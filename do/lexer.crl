mod S = import("slice");
mod D = import("lexer_diag");
mod T = import("token");
mod IDT = import("table");
mod _skip = import("skip_ws");
mod _num = import("number");
mod _str = import("string");
mod _esc = import("escape");
mod _op = import("operator");
mod _ident = import("ident");

typedef slice = S.Slice;
typedef DEng = D.DiagnosticEngine;
typedef Token = T.Token;
typedef TokenKind = T.TokenKind;
typedef IdentifierTable = IDT.IdentifierTable;
typedef EscapeResult = _esc.EscapeResult;

pub struct Lexer {
    DEng* diag;
    IdentifierTable* idents;
    usize line;
    u8* bufStart;
    u8* bufEnd;
    u8* cur;
    u8* lineStart;

    void init(slice src, DEng dEng, IdentifierTable* idTab)
    {
        self.bufStart = src.ptr;
        self.cur = src.ptr;
        self.bufEnd = (u8*)((usize)src.ptr + src.len);
        self.line = 1;
        self.lineStart = src.ptr;
        self.diag = dEng;
        self.idents = idTab;
    }

    bool isAtEnd()
    {
        return self.cur >= self.bufEnd;
    }

    Token makeToken(TokenKind kind, u8* start)
    {
        Token t;
        t.kind = kind;
        t.data.ptr = start;
        t.data.len = (usize)(self.cur - start);
        t.line = self.line;
        t.col = (usize)(start - self.lineStart) + 1;
        t.info = null;
        return t;
    }

    Token nextToken()
    {
        self.skipWsCmts();
        u8* start = self.cur;
        if (self.isAtEnd()) return self.makeToken(TokenKind::Eof, start);
        u8 c = self.cur[0];
        self.cur++;
        
        if (c == 'R' && !self.isAtEnd() && self.cur[0] == '"')
        {
            self.cur++;
            return self.lexRawString(start);
        }
        if ((c == 'u' || c == 'U' || c == 'c') && !self.isAtEnd() && self.cur[0] == '"')
        {
            self.cur++;
            return self.lexString(start);
        }
        if (c == 'u' && !self.isAtEnd() && self.cur[0] == '8' &&
            self.cur + 1 < self.bufEnd && self.cur[1] == '"')
        {
            self.cur += 2;
            return self.lexString(start);
        }
        if ((c | 0x20) >= 'a' && (c | 0x20) <= 'z' || c == '_')
        {
            return self.lexIdentifier(start);
        }
        if (c >= 0xC0 && c <= 0xFD)
        {
            // (u32 cp, usize bytes) = // just so you know, what the fuck is this logic here 
            _ident.decodeUtf8(start, self.bufEnd);
            if (bytes > 0 && _ident.isXidStart(cp))
            {
                self.cur = start + bytes;
                return self.lexIdentifier(start);
            }
        }
        if (c >= '0' && c <= '9')
            return self.lexNumber(start);
        if (c == '"')
            return self.lexString(start);
        if (c == '\'')
        {
            while (!self.isAtEnd() && self.cur[0] != '\'')
            {
                if (self.cur[0] == '\\')
                {
                    EscapeResult esc = EscapeResult::decodeEscapeSequence(self.cur, self.bufEnd);
                    if (!esc.isValid)
                        self.diag.reportError(self.bufStart, self.bufEnd, self.cur, "unknown escape sequence");
                    self.cur += esc.bytesConsumed;
                } else {
                    // (u32 cp, usize bytes) = // what the fuck is this logic too? 
                    _ident.decodeUtf8(self.cur, self.bufEnd);
                    if (bytes > 0) {
                        self.cur += bytes;
                    } else {
                        self.cur++;
                    }
                }
            }
            if (!self.isAtEnd()) self.cur++;
            return self.makeToken(TokenKind::Char, start);
        }

        Token op = self.lexOperator(c, start);
        if (op.kind != TokenKind::Eof) return op;

        return self.makeToken(TokenKind::Eof, start);
    }
}
