mod lex = import("lexer");

typedef Lexer = lex.Lexer;

pub Lexer {
    void skipWsCmts()
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            switch (c)
            {
                case:  ' ': 
                case: '\r': 
                case: '\t':
                    self.cur++;
                    break;
                case: '\n': {
                    self.line++;
                    self.cur++;
                    self.lineStart = self.cur;
                    break;
                }
                case: '/' {
                    if (self.cur + 1 < self.bufEnd && self.cur[1] == '/') {
                        self.cur += 2;
                        while (!self.isAtEnd() && self.cur[0] != '\n') { self.cur++ }
                    }
                    else if (self.cur + 1 < self.bufEnd &&
                             self.cur[1] == '*')
                    {
                        self.cur += 2;
                        while (!self.isAtEnd())
                        {
                            if (self.cur[0] == '\n')
                            {
                                self.line++;
                                self.cur++;
                                self.lineStart = self.cur;
                            }
                            else if (self.cur[0] == '*' && 
                                     self.cur + 1 < self.bufEnd &&
                                     self.cur[1] == '/')
                            {
                                self.cur += 2;
                                break;
                            } else {
                                self.cur++;
                            }
                        }
                    } else {
                        return;
                    } 
                    break;
                }
                default: return;
            }
        }
    }
}
