bool testNestedImport()
{
    u8* src = (u8*)"pub mod m = import path { ios { add, sub }, mul }; import m { mul };";
    printf((u8*)"nested import test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
    return r.errors == 0;
}

bool testAttr()
{
    u8* src = (u8*)"#[[packed]] pub struct Foo { u32 x; }";
    printf((u8*)"attr test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
    return r.errors == 0;
}

bool testSwitchPatterns()
{
    u8* src = (u8*)"switch (x) { 0, 1 => { 1 }, Some { .value } => { 2 }, else => { 0 } }";
    printf((u8*)"switch pattern test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
    u8* underscore = (u8*)"switch (x) { _ => { 0 }, else => { 1 } }";
    TestResult underscoreResult = runExpr(underscore, sourceLen(underscore));
    u8* orpat = (u8*)"switch (x) { 0 | 1 => { 1 }, else => { 0 } }";
    TestResult orResult = runExpr(orpat, sourceLen(orpat));
    printf((u8*)"switch or-pattern test: ");
    orResult.print();
    return r.errors == 0 && underscoreResult.errors == 0 && orResult.errors == 0;
}

