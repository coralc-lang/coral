bool testImportBindings()
{
    u8* valid = (u8*)"pub mod m = import path { add as plus }; import m { add }; u32 f() { return m::add(1, 2); }";
    u8* wildcard = (u8*)"pub mod m = import path { * }; import m { whatever };";
    u8* opaque = (u8*)"pub mod m = import path; u32 f() { return m::anything(1); }";
    u8* rootPath = (u8*)"import file::math::core { square };";
    u8* libPath = (u8*)"import(lib) std::math { pow };";
    u8* unknownNs = (u8*)"u32 f() { return zzz::add(1, 2); }";
    u8* unknownMod = (u8*)"import missing { x };";
    u8* unknownMember = (u8*)"pub mod m = import path { add as plus }; u32 f() { return m::nope(1); }";
    u8* unknownSymbol = (u8*)"pub mod m = import path { add as plus }; import m { missing };";
    bool validOk = runSema(valid, sourceLen(valid));
    bool wildcardOk = runSema(wildcard, sourceLen(wildcard));
    bool opaqueOk = runSema(opaque, sourceLen(opaque));
    bool rootOk = runSema(rootPath, sourceLen(rootPath));
    bool libOk = runSema(libPath, sourceLen(libPath));
    bool unknownNsRejected = !runSema(unknownNs, sourceLen(unknownNs));
    bool unknownModRejected = !runSema(unknownMod, sourceLen(unknownMod));
    bool unknownMemberRejected = !runSema(unknownMember, sourceLen(unknownMember));
    bool unknownSymbolRejected = !runSema(unknownSymbol, sourceLen(unknownSymbol));
    printf((u8*)"import binding test: valid=%u wildcard=%u opaque=%u root=%u lib=%u unknown_ns=%u unknown_mod=%u unknown_member=%u unknown_symbol=%u\n", validOk ? 1 : 0, wildcardOk ? 1 : 0, opaqueOk ? 1 : 0, rootOk ? 1 : 0, libOk ? 1 : 0, unknownNsRejected ? 1 : 0, unknownModRejected ? 1 : 0, unknownMemberRejected ? 1 : 0, unknownSymbolRejected ? 1 : 0);
    return validOk && wildcardOk && opaqueOk && rootOk && libOk && unknownNsRejected && unknownModRejected && unknownMemberRejected && unknownSymbolRejected;
}

