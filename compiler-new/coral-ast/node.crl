/* ast/node.crl — universal AST node wrapper
 *
 * Node is a flat wrapper that references other node types by index.
 * The actual data lives in parallel arrays in the Ast struct.
 *
 * Clang-inspired performance principles:
 *   - Flatten variants: NodeKind tag + parallel arrays per kind
 *   - NodeId is u32 index (4 bytes, not 8-byte pointer)
 *   - Ast owns all data — single allocation, no pointer chasing
 *   - Immutable nodes: create once, never modify
 */

mod id = import "id";
import id { Str, SourceLoc, NodeId };
mod types = import "types";
import types { Ty, TypeEntry };
mod expr = import "expr";
import expr { Expr };
mod stmt = import "stmt";
import stmt { Stmt };
mod decl_ast = import "decl";
import decl_ast { Decl, File, Param, Field, GenericParam, EnumVariant, VariantVariant, FlagBranch };
mod pat = import "pat";
import pat { Pat };

pub variant NodeKind
{
    Invalid { u8 flags; },
    Expr { Expr value; },
    Stmt { Stmt value; },
    Decl { Decl value; },
    Pat { Pat value; },
    Type { Ty value; },
    Param { Param value; },
    Field { Field value; },
    GenericParam { GenericParam value; },
    EnumVariant { EnumVariant value; },
    Variant { VariantVariant value; },
    FlagBranch { FlagBranch value; }
}

pub struct Node
{
    NodeKind kind;
    SourceLoc loc;
}

pub struct Ast
{
    File* files;
    u32 filesLen;
    Node* nodes;
    u32 nodesLen;
    TypeEntry* types;
    u32 typesLen;
}
