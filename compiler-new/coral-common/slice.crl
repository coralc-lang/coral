// slice of u8 utility type
// for coralc compiler.

pub struct Slice
{
    u8* ptr;
    usize len;

    static Slice from(u8* p, usize len)
    {
        return Slice {
            .ptr = p,
            .len = len
        };
    }

    bool eq(Slice b)
    {
        if (self.len != b.len) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != b.ptr[i]) return false; 
        }
        return true;
    }
}