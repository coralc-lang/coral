mod id = import "../coral-ast/id";
import id { Str, NodeId };
mod types = import "../coral-ast/types";
import types { Ty, TypeEntry, TypeKind };
mod node = import "../coral-ast/node";
import node { Node, NodeKind };
mod decl_ast = import "../coral-ast/decl";
import decl_ast { Decl, DeclKind, GenericParam };
mod stmt_ast = import "../coral-ast/stmt";
import stmt_ast { Stmt, StmtKind };
mod context = import "../coral-context/context";
import context { AstContext };
mod sema = import "../coral-semantics/sema";
import sema { Sema };
mod mono = import "mono";
import mono { MonoContext, MonoDeclKind, MonoInstance, MonoInstanceKind, MonoSubstitution };
mod collect = import "collect";
import collect;
mod comptime_eval = import "comptime";
import comptime_eval { CtEval, ctEvalStmts };

extern("C") rawptr calloc(usize count, usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);
extern("C") void free(rawptr ptr);
extern("C") i32 printf(rawptr fmt, ...);

pub extend MonoContext
{
    MonoSubstitution* buildSubstitutions(NodeId declaration, Ty* arguments, u32 argumentsLen)
    {
        u32 count = self.genericCount(declaration);
        if (count == 0) return null;
        MonoSubstitution* result = (MonoSubstitution*)calloc((usize)count, @sizeof(MonoSubstitution));
        if (result == null)
        {
            self.errors = self.errors + 1;
            return null;
        }
        u32 next = 0;
        Decl* decl = self.declAt(declaration);
        if (decl == null) return result;
        NodeId* params = null;
        u32 paramCount = 0;
        switch (decl->kind.tag)
        {
            DeclKind::Struct => {
                params = decl->kind.payload.Struct.genericParams;
                paramCount = decl->kind.payload.Struct.genericParamsLen;
            },

            DeclKind::Variant => {
                params = decl->kind.payload.Variant.genericParams;
                paramCount = decl->kind.payload.Variant.genericParamsLen;
            },

            DeclKind::Union => {
                params = decl->kind.payload.Union.genericParams;
                paramCount = decl->kind.payload.Union.genericParamsLen;
            },

            DeclKind::Trait => {
                params = decl->kind.payload.Trait.genericParams;
                paramCount = decl->kind.payload.Trait.genericParamsLen;
            },

            DeclKind::Func => {
                params = decl->kind.payload.Func.genericParams;
                paramCount = decl->kind.payload.Func.genericParamsLen;
            },
            else => {}
        }
        u32 i = 0;
        while (i < paramCount && next < argumentsLen)
        {
            Node* node = self.nodeAt(params[i]);
            if (node != null && node->kind.tag == NodeKind::GenericParam)
            {
                GenericParam* param = &node->kind.payload.GenericParam.value;
                result[next].parameter = param->name;
                result[next].index = next;
                result[next].declaration = params[i];
                result[next].typeNode = arguments[next];
                next = next + 1;
            }
            i = i + 1;
        }
        if (decl->kind.tag == DeclKind::Func)
        {
            i = 0;
            while (i < decl->kind.payload.Func.paramsLen && next < argumentsLen)
            {
                NodeId paramId = decl->kind.payload.Func.params[i];
                if (self.isTypeParameter(paramId))
                {
                    Str name = self.parameterName(paramId);
                    if (!self.nameInGenericParams(declaration, name))
                    {
                        result[next].parameter = name;
                        result[next].index = next;
                        result[next].declaration = paramId;
                        result[next].typeNode = arguments[next];
                        next = next + 1;
                    }
                }
                i = i + 1;
            }
        }
        return result;
    }

    bool sameArguments(Ty* left, Ty* right, u32 len)
    {
        u32 i = 0;
        while (i < len)
        {
            if (!self.sema.sameType(left[i], right[i])) return false;
            i = i + 1;
        }
        return true;
    }

    bool hasInstance(MonoDeclKind kind, Str name, Ty* arguments, u32 argumentsLen, u64 valueKey)
    {
        u32 i = 0;
        while (i < self.instancesLen)
        {
            if (self.instances[i].kind == (u8)kind && self.instances[i].name == name &&
                self.instances[i].argumentsLen == argumentsLen &&
                self.instances[i].valueKey == valueKey &&
                self.sameArguments(self.instances[i].arguments, arguments, argumentsLen))
                return true;
            i = i + 1;
        }
        return false;
    }

    bool addInstance(NodeId declaration, Ty* arguments, u32 argumentsLen,
                     u64 valueKey, u32 packArity, Str* literalNames, NodeId* literalNodes, u32 literalsLen,
                     Ty* tailTypes, NodeId* tailNodes, u32 tailLen,
                     u32* outIndex)
    {
        Decl* decl = self.declAt(declaration);
        if (decl == null) return false;
        Str name = self.declarationName(declaration);
        MonoDeclKind kind;
        if (decl->kind.tag == DeclKind::Func) kind = MonoDeclKind::FunctionDecl;
        else kind = MonoDeclKind::TypeDecl;
        u32 foundIdx = 0;
        bool found = false;
        u32 scan = 0;
        while (scan < self.instancesLen)
        {
            if (self.instances[scan].kind == (u8)kind && self.instances[scan].name == name &&
                self.instances[scan].argumentsLen == argumentsLen &&
                self.instances[scan].valueKey == valueKey &&
                self.sameArguments(self.instances[scan].arguments, arguments, argumentsLen))
            {
                found = true;
                foundIdx = scan;
                break;
            }
            scan = scan + 1;
        }
        if (found)
        {
            if (outIndex != null) *outIndex = foundIdx;
            return true;
        }
        if (!self.reserveInstances()) return false;
        MonoInstance* instance = self.instances + self.instancesLen;
        if (decl->kind.tag == DeclKind::Func) instance.kind = MonoInstanceKind::FunctionInstance;
        else instance.kind = MonoInstanceKind::TypeInstance;
        instance.name = name;
        instance.declaration = declaration;
        instance.typeNode = 0;
        instance.returnType = 0;
        instance.paramTypes = null;
        instance.paramTypesLen = 0;
        instance.arguments = self.copyTypes(arguments, argumentsLen);
        instance.argumentsLen = argumentsLen;
        instance.substitutions = self.buildSubstitutions(declaration, arguments, argumentsLen);
        instance.substitutionsLen = self.genericCount(declaration);
        instance.valueKey = valueKey;
        instance.packArity = packArity;
        instance.literalNames = null;
        instance.literalNodes = null;
        instance.literalsLen = 0;
        instance.tailTypes = null;
        instance.tailNodes = null;
        instance.tailArgNames = null;
        instance.tailLen = 0;
        if (tailLen > 0 && tailTypes != null && tailNodes != null)
        {
            Ty* ttypes = (Ty*)malloc((usize)tailLen * @sizeof(Ty));
            NodeId* tnodes = (NodeId*)malloc((usize)tailLen * @sizeof(NodeId));
            if (ttypes != null && tnodes != null)
            {
                u32 k = 0;
                while (k < tailLen)
                {
                    ttypes[k] = tailTypes[k];
                    tnodes[k] = tailNodes[k];
                    k = k + 1;
                }
                instance.tailTypes = ttypes;
                instance.tailNodes = tnodes;
                instance.tailLen = tailLen;
            }
            else
            {
                if (ttypes != null) free((rawptr)ttypes);
                if (tnodes != null) free((rawptr)tnodes);
            }
        }
        if (literalsLen > 0)
        {
            Str* lnames = (Str*)malloc((usize)literalsLen * @sizeof(Str));
            NodeId* lnodes = (NodeId*)malloc((usize)literalsLen * @sizeof(NodeId));
            if (lnames != null && lnodes != null)
            {
                u32 k = 0;
                while (k < literalsLen)
                {
                    lnames[k] = literalNames[k];
                    lnodes[k] = literalNodes[k];
                    k = k + 1;
                }
                instance.literalNames = lnames;
                instance.literalNodes = lnodes;
                instance.literalsLen = literalsLen;
            }
            else
            {
                if (lnames != null) free((rawptr)lnames);
                if (lnodes != null) free((rawptr)lnodes);
            }
        }
        if (decl->kind.tag == DeclKind::Func) instance.body = decl->kind.payload.Func.body;
        else
        {
            NodeId none;
            none.index = 0;
            instance.body = none;
        }
        instance.attributes = decl->attrs;
        instance.attributesLen = decl->attrsLen;
        instance.validationAttempted = 0;
        instance.validated = 0;
        if (decl->kind.tag == DeclKind::Func)
        {
            instance.returnType = self.substituteType(decl->kind.payload.Func.returnType, instance.substitutions, instance.substitutionsLen);
            instance.paramTypesLen = decl->kind.payload.Func.paramsLen;
            if (instance.paramTypesLen > 0)
            {
                instance.paramTypes = (Ty*)calloc((usize)instance.paramTypesLen, @sizeof(Ty));
                if (instance.paramTypes == null)
                {
                    self.errors = self.errors + 1;
                    return false;
                }
                u32 i = 0;
                while (i < instance.paramTypesLen)
                {
                    Node* param = self.nodeAt(decl->kind.payload.Func.params[i]);
                    if (param != null && param->kind.tag == NodeKind::Param)
                        instance.paramTypes[i] = self.substituteType(param->kind.payload.Param.value.typeNode, instance.substitutions, instance.substitutionsLen);
                    i = i + 1;
                }
            }
        }
        else
        {
            TypeKind kind = TypeKind::Named{ .name = name, .genericArgs = instance.arguments, .genericArgsLen = argumentsLen };
            instance.typeNode = self.sema.allocType(kind);
        }
        self.instancesLen = self.instancesLen + 1;
        if (outIndex != null) *outIndex = self.instancesLen - 1;
        return true;
    }

    bool validateInstance(MonoInstance* instance)
    {
        instance.validationAttempted = 1;
        u32 errorsBefore = self.sema.errors;
        if (instance.kind == MonoInstanceKind::FunctionInstance)
        {
            if (!self.sema.checkType(instance.returnType)) return false;
            u32 i = 0;
            while (i < instance.paramTypesLen)
            {
                if (!self.sema.checkType(instance.paramTypes[i])) return false;
                i = i + 1;
            }
        }
        else if (!self.sema.checkType(instance.typeNode)) return false;
        if (self.sema.errors == errorsBefore) instance.validated = 1;
        else instance.validated = 0;
        return instance.validated != 0;
    }

    bool run()
    {
        u32 i = 0;
        while (i < self.workLen)
        {
            u32 instIdx = 0;
            if (!self.addInstance(self.work[i].declaration, self.work[i].arguments, self.work[i].argumentsLen,
                                  self.work[i].valueKey, self.work[i].packArity,
                                  self.work[i].literalNames, self.work[i].literalNodes, self.work[i].literalsLen,
                                  self.work[i].tailTypes, self.work[i].tailNodes, self.work[i].tailLen,
                                  &instIdx)) return false;
            MonoInstance* instance = self.instances + instIdx;
            if (!self.validateInstance(instance))
            {
                printf("[mono] validateInstance FAILED decl=%d ret=%d\n", (i32)instance.declaration.index, (i32)instance.returnType);
                self.errors = self.errors + 1;
            }
            /* re-collect the instance body with its substitutions active so
             * nested generic calls (`dealloc<T>` inside realloc<cchar>,
             * `alloc<T>` inside Vec<str>) enqueue concrete instances */
            self.activeSubs = instance.substitutions;
            self.activeSubsLen = instance.substitutionsLen;
            if (instance.kind == MonoInstanceKind::FunctionInstance)
            {
                if (instance.body.index != 0)
                {
                    self.collectStmt(instance.body);
                    /* staging: evaluate the body's comptime blocks with the
                     * instance's type substitutions bound; surviving runtime
                     * statements replace the original body */
                    self.evalComptimeBody(instance);
                }
            }
            else if (instance.kind == MonoInstanceKind::TypeInstance)
            {
                Node* tdn = self.nodeAt(instance.declaration);
                if (tdn != null && tdn.kind.tag == NodeKind::Decl)
                {
                    Decl* td = &tdn.kind.payload.Decl.value;
                    NodeId* methods = null;
                    u32 methodsLen = 0;
                    if (td->kind.tag == DeclKind::Struct)
                    {
                        methods = td->kind.payload.Struct.methods;
                        methodsLen = td->kind.payload.Struct.methodsLen;
                    }
                    else if (td->kind.tag == DeclKind::Union)
                    {
                        methods = td->kind.payload.Union.methods;
                        methodsLen = td->kind.payload.Union.methodsLen;
                    }
                    else if (td->kind.tag == DeclKind::Variant)
                    {
                        methods = td->kind.payload.Variant.methods;
                        methodsLen = td->kind.payload.Variant.methodsLen;
                    }
                    u32 mi = 0;
                    while (mi < methodsLen)
                    {
                        self.collectDecl(methods[mi]);
                        mi = mi + 1;
                    }
                }
            }
            self.activeSubs = null;
            self.activeSubsLen = 0;
            i = i + 1;
        }
        return self.errors == 0;
    }

    /* staging: evaluate comptime blocks in a function instance's body.
     * binds type params from substitutions, then rewrites the body's
     * comptime control flow into runtime statements. the original body
     * is only replaced when the evaluator produced output (i.e. there
     * was something to fold); otherwise the body passes through and
     * codegen inlines the comptime blocks as before. */
    void evalComptimeBody(MonoInstance* instance)
    {
        /* only rewire bodies that actually contain a comptime block —
         * every other instance skips the evaluator entirely */
        Node* bn = self.nodeAt(instance.body);
        if (bn == null || bn->kind.tag != NodeKind::Stmt) return;
        Stmt* bs = &bn->kind.payload.Stmt.value;
        bool hasCt = false;
        if (bs->kind.tag == StmtKind::Comptime) hasCt = true;
        else if (bs->kind.tag == StmtKind::Block)
        {
            u32 s = 0;
            while (s < bs->kind.payload.Block.stmtsLen)
            {
                Node* sn = self.nodeAt(bs->kind.payload.Block.stmts[s]);
                if (sn != null && sn->kind.tag == NodeKind::Stmt &&
                    sn->kind.payload.Stmt.value.kind.tag == StmtKind::Comptime)
                    hasCt = true;
                s = s + 1;
            }
        }
        if (!hasCt) return;

        CtEval ct;
        ct.init(self);
        /* bind each generic parameter to its concrete type so type
         * switches (`switch (T)`) fold during evaluation */
        u32 i = 0;
        while (i < instance.substitutionsLen)
        {
            ct.bind(instance.substitutions[i].parameter,
                    ct.makeType(instance.substitutions[i].typeNode));
            i = i + 1;
        }
        /* bind call-site literal values recorded for this instance
         * (Zig-style value specialization: `println("hello")` binds fmt
         * to the literal bytes, so `@isFormatLiteral(fmt)` folds) */
        u32 li = 0;
        while (li < instance.literalsLen)
        {
            Node* vn = self.nodeAt(instance.literalNodes[li]);
            if (vn != null && vn->kind.tag == NodeKind::Expr)
            {
                Expr* ve = &vn->kind.payload.Expr.value;
                if (ve->kind.tag == ExprKind::StringLit)
                    ct.bind(instance.literalNames[li], ct.strLitVal(instance.literalNodes[li]));
                else if (ve->kind.tag == ExprKind::IntLit)
                    ct.bind(instance.literalNames[li], ct.makeInt(ve->kind.payload.IntLit.value));
                else if (ve->kind.tag == ExprKind::CharLit)
                    ct.bind(instance.literalNames[li], ct.makeInt((u64)ve->kind.payload.CharLit.value));
                else if (ve->kind.tag == ExprKind::BoolLit)
                    ct.bind(instance.literalNames[li], ct.makeBool((ve->kind.payload.BoolLit.flags & 1) != 0));
            }
            li = li + 1;
        }
        /* if the instance function is variadic, remember the pack param
         * name so bare `...` in its body can forward it */
        Node* fnNode = self.nodeAt(instance.declaration);
        if (fnNode != null && fnNode->kind.tag == NodeKind::Decl)
        {
            Decl* fd = &fnNode->kind.payload.Decl.value;
            if (fd->kind.tag == DeclKind::Func && fd->kind.payload.Func.paramsLen > 0)
            {
                NodeId lastP = fd->kind.payload.Func.params[fd->kind.payload.Func.paramsLen - 1];
                Node* lpn = self.nodeAt(lastP);
                if (lpn != null && lpn->kind.tag == NodeKind::Param &&
                    (lpn->kind.payload.Param.value.flags & 16) != 0)
                {
                    ct.variadicPackName = lpn->kind.payload.Param.value.name;
                    if (instance.packArity == 0)
                    {
                        /* this call site passed no trailing args — bind
                         * the pack to an empty pack so `for (x : args)`
                         * unrolls to zero iterations instead of falling
                         * back to a runtime loop over a pack codegen
                         * cannot lower */
                        ct.bind(ct.variadicPackName, ct.makePack(null, 0));
                    }
                    else
                    {
                        /* bind the recorded call-site tail args: literals
                         * fold to their comptime value; runtime args become
                         * fresh idents naming this instance's own trailing
                         * C parameters (`_varg0`, …) — the call site passes
                         * every arg positionally, so the names only need to
                         * match what cgEmitParams declares */
                        u32 n = instance.packArity;
                        CtVal* elems = (CtVal*)calloc((usize)n, @sizeof(CtVal));
                        Str* names = (Str*)malloc((usize)n * @sizeof(Str));
                        u8* sbuf = (u8*)malloc(32);
                        if (elems != null && names != null && sbuf != null)
                        {
                            u32 k = 0;
                            while (k < n)
                            {
                                NodeId nid;
                                nid.index = 0;
                                if (k < instance.tailLen) nid = instance.tailNodes[k];
                                Ty tt = 0;
                                if (k < instance.tailLen) tt = instance.tailTypes[k];
                                bool folded = false;
                                CtVal ev;
                                ev.kind = 0;
                                if (nid.index != 0)
                                {
                                    Node* tn = self.nodeAt(nid);
                                    if (tn != null && tn->kind.tag == NodeKind::Expr)
                                    {
                                        Expr* te = &tn->kind.payload.Expr.value;
                                        if (te->kind.tag == ExprKind::StringLit)
                                        {
                                            ev = ct.strLitVal(nid);
                                            folded = true;
                                        }
                                        else if (te->kind.tag == ExprKind::IntLit)
                                        {
                                            ev = ct.makeIntTy(te->kind.payload.IntLit.value, tt);
                                            folded = true;
                                        }
                                        else if (te->kind.tag == ExprKind::CharLit)
                                        {
                                            ev = ct.makeIntTy((u64)te->kind.payload.CharLit.value, tt);
                                            folded = true;
                                        }
                                        else if (te->kind.tag == ExprKind::BoolLit)
                                        {
                                            ev = ct.makeBool((te->kind.payload.BoolLit.flags & 1) != 0);
                                            folded = true;
                                        }
                                    }
                                }
                                /* synthesized parameter name — always made
                                 * so the emitted C signature has one named
                                 * parameter per tail arg, in call order */
                                sbuf[0] = 95; sbuf[1] = 118; sbuf[2] = 97; sbuf[3] = 114; sbuf[4] = 103; /* "_varg" */
                                u32 w = 5;
                                u32 dv = k;
                                u32 dn = 0;
                                if (dv == 0) { sbuf[20] = 48; dn = 1; }
                                while (dv > 0)
                                {
                                    sbuf[20 + dn] = (u8)(48 + (dv % 10));
                                    dn = dn + 1;
                                    dv = dv / 10;
                                }
                                while (dn > 0) { dn = dn - 1; sbuf[w] = sbuf[20 + dn]; w = w + 1; }
                                Str nm = ct.internStr(sbuf, (usize)w);
                                names[k] = nm;
                                if (!folded)
                                {
                                    NodeId id = ct.mkExpr(ExprKind::Ident{ .name = nm }, tt);
                                    ev = ct.makeRt(id, tt);
                                }
                                elems[k] = ev;
                                k = k + 1;
                            }
                            instance.tailArgNames = names;
                            ct.bind(ct.variadicPackName, ct.makePack(elems, n));
                        }
                        else
                        {
                            if (elems != null) free((rawptr)elems);
                            if (names != null) free((rawptr)names);
                        }
                        free((rawptr)sbuf);
                    }
                }
            }
        }
        ct.evalStmt(instance.body);
        if (ct.failed)
        {
            printf("[mono] evalComptimeBody FAILED decl=%d name=%s msg=%s\n", (i32)instance.declaration.index, (rawptr)self.ast.interns[instance.name].ptr, (rawptr)ct.errMsg);
            self.errors = self.errors + 1;
            ct.dispose();
            return;
        }
        /* a type switch with no matching arm — only reported when the
         * author's own @compileError did not already fire (ct.failed) */
        if (ct.typeSwitchMissed)
        {
            printf("[mono] evalComptimeBody type-switch miss decl=%d msg=no switch arm matches the scrutinee type\n", (i32)instance.declaration.index);
            self.errors = self.errors + 1;
            ct.dispose();
            return;
        }
        /* replace the body with a Block of the surviving runtime stmts —
         * length is not a proxy for "unchanged" (one comptime stmt can
         * fold into one different runtime stmt) */
        if (ct.emittedLen > 0)
        {
            NodeId* out = (NodeId*)calloc((usize)ct.emittedLen, @sizeof(NodeId));
            if (out != null)
            {
                u32 k = 0;
                while (k < ct.emittedLen) { out[k] = ct.emitted[k]; k = k + 1; }
                AstContext* c = self.ast;
                NodeId newBody = c.allocNodeSlot();
                if (newBody.index != 0)
                {
                    Node* nn = c.nodes + newBody.index;
                    nn->loc = bn->loc;
                    nn->kind = NodeKind::Stmt{ .value = Stmt{ .kind = StmtKind::Block{ .stmts = out, .stmtsLen = ct.emittedLen }, .loc = bn->loc } };
                    instance.body = newBody;
                    /* arena-tracked so clear() need not free it */
                    c.track((rawptr)out);
                }
            }
        }
        ct.dispose();
    }
}
