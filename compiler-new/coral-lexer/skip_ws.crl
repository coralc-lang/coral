mod base = import "base";
mod diagnostics = import "../coral-diagnostics/code";

import base { Lexer };
import diagnostics { ErrorCode };

pub extend Lexer
{
    void skipWsCmts()
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            switch (c)
            {
                ' ', '\r', '\t' => { // if the bootstrap flags this, make this the d. not |. 
                    self.cur++; // use a comma to separate.
                },
                '\n' => {
                    self.line++;
                    self.cur++;
                    self.lineStart = self.cur;
                },
                '/' => {
                    if (self.cur + 1 < self.bufEnd && self.cur[1] == '/') {
                        self.cur += 2;
                        while (!self.isAtEnd() && self.cur[0] != '\n') { self.cur++ }
                    }
                    else if (self.cur + 1 < self.bufEnd &&
                             self.cur[1] == '*')
                    {
                        u8* commentStart = self.cur;
                        bool closed = false;
                        self.cur += 2;
                        while (!self.isAtEnd())
                        {
                            if (self.cur[0] == '\n')
                            {
                                self.line++;
                                self.cur++;
                                self.lineStart = self.cur;
                            }
                            else if (self.cur[0] == '*' &&
                                     self.cur + 1 < self.bufEnd &&
                                     self.cur[1] == '/')
                            {
                                self.cur += 2;
                                closed = true;
                                break;
                            } else {
                                self.cur++;
                            }
                        }
                        if (!closed)
                            self.reportErrorCode(ErrorCode::LexUnterminatedComment, self.bufStart, self.bufEnd, commentStart, "unterminated block comment");
                    } else {
                        return;
                    }
                },
                else => { return; },
            }
        }
    }
}
