/* diagnostics/error_code.crl — unique error numbers
 *
 * Follows Clang's DiagnosticIDs design: each diagnostic has a unique ID.
 * Ranges:
 *   1000-1999  Lexer errors
 *   2000-2999  Parser errors
 *   3000-3999  Semantic errors (name resolution, type checking)
 *   4000-4999  Codegen errors
 *   5000-5999  Driver errors (file I/O, flags)
 */

pub enum ErrorCode
{
    // Lexer errors 1000-1999 
    LexUnknownChar,
    LexUnterminatedString,
    LexUnterminatedChar,
    LexUnterminatedComment,
    LexInvalidEscape,
    LexInvalidNumber,
    LexInvalidChar,

    // Parser errors 2000-2999 
    ParseExpectedToken,
    ParseExpectedExpr,
    ParseExpectedType,
    ParseExpectedDecl,
    ParseExpectedStmt,
    ParseUnexpectedEof,
    ParseInvalidAssignTarget,
    ParseDuplicateModifier,
    ParseMissingSemicolon,
    ParseCondAssign,
    ParseInvalidImportPath,

    // Semantic errors 3000-3999 
    SemaUndeclaredIdent,
    SemaTypeMismatch,
    SemaArityMismatch,
    SemaDuplicateDecl,
    SemaInvalidCast,
    SemaUnknownMember,
    SemaInternal,
    SemaInvalidAssignTarget,
    SemaIntToPtr,

    // Codegen errors 4000-4999 
    CodegenUnsupported,
    CodegenInternal,

    // Driver errors 5000-5999 
    DriverFileNotFound,
    DriverInvalidFlag,
    DriverOutOfMemory
}

/* stable diagnostic codes — call sites report one of these (plus a
 * location and an optional help line); error.crl renders everything.
 *   LXXXX  lexer
 *   PXXXX  parser
 *   TXXXX   type check / semantic analysis
 *   GXXXX   codegen
 *   DXXXX  driver
 */
 
str codeStr(ErrorCode code)
{
    switch (code)
    {
        ErrorCode::LexUnknownChar => { return "L0001"; },
        ErrorCode::LexUnterminatedString => { return "L0002"; },
        ErrorCode::LexUnterminatedChar => { return "L0003"; },
        ErrorCode::LexUnterminatedComment => { return "L0004"; },
        ErrorCode::LexInvalidEscape => { return "L0005"; },
        ErrorCode::LexInvalidNumber => { return "L0006"; },
        ErrorCode::LexInvalidChar => { return "L0007"; },
        ErrorCode::ParseExpectedToken => { return "P0001"; },
        ErrorCode::ParseExpectedExpr => { return "P0002"; },
        ErrorCode::ParseExpectedType => { return "P0003"; },
        ErrorCode::ParseExpectedDecl => { return "P0004"; },
        ErrorCode::ParseExpectedStmt => { return "P0005"; },
        ErrorCode::ParseUnexpectedEof => { return "P0006"; },
        ErrorCode::ParseInvalidAssignTarget => { return "P0007"; },
        ErrorCode::ParseDuplicateModifier => { return "P0008"; },
        ErrorCode::ParseMissingSemicolon => { return "P0009"; },
        ErrorCode::ParseCondAssign => { return "P0010"; },
        ErrorCode::ParseInvalidImportPath => { return "P0011"; },
        ErrorCode::SemaUndeclaredIdent => { return "T0001"; },
        ErrorCode::SemaTypeMismatch => { return "T0002"; },
        ErrorCode::SemaArityMismatch => { return "T0003"; },
        ErrorCode::SemaDuplicateDecl => { return "T0004"; },
        ErrorCode::SemaInvalidCast => { return "T0005"; },
        ErrorCode::SemaUnknownMember => { return "T0006"; },
        ErrorCode::SemaInternal => { return "T0007"; },
        ErrorCode::SemaInvalidAssignTarget => { return "T0008"; },
        ErrorCode::SemaIntToPtr => { return "T0009"; },
        ErrorCode::CodegenUnsupported => { return "G0001"; },
        ErrorCode::CodegenInternal => { return "G0002"; },
        ErrorCode::DriverFileNotFound => { return "D0001"; },
        ErrorCode::DriverInvalidFlag => { return "D0002"; },
        ErrorCode::DriverOutOfMemory => { return "D0003"; },
        else => { return "404-0000"; }
    }
}
