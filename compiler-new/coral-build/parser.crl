import lexer { CrlbLexer, mkSlice };
import token { CrlbToken, CrlbTokenKind };
import ast { CrlbNode, CrlbNodeKind, Value, ValueArray, nodeKindName, valueArrayPush };
import arena { Arena };
import common::slice { Slice };

extern("C") i32 printf(u8* fmt, ...);

// recursive-descent parser for the .crlb build-file grammar (build_sys.md)
pub struct CrlbParser
{
    CrlbLexer* lx;
    CrlbToken prev;
    CrlbToken cur;
    CrlbToken next;
    Arena* arena;
    u32 errors;

    void init(Arena* a, Slice src)
    {
        self.arena = a;
        self.errors = 0;
        self.lx = (CrlbLexer*)self.arena.alloc(@sizeof(CrlbLexer), 8);
        if (self.lx == null) return;
        self.lx.init(src);
        self.cur = self.lx.next();
        self.prev = self.cur;
        self.next = self.lx.next();
    }

    void advance()
    {
        self.prev = self.cur;
        self.cur = self.next;
        self.next = self.lx.next();
    }

    bool check(CrlbTokenKind k) { return self.cur.kind == k; }
    bool checkNext(CrlbTokenKind k) { return self.next.kind == k; }

    bool match(CrlbTokenKind k)
    {
        if (self.cur.kind != k) return false;
        self.advance();
        return true;
    }

    void errorAt(CrlbToken t, u8* msg)
    {
        self.errors = self.errors + 1;
        printf((u8*)"%llu:%llu: parse error: %s\n", t.line, t.col, msg);
    }

    void expect(CrlbTokenKind k, u8* msg)
    {
        if (self.cur.kind != k)
        {
            self.errorAt(self.cur, msg);
            return;
        }
        self.advance();
    }

    bool isWord(CrlbToken t, u8* cstr, usize len)
    {
        if (t.kind != CrlbTokenKind::Ident) return false;
        Slice s = t.text;
        return s.eq(mkSlice(cstr, len));
    }

    bool curIsWord(u8* cstr, usize len)
    {
        return self.isWord(self.cur, cstr, len);
    }

    // values

    Value parseValue()
    {
        switch (self.cur.kind)
        {
            CrlbTokenKind::String => {
                Value v = Value::String { .value = self.cur.text };
                self.advance();
                return v;
            },
            CrlbTokenKind::Number => {
                Value v = Value::Number { .value = self.cur.numValue };
                self.advance();
                return v;
            },
            CrlbTokenKind::Bool => {
                Value v = Value::Boolean { .value = self.cur.boolValue };
                self.advance();
                return v;
            },
            CrlbTokenKind::LBracket => {
                self.advance();
                ValueArray* arr = (ValueArray*)self.arena.alloc(@sizeof(ValueArray), 8);
                if (arr != null)
                {
                    arr.data = null;
                    arr.len = 0;
                    arr.cap = 0;
                    arr.arena = self.arena;
                }
                while (!self.check(CrlbTokenKind::RBracket) && !self.check(CrlbTokenKind::Eof))
                {
                    Value item = self.parseValue();
                    if (arr != null) valueArrayPush(arr, item);
                    if (!self.match(CrlbTokenKind::Comma)) break;
                }
                self.expect(CrlbTokenKind::RBracket, (u8*)"expected ] to close list");
                Value v = Value::List { .value = arr };
                return v;
            },
            else => {
                self.errorAt(self.cur, (u8*)"expected value");
                self.advance();
                Value v = Value::Number { .value = 0 };
                return v;
            }
        }
    }

    // children

    bool childKind(Slice name, CrlbNodeKind* out)
    {
        if (name.eq(mkSlice((u8*)"override", 8))) { *out = CrlbNodeKind::Override; return true; }
        if (name.eq(mkSlice((u8*)"target", 6))) { *out = CrlbNodeKind::Target; return true; }
        if (name.eq(mkSlice((u8*)"link", 4))) { *out = CrlbNodeKind::Link; return true; }
        if (name.eq(mkSlice((u8*)"artifact", 8))) { *out = CrlbNodeKind::Artifact; return true; }
        if (name.eq(mkSlice((u8*)"features", 8))) { *out = CrlbNodeKind::Features; return true; }
        if (name.eq(mkSlice((u8*)"env", 3))) { *out = CrlbNodeKind::Env; return true; }
        if (name.eq(mkSlice((u8*)"log", 3))) { *out = CrlbNodeKind::Log; return true; }
        if (name.eq(mkSlice((u8*)"metrics", 7))) { *out = CrlbNodeKind::Metrics; return true; }
        if (name.eq(mkSlice((u8*)"test", 4))) { *out = CrlbNodeKind::Test; return true; }
        if (name.eq(mkSlice((u8*)"bench", 5))) { *out = CrlbNodeKind::Bench; return true; }
        if (name.eq(mkSlice((u8*)"hook", 4))) { *out = CrlbNodeKind::Hook; return true; }
        if (name.eq(mkSlice((u8*)"phase", 5))) { *out = CrlbNodeKind::Phase; return true; }
        if (name.eq(mkSlice((u8*)"task", 4))) { *out = CrlbNodeKind::Task; return true; }
        if (name.eq(mkSlice((u8*)"profile", 7))) { *out = CrlbNodeKind::Profile; return true; }
        if (name.eq(mkSlice((u8*)"workspace", 9))) { *out = CrlbNodeKind::Workspace; return true; }
        if (name.eq(mkSlice((u8*)"deps", 4))) { *out = CrlbNodeKind::Deps; return true; }
        if (name.eq(mkSlice((u8*)"remote", 6))) { *out = CrlbNodeKind::Remote; return true; }
        if (name.eq(mkSlice((u8*)"ci", 2))) { *out = CrlbNodeKind::Ci; return true; }
        if (name.eq(mkSlice((u8*)"lint", 4))) { *out = CrlbNodeKind::Lint; return true; }
        if (name.eq(mkSlice((u8*)"format", 6))) { *out = CrlbNodeKind::Format; return true; }
        if (name.eq(mkSlice((u8*)"lsp", 3))) { *out = CrlbNodeKind::Lsp; return true; }
        if (name.eq(mkSlice((u8*)"include", 7))) { *out = CrlbNodeKind::Include; return true; }
        if (name.eq(mkSlice((u8*)"build", 5))) { *out = CrlbNodeKind::Build; return true; }
        if (name.eq(mkSlice((u8*)"schema", 6))) { *out = CrlbNodeKind::Schema; return true; }
        if (name.eq(mkSlice((u8*)"strict", 6))) { *out = CrlbNodeKind::Strict; return true; }
        return false;
    }

    // parse one `{ ... }` body (fields + nested children) into node
    void parseBlockInto(CrlbNode* node)
    {
        self.expect(CrlbTokenKind::LBrace, (u8*)"expected { to open block");
        while (!self.check(CrlbTokenKind::RBrace) && !self.check(CrlbTokenKind::Eof))
        {
            if (self.check(CrlbTokenKind::Ident))
            {
                Slice name = self.cur.text;
                self.advance();
                if (self.check(CrlbTokenKind::Equals))
                {
                    self.advance();
                    if (self.check(CrlbTokenKind::LBrace))
                    {
                        // env = { ... }; style map block
                        CrlbNodeKind mk;
                        if (!self.childKind(name, &mk))
                        {
                            self.errorAt(self.prev, (u8*)"unknown block name");
                            mk = CrlbNodeKind::Env;
                        }
                        CrlbNode child;
                        child.init(mk, self.arena);
                        child.label = name;
                        child.hasLabel = true;
                        self.parseBlockInto(&child);
                        self.expect(CrlbTokenKind::Semi, (u8*)"expected ; after block");
                        node.addChild(&child);
                        continue;
                    }
                    Value v = self.parseValue();
                    self.expect(CrlbTokenKind::Semi, (u8*)"expected ; after field");
                    node.addField(name, v);
                    continue;
                }
                if (self.check(CrlbTokenKind::String) || self.check(CrlbTokenKind::LBrace))
                {
                    // labeled or bare nested block: override "x" { ... }
                    CrlbNodeKind mk;
                    if (!self.childKind(name, &mk))
                    {
                        self.errorAt(self.prev, (u8*)"unknown block name");
                        mk = CrlbNodeKind::Override;
                    }
                    CrlbNode child;
                    child.init(mk, self.arena);
                    child.label = name;
                    child.hasLabel = true;
                    if (self.check(CrlbTokenKind::String))
                    {
                        child.label = self.cur.text;
                        child.hasLabel = true;
                        self.advance();
                    }
                    if (self.check(CrlbTokenKind::Ident) && self.curIsWord((u8*)"extends", 7))
                    {
                        self.advance();
                        if (self.check(CrlbTokenKind::String))
                        {
                            child.extendsTarget = self.cur.text;
                            child.hasExtends = true;
                            self.advance();
                        }
                    }
                    self.parseBlockInto(&child);
                    node.addChild(&child);
                    continue;
                }
                self.errorAt(self.cur, (u8*)"expected = or { after name");
                continue;
            }
            if (self.check(CrlbTokenKind::String))
            {
                // dep_entry style: "key" = { ... };
                Slice key = self.cur.text;
                self.advance();
                self.expect(CrlbTokenKind::Equals, (u8*)"expected = after string key");
                CrlbNode child;
                child.init(CrlbNodeKind::DepEntry, self.arena);
                child.label = key;
                child.hasLabel = true;
                if (self.check(CrlbTokenKind::LBrace)) self.parseBlockInto(&child);
                self.expect(CrlbTokenKind::Semi, (u8*)"expected ; after entry");
                node.addChild(&child);
                continue;
            }
            self.errorAt(self.cur, (u8*)"unexpected token in block");
            self.advance();
        }
        self.expect(CrlbTokenKind::RBrace, (u8*)"expected } to close block");
    }

    // ── top-level declarations ───────────────────────────────────────

    CrlbNode* parseTopDecl()
    {
        if (!self.check(CrlbTokenKind::Ident))
        {
            self.errorAt(self.cur, (u8*)"expected declaration");
            self.advance();
            return null;
        }
        Slice kw = self.cur.text;
        self.advance();

        // schema = 1;   strict = true;
        if (kw.eq(mkSlice((u8*)"schema", 6)) || kw.eq(mkSlice((u8*)"strict", 6)))
        {
            CrlbNodeKind k = CrlbNodeKind::Schema;
            if (kw.eq(mkSlice((u8*)"strict", 6))) k = CrlbNodeKind::Strict;
            CrlbNode* n = (CrlbNode*)self.arena.alloc(@sizeof(CrlbNode), 8);
            if (n == null) return null;
            n.init(k, self.arena);
            self.expect(CrlbTokenKind::Equals, (u8*)"expected = in schema/strict decl");
            Value v = self.parseValue();
            self.expect(CrlbTokenKind::Semi, (u8*)"expected ; after schema/strict");
            n.addField(kw, v);
            return n;
        }

        // alias name = "target";
        if (kw.eq(mkSlice((u8*)"alias", 5)))
        {
            CrlbNode* n = (CrlbNode*)self.arena.alloc(@sizeof(CrlbNode), 8);
            if (n == null) return null;
            n.init(CrlbNodeKind::Alias, self.arena);
            if (self.check(CrlbTokenKind::Ident))
            {
                n.label = self.cur.text;
                n.hasLabel = true;
                self.advance();
            }
            else self.errorAt(self.cur, (u8*)"expected alias name");
            self.expect(CrlbTokenKind::Equals, (u8*)"expected = in alias decl");
            if (self.check(CrlbTokenKind::String))
            {
                n.payload = self.cur.text;
                n.hasPayload = true;
                self.advance();
            }
            else self.errorAt(self.cur, (u8*)"expected string target in alias");
            self.expect(CrlbTokenKind::Semi, (u8*)"expected ; after alias");
            return n;
        }

        // include "other.crlb";
        if (kw.eq(mkSlice((u8*)"include", 7)))
        {
            CrlbNode* n = (CrlbNode*)self.arena.alloc(@sizeof(CrlbNode), 8);
            if (n == null) return null;
            n.init(CrlbNodeKind::Include, self.arena);
            if (self.check(CrlbTokenKind::String))
            {
                n.payload = self.cur.text;
                n.hasPayload = true;
                self.advance();
            }
            else self.errorAt(self.cur, (u8*)"expected string path in include");
            self.expect(CrlbTokenKind::Semi, (u8*)"expected ; after include");
            return n;
        }

        // labeled block decl: build "name" [extends "x"] { ... }
        CrlbNodeKind kind;
        if (!self.childKind(kw, &kind))
        {
            self.errorAt(self.prev, (u8*)"unknown top-level declaration");
            return null;
        }
        CrlbNode* n = (CrlbNode*)self.arena.alloc(@sizeof(CrlbNode), 8);
        if (n == null) return null;
        n.init(kind, self.arena);
        if (self.check(CrlbTokenKind::String))
        {
            n.label = self.cur.text;
            n.hasLabel = true;
            self.advance();
        }
        if (self.check(CrlbTokenKind::Ident) && self.curIsWord((u8*)"extends", 7))
        {
            self.advance();
            if (self.check(CrlbTokenKind::String))
            {
                n.extendsTarget = self.cur.text;
                n.hasExtends = true;
                self.advance();
            }
        }
        self.parseBlockInto(n);
        return n;
    }

    CrlbNode* parseFile()
    {
        CrlbNode* root = (CrlbNode*)self.arena.alloc(@sizeof(CrlbNode), 8);
        if (root == null) return null;
        root.init(CrlbNodeKind::Root, self.arena);
        while (!self.check(CrlbTokenKind::Eof))
        {
            CrlbNode* decl = self.parseTopDecl();
            if (decl != null) root.addChild(decl);
            if (self.errors > 64) break;
        }
        if (self.lx.hadError) self.errors = self.errors + 1;
        return root;
    }
}
