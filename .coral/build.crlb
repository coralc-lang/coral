# example build file for the coral compiler tree
schema = 1;
strict = true;

build "coralc" {
    root       = "compiler/";
    entry      = "coral-frontend";
    target     = "native-x86_64";
    opt        = "debug";
    output     = "build/coralc";
    module_map = ".coral/modules.map";
    cache_dir  = ".coral/cache";

    flags = ["--strict", "--warn-unused"];

    modules = [
        "coral-ast",
        "coral-build",
        "coral-common",
        "coral-context",
        "coral-diagnostics",
        "coral-frontend",
        "coral-lexer",
        "coral-module",
        "coral-mono",
        "coral-parser",
        "coral-semantics",
        "coral-source",
    ];

    skip = ["target", "vendor"];
}

# short names for imports
alias lexer = "coral-lexer";
alias parser = "coral-parser";
alias common = "coral-common";
alias diag = "coral-diagnostics";
alias ast = "coral-ast";
alias sem = "coral-semantics";

task "run" {
    after = ["build"];
    exec  = "build/coralc";
}
