// Package root for `mod wallvm = import(lib, "wallvm")`.
// Re-exports every submodule file under wallvm/ (recursively).

pub mod domtree = import(lib, "wallvm/domtree.crl");
pub mod wallvm = import(lib, "wallvm/wallvm.crl");
pub mod extern_decl = import(lib, "wallvm/ffi/extern.crl");
pub mod irBuilder = import(lib, "wallvm/ir_builder.crl");
pub mod irOps = import(lib, "wallvm/ir_opcodes.crl");
pub mod irTypes = import(lib, "wallvm/ir_types.crl");
pub mod regalloc = import(lib, "wallvm/regalloc/lsra.crl");
pub mod graphRegalloc = import(lib, "wallvm/regalloc/graph.crl");
pub mod gc = import(lib, "wallvm/gc/gc.crl");
pub mod irParser = import(lib, "wallvm/ir_parser.crl");
pub mod irMetadata = import(lib, "wallvm/ir_metadata.crl");
pub mod irStrings = import(lib, "wallvm/ir_strings.crl");
pub mod asm_rules = import(lib, "wallvm/rules/asm_rules.crl");

pub mod noret = import(lib, "wallvm/noret/.noret.crl");
pub mod passes = import(lib, "wallvm/passes/.passes.crl");
pub mod target = import(lib, "wallvm/target/.target.crl");