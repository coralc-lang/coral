mod std = import(lib, "std");

pub void sortI32(std::vec::vec<i32>* v)
{
    sortI32Range(v, 0, v*.count());
}

void sortI32Range(std::vec::vec<i32>* v, usize lo, usize hi)
{
    if (hi - lo <= 1) return;
    usize pi = partitionI32(v, lo, hi);
    if (pi > lo) sortI32Range(v, lo, pi);
    if (pi + 1 < hi) sortI32Range(v, pi + 1, hi);
}

usize partitionI32(std::vec::vec<i32>* v, usize lo, usize hi)
{
    usize mid = lo + (hi - 1 - lo) / 2;
    usize pIdx = hi - 1;
    i32 a = v*.at(lo);
    i32 b = v*.at(mid);
    i32 c = v*.at(hi - 1);
    if ((a < b) != (a < c)) pIdx = lo;
    else if ((b < a) != (b < c)) pIdx = mid;
    i32 pivot = v*.at(pIdx);
    usize i = lo;
    for (usize j = lo; j < hi - 1; j++)
    {
        if (v*.at(j) < pivot)
        {
            i32 tmp = v*.at(i);
            v*.set(i, v*.at(j));
            v*.set(j, tmp);
            i++;
        }
    }
    i32 tmp = v*.at(i);
    v*.set(i, v*.at(pIdx));
    v*.set(pIdx, tmp);
    return i;
}

