pub void sortBy<T>(std::vec::vec<T>* v, bool(T, T) less)
{
    sortByRange<T>(v, 0, v*.count(), less);
}

void sortByRange<T>(std::vec::vec<T>* v, usize lo, usize hi, bool(T, T) less)
{
    if (hi - lo <= 1) return;
    usize pi = partitionBy<T>(v, lo, hi, less);
    if (pi > lo) sortByRange<T>(v, lo, pi, less);
    if (pi + 1 < hi) sortByRange<T>(v, pi + 1, hi, less);
}

usize partitionBy<T>(std::vec::vec<T>* v, usize lo, usize hi, bool(T, T) less)
{
    usize mid = lo + (hi - 1 - lo) / 2;
    usize pIdx;
    T la = v*.at(lo);
    T mb = v*.at(mid);
    T hc = v*.at(hi - 1);
    if (less(la, mb) && less(la, hc))
    {
        if (less(mb, hc)) pIdx = mid;
        else pIdx = hi - 1;
    }
    else if (less(mb, la) && less(mb, hc))
    {
        if (less(la, hc)) pIdx = lo;
        else pIdx = hi - 1;
    }
    else
    {
        if (less(la, mb)) pIdx = lo;
        else pIdx = mid;
    }
    T pivot = v*.at(pIdx);
    usize i = lo;
    for (usize j = lo; j < hi - 1; j++)
    {
        if (less(v*.at(j), pivot))
        {
            T tmp = v*.at(i);
            v*.set(i, v*.at(j));
            v*.set(j, tmp);
            i++;
        }
    }
    T tmp = v*.at(i);
    v*.set(i, v*.at(pIdx));
    v*.set(pIdx, tmp);
    return i;
}

pub bool isSortedI32(const std::vec::vec<i32>* v)
{
    for (usize i = 1; i < v*.count(); i++)
        if (v*.at(i - 1) > v*.at(i)) return false;
    return true;
}

pub bool isSortedusize(const std::vec::vec<usize>* v)
{
    for (usize i = 1; i < v*.count(); i++)
        if (v*.at(i - 1) > v*.at(i)) return false;
    return true;
}

pub bool isSortedBy<T>(const std::vec::vec<T>* v, bool(T, T) less)
{
    for (usize i = 1; i < v*.count(); i++)
        if (less(v*.at(i), v*.at(i - 1))) return false;
    return true;
}

pub isize binarySearchI32(const std::vec::vec<i32>* v, i32 key)
{
    i64 lo = 0;
    i64 hi = (i64)v*.count() - 1;
    while (lo <= hi)
    {
        i64 mid = lo + (hi - lo) / 2;
        i32 val = v*.at((usize)mid);
        if (val == key) return mid;
        if (val < key) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

pub isize binarySearchusize(const std::vec::vec<usize>* v, usize key)
{
    i64 lo = 0;
    i64 hi = (i64)v*.count() - 1;
    while (lo <= hi)
    {
        i64 mid = lo + (hi - lo) / 2;
        usize val = v*.at((usize)mid);
        if (val == key) return mid;
        if (val < key) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

pub isize binarySearchBy<T>(const std::vec::vec<T>* v, T key, i32(T, T) cmp)
{
    i64 lo = 0;
    i64 hi = (i64)v*.count() - 1;
    while (lo <= hi)
    {
        i64 mid = lo + (hi - lo) / 2;
        i32 c = cmp(key, v*.at((usize)mid));
        if (c == 0) return mid;
        if (c > 0) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

pub void reverse<T>(std::vec::vec<T>* v)
{
    usize n = v*.count();
    for (usize i = 0; i < n / 2; i++)
    {
        T tmp = v*.at(i);
        v*.set(i, v*.at(n - 1 - i));
        v*.set(n - 1 - i, tmp);
    }
}