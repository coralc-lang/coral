mod std = import(lib, "std");

pub struct unordered_map<K, V>
{
    std::hashmap::hashmap<K, V> inner;

    static unordered_map<K, V> new(usize(K) hf, bool(K, K) ef)
    {
        unordered_map<K, V> m;
        m.inner = std::hashmap::hashmap<K, V>::new(hf, ef);
        return m;
    }

    void dispose() { self.inner.dispose(); }
    usize count() { return self.inner.count(); }
    bool isEmpty() { return self.inner.count() == 0; }

    void insert(K key, V value)
    {
        self.inner.insert(key, value);
    }

    std::option::option<V> get(K key)
    {
        return self.inner.get(key);
    }

    V* getPtr(K key)
    {
        return self.inner.getPtr(key);
    }

    bool contains(K key)
    {
        return self.inner.contains(key);
    }

    void remove(K key)
    {
        self.inner.remove(key);
    }

    void clear()
    {
        self.inner.clear();
    }

    std::vec::vec<K> keys()
    {
        return self.inner.keys();
    }

    std::vec::vec<V> values()
    {
        return self.inner.values();
    }

    void each(void(K, V) fn)
    {
        self.inner.each(fn);
    }
}

trait drop
{
    void drop();
}

unordered_map::drop
{
    void drop()
    {
        self.dispose();
    }
}

pub unordered_map<K, V> new<K, V>(usize(K) hf, bool(K, K) ef)
{
    return unordered_map<K, V>::new(hf, ef);
}