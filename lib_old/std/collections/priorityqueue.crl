mod std = import(lib, "std");

pub struct priorityqueue<T>
{
    T* data;
    usize len;
    usize cap;
    bool(T, T) less;

    static priorityqueue<T> new(bool(T, T) cmp)
    {
        priorityqueue<T> pq;
        pq.data = std::mman::alloc<T>(16);
        pq.len = 0;
        pq.cap = 16;
        pq.less = cmp;
        return pq;
    }

    void dispose()
    {
        if (self.data != null) { std::mman::dealloc<T>(self.data); self.data = null; }
        self.len = 0;
        self.cap = 0;
    }

    usize count() { return self.len; }
    bool isEmpty() { return self.len == 0; }

    void _grow()
    {
        usize newCap = self.cap * 2;
        T* newData = std::mman::alloc<T>(newCap);
        for (usize i = 0; i < self.len; i++) newData[i] = self.data[i];
        std::mman::dealloc<T>(self.data);
        self.data = newData;
        self.cap = newCap;
    }

    void _siftUp(usize idx)
    {
        while (idx > 0)
        {
            usize parent = (idx - 1) / 2;
            if (!self.less(self.data[idx], self.data[parent])) break;
            T tmp = self.data[idx];
            self.data[idx] = self.data[parent];
            self.data[parent] = tmp;
            idx = parent;
        }
    }

    void _siftDown(usize idx)
    {
        for (;;)
        {
            usize smallest = idx;
            usize left = 2 * idx + 1;
            usize right = 2 * idx + 2;
            if (left < self.len && self.less(self.data[left], self.data[smallest])) smallest = left;
            if (right < self.len && self.less(self.data[right], self.data[smallest])) smallest = right;
            if (smallest == idx) break;
            T tmp = self.data[idx];
            self.data[idx] = self.data[smallest];
            self.data[smallest] = tmp;
            idx = smallest;
        }
    }

    void push(T val)
    {
        if (self.len >= self.cap) self._grow();
        self.data[self.len] = val;
        self._siftUp(self.len);
        self.len++;
    }

    T pop()
    {
        assert(self.len > 0);
        T val = self.data[0];
        self.len--;
        if (self.len > 0)
        {
            self.data[0] = self.data[self.len];
            self._siftDown(0);
        }
        return val;
    }

    T peek()
    {
        assert(self.len > 0);
        return self.data[0];
    }

    void clear()
    {
        self.len = 0;
    }
}

trait drop
{
    void drop();
}

priorityqueue<T>::drop
{
    void drop()
    {
        self.dispose();
    }
}