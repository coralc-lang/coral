mod std = import(lib, "std");

pub std::vec::vec<U> map<T, U>(const std::vec::vec<T>* v, U(T) fn)
{
    std::vec::vec<U> result = std::vec::vec<U>::withCap(v*.count());
    for (usize i = 0; i < v*.count(); i++)
        result.push(fn(v*.at(i)));
    return result;
}

pub std::vec::vec<T> filter<T>(const std::vec::vec<T>* v, bool(T) pred)
{
    std::vec::vec<T> result = std::vec::vec<T>::new();
    for (usize i = 0; i < v*.count(); i++)
    {
        T val = v*.at(i);
        if (pred(val)) result.push(val);
    }
    return result;
}

pub T reduce<T>(const std::vec::vec<T>* v, T init, T(T, T) fn)
{
    T acc = init;
    for (usize i = 0; i < v*.count(); i++)
        acc = fn(acc, v*.at(i));
    return acc;
}

pub void forEach<T>(const std::vec::vec<T>* v, void(T) fn)
{
    for (usize i = 0; i < v*.count(); i++)
        fn(v*.at(i));
}

pub T find<T>(const std::vec::vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v*.count(); i++)
    {
        T val = v*.at(i);
        if (pred(val)) return val;
    }
    return T();
}

pub isize findIndex<T>(const std::vec::vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v*.count(); i++)
        if (pred(v*.at(i))) return (i64)i;
    return -1;
}

pub bool any<T>(const std::vec::vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v*.count(); i++)
        if (pred(v*.at(i))) return true;
    return false;
}

pub bool all<T>(const std::vec::vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v*.count(); i++)
        if (!pred(v*.at(i))) return false;
    return true;
}

pub std::vec::vec<T> take<T>(const std::vec::vec<T>* v, usize n)
{
    usize count = n < v*.count() ? n : v*.count();
    std::vec::vec<T> result = std::vec::vec<T>::withCap(count);
    for (usize i = 0; i < count; i++)
        result.push(v*.at(i));
    return result;
}

pub std::vec::vec<T> skip<T>(const std::vec::vec<T>* v, usize n)
{
    if (n >= v*.count()) return std::vec::vec<T>::new();
    usize remaining = v*.count() - n;
    std::vec::vec<T> result = std::vec::vec<T>::withCap(remaining);
    for (usize i = n; i < v*.count(); i++)
        result.push(v*.at(i));
    return result;
}

pub std::vec::vec<T> slice<T>(const std::vec::vec<T>* v, usize start, usize end)
{
    if (start >= end || start >= v*.count()) return std::vec::vec<T>::new();
    usize e = end < v*.count() ? end : v*.count();
    usize n = e - start;
    std::vec::vec<T> result = std::vec::vec<T>::withCap(n);
    for (usize i = start; i < e; i++)
        result.push(v*.at(i));
    return result;
}

pub struct Pair<T, U>
{
    T first;
    U second;
}

pub std::vec::vec<Pair<T, U>> zip<T, U>(const std::vec::vec<T>* a, const std::vec::vec<U>* b)
{
    usize n = a*.count() < b*.count() ? a*.count() : b*.count();
    std::vec::vec<Pair<T, U>> result = std::vec::vec<Pair<T, U>>::withCap(n);
    for (usize i = 0; i < n; i++)
    {
        Pair<T, U> p;
        p.first = a*.at(i);
        p.second = b*.at(i);
        result.push(p);
    }
    return result;
}

pub usize countIf<T>(const std::vec::vec<T>* v, bool(T) pred)
{
    usize n = 0;
    for (usize i = 0; i < v*.count(); i++)
        if (pred(v*.at(i))) n++;
    return n;
}

pub T minBy<T>(const std::vec::vec<T>* v, bool(T, T) less)
{
    assert(v*.count() > 0);
    T best = v*.at(0);
    for (usize i = 1; i < v*.count(); i++)
    {
        T val = v*.at(i);
        if (less(val, best)) best = val;
    }
    return best;
}

pub T maxBy<T>(const std::vec::vec<T>* v, bool(T, T) less)
{
    assert(v*.count() > 0);
    T best = v*.at(0);
    for (usize i = 1; i < v*.count(); i++)
    {
        T val = v*.at(i);
        if (less(best, val)) best = val;
    }
    return best;
}

pub std::vec::vec<T> unique<T>(const std::vec::vec<T>* v, bool(T, T) eq)
{
    std::vec::vec<T> result = std::vec::vec<T>::new();
    for (usize i = 0; i < v*.count(); i++)
    {
        T val = v*.at(i);
        bool found = false;
        for (usize j = 0; j < result.count(); j++)
        {
            if (eq(val, result.at(j))) { found = true; break; }
        }
        if (!found) result.push(val);
    }
    return result;
}

pub std::vec::vec<T> flatten<T>(const std::vec::vec<std::vec::vec<T>>* v)
{
    usize total = 0;
    for (usize i = 0; i < v*.count(); i++)
        total += v*.at(i).count();
    std::vec::vec<T> result = std::vec::vec<T>::withCap(total);
    for (usize i = 0; i < v*.count(); i++)
    {
        std::vec::vec<T> inner = v*.at(i);
        for (usize j = 0; j < inner.count(); j++)
            result.push(inner.at(j));
    }
    return result;
}

pub std::vec::vec<usize> enumerate<T>(const std::vec::vec<T>* v)
{
    std::vec::vec<usize> result = std::vec::vec<usize>::withCap(v*.count());
    for (usize i = 0; i < v*.count(); i++)
        result.push(i);
    return result;
}

pub T sum<T>(const std::vec::vec<T>* v)
{
    assert(v*.count() > 0);
    T total = v*.at(0);
    for (usize i = 1; i < v*.count(); i++)
        total = total + v*.at(i);
    return total;
}

pub f64 average(const std::vec::vec<f64>* v)
{
    if (v*.count() == 0) return 0.0;
    f64 total = 0.0;
    for (usize i = 0; i < v*.count(); i++)
        total += v*.at(i);
    return total / (f64)v*.count();
}
