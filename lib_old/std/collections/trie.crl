mod std = import(lib, "std");

const u32 TRIE_FANOUT = 256;

pub struct TrieNode
{
    TrieNode* children[TRIE_FANOUT];
    bool isEnd;
}

pub struct trie
{
    TrieNode* root;
    usize count;

    static trie new()
    {
        trie t;
        t.root = null;
        t.count = 0;
        return t;
    }

    void dispose()
    {
        self._disposeNode(self.root);
        self.root = null;
        self.count = 0;
    }

    void _disposeNode(TrieNode* node)
    {
        if (node == null) return;
        for (usize i = 0; i < TRIE_FANOUT; i++)
            self._disposeNode(node*.children[i]);
        std::mman::dealloc<TrieNode>(node);
    }

    usize size() { return self.count; }
    bool isEmpty() { return self.count == 0; }

    void insert(str key)
    {
        if (self.root == null)
        {
            self.root = std::mman::alloc<TrieNode>(1);
            for (usize i = 0; i < TRIE_FANOUT; i++) self.root*.children[i] = null;
            self.root*.isEnd = false;
        }
        TrieNode* cur = self.root;
        for (usize i = 0; i < key.len; i++)
        {
            usize idx = (usize)(u8)key.ptr[i];
            if (cur*.children[idx] == null)
            {
                cur*.children[idx] = std::mman::alloc<TrieNode>(1);
                for (usize j = 0; j < TRIE_FANOUT; j++) cur*.children[idx]*.children[j] = null;
                cur*.children[idx]*.isEnd = false;
            }
            cur = cur*.children[idx];
        }
        if (!cur*.isEnd) { cur*.isEnd = true; self.count++; }
    }

    bool contains(str key)
    {
        TrieNode* cur = self.root;
        if (cur == null) return false;
        for (usize i = 0; i < key.len; i++)
        {
            usize idx = (usize)(u8)key.ptr[i];
            if (cur*.children[idx] == null) return false;
            cur = cur*.children[idx];
        }
        return cur*.isEnd;
    }

    bool startsWith(str prefix)
    {
        TrieNode* cur = self.root;
        if (cur == null) return false;
        for (usize i = 0; i < prefix.len; i++)
        {
            usize idx = (usize)(u8)prefix.ptr[i];
            if (cur*.children[idx] == null) return false;
            cur = cur*.children[idx];
        }
        return true;
    }

    bool remove(str key)
    {
        if (self.root == null) return false;
        return self._remove(self.root, key, 0);
    }

    bool _remove(TrieNode* node, str key, usize depth)
    {
        if (depth == key.len)
        {
            if (!node*.isEnd) return false;
            node*.isEnd = false;
            self.count--;
            return true;
        }
        usize idx = (usize)(u8)key.ptr[depth];
        if (node*.children[idx] == null) return false;
        bool result = self._remove(node*.children[idx], key, depth + 1);
        if (result && !node*.children[idx]*.isEnd)
        {
            bool hasChild = false;
            for (usize j = 0; j < TRIE_FANOUT; j++)
            {
                if (node*.children[idx]*.children[j] != null) { hasChild = true; break; }
            }
            if (!hasChild)
            {
                std::mman::dealloc<TrieNode>(node*.children[idx]);
                node*.children[idx] = null;
            }
        }
        return result;
    }

    void each(void(str) fn)
    {
        usize maxDepth = 0;
        self._maxDepth(self.root, 0, &maxDepth);
        usize cap = maxDepth > 0 ? maxDepth : 1;
        u8* buf = std::mman::alloc<u8>(cap);
        self._each(self.root, buf, cap, 0, fn);
        std::mman::dealloc<u8>(buf);
    }

    void _maxDepth(TrieNode* node, usize depth, usize* max)
    {
        if (node == null) return;
        if (node*.isEnd && depth > *max) *max = depth;
        for (usize i = 0; i < TRIE_FANOUT; i++)
        {
            if (node*.children[i] != null)
                self._maxDepth(node*.children[i], depth + 1, max);
        }
    }

    void _each(TrieNode* node, u8* buf, usize cap, usize depth, void(str) fn)
    {
        if (node == null) return;
        if (node*.isEnd)
            fn(str::fromParts((const u8*)buf, depth));
        for (usize i = 0; i < TRIE_FANOUT; i++)
        {
            if (node*.children[i] != null)
            {
                buf[depth] = (u8)i;
                self._each(node*.children[i], buf, cap, depth + 1, fn);
            }
        }
    }
}

trait drop
{
    void drop();
}

trie::drop
{
    void drop()
    {
        self.dispose();
    }
}