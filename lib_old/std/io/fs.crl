import(lib) std { libc, mman, string, fios, };

pub constexpr i32 O_RDONLY = 0;
pub constexpr i32 O_WRONLY = 1;
pub constexpr i32 O_RDWR = 2;
pub constexpr i32 O_CREAT = 64;
pub constexpr i32 O_TRUNC = 512;
pub constexpr i32 O_APPEND = 1024;
pub constexpr i32 S_IRWXU = 448;
pub constexpr i32 S_IRUSR = 256;
pub constexpr i32 S_IWUSR = 128;
pub constexpr i32 S_IXUSR = 64;
pub constexpr i32 SEEK_SET = 0;
pub constexpr i32 SEEK_CUR = 1;
pub constexpr i32 SEEK_END = 2;
pub constexpr i32 F_OK = 0;
pub constexpr i32 R_OK = 4;
pub constexpr i32 W_OK = 2;
pub constexpr i32 X_OK = 1;

pub distinct File = i32;
pub distinct Dir = rawptr;

// had tp checkt to make sure Layout matches glibc x86-64 struct stat and the BSDs' old stat
pub struct Stat
{
    u64 st_dev;
    u64 st_ino;
    u64 st_nlink;
    u32 st_mode;
    u32 st_uid;
    u32 st_gid;
    u32 pad0;
    u64 st_rdev;
    i64 st_size;
    i64 st_blksize;
    i64 st_blocks;
    i64 st_atime;
    i64 st_atimeNsec;
    i64 st_mtime;
    i64 st_mtimeNsec;
    i64 st_ctime;
    i64 st_ctimeNsec;
    i64 reserved[3];
}

pub enum FileType
{
    Unknown,
    Regular,
    Directory,
    CharDevice,
    BlockDevice,
    Fifo,
    Symlink,
    Socket,
}

pub File fileOpen(str path, str mode)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;

    i32 flags = -1;
    bool create = false;
    if (mode.len >= 1)
    {
        if (mode.ptr[0] == 'r') flags = O_RDONLY;
        else if (mode.ptr[0] == 'w') { flags = O_WRONLY | O_CREAT | O_TRUNC; create = true; }
        else if (mode.ptr[0] == 'a') { flags = O_WRONLY | O_CREAT | O_APPEND; create = true; }
    }
    if (flags < 0) return (File)(-1);
    for (usize i = 1; i < mode.len; i++)
    {
        if (mode.ptr[i] == '+') { flags = (flags & ~(O_RDONLY | O_WRONLY)) | O_RDWR; }
    }
    i32 fd = libc::open(pbuf, flags, create ? 420 : 0);
    return (File)fd;
}

pub void fileClose(File f)
{
    libc::close((i32)f);
}

pub isize fileRead(File f, u8* buf, usize count)
{
    return libc::read((i32)f, buf, count);
}

pub isize fileWrite(File f, const u8* buf, usize count)
{
    return libc::write((i32)f, buf, count);
}

pub isize fileSeek(File f, isize offset, i32 whence)
{
    return libc::lseek((i32)f, offset, whence);
}

pub bool fileExists(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return libc::access(pbuf, F_OK) == 0;
}

pub bool statPath(str path, Stat* out)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return libc::stat(pbuf, (rawptr)out) == 0;
}

pub FileType getFileType(const Stat* s)
{
    u32 mode = s*.st_mode;
    if ((mode & 0xF000) == 0x8000) return FileType::Regular;
    if ((mode & 0xF000) == 0x4000) return FileType::Directory;
    if ((mode & 0xF000) == 0x2000) return FileType::CharDevice;
    if ((mode & 0xF000) == 0x6000) return FileType::BlockDevice;
    if ((mode & 0xF000) == 0x1000) return FileType::Fifo;
    if ((mode & 0xF000) == 0xA000) return FileType::Symlink;
    if ((mode & 0xF000) == 0xC000) return FileType::Socket;
    return FileType::Unknown;
}

pub bool createDir(str path, i32 mode)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return libc::mkdir(pbuf, mode) == 0;
}

pub bool removeDir(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return libc::rmdir(pbuf) == 0;
}

pub bool deleteFile(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return libc::unlink(pbuf) == 0;
}

pub bool renameFile(str oldPath, str newPath)
{
    u8 oldBuf[4096];
    u8 newBuf[4096];
    usize olen = oldPath.len < 4095 ? oldPath.len : 4095;
    usize nlen = newPath.len < 4095 ? newPath.len : 4095;
    mman::copy<u8>(oldBuf, (const u8*)oldPath.ptr, olen);
    mman::copy<u8>(newBuf, (const u8*)newPath.ptr, nlen);
    oldBuf[olen] = 0; newBuf[nlen] = 0;
    return libc::rename(oldBuf, newBuf) == 0;
}

pub bool canAccess(str path, i32 mode)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return libc::access(pbuf, mode) == 0;
}

pub Dir openDir(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    mman::copy<u8>(pbuf, (const u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return (Dir)libc::opendir(pbuf);
}

pub rawptr readDir(Dir dir)
{
    return libc::readdir((rawptr)dir);
}

pub void closeDir(Dir dir)
{
    libc::closedir((rawptr)dir);
}

pub string::String readFileToString(str path)
{
    File f = fileOpen(path, str::fromCstr("r"));
    if ((i32)f < 0) return string::String::new();
     string::String out = string::String::new();
    u8 chunk[4096];
    for (;;)
    {
        isize n = fileRead(f, (u8*)chunk, 4096);
        if (n <= 0) break;
        out.appendView(str::fromParts(chunk, (usize)n));
    }
    fileClose(f);
    return out;
}

// glibc x86-64 struct dirent (fields we need; reclen-padded tail omitted).
// Layout verified against bits/dirent.h: d_ino u64, d_off i64, d_reclen u16,
// d_type u8, d_name std.cchar[256].
pub struct Dirent
{
    u64 d_ino;
    i64 d_off;
    u16 d_reclen;
    u8 d_type;
    u8 d_name[256];
}

// Read the next directory entry; false at end of stream.
pub bool readDirEntry(Dir dir, Dirent* out)
{
    rawptr raw = readDir(dir);
    if (raw == null) return false;
    mman::copy<u8>((u8*)out, (const u8*)raw, (usize)sizeof(Dirent));
    return true;
}

// mkdir -p behavior: create every missing component of `path`.
// mode 0755 by convention here (pass 493u).
pub bool createDirRecursive(str path, i32 mode)
{
    if (path.len == 0) return false;
    Stat st;
    if (statPath(path, &st)) return true; // already exists
    // find parent and recurse first
    u32 lastSlash = 0;
    bool hasSlash = false;
    for (usize i = 0; i < path.len; i++)
        if (path.ptr[i] == '/') { lastSlash = (u32)i; hasSlash = true; }
    if (hasSlash && lastSlash > 0)
        createDirRecursive(str::fromParts(path.ptr, lastSlash), mode);
    return createDir(path, mode);
}

// Write an entire String to `path` (truncates). Returns success.
pub bool writeFileFromString(str path, const string::String* data)
{
    fios::FileHandle fh = fios::fileOpen(path, str::fromCstr("w"));
    if (fh == null) return false;
    fios::fileWriteString(fh, data);
    fios::fileClose(fh);
    return true;
}
