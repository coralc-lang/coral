mod std = import(lib, "std");

pub string get(str name)
{
    std.cchar* buf = (std.cchar*)std::mman::alloc<u8>(name.len + 1);
    std::mman::copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    std.cchar* val = std::libc::getenv(buf);
    if (val == null)
    {
        std::mman::dealloc<u8>((u8*)buf);
        return string::new();
    }
    string result = string.fromView(str::fromCstr(val));
    std::mman::dealloc<u8>((u8*)buf);
    return result;
}

pub bool getInto(str name, string* out)
{
    std.cchar* buf = (std.cchar*)std::mman::alloc<u8>(name.len + 1);
    std::mman::copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    std.cchar* val = std::libc::getenv(buf);
    std::mman::dealloc<u8>((u8*)buf);
    if (val == null) return false;
    out*.free();
    *out = string.fromView(str::fromCstr(val));
    return true;
}

pub bool set(str name, str value)
{
    std.cchar* nbuf = (std.cchar*)std::mman::alloc<u8>(name.len + 1);
    std.cchar* vbuf = (std.cchar*)std::mman::alloc<u8>(value.len + 1);
    std::mman::copy<u8>(nbuf, (const u8*)name.ptr, name.len);
    std::mman::copy<u8>(vbuf, (const u8*)value.ptr, value.len);
    nbuf[name.len] = 0; vbuf[value.len] = 0;
    i32 rc = std::libc::setenv(nbuf, vbuf, 1);
    std::mman::dealloc<u8>((u8*)nbuf);
    std::mman::dealloc<u8>((u8*)vbuf);
    return rc == 0;
}

pub bool unset(str name)
{
    std.cchar* buf = (std.cchar*)std::mman::alloc<u8>(name.len + 1);
    std::mman::copy<u8>(buf, (const u8*)name.ptr, name.len);
    buf[name.len] = 0;
    i32 rc = std::libc::unsetenv(buf);
    std::mman::dealloc<u8>((u8*)buf);
    return rc == 0;
}

pub usize all(vec<string>* out)
{
    std.cchar** env = std::libc::environ;
    usize count = 0;
    while (env[count] != null) count++;
    for (usize i = 0; i < count; i++)
        out*.push(string.fromView(str::fromCstr(env[i])));
    return count;
}