mod std = import(lib, "std");

pub distinct FileHandle = rawptr; // i used distinct, cuz i don't want niggas randomly placing a rawptr in place of it
                                 // niggas gonna need to ocast it. then, they's on their own

pub FileHandle fileOpen(str path, str mode)
{
    u8 pathBuf[4096];
    u8 modeBuf[16];
    usize plen = path.len < 4095u ? path.len : 4095u;
    usize mlen = mode.len < 15 ? mode.len : 15u;
    std::mman::copy<u8>(pathBuf, (const u8*)path.ptr, plen);
    std::mman::copy<u8>(modeBuf, (const u8*)mode.ptr, mlen);
    pathBuf[plen] = 0;
    modeBuf[mlen] = 0;
    return (FileHandle)std::libc::fopen(pathBuf, modeBuf);
}

pub void fileClose(FileHandle fh)
{
    std::libc::fclose((rawptr)fh);
}

pub usize fileWrite(FileHandle fh, str data)
{
    return std::libc::fwrite(data.ptr, 1u, data.len, (rawptr)fh);
}

pub usize fileRead(FileHandle fh, u8* buf, usize maxLen)
{
    return std::libc::fread(buf, 1u, maxLen, (rawptr)fh);
}

pub bool fileEof(FileHandle fh)
{
    return std::libc::feof((rawptr)fh) != 0;
}

pub bool fileError(FileHandle fh)
{
    return std::libc::ferror((rawptr)fh) != 0;
}

pub void fileFlush(FileHandle fh)
{
    std::libc::fflush((rawptr)fh);
}

pub usize fileWriteString(FileHandle fh, const std::string::String* s)
{
    return std::libc::fwrite(s*.ptr, 1u, s*.len, (rawptr)fh);
}

pub bool fileReadAll(str path, std::string::String* out)
{
    FileHandle fh = fileOpen(path, str::fromCstr("rb"));
    if (fh == (FileHandle)0) return false;
    u8 chunk[4096];
    for (;;)
    {
        usize n = fileRead(fh, chunk, 4096u);
        if (n == 0u) break;
        out*.pushView(str::fromParts(chunk, n));
    }
    bool ok = !fileError(fh);
    fileClose(fh);
    return ok;
}