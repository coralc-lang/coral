mod std = import(lib, "std");

// mimalloc - High-performance memory allocator
// Architecture: Arena → Segment → Page → Block
// Features: free list sharding, size-class pages, cross-thread free, page retirement

const u64 MI_ARENA_SIZE = 64 * 1024 * 1024;     // 64 MiB arenas
const u64 MI_SEGMENT_SIZE = 4 * 1024 * 1024;     // 4 MiB segments
const u64 MI_PAGE_SIZE = 64 * 1024;               // 64 KiB pages
const u64 MI_SLICE_SIZE = 64 * 1024;              // 64 KiB slices
const u32 MI_ALIGN = 16;
const u32 MI_MAX_BLOCK_SIZE = 512 * 1024;         // 512 KiB max block
const u32 MI_SMALL_PAGE_MAX = 64 * 1024;          // max size for small pages
const u32 MI_MEDIUM_PAGE_MAX = 512 * 1024;        // max size for medium pages
const u32 MI_HUGE_THRESHOLD = 128 * 1024;         // 128 KiB huge page threshold
const u32 MI_INITIAL_CAPACITY = 4;                // start with 4 blocks
const u32 MI_SEGMENT_MAP_SIZE = 64;               // hash table size for O(1) lookup

// Size classes (44 total):
// Small: 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256
// Medium: 320, 384, 448, 512, 640, 768, 896, 1024, 1280, 1536, 1792, 2048,
//         2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192
// Large: 10240, 12288, 14336, 16384 (handled as single-block pages)
const u32 MI_SIZE_CLASS_COUNT = 44;

// Block: when free, contains pointer to next free block
struct MiBlock
{
    MiBlock* next;
}

// Hash table entry for O(1) page lookup
struct MiSegmentMapEntry
{
    u8* pageBase;            // key: page base address
    MiPage* page;            // value: page pointer
    MiSegmentMapEntry* next; // collision chain
}

// Hash table mapping page base addresses to MiPage pointers
struct MiSegmentMap
{
    MiSegmentMapEntry* buckets[MI_SEGMENT_MAP_SIZE];
}

// Three free lists per page for sharding
struct MiPage
{
    MiPage* next;
    MiPage* prev;
    u32 sizeClass;
    u32 blockSize;
    u32 capacity;
    u32 used;
    u32 freeCount;
    u32 reserved;           // current reserved capacity (for incremental extension)
    u8* base;
    MiBlock* free;           // thread-local free list (fast path)
    MiBlock* localFree;      // freed by owning thread while page active
    MiBlock* xthreadFree;    // freed by other threads (atomic)
    u32 xthreadFreeCount;
    MiSegment* segment;
    u32 pageIdx;
    bool retired;
    u32 retireCount;         // retirement expiry counter
    u64 key1;                // free list pointer encoding key (rotation amount)
    u64 key2;                // free list pointer encoding key (XOR mask)
}

// Segment: contains multiple pages of the same or different size classes
struct MiSegment
{
    MiSegment* next;
    MiSegment* prev;
    u8* base;
    usize size;
    u32 pageCount;
    u32 usedCount;
    MiPage* pages;
    MiArena* arena;
}

// Arena: large OS region, shared across threads
struct MiArena
{
    MiArena* next;
    u8* base;
    usize size;
    u64* bitmap;
    u64 bitmapWords;
    u32 sliceCount;
    u32 usedSlices;
}

// Thread-local heap
struct MiHeap
{
    MiPage* pages[MI_SIZE_CLASS_COUNT];
    MiPage* freePages[MI_SIZE_CLASS_COUNT];
    u32 pageCounts[MI_SIZE_CLASS_COUNT];
    MiArena* arenas;
    MiSegment* segments;
    usize totalAllocated;
    usize totalFreed;
    usize mapped;
    u32 pageSize[MI_SIZE_CLASS_COUNT];
    u32 threadId;
    MiSpinLock lock;         // protects cross-thread operations
    MiBlock* delayedFree;    // delayed free list for cross-thread frees
    MiPage* fullPages;       // pages with no free blocks
    MiPage* hugePages;       // huge allocation pages
    MiSegmentMap segmentMap; // O(1) page lookup
}

// Size class tables
const u32 MI_BLOCK_SIZES[MI_SIZE_CLASS_COUNT] = {
    8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256,
    320, 384, 448, 512, 640, 768, 896, 1024, 1280, 1536, 1792, 2048,
    2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192,
    10240, 12288, 14336, 16384, 20480, 24576, 28672, 32768
};

const u32 MI_PAGE_SIZES[MI_SIZE_CLASS_COUNT] = {
    4096, 4096, 4096, 4096, 4096, 4096, 4096, 4096,
    8192, 8192, 8192, 8192, 16384, 16384, 16384, 16384,
    32768, 32768, 32768, 32768, 65536, 65536, 65536, 65536,
    65536, 65536, 65536, 65536,
    65536, 65536, 65536, 65536, 65536, 65536, 65536, 65536,
    65536, 65536, 65536, 65536, 65536, 65536, 65536, 65536
};

// Size class lookup table for O(1) size class determination (sizes <= 1024)
// Index = (size - 1) >> 3 for sizes up to 128, then use MI_BLOCK_SIZES for larger
static const u8 MI_SIZE_CLASS_SMALL[129] = {
    0,0,0,0,0,0,0,0,  // 1-8: sc 0 (8)
    1,1,1,1,1,1,1,1,  // 9-16: sc 1 (16)
    2,2,2,2,2,2,2,2,  // 17-24: sc 2 (24)
    3,3,3,3,3,3,3,3,  // 25-32: sc 3 (32)
    4,4,4,4,4,4,4,4,  // 33-40: sc 4 (40)
    5,5,5,5,5,5,5,5,  // 41-48: sc 5 (48)
    6,6,6,6,6,6,6,6,  // 49-56: sc 6 (56)
    7,7,7,7,7,7,7,7,  // 57-64: sc 7 (64)
    8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,  // 65-80: sc 8 (80)
    9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,  // 81-96: sc 9 (96)
    10,10,10,10,10,10,10,10,10,10,10,10,10,10,10,10,  // 97-112: sc 10 (112)
    11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11   // 113-128: sc 11 (128)
};

static u32 _miSizeClass(usize size)
{
    if (size == 0) return 0;
    // Fast path for small sizes (<= 128) using lookup table
    if (size <= 128) return (u32)MI_SIZE_CLASS_SMALL[size];
    // Fast path for medium sizes (129-1024) using division
    if (size <= 1024) return 8 + (u32)((size - 129) / 16);
    // Slow path for large sizes
    for (u32 i = 0; i < MI_SIZE_CLASS_COUNT; i++)
    {
        if (size <= MI_BLOCK_SIZES[i]) return i;
    }
    return MI_SIZE_CLASS_COUNT - 1;
}

static usize _miBlockSize(u32 sc)
{
    return (usize)MI_BLOCK_SIZES[sc];
}

static u32 _miBlocksPerPage(u32 sc)
{
    usize blockSize = _miBlockSize(sc);
    usize pageSize = MI_PAGE_SIZES[sc];
    usize metaSize = (sizeof(MiPage) + 255) & ~256u;
    usize usable = pageSize - metaSize;
    return (u32)(usable / blockSize);
}

// LCG random number generator for free list key generation
static u64 _miRandomU64()
{
    static u64 state = 0x123456789ABCDEF0;
    state = state * 6364136223846793005 + 1442695040888963407;
    return state;
}

// Encode a free list pointer using per-page keys
static void _miFreeBlockEncode(MiBlock* block, MiBlock* next, u64 key1, u64 key2)
{
    u64 raw = (u64)next;
    u64 encoded = ((raw ^ key2) << key1) | ((raw ^ key2) >> (64 - key1));
    block*.next = (MiBlock*)encoded;
}

// Decode a free list pointer using per-page keys
static MiBlock* _miFreeBlockDecode(MiBlock* block, u64 key1, u64 key2)
{
    u64 encoded = (u64)block*.next;
    u64 decoded = ((encoded >> key1) | (encoded << (64 - key1))) ^ key2;
    return (MiBlock*)decoded;
}

// Hash function for segment map
static u32 _miSegmentMapHash(u8* addr)
{
    u64 val = (u64)addr;
    val = (val >> 12) ^ (val >> 24); // use page-aligned bits
    return (u32)(val % MI_SEGMENT_MAP_SIZE);
}

// Simple spinlock for cross-thread operations
struct MiSpinLock
{
    u32 locked;

    void acquire()
    {
        while (self*.locked == 1) { /* spin */ }
        self*.locked = 1;
    }

    void release()
    {
        self*.locked = 0;
    }
}

// Segment map operations
static void _miSegmentMapInsert(MiSegmentMap* map, u8* pageBase, MiPage* page)
{
    u32 idx = _miSegmentMapHash(pageBase);
    MiSegmentMapEntry* entry = (MiSegmentMapEntry*)std::mman::_mmap(null, sizeof(MiSegmentMapEntry), 3, 0x22, -1, 0);
    if (entry == null) return;
    entry*.pageBase = pageBase;
    entry*.page = page;
    entry*.next = map*.buckets[idx];
    map*.buckets[idx] = entry;
}

static void _miSegmentMapRemove(MiSegmentMap* map, u8* pageBase)
{
    u32 idx = _miSegmentMapHash(pageBase);
    MiSegmentMapEntry* prev = null;
    MiSegmentMapEntry* entry = map*.buckets[idx];
    while (entry != null)
    {
        if (entry*.pageBase == pageBase)
        {
            if (prev != null) prev*.next = entry*.next;
            else map*.buckets[idx] = entry*.next;
            std::mman::_munmap((rawptr)entry, sizeof(MiSegmentMapEntry));
            return;
        }
        prev = entry;
        entry = entry*.next;
    }
}

static MiPage* _miSegmentMapLookup(MiSegmentMap* map, u8* addr)
{
    u32 idx = _miSegmentMapHash(addr);
    MiSegmentMapEntry* entry = map*.buckets[idx];
    while (entry != null)
    {
        if (entry*.pageBase == addr) return entry*.page;
        entry = entry*.next;
    }
    return null;
}

// Arena Management

static MiArena* _miArenaAlloc(MiHeap* heap, usize minSize)
{
    usize arenaSize = MI_ARENA_SIZE;
    if (arenaSize < minSize) arenaSize = minSize;

    u8* mem = (u8*)std::mman::_mmap(null, arenaSize, 3, 0x22, -1, 0);
    if (mem == null) return null;

    MiArena* arena = (MiArena*)mem;
    arena*.base = mem;
    arena*.size = arenaSize;
    arena*.sliceCount = (u32)(arenaSize / MI_SLICE_SIZE);
    arena*.bitmapWords = (arena*.sliceCount + 63) / 64;
    arena*.bitmap = (u64*)(mem + sizeof(MiArena));
    arena*.usedSlices = 0;
    arena*.next = heap*.arenas;

    // Initialize bitmap to all free (0)
    for (usize i = 0; i < arena*.bitmapWords; i++)
        arena*.bitmap[i] = 0;

    // Mark header slices as used
    u32 headerSlices = (sizeof(MiArena) + arena*.bitmapWords * 8 + MI_SLICE_SIZE - 1) / MI_SLICE_SIZE;
    for (u32 i = 0; i < headerSlices && i < arena*.sliceCount; i++)
    {
        arena*.bitmap[i / 64] |= (1u << (i % 64));
    }
    arena*.usedSlices = headerSlices;

    heap*.arenas = arena;
    heap*.mapped += arenaSize;
    return arena;
}

static rawptr _miArenaSliceAlloc(MiArena* arena, u32 count)
{
    for (u32 i = 0; i + count <= arena*.sliceCount; i++)
    {
        bool found = true;
        for (u32 j = 0; j < count; j++)
        {
            if (arena*.bitmap[(i + j) / 64] & (1u << ((i + j) % 64)))
            {
                found = false;
                break;
            }
        }
        if (found)
        {
            for (u32 j = 0; j < count; j++)
                arena*.bitmap[(i + j) / 64] |= (1u << ((i + j) % 64));
            arena*.usedSlices += count;
            return arena*.base + (u64)i * MI_SLICE_SIZE;
        }
    }
    return null;
}

static void _miArenaSliceFree(MiArena* arena, rawptr ptr, u32 count)
{
    u8* p = (u8*)ptr;
    u32 startIdx = (u32)((p - arena*.base) / MI_SLICE_SIZE);
    for (u32 j = 0; j < count; j++)
        arena*.bitmap[(startIdx + j) / 64] &= ~(1u << ((startIdx + j) % 64));
    arena*.usedSlices -= count;
}

// Segment Management

static MiSegment* _miSegmentAlloc(MiHeap* heap, u32 pageCount)
{
    usize segSize = (usize)pageCount * MI_PAGE_SIZE;
    if (segSize < MI_SEGMENT_SIZE) segSize = MI_SEGMENT_SIZE;

    // Try arena first
    u32 slicesNeeded = (u32)((segSize + MI_SLICE_SIZE - 1) / MI_SLICE_SIZE);
    MiArena* arena = heap*.arenas;
    while (arena != null)
    {
        rawptr mem = _miArenaSliceAlloc(arena, slicesNeeded);
        if (mem != null)
        {
            MiSegment* seg = (MiSegment*)mem;
            seg*.base = (u8*)mem;
            seg*.size = segSize;
            seg*.pageCount = pageCount;
            seg*.usedCount = 0;
            seg*.arena = arena;
            seg*.pages = null;
            seg*.next = heap*.segments;
            seg*.prev = null;
            if (heap*.segments != null) heap*.segments*.prev = seg;
            heap*.segments = seg;
            return seg;
        }
        arena = arena*.next;
    }

    // Fallback: direct mmap
    u8* mem = (u8*)std::mman::_mmap(null, segSize, 3, 0x22, -1, 0);
    if (mem == null) return null;

    MiSegment* seg = (MiSegment*)mem;
    seg*.base = mem;
    seg*.size = segSize;
    seg*.pageCount = pageCount;
    seg*.usedCount = 0;
    seg*.arena = null;
    seg*.pages = null;
    seg*.next = heap*.segments;
    seg*.prev = null;
    if (heap*.segments != null) heap*.segments*.prev = seg;
    heap*.segments = seg;
    heap*.mapped += segSize;
    return seg;
}

static void _miSegmentFree(MiHeap* heap, MiSegment* seg)
{
    if (seg*.prev != null) seg*.prev*.next = seg*.next;
    else heap*.segments = seg*.next;
    if (seg*.next != null) seg*.next*.prev = seg*.prev;

    if (seg*.arena != null)
    {
        u32 slices = (u32)((seg*.size + MI_SLICE_SIZE - 1) / MI_SLICE_SIZE);
        _miArenaSliceFree(seg*.arena, seg*.base, slices);
    }
    else
    {
        std::mman::_munmap((rawptr)seg, seg*.size);
        heap*.mapped -= seg*.size;
    }
}

// Page Management

static MiPage* _miPageAlloc(MiHeap* heap, u32 sc)
{
    u32 pageSize = MI_PAGE_SIZES[sc];
    u32 pageCount = 1;
    if (pageSize < MI_SEGMENT_SIZE) pageCount = (u32)(MI_SEGMENT_SIZE / pageSize);

    MiSegment* seg = _miSegmentAlloc(heap, pageCount);
    if (seg == null) return null;

    // Page metadata goes at the start, blocks follow after alignment
    usize blockSize = _miBlockSize(sc);
    u32 blocksPerPage = _miBlocksPerPage(sc);
    u32 metaSize = (sizeof(MiPage) + 255) & ~256u; // align to 256 bytes

    MiPage* page = (MiPage*)seg*.base;
    page*.next = null;
    page*.prev = null;
    page*.sizeClass = sc;
    page*.blockSize = (u32)blockSize;
    page*.capacity = MI_INITIAL_CAPACITY; // start small
    page*.used = 0;
    page*.freeCount = MI_INITIAL_CAPACITY;
    page*.reserved = blocksPerPage; // can extend up to this
    page*.base = seg*.base + metaSize; // blocks start after metadata
    page*.free = null;
    page*.localFree = null;
    page*.xthreadFree = null;
    page*.xthreadFreeCount = 0;
    page*.segment = seg;
    page*.pageIdx = 0;
    page*.retired = false;
    page*.retireCount = 0;
    page*.key1 = _miRandomU64() % 64; // rotation amount 0-63
    page*.key2 = _miRandomU64();       // XOR mask

    // Build free list (only initial capacity)
    MiBlock* head = null;
    for (u32 i = 0; i < MI_INITIAL_CAPACITY; i++)
    {
        MiBlock* block = (MiBlock*)(page*.base + (u64)i * blockSize);
        _miFreeBlockEncode(block, head, page*.key1, page*.key2);
        head = block;
    }
    page*.free = head;

    seg*.usedCount = 1;

    // Link into heap
    page*.next = heap*.pages[sc];
    if (heap*.pages[sc] != null)
        heap*.pages[sc]*.prev = page;
    heap*.pages[sc] = page;
    heap*.pageCounts[sc]++;

    // Add to segment map
    _miSegmentMapInsert(&heap*.segmentMap, page*.base, page);

    return page;
}

// Extend page capacity incrementally
static bool _miPageExtend(MiHeap* heap, MiPage* page)
{
    u32 newCap = page*.capacity * 2;
    if (newCap > page*.reserved) newCap = page*.reserved;
    if (newCap <= page*.capacity) return false;

    // Add new blocks to free list
    MiBlock* head = page*.free;
    for (u32 i = page*.capacity; i < newCap; i++)
    {
        MiBlock* block = (MiBlock*)(page*.base + (u64)i * page*.blockSize);
        _miFreeBlockEncode(block, head, page*.key1, page*.key2);
        head = block;
    }
    page*.free = head;
    page*.freeCount += (newCap - page*.capacity);
    page*.capacity = newCap;
    return true;
}

static void _miPageFree(MiHeap* heap, MiPage* page, u32 sc)
{
    // Remove from segment map
    _miSegmentMapRemove(&heap*.segmentMap, page*.base);

    // Unlink from heap
    if (page*.prev != null) page*.prev*.next = page*.next;
    else heap*.pages[sc] = page*.next;
    if (page*.next != null) page*.next*.prev = page*.prev;
    heap*.pageCounts[sc]--;

    // Free segment if page owns it
    MiSegment* seg = page*.segment;
    if (seg != null && seg*.usedCount <= 1)
    {
        _miSegmentFree(heap, seg);
    }
}

// Collect cross-thread free list into local free list
static void _miPageCollect(MiPage* page)
{
    MiBlock* xfree = page*.xthreadFree;
    if (xfree == null) return;

    // Atomically swap xthreadFree to null (single-threaded for now)
    MiBlock* old = xfree;
    page*.xthreadFree = null;
    page*.xthreadFreeCount = 0;

    // Decode and prepend to localFree
    MiBlock* tail = old;
    while (tail != null)
    {
        MiBlock* decoded = _miFreeBlockDecode(tail, page*.key1, page*.key2);
        MiBlock* next = tail*.next; // save before overwriting
        tail*.next = page*.localFree;
        page*.localFree = tail;
        tail = next != null ? decoded : null;
    }
}

// Retire a page with expiry to prevent thrashing
static void _miPageMaybeRetire(MiHeap* heap, MiPage* page, u32 sc)
{
    if (page*.used > 0) { page*.retireCount = 0; return; }

    // Only retire if this is not the only page with free blocks
    u32 freePages = 0;
    MiPage* p = heap*.pages[sc];
    while (p != null) { if (p*.free != null || p*.localFree != null) freePages++; p = p*.next; }

    if (freePages <= 1) return; // Don't retire the last free page

    page*.retireCount++;
    if (page*.retireCount < 16) return; // MI_RETIRE_CYCLES

    // Move to free list for reuse
    if (page*.prev != null) page*.prev*.next = page*.next;
    else heap*.pages[sc] = page*.next;
    if (page*.next != null) page*.next*.prev = page*.prev;
    heap*.pageCounts[sc]--;

    page*.next = heap*.freePages[sc];
    heap*.freePages[sc] = page;
    page*.retired = true;
}

// Move page to fullPages list when it becomes full
static void _miPageMoveToFull(MiHeap* heap, MiPage* page, u32 sc)
{
    // Unlink from pages[sc]
    if (page*.prev != null) page*.prev*.next = page*.next;
    else heap*.pages[sc] = page*.next;
    if (page*.next != null) page*.next*.prev = page*.prev;
    heap*.pageCounts[sc]--;

    // Link into fullPages
    page*.next = heap*.fullPages;
    page*.prev = null;
    if (heap*.fullPages != null) heap*.fullPages*.prev = page;
    heap*.fullPages = page;
}

// Move page from fullPages back to pages[sc] when a block is freed
static void _miPageMoveFromFull(MiHeap* heap, MiPage* page, u32 sc)
{
    // Unlink from fullPages
    if (page*.prev != null) page*.prev*.next = page*.next;
    else heap*.fullPages = page*.next;
    if (page*.next != null) page*.next*.prev = page*.prev;

    // Link into pages[sc]
    page*.next = heap*.pages[sc];
    page*.prev = null;
    if (heap*.pages[sc] != null) heap*.pages[sc]*.prev = page;
    heap*.pages[sc] = page;
    heap*.pageCounts[sc]++;
}

// Allocation Fast Path

static rawptr _miAllocFast(MiHeap* heap, u32 sc)
{
    MiPage* page = heap*.pages[sc];

    // Try thread-local free list first
    if (page != null && page*.free != null)
    {
        MiBlock* block = page*.free;
        MiBlock* next = _miFreeBlockDecode(block, page*.key1, page*.key2);
        page*.free = next;
        page*.used++;
        page*.freeCount--;
        heap*.totalAllocated += _miBlockSize(sc);

        // If page becomes full, move to fullPages
        if (page*.freeCount == 0)
        {
            _miPageMoveToFull(heap, page, sc);
        }

        return (rawptr)block;
    }

    // Collect cross-thread frees
    if (page != null)
    {
        _miPageCollect(page);
        if (page*.free == null && page*.localFree != null)
        {
            page*.free = page*.localFree;
            page*.localFree = null;
        }
        if (page*.free != null)
        {
            MiBlock* block = page*.free;
            MiBlock* next = _miFreeBlockDecode(block, page*.key1, page*.key2);
            page*.free = next;
            page*.used++;
            page*.freeCount--;
            heap*.totalAllocated += _miBlockSize(sc);

            // If page becomes full, move to fullPages
            if (page*.freeCount == 0)
            {
                _miPageMoveToFull(heap, page, sc);
            }

            return (rawptr)block;
        }
    }

    return null;
}

// Free Fast Path

static void _miFreeFast(MiHeap* heap, MiPage* page, rawptr ptr)
{
    MiBlock* block = (MiBlock*)ptr;

    // Check if this is a cross-thread free (thread ID doesn't match)
    bool isCrossThread = false;
    if (page*.segment != null && page*.segment*.arena != null)
    {
        // For arena-backed segments, thread IDs would need to match
        // For now, use simple heuristic: always local free in single-threaded mode
        isCrossThread = false;
    }

    if (isCrossThread)
    {
        // Cross-thread: push to delayedFree
        _miFreeBlockEncode(block, heap*.delayedFree, page*.key1, page*.key2);
        heap*.delayedFree = block;
    }
    else
    {
        // Same thread: add to localFree with encoding
        _miFreeBlockEncode(block, page*.localFree, page*.key1, page*.key2);
        page*.localFree = block;
    }

    page*.used--;
    page*.freeCount++;
    heap*.totalFreed += page*.blockSize;

    // If page was full, move it back to pages[sc]
    if (page*.freeCount == 1 && page*.prev == null && heap*.fullPages == page)
    {
        _miPageMoveFromFull(heap, page, page*.sizeClass);
    }

    // Check if page should be retired
    if (page*.used == 0)
    {
        _miPageMaybeRetire(heap, page, page*.sizeClass);
    }
}

// Process delayed free list - drain into appropriate pages
static void _miProcessDelayedFree(MiHeap* heap)
{
    MiBlock* current = heap*.delayedFree;
    heap*.delayedFree = null;

    while (current != null)
    {
        // Decode the pointer to find the next block in the delayed list
        MiBlock* next = current*.next;

        // Find which page this block belongs to using segment map
        u8* addr = (u8*)current;
        u32 hashIdx = _miSegmentMapHash(addr);
        MiSegmentMapEntry* entry = heap*.segmentMap.buckets[hashIdx];
        MiPage* page = null;

        // Search hash chain
        while (entry != null)
        {
            u8* pageEnd = entry*.page*.base + (u64)entry*.page*.capacity * entry*.page*.blockSize;
            if (addr >= entry*.page*.base && addr < pageEnd)
            {
                // Verify alignment
                u64 offset = (u64)(addr - entry*.page*.base);
                if (offset % entry*.page*.blockSize == 0)
                {
                    page = entry*.page;
                    break;
                }
            }
            entry = entry*.next;
        }

        if (page != null)
        {
            // Add to page's localFree
            _miFreeBlockEncode(current, page*.localFree, page*.key1, page*.key2);
            page*.localFree = current;
            page*.used--;
            page*.freeCount++;

            // If page was full, move it back to pages[sc]
            if (page*.freeCount == 1 && page*.prev == null && heap*.fullPages == page)
            {
                _miPageMoveFromFull(heap, page, page*.sizeClass);
            }
        }

        current = next;
    }
}

// Find which page a pointer belongs to - O(1) via segment map
static MiPage* _miPageFind(MiHeap* heap, rawptr ptr)
{
    u8* p = (u8*)ptr;

    // O(1) lookup via segment map
    u32 hashIdx = _miSegmentMapHash(p);
    MiSegmentMapEntry* entry = heap*.segmentMap.buckets[hashIdx];
    while (entry != null)
    {
        u8* pageEnd = entry*.page*.base + (u64)entry*.page*.capacity * entry*.page*.blockSize;
        if (p >= entry*.page*.base && p < pageEnd)
        {
            // Verify alignment
            u64 offset = (u64)(p - entry*.page*.base);
            if (offset % entry*.page*.blockSize == 0)
                return entry*.page;
        }
        entry = entry*.next;
    }

    // Fallback: search fullPages list
    MiPage* page = heap*.fullPages;
    while (page != null)
    {
        u8* pageEnd = page*.base + (u64)page*.capacity * page*.blockSize;
        if (p >= page*.base && p < pageEnd)
        {
            u64 offset = (u64)(p - page*.base);
            if (offset % page*.blockSize == 0)
                return page;
        }
        page = page*.next;
    }

    // Fallback: search freePages
    for (u32 sc = 0; sc < MI_SIZE_CLASS_COUNT; sc++)
    {
        page = heap*.freePages[sc];
        while (page != null)
        {
            u8* pageEnd = page*.base + (u64)page*.capacity * page*.blockSize;
            if (p >= page*.base && p < pageEnd)
            {
                u64 offset = (u64)(p - page*.base);
                if (offset % page*.blockSize == 0)
                    return page;
            }
            page = page*.next;
        }
    }

    return null;
}

// Public API

pub struct MiAlloc
{
    MiHeap heap;

    void init(usize reserveSize)
    {
        self*.heap.totalAllocated = 0;
        self*.heap.totalFreed = 0;
        self*.heap.mapped = 0;
        self*.heap.arenas = null;
        self*.heap.segments = null;
        self*.heap.threadId = 0;
        self*.heap.lock.locked = 0;
        self*.heap.delayedFree = null;
        self*.heap.fullPages = null;
        self*.heap.hugePages = null;

        // Initialize segment map
        for (u32 i = 0; i < MI_SEGMENT_MAP_SIZE; i++)
        {
            self*.heap.segmentMap.buckets[i] = null;
        }

        for (u32 i = 0; i < MI_SIZE_CLASS_COUNT; i++)
        {
            self*.heap.pages[i] = null;
            self*.heap.freePages[i] = null;
            self*.heap.pageCounts[i] = 0;
            self*.heap.pageSize[i] = MI_PAGE_SIZES[i];
        }

        // Pre-allocate first arena
        if (reserveSize > 0)
            _miArenaAlloc(&self*.heap, reserveSize);
    }

    rawptr alloc(usize size)
    {
        if (size == 0) return null;

        // Process any delayed frees from other threads
        if (self*.heap.delayedFree != null)
        {
            _miProcessDelayedFree(&self*.heap);
        }

        u32 sc = _miSizeClass(size);

        // Handle huge allocations directly
        if (size >= MI_HUGE_THRESHOLD)
        {
            usize allocSize = (size + 255) & ~255u; // align to 256 bytes
            u8* mem = (u8*)std::mman::_mmap(null, allocSize, 3, 0x22, -1, 0);
            if (mem == null) return null;

            // Create a single-block page for this huge allocation
            MiPage* page = (MiPage*)std::mman::_mmap(null, sizeof(MiPage), 3, 0x22, -1, 0);
            if (page == null) { std::mman::_munmap((rawptr)mem, allocSize); return null; }

            page*.next = null;
            page*.prev = null;
            page*.sizeClass = sc;
            page*.blockSize = (u32)allocSize;
            page*.capacity = 1;
            page*.used = 1;
            page*.freeCount = 0;
            page*.reserved = 1;
            page*.base = mem;
            page*.free = null;
            page*.localFree = null;
            page*.xthreadFree = null;
            page*.xthreadFreeCount = 0;
            page*.segment = null;
            page*.pageIdx = 0;
            page*.retired = false;
            page*.retireCount = 0;
            page*.key1 = _miRandomU64() % 64;
            page*.key2 = _miRandomU64();

            // Link into hugePages
            page*.next = self*.heap.hugePages;
            self*.heap.hugePages = page;

            self*.heap.totalAllocated += allocSize;
            return (rawptr)mem;
        }

        // Try fast path
        rawptr ptr = _miAllocFast(&self*.heap, sc);
        if (ptr != null) return ptr;

        // Try allocating from a different page in the same size class
        MiPage* page = self*.heap.pages[sc];
        while (page != null && page*.free == null)
        {
            _miPageCollect(page);
            if (page*.free == null && page*.localFree != null)
            {
                page*.free = page*.localFree;
                page*.localFree = null;
            }
            if (page*.free != null) break;
            page = page*.next;
        }

        if (page != null && page*.free != null)
        {
            MiBlock* block = page*.free;
            MiBlock* next = _miFreeBlockDecode(block, page*.key1, page*.key2);
            page*.free = next;
            page*.used++;
            page*.freeCount--;
            self*.heap.totalAllocated += _miBlockSize(sc);

            // If page becomes full, move to fullPages
            if (page*.freeCount == 0)
            {
                _miPageMoveToFull(&self*.heap, page, sc);
            }

            return (rawptr)block;
        }

        // Try extending an existing page
        page = self*.heap.pages[sc];
        while (page != null)
        {
            if (page*.capacity < page*.reserved)
            {
                if (_miPageExtend(&self*.heap, page))
                {
                    MiBlock* block = page*.free;
                    MiBlock* next = _miFreeBlockDecode(block, page*.key1, page*.key2);
                    page*.free = next;
                    page*.used++;
                    page*.freeCount--;
                    self*.heap.totalAllocated += _miBlockSize(sc);
                    return (rawptr)block;
                }
            }
            page = page*.next;
        }

        // Try a retired page
        page = self*.heap.freePages[sc];
        if (page != null)
        {
            self*.heap.freePages[sc] = page*.next;
            page*.next = null;
            page*.retired = false;

            // Rebuild free list from localFree
            if (page*.localFree != null)
            {
                page*.free = page*.localFree;
                page*.localFree = null;
            }

            page*.next = self*.heap.pages[sc];
            if (self*.heap.pages[sc] != null)
                self*.heap.pages[sc]*.prev = page;
            self*.heap.pages[sc] = page;
            self*.heap.pageCounts[sc]++;

            if (page*.free != null)
            {
                MiBlock* block = page*.free;
                MiBlock* next = _miFreeBlockDecode(block, page*.key1, page*.key2);
                page*.free = next;
                page*.used++;
                page*.freeCount--;
                self*.heap.totalAllocated += _miBlockSize(sc);
                return (rawptr)block;
            }
        }

        // Allocate new page
        page = _miPageAlloc(&self*.heap, sc);
        if (page == null) return null;

        MiBlock* block = page*.free;
        MiBlock* next = _miFreeBlockDecode(block, page*.key1, page*.key2);
        page*.free = next;
        page*.used++;
        page*.freeCount--;
        self*.heap.totalAllocated += _miBlockSize(sc);
        return (rawptr)block;
    }

    void free(rawptr ptr)
    {
        if (ptr == null) return;

        MiPage* page = _miPageFind(&self*.heap, ptr);
        if (page == null) return;

        // Handle huge page deallocation
        if (page*.capacity == 1 && page*.blockSize >= MI_HUGE_THRESHOLD)
        {
            // Unlink from hugePages
            MiPage** pp = &self*.heap.hugePages;
            while (*pp != null)
            {
                if (*pp == page)
                {
                    *pp = page*.next;
                    break;
                }
                pp = &(*pp)*.next;
            }
            usize allocSize = (usize)page*.blockSize;
            std::mman::_munmap((rawptr)page, sizeof(MiPage));
            std::mman::_munmap(ptr, allocSize);
            self*.heap.totalFreed += allocSize;
            return;
        }

        _miFreeFast(&self*.heap, page, ptr);
    }

    rawptr realloc(rawptr ptr, usize newSize)
    {
        if (ptr == null) return self*.alloc(newSize);
        if (newSize == 0) { self*.free(ptr); return null; }

        MiPage* page = _miPageFind(&self*.heap, ptr);
        if (page == null) return null;

        u32 oldSc = page*.sizeClass;
        u32 newSc = _miSizeClass(newSize);

        // Same size class - no-op
        if (oldSc == newSc) return ptr;

        // Allocate new, copy, free old
        rawptr newPtr = self*.alloc(newSize);
        if (newPtr == null) return null;

        usize copyLen = (usize)page*.blockSize < newSize ? (usize)page*.blockSize : newSize;
        std::mman::_memcpy(newPtr, ptr, copyLen);
        self*.free(ptr);
        return newPtr;
    }

    rawptr calloc(usize count, usize size)
    {
        // Overflow check
        if (count != 0 && size > (0xFFFFFFFFFFFFFFFF / count)) return null;
        usize total = count * size;
        rawptr ptr = self*.alloc(total);
        if (ptr != null)
        {
            // Zero initialize
            u8* p = (u8*)ptr;
            for (usize i = 0; i < total; i++) p[i] = 0;
        }
        return ptr;
    }

    usize getAllocated(const self*)
    {
        return self*.heap.totalAllocated;
    }

    usize getFreed(const self*)
    {
        return self*.heap.totalFreed;
    }

    usize getUsed(const self*)
    {
        return self*.heap.totalAllocated - self*.heap.totalFreed;
    }

    usize getMapped(const self*)
    {
        return self*.heap.mapped;
    }

    std::mman::Allocator allocator()
    {
        std::mman::Allocator a;
        a.ctx = (rawptr)self;
        a.alloc = _miWrapAlloc;
        a.free = _miWrapFree;
        a.realloc = _miWrapRealloc;
        return a;
    }
}

// Wrapper Functions

rawptr _miWrapAlloc(rawptr ctx, usize size)
{
    if (!ctx) return null;
    return ((MiAlloc*)ctx)*.alloc(size);
}

void _miWrapFree(rawptr ctx, rawptr ptr)
{
    if (!ctx || !ptr) return;
    ((MiAlloc*)ctx)*.free(ptr);
}

rawptr _miWrapRealloc(rawptr ctx, rawptr ptr, usize newSize)
{
    if (!ctx) return null;
    return ((MiAlloc*)ctx)*.realloc(ptr, newSize);
}

// Stats

pub void miStatsPrint(MiAlloc* alloc)
{
    std::ios::nprint("mimalloc stats:");
    std::ios::nprint("  allocated: ", alloc*.getAllocated());
    std::ios::nprint("  freed:     ", alloc*.getFreed());
    std::ios::nprint("  in use:    ", alloc*.getUsed());
    std::ios::nprint("  mapped:    ", alloc*.getMapped());
}
