mod std = import(lib, "std");
mod core = import(lib, "core");

pub struct String
{
    std.cchar* ptr;
    usize len;
    usize cap;

    static String new()
    {
        String s;
        s.ptr = std::mman::alloc<std.cchar>(16 + 1);
        s.ptr[0] = 0;
        s.len = 0;
        s.cap = 16;
        return s;
    }

    static String withCap(usize cap)
    {
        usize c = cap > 7 ? cap : 7;
        String s;
        s.ptr = std::mman::alloc<std.cchar>(c + 1);
        s.ptr[0] = 0;
        s.len = 0;
        s.cap = c;
        return s;
    }

    static String fromView(str sv)
    {
        String s = String::withCap(sv.len);
        std::libc::memcpy((rawptr)s.ptr, (const rawptr)sv.ptr, sv.len);
        s.ptr[sv.len] = 0;
        s.len = sv.len;
        return s;
    }

    static String fromCstr(const std.cchar* cstr)
    {
        return String::fromView(str::fromCstr(cstr));
    }

    String clone()
    {
        return String::fromView(self.asView());
    }

    void free()
    {
        std::mman::dealloc<std.cchar>(self.ptr);
        self.ptr = null;
        self.len = 0;
        self.cap = 0;
    }

    void _ensure(usize extra)
    {
        if (self.len + extra <= self.cap) return;
        usize nc = self.cap * 2;
        if (nc < self.len + extra) nc = self.len + extra;
        self.ptr = std::mman::realloc<std.cchar>(self.ptr, nc + 1);
        self.cap = nc;
    }

    str asView() { return str::fromParts(self.ptr, self.len); }
    const std.cchar* asCstr() { return self.ptr; }
    const std.cchar* asU8() { return self.ptr; }

    void pushChar(std.cchar c)
    {
        self._ensure(1);
        self.ptr[self.len++] = c;
        self.ptr[self.len] = 0;
    }

    void pushByte(std.cchar b)
    {
        self._ensure(1);
        self.ptr[self.len++] = b;
        self.ptr[self.len] = 0;
    }

    void appendView(str sv)
    {
        self.pushView(sv);
    }

    void pushView(str sv)
    {
        bool selfRef = sv.ptr >= self.ptr && (usize)(sv.ptr - self.ptr) < self.len;
        usize off = 0;
        if (selfRef) off = (usize)(sv.ptr - self.ptr);
        self._ensure(sv.len);
        if (selfRef)
        {
            std::libc::memmove((rawptr)(self.ptr + self.len), (const rawptr)(self.ptr + off), sv.len);
        }
        else
            std::libc::memcpy((rawptr)(self.ptr + self.len), (const rawptr)sv.ptr, sv.len);
        self.len += sv.len;
        self.ptr[self.len] = 0;
    }

    void pushStr(const String* other)
    {
        self.pushView(other*.asView());
    }

    void pushCstr(const std.cchar* cstr)
    {
        self.pushView(str::fromCstr(cstr));
    }

    void pushRepeat(std.cchar c, usize n)
    {
        self._ensure(n);
        std::libc::memset((rawptr)(self.ptr + self.len), (i32)c, n);
        self.len += n;
        self.ptr[self.len] = 0;
    }

    void clear()
    {
        self.len = 0;
        self.ptr[0] = 0;
    }

    void shrinkToFit()
    {
        self.ptr = std::mman::realloc<std.cchar>(self.ptr, self.len + 1);
        self.cap = self.len;
    }

    void truncate(usize newLen)
    {
        if (newLen >= self.len) return;
        self.len = newLen;
        self.ptr[self.len] = 0;
    }

    void insertView(usize idx, str sv)
    {
        assert(idx <= self.len);
        bool selfRef = sv.ptr >= self.ptr && (usize)(sv.ptr - self.ptr) < self.len;
        usize off = 0;
        if (selfRef) off = (usize)(sv.ptr - self.ptr);
        self._ensure(sv.len);
        std::libc::memmove((rawptr)(self.ptr + idx + sv.len),
                                (const rawptr)(self.ptr + idx),
                                self.len - idx + 1);
        if (selfRef)
        {
            const std.cchar* src = (const std.cchar*)(self.ptr + off);
            if (off >= idx) src = (const std.cchar*)(self.ptr + off + sv.len);
            std::libc::memmove((rawptr)(self.ptr + idx), (const rawptr)src, sv.len);
        }
        else
            std::libc::memcpy((rawptr)(self.ptr + idx), (const rawptr)sv.ptr, sv.len);
        self.len += sv.len;
    }

    void removeRange(usize start, usize end)
    {
        assert(start <= end);
        assert(end <= self.len);
        usize tail = self.len - end;
        std::libc::memmove((rawptr)(self.ptr + start),
                        (const rawptr)(self.ptr + end),
                        tail + 1);
        self.len -= (end - start);
    }

    void replaceAll(str needle, str replacement)
    {
        if (needle.len == 0) return;
        String result = String::new();
        usize i = 0;
        while (i <= self.len)
        {
            str rest = str::fromParts(self.ptr + i, self.len - i);
            usize pos = rest.findView(needle);
            if (pos == rest.len)
            {
                result.pushView(rest);
                break;
            }
            result.pushView(str::fromParts(rest.ptr, pos));
            result.pushView(replacement);
            i += pos + needle.len;
        }
        self.free();
        *self = result;
    }

    void toUpper()
    {
        for (usize i = 0; i < self.len; i++)
            self.ptr[i] = core::charr::toUpper(self.ptr[i]);
    }

    void toLower()
    {
        for (usize i = 0; i < self.len; i++)
            self.ptr[i] = core::charr::toLower(self.ptr[i]);
    }

    void reverse()
    {
        usize lo = 0;
        usize hi = self.len;
        while (lo < hi)
        {
            hi--;
            std.cchar t = self.ptr[lo];
            self.ptr[lo++] = self.ptr[hi];
            self.ptr[hi] = t;
        }
    }

    std.cchar at(usize idx)
    {
        assert(idx < self.len);
        return self.ptr[idx];
    }

    void atApply(usize idx, std.cchar c)
    {
        assert(idx < self.len);
        self.ptr[idx] = c;
    }

    bool isEmpty() { return self.len == 0; }

    bool equals(const String* other)
    {
        str sv = self.asView();
        return sv.equals(other*.asView());
    }

    bool equalsView(str sv)
    {
        return self.asView().equals(sv);
    }

    i32 compare(const String* other)
    {
        str sv = self.asView();
        return sv.compare(other*.asView());
    }

    usize findChar(std.cchar c)
    {
        return self.asView().findByte(c);
    }

    usize rfindChar(std.cchar c)
    {
        return self.asView().rfindByte(c);
    }

    usize findView(str needle)
    {
        return self.asView().findView(needle);
    }

    bool startsWith(str prefix)
    {
        return self.asView().startsWith(prefix);
    }

    bool endsWith(str suffix)
    {
        return self.asView().endsWith(suffix);
    }

    bool containsView(str needle)
    {
        return self.asView().containsView(needle);
    }

    String trim()
    {
        str tv = self.asView();
        return String::fromView(tv.trim());
    }

    String trimStart()
    {
        str tv = self.asView();
        return String::fromView(tv.trimStart());
    }

    String trimEnd()
    {
        str tv = self.asView();
        return String::fromView(tv.trimEnd());
    }

    String substr(usize start, usize end)
    {
        assert(start <= end);
        assert(end <= self.len);
        return String::fromView(str::fromParts(self.ptr + start, end - start));
    }

    std::vec::vec<str> splitByte(std.cchar delim)
    {
        std::vec::vec<str> parts = std::vec::vec<str>::new();
        usize start = 0;
        for (usize i = 0; i <= self.len; i++)
        {
            if (i == self.len || self.ptr[i] == delim)
            {
                parts.push(str::fromParts(self.ptr + start, i - start));
                start = i + 1;
            }
        }
        return parts;
    }

    String repeat(usize n)
    {
        String r = String::withCap(self.len * n);
        for (usize i = 0; i < n; i++) r.pushStr(self);
        return r;
    }

    static String join(str sep, const std::vec::vec<str>* parts)
    {
        String r = String::new();
        for (usize i = 0; i < parts.len; i++)
        {
            if (i > 0) r.pushView(sep);
            r.pushView(*parts.atConst(parts, i));
        }
        return r;
    }

    String padLeft(usize totalLen, std.cchar padChar)
    {
        if (self.len >= totalLen) return self.clone();
        usize pad = totalLen - self.len;
        String r = String::withCap(totalLen);
        r.pushRepeat(padChar, pad);
        r.pushStr(self);
        return r;
    }

    String padRight(usize totalLen, std.cchar padChar)
    {
        if (self.len >= totalLen) return self.clone();
        String r = self.clone();
        r.pushRepeat(padChar, totalLen - self.len);
        return r;
    }

    usize countChar(std.cchar c)
    {
        usize n = 0;
        for (usize i = 0; i < self.len; i++)
            if (self.ptr[i] == c) n++;
        return n;
    }
}

trait drop
{
    void drop();
}

String::drop
{
    void drop()
    {
        self.free();
    }
}