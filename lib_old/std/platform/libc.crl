// I/O
pub extern i64 read(i32 fd, u8* buf, u64 count);
pub extern i64 write(i32 fd, const u8* buf, u64 count);
pub extern i32 getchar();
pub extern i32 putchar(i32 c);
pub extern i32 fflush(rawptr stream);
// String
pub extern u64 strlen(const char* s);
pub extern i32 strcmp(const u8* a, const u8* b);
pub extern u8* strcpy(u8* dst, const u8* src);
// Memory
pub extern rawptr malloc(u64 size);
pub extern void free(rawptr ptr);
pub extern rawptr realloc(rawptr ptr, u64 newSize);
pub extern void memcpy(rawptr dst, const rawptr src, u64 n);
pub extern void memmove(rawptr dst, const rawptr src, u64 n);
pub extern void memset(rawptr dst, i32 val, u64 n);
pub extern i32 memcmp(const rawptr a, const rawptr b, u64 n);
// Formatting
pub extern i32 snprintf(u8* buf, u64 size, const u8* fmt, ...);
pub extern i32 printf(const char* fmt, ...);
pub extern i32 puts(const char* s);

// POSIX (all platforms except Windows)
pub extern rawptr mmap(rawptr addr, u64 length, i32 prot, i32 flags, i32 fd, i64 offset);
pub extern i32 munmap(rawptr addr, u64 length);
pub extern i32 open(const char* path, i32 flags, i32 mode);
pub extern i32 close(i32 fd);
pub extern i32 stat(const char* path, rawptr buf);
pub extern i32 mkdir(const char* path, i32 mode);
pub extern i32 chdir(const char* path);
pub extern i32 rmdir(const char* path);
pub extern i32 unlink(const char* path);
pub extern i32 rename(const char* old, const char* newName);
pub extern i32 access(const char* path, i32 mode);
pub extern rawptr opendir(const char* path);
pub extern rawptr readdir(rawptr dir);
pub extern i32 closedir(rawptr dir);

// Stdio
pub extern rawptr fopen(const char* path, const u8* mode);
pub extern i32 fclose(rawptr stream);
pub extern u64 fread(rawptr ptr, u64 size, u64 count, rawptr stream);
pub extern u64 fwrite(const rawptr ptr, u64 size, u64 count, rawptr stream);
pub extern i32 feof(rawptr stream);
pub extern i32 ferror(rawptr stream);

// File operations
pub extern i64 lseek(i32 fd, i64 offset, i32 whence);
pub extern i32 mkstemp(u8* templateStr);
pub extern u8* mkdtemp(u8* templateStr);

// Regex
pub extern i32 regcomp(rawptr preg, const char* pattern, i32 cflags);
pub extern i32 regexec(const rawptr preg, const char* string, u64 nmatch, rawptr pmatch, i32 eflags);
pub extern void regfree(rawptr preg);
pub extern u64 regerror(i32 errcode, const rawptr preg, u8* errbuf, u64 errbufSize);

// Process
pub extern i32 fork();
pub extern i32 execvp(const u8* file, const u8** argv);
pub extern i32 waitpid(i32 pid, i32* status, i32 options);
pub extern i32 poll(rawptr fds, u64 nfds, i32 timeout);
pub extern void _exit(i32 code);
pub extern i32 pipe(i32* fds);
pub extern i32 dup2(i32 oldfd, i32 newfd);
pub extern i32 execvpe(const u8* file, const u8** argv, const u8** envp);

// Signals
pub extern void(i32) signal(i32 signum, void(i32) handler);
pub extern i32 kill(i32 pid, i32 sig);
pub extern i32 raise(i32 sig);

// Environment
pub extern u8* getenv(const u8* name);
pub extern i32 setenv(const u8* name, const u8* value, i32 overwrite);
pub extern i32 unsetenv(const u8* name);
pub extern i64 readlink(const char* path, char* buf, u64 bufsize);

// Time
pub extern i32 gettimeofday(rawptr tv, rawptr tz);
pub extern u64 time(rawptr t);
pub extern i64 clock_gettime(i32 clockId, rawptr tp);
pub extern i32 nanosleep(const rawptr req, rawptr rem);

// Terminal
pub extern i32 isatty(i32 fd);

// Thread/Pthread
pub extern i32 pthread_create(rawptr* thread, const rawptr attr, rawptr(rawptr) start, rawptr arg);
pub extern i32 pthread_join(rawptr thread, rawptr* retval);
pub extern void pthread_exit(rawptr retval);
pub extern rawptr pthread_self();

pub extern i32 pthread_mutex_init(rawptr mutex, const rawptr attr);
pub extern i32 pthread_mutex_destroy(rawptr mutex);
pub extern i32 pthread_mutex_lock(rawptr mutex);
pub extern i32 pthread_mutex_unlock(rawptr mutex);
pub extern i32 pthread_mutex_trylock(rawptr mutex);
pub extern i32 pthread_mutexattr_init(rawptr attr);
pub extern i32 pthread_mutexattr_destroy(rawptr attr);
pub extern i32 pthread_mutexattr_settype(rawptr attr, i32 type);

pub extern i32 pthread_cond_init(rawptr cond, const rawptr attr);
pub extern i32 pthread_cond_destroy(rawptr cond);
pub extern i32 pthread_cond_wait(rawptr cond, rawptr mutex);
pub extern i32 pthread_cond_signal(rawptr cond);
pub extern i32 pthread_cond_broadcast(rawptr cond);

pub extern i32 pthread_rwlock_init(rawptr lock, const rawptr attr);
pub extern i32 pthread_rwlock_destroy(rawptr lock);
pub extern i32 pthread_rwlock_rdlock(rawptr lock);
pub extern i32 pthread_rwlock_wrlock(rawptr lock);
pub extern i32 pthread_rwlock_unlock(rawptr lock);
pub extern i32 pthread_rwlock_tryrdlock(rawptr lock);
pub extern i32 pthread_rwlock_trywrlock(rawptr lock);

pub extern i32 sem_init(rawptr sem, i32 pshared, u32 value);
pub extern i32 sem_destroy(rawptr sem);
pub extern i32 sem_wait(rawptr sem);
pub extern i32 sem_trywait(rawptr sem);
pub extern i32 sem_post(rawptr sem);
pub extern i32 sem_getvalue(rawptr sem, i32* sval);

pub extern u8** environ;

// Windows (Win32 API)
// Kernel32
pub extern rawptr GetStdHandle(u32 nStdHandle);
pub extern bool ReadFile(rawptr hFile, u8* lpBuffer, u32 nNumberOfBytesToRead, u32* lpNumberOfBytesRead, rawptr lpOverlapped);
pub extern bool WriteFile(rawptr hFile, const u8* lpBuffer, u32 nNumberOfBytesToWrite, u32* lpNumberOfBytesWritten, rawptr lpOverlapped);
pub extern void ExitProcess(u32 uExitCode);

// File system
pub extern rawptr CreateFileA(const u8* lpFileName, u32 dwDesiredAccess, u32 dwShareMode, rawptr lpSecurityAttributes, u32 dwCreationDisposition, u32 dwFlagsAndAttributes, rawptr hTemplateFile);
pub extern bool CloseHandle(rawptr hObject);
pub extern bool DeleteFileA(const u8* lpFileName);
pub extern bool RemoveDirectoryA(const u8* lpPathName);
pub extern bool CreateDirectoryA(const u8* lpPathName, rawptr lpSecurityAttributes);
pub extern bool MoveFileA(const u8* lpExistingFileName, const u8* lpNewFileName);
pub extern u32 GetFileAttributesA(const u8* lpFileName);

// Memory mapping
pub extern rawptr VirtualAlloc(rawptr lpAddress, u64 dwSize, u32 flAllocationType, u32 flProtect);
pub extern bool VirtualFree(rawptr lpAddress, u64 dwSize, u32 dwFreeType);
pub extern rawptr CreateFileMappingA(rawptr hFile, rawptr lpAttributes, u32 flProtect, u32 dwMaximumSizeHigh, u32 dwMaximumSizeLow, const u8* lpName);
pub extern rawptr MapViewOfFile(rawptr hFileMappingObject, u32 dwDesiredAccess, u32 dwFileOffsetHigh, u32 dwFileOffsetLow, u64 dwNumberOfBytesToMap);
pub extern bool UnmapViewOfFile(rawptr lpBaseAddress);

// Heap
pub extern rawptr GetProcessHeap();
pub extern rawptr HeapAlloc(rawptr hHeap, u32 dwFlags, u64 dwBytes);
pub extern bool HeapFree(rawptr hHeap, u32 dwFlags, rawptr lpMem);
pub extern rawptr HeapReAlloc(rawptr hHeap, u32 dwFlags, rawptr lpMem, u64 dwBytes);

// Process/Thread
pub extern rawptr CreateThread(rawptr lpThreadAttributes, u64 dwStackSize, u32(rawptr) lpStartAddress, rawptr lpParameter, u32 dwCreationFlags, u32* lpThreadId);
pub extern u32 WaitForSingleObject(rawptr hHandle, u32 dwMilliseconds);
pub extern bool TerminateThread(rawptr hThread, u32 dwExitCode);
pub extern bool GetExitCodeThread(rawptr hThread, u32* lpExitCode);

// Synchronization
pub extern rawptr CreateMutexA(rawptr lpMutexAttributes, bool bInitialOwner, const u8* lpName);
pub extern bool ReleaseMutex(rawptr hMutex);
pub extern rawptr CreateSemaphoreA(rawptr lpSemaphoreAttributes, i32 lInitialCount, i32 lMaximumCount, const u8* lpName);
pub extern bool ReleaseSemaphore(rawptr hSemaphore, i32 lReleaseCount, i32* lpPreviousCount);
pub extern rawptr CreateEventA(rawptr lpEventAttributes, bool bManualReset, bool bInitialState, const u8* lpName);
pub extern bool SetEvent(rawptr hEvent);
pub extern bool ResetEvent(rawptr hEvent);

// Time
pub extern void GetSystemTimeAsFileTime(rawptr lpSystemTimeAsFileTime);
pub extern u32 GetTickCount();
pub extern void Sleep(u32 dwMilliseconds);

// Environment
pub extern u8* GetEnvironmentVariableA(const u8* lpName, u8* lpBuffer, u32 nSize);
pub extern bool SetEnvironmentVariableA(const u8* lpName, const u8* lpValue);
pub extern u8* GetCommandLineA();

// Console
pub extern bool GetConsoleMode(rawptr hConsoleHandle, u32* lpMode);
pub extern bool SetConsoleMode(rawptr hConsoleHandle, u32 dwMode);

// Network (Winsock)
pub extern i32 WSAStartup(u16 wVersionRequired, rawptr lpWSAData);
pub extern i32 WSACleanup();
pub extern rawptr socket(i32 af, i32 type, i32 protocol);
pub extern i32 bind(rawptr s, const rawptr name, i32 namelen);
pub extern i32 listen(rawptr s, i32 backlog);
pub extern rawptr accept(rawptr s, rawptr addr, i32* addrlen);
pub extern i32 connect(rawptr s, const rawptr name, i32 namelen);
pub extern i32 send(rawptr s, const u8* buf, i32 len, i32 flags);
pub extern i32 recv(rawptr s, u8* buf, i32 len, i32 flags);
pub extern i32 closesocket(rawptr s);
pub extern i32 setsockopt(rawptr s, i32 level, i32 optname, const u8* optval, i32 optlen);
pub extern i64 recvfrom(i32 fd, u8* buf, u64 len, i32 flags, rawptr srcAddr, i32* addrLen);
pub extern i64 sendto(i32 fd, const u8* buf, u64 len, i32 flags, const rawptr dstAddr, i32 addrLen);
pub extern u64 htonl(u32 val);
pub extern u32 ntohl(u32 val);
pub extern u16 ntohs(u16 val);

pub extern i32 system(const char* cmd);