mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Jump threading: when a branch target is a block that only contains another
// branch with a known condition, thread through to the final destination.
// Also removes dead blocks that become unreachable after threading.
pub struct JumpThreadPass
{
    u64 threads;

    JumpThreadPass new()
    {
        JumpThreadPass p;
        p.threads = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.threads = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            if (bb.ninsts == 0) continue;

            wallvm::ir_types::IrInst* term = bb.insts[bb.ninsts - 1];

            // Pattern 1: unconditional br to a block that has only a single successor
            if (term.opcode == wallvm::irOps::IrOpcode::Br && term.nops == 1)
            {
                wallvm::ir_types::IrBlock* target = (wallvm::ir_types::IrBlock*)term.ops[0];
                if (target != bb && target.ninsts >= 1)
                {
                    wallvm::ir_types::IrInst* targetTerm = target.insts[target.ninsts - 1];

                    // If target has no side effects (only simple ops) and ends with br
                    if (targetTerm.opcode == wallvm::irOps::IrOpcode::Br && targetTerm.nops == 1 &&
                        target != (wallvm::ir_types::IrBlock*)targetTerm.ops[0])
                    {
                        wallvm::ir_types::IrBlock* finalTarget = (wallvm::ir_types::IrBlock*)targetTerm.ops[0];
                        // Thread: bb -> finalTarget
                        if (finalTarget != bb && target.hasNoSideEffects())
                        {
                        // Move target's non-terminator instructions into bb
                        for (u32 si = 0; si < target.ninsts - 1; si++)
                        {
                            wallvm::ir_types::IrInst* si2 = target.insts[si];

                            // If moved instruction is a PHI, update incoming block refs
                            if (si2.opcode == wallvm::irOps::IrOpcode::Phi)
                            {
                                for (u32 pi = 1; pi < si2.nops; pi += 2)
                                {
                                    if (si2.ops[pi] == &target.base)
                                        si2.ops[pi] = &bb.base;
                                }
                            }

                            si2.parent = bb;
                            bb.insertBefore(si2, term);
                        }
                        target.ninsts = 0;

                        // Update terminator: use block's existing operand slot
                        // to avoid dangling pointer to stack local
                        term.ops[0].removeUser(term);
                        finalTarget.base.addUser(term);
                        term.ops[0] = &finalTarget.base;

                        target.removePred(bb);
                        finalTarget.addPred(bb);
                        self.threads++;
                        changed = true;
                        }
                    }
                }
            }

            // Pattern 2: condbr with known constant condition -> thread through
            if (term.opcode == wallvm::irOps::IrOpcode::CondBr && term.nops >= 3)
            {
                wallvm::ir_types::IrValue* cond = term.ops[0];
                if (cond.kind == wallvm::ir_types::IrValueKind::ConstInt)
                {
                    wallvm::ir_types::IrBlock* taken = (cond.valData != 0) ?
                        (wallvm::ir_types::IrBlock*)term.ops[1] : (wallvm::ir_types::IrBlock*)term.ops[2];
                    wallvm::ir_types::IrBlock* notTaken = (cond.valData != 0) ?
                        (wallvm::ir_types::IrBlock*)term.ops[2] : (wallvm::ir_types::IrBlock*)term.ops[1];

                    // Replace condbr with br to taken
                    term.ops[0].removeUser(term);
                    term.ops[(cond.valData != 0) ? 2 : 1].removeUser(term);
                    notTaken.removePred(bb);

                    // Rewrite in place using existing ops array to avoid dangling pointer
                    taken.base.addUser(term);
                    term.nops = 1;
                    term.opcode = wallvm::irOps::IrOpcode::Br;
                    term.ops[0] = &taken.base;

                    bb.nsuccs = 1;
                    bb.succs[0] = taken;
                    self.threads++;
                    changed = true;
                }
            }
        }

        return self.threads > 0;
    }
}

pub bool irPassJumpThread(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    if (!func) return false;
    JumpThreadPass pass = JumpThreadPass::new();
    return pass.run(func);
}