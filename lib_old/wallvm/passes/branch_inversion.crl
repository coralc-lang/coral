mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Redundant Branch Inversion Flattening
// Detects sequential conditional checks that evaluate overlapping or inverse
// predicates and replaces the second branch with an unconditional jump.

pub bool irPassBranchInversionFlat(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!func || func*.isExtern) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func*.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
        if (bb.ninsts < 2) continue;

        // Get the last two instructions
        wallvm::ir_types::IrInst* last = bb.insts[bb.ninsts - 1];
        wallvm::ir_types::IrInst* prev = bb.insts[bb.ninsts - 2];

        if (prev.opcode != wallvm::irOps::IrOpcode::CondBr) continue;
        if (last.opcode != wallvm::irOps::IrOpcode::CondBr) continue;

        if (prev.nops >= 3 && last.nops >= 3)
        {
            // Same targets - remove second condbr
            if (prev.ops[1] == last.ops[1] && prev.ops[2] == last.ops[2])
            {
                if (prev.ops[0] == last.ops[0])
                {
                    wallvm::ir_types::IrInst* brInst = ctx.createInst(
                        wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), &last.ops[1], 1, 0, 0);
                    bb.insts[bb.ninsts - 1] = brInst;
                    brInst.parent = bb;
                    changed = true;
                    last = bb.insts[bb.ninsts - 1];
                }
            }

            // Inverse targets - condbr always takes true branch
            if (prev.ops[1] == last.ops[2] && prev.ops[2] == last.ops[1])
            {
                if (prev.ops[0] == last.ops[0])
                {
                    wallvm::ir_types::IrInst* brInst = ctx.createInst(
                        wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), &last.ops[1], 1, 0, 0);
                    bb.insts[bb.ninsts - 1] = brInst;
                    brInst.parent = bb;
                    changed = true;
                    last = bb.insts[bb.ninsts - 1];
                }
            }
        }

        // Fold ICmp with constant operands
        if (prev.opcode == wallvm::irOps::IrOpcode::ICmp && last.nops >= 3)
        {
            if (last.ops[0] == &prev.base && prev.nops >= 2 &&
                prev.ops[0] && prev.ops[1] &&
                prev.ops[0].kind == wallvm::ir_types::IrValueKind::ConstInt &&
                prev.ops[1].kind == wallvm::ir_types::IrValueKind::ConstInt)
            {
                i64 a = (i64)prev.ops[0].valData;
                i64 b = (i64)prev.ops[1].valData;
                bool result = false;
                switch (prev.icmpPred)
                {
                case wallvm::irOps::IrICmpPred::Eq: result = (a == b); break;
                case wallvm::irOps::IrICmpPred::Ne: result = (a != b); break;
                case wallvm::irOps::IrICmpPred::Slt: result = (a < b); break;
                case wallvm::irOps::IrICmpPred::Sle: result = (a <= b); break;
                case wallvm::irOps::IrICmpPred::Sgt: result = (a > b); break;
                case wallvm::irOps::IrICmpPred::Sge: result = (a >= b); break;
                case wallvm::irOps::IrICmpPred::Ult: result = ((u64)a < (u64)b); break;
                case wallvm::irOps::IrICmpPred::Ule: result = ((u64)a <= (u64)b); break;
                case wallvm::irOps::IrICmpPred::Ugt: result = ((u64)a > (u64)b); break;
                case wallvm::irOps::IrICmpPred::Uge: result = ((u64)a >= (u64)b); break;
                default: break;
                }
                wallvm::ir_types::IrValue* target = result ? last.ops[1] : last.ops[2];
                wallvm::ir_types::IrInst* brInst = ctx.createInst(
                    wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), &target, 1, 0, 0);
                bb.insts[bb.ninsts - 1] = brInst;
                brInst.parent = bb;
                changed = true;
            }
        }

        // Fold FCmp with constant operands
        if (prev.opcode == wallvm::irOps::IrOpcode::FCmp && last.nops >= 3)
        {
            if (last.ops[0] == &prev.base && prev.nops >= 2 &&
                prev.ops[0] && prev.ops[1] &&
                prev.ops[0].kind == wallvm::ir_types::IrValueKind::ConstFloat &&
                prev.ops[1].kind == wallvm::ir_types::IrValueKind::ConstFloat)
            {
                f64 a = (f64)prev.ops[0].valData;
                f64 b = (f64)prev.ops[1].valData;
                bool result = false;
                switch (prev.fcmpPred)
                {
                case wallvm::irOps::IrFCmpPred::Oeq: result = (a == b); break;
                case wallvm::irOps::IrFCmpPred::One: result = (a != b); break;
                case wallvm::irOps::IrFCmpPred::Olt: result = (a < b); break;
                case wallvm::irOps::IrFCmpPred::Ole: result = (a <= b); break;
                case wallvm::irOps::IrFCmpPred::Ogt: result = (a > b); break;
                case wallvm::irOps::IrFCmpPred::Oge: result = (a >= b); break;
                default: break;
                }
                wallvm::ir_types::IrValue* target = result ? last.ops[1] : last.ops[2];
                wallvm::ir_types::IrInst* brInst = ctx.createInst(
                    wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), &target, 1, 0, 0);
                bb.insts[bb.ninsts - 1] = brInst;
                brInst.parent = bb;
                changed = true;
            }
        }
    }

    return changed;
}
