mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Control-Flow Tail Duplication:
// Duplicates the tail of a basic block into its incoming jump targets
// to eliminate unconditional branches and expose further constant folding
// or selection patterns across basic block boundaries.
//
// Pattern: A has tail [X, Y, Z, br B]; B starts with [br C]
//          -> Duplicate tail into A, redirect A to C directly.
// Also: A has tail [X, cond_br ...]; B (single predecessor) has tail [Y, br C]
//          -> If B's only content is a copy of A's tail, merge.
pub struct TailDupPass
{
    u64 dups;

    TailDupPass new()
    {
        TailDupPass p;
        p.dups = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.dups = 0;
        bool changed = true;
        while (changed)
        {
            changed = false;
            for (u32 bi = 0; bi < func*.nblocks; bi++)
            {
                wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
                if (bb.ninsts == 0) continue;

                wallvm::ir_types::IrInst* term = bb.insts[bb.ninsts - 1];

                // Pattern 1: Unconditional branch to a block that only has an unconditional branch
                if (term.opcode == wallvm::irOps::IrOpcode::Br && term.nops == 1)
                {
                    wallvm::ir_types::IrBlock* target = (wallvm::ir_types::IrBlock*)term.ops[0];
                    if (target != bb && target.ninsts >= 1 && target.parent == func)
                    {
                        wallvm::ir_types::IrInst* targetTerm = target.insts[target.ninsts - 1];
                        if (targetTerm.opcode == wallvm::irOps::IrOpcode::Br && targetTerm.nops == 1)
                        {
                            wallvm::ir_types::IrBlock* finalTarget = (wallvm::ir_types::IrBlock*)targetTerm.ops[0];
                            if (finalTarget != bb && target.hasNoSideEffects())
                            {
                                // Move target's instructions into bb (before the terminator)
                                for (u32 si = 0; si < target.ninsts - 1; si++)
                                {
                                    wallvm::ir_types::IrInst* si2 = target.insts[si];
                                    si2.parent = bb;
                                    bb.insertBefore(si2, term);
                                }
                                target.ninsts = 0;

                                // Update terminator to point to finalTarget
                                term.ops[0].removeUser(term);
                                finalTarget.base.addUser(term);
                                term.ops[0] = &finalTarget.base;

                                target.removePred(bb);
                                finalTarget.addPred(bb);
                                self.dups++;
                                changed = true;
                                continue;
                            }
                        }
                    }
                }

                // Pattern 2: CondBr where one target is a simple passthrough block
                if (term.opcode == wallvm::irOps::IrOpcode::CondBr && term.ninsts >= 3)
                {
                    wallvm::ir_types::IrBlock* trueTgt = (wallvm::ir_types::IrBlock*)term.ops[1];
                    wallvm::ir_types::IrBlock* falseTgt = (wallvm::ir_types::IrBlock*)term.ops[2];

                    // Check if true target is a simple passthrough
                    if (trueTgt.npreds == 1 && trueTgt.ninsts >= 1 && trueTgt.parent == func)
                    {
                        wallvm::ir_types::IrInst* ttTerm = trueTgt.insts[trueTgt.ninsts - 1];
                        if (ttTerm.opcode == wallvm::irOps::IrOpcode::Br && ttTerm.nops == 1)
                        {
                            wallvm::ir_types::IrBlock* dest = (wallvm::ir_types::IrBlock*)ttTerm.ops[0];
                            if (dest != bb && trueTgt.hasNoSideEffects() && trueTgt.ninsts - 1 <= 8)
                            {
                                // Merge true target's instructions into bb
                                for (u32 si = 0; si < trueTgt.ninsts - 1; si++)
                                {
                                    wallvm::ir_types::IrInst* si2 = trueTgt.insts[si];
                                    si2.parent = bb;
                                    bb.insertBefore(si2, term);
                                }
                                trueTgt.ninsts = 0;

                                // Redirect condbr's true arm
                                term.ops[1].removeUser(term);
                                dest.base.addUser(term);
                                term.ops[1] = &dest.base;

                                trueTgt.removePred(bb);
                                dest.addPred(bb);
                                self.dups++;
                                changed = true;
                                continue;
                            }
                        }
                    }

                    // Check if false target is a simple passthrough
                    if (falseTgt.npreds == 1 && falseTgt.ninsts >= 1 && falseTgt.parent == func)
                    {
                        wallvm::ir_types::IrInst* ftTerm = falseTgt.insts[falseTgt.ninsts - 1];
                        if (ftTerm.opcode == wallvm::irOps::IrOpcode::Br && ftTerm.nops == 1)
                        {
                            wallvm::ir_types::IrBlock* dest = (wallvm::ir_types::IrBlock*)ftTerm.ops[0];
                            if (dest != bb && falseTgt.hasNoSideEffects() && falseTgt.ninsts - 1 <= 8)
                            {
                                for (u32 si = 0; si < falseTgt.ninsts - 1; si++)
                                {
                                    wallvm::ir_types::IrInst* si2 = falseTgt.insts[si];
                                    si2.parent = bb;
                                    bb.insertBefore(si2, term);
                                }
                                falseTgt.ninsts = 0;

                                term.ops[2].removeUser(term);
                                dest.base.addUser(term);
                                term.ops[2] = &dest.base;

                                falseTgt.removePred(bb);
                                dest.addPred(bb);
                                self.dups++;
                                changed = true;
                                continue;
                            }
                        }
                    }
                }
            }
        }
        return self.dups > 0;
    }
}

pub bool irPassTailDup(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    if (!func) return false;
    TailDupPass pass = TailDupPass::new();
    return pass.run(func);
}
