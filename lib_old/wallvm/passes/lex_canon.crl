mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Lexicographical Canonicalization of Commutative Trees
// Flattens deeply nested, associative, and commutative expression chains
// and deterministically sorts operands using a strict lexicographical order.

static bool isAssocCommut(wallvm::irOps::IrOpcode op)
{
    switch (op)
    {
    case wallvm::irOps::IrOpcode::Add:
    case wallvm::irOps::IrOpcode::Mul:
    case wallvm::irOps::IrOpcode::And:
    case wallvm::irOps::IrOpcode::Or:
    case wallvm::irOps::IrOpcode::Xor:
        return true;
    default:
        return false;
    }
}

static i64 sortKey(wallvm::ir_types::IrValue* val)
{
    if (!val) return 0;
    if (val.kind == wallvm::ir_types::IrValueKind::ConstInt)
    {
        i64 v = (i64)val.valData;
        return v < 0 ? v - 1000000 : v;
    }
    if (val.kind == wallvm::ir_types::IrValueKind::Arg)
        return 10000000 + val.id;
    if (val.kind == wallvm::ir_types::IrValueKind::Inst)
        return 20000000 + val.id;
    return 30000000;
}

static bool valueLessThan(wallvm::ir_types::IrValue* a, wallvm::ir_types::IrValue* b)
{
    return sortKey(a) < sortKey(b);
}

static void sortOperandsLexicographic(wallvm::ir_types::IrInst* inst)
{
    if (inst.nops < 2) return;
    if (!isAssocCommut(inst.opcode)) return;
    if (inst.nops == 2)
    {
        if (valueLessThan(inst.ops[1], inst.ops[0]))
        {
            wallvm::ir_types::IrValue* tmp = inst.ops[0];
            inst.ops[0] = inst.ops[1];
            inst.ops[1] = tmp;
        }
    }
}

static wallvm::ir_types::IrValue* flattenSortChain(
    wallvm::ir_types::IrInst* root,
    wallvm::irOps::IrOpcode op,
    wallvm::ir_types::IrContext* ctx)
{
    u32 capacity = 16;
    wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(capacity);
    u32 count = 0;

    // Worklist of instructions to flatten
    u32 workCap = 16;
    wallvm::ir_types::IrInst** worklist = std::mman::alloc<wallvm::ir_types::IrInst*>(workCap);
    u32 workCount = 0;
    worklist[workCount] = root;
    workCount++;

    while (workCount > 0)
    {
        wallvm::ir_types::IrInst* cur = worklist[workCount - 1];
        workCount--;

        if (cur.nops >= 2 &&
            cur.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
        {
            wallvm::ir_types::IrInst* left = (wallvm::ir_types::IrInst*)cur.ops[0];
            if (left.opcode == op && isAssocCommut(op))
            {
                // Flatten: push left's both operands onto worklist
                for (u32 i = 0; i < left.nops; i++)
                {
                    if (left.ops[i].kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        // Another instruction to flatten - push to worklist
                        if (workCount >= workCap)
                        {
                            workCap *= 2;
                            wallvm::ir_types::IrInst** newW = std::mman::alloc<wallvm::ir_types::IrInst*>(workCap);
                            for (u32 j = 0; j < workCount; j++) newW[j] = worklist[j];
                            std::mman::dealloc<wallvm::ir_types::IrInst*>(worklist);
                            worklist = newW;
                        }
                        worklist[workCount] = (wallvm::ir_types::IrInst*)left.ops[i];
                        workCount++;
                    }
                    else
                    {
                        // Leaf value (ConstInt, Arg, etc.) - collect directly
                        if (count >= capacity)
                        {
                            capacity *= 2;
                            wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(capacity);
                            for (u32 j = 0; j < count; j++) newOps[j] = ops[j];
                            std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
                            ops = newOps;
                        }
                        ops[count] = left.ops[i];
                        count++;
                    }
                }
                continue;
            }
        }

        // Non-flattened: collect both operands as leaves
        if (cur.nops >= 1)
        {
            if (count >= capacity)
            {
                capacity *= 2;
                wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(capacity);
                for (u32 j = 0; j < count; j++) newOps[j] = ops[j];
                std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
                ops = newOps;
            }
            ops[count] = cur.ops[cur.nops - 1];
            count++;
        }
        if (cur.nops >= 2)
        {
            if (count >= capacity)
            {
                capacity *= 2;
                wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(capacity);
                for (u32 j = 0; j < count; j++) newOps[j] = ops[j];
                std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
                ops = newOps;
            }
            ops[count] = cur.ops[0];
            count++;
        }
    }

    std::mman::dealloc<wallvm::ir_types::IrInst*>(worklist);

    // Sort operands lexicographically
    for (u32 i = 0; i < count - 1; i++)
    {
        for (u32 j = i + 1; j < count; j++)
        {
            if (valueLessThan(ops[j], ops[i]))
            {
                wallvm::ir_types::IrValue* tmp = ops[i];
                ops[i] = ops[j];
                ops[j] = tmp;
            }
        }
    }

    // Rebuild the chain: fold left-to-right
    wallvm::ir_types::IrValue* result = ops[0];
    for (u32 i = 1; i < count; i++)
    {
        wallvm::ir_types::IrValue** pair = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        pair[0] = result;
        pair[1] = ops[i];
        wallvm::ir_types::IrInst* merged = ctx.createInst(op, root.base.type, pair, 2, 0, 0);
        result = &merged.base;
        std::mman::dealloc<wallvm::ir_types::IrValue*>(pair);
    }

    std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    return result;
}

pub bool irPassLexCanonicalize(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!func || func*.isExtern) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func*.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (!isAssocCommut(inst.opcode)) continue;

            // Check if left operand is same op (nested associative chain)
            if (inst.nops >= 2 && inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
            {
                wallvm::ir_types::IrInst* left = (wallvm::ir_types::IrInst*)inst.ops[0];
                if (left.opcode == inst.opcode)
                {
                    wallvm::ir_types::IrValue* sorted = flattenSortChain(inst, inst.opcode, ctx);
                    if (sorted != &inst.base)
                    {
                        // Replace this instruction's uses with the sorted chain
                        // For simplicity, just sort the two operands of this instruction
                        sortOperandsLexicographic(inst);
                        changed = true;
                    }
                    continue;
                }
            }

            sortOperandsLexicographic(inst);
        }
    }

    return changed;
}
