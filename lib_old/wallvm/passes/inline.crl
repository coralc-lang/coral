mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Key-value map for value/block remapping during cloning
struct ValMap
{
    wallvm::ir_types::IrValue** keys;
    wallvm::ir_types::IrValue** vals;
    u32 count;
    u32 cap;

    void init()
    {
        self.keys = null;
        self.vals = null;
        self.count = 0;
        self.cap = 0;
    }

    void put(wallvm::ir_types::IrValue* k, wallvm::ir_types::IrValue* v)
    {
        if (self.count >= self.cap)
        {
            u32 nc = self.cap ? self.cap * 2 : 32;
            wallvm::ir_types::IrValue** nk = std::mman::alloc<wallvm::ir_types::IrValue*>(nc);
            wallvm::ir_types::IrValue** nv = std::mman::alloc<wallvm::ir_types::IrValue*>(nc);
            for (u32 i = 0; i < self.count; i++)
            {
                nk[i] = self.keys[i];
                nv[i] = self.vals[i];
            }
            if (self.keys) std::mman::dealloc<wallvm::ir_types::IrValue*>(self.keys);
            if (self.vals) std::mman::dealloc<wallvm::ir_types::IrValue*>(self.vals);
            self.keys = nk;
            self.vals = nv;
            self.cap = nc;
        }
        self.keys[self.count] = k;
        self.vals[self.count] = v;
        self.count++;
    }

    wallvm::ir_types::IrValue* get(wallvm::ir_types::IrValue* k)
    {
        for (u32 i = 0; i < self.count; i++)
            if (self.keys[i] == k)
                return self.vals[i];
        return null;
    }

    void free()
    {
        if (self.keys) std::mman::dealloc<wallvm::ir_types::IrValue*>(self.keys);
        if (self.vals) std::mman::dealloc<wallvm::ir_types::IrValue*>(self.vals);
        self.keys = null;
        self.vals = null;
        self.count = 0;
        self.cap = 0;
    }
};

// Cost model constants
const u32 COST_LOAD = 2;
const u32 COST_STORE = 3;
const u32 COST_CALL = 5;
const u32 COST_BRANCH = 2;
const u32 COST_ARITH = 1;
const u32 COST_CMP = 1;
const u32 COST_CAST = 1;
const u32 COST_PHI = 2;
const u32 COST_GEP = 1;
const u32 COST_ALLOCA = 1;
const u32 COST_RET = 1;
const u32 COST_SELECT = 1;
const u32 COST_UNREACHABLE = 0;

// Thresholds per opt level
const u32 INLINE_THRESHOLD_O1 = 30;
const u32 INLINE_THRESHOLD_O2 = 60;
const u32 INLINE_THRESHOLD_O3 = 120;
const u32 MAX_INLINE_DEPTH = 4;
const u32 MAX_CALLER_GROWTH = 4;

// Cost estimation
static u32 estimateInstCost(wallvm::ir_types::IrInst* inst)
{
    switch (inst.opcode)
    {
    case wallvm::irOps::IrOpcode::Load: return COST_LOAD;
    case wallvm::irOps::IrOpcode::Store: return COST_STORE;
    case wallvm::irOps::IrOpcode::Call: return COST_CALL;
    case wallvm::irOps::IrOpcode::Br: case wallvm::irOps::IrOpcode::CondBr: return COST_BRANCH;
    case wallvm::irOps::IrOpcode::Ret: return COST_RET;
    case wallvm::irOps::IrOpcode::Unreachable: case wallvm::irOps::IrOpcode::Noret: return COST_UNREACHABLE;
    case wallvm::irOps::IrOpcode::Phi: return COST_PHI;
    case wallvm::irOps::IrOpcode::Gep: return COST_GEP;
    case wallvm::irOps::IrOpcode::Alloca: return COST_ALLOCA;
    case wallvm::irOps::IrOpcode::Select: return COST_SELECT;
    case wallvm::irOps::IrOpcode::ICmp: case wallvm::irOps::IrOpcode::FCmp: return COST_CMP;
    case wallvm::irOps::IrOpcode::Trunc: case wallvm::irOps::IrOpcode::Zext: case wallvm::irOps::IrOpcode::Sext:
    case wallvm::irOps::IrOpcode::FpTrunc: case wallvm::irOps::IrOpcode::FpExt:
    case wallvm::irOps::IrOpcode::FpToSi: case wallvm::irOps::IrOpcode::SiToFp:
    case wallvm::irOps::IrOpcode::FpToUi: case wallvm::irOps::IrOpcode::UiToFp:
    case wallvm::irOps::IrOpcode::Bitcast: return COST_CAST;
    default: return COST_ARITH;
    }
}

static u32 estimateFuncCost(wallvm::ir_types::IrFunc* f)
{
    u32 cost = 0;
    for (u32 bi = 0; bi < f.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = f.blocks[bi];
        u32 start = (bi == 0) ? f.nparams : 0;
        if (start > bb.ninsts) start = bb.ninsts;
        for (u32 ii = start; ii < bb.ninsts; ii++)
            cost += estimateInstCost(bb.insts[ii]);
    }
    return cost;
}

static u32 countCallSites(wallvm::ir_types::IrFunc* caller, wallvm::ir_types::IrFunc* callee)
{
    u32 count = 0;
    for (u32 bi = 0; bi < caller.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = caller.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (inst.opcode == wallvm::irOps::IrOpcode::Call && inst.nops >= 1 &&
                inst.ops[0] == (wallvm::ir_types::IrValue*)callee)
                count++;
        }
    }
    return count;
}

// Check if the callee contains any calls back to the caller (recursive)
static bool isRecursive(wallvm::ir_types::IrFunc* caller, wallvm::ir_types::IrFunc* callee)
{
    if (callee == caller) return true;
    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = callee.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (inst.opcode == wallvm::irOps::IrOpcode::Call && inst.nops >= 1)
            {
                wallvm::ir_types::IrValue* cv = inst.ops[0];
                if (cv && cv.kind == wallvm::ir_types::IrValueKind::Func &&
                    (wallvm::ir_types::IrFunc*)cv == caller)
                    return true;
            }
        }
    }
    return false;
}

// Count how many instructions reference pointer types (memory operations)
static u32 countMemoryOps(wallvm::ir_types::IrFunc* f)
{
    u32 n = 0;
    for (u32 bi = 0; bi < f.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = f.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (inst.opcode == wallvm::irOps::IrOpcode::Load ||
                inst.opcode == wallvm::irOps::IrOpcode::Store ||
                inst.opcode == wallvm::irOps::IrOpcode::Alloca ||
                inst.opcode == wallvm::irOps::IrOpcode::Gep)
                n++;
        }
    }
    return n;
}

// Does the function have any side effects (stores, calls, volatile loads)?
static bool hasSideEffects(wallvm::ir_types::IrFunc* f)
{
    for (u32 bi = 0; bi < f.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = f.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (inst.opcode == wallvm::irOps::IrOpcode::Store) return true;
            if (inst.opcode == wallvm::irOps::IrOpcode::Call) return true;
        }
    }
    return false;
}

// Check if the callee only has one call site and is small enough to always inline
static bool alwaysInlineCandidate(wallvm::ir_types::IrFunc* caller, wallvm::ir_types::IrFunc* callee, u32 threshold)
{
    u32 cost = estimateFuncCost(callee);
    u32 callSites = countCallSites(caller, callee);
    // Single-use small function: always inline
    if (callSites == 1 && cost <= threshold / 2) return true;
    // Very tiny function: inline regardless
    if (cost <= 5) return true;
    return false;
}

// Clone infrastructure
static u32 countBodyInsts(wallvm::ir_types::IrFunc* f)
{
    u32 n = 0;
    u32 skip = f.nparams;
    for (u32 bi = 0; bi < f.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = f.blocks[bi];
        u32 start = (bi == 0) ? skip : 0;
        if (start > bb.ninsts) start = bb.ninsts;
        n += bb.ninsts - start;
    }
    return n;
}

static wallvm::ir_types::IrInst* cloneInst(wallvm::ir_types::IrInst* old,
                                        wallvm::ir_types::IrBlock* newBlock,
                                        ValMap* valMap, ValMap* blkMap,
                                        wallvm::ir_types::IrContext* ctx)
{
    wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(old.nops > 0 ? old.nops : 1);

    for (u32 i = 0; i < old.nops; i++)
    {
        wallvm::ir_types::IrValue* op = old.ops[i];
        if (!op) { newOps[i] = null; continue; }

        if (op.kind == wallvm::ir_types::IrValueKind::Inst)
        {
            wallvm::ir_types::IrValue* m = valMap.get(op);
            if (m) { newOps[i] = m; continue; }
        }
        else if (op.kind == wallvm::ir_types::IrValueKind::Block)
        {
            wallvm::ir_types::IrValue* m = blkMap.get(op);
            if (m) { newOps[i] = m; continue; }
        }

        newOps[i] = op;
    }

    wallvm::ir_types::IrInst* ni = ctx.createInst(old.opcode, old.base.type, newOps, old.nops,
                                (u64)old.icmpPred, (u64)old.fcmpPred);

    newBlock.addInst(ni);
    valMap.put(&old.base, &ni.base);

    // Copy debug info
    if (old.debugLoc.file)
        ni.setDebugLoc(old.debugLoc.file, old.debugLoc.line, old.debugLoc.col);

    // Copy var debug info
    for (u32 vi = 0; vi < old.nvarDbg; vi++)
        ni.addVarDebug(old.varDbg[vi].varName, old.varDbg[vi].varType,
                       old.varDbg[vi].line, old.varDbg[vi].col, old.varDbg[vi].argIndex);

    for (u32 i = 0; i < old.nops; i++)
        if (newOps[i])
            newOps[i].addUser(ni);

    return ni;
}

static void eraseInstAt(wallvm::ir_types::IrBlock* bb, u32 ii)
{
    for (u32 j = ii; j < bb.ninsts - 1; j++)
        bb.insts[j] = bb.insts[j + 1];
    bb.ninsts--;
}

static void transferSuccs(wallvm::ir_types::IrBlock* src, wallvm::ir_types::IrBlock* dst)
{
    for (u32 i = 0; i < src.nsuccs; i++)
    {
        wallvm::ir_types::IrBlock* succ = src.succs[i];
        succ.removePred(src);
        dst.addSucc(succ);
        for (u32 pi = 0; pi < succ.ninsts; pi++)
        {
            wallvm::ir_types::IrInst* phi = succ.insts[pi];
            if (phi.opcode == wallvm::irOps::IrOpcode::Phi)
            {
                for (u32 oi = 1; oi < phi.nops; oi += 2)
                    if (phi.ops[oi] == &src.base)
                        phi.ops[oi] = &dst.base;
            }
        }
    }
    src.nsuccs = 0;
    if (src.succs)
    {
        std::mman::dealloc<wallvm::ir_types::IrBlock*>(src.succs);
        src.succs = null;
    }
    src.capSuccs = 0;
}

static void moveInstsAfter(wallvm::ir_types::IrBlock* src, u32 startIdx, wallvm::ir_types::IrBlock* dst)
{
    u32 nToMove = src.ninsts - startIdx;
    for (u32 i = 0; i < nToMove; i++)
    {
        wallvm::ir_types::IrInst* inst = src.insts[startIdx];
        eraseInstAt(src, startIdx);
        inst.parent = dst;
        dst.addInst(inst);
    }
}

// Core inlining logic
static bool inlineCall(wallvm::ir_types::IrFunc* caller, wallvm::ir_types::IrBlock* callBlock, wallvm::ir_types::IrInst* callInst,
                        u32 instIdx, wallvm::ir_types::IrFunc* callee, wallvm::ir_types::IrContext* ctx)
{
    u32 nCallArgs = (callInst.nops > 0) ? callInst.nops - 1 : 0;
    wallvm::ir_types::IrValue** callArgs = (callInst.nops > 1) ? &callInst.ops[1] : null;

    wallvm::ir_types::IrBlock* afterBlock = ctx.createBlock("after_inline");
    caller.addBlock(afterBlock);

    transferSuccs(callBlock, afterBlock);
    moveInstsAfter(callBlock, instIdx + 1, afterBlock);

    for (u32 i = 0; i < callInst.nops; i++)
        if (callInst.ops[i])
            callInst.ops[i].removeUser(callInst);
    eraseInstAt(callBlock, instIdx);

    ValMap blkMap;
    blkMap.init();

    wallvm::ir_types::IrBlock** newBlocks = std::mman::alloc<wallvm::ir_types::IrBlock*>(callee.nblocks);
    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* ob = callee.blocks[bi];
        wallvm::ir_types::IrBlock* nb = ctx.createBlock(ob.base.name);
        caller.addBlock(nb);
        newBlocks[bi] = nb;
        blkMap.put(&ob.base, &nb.base);
    }
    wallvm::ir_types::IrBlock* calleeEntry = newBlocks[0];

    ValMap valMap;
    valMap.init();

    u32 nparams = callee.nparams;
    wallvm::ir_types::IrBlock* oldEntry = callee.blocks[0];
    for (u32 i = 0; i < nparams && i < nCallArgs; i++)
    {
        if (i < oldEntry.ninsts)
        {
            wallvm::ir_types::IrInst* paramInst = oldEntry.insts[i];
            valMap.put(&paramInst.base, callArgs[i]);
        }
    }

    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* ob = callee.blocks[bi];
        wallvm::ir_types::IrBlock* nb = newBlocks[bi];
        u32 start = (bi == 0) ? nparams : 0;

        for (u32 ii = start; ii < ob.ninsts; ii++)
            cloneInst(ob.insts[ii], nb, &valMap, &blkMap, ctx);
    }

    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* nb = newBlocks[bi];
        for (u32 ii = 0; ii < nb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* ni = nb.insts[ii];
            for (u32 j = 0; j < ni.nops; j++)
            {
                wallvm::ir_types::IrValue* op = ni.ops[j];
                if (!op || op.kind != wallvm::ir_types::IrValueKind::Inst) continue;
                wallvm::ir_types::IrValue* m = valMap.get(op);
                if (!m || m == op) continue;
                op.removeUser(ni);
                ni.ops[j] = m;
                m.addUser(ni);
            }
        }
    }

    // Wire up control flow: br from callBlock to callee entry
    {
        wallvm::ir_types::IrValue** brOps = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        brOps[0] = &calleeEntry.base;
        wallvm::ir_types::IrInst* brInst = ctx.createInst(wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), brOps, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(brOps);
        callBlock.addInst(brInst);
        calleeEntry.base.addUser(brInst);
        callBlock.addSucc(calleeEntry);
    }

    // Handle return values
    u32 retCount = 0;
    wallvm::ir_types::IrInst** retInsts = std::mman::alloc<wallvm::ir_types::IrInst*>(callee.nblocks);
    for (u32 bi = 0; bi < callee.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* nb = newBlocks[bi];
        for (u32 ii = 0; ii < nb.ninsts; ii++)
        {
            if (nb.insts[ii].opcode == wallvm::irOps::IrOpcode::Ret)
                retInsts[retCount++] = nb.insts[ii];
        }
    }

    wallvm::ir_types::IrBlock* contBlock = ctx.createBlock("cont_inline");
    caller.addBlock(contBlock);

    bool hasRetVal = callInst.base.type && callInst.base.type.kind != wallvm::ir_types::IrTypeKind::Void;

    for (u32 ri = 0; ri < retCount; ri++)
    {
        wallvm::ir_types::IrInst* ret = retInsts[ri];
        wallvm::ir_types::IrBlock* retBlock = ret.parent;

        for (u32 oi = 0; oi < ret.nops; oi++)
            if (ret.ops[oi])
                ret.ops[oi].removeUser(ret);

        for (u32 ii = 0; ii < retBlock.ninsts; ii++)
        {
            if (retBlock.insts[ii] == ret)
            {
                eraseInstAt(retBlock, ii);
                break;
            }
        }

        retBlock.addSucc(contBlock);

        wallvm::ir_types::IrValue** brOps = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        brOps[0] = &contBlock.base;
        wallvm::ir_types::IrInst* brInst =
            ctx.createInst(wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), brOps, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(brOps);
        retBlock.addInst(brInst);
        contBlock.base.addUser(brInst);
    }

    wallvm::ir_types::IrValue* mergedRetVal = null;

    if (hasRetVal && retCount > 1)
    {
        wallvm::ir_types::IrType* retTy = callInst.base.type;
        wallvm::ir_types::IrValue** phiVals = std::mman::alloc<wallvm::ir_types::IrValue*>(retCount);
        wallvm::ir_types::IrValue** phiBlks = std::mman::alloc<wallvm::ir_types::IrValue*>(retCount);
        u32 phiCount = 0;

        for (u32 ri = 0; ri < retCount; ri++)
        {
            wallvm::ir_types::IrInst* ret = retInsts[ri];
            if (ret.nops > 0 && ret.ops[0])
            {
                wallvm::ir_types::IrBlock* retBlock = ret.parent;
                phiVals[phiCount] = ret.ops[0];
                phiBlks[phiCount] = &retBlock.base;
                phiCount++;
            }
        }

        if (phiCount > 1)
        {
            wallvm::ir_types::IrValue** phiOps = std::mman::alloc<wallvm::ir_types::IrValue*>(phiCount * 2);
            for (u32 i = 0; i < phiCount; i++)
            {
                phiOps[i * 2] = phiVals[i];
                phiOps[i * 2 + 1] = phiBlks[i];
            }
            wallvm::ir_types::IrInst* phiInst =
                ctx.createInst(wallvm::irOps::IrOpcode::Phi, retTy, phiOps, phiCount * 2, 0, 0);
            contBlock.addInst(phiInst);
            for (u32 i = 0; i < phiCount * 2; i++)
                if (phiOps[i])
                    phiOps[i].addUser(phiInst);
            std::mman::dealloc<wallvm::ir_types::IrValue*>(phiOps);
            mergedRetVal = &phiInst.base;
        }
        else if (phiCount == 1)
        {
            mergedRetVal = phiVals[0];
        }

        if (phiVals) std::mman::dealloc<wallvm::ir_types::IrValue*>(phiVals);
        if (phiBlks) std::mman::dealloc<wallvm::ir_types::IrValue*>(phiBlks);
    }
    else if (hasRetVal && retCount == 1)
    {
        wallvm::ir_types::IrInst* ret = retInsts[0];
        if (ret.nops > 0 && ret.ops[0])
            mergedRetVal = ret.ops[0];
    }

    for (u32 ri = 0; ri < retCount; ri++)
        retInsts[ri].erase();

    // br from contBlock to afterBlock
    {
        wallvm::ir_types::IrValue** brOps = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        brOps[0] = &afterBlock.base;
        wallvm::ir_types::IrInst* brInst =
            ctx.createInst(wallvm::irOps::IrOpcode::Br, ctx.tyVoid(), brOps, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(brOps);
        contBlock.addInst(brInst);
        afterBlock.base.addUser(brInst);
        contBlock.addSucc(afterBlock);
    }

    if (hasRetVal && mergedRetVal)
    {
        wallvm::ir_types::IrValue* callVal = &callInst.base;
        callVal.replaceAllUses(mergedRetVal);
    }

    callInst.erase();

    std::mman::dealloc<wallvm::ir_types::IrBlock*>(newBlocks);
    std::mman::dealloc<wallvm::ir_types::IrInst*>(retInsts);

    valMap.free();
    blkMap.free();

    return true;
}

// Main inline pass
pub bool irPassInline(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;
    if (func*.nblocks == 0) return false;

    // Determine threshold based on function's own size
    u32 callerCost = estimateFuncCost(func);
    u32 threshold = INLINE_THRESHOLD_O1;
    if (callerCost > 200) threshold = INLINE_THRESHOLD_O3;
    else if (callerCost > 80) threshold = INLINE_THRESHOLD_O2;

    bool changed = false;
    u32 totalInlined = 0;
    const u32 MAX_TOTAL_INLINED = 500;

    bool progress = true;
    while (progress && totalInlined < MAX_TOTAL_INLINED)
    {
        progress = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];

            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];
                if (inst.opcode != wallvm::irOps::IrOpcode::Call) continue;

                if (inst.nops < 1) continue;
                wallvm::ir_types::IrValue* calleeVal = inst.ops[0];
                if (!calleeVal || calleeVal.kind != wallvm::ir_types::IrValueKind::Func) continue;

                wallvm::ir_types::IrFunc* callee = (wallvm::ir_types::IrFunc*)calleeVal;

                // Never inline extern, recursive, or self-recursive callees
                if (callee.isExtern) continue;
                if (callee == func || isRecursive(func, callee)) continue;

                // Cost-benefit analysis
                u32 calleeCost = estimateFuncCost(callee);
                u32 callSites = countCallSites(func, callee);

                // Benefit: instructions saved = calleeCost * callSites - calleeCost (the callee body)
                // Cost: calleeCost (one copy inlined)
                // Net benefit = calleeCost * (callSites - 1) when callSites > 1
                // For single call site, benefit = constant propagation opportunity

                bool shouldInline = false;

                if (alwaysInlineCandidate(func, callee, threshold))
                {
                    shouldInline = true;
                }
                else if (callSites == 1)
                {
                    // Single call site: inline if callee is small enough
                    // Account for caller growth
                    u32 growth = calleeCost;
                    if (callerCost + growth <= threshold * MAX_CALLER_GROWTH)
                        shouldInline = (calleeCost <= threshold);
                }
                else
                {
                    // Multiple call sites: more aggressive - the benefit is multiplied
                    // But we only inline if callee is very small to avoid code bloat
                    shouldInline = (calleeCost <= threshold / 3);
                }

                // Never inline functions with too many memory ops (likely large state)
                if (countMemoryOps(callee) > calleeCost / 2)
                    shouldInline = false;

                // Don't inline functions that contain calls (will be handled by recursive inlining)
                // unless they're very small
                if (!shouldInline && calleeCost <= 8)
                    shouldInline = true;

                if (!shouldInline) continue;

                if (inlineCall(func, bb, inst, ii, callee, ctx))
                {
                    changed = true;
                    progress = true;
                    totalInlined++;
                    callerCost = estimateFuncCost(func);
                    break;
                }
            }

            if (progress) break;
        }
    }
    return changed;
}
