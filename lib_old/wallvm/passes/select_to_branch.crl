mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Select-to-Branch conversion: converts select instructions into branching
// when the selected value has side effects (calls, stores) or when branching
// is more efficient (e.g., for cmov which requires both values computed).

struct SelectToBranchPass
{
    wallvm::ir_types::IrContext* ctx;
    u64 conversions;

    SelectToBranchPass new(wallvm::ir_types::IrContext* ctx)
    {
        SelectToBranchPass p;
        p.ctx = ctx;
        p.conversions = 0;
        return p;
    }

    wallvm::ir_types::IrBlock* createBlock(wallvm::ir_types::IrFunc* func)
    {
        wallvm::ir_types::IrBlock* bb = std::mman::alloc<wallvm::ir_types::IrBlock>(1);
        *bb = (wallvm::ir_types::IrBlock) {};
        func*.addBlock(bb);
        return bb;
    }

    wallvm::ir_types::IrInst* createTerminator(wallvm::ir_types::IrBlock* parent)
    {
        wallvm::ir_types::IrInst* inst = std::mman::alloc<wallvm::ir_types::IrInst>(1);
        *inst = (wallvm::ir_types::IrInst) {};
        inst.parent = parent;
        return inst;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.conversions = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];
                if (inst.opcode != wallvm::irOps::IrOpcode::Select) continue;
                if (inst.nops < 3) continue;

                wallvm::ir_types::IrValue* trueVal = inst.ops[1];
                wallvm::ir_types::IrValue* falseVal = inst.ops[2];
                bool trueHasSideEffects = hasSideEffects(trueVal);
                bool falseHasSideEffects = hasSideEffects(falseVal);

                if (!trueHasSideEffects && !falseHasSideEffects) continue;

                wallvm::ir_types::IrValue* cond = inst.ops[0];

                wallvm::ir_types::IrBlock* trueBB = createBlock(func);
                wallvm::ir_types::IrBlock* falseBB = createBlock(func);
                wallvm::ir_types::IrBlock* mergeBB = createBlock(func);

                // Terminate original block with condbr
                wallvm::ir_types::IrInst* term = createTerminator(bb);
                term.opcode = wallvm::irOps::IrOpcode::CondBr;
                term.nops = 3;
                term.ops[0] = cond;
                term.ops[1] = &trueBB.base;
                term.ops[2] = &falseBB.base;
                cond.addUser(term);
                trueBB.base.addUser(term);
                falseBB.base.addUser(term);
                bb.addInst(term);

                bb.addSucc(trueBB);
                bb.addSucc(falseBB);

                // trueBB: br mergeBB
                wallvm::ir_types::IrInst* trueTerm = createTerminator(trueBB);
                trueTerm.opcode = wallvm::irOps::IrOpcode::Br;
                trueTerm.nops = 1;
                trueTerm.ops[0] = &mergeBB.base;
                mergeBB.base.addUser(trueTerm);
                trueBB.addInst(trueTerm);
                trueBB.addSucc(mergeBB);

                // falseBB: br mergeBB
                wallvm::ir_types::IrInst* falseTerm = createTerminator(falseBB);
                falseTerm.opcode = wallvm::irOps::IrOpcode::Br;
                falseTerm.nops = 1;
                falseTerm.ops[0] = &mergeBB.base;
                mergeBB.base.addUser(falseTerm);
                falseBB.addInst(falseTerm);
                falseBB.addSucc(mergeBB);

                // Move instructions after the select into the merge block
                u32 remaining = bb.ninsts - (ii + 1);
                if (remaining > 0)
                {
                    for (u32 si = ii + 1; si < bb.ninsts; si++)
                    {
                        wallvm::ir_types::IrInst* si2 = bb.insts[si];
                        si2.parent = mergeBB;
                        mergeBB.addInst(si2);
                    }
                    bb.ninsts = ii + 1;
                }
                else
                {
                    bb.ninsts = ii + 1;
                }

                // Convert the select into a phi in mergeBB
                inst.opcode = wallvm::irOps::IrOpcode::Phi;
                inst.nops = 4;
                inst.ops[0] = trueVal;
                inst.ops[1] = &trueBB.base;
                inst.ops[2] = falseVal;
                inst.ops[3] = &falseBB.base;
                trueVal.addUser(inst);
                trueBB.base.addUser(inst);
                falseVal.addUser(inst);
                falseBB.base.addUser(inst);

                // Phi goes at the beginning of mergeBB
                if (mergeBB.ninsts > 0)
                {
                    mergeBB.insertBefore(inst, mergeBB.insts[0]);
                }
                else
                {
                    mergeBB.addInst(inst);
                }
                inst.parent = mergeBB;

                self.conversions++;
                changed = true;
                break;
            }
        }

        return changed;
    }

    bool hasSideEffects(wallvm::ir_types::IrValue* val)
    {
        if (!val) return false;
        if (val.kind != wallvm::ir_types::IrValueKind::Inst) return false;
        wallvm::ir_types::IrInst* inst = (wallvm::ir_types::IrInst*)val;
        switch (inst.opcode)
        {
        case wallvm::irOps::IrOpcode::Call:
        case wallvm::irOps::IrOpcode::Store:
        case wallvm::irOps::IrOpcode::AtomicStore:
        case wallvm::irOps::IrOpcode::AtomicRmw:
        case wallvm::irOps::IrOpcode::AtomicCmpXchg:
        case wallvm::irOps::IrOpcode::Fence:
        case wallvm::irOps::IrOpcode::GcWriteBarrier:
        case wallvm::irOps::IrOpcode::GcSafepoint:
        case wallvm::irOps::IrOpcode::InlineAsm:
            return true;
        default:
            return false;
        }
    }
}

pub bool irPassSelectToBranch(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!func || !ctx) return false;

    SelectToBranchPass pass = SelectToBranchPass.new(ctx);
    return pass.run(func);
}
