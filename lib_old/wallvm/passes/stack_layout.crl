mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Static Spatial Layout Sorting of Stack Variables (Anti-Clustering)
// Reorganizes local stack variables by access frequency and size class,
// grouping hot variables together to fit within cache lines.

struct StackVarInfo
{
    wallvm::ir_types::IrInst* alloca;
    u32 accessCount;
    u32 sizeBytes;
    bool isHot;
}

pub bool irPassStackLayout(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    if (!func || func*.isExtern) return false;
    bool changed = false;

    // Count allocas and their access frequencies
    u32 allocaCap = 16;
    StackVarInfo* vars = std::mman::alloc<StackVarInfo>(allocaCap);
    u32 nvars = 0;

    for (u32 bi = 0; bi < func*.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];

            // Collect allocas
            if (inst.opcode == wallvm::irOps::IrOpcode::Alloca)
            {
                if (nvars >= allocaCap)
                {
                    allocaCap *= 2;
                    StackVarInfo* newV = std::mman::alloc<StackVarInfo>(allocaCap);
                    for (u32 i = 0; i < nvars; i++) newV[i] = vars[i];
                    std::mman::dealloc<StackVarInfo>(vars);
                    vars = newV;
                }
                vars[nvars].alloca = inst;
                vars[nvars].accessCount = 0;

                // Estimate size from type
                wallvm::ir_types::IrType* ty = inst.base.type;
                if (ty)
                {
                    switch (ty.kind)
                    {
                    case wallvm::ir_types::IrTypeKind::Int:
                        vars[nvars].sizeBytes = (ty.width + 7) / 8;
                        break;
                    case wallvm::ir_types::IrTypeKind::Float:
                        vars[nvars].sizeBytes = (ty.width + 7) / 8;
                        break;
                    case wallvm::ir_types::IrTypeKind::Ptr:
                        vars[nvars].sizeBytes = 8;
                        break;
                    default:
                        vars[nvars].sizeBytes = 8;
                        break;
                    }
                }
                else
                {
                    vars[nvars].sizeBytes = 8;
                }

                vars[nvars].isHot = false;
                nvars++;
            }
        }
    }

    if (nvars == 0)
    {
        std::mman::dealloc<StackVarInfo>(vars);
        return false;
    }

    // Count accesses to each alloca (loads/stores that use it as pointer)
    for (u32 bi = 0; bi < func*.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (inst.opcode == wallvm::irOps::IrOpcode::Load ||
                inst.opcode == wallvm::irOps::IrOpcode::Store ||
                inst.opcode == wallvm::irOps::IrOpcode::Gep)
            {
                if (inst.nops > 0 && inst.ops[0] &&
                    inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
                {
                    wallvm::ir_types::IrInst* src = (wallvm::ir_types::IrInst*)inst.ops[0];
                    if (src.opcode == wallvm::irOps::IrOpcode::Alloca)
                    {
                        // Find which variable this is
                        for (u32 vi = 0; vi < nvars; vi++)
                        {
                            if (vars[vi].alloca == src)
                            {
                                vars[vi].accessCount++;
                                break;
                            }
                        }
                    }
                }
            }
        }
    }

    // Sort by access count (descending), hot variables first
    for (u32 i = 0; i < nvars - 1; i++)
    {
        for (u32 j = i + 1; j < nvars; j++)
        {
            if (vars[j].accessCount > vars[i].accessCount)
            {
                StackVarInfo tmp = vars[i];
                vars[i] = vars[j];
                vars[j] = tmp;
            }
        }
    }

    // Mark hot variables (those with above-median access count)
    u32 medianIdx = nvars / 2;
    u32 medianCount = vars[medianIdx].accessCount;
    for (u32 i = 0; i < nvars; i++)
    {
        vars[i].isHot = (vars[i].accessCount >= medianCount);
    }

    // Reorder the allocas in the entry block
    wallvm::ir_types::IrBlock* entry = func*.blocks[0];
    if (!entry)
    {
        std::mman::dealloc<StackVarInfo>(vars);
        return false;
    }

    // Find all allocas in entry block
    u32 entryAllocas = 0;
    for (u32 ii = 0; ii < entry.ninsts; ii++)
    {
        if (entry.insts[ii].opcode == wallvm::irOps::IrOpcode::Alloca)
            entryAllocas++;
    }

    if (entryAllocas < 2)
    {
        std::mman::dealloc<StackVarInfo>(vars);
        return false;
    }

    // Build new instruction order: hot allocas first, then cold
    u32 newCap = entry.ninsts;
    wallvm::ir_types::IrInst** newInsts = std::mman::alloc<wallvm::ir_types::IrInst*>(newCap);
    u32 newCount = 0;

    // First: all non-alloca instructions (in order)
    for (u32 ii = 0; ii < entry.ninsts; ii++)
    {
        if (entry.insts[ii].opcode != wallvm::irOps::IrOpcode::Alloca)
        {
            newInsts[newCount] = entry.insts[ii];
            newCount++;
        }
    }

    // Then: hot allocas in sorted order
    for (u32 vi = 0; vi < nvars; vi++)
    {
        if (vars[vi].isHot)
        {
            newInsts[newCount] = vars[vi].alloca;
            newCount++;
        }
    }

    // Then: cold allocas in sorted order
    for (u32 vi = 0; vi < nvars; vi++)
    {
        if (!vars[vi].isHot)
        {
            newInsts[newCount] = vars[vi].alloca;
            newCount++;
        }
    }

    // Replace entry block instructions
    std::mman::dealloc<wallvm::ir_types::IrInst*>(entry.insts);
    entry.insts = newInsts;
    entry.ninsts = newCount;
    changed = true;

    std::mman::dealloc<StackVarInfo>(vars);
    return changed;
}
