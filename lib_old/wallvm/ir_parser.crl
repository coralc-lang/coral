mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// IR Parser - parses text IR back into IR structures
// Enables round-tripping: IR → text → IR

pub struct IrParser
{
    wallvm::ir_types::IrContext* ctx;
    str input;
    u32 pos;
    u32 len;
    std::cchar currentChar;
    u32 line;
    u32 column;

    // Name tables for SSA values
    char** valueNames;
    wallvm::ir_types::IrValue** values;
    u32 numValues;
    u32 capValues;

    // Block name table
    char** blockNames;
    wallvm::ir_types::IrBlock** blocks;
    u32 numBlocks;
    u32 capBlocks;

    // Function being parsed
    wallvm::ir_types::IrFunc* currentFunc;
}

pub IrParser new(wallvm::ir_types::IrContext* ctx)
{
    IrParser p;
    p.ctx = ctx;
    p.input = "";
    p.pos = 0;
    p.len = 0;
    p.currentChar = 0;
    p.line = 1;
    p.column = 1;
    p.valueNames = null;
    p.values = null;
    p.numValues = 0;
    p.capValues = 0;
    p.blockNames = null;
    p.blocks = null;
    p.numBlocks = 0;
    p.capBlocks = 0;
    p.currentFunc = null;
    return p;
}

pub void destroy(IrParser* p)
{
    if (p.valueNames) std::mman::dealloc<char*>(p.valueNames);
    if (p.values) std::mman::dealloc<wallvm::ir_types::IrValue*>(p.values);
    if (p.blockNames) std::mman::dealloc<char*>(p.blockNames);
    if (p.blocks) std::mman::dealloc<wallvm::ir_types::IrBlock*>(p.blocks);
}

// Lexer helpers
static void advance(IrParser* p)
{
    if (p.pos < p.len)
    {
        p.currentChar = p.input.ptr[p.pos];
        p.pos++;
        if (p.currentChar == '\n')
        {
            p.line++;
            p.column = 1;
        }
        else
        {
            p.column++;
        }
    }
    else
    {
        p.currentChar = 0;
    }
}

static void skipWhitespace(IrParser* p)
{
    while (p.currentChar == ' ' || p.currentChar == '\t' ||
           p.currentChar == '\n' || p.currentChar == '\r')
    {
        advance(p);
    }
}

static void skipComment(IrParser* p)
{
    if (p.currentChar == ';')
    {
        while (p.currentChar != '\n' && p.currentChar != 0)
            advance(p);
        skipWhitespace(p);
    }
}

static bool matchChar(IrParser* p, std::cchar c)
{
    if (p.currentChar == c)
    {
        advance(p);
        return true;
    }
    return false;
}

static bool matchString(IrParser* p, str pat)
{
    u32 i = 0;
    while (i < pat.len && p.currentChar == pat.ptr[i])
    {
        advance(p);
        i++;
    }
    return i == pat.len;
}

// Parse identifier
static char* parseIdent(IrParser* p)
{
    u32 start = p.pos - 1;
    while ((p.currentChar >= 'a' && p.currentChar <= 'z') ||
           (p.currentChar >= 'A' && p.currentChar <= 'Z') ||
           (p.currentChar >= '0' && p.currentChar <= '9') ||
           p.currentChar == '_' || p.currentChar == '.' || p.currentChar == '-')
    {
        advance(p);
    }
    u32 len = (p.pos - 1) - start;
    char* ident = std::mman::alloc<char>(len + 1);
    std::mman::copy<char>(ident, p.input.ptr + start, len);
    ident[len] = 0;
    return ident;
}

// Parse number
static i64 parseNumber(IrParser* p)
{
    i64 value = 0;
    bool negative = false;
    if (p.currentChar == '-')
    {
        negative = true;
        advance(p);
    }
    while (p.currentChar >= '0' && p.currentChar <= '9')
    {
        value = value * 10 + (p.currentChar - '0');
        advance(p);
    }
    return negative ? -value : value;
}

// Parse type
static wallvm::ir_types::IrType* parseType(IrParser* p)
{
    skipWhitespace(p);
    skipComment(p);

    if (matchString(p, "i8")) return p.ctx.tyInt(8);
    if (matchString(p, "i16")) return p.ctx.tyInt(16);
    if (matchString(p, "i32")) return p.ctx.tyInt(32);
    if (matchString(p, "i64")) return p.ctx.tyInt(64);
    if (matchString(p, "f32")) return p.ctx.tyFloat(32);
    if (matchString(p, "f64")) return p.ctx.tyFloat(64);
    if (matchString(p, "void")) return p.ctx.tyVoid();
    if (matchString(p, "ptr")) return p.ctx.tyPtr(null);

    // Parse pointer type: ptr type
    if (matchString(p, "ptr "))
    {
        wallvm::ir_types::IrType* inner = parseType(p);
        return p.ctx.tyPtr(inner);
    }

    // Parse vector type: <N x type>
    if (matchChar(p, '<'))
    {
        u32 width = (u32)parseNumber(p);
        skipWhitespace(p);
        matchString(p, "x");
        skipWhitespace(p);
        wallvm::ir_types::IrType* elem = parseType(p);
        matchChar(p, '>');
        return p.ctx.tyVector(elem, width);
    }

    return null;
}

// String comparison helper
static bool strEq(const char* a, const char* b)
{
    if (!a || !b) return false;
    u32 i = 0;
    while (a[i] && b[i])
    {
        if (a[i] != b[i]) return false;
        i++;
    }
    return a[i] == b[i];
}

// Parse value reference (SSA name or constant)
static wallvm::ir_types::IrValue* parseValue(IrParser* p)
{
    skipWhitespace(p);
    skipComment(p);

    // Constant integer
    if (p.currentChar >= '0' && p.currentChar <= '9')
    {
        i64 val = parseNumber(p);
        return p.ctx.constInt(p.ctx.tyInt(64), val);
    }

    // Negative constant
    if (p.currentChar == '-')
    {
        i64 val = parseNumber(p);
        return p.ctx.constInt(p.ctx.tyInt(64), val);
    }

    // Named value (%name or %123)
    if (matchChar(p, '%'))
    {
        char* name = parseIdent(p);
        // Look up in value table
        for (u32 i = 0; i < p.numValues; i++)
        {
            if (p.valueNames[i] && strEq(p.valueNames[i], name))
            {
                std::mman::dealloc<char>(name);
                return p.values[i];
            }
        }
        std::mman::dealloc<char>(name);
        return null;
    }

    // Block reference (@name)
    if (matchChar(p, '@'))
    {
        char* name = parseIdent(p);
        for (u32 i = 0; i < p.numBlocks; i++)
        {
            if (p.blockNames[i] && strEq(p.blockNames[i], name))
            {
                std::mman::dealloc<char>(name);
                return &p.blocks[i].base;
            }
        }
        // May be a function reference - look up in module globals
        for (u32 i = 0; i < p.ctx.currentModule.nglobals; i++)
        {
            wallvm::ir_types::IrGlobal* g = p.ctx.currentModule.globals[i];
            if (g.name && strEq(g.name, name))
            {
                std::mman::dealloc<char>(name);
                return &g.base;
            }
        }
        std::mman::dealloc<char>(name);
        return null;
    }

    // String literal in value position (e.g., for inline asm)
    if (p.currentChar == '"')
    {
        advance(p); // skip opening quote
        u32 start = p.pos;
        while (p.currentChar != '"' && p.currentChar != 0)
            advance(p);
        u32 slen = p.pos - start;
        if (p.currentChar == '"') advance(p);
        char* str = std::mman::alloc<char>(slen + 1);
        std::mman::copy<char>(str, p.input.ptr + start, slen);
        str[slen] = 0;
        return p.ctx.constInt(p.ctx.tyInt(64), 0); // placeholder
    }

    return null;
}

// Add value to parser's name table
static void addValue(IrParser* p, char* name, wallvm::ir_types::IrValue* val)
{
    if (p.numValues >= p.capValues)
    {
        u32 newCap = p.capValues ? p.capValues * 2 : 32;
        char** newNames = std::mman::alloc<char*>(newCap);
        wallvm::ir_types::IrValue** newVals = std::mman::alloc<wallvm::ir_types::IrValue*>(newCap);
        for (u32 i = 0; i < p.numValues; i++)
        {
            newNames[i] = p.valueNames[i];
            newVals[i] = p.values[i];
        }
        if (p.valueNames) std::mman::dealloc<char*>(p.valueNames);
        if (p.values) std::mman::dealloc<wallvm::ir_types::IrValue*>(p.values);
        p.valueNames = newNames;
        p.values = newVals;
        p.capValues = newCap;
    }
    p.valueNames[p.numValues] = name;
    p.values[p.numValues] = val;
    p.numValues++;
}

// Parse ICMP predicate string
static wallvm::irOps::IrICmpPred parseICmpPred(IrParser* p)
{
    if (matchString(p, "eq")) return wallvm::irOps::IrICmpPred::Eq;
    if (matchString(p, "ne")) return wallvm::irOps::IrICmpPred::Ne;
    if (matchString(p, "slt")) return wallvm::irOps::IrICmpPred::Slt;
    if (matchString(p, "sle")) return wallvm::irOps::IrICmpPred::Sle;
    if (matchString(p, "sgt")) return wallvm::irOps::IrICmpPred::Sgt;
    if (matchString(p, "sge")) return wallvm::irOps::IrICmpPred::Sge;
    if (matchString(p, "ult")) return wallvm::irOps::IrICmpPred::Ult;
    if (matchString(p, "ule")) return wallvm::irOps::IrICmpPred::Ule;
    if (matchString(p, "ugt")) return wallvm::irOps::IrICmpPred::Ugt;
    if (matchString(p, "uge")) return wallvm::irOps::IrICmpPred::Uge;
    return wallvm::irOps::IrICmpPred::Eq;
}

// Parse FCMP predicate string
static wallvm::irOps::IrFCmpPred parseFCmpPred(IrParser* p)
{
    if (matchString(p, "oeq")) return wallvm::irOps::IrFCmpPred::Oeq;
    if (matchString(p, "one")) return wallvm::irOps::IrFCmpPred::One;
    if (matchString(p, "olt")) return wallvm::irOps::IrFCmpPred::Olt;
    if (matchString(p, "ole")) return wallvm::irOps::IrFCmpPred::Ole;
    if (matchString(p, "ogt")) return wallvm::irOps::IrFCmpPred::Ogt;
    if (matchString(p, "oge")) return wallvm::irOps::IrFCmpPred::Oge;
    if (matchString(p, "ueq")) return wallvm::irOps::IrFCmpPred::Ueq;
    if (matchString(p, "une")) return wallvm::irOps::IrFCmpPred::Une;
    if (matchString(p, "ult")) return wallvm::irOps::IrFCmpPred::Ult;
    if (matchString(p, "ule")) return wallvm::irOps::IrFCmpPred::Ule;
    if (matchString(p, "ugt")) return wallvm::irOps::IrFCmpPred::Ugt;
    if (matchString(p, "uge")) return wallvm::irOps::IrFCmpPred::Uge;
    if (matchString(p, "uno")) return wallvm::irOps::IrFCmpPred::Uno;
    if (matchString(p, "ord")) return wallvm::irOps::IrFCmpPred::Ord;
    return wallvm::irOps::IrFCmpPred::Oeq;
}

// Helper: parse binary op (type, a, b)
static wallvm::ir_types::IrInst* parseBinaryOp(IrParser* p, wallvm::irOps::IrOpcode op)
{
    wallvm::ir_types::IrType* ty = parseType(p);
    skipWhitespace(p);
    wallvm::ir_types::IrValue* a = parseValue(p);
    skipWhitespace(p);
    matchChar(p, ',');
    skipWhitespace(p);
    wallvm::ir_types::IrValue* b = parseValue(p);

    wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
    ops[0] = a;
    ops[1] = b;
    wallvm::ir_types::IrInst* inst = p.ctx.createInst(op, ty, ops, 2, 0, 0);
    std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    return inst;
}

// Helper: parse unary op (type, a)
static wallvm::ir_types::IrInst* parseUnaryOp(IrParser* p, wallvm::irOps::IrOpcode op)
{
    wallvm::ir_types::IrType* ty = parseType(p);
    skipWhitespace(p);
    wallvm::ir_types::IrValue* a = parseValue(p);

    wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
    ops[0] = a;
    wallvm::ir_types::IrInst* inst = p.ctx.createInst(op, ty, ops, 1, 0, 0);
    std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    return inst;
}

// Helper: parse cast op (type, a)
static wallvm::ir_types::IrInst* parseCastOp(IrParser* p, wallvm::irOps::IrOpcode op)
{
    wallvm::ir_types::IrType* ty = parseType(p);
    skipWhitespace(p);
    wallvm::ir_types::IrValue* a = parseValue(p);

    wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
    ops[0] = a;
    wallvm::ir_types::IrInst* inst = p.ctx.createInst(op, ty, ops, 1, 0, 0);
    std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    return inst;
}

// Helper: parse call op (func, args...)
static wallvm::ir_types::IrInst* parseCallInst(IrParser* p)
{
    wallvm::ir_types::IrValue* func = parseValue(p);
    skipWhitespace(p);

    // Collect arguments
    u32 nargs = 0;
    u32 argCap = 8;
    wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(argCap);
    ops[nargs] = func;
    nargs++;

    while (p.currentChar != 0 && p.currentChar != '\n' && p.currentChar != ';')
    {
        if (p.currentChar == ',')
        {
            advance(p);
            skipWhitespace(p);
            if (nargs >= argCap)
            {
                argCap *= 2;
                wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(argCap);
                for (u32 i = 0; i < nargs; i++) newOps[i] = ops[i];
                std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
                ops = newOps;
            }
            ops[nargs] = parseValue(p);
            nargs++;
            skipWhitespace(p);
        }
        else
        {
            break;
        }
    }

    wallvm::ir_types::IrInst* inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Call, null, ops, nargs, 0, 0);
    std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    return inst;
}

// Parse instruction
static wallvm::ir_types::IrInst* parseInstruction(IrParser* p)
{
    skipWhitespace(p);
    skipComment(p);

    // Parse instruction name
    char* name = parseIdent(p);
    if (!name) return null;

    skipWhitespace(p);

    wallvm::ir_types::IrInst* inst = null;

    // Binary ops: type, a, b
    if (strEq(name, "add")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Add);
    else if (strEq(name, "sub")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Sub);
    else if (strEq(name, "mul")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Mul);
    else if (strEq(name, "sdiv")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::SDiv);
    else if (strEq(name, "udiv")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::UDiv);
    else if (strEq(name, "srem")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::SRem);
    else if (strEq(name, "urem")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::URem);
    else if (strEq(name, "and")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::And);
    else if (strEq(name, "or")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Or);
    else if (strEq(name, "xor")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Xor);
    else if (strEq(name, "shl")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Shl);
    else if (strEq(name, "ashr")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Ashr);
    else if (strEq(name, "lshr")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Lshr);
    else if (strEq(name, "rotl")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Rotl);
    else if (strEq(name, "rotr")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::Rotr);
    else if (strEq(name, "smin")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::SMin);
    else if (strEq(name, "smax")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::SMax);
    else if (strEq(name, "umin")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::UMin);
    else if (strEq(name, "umax")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::UMax);

    // Float binary ops
    else if (strEq(name, "fadd")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::FAdd);
    else if (strEq(name, "fsub")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::FSub);
    else if (strEq(name, "fmul")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::FMul);
    else if (strEq(name, "fdiv")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::FDiv);

    // FMA: type, a, b, c
    else if (strEq(name, "fma"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* a = parseValue(p);
        skipWhitespace(p); matchChar(p, ','); skipWhitespace(p);
        wallvm::ir_types::IrValue* b = parseValue(p);
        skipWhitespace(p); matchChar(p, ','); skipWhitespace(p);
        wallvm::ir_types::IrValue* c = parseValue(p);
        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(3);
        ops[0] = a; ops[1] = b; ops[2] = c;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Fma, ty, ops, 3, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Unary ops
    else if (strEq(name, "neg")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::Neg);
    else if (strEq(name, "not")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::Not);
    else if (strEq(name, "abs")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::Abs);
    else if (strEq(name, "ctpop")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::CtPop);
    else if (strEq(name, "ctlz")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::CtLz);
    else if (strEq(name, "cttz")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::CtTz);
    else if (strEq(name, "bswap")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::Bswap);
    else if (strEq(name, "fabs")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::FAbs);
    else if (strEq(name, "fsqrt")) inst = parseUnaryOp(p, wallvm::irOps::IrOpcode::FSqrt);

    // Cast ops
    else if (strEq(name, "trunc")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::Trunc);
    else if (strEq(name, "zext")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::Zext);
    else if (strEq(name, "sext")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::Sext);
    else if (strEq(name, "fptrunc")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::FpTrunc);
    else if (strEq(name, "fpext")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::FpExt);
    else if (strEq(name, "fptosi")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::FpToSi);
    else if (strEq(name, "sitofp")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::SiToFp);
    else if (strEq(name, "fptoui")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::FpToUi);
    else if (strEq(name, "uitofp")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::UiToFp);
    else if (strEq(name, "bitcast")) inst = parseCastOp(p, wallvm::irOps::IrOpcode::Bitcast);

    // Memory ops
    else if (strEq(name, "load"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* ptr = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        ops[0] = ptr;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Load, ty, ops, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "store"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* val = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* ptr = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        ops[0] = val;
        ops[1] = ptr;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Store, p.ctx.tyVoid(), ops, 2, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "alloca"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Alloca, ty, null, 0, 0, 0);
    }
    else if (strEq(name, "gep"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* base = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* idx = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        ops[0] = base;
        ops[1] = idx;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Gep, ty, ops, 2, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Compare ops
    else if (strEq(name, "icmp"))
    {
        wallvm::irOps::IrICmpPred pred = parseICmpPred(p);
        skipWhitespace(p);
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* a = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* b = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        ops[0] = a;
        ops[1] = b;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::ICmp, ty, ops, 2, pred, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "fcmp"))
    {
        wallvm::irOps::IrFCmpPred pred = parseFCmpPred(p);
        skipWhitespace(p);
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* a = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* b = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        ops[0] = a;
        ops[1] = b;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::FCmp, ty, ops, 2, 0, pred);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Control flow
    else if (strEq(name, "br"))
    {
        wallvm::ir_types::IrValue* target = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        ops[0] = target;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Br, p.ctx.tyVoid(), ops, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "condbr"))
    {
        wallvm::ir_types::IrValue* cond = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* trueDest = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* falseDest = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(3);
        ops[0] = cond;
        ops[1] = trueDest;
        ops[2] = falseDest;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::CondBr, p.ctx.tyVoid(), ops, 3, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "ret"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        wallvm::ir_types::IrValue* val = parseValue(p);

        wallvm::ir_types::IrValue** ops = null;
        u32 nops = 0;
        if (val)
        {
            ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
            ops[0] = val;
            nops = 1;
        }
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Ret, ty, ops, nops, 0, 0);
        if (ops) std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "call"))
    {
        inst = parseCallInst(p);
    }
    else if (strEq(name, "select"))
    {
        wallvm::ir_types::IrValue* cond = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* a = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* b = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(3);
        ops[0] = cond;
        ops[1] = a;
        ops[2] = b;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Select, null, ops, 3, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Inline asm: inlineasm "template" "constraints" "clobbers", args...
    else if (strEq(name, "inlineasm"))
    {
        // Parse string template
        if (!matchChar(p, '"')) { std::mman::dealloc<char>(name); return null; }
        u32 start = p.pos;
        while (p.currentChar != '"' && p.currentChar != 0) advance(p);
        u32 tlen = p.pos - start;
        char* templ = std::mman::alloc<char>(tlen + 1);
        std::mman::copy<char>(templ, p.input.ptr + start, tlen);
        templ[tlen] = 0;
        if (p.currentChar == '"') advance(p);

        skipWhitespace(p);

        // Parse constraints string
        char* constraints = null;
        if (p.currentChar == '"')
        {
            advance(p);
            start = p.pos;
            while (p.currentChar != '"' && p.currentChar != 0) advance(p);
            u32 clen = p.pos - start;
            constraints = std::mman::alloc<char>(clen + 1);
            std::mman::copy<char>(constraints, p.input.ptr + start, clen);
            constraints[clen] = 0;
            if (p.currentChar == '"') advance(p);
        }

        skipWhitespace(p);

        // Parse clobbers string
        char* clobbers = null;
        if (p.currentChar == '"')
        {
            advance(p);
            start = p.pos;
            while (p.currentChar != '"' && p.currentChar != 0) advance(p);
            u32 blen = p.pos - start;
            clobbers = std::mman::alloc<char>(blen + 1);
            std::mman::copy<char>(clobbers, p.input.ptr + start, blen);
            clobbers[blen] = 0;
            if (p.currentChar == '"') advance(p);
        }

        // Parse operand values
        u32 nargs = 0;
        u32 argCap = 4;
        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(argCap);

        while (p.currentChar != 0 && p.currentChar != '\n' && p.currentChar != ';')
        {
            if (p.currentChar == ',')
            {
                advance(p);
                skipWhitespace(p);
                if (nargs >= argCap)
                {
                    argCap *= 2;
                    wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(argCap);
                    for (u32 i = 0; i < nargs; i++) newOps[i] = ops[i];
                    std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
                    ops = newOps;
                }
                ops[nargs] = parseValue(p);
                nargs++;
                skipWhitespace(p);
            }
            else
            {
                break;
            }
        }

        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::InlineAsm, null, ops, nargs, 0, 0);
        if (inst)
        {
            inst.asmString = templ;
            inst.asmConstraints = constraints;
            inst.asmClobbers = clobbers;
        }
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Phi: phi type [val, block] [val, block] ...
    else if (strEq(name, "phi"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);

        u32 npairs = 0;
        u32 pairCap = 8;
        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(pairCap);

        while (p.currentChar == '[')
        {
            advance(p); // skip [
            skipWhitespace(p);
            wallvm::ir_types::IrValue* val = parseValue(p);
            skipWhitespace(p);
            matchChar(p, ',');
            skipWhitespace(p);
            wallvm::ir_types::IrValue* block = parseValue(p);
            skipWhitespace(p);
            matchChar(p, ']');
            skipWhitespace(p);

            if (npairs + 1 >= pairCap)
            {
                pairCap *= 2;
                wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(pairCap);
                for (u32 i = 0; i < npairs; i++) newOps[i] = ops[i];
                std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
                ops = newOps;
            }
            ops[npairs] = val;
            ops[npairs + 1] = block;
            npairs += 2;
        }

        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Phi, ty, ops, npairs, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Vector ops
    else if (strEq(name, "vec_add")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecAdd);
    else if (strEq(name, "vec_sub")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecSub);
    else if (strEq(name, "vec_mul")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecMul);
    else if (strEq(name, "vec_div")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecDiv);
    else if (strEq(name, "vec_fadd")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecFAdd);
    else if (strEq(name, "vec_fsub")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecFSub);
    else if (strEq(name, "vec_fmul")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecFMul);
    else if (strEq(name, "vec_fdiv")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecFDiv);
    else if (strEq(name, "vec_min")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecMin);
    else if (strEq(name, "vec_max")) inst = parseBinaryOp(p, wallvm::irOps::IrOpcode::VecMax);
    else if (strEq(name, "vec_broadcast"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* a = parseValue(p);
        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        ops[0] = a;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::VecBroadcast, ty, ops, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // Atomic ops
    else if (strEq(name, "atomic_load"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* ptr = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
        ops[0] = ptr;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::AtomicLoad, ty, ops, 1, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "atomic_store"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* val = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* ptr = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        ops[0] = val;
        ops[1] = ptr;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::AtomicStore, p.ctx.tyVoid(), ops, 2, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "atomic_cmpxchg"))
    {
        wallvm::ir_types::IrType* ty = parseType(p);
        skipWhitespace(p);
        wallvm::ir_types::IrValue* ptr = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* cmp = parseValue(p);
        skipWhitespace(p);
        matchChar(p, ',');
        skipWhitespace(p);
        wallvm::ir_types::IrValue* newVal = parseValue(p);

        wallvm::ir_types::IrValue** ops = std::mman::alloc<wallvm::ir_types::IrValue*>(3);
        ops[0] = ptr;
        ops[1] = cmp;
        ops[2] = newVal;
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::AtomicCmpXchg, ty, ops, 3, 0, 0);
        std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }

    // GC ops
    else if (strEq(name, "gc_root"))
    {
        wallvm::ir_types::IrValue* ptr = parseValue(p);
        wallvm::ir_types::IrValue** ops = null;
        u32 nops = 0;
        if (ptr)
        {
            ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
            ops[0] = ptr;
            nops = 1;
        }
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::GcRoot, p.ctx.tyVoid(), ops, nops, 0, 0);
        if (ops) std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "gc_write_barrier"))
    {
        wallvm::ir_types::IrValue* ptr = parseValue(p);
        wallvm::ir_types::IrValue** ops = null;
        u32 nops = 0;
        if (ptr)
        {
            ops = std::mman::alloc<wallvm::ir_types::IrValue*>(1);
            ops[0] = ptr;
            nops = 1;
        }
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::GcWriteBarrier, p.ctx.tyVoid(), ops, nops, 0, 0);
        if (ops) std::mman::dealloc<wallvm::ir_types::IrValue*>(ops);
    }
    else if (strEq(name, "gc_safepoint"))
    {
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::GcSafepoint, p.ctx.tyVoid(), null, 0, 0, 0);
    }

    // Special: unreachable, noret
    else if (strEq(name, "unreachable"))
    {
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Unreachable, p.ctx.tyVoid(), null, 0, 0, 0);
    }
    else if (strEq(name, "noret"))
    {
        inst = p.ctx.createInst(wallvm::irOps::IrOpcode::Noret, p.ctx.tyVoid(), null, 0, 0, 0);
    }

    // Name assignment: %N = instruction...
    if (inst && inst.opcode != wallvm::irOps::IrOpcode::Br &&
        inst.opcode != wallvm::irOps::IrOpcode::CondBr &&
        inst.opcode != wallvm::irOps::IrOpcode::Ret &&
        inst.opcode != wallvm::irOps::IrOpcode::Store &&
        inst.opcode != wallvm::irOps::IrOpcode::Unreachable &&
        inst.opcode != wallvm::irOps::IrOpcode::Noret &&
        inst.opcode != wallvm::irOps::IrOpcode::Fence &&
        inst.opcode != wallvm::irOps::IrOpcode::AtomicStore &&
        inst.opcode != wallvm::irOps::IrOpcode::GcWriteBarrier &&
        inst.opcode != wallvm::irOps::IrOpcode::GcSafepoint)
    {
        // The value was assigned via %N = instruction, so it should already
        // be in the value table if we parsed the %N prefix. For now the parser
        // doesn't track %N assignments in the instruction itself - that's handled
        // in parseBlock. This is a placeholder.
    }

    std::mman::dealloc<char>(name);
    return inst;
}

// Parse basic block
static wallvm::ir_types::IrBlock* parseBlock(IrParser* p)
{
    skipWhitespace(p);
    skipComment(p);

    // Parse block label: @name:
    if (!matchChar(p, '@')) return null;
    char* name = parseIdent(p);
    matchChar(p, ':');

    // Create block
    wallvm::ir_types::IrBlock* bb = p.ctx.createBlock(name);
    p.currentFunc.addBlock(bb);

    // Add to block table
    if (p.numBlocks >= p.capBlocks)
    {
        u32 newCap = p.capBlocks ? p.capBlocks * 2 : 16;
        char** newNames = std::mman::alloc<char*>(newCap);
        wallvm::ir_types::IrBlock** newBlocks = std::mman::alloc<wallvm::ir_types::IrBlock*>(newCap);
        for (u32 i = 0; i < p.numBlocks; i++)
        {
            newNames[i] = p.blockNames[i];
            newBlocks[i] = p.blocks[i];
        }
        if (p.blockNames) std::mman::dealloc<char*>(p.blockNames);
        if (p.blocks) std::mman::dealloc<wallvm::ir_types::IrBlock*>(p.blocks);
        p.blockNames = newNames;
        p.blocks = newBlocks;
        p.capBlocks = newCap;
    }
    p.blockNames[p.numBlocks] = name;
    p.blocks[p.numBlocks] = bb;
    p.numBlocks++;

    // Parse instructions
    while (p.currentChar != 0 && p.currentChar != '@')
    {
        skipWhitespace(p);
        skipComment(p);
        if (p.currentChar == 0 || p.currentChar == '@') break;

        // Check for %N = name assignment
        bool hasName = false;
        u32 assignId = 0;
        if (p.currentChar == '%')
        {
            advance(p);
            assignId = 0;
            while (p.currentChar >= '0' && p.currentChar <= '9')
            {
                assignId = assignId * 10 + (p.currentChar - '0');
                advance(p);
            }
            hasName = true;
            skipWhitespace(p);
            matchChar(p, '=');
            skipWhitespace(p);
        }

        wallvm::ir_types::IrInst* inst = parseInstruction(p);
        if (inst)
        {
            inst.parent = bb;
            bb.addInst(inst);

            // Register named value if assigned
            if (hasName)
            {
                char* valName = std::mman::alloc<char>(16);
                valName[0] = '%';
                u32 tmp = assignId;
                u32 digits = 0;
                if (tmp == 0) digits = 1;
                else { u32 t = tmp; while (t > 0) { digits++; t /= 10; } }
                for (u32 i = 0; i < digits; i++)
                {
                    valName[digits - 1 - i] = '0' + (tmp % 10);
                    tmp /= 10;
                }
                valName[digits + 1] = 0;
                addValue(p, valName, &inst.base);
            }
        }
    }

    return bb;
}

// Parse function
pub wallvm::ir_types::IrFunc* parseFunction(IrParser* p, str text)
{
    p.input = text;
    p.len = text.len;
    p.pos = 0;
    p.line = 1;
    p.column = 1;
    p.numValues = 0;
    p.numBlocks = 0;
    advance(p);

    skipWhitespace(p);
    skipComment(p);

    // Parse "fn"
    if (!matchString(p, "fn")) return null;
    skipWhitespace(p);

    // Parse function name
    char* name = parseIdent(p);
    skipWhitespace(p);

    // Parse parameter list
    wallvm::ir_types::IrType** paramTypes = null;
    u32 nparams = 0;
    if (matchChar(p, '('))
    {
        u32 paramCap = 8;
        paramTypes = std::mman::alloc<wallvm::ir_types::IrType*>(paramCap);

        while (p.currentChar != ')' && p.currentChar != 0)
        {
            skipWhitespace(p);
            skipComment(p);
            if (p.currentChar == ')') break;
            if (nparams >= paramCap)
            {
                paramCap *= 2;
                wallvm::ir_types::IrType** newPT = std::mman::alloc<wallvm::ir_types::IrType*>(paramCap);
                for (u32 i = 0; i < nparams; i++) newPT[i] = paramTypes[i];
                std::mman::dealloc<wallvm::ir_types::IrType*>(paramTypes);
                paramTypes = newPT;
            }
            paramTypes[nparams] = parseType(p);
            nparams++;
            skipWhitespace(p);
            if (p.currentChar == ',') advance(p);
        }
        matchChar(p, ')');
    }

    skipWhitespace(p);

    // Parse return type
    wallvm::ir_types::IrType* retTy = parseType(p);
    skipWhitespace(p);

    // Create function
    wallvm::ir_types::IrFunc* func = p.ctx.createFunc(name, retTy, paramTypes, nparams);
    p.currentFunc = func;

    if (paramTypes) std::mman::dealloc<wallvm::ir_types::IrType*>(paramTypes);

    // Parse basic blocks
    while (p.currentChar != 0)
    {
        skipWhitespace(p);
        skipComment(p);
        if (p.currentChar == 0) break;

        parseBlock(p);
    }

    return func;
}

// Parse entire module from text
pub wallvm::ir_types::IrModule* parseModule(IrParser* p, str text, str modName)
{
    p.input = text;
    p.len = text.len;
    p.pos = 0;
    p.line = 1;
    p.column = 1;
    p.numValues = 0;
    p.numBlocks = 0;
    advance(p);

    wallvm::ir_types::IrModule* modd = p.ctx.createModule(!modName.isEmpty() ? modName : "parsed");

    while (p.currentChar != 0)
    {
        skipWhitespace(p);
        skipComment(p);
        if (p.currentChar == 0) break;

        // Check for module-level items
        if (matchString(p, "extern"))
        {
            skipWhitespace(p);
            char* name = parseIdent(p);
            if (name)
            {
                wallvm::ir_types::IrFunc* func = p.ctx.createFunc(name, p.ctx.tyVoid(), null, 0);
                func.isExtern = true;
                modd.addFunc(func);
                std::mman::dealloc<char>(name);
            }
        }
        else if (p.currentChar == '@')
        {
            // Parse global or string constant
            advance(p);
            char* name = parseIdent(p);
            skipWhitespace(p);
            matchChar(p, '=');
            skipWhitespace(p);

            if (matchString(p, "global") ||
                matchString(p, "constant"))
            {
                bool isConst = matchString(p, "constant");
                if (!isConst) matchString(p, "global");
                skipWhitespace(p);

                wallvm::ir_types::IrType* ty = parseType(p);
                skipWhitespace(p);
                wallvm::ir_types::IrValue* initVal = parseValue(p);

                wallvm::ir_types::IrGlobal* g = p.ctx.createGlobal(name, ty, initVal, isConst);
                modd.addGlobal(g);
            }
            else if (p.currentChar == '"')
            {
                // String constant
                advance(p);
                u32 start = p.pos;
                while (p.currentChar != '"' && p.currentChar != 0)
                    advance(p);
                u32 slen = p.pos - start;
                if (p.currentChar == '"') advance(p);

                wallvm::ir_types::IrStringConst* sc = p.ctx.createStringConstant(p.input.ptr + start, slen);
                sc.base.name = name;
                modd.addStringConst(sc);
            }
        }
        else if (matchString(p, "fn"))
        {
            // Parse function (re-do parsing since we already consumed 'fn')
            skipWhitespace(p);
            char* funcName = parseIdent(p);
            skipWhitespace(p);

            wallvm::ir_types::IrType** paramTypes = null;
            u32 nparams = 0;
            if (matchChar(p, '('))
            {
                u32 paramCap = 8;
                paramTypes = std::mman::alloc<wallvm::ir_types::IrType*>(paramCap);
                while (p.currentChar != ')' && p.currentChar != 0)
                {
                    skipWhitespace(p);
                    skipComment(p);
                    if (p.currentChar == ')') break;
                    if (nparams >= paramCap)
                    {
                        paramCap *= 2;
                        wallvm::ir_types::IrType** newPT = std::mman::alloc<wallvm::ir_types::IrType*>(paramCap);
                        for (u32 i = 0; i < nparams; i++) newPT[i] = paramTypes[i];
                        std::mman::dealloc<wallvm::ir_types::IrType*>(paramTypes);
                        paramTypes = newPT;
                    }
                    paramTypes[nparams] = parseType(p);
                    nparams++;
                    skipWhitespace(p);
                    if (p.currentChar == ',') advance(p);
                }
                matchChar(p, ')');
            }

            skipWhitespace(p);
            wallvm::ir_types::IrType* retTy = parseType(p);
            skipWhitespace(p);

            wallvm::ir_types::IrFunc* func = p.ctx.createFunc(funcName, retTy, paramTypes, nparams);
            if (paramTypes) std::mman::dealloc<wallvm::ir_types::IrType*>(paramTypes);
            std::mman::dealloc<char>(funcName);

            p.currentFunc = func;
            modd.addFunc(func);

            // Parse blocks
            while (p.currentChar != 0)
            {
                skipWhitespace(p);
                skipComment(p);
                if (p.currentChar == 0) break;
                if (p.currentChar == '@')
                {
                    // Peek ahead to check if this is a new block or another fn/global
                    u32 savedPos = p.pos;
                    std::cchar savedChar = p.currentChar;
                    advance(p);
                    char* peekName = parseIdent(p);
                    bool isBlock = false;
                    if (peekName)
                    {
                        // If followed by ':' it's a block label
                        if (p.currentChar == ':') isBlock = true;
                        std::mman::dealloc<char>(peekName);
                    }
                    p.pos = savedPos;
                    p.currentChar = savedChar;

                    if (!isBlock) break;
                    parseBlock(p);
                }
                else
                {
                    break;
                }
            }
        }
        else
        {
            // Skip unknown content
            while (p.currentChar != '\n' && p.currentChar != 0)
                advance(p);
        }
    }

    return modd;
}
