mod std = import(lib) std;

pub enum IrOpcode
{
    // Terminators
    Br,
    CondBr,
    Ret,
    Unreachable,
    Noret,
    // Unary
    Neg,
    Not,
    // Binary arithmetic
    Add,
    Sub,
    Mul,
    SDiv,
    UDiv,
    SRem,
    URem,
    // Binary bitwise
    And,
    Or,
    Xor,
    Shl,
    Ashr,
    Lshr,
    // Memory
    Alloca,
    Load,
    Store,
    Gep,
    // Cast
    Trunc,
    Zext,
    Sext,
    FpTrunc,
    FpExt,
    FpToSi,
    SiToFp,
    FpToUi,
    UiToFp,
    Bitcast,
    // Compare
    ICmp,
    FCmp,
    // Bit manipulation
    CtPop,
    CtLz,
    CtTz,
    Rotl,
    Rotr,
    Bswap,
    // Integer min/max
    SMin,
    SMax,
    UMin,
    UMax,
    // Integer abs
    Abs,
    // Floating-point
    FAdd,
    FSub,
    FMul,
    FDiv,
    Fma,
    FAbs,
    FSqrt,
    // Vector/SIMD
    VecAdd,
    VecSub,
    VecMul,
    VecDiv,
    VecFAdd,
    VecFSub,
    VecFMul,
    VecFDiv,
    VecMin,
    VecMax,
    VecBroadcast,
    ShuffleVector,
    ExtractElement,
    InsertElement,
    // Inline assembly
    InlineAsm,
    // Atomics
    AtomicLoad,
    AtomicStore,
    AtomicRmw,
    AtomicCmpXchg,
    Fence,
    // Exception handling
    LandingPad,
    ExtractValue,
    // GC support
    GcRoot,
    GcWriteBarrier,
    GcSafepoint,
    // Other
    Call,
    Phi,
    Select
}

// ICmp predicates
pub enum IrICmpPred
{
    Eq,
    Ne,
    Slt,
    Sle,
    Sgt,
    Sge,
    Ult,
    Ule,
    Ugt,
    Uge
}

// FCmp predicates
pub enum IrFCmpPred
{
    Oeq,
    One,
    Olt,
    Ole,
    Ogt,
    Oge,
    Ueq,
    Une,
    Ult,
    Ule,
    Ugt,
    Uge
}

// Atomic RMW operations
pub enum IrAtomicRmwOp
{
    Xchg,
    Add,
    Sub,
    And,
    Nand,
    Or,
    Xor,
    Max,
    Min,
    UMax,
    UMin
}

// Atomic memory ordering
pub enum IrAtomicOrdering
{
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst
}

// Opcode classification
pub bool irOpcodeIsTerminator(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::Br:
    case IrOpcode::CondBr:
    case IrOpcode::Ret:
    case IrOpcode::Unreachable:
    case IrOpcode::Noret:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsVector(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::VecAdd:
    case IrOpcode::VecSub:
    case IrOpcode::VecMul:
    case IrOpcode::VecDiv:
    case IrOpcode::VecFAdd:
    case IrOpcode::VecFSub:
    case IrOpcode::VecFMul:
    case IrOpcode::VecFDiv:
    case IrOpcode::VecMin:
    case IrOpcode::VecMax:
    case IrOpcode::VecBroadcast:
    case IrOpcode::ShuffleVector:
    case IrOpcode::ExtractElement:
    case IrOpcode::InsertElement:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsAtomic(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::AtomicLoad:
    case IrOpcode::AtomicStore:
    case IrOpcode::AtomicRmw:
    case IrOpcode::AtomicCmpXchg:
    case IrOpcode::Fence:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsGc(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::GcRoot:
    case IrOpcode::GcWriteBarrier:
    case IrOpcode::GcSafepoint:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsBinary(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::Add:
    case IrOpcode::Sub:
    case IrOpcode::Mul:
    case IrOpcode::SDiv:
    case IrOpcode::UDiv:
    case IrOpcode::SRem:
    case IrOpcode::URem:
    case IrOpcode::And:
    case IrOpcode::Or:
    case IrOpcode::Xor:
    case IrOpcode::Shl:
    case IrOpcode::Ashr:
    case IrOpcode::Lshr:
    case IrOpcode::Rotl:
    case IrOpcode::Rotr:
    case IrOpcode::SMin:
    case IrOpcode::SMax:
    case IrOpcode::UMin:
    case IrOpcode::UMax:
    case IrOpcode::VecAdd:
    case IrOpcode::VecSub:
    case IrOpcode::VecMul:
    case IrOpcode::VecDiv:
    case IrOpcode::VecFAdd:
    case IrOpcode::VecFSub:
    case IrOpcode::VecFMul:
    case IrOpcode::VecFDiv:
    case IrOpcode::VecMin:
    case IrOpcode::VecMax:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsCast(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::Trunc:
    case IrOpcode::Zext:
    case IrOpcode::Sext:
    case IrOpcode::FpTrunc:
    case IrOpcode::FpExt:
    case IrOpcode::FpToSi:
    case IrOpcode::SiToFp:
    case IrOpcode::FpToUi:
    case IrOpcode::UiToFp:
    case IrOpcode::Bitcast:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsMemory(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::Alloca:
    case IrOpcode::Load:
    case IrOpcode::Store:
    case IrOpcode::Gep:
    case IrOpcode::AtomicLoad:
    case IrOpcode::AtomicStore:
        return true;
    default:
        return false;
    }
}

pub bool irOpcodeIsCommutative(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::Add:
    case IrOpcode::Mul:
    case IrOpcode::And:
    case IrOpcode::Or:
    case IrOpcode::Xor:
    case IrOpcode::SMin:
    case IrOpcode::SMax:
    case IrOpcode::UMin:
    case IrOpcode::UMax:
        return true;
    default:
        return false;
    }
}

// Opcode string names
static str irOpcodeStrHelper(IrOpcode op)
{
    switch (op)
    {
    case IrOpcode::Br: return "br";
    case IrOpcode::CondBr: return "cond_br";
    case IrOpcode::Ret: return "ret";
    case IrOpcode::Unreachable: return "unreachable";
    case IrOpcode::Noret: return "noret";
    default: return "";
    }
}

