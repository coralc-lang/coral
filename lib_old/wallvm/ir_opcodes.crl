    case IrAtomicRmwOp::Sub: return "sub";
    case IrAtomicRmwOp::And: return "and";
    case IrAtomicRmwOp::Nand: return "nand";
    case IrAtomicRmwOp::Or: return "or";
    case IrAtomicRmwOp::Xor: return "xor";
    case IrAtomicRmwOp::Max: return "max";
    case IrAtomicRmwOp::Min: return "min";
    case IrAtomicRmwOp::UMax: return "umax";
    case IrAtomicRmwOp::UMin: return "umin";
    }
    return "unknown";
}

pub str irAtomicOrderingStr(IrAtomicOrdering o)
{
    switch (o)
    {
    case IrAtomicOrdering::Relaxed: return "relaxed";
    case IrAtomicOrdering::Acquire: return "acquire";
    case IrAtomicOrdering::Release: return "release";
    case IrAtomicOrdering::AcqRel: return "acq_rel";
    case IrAtomicOrdering::SeqCst: return "seq_cst";
    }
    return "unknown";
}

