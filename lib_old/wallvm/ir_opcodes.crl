    switch (p)
    {
    case IrFCmpPred::Oeq: return "oeq";
    case IrFCmpPred::One: return "one";
    case IrFCmpPred::Olt: return "olt";
    case IrFCmpPred::Ole: return "ole";
    case IrFCmpPred::Ogt: return "ogt";
    case IrFCmpPred::Oge: return "oge";
    case IrFCmpPred::Ueq: return "ueq";
    case IrFCmpPred::Une: return "une";
    case IrFCmpPred::Ult: return "ult";
    case IrFCmpPred::Ule: return "ule";
    case IrFCmpPred::Ugt: return "ugt";
    case IrFCmpPred::Uge: return "uge";
    }
    return "unknown";
}
