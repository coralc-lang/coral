pub str irOpcodeStr(IrOpcode op)
{
    str r;
    r = irOpcodeStrHelper(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper2(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper3(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper4(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper5(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper6(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper7(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper8(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper9(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper10(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper11(op); if (!r.isEmpty()) return r;
    r = irOpcodeStrHelper12(op); if (!r.isEmpty()) return r;
    return "unknown";
}

pub str irICmpStr(IrICmpPred p)
{
    switch (p)
    {
    case IrICmpPred::Eq: return "eq";
    case IrICmpPred::Ne: return "ne";
    case IrICmpPred::Slt: return "slt";
    case IrICmpPred::Sle: return "sle";
    case IrICmpPred::Sgt: return "sgt";
    case IrICmpPred::Sge: return "sge";
    case IrICmpPred::Ult: return "ult";
    case IrICmpPred::Ule: return "ule";
    case IrICmpPred::Ugt: return "ugt";
    case IrICmpPred::Uge: return "uge";
    }
    return "unknown";
}

pub str irAtomicRmwOpStr(IrAtomicRmwOp op)
{
    switch (op)
