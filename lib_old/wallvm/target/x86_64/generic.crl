mod wallvm = import(lib) wallvm;
mod std = import(lib) std;
mod x86_64_base = import(lib) wallvm::target::x86_64::x86_64_base.crl;
mod avx = import(lib) wallvm::target::x86_64::avx.crl;

// Bare-metal x86_64 code generator
// No OS abstractions, no ELF/COFF directives, no system calls.
// Produces raw assembly suitable for linking with a custom linker script
// or embedding directly into a binary blob.

pub bool irCodegenX86_64Bare(wallvm::ir_types::IrModule* modd, rawptr userdata, bool useAtt)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return false;

    x86_64_base::86_64CodeGen codegen;
    x86_64_base::CpuFeatures features = x86_64_base::defaultCpuFeatures();
    features.sse = true;
    features.sse2 = true;
    features.sse3 = true;
    features.ssse3 = true;
    features.sse41 = true;
    features.sse42 = true;
    features.avx = true;
    features.avx2 = true;
    features.fma = true;
    features.bmi1 = true;
    features.bmi2 = true;
    features.popcnt = true;
    features.lzcnt = true;
    codegen.init(ctx, modd, false, useAtt, &features);

    for (u32 fi = 0; fi < modd.nfuncs; fi++)
    {
        wallvm::ir_types::IrFunc* func = modd.funcs[fi];
        if (!func) continue;
        if (func*.isExtern) continue;

        x86_64_base::ElfMetadata meta = x86_64_base::defaultFuncMeta();
        codegen.emitPrologue(func, &meta);

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb.ninsts; ii++)
                codegen.emitInst(bb.insts[ii]);
        }

        codegen.emitEpilogue();
    }

    return true;
}

pub const char* irCodegenX86_64BareAsm(wallvm::ir_types::IrModule* modd, rawptr userdata, bool useAtt)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return null;

    x86_64_base::X86_64CodeGen codegen;
    x86_64_base::CpuFeatures features = x86_64_base::defaultCpuFeatures();
    features.sse = true;
    features.sse2 = true;
    features.sse3 = true;
    features.ssse3 = true;
    features.sse41 = true;
    features.sse42 = true;
    features.avx = true;
    features.avx2 = true;
    features.fma = true;
    features.bmi1 = true;
    features.bmi2 = true;
    features.popcnt = true;
    features.lzcnt = true;
    codegen.init(ctx, modd, false, useAtt, &features);

    for (u32 fi = 0; fi < modd.nfuncs; fi++)
    {
        wallvm::ir_types::IrFunc* func = modd.funcs[fi];
        if (!func) continue;
        if (func*.isExtern) continue;

        x86_64_base::ElfMetadata meta = x86_64_base::defaultFuncMeta();
        codegen.emitPrologue(func, &meta);

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb.ninsts; ii++)
                codegen.emitInst(bb.insts[ii]);
        }

        codegen.emitEpilogue();
    }

    return codegen.emitter.getOutput();
}
