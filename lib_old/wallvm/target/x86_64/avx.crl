mod wallvm = import(lib) wallvm;
mod x86_64_base = import(lib) wallvm::target::x86_64::x86_64_base.crl;

pub void emitAvxVecAdd256(x86_64_base.X86_64Emitter* emitter,
                          const u8* dst, const u8* src1,
                          const u8* src2)
{
    emitter*.it("\tvpaddd ");
    emitter*.it(src2);
    emitter*.it(", ");
    emitter*.it(src1);
    emitter*.it(", ");
    emitter*.itLine(dst);
}

pub void emitAvxVecSub256(x86_64_base.X86_64Emitter* emitter,
                          const u8* dst, const u8* src1,
                          const u8* src2)
{
    emitter*.it("\tvpsubd ");
    emitter*.it(src2);
    emitter*.it(", ");
    emitter*.it(src1);
    emitter*.it(", ");
    emitter*.itLine(dst);
}

pub void emitAvxVecMul256(x86_64_base.X86_64Emitter* emitter,
                          const u8* dst, const u8* src1,
                          const u8* src2)
{
    emitter*.it("\tvpmulld ");
    emitter*.it(src2);
    emitter*.it(", ");
    emitter*.it(src1);
    emitter*.it(", ");
    emitter*.itLine(dst);
}

