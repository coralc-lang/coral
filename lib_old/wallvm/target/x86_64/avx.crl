pub void emitAvxVecFDiv256(x86_64_base.X86_64Emitter* emitter,
                           const u8* dst, const u8* src1,
                           const u8* src2)
{
    emitter*.it("\tvdivps ");
    emitter*.it(src2);
    emitter*.it(", ");
    emitter*.it(src1);
    emitter*.it(", ");
    emitter*.itLine(dst);
}

pub void emitAvxVecBroadcast256(x86_64_base.X86_64Emitter* emitter, const u8* dst, const u8* src)
{
    emitter*.it("\tvbroadcastss ");
    emitter*.it(src);
    emitter*.it(", ");
    emitter*.itLine(dst);
}

pub void emitAvxVecGather256(x86_64_base.X86_64Emitter* emitter,
                             const u8* dst, const u8* base,
                             const u8* indices, u32 scale)
{
    emitter*.it("\tvpgatherdd ");
    emitter*.it(indices);
    emitter*.it(", (");
    emitter*.it(base);
    emitter*.it("), ");
    emitter*.it(dst);
    emitter*.it(", $");
    std::cu8 buf[16];
    u32ToStr(scale, buf);
    emitter*.itLine(buf);
}

pub void emitAvx512VecAdd512(x86_64_base.X86_64Emitter* emitter,
                             const u8* dst, const u8* src1,
                             const u8* src2)
{
    if (emitter.features && emitter.features.avx512f)
    {
        emitter*.it("\tvpaddd ");
        emitter*.it(src2);
        emitter*.it(", ");
        emitter*.it(src1);
        emitter*.it(", ");
        emitter*.itLine(dst);
    }
}

