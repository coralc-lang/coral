pub void emitAvx512VecAdd512Masked(x86_64_base.X86_64Emitter* emitter,
                                   const u8* dst, const u8* src1,
                                   const u8* src2, const u8* mask)
{
    if (emitter.features && emitter.features.avx512f)
    {
        emitter*.it("\tvpaddd ");
        emitter*.it(src2);
        emitter*.it(", ");
        emitter*.it(src1);
        emitter*.it(dst);
        emitter*.it(" {");
        emitter*.it(mask);
        emitter*.itLine("}");
    }
}

pub void emitFma(x86_64_base.X86_64Emitter* emitter,
                 const u8* dst, const u8* src1,
                 const u8* src2, const u8* src3)
{
    if (emitter.features && emitter.features.fma)
    {
        emitter*.it("\tvfmadd231ss ");
        emitter*.it(src2);
        emitter*.it(", ");
        emitter*.it(src1);
        emitter*.it(", ");
        emitter*.itLine(dst);
    }
}

pub void emitFma256(x86_64_base.X86_64Emitter* emitter,
                    const u8* dst, const u8* src1,
                    const u8* src2, const u8* src3)
{
    if (emitter.features && emitter.features.fma)
    {
        emitter*.it("\tvfmadd231ps ");
        emitter*.it(src2);
        emitter*.it(", ");
        emitter*.it(src1);
        emitter*.it(", ");
        emitter*.itLine(dst);
    }
}

static void u32ToStr(u32 val, u8* out)
{
    if (val == 0) { out[0] = '0'; out[1] = 0; return; }
    u8 buf[16];
    u32 i = 0;
    while (val > 0) { buf[i++] = '0' + (val % 10); val /= 10; }
    for (u32 j = 0; j < i; j++) out[j] = buf[i - 1 - j];
    out[i] = 0;
}
