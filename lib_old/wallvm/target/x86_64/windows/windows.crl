mod wallvm = import(lib) wallvm;
mod std = import(lib) std;
mod x86_64_base = import(lib) wallvm::target::x86_64::x86_64_base.crl;
mod avx = import(lib) wallvm::target::x86_64::avx.crl;

// x86_64 Windows code generator
// Microsoft x64 ABI: rcx, rdx, r8, r9 for integer args, xmm0-3 for float args
// 32-byte stack alignment, shadow space (32 bytes), no red zone
// Callee-save: rbx, rbp, rdi, rsi, r12-r15

pub bool irWinX86_64(wallvm::ir_types::IrModule* modd, rawptr userdata, bool useAtt)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return false;

    x86_64_base::X86_64CodeGen codegen;
    x86_64_base::CpuFeatures features = x86_64_base::defaultCpuFeatures();
    features.avx = true;
    features.avx2 = true;
    features.fma = true;
    features.bmi1 = true;
    features.bmi2 = true;
    features.popcnt = true;
    features.lzcnt = true;
    codegen.init(ctx, modd, true, useAtt, &features);

    codegen.emitter.emitLine(".section .text");

    for (u32 fi = 0; fi < modd*.nfuncs; fi++)
    {
        wallvm::ir_types::IrFunc* func = modd*.funcs[fi];
        if (!func) continue;
        if (func*.isExtern) continue;

        codegen.emitter.emit("public ");
        codegen.emitter.emitLine(func*.name);

        x86_64_base::ElfMetadata meta = x86_64_base::defaultFuncMeta();
        codegen.emitPrologue(func, &meta);

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb.ninsts; ii++)
                codegen.emitInst(bb.insts[ii]);
        }

        codegen.emitEpilogue();
    }

    return true;
}

pub str irWinX86_64Asm(wallvm::ir_types::IrModule* modd, rawptr userdata, bool useAtt)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return null;

    x86_64_base::X86_64CodeGen codegen;
    x86_64_base::CpuFeatures features = x86_64_base::defaultCpuFeatures();
    features.avx = true;
    features.avx2 = true;
    features.fma = true;
    features.bmi1 = true;
    features.bmi2 = true;
    features.popcnt = true;
    features.lzcnt = true;
    codegen.init(ctx, modd, true, useAtt, &features);

    codegen.emitter.emitLine(".section .text");

    for (u32 fi = 0; fi < modd*.nfuncs; fi++)
    {
        wallvm::ir_types::IrFunc* func = modd*.funcs[fi];
        if (!func) continue;
        if (func*.isExtern) continue;

        codegen.emitter.emit("public ");
        codegen.emitter.emitLine(func*.name);

        x86_64_base::ElfMetadata meta = x86_64_base::defaultFuncMeta();
        codegen.emitPrologue(func, &meta);

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb.ninsts; ii++)
                codegen.emitInst(bb.insts[ii]);
        }

        codegen.emitEpilogue();
    }

    return codegen.emitter.getOutput();
}
