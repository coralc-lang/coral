mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// WebAssembly code generator (WASM text format)
// WASM is a stack machine: instructions push/pop values from a virtual stack.
// No register allocation needed - values live on the WASM operand stack.

pub struct WasmEmitter
{
    wallvm::ir_types::IrContext* ctx;
    wallvm::ir_types::IrModule* modd;
    std::cchar* output;
    u32 outputLen;
    u32 outputCap;
    u32 indent;
    u32 labelCounter;

    void init(wallvm::ir_types::IrContext* ctx, wallvm::ir_types::IrModule* modd)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.output = null;
        self.outputLen = 0;
        self.outputCap = 0;
        self.indent = 0;
        self.labelCounter = 0;
    }

    u32 nextLabel()
    {
        return self.labelCounter++;
    }

    void emit(const char* str)
    {
        u32 len = 0;
        while (str[len]) len++;
        if (self.outputLen + len + 1 > self.outputCap)
        {
            u32 newCap = self.outputCap ? self.outputCap * 2 : 8192;
            std::cchar* buf = std::mman::alloc<std::cchar>(newCap);
            if (self.output)
            {
                for (u32 i = 0; i < self.outputLen; i++)
                    buf[i] = self.output[i];
                std::mman::dealloc<std::cchar>(self.output);
            }
            self.output = buf;
            self.outputCap = newCap;
        }
        for (u32 i = 0; i < len; i++)
            self.output[self.outputLen + i] = str[i];
        self.outputLen += len;
        self.output[self.outputLen] = 0;
    }

    void emitLine(const char* str)
    {
        for (u32 i = 0; i < self.indent; i++)
            self.emit("  ");
        self.emit(str);
        self.emit("\n");
    }

    void emitU32(u32 val)
    {
        if (val == 0) { self.emit("0"); return; }
        std::cchar buf[16];
        u32 i = 0;
        u32 v = val;
        while (v > 0) { buf[i++] = '0' + (v % 10); v /= 10; }
        for (u32 j = 0; j < i; j++)
        {
            std::cchar c[2] = { buf[i - 1 - j], 0 };
            self.emit(c);
        }
    }

    void emitI64(i64 val)
    {
        if (val < 0) { self.emit("-"); val = -val; }
        if (val == 0) { self.emit("0"); return; }
        std::cchar buf[32];
        u32 i = 0;
        i64 v = val;
        while (v > 0) { buf[i++] = '0' + (v % 10); v /= 10; }
        for (u32 j = 0; j < i; j++)
        {
            std::cchar c[2] = { buf[i - 1 - j], 0 };
            self.emit(c);
        }
    }

    void emitHexU64(u64 val)
    {
        self.emit("0x");
        if (val == 0) { self.emit("0"); return; }
        std::cchar buf[16];
        u32 i = 0;
        u64 v = val;
        while (v > 0)
        {
            std::cchar d = (std::cchar)(v & 0xF);
            if (d < 10) buf[i++] = '0' + d;
            else buf[i++] = 'a' + (d - 10);
            v >>= 4;
        }
        for (u32 j = 0; j < i; j++)
        {
            std::cchar c[2] = { buf[i - 1 - j], 0 };
            self.emit((const char*)c);
        }
    }

    void emitType(wallvm::ir_types::IrType* ty)
    {
        if (!ty) { self.emit("void"); return; }
        switch (ty.kind)
        {
        case wallvm::ir_types::IrTypeKind::Void:
            self.emit("void");
            break;
        case wallvm::ir_types::IrTypeKind::Int:
            if (ty.width <= 32) self.emit("i32");
            else self.emit("i64");
            break;
        case wallvm::ir_types::IrTypeKind::Float:
            if (ty.width <= 32) self.emit("f32");
            else self.emit("f64");
            break;
        case wallvm::ir_types::IrTypeKind::Ptr:
            self.emit("i32");
            break;
        default:
            self.emit("i32");
            break;
        }
    }

    const char* getOutput() { return self.output; }
}

pub struct WasmCodeGen
{
    wallvm::ir_types::IrContext* ctx;
    wallvm::ir_types::IrModule* modd;
    WasmEmitter emitter;

    void init(wallvm::ir_types::IrContext* ctx, wallvm::ir_types::IrModule* modd)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.emitter.init(ctx, modd);
    }

    void emitModule()
    {
        self.emitter.emitLine("(module");
        self.emitter.indent++;

        self.emitter.emitLine("(memory $0 1 256)");
        self.emitter.emitLine("(global $__heap_base (mut i32) (i32.const 65536))");
        self.emitter.emitLine("(global $__stack_pointer (mut i32) (i32.const 1048576))");

        self.emitter.emit("(func $malloc (param $size i32) (result i32)");
        self.emitter.indent++;
        self.emitter.emitLine("local $ptr i32");
        self.emitter.emitLine("global.get $__heap_base");
        self.emitter.emitLine("local.set $ptr");
        self.emitter.emitLine("global.get $__heap_base");
        self.emitter.emitLine("local.get $size");
        self.emitter.emitLine("i32.add");
        self.emitter.emitLine("global.set $__heap_base");
        self.emitter.emitLine("local.get $ptr");
        self.emitter.indent--;
        self.emitter.emitLine(")");

        self.emitter.emit("(func $grow_memory (param $pages i32) (result i32)");
        self.emitter.indent++;
        self.emitter.emitLine("local.get $pages");
        self.emitter.emitLine("memory.grow");
        self.emitter.indent--;
        self.emitter.emitLine(")");

        // Table section for indirect calls
        u32 nFuncs = 0;
        for (u32 fi = 0; fi < self.modd.nfuncs; fi++)
        {
            wallvm::ir_types::IrFunc* func = self.modd.funcs[fi];
            if (!func || func*.isExtern) continue;
            nFuncs++;
        }
        if (nFuncs > 0)
        {
            self.emitter.emit("(table ");
            self.emitter.emitU32(nFuncs);
            self.emitter.emitLine(" funcref)");
        }

        // Type section
        for (u32 fi = 0; fi < self.modd.nfuncs; fi++)
        {
            wallvm::ir_types::IrFunc* func = self.modd.funcs[fi];
            if (!func || func*.isExtern) continue;

            self.emitter.emit("(type $t");
            self.emitter.emitU32(fi);
            self.emitter.emit(" (func (param");
            for (u32 pi = 0; pi < func*.nparams; pi++)
            {
                self.emitter.emit(" ");
                self.emitter.emitType(func*.paramTypes[pi]);
            }
            bool hasRet = func*.retType && func*.retType.kind != wallvm::ir_types::IrTypeKind::Void;
            if (hasRet)
            {
                self.emitter.emit(") (result ");
                self.emitter.emitType(func*.retType);
                self.emitter.emitLine(")))");
            }
            else
            {
                self.emitter.emitLine(")))");
            }
        }

        // Import section
        for (u32 fi = 0; fi < self.modd.nfuncs; fi++)
        {
            wallvm::ir_types::IrFunc* func = self.modd.funcs[fi];
            if (!func || !func*.isExtern) continue;

            self.emitter.emit("(import \"env\" \"");
            self.emitter.emit(func*.name);
            self.emitter.emit("\" (func $");
            self.emitter.emit(func*.name);
            self.emitter.emit(" (param");
            for (u32 pi = 0; pi < func*.nparams; pi++)
            {
                self.emitter.emit(" ");
                self.emitter.emitType(func*.paramTypes[pi]);
            }
            bool hasRet = func*.retType && func*.retType.kind != wallvm::ir_types::IrTypeKind::Void;
            if (hasRet)
            {
                self.emitter.emit(") (result ");
                self.emitter.emitType(func*.retType);
                self.emitter.emitLine(")))");
            }
            else
            {
                self.emitter.emitLine(")))");
            }
        }

        // Function section
        for (u32 fi = 0; fi < self.modd.nfuncs; fi++)
        {
            wallvm::ir_types::IrFunc* func = self.modd.funcs[fi];
            if (!func || func*.isExtern) continue;

            self.emitter.emit("(func $");
            self.emitter.emit(func*.name);
            self.emitter.emit(" (type $t");
            self.emitter.emitU32(fi);
            self.emitter.emitLine(")");
            self.emitter.indent++;
            self.emitFunc(func);
            self.emitter.indent--;
            self.emitter.emitLine(")");
        }

        // Elem section for indirect calls
        self.emitter.emit("(elem (i32.const 0)");
        for (u32 fi = 0; fi < self.modd.nfuncs; fi++)
        {
            wallvm::ir_types::IrFunc* func = self.modd.funcs[fi];
            if (!func || func*.isExtern) continue;
            self.emitter.emit(" $");
            self.emitter.emit(func*.name);
        }
        self.emitter.emitLine(")");

        // Export main
        for (u32 fi = 0; fi < self.modd.nfuncs; fi++)
        {
            wallvm::ir_types::IrFunc* func = self.modd.funcs[fi];
            if (!func || func*.isExtern) continue;
            if (func*.name && func*.name[0] == 'm' && func*.name[1] == 'a' && func*.name[2] == 'i' && func*.name[3] == 'n')
            {
                self.emitter.emit("(export \"main\" (func $");
                self.emitter.emit(func*.name);
                self.emitter.emitLine("))");
            }
        }

        self.emitter.emitLine("(export \"malloc\" (func $malloc))");
        self.emitter.emitLine("(export \"grow_memory\" (func $grow_memory))");
        self.emitter.emitLine("(export \"memory\" (memory $0))");

        self.emitter.indent--;
        self.emitter.emitLine(")");
    }

    // NOTE: Each basic block is emitted as block $name ... end.
    // This is correct for straight-line code but incorrect for arbitrary CFGs
    // with multiple predecessors/successors. The correct approach is to use
    // the function body as one block with nested blocks for loops and
    // conditional branches using br/br_if.
    void emitFunc(wallvm::ir_types::IrFunc* func)
    {
        self.emitter.emitLine("(local $alloca_ptr i32)");
        self.emitter.emitLine("(local $abs_tmp i32)");
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            self.emitter.emit("block $");
            self.emitter.emit(bb.name);
            self.emitter.emit("\n");
            self.emitter.indent++;
            for (u32 ii = 0; ii < bb.ninsts; ii++)
                self.emitInst(bb.insts[ii]);
            self.emitter.indent--;
            self.emitter.emitLine("end");
        }
    }

    void emitInst(wallvm::ir_types::IrInst* inst)
    {
        switch (inst.opcode)
        {
        case wallvm::irOps::IrOpcode::Add:
            self.emitBinOp(inst, "i32.add", "i64.add");
            break;
        case wallvm::irOps::IrOpcode::Sub:
            self.emitBinOp(inst, "i32.sub", "i64.sub");
            break;
        case wallvm::irOps::IrOpcode::Mul:
            self.emitBinOp(inst, "i32.mul", "i64.mul");
            break;
        case wallvm::irOps::IrOpcode::SDiv:
            self.emitBinOp(inst, "i32.div_s", "i64.div_s");
            break;
        case wallvm::irOps::IrOpcode::UDiv:
            self.emitBinOp(inst, "i32.div_u", "i64.div_u");
            break;
        case wallvm::irOps::IrOpcode::SRem:
            self.emitBinOp(inst, "i32.rem_s", "i64.rem_s");
            break;
        case wallvm::irOps::IrOpcode::URem:
            self.emitBinOp(inst, "i32.rem_u", "i64.rem_u");
            break;
        case wallvm::irOps::IrOpcode::And:
            self.emitBinOp(inst, "i32.and", "i64.and");
            break;
        case wallvm::irOps::IrOpcode::Or:
            self.emitBinOp(inst, "i32.or", "i64.or");
            break;
        case wallvm::irOps::IrOpcode::Xor:
            self.emitBinOp(inst, "i32.xor", "i64.xor");
            break;
        case wallvm::irOps::IrOpcode::Shl:
            self.emitBinOp(inst, "i32.shl", "i64.shl");
            break;
        case wallvm::irOps::IrOpcode::Ashr:
            self.emitBinOp(inst, "i32.shr_s", "i64.shr_s");
            break;
        case wallvm::irOps::IrOpcode::Lshr:
            self.emitBinOp(inst, "i32.shr_u", "i64.shr_u");
            break;
        case wallvm::irOps::IrOpcode::Neg:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool is64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                self.emitter.emitLine(is64 ? "i64.const 0" : "i32.const 0");
                self.emitter.emitLine(is64 ? "i64.sub" : "i32.sub");
            }
            break;
        case wallvm::irOps::IrOpcode::Not:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool is64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                self.emitter.emitLine(is64 ? "i64.const -1" : "i32.const -1");
                self.emitter.emitLine(is64 ? "i64.xor" : "i32.xor");
            }
            break;
        case wallvm::irOps::IrOpcode::FAdd:
            self.emitBinOp(inst, "f32.add", "f64.add");
            break;
        case wallvm::irOps::IrOpcode::FSub:
            self.emitBinOp(inst, "f32.sub", "f64.sub");
            break;
        case wallvm::irOps::IrOpcode::FMul:
            self.emitBinOp(inst, "f32.mul", "f64.mul");
            break;
        case wallvm::irOps::IrOpcode::FDiv:
            self.emitBinOp(inst, "f32.div", "f64.div");
            break;
        case wallvm::irOps::IrOpcode::FAbs:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            if (inst.base.type && inst.base.type.width > 32)
                self.emitter.emitLine("f64.abs");
            else
                self.emitter.emitLine("f32.abs");
            break;
        case wallvm::irOps::IrOpcode::FSqrt:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            if (inst.base.type && inst.base.type.width > 32)
                self.emitter.emitLine("f64.sqrt");
            else
                self.emitter.emitLine("f32.sqrt");
            break;
        case wallvm::irOps::IrOpcode::Load:
            self.emitLoadType(inst);
            break;
        case wallvm::irOps::IrOpcode::Store:
            self.emitStoreType(inst);
            break;
        case wallvm::irOps::IrOpcode::Alloca:
        {
            u32 allocSize = 16;
            if (inst.nops > 0 && inst.ops[0] && inst.ops[0].kind == wallvm::ir_types::IrValueKind::ConstInt)
            {
                allocSize = (u32)inst.ops[0].valData;
                allocSize = (allocSize + 15) & 0xFFFFFFF0;
            }
            self.emitter.emitLine("global.get $__stack_pointer");
            self.emitter.emitLine("local.tee $alloca_ptr");
            if (inst.nops > 0 && inst.ops[0] && inst.ops[0].kind == wallvm::ir_types::IrValueKind::ConstInt)
            {
                self.emitter.emit("i32.const ");
                self.emitter.emitU32(allocSize);
                self.emitter.emitLine("");
            }
            else
            {
                if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
                self.emitter.emitLine("i32.const 15");
                self.emitter.emitLine("i32.add");
                self.emitter.emitLine("i32.const -16");
                self.emitter.emitLine("i32.and");
            }
            self.emitter.emitLine("i32.sub");
            self.emitter.emitLine("global.set $__stack_pointer");
            self.emitter.emitLine("local.get $alloca_ptr");
            break;
        }
        case wallvm::irOps::IrOpcode::Gep:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
            self.emitter.emitLine("i32.add");
            break;
        case wallvm::irOps::IrOpcode::Br:
            if (inst.nops > 0 && inst.ops[0])
            {
                self.emitter.emit("br $");
                self.emitter.emitLine(inst.ops[0].name);
            }
            break;
        case wallvm::irOps::IrOpcode::CondBr:
            if (inst.nops >= 3)
            {
                if (inst.ops[0]) self.emitValuePush(inst.ops[0]);
                self.emitter.emit("br_if $");
                self.emitter.emitLine(inst.ops[1].name);
                self.emitter.emit("br $");
                self.emitter.emitLine(inst.ops[2].name);
            }
            break;
        case wallvm::irOps::IrOpcode::Ret:
            if (inst.nops > 0 && inst.ops[0])
            {
                self.emitValuePush(inst.ops[0]);
            }
            self.emitter.emitLine("return");
            break;
        case wallvm::irOps::IrOpcode::ICmp:
            self.emitICmp(inst);
            break;
        case wallvm::irOps::IrOpcode::FCmp:
            self.emitFCmp(inst);
            break;
        case wallvm::irOps::IrOpcode::Call:
            if (inst.nops > 0 && inst.ops[0])
            {
                for (u32 i = 1; i < inst.nops; i++)
                    self.emitValuePush(inst.ops[i]);
                self.emitter.emit("call $");
                self.emitter.emitLine(inst.ops[0].name);
            }
            break;
        case wallvm::irOps::IrOpcode::Select:
            if (inst.nops >= 3)
            {
                if (inst.ops[0]) self.emitValuePush(inst.ops[0]);
                self.emitter.emitLine("if (result i32)");
                self.emitter.indent++;
                if (inst.ops[1]) self.emitValuePush(inst.ops[1]);
                self.emitter.indent--;
                self.emitter.emitLine("else");
                self.emitter.indent++;
                if (inst.ops[2]) self.emitValuePush(inst.ops[2]);
                self.emitter.indent--;
                self.emitter.emitLine("end");
            }
            break;
        case wallvm::irOps::IrOpcode::SiToFp:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool srcIs64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                bool dstIs64 = inst.base.type && inst.base.type.width > 32;
                if (dstIs64)
                    self.emitter.emitLine(srcIs64 ? "f64.convert_s/i64" : "f64.convert_s/i32");
                else
                    self.emitter.emitLine(srcIs64 ? "f32.convert_s/i64" : "f32.convert_s/i32");
            }
            break;
        case wallvm::irOps::IrOpcode::FpToSi:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool dstIs64 = inst.base.type && inst.base.type.width > 32;
                bool srcIs64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                if (dstIs64)
                    self.emitter.emitLine(srcIs64 ? "i64.trunc_s/f64" : "i64.trunc_s/f32");
                else
                    self.emitter.emitLine(srcIs64 ? "i32.trunc_s/f64" : "i32.trunc_s/f32");
            }
            break;
        case wallvm::irOps::IrOpcode::FpToUi:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool dstIs64 = inst.base.type && inst.base.type.width > 32;
                bool srcIs64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                if (dstIs64)
                    self.emitter.emitLine(srcIs64 ? "i64.trunc_u/f64" : "i64.trunc_u/f32");
                else
                    self.emitter.emitLine(srcIs64 ? "i32.trunc_u/f64" : "i32.trunc_u/f32");
            }
            break;
        case wallvm::irOps::IrOpcode::UiToFp:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool srcIs64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                bool dstIs64 = inst.base.type && inst.base.type.width > 32;
                if (dstIs64)
                    self.emitter.emitLine(srcIs64 ? "f64.convert_u/i64" : "f64.convert_u/i32");
                else
                    self.emitter.emitLine(srcIs64 ? "f32.convert_u/i64" : "f32.convert_u/i32");
            }
            break;
        case wallvm::irOps::IrOpcode::FpTrunc:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            self.emitter.emitLine("f32.demote/f64");
            break;
        case wallvm::irOps::IrOpcode::FpExt:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            self.emitter.emitLine("f64.promote/f32");
            break;
        case wallvm::irOps::IrOpcode::Trunc:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            self.emitter.emitLine("i32.wrap_i64");
            break;
        case wallvm::irOps::IrOpcode::Zext:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                u32 srcWidth = (inst.ops[0] && inst.ops[0].type) ? inst.ops[0].type.width : 32;
                if (srcWidth <= 8)
                {
                    self.emitter.emitLine("i32.const 0xFF");
                    self.emitter.emitLine("i32.and");
                }
                else if (srcWidth <= 16)
                {
                    self.emitter.emitLine("i32.const 0xFFFF");
                    self.emitter.emitLine("i32.and");
                }
                else if (srcWidth > 32)
                {
                    self.emitter.emitLine("i32.wrap_i64");
                }
                // else: i32->i32 zero extend is a no-op
            }
            break;
        case wallvm::irOps::IrOpcode::Sext:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                u32 srcWidth = (inst.ops[0] && inst.ops[0].type) ? inst.ops[0].type.width : 32;
                if (srcWidth <= 8)
                    self.emitter.emitLine("i32.extend8_s");
                else if (srcWidth <= 16)
                    self.emitter.emitLine("i32.extend16_s");
                // else: i32->i32 sign extend is a no-op
            }
            break;
        case wallvm::irOps::IrOpcode::Bitcast:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            break;
        case wallvm::irOps::IrOpcode::Unreachable:
            self.emitter.emitLine("unreachable");
            break;
        case wallvm::irOps::IrOpcode::SMin:
            self.emitMin(inst, true);
            break;
        case wallvm::irOps::IrOpcode::SMax:
            self.emitMax(inst, true);
            break;
        case wallvm::irOps::IrOpcode::UMin:
            self.emitMin(inst, false);
            break;
        case wallvm::irOps::IrOpcode::UMax:
            self.emitMax(inst, false);
            break;
        case wallvm::irOps::IrOpcode::Abs:
            if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
            {
                bool is64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
                self.emitter.emitLine("local.tee $abs_tmp");
                self.emitter.emitLine("local.get $abs_tmp");
                self.emitter.emitLine(is64 ? "i64.const 0" : "i32.const 0");
                self.emitter.emitLine(is64 ? "i64.sub" : "i32.sub");
                self.emitter.emitLine("local.get $abs_tmp");
                self.emitter.emitLine(is64 ? "i64.const 0" : "i32.const 0");
                self.emitter.emitLine(is64 ? "i64.gt_s" : "i32.gt_s");
                self.emitter.emitLine("select");
            }
            break;
        default:
            self.emitter.emit(";; unhandled opcode ");
            self.emitter.emitU32(inst.opcode);
            self.emitter.emitLine("");
            break;
        }
    }

    void emitBinOp(wallvm::ir_types::IrInst* inst, const char* op32, const char* op64)
    {
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
        bool is64 = inst.base.type && inst.base.type.width > 32;
        self.emitter.emitLine(is64 ? op64 : op32);
    }

    void emitLoadType(wallvm::ir_types::IrInst* inst)
    {
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        if (!inst.base.type) { self.emitter.emitLine("i32.load"); return; }
        switch (inst.base.type.kind)
        {
        case wallvm::ir_types::IrTypeKind::Int:
            // NOTE: IrType does not currently track signedness, so we always
            // sign-extend sub-word loads. To support unsigned loads, add an
            // isSigned field to IrType and use i32.load8_u / i32.load16_u
            // for unsigned types.
            if (inst.base.type.width <= 8) self.emitter.emitLine("i32.load8_s");
            else if (inst.base.type.width <= 16) self.emitter.emitLine("i32.load16_s");
            else if (inst.base.type.width <= 32) self.emitter.emitLine("i32.load");
            else self.emitter.emitLine("i64.load");
            break;
        case wallvm::ir_types::IrTypeKind::Float:
            if (inst.base.type.width <= 32) self.emitter.emitLine("f32.load");
            else self.emitter.emitLine("f64.load");
            break;
        default:
            self.emitter.emitLine("i32.load");
            break;
        }
    }

    void emitStoreType(wallvm::ir_types::IrInst* inst)
    {
        if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        wallvm::ir_types::IrType* ty = inst.ops[0] ? inst.ops[0].type : null;
        if (!ty) { self.emitter.emitLine("i32.store"); return; }
        switch (ty.kind)
        {
        case wallvm::ir_types::IrTypeKind::Int:
            if (ty.width <= 8) self.emitter.emitLine("i32.store8");
            else if (ty.width <= 16) self.emitter.emitLine("i32.store16");
            else if (ty.width <= 32) self.emitter.emitLine("i32.store");
            else self.emitter.emitLine("i64.store");
            break;
        case wallvm::ir_types::IrTypeKind::Float:
            if (ty.width <= 32) self.emitter.emitLine("f32.store");
            else self.emitter.emitLine("f64.store");
            break;
        default:
            self.emitter.emitLine("i32.store");
            break;
        }
    }

    void emitICmp(wallvm::ir_types::IrInst* inst)
    {
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
        bool is64 = inst.base.type && inst.base.type.width > 32;
        const char* pfx = is64 ? "i64." : "i32.";
        switch (inst.icmpPred)
        {
        case wallvm::irOps::IrICmpPred::Eq: self.emitter.emit(pfx); self.emitter.emitLine("eq"); break;
        case wallvm::irOps::IrICmpPred::Ne: self.emitter.emit(pfx); self.emitter.emitLine("ne"); break;
        case wallvm::irOps::IrICmpPred::Slt: self.emitter.emit(pfx); self.emitter.emitLine("lt_s"); break;
        case wallvm::irOps::IrICmpPred::Sle: self.emitter.emit(pfx); self.emitter.emitLine("le_s"); break;
        case wallvm::irOps::IrICmpPred::Sgt: self.emitter.emit(pfx); self.emitter.emitLine("gt_s"); break;
        case wallvm::irOps::IrICmpPred::Sge: self.emitter.emit(pfx); self.emitter.emitLine("ge_s"); break;
        case wallvm::irOps::IrICmpPred::Ult: self.emitter.emit(pfx); self.emitter.emitLine("lt_u"); break;
        case wallvm::irOps::IrICmpPred::Ule: self.emitter.emit(pfx); self.emitter.emitLine("le_u"); break;
        case wallvm::irOps::IrICmpPred::Ugt: self.emitter.emit(pfx); self.emitter.emitLine("gt_u"); break;
        case wallvm::irOps::IrICmpPred::Uge: self.emitter.emit(pfx); self.emitter.emitLine("ge_u"); break;
        default: self.emitter.emit(pfx); self.emitter.emitLine("eq"); break;
        }
    }

    void emitFCmp(wallvm::ir_types::IrInst* inst)
    {
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
        bool is64 = inst.base.type && inst.base.type.width > 32;
        const char* pfx = is64 ? "f64." : "f32.";
        switch (inst.fcmpPred)
        {
        // Ordered predicates (WASM native)
        case wallvm::irOps::IrFCmpPred::Oeq: self.emitter.emit(pfx); self.emitter.emitLine("eq"); break;
        case wallvm::irOps::IrFCmpPred::One: self.emitter.emit(pfx); self.emitter.emitLine("ne"); break;
        case wallvm::irOps::IrFCmpPred::Olt: self.emitter.emit(pfx); self.emitter.emitLine("lt"); break;
        case wallvm::irOps::IrFCmpPred::Ole: self.emitter.emit(pfx); self.emitter.emitLine("le"); break;
        case wallvm::irOps::IrFCmpPred::Ogt: self.emitter.emit(pfx); self.emitter.emitLine("gt"); break;
        case wallvm::irOps::IrFCmpPred::Oge: self.emitter.emit(pfx); self.emitter.emitLine("ge"); break;
        // Unordered predicates: complement of the opposite ordered predicate
        // Ueq = !ne, Une = !eq, Ult = !ge, Ule = !gt, Ugt = !le, Uge = !lt
        case wallvm::irOps::IrFCmpPred::Ueq: self.emitter.emit(pfx); self.emitter.emitLine("ne"); self.emitter.emitLine("i32.eqz"); break;
        case wallvm::irOps::IrFCmpPred::Une: self.emitter.emit(pfx); self.emitter.emitLine("eq"); self.emitter.emitLine("i32.eqz"); break;
        case wallvm::irOps::IrFCmpPred::Ult: self.emitter.emit(pfx); self.emitter.emitLine("ge"); self.emitter.emitLine("i32.eqz"); break;
        case wallvm::irOps::IrFCmpPred::Ule: self.emitter.emit(pfx); self.emitter.emitLine("gt"); self.emitter.emitLine("i32.eqz"); break;
        case wallvm::irOps::IrFCmpPred::Ugt: self.emitter.emit(pfx); self.emitter.emitLine("le"); self.emitter.emitLine("i32.eqz"); break;
        case wallvm::irOps::IrFCmpPred::Uge: self.emitter.emit(pfx); self.emitter.emitLine("lt"); self.emitter.emitLine("i32.eqz"); break;
        default: self.emitter.emit(pfx); self.emitter.emitLine("eq"); break;
        }
    }

    void emitMin(wallvm::ir_types::IrInst* inst, bool isSigned)
    {
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
        bool is64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
        if (isSigned)
            self.emitter.emitLine(is64 ? "i64.lt_s" : "i32.lt_s");
        else
            self.emitter.emitLine(is64 ? "i64.lt_u" : "i32.lt_u");
        self.emitter.emitLine("select");
    }

    void emitMax(wallvm::ir_types::IrInst* inst, bool isSigned)
    {
        if (inst.nops > 0) self.emitValuePush(inst.ops[0]);
        if (inst.nops > 1) self.emitValuePush(inst.ops[1]);
        bool is64 = inst.ops[0] && inst.ops[0].type && inst.ops[0].type.width > 32;
        if (isSigned)
            self.emitter.emitLine(is64 ? "i64.gt_s" : "i32.gt_s");
        else
            self.emitter.emitLine(is64 ? "i64.gt_u" : "i32.gt_u");
        self.emitter.emitLine("select");
    }

    void emitValuePush(wallvm::ir_types::IrValue* val)
    {
        if (!val) return;
        if (val.kind == wallvm::ir_types::IrValueKind::ConstInt)
        {
            bool is64 = val.type && val.type.width > 32;
            self.emitter.emit(is64 ? "i64.const " : "i32.const ");
            self.emitter.emitI64((i64)val.valData);
            self.emitter.emitLine("");
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::ConstFloat)
        {
            bool is64 = val.type && val.type.width > 32;
            self.emitter.emit(is64 ? "f64.const " : "f32.const ");
            if (is64)
                self.emitter.emitHexU64(val.valData);
            else
                self.emitter.emitHexU64(val.valData & 0xFFFFFFFF);
            self.emitter.emitLine("");
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::Arg)
        {
            self.emitter.emit("local.get $");
            self.emitter.emitU32(val.id);
            self.emitter.emitLine("");
            return;
        }
        // For Inst values (and other non-Arg, non-Const values), the value is
        // already on the WASM stack from the previous instruction that computed
        // it. This relies on SSA form where each value is produced exactly once.
        // For multi-use values, the instruction emitter should use local.tee
        // to save the result to a local for later retrieval.
    }
}

pub bool irCodegenWasm32(wallvm::ir_types::IrModule* modd, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return false;

    WasmCodeGen codegen;
    codegen.init(ctx, modd);
    codegen.emitModule();
    return true;
}

pub const char* irCodegenWasm32Asm(wallvm::ir_types::IrModule* modd, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return null;

    WasmCodeGen codegen;
    codegen.init(ctx, modd);
    codegen.emitModule();
    return codegen.emitter.getOutput();
}
