mod wallvm = import(lib) wallvm;
mod std = import(lib) std;
mod x86_base = import(lib) wallvm::target::x86_64::x86_64_base.crl;

static void emitIrModule(x86_64_base::X86CodeGen* codegen, wallvm::ir_types::IrModule* modd)
{
    codegen.emitter.emitLine(".section .data");
    codegen.emitter.emitLine(".section .text");

    for (u32 fi = 0; fi < modd.nfuncs; fi++)
    {
        wallvm::ir_types::IrFunc* func = modd.funcs[fi];
        if (!func) continue;
        if (func*.isExtern) continue;

        codegen.emitPrologue(func);

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb.ninsts; ii++)
                codegen.emitInst(bb.insts[ii]);
        }

        codegen.emitEpilogue();
    }
}

pub bool irCodegenX86(wallvm::ir_types::IrModule* modd, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return false;

    x86_64_base::X86CodeGen codegen;
    codegen.init(ctx, modd, false, true);

    emitIrModule(&codegen, modd);

    return true;
}

pub const char* irCodegenX86Asm(wallvm::ir_types::IrModule* modd, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !modd) return null;

    x86_64_base::X86CodeGen codegen;
    codegen.init(ctx, modd, false, true);

    emitIrModule(&codegen, modd);

    return codegen.emitter.getOutput();
}
