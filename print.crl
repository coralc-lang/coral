import(lib) std::collections::arr { Array };
// import(lib) platform::libc { printf };

var _a = "fooooo";
var b = _a.isAsciiAlpha();

Array<i32, 4> boys;


pub i32 main()
{
    boys.fill(4 * 4);
    i32 a = 4;
    i32 b = 5;
    println("HELLO {} ---- {}, {} {{}}, {..}", _a, a, b, boys);
    return 0;
}


