pub struct str
{
    const u8 ptr;
    usize len;
}

extend str
{
    static str fromCstr(const std::cchar* cstr)
    {
        str sv;
        sv.ptr = cstr;
        sv.len = std::libc::strlen(cstr);
        return sv;
    }

    static str fromParts(const u8 ptr, usize len)
    {
        str sv;
        sv.ptr = ptr;
        sv.len = len;
        return sv;
    }

    static str empty()
    {
        str sv;
        sv.ptr = "";
        sv.len = 0;
        return sv;
    }

    const std::cchar* asU8() { return self.ptr; }

    std::cchar at(usize idx)
    {
        assert(idx < self.len);
        return self.ptr[idx];
    }

    bool isEmpty() { return self.len == 0; }

    bool equals(str other)
    {
        if (self.len != other.len) return false;
        return std::libc::memcmp((const void*)self.ptr, (const void*)other.ptr, self.len) == 0;
    }

    i32 compare(str other)
    {
        usize minLen = self.len < other.len ? self.len : other.len;
        i32 r = std::libc::memcmp((const void*)self.ptr, (const void*)other.ptr, minLen);
        if (r != 0) return r;
        if (self.len < other.len) return -1;
        if (self.len > other.len) return 1;
        return 0;
    }

    bool startsWith(str prefix)
    {
        if (prefix.len > self.len) return false;
        return std::libc::memcmp((const void*)self.ptr, (const void*)prefix.ptr, prefix.len) == 0;
    }

    bool endsWith(str suffix)
    {
        if (suffix.len > self.len) return false;
        return std::libc::memcmp((const void*)(self.ptr + (self.len - suffix.len)),
                      (const void*)suffix.ptr, suffix.len) == 0;
    }

    bool containsView(str needle)
    {
        return self.findView(needle) < self.len;
    }

    bool containsByte(u8 c)
    {
        return self.findByte(c) < self.len;
    }

    usize findByte(u8 c)
    {
        for (usize i = 0; i < self.len; i++)
            if (self.ptr[i] == c) return i;
        return self.len;
    }

    usize rfindByte(u8 c)
    {
        usize i = self.len;
        while (i > 0)
        {
            i--;
            if (self.ptr[i] == c) return i;
        }
        return self.len;
    }

    usize findView(str needle)
    {
        if (needle.len == 0) return 0;
        if (needle.len > self.len) return self.len;
        for (usize i = 0; i <= self.len - needle.len; i++)
        {
            if (std::libc::memcmp((const void*)(self.ptr + i),
                                (const void*)needle.ptr,
                                needle.len) == 0)
                return i;
        }
        return self.len;
    }

    str slice(usize start, usize end)
    {
        assert(start <= end);
        assert(end <= self.len);
        return str::fromParts(self.ptr + start, end - start);
    }

    str trimStart()
    {
        usize i = 0;
        while (i < self.len && (self.ptr[i] == ' ' ||
                                 self.ptr[i] == '\t' ||
                                 self.ptr[i] == '\n' ||
                                 self.ptr[i] == '\r')) i++;
        return str::fromParts(self.ptr + i, self.len - i);
    }

    str trimEnd()
    {
        usize e = self.len;
        while (e > 0 && (self.ptr[e-1] == ' ' ||
                          self.ptr[e-1] == '\t' ||
                          self.ptr[e-1] == '\n' ||
                          self.ptr[e-1] == '\r')) e--;
        return str::fromParts(self.ptr, e);
    }

    str trim()
    {
        str t = self.trimStart();
        return t.trimEnd();
    }

    bool isAsciiDigit()
    {
        for (usize i = 0; i < self.len; i++)
        {
            std::cchar c = self.ptr[i];
            if (!core::charUtil::isDigit(c)) return false;
        }
        return self.len > 0;
    }

    bool isAsciiAlpha()
    {
        for (usize i = 0; i < self.len; i++)
        {
            std::cchar c = self.ptr[i];
            if (!core::charUtil::isAlpha(c)) return false;
        }
        return self.len > 0;
    }

    bool isAsciiAlnum()
    {
        for (usize i = 0; i < self.len; i++)
        {
            std::cchar c = self.ptr[i];
            if (!core::charUtil::isAlnum(c)) return false;
        }
        return self.len > 0;
    }
}
