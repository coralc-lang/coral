pub bool isDigit(u8 c)
{
    u16 v = (u16)c;
    return v >= (u16)'0' && v <= (u16)'9';
}

pub bool isAlpha(u8 c)
{
    u16 v = (u16)c;
    return (v >= (u16)'a' && v <= (u16)'z') || (v >= (u16)'A' && v <= (u16)'Z');
}

pub bool isAlnum(u8 c) { return isDigit(c) || isAlpha(c); }

pub bool isLower(u8 c)
{
    u16 v = (u16)c;
    return v >= (u16)'a' && v <= (u16)'z';
}

pub bool isUpper(u8 c)
{
    u16 v = (u16)c;
    return v >= (u16)'A' && v <= (u16)'Z';
}

pub u8 toLower(u8 c)
{
    u16 v = (u16)c;
    if (v >= (u16)'A' && v <= (u16)'Z') return (u8)(v + 0x20);
    return c;
}

pub u8 toUpper(u8 c)
{
    u16 v = (u16)c;
    if (v >= (u16)'a' && v <= (u16)'z') return (u8)(v - 0x20);
    return c;
}

pub bool isSpace(u8 c)
{
    u16 v = (u16)c;
    return v == (u16)' ' || v == (u16)'\t' || v == (u16)'\n' || v == (u16)'\r' || v == (u16)'\f' || v == (u16)'\v';
}

pub bool isPrint(u8 c)
{
    u16 v = (u16)c;
    return v >= 0x20 && v <= 0x7E;
}

pub bool isControl(u8 c)
{
    u16 v = (u16)c;
    return v < 0x20 || v == 0x7F;
}

pub bool isHexDigit(u8 c)
{
    u16 v = (u16)c;
    return (v >= (u16)'0' && v <= (u16)'9') || (v >= (u16)'a' && v <= (u16)'f') || (v >= (u16)'A' && v <= (u16)'F');
}

pub u8 digitValue(u8 c)
{
    u16 v = (u16)c;
    if (v >= (u16)'0' && v <= (u16)'9') return (u8)(v - (u16)'0');
    if (v >= (u16)'a' && v <= (u16)'f') return (u8)(v - (u16)'a' + 10);
    if (v >= (u16)'A' && v <= (u16)'F') return (u8)(v - (u16)'A' + 10);
    return (u8)0;
}

pub bool isAscii(u8 c)
{
    return (u16)c <= 0x7F;
}

pub bool isWhitespace(u8 c) { return isSpace(c); }

pub bool isNewline(u8 c)
{
    u16 v = (u16)c;
    return v == (u16)'\n' || v == (u16)'\r';
}

pub bool isPunctuation(u8 c)
{
    u16 v = (u16)c;
    return (v >= 0x21 && v <= 0x2F) || (v >= 0x3A && v <= 0x40) ||
           (v >= 0x5B && v <= 0x60) || (v >= 0x7B && v <= 0x7E);
}

pub bool isSymbol(u8 c)
{
    u16 v = (u16)c;
    return v == (u16)'+' || v == (u16)'-' || v == (u16)'*' || v == (u16)'/' ||
           v == (u16)'=' || v == (u16)'<' || v == (u16)'>' || v == (u16)'!' ||
           v == (u16)'&' || v == (u16)'|' || v == (u16)'^' || v == (u16)'~' ||
           v == (u16)'%' || v == (u16)'?' || v == (u16)'@';
}

pub u32 utf8Width(u8 c)
{
    u32 v = (u32)c;
    if (v <= 0x7F) return 1;
    if (v <= 0x7FF) return 2;
    if (v <= 0xFFFF) return 3;
    return 4;
}

pub u32 encodeUtf8(u8 c, u8* buf)
{
    u32 v = (u32)c;
    if (v <= 0x7F)
    {
        buf[0] = (u8)v;
        return 1;
    }
    if (v <= 0x7FF)
    {
        buf[0] = (u8)(0xC0 | (v >> 6));
        buf[1] = (u8)(0x80 | (v & 0x3F));
        return 2;
    }
    if (v <= 0xFFFF)
    {
        buf[0] = (u8)(0xE0 | (v >> 12));
        buf[1] = (u8)(0x80 | ((v >> 6) & 0x3F));
        buf[2] = (u8)(0x80 | (v & 0x3F));
        return 3;
    }
    buf[0] = (u8)(0xF0 | (v >> 18));
    buf[1] = (u8)(0x80 | ((v >> 12) & 0x3F));
    buf[2] = (u8)(0x80 | ((v >> 6) & 0x3F));
    buf[3] = (u8)(0x80 | (v & 0x3F));
    return 4;
}

pub u8 decodeUtf8(const u8* buf, u32* bytesOut)
{
    u8 b0 = buf[0];
    if (b0 <= 0x7F)
    {
        bytesOut* = 1;
        return (u8)b0;
    }
    if ((b0 & 0xE0) == 0xC0)
    {
        bytesOut* = 2;
        return (u8)(((u32)(b0 & 0x1F) << 6) | ((u32)(buf[1] & 0x3F)));
    }
    if ((b0 & 0xF0) == 0xE0)
    {
        bytesOut* = 3;
        return (u8)(((u32)(b0 & 0x0F) << 12) | ((u32)(buf[1] & 0x3F) << 6) | ((u32)(buf[2] & 0x3F)));
    }
    bytesOut* = 4;
    return (u8)(((u32)(b0 & 0x07) << 18) | ((u32)(buf[1] & 0x3F) << 12) | ((u32)(buf[2] & 0x3F) << 6) | ((u32)(buf[3] & 0x3F)));
}

pub u32 toUtf8(u8 c, u8* buf)
{
    return encodeUtf8(c, buf);
}

pub u8 fromUtf8(const u8* buf, u32* bytesOut)
{
    return decodeUtf8(buf, bytesOut);
}

pub u8 toAscii(u8 c)
{
    return (u8)((u8)c);
}

pub bool u8Eq(u8 a, u8 b) { return a == b; }

pub bool u8EqLower(u8 a, u8 b) { return toLower(a) == toLower(b); }

pub i32 u8Cmp(u8 a, u8 b)
{
    u16 av = (u16)a;
    u16 bv = (u16)b;
    if (av < bv) return -1;
    if (av > bv) return 1;
    return 0;
}

pub str toStr(u8 c)
{
    u8 buf[4];
    u32 n = encodeUtf8(c, buf);
    return str::fromParts(buf, (u64)n);
}

pub u8 const newline = '\n';
pub u8 const tab = '\t';
pub u8 const space = ' ';
pub u8 const nullu8 = '\0';
pub u8 const carriageReturn = '\r';


