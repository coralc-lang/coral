/* context/context.crl — AST context with arenas and interning
 *
 * Owns all compiler data: interned strings, uniqued types, AST nodes.
 * Bump allocation: single large buffers, bump pointer, free all at once.
 * Follows Clang's ASTContext + BumpPtrAllocator design.
 */

mod id = import "../coral-ast/id";
import id { Str, SourceLoc, NodeId };
mod types = import "../coral-ast/types";
import types { Ty, TypeEntry, TypeKind };
mod node = import "../coral-ast/node";
import node { Node, NodeKind };
mod decl_ast = import "../coral-ast/decl";
import decl_ast { File, VariantVariant };
mod stmt = import "../coral-ast/stmt";
import stmt { SwitchCase };

extern("C") rawptr malloc(usize size);
extern("C") rawptr calloc(usize count, usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);
extern("C") void free(rawptr ptr);

pub struct InternEntry
{
    u8* ptr;
    usize len;
    u32 id;
}

pub struct NodeListBuilder
{
    NodeId* data;
    u32 len;
    u32 cap;
}

pub struct StrListBuilder
{
    Str* data;
    u32 len;
    u32 cap;
}

pub struct TyListBuilder
{
    Ty* data;
    u32 len;
    u32 cap;
}

pub struct SwitchListBuilder
{
    SwitchCase* data;
    u32 len;
    u32 cap;
}

pub struct VariantListBuilder
{
    VariantVariant* data;
    u32 len;
    u32 cap;
}

pub struct AstContext
{
    InternEntry* interns;
    u32 internsLen;
    u32 internsCap;
    TypeEntry* types;
    u32 typesLen;
    u32 typesCap;
    Node* nodes;
    u32 nodesLen;
    u32 nodesCap;
    rawptr* owned;
    u32 ownedLen;
    u32 ownedCap;
    u32 error;

    void init(u32 internCap, u32 typeCap, u32 nodeCap)
    {
        self.interns = null;
        self.internsLen = 0;
        self.internsCap = 0;
        self.types = null;
        self.typesLen = 0;
        self.typesCap = 0;
        self.nodes = null;
        self.nodesLen = 0;
        self.nodesCap = 0;
        self.owned = null;
        self.ownedLen = 0;
        self.ownedCap = 0;
        self.error = 0;

        if (internCap > 0)
        {
            usize bytes = 0;
            if (self.byteCount(internCap, sizeof(InternEntry), &bytes))
            {
                self.interns = (InternEntry*)calloc(1, bytes);
                if (self.interns != null)
                {
                    self.internsCap = internCap;
                    self.internsLen = 1;
                }
                else
                {
                    self.setError();
                }
            }
        }
        if (typeCap > 0)
        {
            usize bytes = 0;
            if (self.byteCount(typeCap, sizeof(TypeEntry), &bytes))
            {
                self.types = (TypeEntry*)calloc(1, bytes);
                if (self.types != null)
                {
                    self.typesCap = typeCap;
                    self.typesLen = 1;
                }
                else
                {
                    self.setError();
                }
            }
        }
        if (nodeCap > 0)
        {
            usize bytes = 0;
            if (self.byteCount(nodeCap, sizeof(Node), &bytes))
            {
                self.nodes = (Node*)calloc(1, bytes);
                if (self.nodes != null)
                {
                    self.nodesCap = nodeCap;
                    self.nodesLen = 1;
                }
                else
                {
                    self.setError();
                }
            }
        }
    }

    void deinit()
    {
        u32 i = 0;
        while (i < self.ownedLen)
        {
            if (self.owned[i] != null) free(self.owned[i]);
            i = i + 1;
        }
        if (self.owned != null) free(self.owned);
        if (self.interns != null) free(self.interns);
        if (self.types != null) free(self.types);
        if (self.nodes != null) free(self.nodes);
        self.interns = null;
        self.internsLen = 0;
        self.internsCap = 0;
        self.types = null;
        self.typesLen = 0;
        self.typesCap = 0;
        self.nodes = null;
        self.nodesLen = 0;
        self.nodesCap = 0;
        self.owned = null;
        self.ownedLen = 0;
        self.ownedCap = 0;
        self.error = 0;
    }

    bool streq(u8* a, usize aLen, u8* b, usize bLen)
    {
        if (aLen != bLen) return false;
        if (aLen == 0) return true;
        if (a == null || b == null) return false;
        usize i = 0;
        while (i < aLen)
        {
            u8* ap = a + i;
            u8* bp = b + i;
            if (ap[0] != bp[0]) return false;
            i = i + 1;
        }
        return true;
    }

    void setError()
    {
        self.error = 1;
    }

    bool hasError()
    {
        return self.error != 0;
    }

    bool byteCount(u32 count, usize elementSize, usize* bytes)
    {
        usize maxSize = (usize)0 - 1;
        if (elementSize == 0 || (usize)count > maxSize / elementSize)
        {
            self.setError();
            return false;
        }
        *bytes = (usize)count * elementSize;
        return true;
    }

    rawptr grow(rawptr data, u32 oldCap, u32* newCap, usize elementSize)
    {
        if (self.error != 0) return null;
        u32 nextCap = 4;
        if (oldCap != 0)
        {
            if (oldCap > 2147483647)
            {
                self.setError();
                return null;
            }
            nextCap = oldCap * 2;
            if (nextCap <= oldCap)
            {
                self.setError();
                return null;
            }
        }
        usize bytes = 0;
        if (!self.byteCount(nextCap, elementSize, &bytes)) return null;
        rawptr result = realloc(data, bytes);
        if (result == null)
        {
            self.setError();
            return null;
        }
        *newCap = nextCap;
        return result;
    }

    bool ensureInterns()
    {
        if (self.error != 0) return false;
        if (self.interns == null || self.internsCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.interns, self.internsCap, &newCap, sizeof(InternEntry));
            if (raw == null) return false;
            self.interns = (InternEntry*)raw;
            self.internsCap = newCap;
        }
        if (self.internsLen == 0)
        {
            self.interns[0].ptr = null;
            self.interns[0].len = 0;
            self.interns[0].id = 0;
            self.internsLen = 1;
        }
        return true;
    }

    bool ensureTypes()
    {
        if (self.error != 0) return false;
        if (self.types == null || self.typesCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.types, self.typesCap, &newCap, sizeof(TypeEntry));
            if (raw == null) return false;
            self.types = (TypeEntry*)raw;
            self.typesCap = newCap;
        }
        if (self.typesLen == 0)
        {
            self.types[0].kind.tag = TypeKind::Error;
            self.types[0].loc.data = 0;
            self.typesLen = 1;
        }
        return true;
    }

    bool ensureNodes()
    {
        if (self.error != 0) return false;
        if (self.nodes == null || self.nodesCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.nodes, self.nodesCap, &newCap, sizeof(Node));
            if (raw == null) return false;
            self.nodes = (Node*)raw;
            self.nodesCap = newCap;
        }
        if (self.nodesLen == 0)
        {
            self.nodes[0].kind.tag = NodeKind::Invalid;
            self.nodes[0].kind.payload.Invalid.flags = 0;
            self.nodes[0].loc.data = 0;
            self.nodesLen = 1;
        }
        return true;
    }

    bool ensureOwned()
    {
        if (self.error != 0) return false;
        if (self.owned == null || self.ownedCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.owned, self.ownedCap, &newCap, sizeof(rawptr));
            if (raw == null) return false;
            self.owned = (rawptr*)raw;
            self.ownedCap = newCap;
        }
        return true;
    }

    bool growInterns()
    {
        if (self.internsLen < self.internsCap) return true;
        u32 newCap = self.internsCap;
        rawptr raw = self.grow((rawptr)self.interns, self.internsCap, &newCap, sizeof(InternEntry));
        if (raw == null) return false;
        self.interns = (InternEntry*)raw;
        self.internsCap = newCap;
        return true;
    }

    bool growTypes()
    {
        if (self.typesLen < self.typesCap) return true;
        u32 newCap = self.typesCap;
        rawptr raw = self.grow((rawptr)self.types, self.typesCap, &newCap, sizeof(TypeEntry));
        if (raw == null) return false;
        self.types = (TypeEntry*)raw;
        self.typesCap = newCap;
        return true;
    }

    bool growNodes()
    {
        if (self.nodesLen < self.nodesCap) return true;
        u32 newCap = self.nodesCap;
        rawptr raw = self.grow((rawptr)self.nodes, self.nodesCap, &newCap, sizeof(Node));
        if (raw == null) return false;
        self.nodes = (Node*)raw;
        self.nodesCap = newCap;
        return true;
    }

    u32 intern(u8* ptr, usize len)
    {
        if (len == 0 || ptr == null) return 0;
        if (self.error != 0) return 0;
        if (!self.ensureInterns()) return 0;

        u32 i = 1;
        while (i < self.internsLen)
        {
            InternEntry* e = self.interns + i;
            if (self.streq(e.ptr, e.len, ptr, len))
            {
                return e.id;
            }
            i = i + 1;
        }
        if (!self.growInterns()) return 0;
        if (self.internsLen == 4294967295) {
            self.setError();
            return 0;
        }
        InternEntry* e = self.interns + self.internsLen;
        e.ptr = ptr;
        e.len = len;
        e.id = self.internsLen;
        self.internsLen = self.internsLen + 1;
        return e.id;
    }

    bool track(rawptr ptr)
    {
        if (ptr == null) return true;
        if (self.error != 0) return false;
        if (!self.ensureOwned()) return false;
        if (self.ownedLen >= self.ownedCap)
        {
            u32 newCap = self.ownedCap;
            rawptr raw = self.grow((rawptr)self.owned, self.ownedCap, &newCap, sizeof(rawptr));
            if (raw == null) return false;
            self.owned = (rawptr*)raw;
            self.ownedCap = newCap;
        }
        self.owned[self.ownedLen] = ptr;
        self.ownedLen = self.ownedLen + 1;
        return true;
    }

    void nodeListInit(NodeListBuilder* b)
    {
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
    }

    bool nodeListAppend(NodeListBuilder* b, NodeId value)
    {
        if (self.error != 0) return false;
        if (b*.len >= b*.cap)
        {
            u32 newCap = b*.cap;
            rawptr raw = self.grow((rawptr)b*.data, b*.cap, &newCap, sizeof(NodeId));
            if (raw == null) return false;
            b*.data = (NodeId*)raw;
            b*.cap = newCap;
        }
        b*.data[b*.len] = value;
        b*.len = b*.len + 1;
        return true;
    }

    NodeId* nodeListFinish(NodeListBuilder* b)
    {
        NodeId* result = b*.data;
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
        if (result != null && !self.track((rawptr)result))
        {
            free((rawptr)result);
            return null;
        }
        return result;
    }

    void strListInit(StrListBuilder* b)
    {
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
    }

    bool strListAppend(StrListBuilder* b, Str value)
    {
        if (self.error != 0) return false;
        if (b*.len >= b*.cap)
        {
            u32 newCap = b*.cap;
            rawptr raw = self.grow((rawptr)b*.data, b*.cap, &newCap, sizeof(Str));
            if (raw == null) return false;
            b*.data = (Str*)raw;
            b*.cap = newCap;
        }
        b*.data[b*.len] = value;
        b*.len = b*.len + 1;
        return true;
    }

    Str* strListFinish(StrListBuilder* b)
    {
        Str* result = b*.data;
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
        if (result != null && !self.track((rawptr)result))
        {
            free((rawptr)result);
            return null;
        }
        return result;
    }

    void tyListInit(TyListBuilder* b)
    {
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
    }

    bool tyListAppend(TyListBuilder* b, Ty value)
    {
        if (self.error != 0) return false;
        if (b*.len >= b*.cap)
        {
            u32 newCap = b*.cap;
            rawptr raw = self.grow((rawptr)b*.data, b*.cap, &newCap, sizeof(Ty));
            if (raw == null) return false;
            b*.data = (Ty*)raw;
            b*.cap = newCap;
        }
        b*.data[b*.len] = value;
        b*.len = b*.len + 1;
        return true;
    }

    Ty* tyListFinish(TyListBuilder* b)
    {
        Ty* result = b*.data;
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
        if (result != null && !self.track((rawptr)result))
        {
            free((rawptr)result);
            return null;
        }
        return result;
    }

    void switchListInit(SwitchListBuilder* b)
    {
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
    }

    bool switchListAppend(SwitchListBuilder* b, SwitchCase value)
    {
        if (self.error != 0) return false;
        if (b*.len >= b*.cap)
        {
            u32 newCap = b*.cap;
            rawptr raw = self.grow((rawptr)b*.data, b*.cap, &newCap, sizeof(SwitchCase));
            if (raw == null) return false;
            b*.data = (SwitchCase*)raw;
            b*.cap = newCap;
        }
        b*.data[b*.len] = value;
        b*.len = b*.len + 1;
        return true;
    }

    SwitchCase* switchListFinish(SwitchListBuilder* b)
    {
        SwitchCase* result = b*.data;
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
        if (result != null && !self.track((rawptr)result))
        {
            free((rawptr)result);
            return null;
        }
        return result;
    }

    void variantListInit(VariantListBuilder* b)
    {
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
    }

    bool variantListAppend(VariantListBuilder* b, VariantVariant value)
    {
        if (self.error != 0) return false;
        if (b*.len >= b*.cap)
        {
            u32 newCap = b*.cap;
            rawptr raw = self.grow((rawptr)b*.data, b*.cap, &newCap, sizeof(VariantVariant));
            if (raw == null) return false;
            b*.data = (VariantVariant*)raw;
            b*.cap = newCap;
        }
        b*.data[b*.len] = value;
        b*.len = b*.len + 1;
        return true;
    }

    VariantVariant* variantListFinish(VariantListBuilder* b)
    {
        VariantVariant* result = b*.data;
        b*.data = null;
        b*.len = 0;
        b*.cap = 0;
        if (result != null && !self.track((rawptr)result))
        {
            free((rawptr)result);
            return null;
        }
        return result;
    }

    rawptr allocBytes(usize size)
    {
        if (size == 0) return null;
        if (self.error != 0) return null;
        rawptr ptr = malloc(size);
        if (ptr == null)
        {
            self.setError();
            return null;
        }
        if (!self.track(ptr))
        {
            free(ptr);
            return null;
        }
        return ptr;
    }

    NodeId* allocNodeList(u32 len)
    {
        if (len == 0) return null;
        usize bytes = 0;
        if (!self.byteCount(len, sizeof(NodeId), &bytes)) return null;
        return (NodeId*)self.allocBytes(bytes);
    }

    Str* allocStrList(u32 len)
    {
        if (len == 0) return null;
        usize bytes = 0;
        if (!self.byteCount(len, sizeof(Str), &bytes)) return null;
        return (Str*)self.allocBytes(bytes);
    }

    File* allocFile()
    {
        return (File*)self.allocBytes(sizeof(File));
    }

    Ty* allocTyList(u32 len)
    {
        if (len == 0) return null;
        usize bytes = 0;
        if (!self.byteCount(len, sizeof(Ty), &bytes)) return null;
        return (Ty*)self.allocBytes(bytes);
    }

    SwitchCase* allocSwitchCaseList(u32 len)
    {
        if (len == 0) return null;
        usize bytes = 0;
        if (!self.byteCount(len, sizeof(SwitchCase), &bytes)) return null;
        return (SwitchCase*)self.allocBytes(bytes);
    }

    Ty allocTypeSlot()
    {
        if (self.error != 0) return 0;
        if (!self.ensureTypes()) return 0;
        if (self.typesLen >= self.typesCap && !self.growTypes()) return 0;
        if (self.typesLen == 4294967295)
        {
            self.setError();
            return 0;
        }
        Ty id = self.typesLen;
        self.typesLen = self.typesLen + 1;
        return id;
    }

    NodeId allocNodeSlot()
    {
        if (self.error != 0) return self.noneNode();
        if (!self.ensureNodes()) return self.noneNode();
        if (self.nodesLen >= self.nodesCap && !self.growNodes()) return self.noneNode();
        if (self.nodesLen == 4294967295)
        {
            self.setError();
            return self.noneNode();
        }
        NodeId n;
        n.index = self.nodesLen;
        self.nodesLen = self.nodesLen + 1;
        return n;
    }

    NodeId noneNode()
    {
        NodeId n;
        n.index = 0;
        return n;
    }

    u32 nodeCount()
    {
        return self.nodesLen;
    }
}
