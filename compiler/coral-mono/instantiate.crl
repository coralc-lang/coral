mod id = import "../coral-ast/id";
import id { Str, NodeId };
mod types = import "../coral-ast/types";
import types { Ty, TypeEntry, TypeKind };
mod node = import "../coral-ast/node";
import node { Node, NodeKind };
mod decl_ast = import "../coral-ast/decl";
import decl_ast { Decl, DeclKind, GenericParam };
mod sema = import "../coral-semantics/sema";
import sema { Sema };
mod mono = import "mono";
import mono { MonoContext, MonoDeclKind, MonoInstance, MonoInstanceKind, MonoSubstitution };
mod collect = import "collect";
import collect;

extern("C") rawptr calloc(usize count, usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);
extern("C") void free(rawptr ptr);

pub extend MonoContext
{
    MonoSubstitution* buildSubstitutions(NodeId declaration, Ty* arguments, u32 argumentsLen)
    {
        u32 count = self.genericCount(declaration);
        if (count == 0) return null;
        MonoSubstitution* result = (MonoSubstitution*)calloc((usize)count, @sizeof(MonoSubstitution));
        if (result == null)
        {
            self.errors = self.errors + 1;
            return null;
        }
        u32 next = 0;
        Decl* decl = self.declAt(declaration);
        if (decl == null) return result;
        NodeId* params = null;
        u32 paramCount = 0;
        switch (decl->kind.tag)
        {
            DeclKind::Struct => {
                params = decl->kind.payload.Struct.genericParams;
                paramCount = decl->kind.payload.Struct.genericParamsLen;
            },

            DeclKind::Variant => {
                params = decl->kind.payload.Variant.genericParams;
                paramCount = decl->kind.payload.Variant.genericParamsLen;
            },

            DeclKind::Union => {
                params = decl->kind.payload.Union.genericParams;
                paramCount = decl->kind.payload.Union.genericParamsLen;
            },

            DeclKind::Trait => {
                params = decl->kind.payload.Trait.genericParams;
                paramCount = decl->kind.payload.Trait.genericParamsLen;
            },

            DeclKind::Func => {
                params = decl->kind.payload.Func.genericParams;
                paramCount = decl->kind.payload.Func.genericParamsLen;
            },
            else => {}
        }
        u32 i = 0;
        while (i < paramCount && next < argumentsLen)
        {
            Node* node = self.nodeAt(params[i]);
            if (node != null && node->kind.tag == NodeKind::GenericParam)
            {
                GenericParam* param = &node->kind.payload.GenericParam.value;
                result[next].parameter = param->name;
                result[next].index = next;
                result[next].declaration = params[i];
                result[next].typeNode = arguments[next];
                next = next + 1;
            }
            i = i + 1;
        }
        if (decl->kind.tag == DeclKind::Func)
        {
            i = 0;
            while (i < decl->kind.payload.Func.paramsLen && next < argumentsLen)
            {
                NodeId paramId = decl->kind.payload.Func.params[i];
                if (self.isTypeParameter(paramId))
                {
                    Str name = self.parameterName(paramId);
                    if (!self.nameInGenericParams(declaration, name))
                    {
                        result[next].parameter = name;
                        result[next].index = next;
                        result[next].declaration = paramId;
                        result[next].typeNode = arguments[next];
                        next = next + 1;
                    }
                }
                i = i + 1;
            }
        }
        return result;
    }

    bool sameArguments(Ty* left, Ty* right, u32 len)
    {
        u32 i = 0;
        while (i < len)
        {
            if (!self.sema.sameType(left[i], right[i])) return false;
            i = i + 1;
        }
        return true;
    }

    bool hasInstance(MonoDeclKind kind, Str name, Ty* arguments, u32 argumentsLen)
    {
        u32 i = 0;
        while (i < self.instancesLen)
        {
            if (self.instances[i].kind == (u8)kind && self.instances[i].name == name &&
                self.instances[i].argumentsLen == argumentsLen &&
                self.sameArguments(self.instances[i].arguments, arguments, argumentsLen))
                return true;
            i = i + 1;
        }
        return false;
    }

    bool addInstance(NodeId declaration, Ty* arguments, u32 argumentsLen)
    {
        Decl* decl = self.declAt(declaration);
        if (decl == null) return false;
        Str name = self.declarationName(declaration);
        MonoDeclKind kind;
        if (decl->kind.tag == DeclKind::Func) kind = MonoDeclKind::FunctionDecl;
        else kind = MonoDeclKind::TypeDecl;
        if (self.hasInstance(kind, name, arguments, argumentsLen)) return true;
        if (!self.reserveInstances()) return false;
        MonoInstance* instance = self.instances + self.instancesLen;
        if (decl->kind.tag == DeclKind::Func) instance.kind = MonoInstanceKind::FunctionInstance;
        else instance.kind = MonoInstanceKind::TypeInstance;
        instance.name = name;
        instance.declaration = declaration;
        instance.typeNode = 0;
        instance.returnType = 0;
        instance.paramTypes = null;
        instance.paramTypesLen = 0;
        instance.arguments = self.copyTypes(arguments, argumentsLen);
        instance.argumentsLen = argumentsLen;
        instance.substitutions = self.buildSubstitutions(declaration, arguments, argumentsLen);
        instance.substitutionsLen = self.genericCount(declaration);
        if (decl->kind.tag == DeclKind::Func) instance.body = decl->kind.payload.Func.body;
        else
        {
            NodeId none;
            none.index = 0;
            instance.body = none;
        }
        instance.attributes = decl->attrs;
        instance.attributesLen = decl->attrsLen;
        instance.validationAttempted = 0;
        instance.validated = 0;
        if (decl->kind.tag == DeclKind::Func)
        {
            instance.returnType = self.substituteType(decl->kind.payload.Func.returnType, instance.substitutions, instance.substitutionsLen);
            instance.paramTypesLen = decl->kind.payload.Func.paramsLen;
            if (instance.paramTypesLen > 0)
            {
                instance.paramTypes = (Ty*)calloc((usize)instance.paramTypesLen, @sizeof(Ty));
                if (instance.paramTypes == null)
                {
                    self.errors = self.errors + 1;
                    return false;
                }
                u32 i = 0;
                while (i < instance.paramTypesLen)
                {
                    Node* param = self.nodeAt(decl->kind.payload.Func.params[i]);
                    if (param != null && param->kind.tag == NodeKind::Param)
                        instance.paramTypes[i] = self.substituteType(param->kind.payload.Param.value.typeNode, instance.substitutions, instance.substitutionsLen);
                    i = i + 1;
                }
            }
        }
        else
        {
            TypeKind kind = TypeKind::Named{ .name = name, .genericArgs = instance.arguments, .genericArgsLen = argumentsLen };
            instance.typeNode = self.sema.allocType(kind);
        }
        self.instancesLen = self.instancesLen + 1;
        return true;
    }

    bool validateInstance(MonoInstance* instance)
    {
        instance.validationAttempted = 1;
        u32 errorsBefore = self.sema.errors;
        if (instance.kind == MonoInstanceKind::FunctionInstance)
        {
            if (!self.sema.checkType(instance.returnType)) return false;
            u32 i = 0;
            while (i < instance.paramTypesLen)
            {
                if (!self.sema.checkType(instance.paramTypes[i])) return false;
                i = i + 1;
            }
        }
        else if (!self.sema.checkType(instance.typeNode)) return false;
        if (self.sema.errors == errorsBefore) instance.validated = 1;
        else instance.validated = 0;
        return instance.validated != 0;
    }

    bool run()
    {
        u32 i = 0;
        while (i < self.workLen)
        {
            if (!self.addInstance(self.work[i].declaration, self.work[i].arguments, self.work[i].argumentsLen)) return false;
            MonoInstance* instance = self.instances + self.instancesLen - 1;
            if (!self.validateInstance(instance))
            {
                self.errors = self.errors + 1;
            }
            /* re-collect the instance body with its substitutions active so
             * nested generic calls (`dealloc<T>` inside realloc<cchar>,
             * `alloc<T>` inside Vec<str>) enqueue concrete instances */
            self.activeSubs = instance.substitutions;
            self.activeSubsLen = instance.substitutionsLen;
            if (instance.kind == MonoInstanceKind::FunctionInstance)
            {
                if (instance.body.index != 0) self.collectStmt(instance.body);
            }
            else if (instance.kind == MonoInstanceKind::TypeInstance)
            {
                Node* tdn = self.nodeAt(instance.declaration);
                if (tdn != null && tdn.kind.tag == NodeKind::Decl)
                {
                    Decl* td = &tdn.kind.payload.Decl.value;
                    NodeId* methods = null;
                    u32 methodsLen = 0;
                    if (td->kind.tag == DeclKind::Struct)
                    {
                        methods = td->kind.payload.Struct.methods;
                        methodsLen = td->kind.payload.Struct.methodsLen;
                    }
                    else if (td->kind.tag == DeclKind::Union)
                    {
                        methods = td->kind.payload.Union.methods;
                        methodsLen = td->kind.payload.Union.methodsLen;
                    }
                    else if (td->kind.tag == DeclKind::Variant)
                    {
                        methods = td->kind.payload.Variant.methods;
                        methodsLen = td->kind.payload.Variant.methodsLen;
                    }
                    u32 mi = 0;
                    while (mi < methodsLen)
                    {
                        self.collectDecl(methods[mi]);
                        mi = mi + 1;
                    }
                }
            }
            self.activeSubs = null;
            self.activeSubsLen = 0;
            i = i + 1;
        }
        return self.errors == 0;
    }
}
