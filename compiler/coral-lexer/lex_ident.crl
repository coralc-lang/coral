    if (cp >= 0xA980 && cp <= 0xA9DF) return true; // Javanese
    if (cp >= 0xA9E0 && cp <= 0xA9FF) return true; // Myanmar Extended-B
    if (cp >= 0xAA00 && cp <= 0xAA5F) return true; // Cham
    if (cp >= 0xAA60 && cp <= 0xAA7F) return true; // Myanmar Extended-A
    if (cp >= 0xAA80 && cp <= 0xAADF) return true; // Tai Viet
    if (cp >= 0xAAE0 && cp <= 0xAAFF) return true; // Meetei Mayek Extensions
    if (cp >= 0xAB00 && cp <= 0xAB2F) return true; // Ethiopic Extended-A
    if (cp >= 0xAB30 && cp <= 0xAB6F) return true; // Latin Extended-E
    if (cp >= 0xAB70 && cp <= 0xABBF) return true; // Cherokee Supplement
    if (cp >= 0xABC0 && cp <= 0xABFF) return true; // Meetei Mayek
    if (cp >= 0xAC00 && cp <= 0xD7AF) return true; // Hangul Syllables
    if (cp >= 0xD7B0 && cp <= 0xD7FF) return true; // Hangul Jamo Extended-B
    if (cp >= 0xF900 && cp <= 0xFAFF) return true; // CJK Compatibility Ideographs
    if (cp >= 0xFB00 && cp <= 0xFB4F) return true; // Alphabetic Presentation Forms
    if (cp >= 0xFB50 && cp <= 0xFDFF) return true; // Arabic Presentation Forms-A
    if (cp >= 0xFE00 && cp <= 0xFE0F) return true; // Variation Selectors
    if (cp >= 0xFE10 && cp <= 0xFE1F) return true; // Vertical Forms
    if (cp >= 0xFE20 && cp <= 0xFE2F) return true; // Combining Half Marks
    if (cp >= 0xFE30 && cp <= 0xFE4F) return true; // CJK Compatibility Forms
    if (cp >= 0xFE50 && cp <= 0xFE6F) return true; // Small Form Variants
    if (cp >= 0xFF00 && cp <= 0xFFEF) return true; // Halfwidth and Fullwidth Forms
    if (cp >= 0xFFF0 && cp <= 0xFFFF) return true; // Specials
    if (cp >= 0x10000 && cp <= 0x1007F) return true; // Linear B Syllabary
    if (cp >= 0x10080 && cp <= 0x100FF) return true; // Linear B Ideograms
    if (cp >= 0x10100 && cp <= 0x1013F) return true; // Aegean Numbers
    if (cp >= 0x10140 && cp <= 0x1018F) return true; // Ancient Greek Numbers
    if (cp >= 0x10190 && cp <= 0x101CF) return true; // Ancient Symbols
    if (cp >= 0x101D0 && cp <= 0x101FF) return true; // Phaistos Disc
    if (cp >= 0x10200 && cp <= 0x1027F) return true; // Old Italic
    if (cp >= 0x10280 && cp <= 0x1029F) return true; // Gothic
    if (cp >= 0x102A0 && cp <= 0x102DF) return true; // Old Permic
    if (cp >= 0x10300 && cp <= 0x1032F) return true; // Ugaritic
    if (cp >= 0x10330 && cp <= 0x1034F) return true; // Old Persian
    if (cp >= 0x10350 && cp <= 0x1037F) return true; // Deseret
    if (cp >= 0x10380 && cp <= 0x1039F) return true; // Shavian
