mod lex = import("lexer");
mod S = import("slice");
mod T = import("token");

typedef slice = S.Slice;
typedef TokenKind = T.TokenKind;
typedef Lexer = lex.Lexer;

pub Lexer {
    TokenKind classifyIdentifier(slice* s)
    {
        switch(s->len)
        {
            case 2: {
                if (s.eq("if")) return TokenKind::If;
                break;
            }
            case 3: {
                if (s.eq("use")) return TokenKind::Use;
                if (s.eq("mod")) return TokenKind::Mod;
                if (s.eq("pub")) return TokenKind::Pub;
                if (s.eq("for")) return TokenKind::For;
                if (s.eq("asm")) return TokenKind::Asm;
                if (s.eq("var")) return TokenKind::Var;
                break;
            }
            case 4: {
                if (s.eq("enum")) return TokenKind::Enum;
                if (s.eq("else")) return TokenKind::Else;
                if (s.eq("loop")) return TokenKind::Loop;
                if (s.eq("flag")) return TokenKind::Flag;
                if (s.eq("true")) return TokenKind::True;
                if (s.eq("null")) return TokenKind::Null;
                if (s.eq("self")) return TokenKind::Self;
                break;
            }
            case 5: {
                if (s.eq("while")) return TokenKind::While;
                if (s.eq("trait")) return TokenKind::Trait;
                if (s.eq("const")) return TokenKind::Const;
                if (s.eq("defer")) return TokenKind::Defer;
                if (s.eq("break")) return TokenKind::Break;
                if (s.eq("union")) return TokenKind::Union;
                break;
            }
            case 6: {
                if (s.eq("import")) return TokenKind::Import;
                if (s.eq("static")) return TokenKind::Static;
                if (s.eq("struct")) return TokenKind::Struct;
                if (s.eq("extern")) return TokenKind::Extern;
                if (s.eq("switch")) return TokenKind::Switch;
                if (s.eq("return")) return TokenKind::Return;
                break;
            }
            case 7: {
                if (s.eq("default")) return TokenKind::Default;
                if (s.eq("typedef")) return TokenKind::Typedef;
                break;
            }
            case 8: {
                if (s.eq("distinct")) return TokenKind::Distinct;
                if (s.eq("continue")) return TokenKind::Continue;
                if (s.eq("comptime")) return TokenKind::Comptime;
                if (s.eq("volatile")) return TokenKind::Volatile;
                break;
            }
            default: break;
        }
        return TokenKind::Ident;
    }
}
