mod lex = import("lexer");
mod T = import("token");

typedef TokenKind = T.TokenKind;
typedef Lexer = lex.Lexer;
typedef Token = T.Token;

// UTF-8 decode: returns (codepoint, bytesConsumed)
// returns (0, 0) on error
pub (u32, usize) decodeUtf8(u8* buf, u8* bufEnd)
{
    if (buf >= bufEnd) return (0, 0);
    u8 b0 = buf[0];
    if (b0 < 0x80) return ((u32)b0, 1);
    if (b0 < 0xC0) return (0, 0); // continuation byte, invalid start
    if (b0 < 0xE0)
    {
        if (buf + 1 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        if ((b1 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x1F) << 6) | ((u32)(b1 & 0x3F)), 2);
    }
    if (b0 < 0xF0)
    {
        if (buf + 2 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x0F) << 12) | ((u32)(b1 & 0x3F) << 6) | ((u32)(b2 & 0x3F)), 3);
    }
    if (b0 < 0xF8)
    {
        if (buf + 3 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        u8 b3 = buf[3];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x07) << 18) | ((u32)(b1 & 0x3F) << 12) | ((u32)(b2 & 0x3F) << 6) | ((u32)(b3 & 0x3F)), 4);
    }
    return (0, 0);
}

// XID_Start: check if codepoint can start an identifier
// Covers ASCII letters, underscore, and common Unicode letter scripts
pub bool isXidStart(u32 cp)
{
    if (cp < 128) return (cp >= 'A' && cp <= 'Z') || (cp >= 'a' && cp <= 'z') || cp == '_';
    // Latin, Greek, Cyrillic, Armenian, Hebrew, Arabic
    if (cp >= 0x00C0 && cp <= 0x02FF) return true;
    // Combining Diacritical Marks
    if (cp >= 0x0300 && cp <= 0x036F) return true;
    // Greek and Coptic
    if (cp >= 0x0370 && cp <= 0x03FF) return true;
    // Cyrillic, Cyrillic Supplement
    if (cp >= 0x0400 && cp <= 0x052F) return true;
    // Armenian, Hebrew, Arabic
    if (cp >= 0x0530 && cp <= 0x06FF) return true;
    // Syriac, Thaana
    if (cp >= 0x0700 && cp <= 0x07BF) return true;
    // Devanagari, Bengali, Gurmukhi, Gujarati, Oriya, Tamil, Telugu, Kannada, Malayalam
    if (cp >= 0x0900 && cp <= 0x0D7F) return true;
    // Thai, Lao
    if (cp >= 0x0E00 && cp <= 0x0EFF) return true;
    // Myanmar, Georgian, Hangul Jamo, Ethiopic
    if (cp >= 0x1000 && cp <= 0x137F) return true;
    // Cherokee
    if (cp >= 0x13A0 && cp <= 0x13FF) return true;
    // Unified Canadian Aboriginal Syllabics, Ogham, Runic
    if (cp >= 0x1400 && cp <= 0x16FF) return true;
    // Tagalog, Hanunoo, Buhid, Tagbanwa, Khmer, Mongolian
    if (cp >= 0x1700 && cp <= 0x18AF) return true;
    // Limbu, Tai Le, Tai Lue, Khmer Symbols, Buginese
    if (cp >= 0x1900 && cp <= 0x1A1F) return true;
    // Balinese, Sundanese, Lepcha, Ol Chiki
    if (cp >= 0x1B00 && cp <= 0x1C7F) return true;
    // Phonetic Extensions, Latin Extended Additional, Greek Extended
    if (cp >= 0x1D00 && cp <= 0x1FFF) return true;
    // CJK symbols, Hiragana, Katakana, Bopomofo, Hangul Compatibility Jamo
    if (cp >= 0x2E80 && cp <= 0x31BF) return true;
    // CJK Compatibility, CJK Extension A, Yijing Hexagram, CJK Unified Ideographs
    if (cp >= 0x3200 && cp <= 0x9FFF) return true;
    // Yi Syllables, Lisu, Vai, Cyrillic Extended-B, Latin Extended-D
    if (cp >= 0xA000 && cp <= 0xA7FF) return true;
    // Syloti Nagri, Phags-pa, Saurashtra, Devanagari Extended, Kayah Li, Rejang
    if (cp >= 0xA800 && cp <= 0xA95F) return true;
    // Hangul Jamo Extended-A, Javanese, Myanmar Extended-B, Cham, Myanmar Extended-A
    if (cp >= 0xA960 && cp <= 0xAA7F) return true;
    // Tai Viet, Meetei Mayek, Ethiopic Extended-A, Latin Extended-E, Cherokee Supplement
    if (cp >= 0xAA80 && cp <= 0xABBF) return true;
    // Meetei Mayek, Hangul Syllables, Hangul Jamo Extended-B
    if (cp >= 0xABC0 && cp <= 0xD7FF) return true;
    // CJK Compatibility Ideographs, Alphabetic Presentation Forms, Arabic Presentation Forms-A
    if (cp >= 0xF900 && cp <= 0xFDFF) return true;
    // Variation Selectors, CJK Compatibility Forms, Small Form Variants
    if (cp >= 0xFE30 && cp <= 0xFE6F) return true;
    // Halfwidth and Fullwidth Forms
    if (cp >= 0xFF00 && cp <= 0xFFEF) return true;
    // Linear B, Aegean Numbers, Ancient Greek Numbers, Ancient Symbols, Phaistos Disc
    if (cp >= 0x10000 && cp <= 0x101FF) return true;
    // Old Italic, Gothic, Old Permic, Ugaritic, Old Persian, Deseret, Shavian, Osmanya, Osage
    if (cp >= 0x10200 && cp <= 0x103FF) return true;
    // Elbasan, Caucasian Albanian, Vithkuqi, Old Hungarian, Hanifi Rohingya, Old Sogdian
    if (cp >= 0x10400 && cp <= 0x105BF) return true;
    // Old Uyghur, Tangsa, Cypriot Syllabary, Imperial Aramaic, Palmyrene, Nabataean
    if (cp >= 0x10600 && cp <= 0x108AF) return true;
    // Hatran, Phoenician, Lydian, Meroitic Hieroglyphs, Meroitic Cursive
    if (cp >= 0x108E0 && cp <= 0x109FF) return true;
    // Kharoshthi, Old South Arabian, Old North Arabian, Manichaean, Avestan
    if (cp >= 0x10A00 && cp <= 0x10BAF) return true;
    // Inscriptional Parthian, Old Turkic, Old Hungarian, Hanifi Rohingya
    if (cp >= 0x10C00 && cp <= 0x10D3F) return true;
    // Rumi Numeral Symbols, Yezidi, Old Sogdian, Sogdian, Old Uyghur
    if (cp >= 0x10E60 && cp <= 0x10FAF) return true;
    // Chorasmian, Elymaic, Brahmi, Kaithi, Sora Sompeng, Chakma
    if (cp >= 0x10FB0 && cp <= 0x1117F) return true;
    // Mahajani, Sharada, Khojki, Multani, Khudawadi, Grantha
    if (cp >= 0x11180 && cp <= 0x1137F) return true;
    // Tirhuta, Siddham, Modi, Takri, Ahom, Dogra, Warang Citi
    if (cp >= 0x11380 && cp <= 0x1173F) return true;
    // Masaram Gondi, Nandinagari, Zanabazar Square, Soyombo, Pau Cin Hau
    if (cp >= 0x11800 && cp <= 0x11AAF) return true;
    // Myanmar Extended-A, Mon, Siddham, Bhaiksuki, Marchen
    if (cp >= 0x11AB0 && cp <= 0x11CBF) return true;
    // Masaram Gondi, Gunjala Gondi, Makasar, Lisu, Tamil Supplement
    if (cp >= 0x11D00 && cp <= 0x11EFF) return true;
    // Cuneiform, Cuneiform Numbers and Punctuation
    if (cp >= 0x11F00 && cp <= 0x11FAF) return true;
    return false;
}

// XID_Continue: check if codepoint can continue an identifier
pub bool isXidContinue(u32 cp)
{
    if (isXidStart(cp)) return true;
    if (cp < 128) return cp >= '0' && cp <= '9';
    // Combining Diacritical Marks
    if (cp >= 0x0300 && cp <= 0x036F) return true;
    // Combining Diacritical Marks Extended
    if (cp >= 0x1AB0 && cp <= 0x1AFF) return true;
    // Combining Diacritical Marks Supplement
    if (cp >= 0x1DC0 && cp <= 0x1DFF) return true;
    // Combining Half Marks
    if (cp >= 0xFE20 && cp <= 0xFE2F) return true;
    // Variation Selectors
    if (cp >= 0xFE00 && cp <= 0xFE0F) return true;
    // Vertical Forms
    if (cp >= 0xFE10 && cp <= 0xFE1F) return true;
    // Enclosing Marks
    if (cp >= 0x20DD && cp <= 0x20E0) return true;
    // Other combining marks are scattered; use a simplified check
    return false;
}

pub Lexer {
    Token lexIdentifier(u8* start)
    {
        // first character is already validated as XID_Start by caller
        while (!self.isAtEnd())
        {
            (u32 cp, usize bytes) = decodeUtf8(self.cur, self.bufEnd);
            if (bytes == 0 || !isXidContinue(cp)) break;
            self.cur += bytes;
        }
        usize len = (usize)(self.cur - start);
        IdentifierInfo* ii = self.idents.get(start, len);
        Token t = self.makeToken(ii.kind, start);
        t.info = ii;
        return t;
    }
}
