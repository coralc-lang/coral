mod lex = import("lexer");
mod T = import("token");

typedef TokenKind = T.TokenKind;
typedef Lexer = lex.Lexer;

// UTF-8 decode: returns (codepoint, bytesConsumed)
// returns (0, 0) on error
pub (u32, usize) decodeUtf8(u8* buf, u8* bufEnd)
{
    if (buf >= bufEnd) return (0, 0);
    u8 b0 = buf[0];
    if (b0 < 0x80) return ((u32)b0, 1);
    if (b0 < 0xC0) return (0, 0); // continuation byte, invalid start
    if (b0 < 0xE0)
    {
        if (buf + 1 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        if ((b1 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x1F) << 6) | ((u32)(b1 & 0x3F)), 2);
    }
    if (b0 < 0xF0)
    {
        if (buf + 2 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x0F) << 12) | ((u32)(b1 & 0x3F) << 6) | ((u32)(b2 & 0x3F)), 3);
    }
    if (b0 < 0xF8)
    {
        if (buf + 3 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        u8 b3 = buf[3];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x07) << 18) | ((u32)(b1 & 0x3F) << 12) | ((u32)(b2 & 0x3F) << 6) | ((u32)(b3 & 0x3F)), 4);
    }
    return (0, 0);
}

// XID_Start: check if codepoint can start an identifier
// Simplified set: ASCII letters, underscore, and common Unicode letter ranges
pub bool isXidStart(u32 cp)
{
    if (cp < 128) return (cp >= 'A' && cp <= 'Z') || (cp >= 'a' && cp <= 'z') || cp == '_';
    // Latin Extended-A/B
    if (cp >= 0x00C0 && cp <= 0x024F) return true;
    // Latin Extended Additional
    if (cp >= 0x1E00 && cp <= 0x1EFF) return true;
    // Greek and Coptic
    if (cp >= 0x0370 && cp <= 0x03FF) return true;
    // Cyrillic
    if (cp >= 0x0400 && cp <= 0x04FF) return true;
    // Armenian
    if (cp >= 0x0530 && cp <= 0x058F) return true;
    // Hebrew
    if (cp >= 0x0590 && cp <= 0x05FF) return true;
    // Arabic
    if (cp >= 0x0600 && cp <= 0x06FF) return true;
    // Devanagari
    if (cp >= 0x0900 && cp <= 0x097F) return true;
    // Bengali
    if (cp >= 0x0980 && cp <= 0x09FF) return true;
    // Thai
    if (cp >= 0x0E00 && cp <= 0x0E7F) return true;
    // CJK Unified Ideographs
    if (cp >= 0x4E00 && cp <= 0x9FFF) return true;
    // CJK Extension A
    if (cp >= 0x3400 && cp <= 0x4DBF) return true;
    // CJK Extension B
    if (cp >= 0x20000 && cp <= 0x2A6DF) return true;
    // Hiragana
    if (cp >= 0x3040 && cp <= 0x309F) return true;
    // Katakana
    if (cp >= 0x30A0 && cp <= 0x30FF) return true;
    // Hangul Syllables
    if (cp >= 0xAC00 && cp <= 0xD7AF) return true;
    // Other common scripts
    if (cp >= 0x0100 && cp <= 0x017F) return true; // Latin Extended-A
    if (cp >= 0x0180 && cp <= 0x024F) return true; // Latin Extended-B
    if (cp >= 0x0250 && cp <= 0x02AF) return true; // IPA Extensions
    if (cp >= 0x0300 && cp <= 0x036F) return true; // Combining Diacritical Marks
    if (cp >= 0x0500 && cp <= 0x052F) return true; // Cyrillic Supplement
    if (cp >= 0x0530 && cp <= 0x058F) return true; // Armenian
    if (cp >= 0x0590 && cp <= 0x05FF) return true; // Hebrew
    if (cp >= 0x0600 && cp <= 0x06FF) return true; // Arabic
    if (cp >= 0x0700 && cp <= 0x074F) return true; // Syriac
    if (cp >= 0x0780 && cp <= 0x07BF) return true; // Thaana
    if (cp >= 0x0900 && cp <= 0x097F) return true; // Devanagari
    if (cp >= 0x0980 && cp <= 0x09FF) return true; // Bengali
    if (cp >= 0x0A00 && cp <= 0x0A7F) return true; // Gurmukhi
    if (cp >= 0x0A80 && cp <= 0x0AFF) return true; // Gujarati
    if (cp >= 0x0B00 && cp <= 0x0B7F) return true; // Oriya
    if (cp >= 0x0B80 && cp <= 0x0BFF) return true; // Tamil
    if (cp >= 0x0C00 && cp <= 0x0C7F) return true; // Telugu
    if (cp >= 0x0C80 && cp <= 0x0CFF) return true; // Kannada
    if (cp >= 0x0D00 && cp <= 0x0D7F) return true; // Malayalam
    if (cp >= 0x0E00 && cp <= 0x0E7F) return true; // Thai
    if (cp >= 0x0E80 && cp <= 0x0EFF) return true; // Lao
    if (cp >= 0x1000 && cp <= 0x109F) return true; // Myanmar
    if (cp >= 0x10A0 && cp <= 0x10FF) return true; // Georgian
    if (cp >= 0x1100 && cp <= 0x11FF) return true; // Hangul Jamo
    if (cp >= 0x1200 && cp <= 0x137F) return true; // Ethiopic
    if (cp >= 0x13A0 && cp <= 0x13FF) return true; // Cherokee
    if (cp >= 0x1400 && cp <= 0x167F) return true; // Unified Canadian Aboriginal Syllabics
    if (cp >= 0x1680 && cp <= 0x169F) return true; // Ogham
    if (cp >= 0x16A0 && cp <= 0x16FF) return true; // Runic
    if (cp >= 0x1700 && cp <= 0x171F) return true; // Tagalog
    if (cp >= 0x1720 && cp <= 0x173F) return true; // Hanunoo
    if (cp >= 0x1740 && cp <= 0x175F) return true; // Buhid
    if (cp >= 0x1760 && cp <= 0x177F) return true; // Tagbanwa
    if (cp >= 0x1780 && cp <= 0x17FF) return true; // Khmer
    if (cp >= 0x1800 && cp <= 0x18AF) return true; // Mongolian
    if (cp >= 0x1900 && cp <= 0x194F) return true; // Limbu
    if (cp >= 0x1950 && cp <= 0x197F) return true; // Tai Le
    if (cp >= 0x1980 && cp <= 0x19DF) return true; // Tai Lue
    if (cp >= 0x19E0 && cp <= 0x19FF) return true; // Khmer Symbols
    if (cp >= 0x1A00 && cp <= 0x1A1F) return true; // Buginese
    if (cp >= 0x1B00 && cp <= 0x1B7F) return true; // Balinese
    if (cp >= 0x1B80 && cp <= 0x1BBF) return true; // Sundanese
    if (cp >= 0x1C00 && cp <= 0x1C4F) return true; // Lepcha
    if (cp >= 0x1C50 && cp <= 0x1C7F) return true; // Ol Chiki
    if (cp >= 0x1D00 && cp <= 0x1D7F) return true; // Phonetic Extensions
    if (cp >= 0x1D80 && cp <= 0x1DBF) return true; // Phonetic Extensions Supplement
    if (cp >= 0x1E00 && cp <= 0x1EFF) return true; // Latin Extended Additional
    if (cp >= 0x1F00 && cp <= 0x1FFF) return true; // Greek Extended
    if (cp >= 0x2000 && cp <= 0x206F) return true; // General Punctuation (some)
    if (cp >= 0x2070 && cp <= 0x209F) return true; // Superscripts and Subscripts
    if (cp >= 0x20A0 && cp <= 0x20CF) return true; // Currency Symbols
    if (cp >= 0x20D0 && cp <= 0x20FF) return true; // Combining Diacritical Marks for Symbols
    if (cp >= 0x2100 && cp <= 0x214F) return true; // Letterlike Symbols
    if (cp >= 0x2150 && cp <= 0x218F) return true; // Number Forms
    if (cp >= 0x2190 && cp <= 0x21FF) return true; // Arrows
    if (cp >= 0x2200 && cp <= 0x22FF) return true; // Mathematical Operators
    if (cp >= 0x2300 && cp <= 0x23FF) return true; // Miscellaneous Technical
    if (cp >= 0x2400 && cp <= 0x243F) return true; // Control Pictures
    if (cp >= 0x2440 && cp <= 0x245F) return true; // Optical Character Recognition
    if (cp >= 0x2460 && cp <= 0x24FF) return true; // Enclosed Alphanumerics
    if (cp >= 0x2500 && cp <= 0x257F) return true; // Box Drawing
    if (cp >= 0x2580 && cp <= 0x259F) return true; // Block Elements
    if (cp >= 0x25A0 && cp <= 0x25FF) return true; // Geometric Shapes
    if (cp >= 0x2600 && cp <= 0x26FF) return true; // Miscellaneous Symbols
    if (cp >= 0x2700 && cp <= 0x27BF) return true; // Dingbats
    if (cp >= 0x27C0 && cp <= 0x27EF) return true; // Miscellaneous Mathematical Symbols-A
    if (cp >= 0x27F0 && cp <= 0x27FF) return true; // Supplemental Arrows-A
    if (cp >= 0x2800 && cp <= 0x28FF) return true; // Braille Patterns
    if (cp >= 0x2900 && cp <= 0x297F) return true; // Supplemental Arrows-B
    if (cp >= 0x2980 && cp <= 0x29FF) return true; // Miscellaneous Mathematical Symbols-B
    if (cp >= 0x2A00 && cp <= 0x2AFF) return true; // Supplemental Mathematical Operators
    if (cp >= 0x2B00 && cp <= 0x2BFF) return true; // Miscellaneous Symbols and Arrows
    if (cp >= 0x2C00 && cp <= 0x2C5F) return true; // Glagolitic
    if (cp >= 0x2C60 && cp <= 0x2C7F) return true; // Latin Extended-C
    if (cp >= 0x2C80 && cp <= 0x2CFF) return true; // Coptic
    if (cp >= 0x2D00 && cp <= 0x2D2F) return true; // Georgian Supplement
    if (cp >= 0x2D30 && cp <= 0x2D7F) return true; // Tifinagh
    if (cp >= 0x2D80 && cp <= 0x2DDF) return true; // Ethiopic Extended
    if (cp >= 0x2DE0 && cp <= 0x2DFF) return true; // Cyrillic Extended-A
    if (cp >= 0x2E00 && cp <= 0x2E7F) return true; // Supplemental Punctuation
    if (cp >= 0x2E80 && cp <= 0x2EFF) return true; // CJK Radicals Supplement
    if (cp >= 0x2F00 && cp <= 0x2FDF) return true; // Kangxi Radicals
    if (cp >= 0x2FE0 && cp <= 0x2FEF) return true; // Ideographic Description Characters
    if (cp >= 0x2FF0 && cp <= 0x2FFF) return true; // CJK Symbols and Punctuation
    if (cp >= 0x3000 && cp <= 0x303F) return true; // Hiragana
    if (cp >= 0x3040 && cp <= 0x309F) return true; // Katakana
    if (cp >= 0x30A0 && cp <= 0x30FF) return true; // Bopomofo
    if (cp >= 0x3100 && cp <= 0x312F) return true; // Hangul Compatility Jamo
    if (cp >= 0x3130 && cp <= 0x318F) return true; // Kanbun
    if (cp >= 0x3190 && cp <= 0x319F) return true; // CJK Strokes
    if (cp >= 0x31A0 && cp <= 0x31BF) return true; // Katakana Phonetic Extensions
    if (cp >= 0x31C0 && cp <= 0x31EF) return true; // Enclosed CJK Letters and Months
    if (cp >= 0x31F0 && cp <= 0x31FF) return true; // CJK Compatibility
    if (cp >= 0x3200 && cp <= 0x32FF) return true; // CJK Unified Ideographs Extension A
    if (cp >= 0x3300 && cp <= 0x33FF) return true; // CJK Compatibility Ideographs
    if (cp >= 0x3400 && cp <= 0x4DBF) return true; // CJK Unified Ideographs Extension A
    if (cp >= 0x4DC0 && cp <= 0x4DFF) return true; // Yijing Hexagram Symbols
    if (cp >= 0x4E00 && cp <= 0x9FFF) return true; // CJK Unified Ideographs
    if (cp >= 0xA000 && cp <= 0xA4CF) return true; // Yi Syllables
    if (cp >= 0xA4D0 && cp <= 0xA4FF) return true; // Lisu
    if (cp >= 0xA500 && cp <= 0xA63F) return true; // Vai
    if (cp >= 0xA640 && cp <= 0xA69F) return true; // Cyrillic Extended-B
    if (cp >= 0xA700 && cp <= 0xA71F) return true; // Modifier Tone Letters
    if (cp >= 0xA720 && cp <= 0xA7FF) return true; // Latin Extended-D
    if (cp >= 0xA800 && cp <= 0xA82F) return true; // Syloti Nagri
    if (cp >= 0xA830 && cp <= 0xA83F) return true; // Common Indic Number Forms
    if (cp >= 0xA840 && cp <= 0xA87F) return true; // Phags-pa
