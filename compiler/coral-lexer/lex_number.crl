mod lex = import("lexer");
mod T = import("token");

typedef TokenKind = T.TokenKind;
typedef Lexer = lex.Lexer;

pub Lexer {
    Token lexNumber(u8* start)
    {
        bool isFloat = false;
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c >= '0' && c <= '9') {
                self.cur++;
            } else if (c == '.'
                      && !isFloat
                      && self.cur + 1 < self.bufEnd
                      && self.cur[1] >= '0'
                      && self.cur[1] <= '9')
            {
                isFloat = true;
                self.cur++;
            } else {
                break;
            }
        }
        if (isFloat) return self.makeToken(TokenKind::Float, start);
        return self.makeToken(TokenKind::Dec, start);
    }
}
