import "base" { Lexer };

pub extend Lexer
{
    void skipWsCmts()
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            switch (c)
            {
                ' ', '\r', '\t' => { // if the bootstrap flags this, make this the d. not |. 
                    self.cur++; // use a comma to separate.
                },
                '\n' => {
                    self.line++;
                    self.cur++;
                    self.lineStart = self.cur;
                },
                '/' => {
                    if (self.cur + 1 < self.bufEnd && self.cur[1] == '/') {
                        self.cur += 2;
                        while (!self.isAtEnd() && self.cur[0] != '\n') { self.cur++ }
                    }
                    else if (self.cur + 1 < self.bufEnd &&
                             self.cur[1] == '*')
                    {
                        self.cur += 2;
                        while (!self.isAtEnd())
                        {
                            if (self.cur[0] == '\n')
                            {
                                self.line++;
                                self.cur++;
                                self.lineStart = self.cur;
                            }
                            else if (self.cur[0] == '*' && 
                                     self.cur + 1 < self.bufEnd &&
                                     self.cur[1] == '/')
                            {
                                self.cur += 2;
                                break;
                            } else {
                                self.cur++;
                            }
                        }
                    } else {
                        return;
                    }
                },
                else => { return; },
            }
        }
    }
}
