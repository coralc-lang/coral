pub struct EscapeResult {
    u8 character;
    usize bytesConsumed;
    bool isValid;

    EscapeResult decodeEscapeSequence(u8* ptr, u8* end)
    {
        EscapeResult esc;
        esc.isValid = true;
        esc.bytesConsumed = 2;

        if (ptr >= end || ptr[0] != '\\')
            esc.isValid = false;

        u8 next = ptr[1];
        switch (next)
        {
            case 'n': esc.character = '\n'; break;
            case 'r': esc.character = '\r'; break;
            case 't': esc.character = '\t'; break;
            case '\\': esc.character = '\\'; break;
            case '\'': esc.character = '\''; break;
            case '\"': esc.character = '\"'; break;
            case '0': esc.character = '\0'; break;
            case 'x': 
            {
                if (ptr + 3 >= end)
                {
                    esc.isValid = false;
                    break;
                }
                u8 h1 = ptr[2];
                u8 h2 = ptr[3];

                if (!((h1 >= '0' && h1 <= '9') || (h1 >= 'a' && h1 <= 'f') || (h1 >= 'A' && h1 <= 'F')) ||
                    !((h2 >= '0' && h2 <= '9') || (h2 >= 'a' && h2 <= 'f') || (h2 >= 'A' && h2 <= 'F')))
                {
                    esc.isValid = false;
                    break;
                }

                u8 hi = (h1 >= 'a') ? (h1 - 'a' + 10) : (h1 >= 'A') ? (h1 - 'A' + 10) : (h1 - '0');
                u8 lo = (h2 >= 'a') ? (h2 - 'a' + 10) : (h2 >= 'A') ? (h2 - 'A' + 10) : (h2 - '0');
                esc.character = (u8)((hi << 4) | lo);
                esc.bytesConsumed = 4;
                break;
            }
            default:
            {
                esc.isValid = false;
                esc.character = next;
            }
        }
        return esc;
    }
}