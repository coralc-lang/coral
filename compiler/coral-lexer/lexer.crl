import "../coral-common/token" { Token, TokenKind };
import "ident" { decodeUtf8, isXidStart };
import "escape" { EscapeResult, decodeEscapeSequence };
import "base" { Lexer };
import "skip_ws";
import "number";
import "string";
import "operator";

extend Lexer
{
    Token nextToken()
    {
        self.skipWsCmts();
        u8* start = self.cur;
        if (self.isAtEnd()) return self.makeToken(TokenKind::Eof, start);
        u8 c = self.cur[0];
        self.cur++;
        
        if (c == 'R' && !self.isAtEnd() && self.cur[0] == '"') {
            self.cur++;
            return self.lexRawString(start);
        }
        if ((c == 'u' || c == 'U' || c == 'c') && !self.isAtEnd() && self.cur[0] == '"') {
            self.cur++;
            return self.lexString(start);
        }
        if (c == 'u' && !self.isAtEnd() && self.cur[0] == '8' &&
            self.cur + 1 < self.bufEnd && self.cur[1] == '"')
        {
            self.cur += 2;
            return self.lexString(start);
        }
        if ((c | 0x20) >= 'a' && (c | 0x20) <= 'z' || c == '_')
            return self.lexIdentifier(start);
        if (c >= 0xC0 && c <= 0xFD) {
            usize len;
            u32 cp = decodeUtf8(start, self.bufEnd, &len);
            if (len > 0 && isXidStart(cp))
            {
                self.cur = start + len;
                return self.lexIdentifier(start);
            }
        }
        if (c >= '0' && c <= '9') return self.lexNumber(start);
        if (c == '"') return self.lexString(start);
        if (c == '\'')
        {
            while (!self.isAtEnd() && self.cur[0] != '\'')
            {
                if (self.cur[0] == '\\')
                {
                    EscapeResult esc = EscapeResult::decodeEscapeSequence(self.cur, self.bufEnd);
                    if (!esc.isValid)
                        self.diag.reportError(self.bufStart, self.bufEnd, self.cur, "unknown escape sequence");
                    self.cur += esc.bytesConsumed;
                } else {
                    usize len;
                    u32 cp = decodeUtf8(self.cur, self.bufEnd, &len);
                    if (len > 0) {
                        self.cur += len;
                    } else {
                        self.cur++;
                    }
                }
            }
            if (!self.isAtEnd()) self.cur++;
            return self.makeToken(TokenKind::Char, start);
        }

        Token op = self.lexOperator(c, start);
        if (op.kind != TokenKind::Eof) return op;

        return self.makeToken(TokenKind::Eof, start);
    }
}
