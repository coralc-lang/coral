// escape sequence handling for the coralc compiler frontend.
// it handlues multiple types f excape sequences.

pub struct EscapeResult
{
    u32 codepoint;
    usize bytesConsumed;
    bool isValid;

    static EscapeResult decodeEscapeSequence(u8* ptr, u8* end)
    {
        EscapeResult esc;
        esc.isValid = true;
    esc.bytesConsumed = 2;
    esc.codepoint = 0;

    if (ptr >= end || ptr[0] != '\\') {
        esc.isValid = false;
        return esc;
    }
    if (ptr + 1 >= end) {
        esc.isValid = false;
        return esc;
    }

    u8 next = ptr[1];
    switch (next)
    {
        'n' => { esc.codepoint = '\n'; },
        'r' => { esc.codepoint = '\r'; },
        't' => { esc.codepoint = '\t'; },
        '\\' => { esc.codepoint = '\\'; },
        '\'' => { esc.codepoint = '\''; },
        '"' => { esc.codepoint = '"'; },
        '0' => { esc.codepoint = '\0'; },
        
        'x' => {
            if (ptr + 4 > end) {
                esc.isValid = false; }
            else {
                u8 h1 = ptr[2];
                u8 h2 = ptr[3];

                if (!((h1 >= '0' && h1 <= '9') || ((h1 | 0x20) >= 'a' && (h1 | 0x20) <= 'f')) ||
                    !((h2 >= '0' && h2 <= '9') || ((h2 | 0x20) >= 'a' && (h2 | 0x20) <= 'f'))) {
                    esc.isValid = false; }
                else {
                    u8 hi = (h1 >= 'a') ? (h1 - 'a' + 10) : (h1 >= 'A') ? (h1 - 'A' + 10) : (h1 - '0');
                    u8 lo = (h2 >= 'a') ? (h2 - 'a' + 10) : (h2 >= 'A') ? (h2 - 'A' + 10) : (h2 - '0');
                    esc.codepoint = (u32)((hi << 4) | lo);
                    esc.bytesConsumed = 4;
                }
            }
        },
        
        'u' => {
            if (ptr + 6 > end) {
                esc.isValid = false; }
            else
            {
                u32 cp = 0;
                bool valid = true;
                for (usize i = 0; i < 4; i++)
                {
                    u8 h = ptr[2 + i];
                    u8 val;
                    if (h >= '0' && h <= '9') val = h - '0';
                    else if ((h | 0x20) >= 'a' && (h | 0x20) <= 'f') val = (h | 0x20) - 'a' + 10;
                    else { valid = false; break; }
                    cp = (cp << 4) | val;
                }
                if (!valid) {
                    esc.isValid = false; }
                else
                {
                    esc.codepoint = cp;
                    esc.bytesConsumed = 6;
                }
            }
        },
        
        'U' => {
            if (ptr + 10 > end) {
                esc.isValid = false; }
            else {
                u32 cp = 0;
                bool valid = true;
                for (usize i = 0; i < 8; i++)
                {
                    u8 h = ptr[2 + i];
                    u8 val;
                    if (h >= '0' && h <= '9') val = h - '0';
                    else if ((h | 0x20) >= 'a' && (h | 0x20) <= 'f') val = (h | 0x20) - 'a' + 10;
                    else { valid = false; break; }
                    cp = (cp << 4) | val;
                }
                if (!valid) {
                    esc.isValid = false; }
                else
                {
                    esc.codepoint = cp;
                    esc.bytesConsumed = 10;
                }
            }
        },
        
        else => {
            esc.isValid = false;
            esc.codepoint = next;
        },
    }
    return esc;
}

