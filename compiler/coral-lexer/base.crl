// Base lexer struct for the files implementing the lexer.
// for the coralc compiler front end.

mod slice = import "../coral-common/slice";
import slice { Slice };
mod token = import "../coral-common/token";
import token { Token, TokenKind };
mod diagnostics = import "../coral-diagnostics/code";
import diagnostics { ErrorCode };
mod diagnostic_engine = import "../coral-diagnostics/engine";
import diagnostic_engine { DiagnosticEngine };
mod table = import "table";
import table { IdentifierTable };

pub struct Lexer
{
    DiagnosticEngine* diag;
    IdentifierTable* idents;
    usize line;
    u8* bufStart;
    u8* bufEnd;
    u8* cur;
    u8* lineStart;
    Token token;

    void init(Slice src, DiagnosticEngine* diag, IdentifierTable* idents)
    {
        self.bufStart = src.ptr;
        self.cur = src.ptr;
        self.bufEnd = (u8*)((usize)src.ptr + src.len);
        self.line = 1;
        self.lineStart = src.ptr;
        self.diag = diag;
        self.idents = idents;
    }

    bool isAtEnd() { return self.cur >= self.bufEnd; }

    u8* getCur() { return self.cur; }
    void setCur(u8* c) { self.cur = c; }
    u8* getLineStart() { return self.lineStart; }
    void setLineStart(u8* c) { self.lineStart = c; }
    u32 getLine() { return self.line; }
    void setLine(u32 l) { self.line = l; }
    Token getToken() { return self.token; }
    void setToken(Token t) { self.token = t; }

    void reportError(u8* bufStart, u8* bufEnd, u8* errPtr, u8* msg)
    {
        self.reportErrorCode(ErrorCode::LexInvalidChar, bufStart, bufEnd, errPtr, msg);
    }

    void reportErrorCode(ErrorCode code, u8* bufStart, u8* bufEnd, u8* errPtr, u8* msg)
    {
        if (self.diag != null)
            self.diag.emitLexerError(code, bufStart, bufEnd, errPtr, msg);
    }

    Token makeToken(TokenKind kind, u8* start)
    {
        Token t;
        t.kind = kind;
        t.data.ptr = start;
        t.data.len = (usize)(self.cur - start);
        t.number = 0;
        t.line = self.line;
        t.col = (usize)(start - self.lineStart) + 1;
        t.info = null;
        return t;
    }
}
