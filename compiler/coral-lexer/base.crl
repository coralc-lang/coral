import "slice" { Slice };
import "token" { Token, TokenKind };
import "../coral-diagnostics/engine" { DiagnosticEngine };
import "table" { IdentifierTable };

pub struct Lexer
{
    DiagnosticEngine* diag;
    IdentifierTable* idents;
    usize line;
    u8* bufStart;
    u8* bufEnd;
    u8* cur;
    u8* lineStart;

    void init(Slice src, DiagnosticEngine* diag, IdentifierTable* idents)
    {
        self.bufStart = src.ptr;
        self.cur = src.ptr;
        self.bufEnd = (u8*)((usize)src.ptr + src.len);
        self.line = 1;
        self.lineStart = src.ptr;
        self.diag = diag;
        self.idents = idents;
    }

    bool isAtEnd() { return self.cur >= self.bufEnd; }

    Token makeToken(TokenKind kind, u8* start)
    {
        Token t;
        t.kind = kind;
        t.data.ptr = start;
        t.data.len = (usize)(self.cur - start);
        t.line = self.line;
        t.col = (usize)(start - self.lineStart) + 1;
        t.info = null;
        return t;
    }
}
