mod lex = import("lexer");
mod T = import("token");

typedef TokenKind = T.TokenKind;
typedef Lexer = lex.Lexer;
typedef Token = T.Token;
typedef IdentifierInfo = T.IdentifierInfo;

pub (u32, usize) decodeUtf8(u8* buf, u8* bufEnd)
{
    if (buf >= bufEnd) return (0, 0);
    u8 b0 = buf[0];
    if (b0 < 0x80) return ((u32)b0, 1);
    if (b0 < 0xC0) return (0, 0);
    if (b0 < 0xE0)
    {
        if (buf + 1 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        if ((b1 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x1F) << 6) | ((u32)(b1 & 0x3F)), 2);
    }
    if (b0 < 0xF0)
    {
        if (buf + 2 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x0F) << 12) | ((u32)(b1 & 0x3F) << 6) | ((u32)(b2 & 0x3F)), 3);
    }
    if (b0 < 0xF8)
    {
        if (buf + 3 >= bufEnd) return (0, 0);
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        u8 b3 = buf[3];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80) return (0, 0);
        return (((u32)(b0 & 0x07) << 18) | ((u32)(b1 & 0x3F) << 12) | ((u32)(b2 & 0x3F) << 6) | ((u32)(b3 & 0x3F)), 4);
    }
    return (0, 0);
}

pub bool isXidStart(u32 cp)
{
    if (cp < 128) return (cp | 0x20) >= 'a' && (cp | 0x20) <= 'z' || cp == '_';
    if (cp >= 0x00C0 && cp <= 0x02FF) return true;
    if (cp >= 0x0300 && cp <= 0x036F) return true;
    if (cp >= 0x0370 && cp <= 0x03FF) return true;
    if (cp >= 0x0400 && cp <= 0x052F) return true;
    if (cp >= 0x0530 && cp <= 0x06FF) return true;
    if (cp >= 0x0700 && cp <= 0x07BF) return true;
    if (cp >= 0x0900 && cp <= 0x0D7F) return true;
    if (cp >= 0x0E00 && cp <= 0x0EFF) return true;
    if (cp >= 0x1000 && cp <= 0x137F) return true;
    if (cp >= 0x13A0 && cp <= 0x13FF) return true;
    if (cp >= 0x1400 && cp <= 0x16FF) return true;
    if (cp >= 0x1700 && cp <= 0x18AF) return true;
    if (cp >= 0x1900 && cp <= 0x1A1F) return true;
    if (cp >= 0x1B00 && cp <= 0x1C7F) return true;
    if (cp >= 0x1D00 && cp <= 0x1FFF) return true;
    if (cp >= 0x2E80 && cp <= 0x31BF) return true;
    if (cp >= 0x3200 && cp <= 0x9FFF) return true;
    if (cp >= 0xA000 && cp <= 0xA7FF) return true;
    if (cp >= 0xA800 && cp <= 0xA95F) return true;
    if (cp >= 0xA960 && cp <= 0xAA7F) return true;
    if (cp >= 0xAA80 && cp <= 0xABBF) return true;
    if (cp >= 0xABC0 && cp <= 0xD7FF) return true;
    if (cp >= 0xF900 && cp <= 0xFDFF) return true;
    if (cp >= 0xFE30 && cp <= 0xFE6F) return true;
    if (cp >= 0xFF00 && cp <= 0xFFEF) return true;
    if (cp >= 0x10000 && cp <= 0x101FF) return true;
    if (cp >= 0x10200 && cp <= 0x103FF) return true;
    if (cp >= 0x10400 && cp <= 0x105BF) return true;
    if (cp >= 0x10600 && cp <= 0x108AF) return true;
    if (cp >= 0x108E0 && cp <= 0x109FF) return true;
    if (cp >= 0x10A00 && cp <= 0x10BAF) return true;
    if (cp >= 0x10C00 && cp <= 0x10D3F) return true;
    if (cp >= 0x10E60 && cp <= 0x10FAF) return true;
    if (cp >= 0x10FB0 && cp <= 0x1117F) return true;
    if (cp >= 0x11180 && cp <= 0x1137F) return true;
    if (cp >= 0x11380 && cp <= 0x1173F) return true;
    if (cp >= 0x11800 && cp <= 0x11AAF) return true;
    if (cp >= 0x11AB0 && cp <= 0x11CBF) return true;
    if (cp >= 0x11D00 && cp <= 0x11EFF) return true;
    if (cp >= 0x11F00 && cp <= 0x11FAF) return true;
    return false;
}

pub bool isXidContinue(u32 cp)
{
    if (isXidStart(cp)) return true;
    if (cp < 128) return cp >= '0' && cp <= '9';
    if (cp >= 0x0300 && cp <= 0x036F) return true;
    if (cp >= 0x1AB0 && cp <= 0x1AFF) return true;
    if (cp >= 0x1DC0 && cp <= 0x1DFF) return true;
    if (cp >= 0xFE20 && cp <= 0xFE2F) return true;
    if (cp >= 0xFE00 && cp <= 0xFE0F) return true;
    if (cp >= 0xFE10 && cp <= 0xFE1F) return true;
    if (cp >= 0x20DD && cp <= 0x20E0) return true;
    return false;
}

pub Lexer {
    Token lexIdentifier(u8* start)
    {
        while (!self.isAtEnd())
        {
            (u32 cp, usize bytes) = decodeUtf8(self.cur, self.bufEnd);
            if (bytes == 0 || !isXidContinue(cp)) break;
            self.cur += bytes;
        }
        usize len = (usize)(self.cur - start);
        IdentifierInfo* ii = self.idents.get(start, len);
        Token t = self.makeToken(ii.kind, start);
        t.info = ii;
        return t;
    }
}
