import "token" { TokenKind, Token };
import "lexer_base" { Lexer };

extend Lexer {
    Token lexNumber(u8* start)
    {
        if (!self.isAtEnd() && self.cur[0] == 'x' &&
            (usize)(self.cur - start) == 1 && start[0] == '0')
        {
            self.cur++;
            return self.lexHex(start);
        }
        if (!self.isAtEnd() && self.cur[0] == 'b' &&
            (usize)(self.cur - start) == 1 && start[0] == '0')
        {
            self.cur++;
            return self.lexBinary(start);
        }
        if (!self.isAtEnd() && self.cur[0] == 'o' &&
            (usize)(self.cur - start) == 1 && start[0] == '0')
        {
            self.cur++;
            return self.lexOctal(start);
        }
        return self.lexDecimal(start);
    }

    Token lexHex(u8* start)
    {
        if (self.isAtEnd() || !((self.cur[0] >= '0' && self.cur[0] <= '9') ||
            (self.cur[0] >= 'a' && self.cur[0] <= 'f') ||
            (self.cur[0] >= 'A' && self.cur[0] <= 'F')))
        {
            self.diag.reportError(self.bufStart, self.bufEnd, start, "hex literal has no digits");
            return self.makeToken(TokenKind::Hex, start);
        }
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if ((c >= '0' && c <= '9') ||
                (c >= 'a' && c <= 'f') ||
                (c >= 'A' && c <= 'F') ||
                c == '_')
            {
                self.cur++;
            } else {
                break;
            }
        }
        return self.makeToken(TokenKind::Hex, start);
    }

    Token lexBinary(u8* start)
    {
        if (self.isAtEnd() || (self.cur[0] != '0' && self.cur[0] != '1'))
        {
            self.diag.reportError(self.bufStart, self.bufEnd, start, "binary literal has no digits");
            return self.makeToken(TokenKind::Bin, start);
        }
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c == '0' || c == '1' || c == '_')
            {
                self.cur++;
            } else {
                break;
            }
        }
        return self.makeToken(TokenKind::Bin, start);
    }

    Token lexOctal(u8* start)
    {
        if (self.isAtEnd() || self.cur[0] < '0' || self.cur[0] > '7')
        {
            self.diag.reportError(self.bufStart, self.bufEnd, start, "octal literal has no digits");
            return self.makeToken(TokenKind::Oct, start);
        }
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if ((c >= '0' && c <= '7') || c == '_')
            {
                self.cur++;
            } else {
                break;
            }
        }
        return self.makeToken(TokenKind::Oct, start);
    }

    Token lexDecimal(u8* start)
    {
        bool isFloat = false;
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c >= '0' && c <= '9') {
                self.cur++;
            } else if (c == '.' && !isFloat) {
                if (self.cur + 1 < self.bufEnd && self.cur[1] == '.') {
                    break;
                }
                isFloat = true;
                self.cur++;
            } else if ((c == 'e' || c == 'E') && !isFloat) {
                isFloat = true;
                self.cur++;
                if (!self.isAtEnd() && (self.cur[0] == '+' || self.cur[0] == '-')) {
                    self.cur++;
                }
            } else if (c == '_') {
                self.cur++;
            } else {
                break;
            }
        }
        if (isFloat) return self.makeToken(TokenKind::Float, start);
        return self.makeToken(TokenKind::Dec, start);
    }
}
