mod token = import "../coral-common/token";
mod parser_lib = import "../coral-parser/lib";
mod lexer_mod = import "../coral-lexer/lexer";
mod table = import "../coral-lexer/table";
mod context = import "../coral-context/context";
mod diagnostics = import "../coral-diagnostics/engine";

import token { TokenKind };
import lexer_mod { Lexer };
import table { IdentifierTable, IdentEntry };
import context { AstContext };
import diagnostics { DiagnosticEngine };
import parser_lib { Parser };

extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);
extern("C") i32 printf(u8* fmt, ...);

pub i32 main()
{
    u8* src = "u32 f(u32 value) { return value; }";
    usize len = 0;
    while (src[len] != 0) len = len + 1;
    AstContext ctx;
    ctx.init(4096, 4096, 4096);
    IdentEntry* entries = (IdentEntry*)malloc(256 * sizeof(IdentEntry));
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();
    DiagnosticEngine diag;
    diag.init(src, src + len);
    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = &diag;
    lexer.idents = &idents;
    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;
    p.parseFile(ctx.intern("debug", 5));
    printf("errors=%u nodes=%u\n", p.errorCount(), ctx.nodeCount());
    ctx.deinit();
    free(entries);
    return 0;
}
