/* coral-frontend/debug_parse.crl — temporary parse/analyze harness (delete when done) */

mod analyze_module = import "analyze";
import analyze_module { AnalyzeResult, analyze };

extern("C") i32 printf(u8* fmt, ...);

usize sourceLen(u8* src)
{
    usize n = 0;
    while (src[n] != 0) n = n + 1;
    return n;
}

void tryAnalyze(u8* label, u8* src)
{
    AnalyzeResult r = analyze(src, sourceLen(src));
    printf("[%s] parse=%d semantic=%d mono=%d\n", label, r.parseErrors, r.semanticErrors, r.monoErrors);
}

pub i32 main()
{
    tryAnalyze("extend-scope", "pub struct Box<T> { T value; } pub extend Box<T> { Box<T> make(T a) { return Box<T>{ .value = a }; } }");
    tryAnalyze("toplevel-undeclared-T", "pub struct Box<T> { T value; } Box<T> make(T a) { return Box<T>{ .value = a }; }");
    tryAnalyze("explicit-generic", "pub struct Box<T> { T value; } Box<T> make<T>(T a) { return Box<T>{ .value = a }; }");
    tryAnalyze("nongeneric-alias-T", "pub struct Box<T> { T value; } typedef T = i32; Box<T> make(T a) { return Box<T>{ .value = a }; }");
    tryAnalyze("nongeneric-i32", "pub struct Box<T> { T value; } Box<i32> fill() { return Box<i32>{ .value = 1 }; }");
    return 0;
}
