/* frontend/args.crl — coralc command-line parsing. */

mod slice_mod = import "../coral-common/slice" { Slice };
mod io_mod = import "io" { readCmdline, sliceCStr };

extern("C") i32 printf(u8* fmt, ...);

pub enum Command { Build, Map, Init, Run, Compile }
pub enum Flag { Help, Force, DryRun, MapOnly, Strict, File, Out, Other, EmitHir, Set }

pub struct Options
{
    Command cmd;
    Slice buildFile;
    bool buildFileSet;
    Slice input;
    Slice output;
    bool help;
    bool force;
    bool dryRun;
    bool mapOnly;
    bool strict;
    bool emitHir;
    Slice* flagNames;
    Slice* flagValues;
    u32 flagsCount;
}

bool aEq(Slice a, u8* b, usize bl)
{
    if (a.len != bl) return false;
    usize i = 0;
    while (i < bl) {
        if (a.ptr[i] != b[i]) return false;
        i = i + 1;
    }
    return true;
}

usize nextArg(Slice all, usize pos, Slice* out)
{
    while (pos < all.len && all.ptr[pos] == 0) pos = pos + 1;
    if (pos >= all.len) {
        *out = Slice::from(null, 0);
        return pos;
    }
    usize start = pos;
    while (pos < all.len && all.ptr[pos] != 0) pos = pos + 1;
    *out = Slice::from(all.ptr + start, pos - start);
    return pos;
}

Flag classifyFlag(Slice a)
{
    switch (a.len)
    {
        2 => {
            if (aEq(a, "-h", 2)) return Flag::Help;
            if (aEq(a, "-f", 2)) return Flag::File;
            if (aEq(a, "-o", 2)) return Flag::Out;
        },
        6 => { if (aEq(a, "--help", 6)) return Flag::Help; if (aEq(a, "--flag", 6)) return Flag::Set; },
        7 => { if (aEq(a, "--force", 7)) return Flag::Force; },
            8 => { if (aEq(a, "--strict", 8)) return Flag::Strict; },
        9 => { if (aEq(a, "--dry-run", 9)) return Flag::DryRun; },
        10 => { if (aEq(a, "--map-only", 10)) return Flag::MapOnly; if (aEq(a, "--emit-hir", 10)) return Flag::EmitHir; },
        else => {}
    }
    return Flag::Other;
}

pub void usage()
{
    printf("coral <command> [options]\n");
    printf("commands:\n");
    printf("  build   build the project (default)\n");
    printf("  map     discover lib.crl folders, update the build file\n");
    printf("  init    scaffold a new build file\n");
    printf("  run     build, then run the output\n");
    printf("  <file.crl>  compile a single file\n");
    printf("options:\n");
    printf("  -f <file>     build file (default coral.crlb, fallback build.crlb)\n");
    printf("  -o <file>     output file (single-file compile)\n");
    printf("  --force       rebuild everything\n");
    printf("  --map-only    write modules.map only\n");
    printf("  --dry-run     compile without producing output\n");
    printf("  --strict      reject unknown build-file fields\n");
    printf("  -h, --help    show this help\n");
}

pub bool parseArgs(Options* opts)
{
    opts->cmd = Command::Build;
    opts->buildFile = Slice::from("coral.crlb", 10);
    opts->buildFileSet = false;
    opts->input = Slice::from(null, 0);
    opts->output = Slice::from(null, 0);
    opts->help = false;
    opts->force = false;
    opts->dryRun = false;
    opts->mapOnly = false;
    opts->strict = false;
    opts->emitHir = false;
    opts->flagsCount = 0;
    opts->flagNames = null;
    opts->flagValues = null;

    Slice argv = readCmdline();
    if (argv.ptr == null) return false;
    usize pos = 0;
    Slice tok;
    pos = nextArg(argv, pos, &tok);
    if (tok.len == 0) return false;

    bool haveCmd = false;
    while (true)
    {
        pos = nextArg(argv, pos, &tok);
        if (tok.len == 0) break;
        Flag f = classifyFlag(tok);
        switch (f)
        {
            Flag::Help => { opts->help = true; return true; },
            Flag::Force => { opts->force = true; continue; },
            Flag::DryRun => { opts->dryRun = true; continue; },
            Flag::MapOnly => { opts->mapOnly = true; continue; },
            Flag::Strict => { opts->strict = true; continue; },
            Flag::EmitHir => { opts->emitHir = true; continue; },
            Flag::Set => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf("coral: --flag needs NAME=VALUE\n");
                    return false;
                }
                usize eq = 0;
                u32 k = 0;
                while (k < val.len)
                {
                    if (val.ptr[k] == 61) { eq = 1; break; }
                    k = k + 1;
                }
                if (eq)
                {
                    if (opts->flagsCount < 32)
                    {
                        if (opts->flagNames == null)
                        {
                            opts->flagNames = (Slice*)malloc(32 * sizeof(Slice));
                            opts->flagValues = (Slice*)malloc(32 * sizeof(Slice));
                        }
                        if (opts->flagNames != null)
                        {
                            opts->flagNames[opts->flagsCount] = Slice::from(val.ptr, k);
                            opts->flagValues[opts->flagsCount] = Slice::from(val.ptr + k + 1, val.len - k - 1);
                            opts->flagsCount = opts->flagsCount + 1;
                        }
                    }
                }
                continue;
            },
            Flag::File => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf("coral: -f needs a file path\n");
                    return false;
                }
                opts->buildFile = val;
                opts->buildFileSet = true;
                continue;
            },
            Flag::Out => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf("coral: -o needs a file path\n");
                    return false;
                }
                opts->output = val;
                continue;
            },
            
            Flag::Other => {},
            else => { return false; }
        }

        if (tok.ptr[0] == 45) {
            printf("coral: unknown flag: %s\n", sliceCStr(tok));
            return false;
        }
        if (haveCmd) {
            printf("coral: unexpected argument: %s\n", sliceCStr(tok));
            return false;
        }
        haveCmd = true;
        bool known = false;
        switch (tok.len) {
            3 => {
                if (aEq(tok, "map", 3)) { opts->cmd = Command::Map; known = true; }
                if (aEq(tok, "run", 3)) { opts->cmd = Command::Run; known = true; }
            },
            4 => { if (aEq(tok, "init", 4)) { opts->cmd = Command::Init; known = true; } },
            5 => { if (aEq(tok, "build", 5)) { opts->cmd = Command::Build; known = true; } },
            else => {},
        }
        if (!known) {
            usize i = tok.len;
            if (i >= 4 && tok.ptr[i - 4] == 46 && tok.ptr[i - 3] == 99 && tok.ptr[i - 2] == 114 && tok.ptr[i - 1] == 108) {
                opts->cmd = Command::Compile;
                opts->input = tok;
                known = true;
            }
        }
        if (!known) {
            printf("coral: unknown command: %s\n", sliceCStr(tok));
            return false;
        }
    }
    return true;
}