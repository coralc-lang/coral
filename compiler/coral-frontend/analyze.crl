extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

pub struct AnalyzeResult
{
    u32 parseErrors;
    u32 semanticErrors;
    u32 monoErrors;
    u32 instances;
    u32 nodes;
}

AnalyzeResult analyze(u8* src, usize len)
{
    AnalyzeResult result;
    result.parseErrors = 0;
    result.semanticErrors = 0;
    result.monoErrors = 0;
    result.instances = 0;
    result.nodes = 0;
    AstContext ctx;
    ctx.init(4096, 4096, 4096);
    IdentEntry* entries = (IdentEntry*)malloc(256 * sizeof(IdentEntry));
    if (entries == null)
    {
        result.parseErrors = 1;
        ctx.deinit();
        return result;
    }
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();
    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;
    Parser parser;
    parser.lexer = &lexer;
    parser.ctx = &ctx;
    parser.panicMode = 0;
    parser.pendingGreater = false;
    parser.current = lexer.nextToken();
    parser.previous = parser.current;
    File* file = parser.parseFile(ctx.intern("frontend", 8));
     Sema sema;
     sema.init(&ctx);
     sema.checkFile(file);
     MonoContext mono;
     mono.init(&ctx, &sema);
     mono.collectFile(file);
     mono.run();
     result.parseErrors = parser.errorCount();
     result.semanticErrors = sema.errors;
     result.monoErrors = mono.errors;
     result.instances = mono.instancesLen;
     result.nodes = ctx.nodeCount();
     mono.deinit();
     sema.deinit();
    ctx.deinit();
    free(entries);
    return result;
}
