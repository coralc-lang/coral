extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

pub struct AnalyzeResult
{
    u32 parseErrors;
    u32 semanticErrors;
    u32 monoErrors;
    u32 instances;
    u32 nodes;
}

/* Like analyze(), but keeps the AST alive for a backend: the context is
 * heap-allocated and outlives this call. Free with freeUnit().
 * sema/mono are kept too — the backend reads monomorphisation instances. */
pub struct CompileUnit
{
    AstContext* ctx;
    File* file;
    Sema* sema;
    MonoContext* mono;
    u32 parseErrors;
    u32 semanticErrors;
    u32 monoErrors;
}

pub void freeUnit(CompileUnit* unit)
{
    if (unit.mono != null) {
        unit.mono.deinit();
        free(unit.mono);
        unit.mono = null;
    }
    if (unit.sema != null) {
        unit.sema.deinit();
        free(unit.sema);
        unit.sema = null;
    }
    if (unit.ctx != null) {
        unit.ctx.deinit();
        free(unit.ctx);
        unit.ctx = null;
        unit.file = null;
    }
}

CompileUnit analyzeForCompile(u8* src, usize len, u8* path)
{
    CompileUnit unit = CompileUnit {
        .ctx = null,
        .file = null,
        .sema = null,
        .mono = null,
        .parseErrors = 0,
        .semanticErrors = 0,
        .monoErrors = 0,
    };

    AstContext* ctx = (AstContext*)malloc(sizeof(AstContext));
    if (ctx == null) {
        unit.parseErrors = 1;
        return unit;
    }
    ctx.init(4096, 4096, 4096);

    IdentEntry* entries = (IdentEntry*)malloc(256 * sizeof(IdentEntry));
    if (entries == null) {
        unit.parseErrors = 1;
        ctx.deinit();
        free(ctx);
        return unit;
    }

    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();

    DiagnosticEngine engine;
    engine.init(src, src + len);

    Lexer lexer = Lexer {
        .bufStart = src,
        .cur = src,
        .bufEnd = src + len,
        .line = 1,
        .lineStart = src,
        .diag = &engine,
        .idents = &idents,
    };

    Parser parser = Parser {
        .lexer = &lexer,
        .ctx = ctx,
        .panicMode = 0,
        .pendingGreater = false,
        .current = lexer.nextToken(),
    };
    parser.previous = parser.current;

    /* real file path so the backend can mangle module paths from it */
    Str pathStr = ctx.intern((u8*)"main", 4);
    if (path != null) {
        usize plen = 0;
        while (path[plen] != 0) plen = plen + 1;
        if (plen > 0) pathStr = ctx.intern(path, plen);
    }
    File* file = parser.parseFile(pathStr);
    unit.parseErrors = parser.errorCount();
    if (file == null && unit.parseErrors == 0) unit.parseErrors = 1;

    if (file != null) {
        Sema* sema = (Sema*)malloc(sizeof(Sema));
        MonoContext* mono = (MonoContext*)malloc(sizeof(MonoContext));
        if (sema == null || mono == null) {
            unit.parseErrors = unit.parseErrors + 1;
            if (sema != null) free(sema);
            if (mono != null) free(mono);
        } else {
            sema.init(ctx, &engine);
            sema.checkFile(file);

            mono.init(ctx, sema);
            mono.collectFile(file);
            mono.run();

            unit.semanticErrors = sema.errors;
            unit.monoErrors = mono.errors;
            unit.sema = sema;
            unit.mono = mono;
        }
    }

    free(entries);

    if (unit.parseErrors > 0 || unit.semanticErrors > 0 || unit.monoErrors > 0) {
        freeUnit(&unit);            /* sema + mono (unit.ctx not set yet) */
        ctx.deinit();
        free(ctx);
        return unit;
    }

    unit.ctx = ctx;
    unit.file = file;
    return unit;
}

AnalyzeResult analyze(u8* src, usize len)
{
    AnalyzeResult result = AnalyzeResult{
        .parseErrors = 0,
        .semanticErrors = 0,
        .monoErrors = 0,
        .instances = 0,
        .nodes = 0,
    };
    
    AstContext ctx;
    ctx.init(4096, 4096, 4096);
    
    IdentEntry* entries = (IdentEntry*)malloc(256 * sizeof(IdentEntry));
    if (entries == null) {
        result.parseErrors = 1;
        ctx.deinit();
        return result;
    }
    
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();

    DiagnosticEngine engine;
    engine.init(src, src + len);

    Lexer lexer = Lexer {
        .bufStart = src,
        .cur = src,
        .bufEnd = src + len,
        .line = 1,
        .lineStart = src,
        .diag = &engine,
        .idents = &idents,
    };
    
    Parser parser = Parser {
        .lexer = &lexer,
        .ctx = &ctx,
        .panicMode = 0,
        .pendingGreater = false,
        .current = lexer.nextToken(),
    };
    parser.previous = parser.current;
    
    File* file = parser.parseFile(ctx.intern("frontend", 8));
    Sema sema;
    sema.init(&ctx, &engine);
    sema.checkFile(file);
    
    MonoContext mono;
    mono.init(&ctx, &sema);
    mono.collectFile(file);
    mono.run();

    result = AnalyzeResult {
        .parseErrors = parser.errorCount(),
        .semanticErrors = sema.errors,
        .monoErrors = mono.errors,
        .instances = mono.instancesLen,
        .nodes = ctx.nodeCount(),
    };

    mono.deinit();
    sema.deinit();
    ctx.deinit();
    free(entries);
    return result;
}
