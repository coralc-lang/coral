extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

pub struct AnalyzeResult
{
    u32 parseErrors;
    u32 semanticErrors;
    u32 monoErrors;
    u32 instances;
    u32 nodes;
}

AnalyzeResult analyze(u8* src, usize len)
{
    AnalyzeResult result = AnalyzeResult{
        .parseErrors = 0,
        .semanticErrors = 0,
        .monoErrors = 0,
        .instances = 0,
        .nodes = 0,
    };
    
    AstContext ctx;
    ctx.init(4096, 4096, 4096);
    
    IdentEntry* entries = (IdentEntry*)malloc(256 * sizeof(IdentEntry));
    if (entries == null) {
        result.parseErrors = 1;
        ctx.deinit();
        return result;
    }
    
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();
    
    Lexer lexer = Lexer {
        .bufStart = src,
        .cur = src,
        .bufEnd = src + len,
        .line = 1,
        .lineStart = src,
        .diag = null,
        .idents = &idents,
    };
    
    Parser parser = Parser {
        .lexer = &lexer,
        .ctx = &ctx,
        .panicMode = 0,
        .pendingGreater = false,
        .current = lexer.nextToken(),
    };
    parser.previous = parser.current;
    
    File* file = parser.parseFile(ctx.intern("frontend", 8));
    Sema sema;
    sema.init(&ctx);
    sema.checkFile(file);
    
    MonoContext mono;
    mono.init(&ctx, &sema);
    mono.collectFile(file);
    mono.run();

    result = AnalyzeResult {
        .parseErrors = parser.errorCount(),
        .semanticErrors = sema.errors,
        .monoErrors = mono.errors,
        .instances = mono.instancesLen,
        .nodes = ctx.nodeCount(),
    };

    mono.deinit();
    sema.deinit();
    ctx.deinit();
    free(entries);
    return result;
}
