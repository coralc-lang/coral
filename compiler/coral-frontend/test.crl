/* frontend/test.crl — parser test harness
 *
 * Exercises the self-host Coral parser on examples,
 * itself, and stdlib files. Reports token and node counts.
 */

import "../coral-common/slice" { Slice };
import "../coral-common/token" { Token, TokenKind };
import "../coral-lexer/lexer" { Lexer };
import "../coral-lexer/table" { IdentifierTable };
import "../coral-diagnostics/engine" { DiagnosticEngine };
import "../coral-parser/parser" { Parser };

extern("C") i32 printf(u8* fmt, ...);

pub struct TestResult
{
    u32 tokens;
    u32 nodes;
    u32 errors;
}

extend TestResult
{
    void print()
    {
        printf("tokens=%u nodes=%u errors=%u\n", self.tokens, self.nodes, self.errors);
    }
}

TestResult runParser(u8* src, usize len)
{
    Slice s;
    s.ptr = src;
    s.len = len;

    IdentifierTable table;
    DiagnosticEngine diag;
    diag.errors = 0;
    diag.warnings = 0;
    diag.errorLimit = 20;
    diag.bufStart = src;
    diag.bufEnd = src + len;

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = &diag;

    Parser p;
    p.lexer = &lexer;
    p.panicMode = 0;
    p.nodeCount = 0;
    Lexer_nextToken(&lexer);
    p.current = lexer.token;
    p.previous = lexer.token;

    u32 tokCount = 0;
    while (!p.atEnd())
    {
        p.advance();
        tokCount = tokCount + 1;
        if (tokCount > 100000) break;
    }

    TestResult r;
    r.tokens = tokCount;
    r.nodes = p.nodeCount;
    r.errors = diag.errors;
    return r;
}

void testExpr()
{
    u8* src = "a + b * (c - d);";
    printf("expr test: ");
    TestResult r = runParser(src, 18);
    r.print();
}

void testFunc()
{
    u8* src = "pub i32 add(u32 a, u32 b) { return a + b; }";
    printf("func test: ");
    TestResult r = runParser(src, 46);
    r.print();
}

void testVariant()
{
    u8* src = "pub variant Option { Some { u32 value }, None }";
    printf("variant test: ");
    TestResult r = runParser(src, 47);
    r.print();
}

void testSwitch()
{
    u8* src = "switch (x) { A => { 1 }, else => { 0 } }";
    printf("switch test: ");
    TestResult r = runParser(src, 41);
    r.print();
}

void testFlag()
{
    u8* src = "flag(PLATFORM) { linux => { a; }, else => { b; } }";
    printf("flag test: ");
    TestResult r = runParser(src, 49);
    r.print();
}

void testImport()
{
    u8* src = "import \"path\" { foo, bar as baz };";
    printf("import path test: ");
    TestResult r = runParser(src, 36);
    r.print();
}

void testImportRoot()
{
    u8* src = "import file::math::core { square };";
    printf("import root test: ");
    TestResult r = runParser(src, 39);
    r.print();
}

void testImportLib()
{
    u8* src = "import(lib) std::math { pow };";
    printf("import lib test: ");
    TestResult r = runParser(src, 32);
    r.print();
}

void testModReexport()
{
    u8* src = "pub mod m = import \"path\";";
    printf("mod reexport test: ");
    TestResult r = runParser(src, 27);
    r.print();
}

void testAttr()
{
    u8* src = "[[packed]] pub struct Foo { u32 x; }";
    printf("attr test: ");
    TestResult r = runParser(src, 36);
    r.print();
}

pub i32 main()
{
    printf("=== coral parser self-test ===\n");
    testExpr();
    testFunc();
    testVariant();
    testSwitch();
    testFlag();
    testImport();
    testAttr();
    printf("=== done ===\n");
}
