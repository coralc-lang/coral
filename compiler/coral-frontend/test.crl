/* frontend/test.crl — parser test harness
 *
 * Exercises the self-host lexer, parser, context, modules, and Sema
 * on focused source snippets. Reports item and node counts.
 */

import "../coral-common/token" { Token, TokenKind, IdentifierInfo };
import "../coral-lexer/lexer" { Lexer };
import "../coral-lexer/ident" { isXidStart, isXidContinue };
import "../coral-lexer/table" { IdentifierTable, IdentEntry };
import "../coral-context/context" { AstContext };
import "../coral-ast/id" { NodeId };
import "../coral-module/module" { ModuleMap, ModuleId };
import "../coral-semantics/scope" { ScopeStack, Symbol };
import "../coral-semantics/sema" { Sema };
import "../coral-semantics/decl";
import "../coral-semantics/expr";
import "../coral-semantics/stmt";
import "../coral-semantics/typecheck";
import "../coral-semantics/member" { MemberInfo };
import "analyze" { AnalyzeResult, analyze };
import "../coral-ast/decl" { File };
import "../coral-parser/lib" { Parser };

extern("C") i32 printf(u8* fmt, ...);
extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

usize sourceLen(u8* src)
{
    usize len = 0;
    while (src[len] != 0)
    {
        len = len + 1;
    }
    return len;
}

pub struct TestResult
{
    u32 items;
    u32 nodes;
    u32 errors;
}

extend TestResult
{
    void print()
    {
        printf("items=%u nodes=%u errors=%u\n", self.items, self.nodes, self.errors);
    }
}

TestResult runParser(u8* src, usize len)
{
    AstContext ctx;
    ctx.init(4096, 4096, 4096);

    IdentEntry* identEntries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(identEntries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;

    File* file = p.parseFile(ctx.intern("test", 4));
    u32 decls = 0;
    if (file != null) decls = file*.declsLen;

    TestResult r;
    r.items = decls;
    r.nodes = ctx.nodeCount();
    r.errors = p.panicMode;
    ctx.deinit();
    free(identEntries);
    return r;
}

TestResult runExpr(u8* src, usize len)
{
    AstContext ctx;
    ctx.init(4096, 4096, 4096);

    IdentEntry* identEntries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(identEntries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;

    p.parseExpr();

    TestResult r;
    r.items = 1;
    r.nodes = ctx.nodeCount();
    r.errors = p.panicMode;
    ctx.deinit();
    free(identEntries);
    return r;
}

bool runSema(u8* src, usize len)
{
    AnalyzeResult result = analyze(src, len);
    bool ok = result.parseErrors == 0 && result.semanticErrors == 0 && result.monoErrors == 0;
    printf("sema check: ok=%u parse_errors=%u semantic_errors=%u mono_errors=%u instances=%u\n", ok ? 1 : 0, result.parseErrors, result.semanticErrors, result.monoErrors, result.instances);
    return ok;
}

bool testLexer()
{
    u8* src = "if x { return 1; }";
    IdentEntry* entries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + sourceLen(src);
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    u32 count = 0;
    while (lexer.cur < lexer.bufEnd)
    {
        Token tok = lexer.nextToken();
        if (tok.kind == TokenKind::Eof) break;
        count = count + 1;
    }
    IdentifierInfo* switchInfo = idents.get("switch", 6);
    printf("lexer test: tokens=%u switch_keyword=%u\n", count, switchInfo != null && switchInfo*.isKeyword ? 1 : 0);
    free(entries);
    return true;
}

bool testNumberTokens()
{
    u8* src = "0xFF 0b1010 0o77";
    IdentEntry* entries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(entries, 256);
    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + sourceLen(src);
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;
    Token hex = lexer.nextToken();
    Token binary = lexer.nextToken();
    Token octal = lexer.nextToken();
    bool ok = hex.kind == TokenKind::Hex && hex.data.len == 2 && hex.data.ptr[0] == 'F';
    ok = ok && binary.kind == TokenKind::Bin && binary.data.len == 4 && binary.data.ptr[0] == '1';
    ok = ok && octal.kind == TokenKind::Oct && octal.data.len == 2 && octal.data.ptr[0] == '7';
    printf("number token test: ok=%u\n", ok ? 1 : 0);
    free(entries);
    return ok;
}

bool testCharLiteral()
{
    u8* src = "'a'";
    printf("char literal test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
    return r.errors == 0;
}

bool testCharTokens()
{
    u8* src = "char 'a'";
    IdentEntry* entries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();
    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + sourceLen(src);
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;
    Token typeToken = lexer.nextToken();
    Token literalToken = lexer.nextToken();
    bool ok = typeToken.kind == TokenKind::Char && literalToken.kind == TokenKind::CharLit;
    printf("char token test: ok=%u\n", ok ? 1 : 0);
    free(entries);
    return ok;
}

bool testIdentifierRanges()
{
    bool ok = isXidStart(0x00C0) && isXidStart(0x06FF) && isXidStart(0x0700);
    ok = ok && !isXidStart(0x07C0) && !isXidStart(0x1380);
    ok = ok && isXidStart(0x13A0) && isXidStart(0x18AF) && !isXidStart(0x18B0);
    ok = ok && isXidStart(0xA7FF) && isXidStart(0xA800) && isXidStart(0xD7FF);
    ok = ok && !isXidStart(0xD800) && isXidStart(0x105BF) && !isXidStart(0x105C0);
    ok = ok && isXidContinue('0') && isXidContinue(0x0300) && !isXidContinue('.');
    printf("identifier ranges test: ok=%u\n", ok ? 1 : 0);
    return ok;
}

bool testContext()
{
    AstContext ctx;
    ctx.init(8, 8, 8);
    Str first = ctx.intern("same", 4);
    Str second = ctx.intern("same", 4);
    printf("context test: interned=%u same=%u\n", ctx.internsLen, first == second ? 1 : 0);
    ctx.deinit();
    return true;
}

bool testModuleMap()
{
    AstContext ctx;
    ctx.init(8, 8, 8);
    ModuleMap map;
    map.init(4);
    Str path = ctx.intern("std/math", 8);
    Str manifest = ctx.intern("std", 3);
    ModuleId first = map.add(path, manifest, 2);
    ModuleId second = map.resolvePath(path);
    ModuleId missing = map.resolveLib(ctx.intern("other", 5));
    printf("module map test: first=%u second=%u missing=%u\n", first.index, second.index, missing.index);
    map.deinit();
    ctx.deinit();
    return true;
}

bool testScopes()
{
    AstContext ctx;
    ctx.init(8, 8, 8);
    Str x = ctx.intern("x", 1);
    Str y = ctx.intern("y", 1);
    Str missing = ctx.intern("missing", 7);
    NodeId none;
    none.index = 0;

    ScopeStack scopes;
    scopes.init(4);
    bool ok = scopes.enter();
    ok = ok && scopes.declare(x, 1, 0, none, 2);
    ok = ok && !scopes.declare(x, 1, 0, none, 2);
    ok = ok && scopes.assign(x, none);
    ok = ok && scopes.enter();
    ok = ok && scopes.declare(x, 1, 0, none, 2);
    Symbol* shadow = scopes.lookup(x);
    ok = ok && shadow != null;
    ok = ok && scopes.leave();
    ok = ok && scopes.lookup(x) != null;
    ok = ok && scopes.declare(y, 1, 0, none, 1);
    ok = ok && !scopes.assign(y, none);
    ok = ok && !scopes.assign(missing, none);
    ok = ok && scopes.errorCount() == 3;
    printf("scope test: ok=%u errors=%u\n", ok ? 1 : 0, scopes.errorCount());
    scopes.leave();
    scopes.deinit();
    ctx.deinit();
    return ok;
}

bool testSema()
{
    u8* valid = "u32 f(u32 value) { return value; }";
    u8* callValid = "u32 add(u32 a, u32 b) { return a + b; } u32 f() { return add(1, 2); }";
    u8* duplicate = "u32 value; u32 value;";
    u8* unknown = "u32 f() { return missing; }";
    u8* constAssign = "u32 f() { const u32 value = 1; value = 2; return value; }";
    u8* typeMismatch = "u32 f() { u32 value = 1; value = \"text\"; return value; }";
    u8* arityMismatch = "u32 add(u32 a, u32 b) { return a + b; } u32 f() { return add(1); }";
    u8* genericValid = "pub struct Box<T> { T value; } Box<T> make(comptime T) { return Box<T>{ .value = 1 }; }";
    u8* genericArity = "pub struct Box<T> { T value; } Box<u32, i32> make() { return null; }";
    u8* comptimeValid = "void println(comptime T) { }";
    u8* enumValid = "pub enum Color { Red, Green }";
    bool validOk = runSema(valid, sourceLen(valid));
    bool callValidOk = runSema(callValid, sourceLen(callValid));
    bool duplicateRejected = !runSema(duplicate, sourceLen(duplicate));
    bool unknownRejected = !runSema(unknown, sourceLen(unknown));
    bool constRejected = !runSema(constAssign, sourceLen(constAssign));
    bool typeMismatchRejected = !runSema(typeMismatch, sourceLen(typeMismatch));
    bool arityRejected = !runSema(arityMismatch, sourceLen(arityMismatch));
    bool genericValidOk = runSema(genericValid, sourceLen(genericValid));
    bool genericArityRejected = !runSema(genericArity, sourceLen(genericArity));
    bool comptimeOk = runSema(comptimeValid, sourceLen(comptimeValid));
    bool enumOk = runSema(enumValid, sourceLen(enumValid));
    printf("semantic declaration test: valid=%u call_valid=%u duplicate=%u unknown=%u const_assign=%u type_mismatch=%u arity=%u generic_valid=%u generic_arity=%u comptime=%u enum=%u\n", validOk ? 1 : 0, callValidOk ? 1 : 0, duplicateRejected ? 1 : 0, unknownRejected ? 1 : 0, constRejected ? 1 : 0, typeMismatchRejected ? 1 : 0, arityRejected ? 1 : 0, genericValidOk ? 1 : 0, genericArityRejected ? 1 : 0, comptimeOk ? 1 : 0, enumOk ? 1 : 0);
    return validOk && callValidOk && duplicateRejected && unknownRejected && constRejected && typeMismatchRejected && arityRejected && genericValidOk && genericArityRejected && comptimeOk && enumOk;
}

bool testMono()
{
    u8* src = "pub struct Box<T> { T value; } T make(comptime T) { return null; } Box<u32> use() { return null; }";
    AnalyzeResult result = analyze(src, sourceLen(src));
    bool ok = result.parseErrors == 0 && result.semanticErrors == 0 && result.monoErrors == 0 && result.instances >= 2;
    printf("mono test: ok=%u parse=%u semantic=%u instances=%u errors=%u\n", ok ? 1 : 0, result.parseErrors, result.semanticErrors, result.instances, result.monoErrors);
    return ok;
}

bool testExpr()
{
    u8* src = "a + b * (c - d);";
    printf("expr test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
    return r.errors == 0;
}

bool testMemberSemantics()
{
    u8* valid = "pub struct Point { u32 x; u32 y; } u32 get() { Point p = Point { .x = 1, .y = 2 }; return p.x; }";
    u8* invalid = "pub struct Point { u32 x; u32 y; } u32 get() { Point p = Point { .x = 1, .y = 2 }; return p.z; }";
    u8* method = "pub struct Counter { u32 value; u32 get() { return 1; } } u32 read() { Counter c = Counter { .value = 1 }; return c.get(); }";
    bool validOk = runSema(valid, sourceLen(valid));
    bool invalidRejected = !runSema(invalid, sourceLen(invalid));
    bool methodOk = runSema(method, sourceLen(method));
    printf("member semantic test: valid=%u invalid=%u method=%u\n", validOk ? 1 : 0, invalidRejected ? 1 : 0, methodOk ? 1 : 0);
    return validOk && invalidRejected && methodOk;
}

