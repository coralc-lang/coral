/* frontend/test.crl — parser test harness
 *
 * Exercises the self-host Coral parser on examples,
 * itself, and stdlib files. Reports token and node counts.
 */

import "../coral-common/token" { Token, TokenKind, IdentifierInfo };
import "../coral-lexer/lexer" { Lexer };
import "../coral-lexer/ident" { isXidStart, isXidContinue };
import "../coral-lexer/table" { IdentifierTable, IdentEntry };
import "../coral-context/context" { AstContext };
import "../coral-module/module" { ModuleMap, ModuleId };
import "../coral-ast/decl" { File };
import "../coral-parser/lib" { Parser };

extern("C") i32 printf(u8* fmt, ...);
extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

usize sourceLen(u8* src)
{
    usize len = 0;
    while (src[len] != 0)
    {
        len = len + 1;
    }
    return len;
}

pub struct TestResult
{
    u32 tokens;
    u32 nodes;
    u32 errors;
}

extend TestResult
{
    void print()
    {
        printf("tokens=%u nodes=%u errors=%u\n", self.tokens, self.nodes, self.errors);
    }
}

TestResult runParser(u8* src, usize len)
{
    AstContext ctx;
    ctx.init(4096, 4096, 4096);

    IdentEntry* identEntries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(identEntries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;

    File* file = p.parseFile(ctx.intern("test", 4));
    u32 decls = 0;
    if (file != null) decls = file*.declsLen;

    TestResult r;
    r.tokens = decls;
    r.nodes = ctx.nodeCount();
    r.errors = p.panicMode;
    ctx.deinit();
    free(identEntries);
    return r;
}

TestResult runExpr(u8* src, usize len)
{
    AstContext ctx;
    ctx.init(4096, 4096, 4096);

    IdentEntry* identEntries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(identEntries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;
    p.parseExpr();

    TestResult r;
    r.tokens = 1;
    r.nodes = ctx.nodeCount();
    r.errors = p.panicMode;
    ctx.deinit();
    free(identEntries);
    return r;
}

bool testLexer()
{
    u8* src = "if x { return 1; }";
    IdentEntry* entries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + sourceLen(src);
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    u32 count = 0;
    while (lexer.cur < lexer.bufEnd)
    {
        Token tok = lexer.nextToken();
        if (tok.kind == TokenKind::Eof) break;
        count = count + 1;
    }
    IdentifierInfo* switchInfo = idents.get("switch", 6);
    printf("lexer test: tokens=%u switch_keyword=%u\n", count, switchInfo != null && switchInfo*.isKeyword ? 1 : 0);
    free(entries);
    return true;
}

bool testIdentifierRanges()
{
    bool ok = isXidStart(0x00C0) && isXidStart(0x06FF) && isXidStart(0x0700);
    ok = ok && !isXidStart(0x07C0) && !isXidStart(0x1380);
    ok = ok && isXidStart(0x13A0) && isXidStart(0x18AF) && !isXidStart(0x18B0);
    ok = ok && isXidStart(0xA7FF) && isXidStart(0xA800) && isXidStart(0xD7FF);
    ok = ok && !isXidStart(0xD800) && isXidStart(0x105BF) && !isXidStart(0x105C0);
    ok = ok && isXidContinue('0') && isXidContinue(0x0300) && !isXidContinue('.');
    printf("identifier ranges test: ok=%u\n", ok ? 1 : 0);
    return ok;
}

bool testContext()
{
    AstContext ctx;
    ctx.init(8, 8, 8);
    Str first = ctx.intern("same", 4);
    Str second = ctx.intern("same", 4);
    printf("context test: interned=%u same=%u\n", ctx.internsLen, first == second ? 1 : 0);
    ctx.deinit();
    return true;
}

bool testModuleMap()
{
    AstContext ctx;
    ctx.init(8, 8, 8);
    ModuleMap map;
    map.init(4);
    Str path = ctx.intern("std/math", 8);
    Str manifest = ctx.intern("std", 3);
    ModuleId first = map.add(path, manifest, 2);
    ModuleId second = map.resolvePath(path);
    ModuleId missing = map.resolveLib(ctx.intern("other", 5));
    printf("module map test: first=%u second=%u missing=%u\n", first.index, second.index, missing.index);
    map.deinit();
    ctx.deinit();
    return true;
}

bool testExpr()
{
    u8* src = "a + b * (c - d);";
    printf("expr test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
    return r.errors == 0;
}

bool testCompositeExpressions()
{
    u8* src = "Point { .x = 1, .y = 2 }";
    printf("composite expression test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
    return r.errors == 0;
}

