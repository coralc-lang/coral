bool testGenericExpressions()
{
    u8* path = "Option<f64>::None";
    TestResult pathResult = runExpr(path, sourceLen(path));
    u8* literal = "Box<u32> { .value = 1 }";
    TestResult literalResult = runExpr(literal, sourceLen(literal));
    printf("generic expression test: path=%u literal=%u\n", pathResult.errors, literalResult.errors);
    return pathResult.errors == 0 && literalResult.errors == 0;
}

