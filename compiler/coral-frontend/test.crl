pub i32 main()
{
    printf("****coral parser self-test****\n");
    bool ok = true;
    ok = testLexer() && ok;
    ok = testNumberTokens() && ok;
    ok = testCharLiteral() && ok;
    ok = testCharTokens() && ok;
    ok = testIdentifierRanges() && ok;
    ok = testContext() && ok;
    ok = testModuleMap() && ok;
    ok = testScopes() && ok;
    ok = testSema() && ok;
    ok = testMemberSemantics() && ok;
    ok = testMono() && ok;
    ok = testExpr() && ok;
    ok = testTernary() && ok;
    ok = testNumbers() && ok;
    ok = testCompositeExpressions() && ok;
    ok = testFunc() && ok;
    ok = testDeclarations() && ok;
    ok = testGlobal() && ok;
    ok = testExternalDeclarations() && ok;
    ok = testTypeDeclarations() && ok;
    ok = testFunctionPointer() && ok;
    ok = testGenericSyntax() && ok;
    ok = testGenericExpressions() && ok;
    ok = testGenericTypeForms() && ok;
    ok = testGenericExtension() && ok;
    ok = testComptimeType() && ok;
    ok = testVariant() && ok;
    ok = testSwitch() && ok;
    ok = testSwitchStmt() && ok;
    ok = testFlag() && ok;
    ok = testImport() && ok;
    ok = testImportRoot() && ok;
    ok = testImportAlias() && ok;
    ok = testImportLib() && ok;
    ok = testModReexport() && ok;
    ok = testModLibReexport() && ok;
    ok = testAttr() && ok;
    ok = testSwitchPatterns() && ok;
    ok = testForIn() && ok;
    ok = testLocals() && ok;
    ok = testAssignmentPrecedence() && ok;
    ok = testControlFlow() && ok;
    ok = testSpecialStatements() && ok;
    ok = testExpressionStatements() && ok;
    ok = testRecovery() && ok;
    printf("****done****\n");
    return ok ? 0 : 1;
}
