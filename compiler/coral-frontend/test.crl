/* frontend/test.crl — parser test harness
 *
 * Exercises the self-host Coral parser on examples,
 * itself, and stdlib files. Reports token and node counts.
 */

import "../coral-common/token" { TokenKind };
import "../coral-lexer/lexer" { Lexer };
import "../coral-lexer/table" { IdentifierTable, IdentEntry };
import "../coral-context/context" { AstContext };
import "../coral-ast/decl" { File };
import "../coral-parser/lib" { Parser };

extern("C") i32 printf(u8* fmt, ...);
extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

usize sourceLen(u8* src)
{
    usize len = 0;
    while (src[len] != 0)
    {
        len = len + 1;
    }
    return len;
}

pub struct TestResult
{
    u32 tokens;
    u32 nodes;
    u32 errors;
}

extend TestResult
{
    void print()
    {
        printf("tokens=%u nodes=%u errors=%u\n", self.tokens, self.nodes, self.errors);
    }
}

TestResult runParser(u8* src, usize len)
{
    AstContext ctx;
    ctx.init(4096, 4096, 4096);

    IdentEntry* identEntries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(identEntries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;

    File* file = p.parseFile(ctx.intern("test", 4));
    u32 decls = 0;
    if (file != null) decls = file*.declsLen;

    TestResult r;
    r.tokens = decls;
    r.nodes = ctx.nodeCount();
    r.errors = p.panicMode;
    ctx.deinit();
    free(identEntries);
    return r;
}

TestResult runExpr(u8* src, usize len)
{
    AstContext ctx;
    ctx.init(4096, 4096, 4096);

    IdentEntry* identEntries = malloc(256 * 64);
    IdentifierTable idents;
    idents.init(identEntries, 256);
    idents.addKeywords();

    Lexer lexer;
    lexer.bufStart = src;
    lexer.cur = src;
    lexer.bufEnd = src + len;
    lexer.line = 1;
    lexer.lineStart = src;
    lexer.diag = null;
    lexer.idents = &idents;

    Parser p;
    p.lexer = &lexer;
    p.ctx = &ctx;
    p.panicMode = 0;
    p.pendingGreater = false;
    p.current = lexer.nextToken();
    p.previous = p.current;
    p.parseExpr();

    TestResult r;
    r.tokens = 1;
    r.nodes = ctx.nodeCount();
    r.errors = p.panicMode;
    ctx.deinit();
    free(identEntries);
    return r;
}

void testExpr()
{
    u8* src = "a + b * (c - d);";
    printf("expr test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
}

void testFunc()
{
    u8* src = "pub i32 add(u32 a, u32 b) { return a + b; }";
    printf("func test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testVariant()
{
    u8* src = "pub variant Option { Some { u32 value }, None }";
    printf("variant test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testSwitch()
{
    u8* src = "switch (x) { A => { 1 }, else => { 0 } }";
    printf("switch test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
}

void testSwitchStmt()
{
    u8* src = "void f() { switch (x) { A => { a; }, else => { b; } } }";
    printf("switch stmt test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testFlag()
{
    u8* src = "flag(PLATFORM) { linux => { a; }, else => { b; } }";
    printf("flag test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testImport()
{
    u8* src = "import \"path\" { foo, bar as baz };";
    printf("import path test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testImportRoot()
{
    u8* src = "import file::math::core { square };";
    printf("import root test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testImportLib()
{
    u8* src = "import(lib) std::math { pow };";
    printf("import lib test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testModReexport()
{
    u8* src = "pub mod m = import \"path\";";
    printf("mod reexport test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testAttr()
{
    u8* src = "[[packed]] pub struct Foo { u32 x; }";
    printf("attr test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testSwitchPatterns()
{
    u8* src = "switch (x) { 0, 1 => { 1 }, Some { .value } => { 2 }, else => { 0 } }";
    printf("switch pattern test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
}

void testForIn()
{
    u8* src = "void f() { for (u32 value : values) { use(value); } }";
    printf("for-in test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testLocals()
{
    u8* src = "void f() { var x = 1; const u32 y = 2; x = y; }";
    printf("locals test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

void testRecovery()
{
    u8* src = "u32";
    printf("recovery test: ");
    TestResult r = runParser(src, sourceLen(src));
    r.print();
}

pub i32 main()
{
    printf("****coral parser self-test****\n");
    testExpr();
    testFunc();
    testVariant();
    testSwitch();
    testSwitchStmt();
    testFlag();
    testImport();
    testImportRoot();
    testImportLib();
    testModReexport();
    testAttr();
    testRecovery();
    printf("****done****\n");
    return 0;
}
