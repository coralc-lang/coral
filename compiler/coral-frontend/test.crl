bool testSwitchPatterns()
{
    u8* src = "switch (x) { 0, 1 => { 1 }, Some { .value } => { 2 }, else => { 0 } }";
    printf("switch pattern test: ");
    TestResult r = runExpr(src, sourceLen(src));
    r.print();
    u8* underscore = "switch (x) { _ => { 0 }, else => { 1 } }";
    TestResult underscoreResult = runExpr(underscore, sourceLen(underscore));
    return r.errors == 0 && underscoreResult.errors == 0;
}

