/* frontend/io.crl — file and cmdline readers shared by coralc. */

mod slice_mod = import "../coral-common/slice" { Slice };

extern("C") i32 open(u8* path, i32 flags, i32 mode);
extern("C") i32 read(i32 fd, u8* buf, usize len);
extern("C") i32 close(i32 fd);
extern("C") rawptr malloc(usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);
extern("C") void free(rawptr ptr);

usize readAll(i32 fd, u8* buf, usize cap)
{
    usize len = 0;
    while (len + 1 < cap)
    {
        i32 got = read(fd, buf + len, cap - 1 - len);
        if (got <= 0) break;
        len = len + (usize)got;
    }
    return len;
}

pub Slice readCmdline()
{
    u8* buf = (u8*)malloc(8192);
    if (buf == null) return Slice::from(null, 0);
    i32 fd = open("/proc/self/cmdline", 0, 0);
    if (fd < 0) return Slice::from(null, 0);
    usize len = readAll(fd, buf, 8192);
    close(fd);
    return Slice::from(buf, len);
}

pub Slice readFile(u8* cpath, usize* outLen)
{
    *outLen = 0;
    i32 fd = open(cpath, 0, 0);
    if (fd < 0) return Slice::from(null, 0);
    usize cap = 65536;
    u8* buf = (u8*)malloc(cap);
    if (buf == null) {
        close(fd);
        return Slice::from(null, 0);
    }
    usize len = 0;
    while (true)
    {
        if (len + 1 >= cap)
        {
            usize newCap = cap * 2;
            u8* grown = (u8*)realloc((rawptr)buf, newCap);
            if (grown == null) {
                close(fd);
                free((rawptr)buf);
                return Slice::from(null, 0);
            }
            buf = grown;
            cap = newCap;
        }
        i32 got = read(fd, buf + len, cap - 1 - len);
        if (got <= 0) break;
        len = len + (usize)got;
    }
    close(fd);
    buf[len] = 0;
    *outLen = len;
    return Slice::from(buf, len);
}

pub u8* sliceCStr(Slice s)
{
    u8* p = (u8*)malloc(s.len + 1);
    if (p == null) return null;
    usize i = 0;
    while (i < s.len) {
        p[i] = s.ptr[i];
        i = i + 1;
    }
    p[s.len] = 0;
    return p;
}

extern("C") i32 write(i32 fd, u8* buf, usize len);

pub bool writeFile(u8* cpath, Slice data)
{
    /* O_WRONLY|O_CREAT|O_TRUNC, mode 0644 */
    i32 fd = open(cpath, 577, 420);
    if (fd < 0) return false;
    usize off = 0;
    while (off < data.len)
    {
        i32 n = write(fd, data.ptr + off, data.len - off);
        if (n <= 0) { close(fd); return false; }
        off = off + (usize)n;
    }
    close(fd);
    return true;
}
