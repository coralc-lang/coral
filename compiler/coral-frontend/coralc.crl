/* frontend/coralc.crl — the single coralc entry point.
 *
 * One executable: build-file parsing + builder + (later) compile.
 * Args come from /proc/self/cmdline (NUL-separated), not argc/argv.
 */

mod arena_mod = import "../coral-build/arena" { Arena };
mod slice_mod = import "../coral-common/slice" { Slice };
mod crlb_mod = import "../coral-build/parser" { Parser };
mod cfg_ast = import "../coral-build/ast" { Node };
mod builder_mod = import "../coral-build/builder" { builderRun, Builder };

extern("C") i32 printf(u8* fmt, ...);
extern("C") i32 open(u8* path, i32 flags, i32 mode);
extern("C") i32 read(i32 fd, u8* buf, usize len);
extern("C") i32 close(i32 fd);
extern("C") rawptr malloc(usize size);

pub enum Command { Build, Map, Init, Run }
pub enum Flag { Help, Force, DryRun, MapOnly, Strict, File, Other }

pub struct Options
{
    Command cmd;
    Slice buildFile;
    bool help;
    bool force;
    bool dryRun;
    bool mapOnly;
    bool strict;
}

usize readAll(i32 fd, u8* buf, usize cap)
{
    usize len = 0;
    while (len + 1 < cap)
    {
        i32 got = read(fd, buf + len, cap - 1 - len);
        if (got <= 0) break;
        len = len + (usize)got;
    }
    return len;
}

Slice readCmdline()
{
    u8* buf = (u8*)malloc(8192);
    if (buf == null) return Slice::from(null, 0);
    i32 fd = open("/proc/self/cmdline", 0, 0);
    if (fd < 0) return Slice::from(null, 0);
    usize len = readAll(fd, buf, 8192);
    close(fd);
    return Slice::from(buf, len);
}

Slice readFile(u8* cpath, usize* outLen)
{
    *outLen = 0;
    i32 fd = open(cpath, 0, 0);
    if (fd < 0) return Slice::from(null, 0);
    usize cap = 65536;
    u8* buf = (u8*)malloc(cap);
    if (buf == null)
    {
        close(fd);
        return Slice::from(null, 0);
    }
    usize len = 0;
    while (true)
    {
        if (len + 1 >= cap)
        {
            break;
        }
        i32 got = read(fd, buf + len, cap - 1 - len);
        if (got <= 0) break;
        len = len + (usize)got;
    }
    close(fd);
    buf[len] = 0;
    *outLen = len;
    return Slice::from(buf, len);
}

u8* sliceCStr(Slice s)
{
    u8* p = (u8*)malloc(s.len + 1);
    if (p == null) return null;
    usize i = 0;
    while (i < s.len)
    {
        p[i] = s.ptr[i];
        i = i + 1;
    }
    p[s.len] = 0;
    return p;
}

bool aEq(Slice a, u8* b, usize bl)
{
    if (a.len != bl) return false;
    usize i = 0;
    while (i < bl)
    {
        if (a.ptr[i] != b[i]) return false;
        i = i + 1;
    }
    return true;
}

usize nextArg(Slice all, usize pos, Slice* out)
{
    while (pos < all.len && all.ptr[pos] == 0) pos = pos + 1;
    if (pos >= all.len)
    {
        *out = Slice::from(null, 0);
        return pos;
    }
    usize start = pos;
    while (pos < all.len && all.ptr[pos] != 0) pos = pos + 1;
    *out = Slice::from(all.ptr + start, pos - start);
    return pos;
}

Flag classifyFlag(Slice a)
{
    if (aEq(a, "-h", 2)) return Flag::Help;
    if (aEq(a, "--help", 6)) return Flag::Help;
    if (aEq(a, "--force", 7)) return Flag::Force;
    if (aEq(a, "--dry-run", 9)) return Flag::DryRun;
    if (aEq(a, "--map-only", 10)) return Flag::MapOnly;
    if (aEq(a, "--strict", 8)) return Flag::Strict;
    if (aEq(a, "-f", 2)) return Flag::File;
    return Flag::Other;
}

void usage()
{
    printf("coral <command> [options]\n");
    printf("commands:\n");
    printf("  build   build the project (default)\n");
    printf("  map     discover lib.crl folders, update the build file\n");
    printf("  init    scaffold a new build file\n");
    printf("  run     build, then run the output\n");
    printf("options:\n");
    printf("  -f <file>     build file (default coral.crlb)\n");
    printf("  --force       rebuild everything\n");
    printf("  --map-only    write modules.map only\n");
    printf("  --dry-run     compile without producing output\n");
    printf("  --strict      reject unknown build-file fields\n");
    printf("  -h, --help    show this help\n");
}

bool parseArgs(Options* opts)
{
    opts->cmd = Command::Build;
    opts->buildFile = Slice::from("coral.crlb", 10);
    opts->help = false;
    opts->force = false;
    opts->dryRun = false;
    opts->mapOnly = false;
    opts->strict = false;

    Slice argv = readCmdline();
    if (argv.ptr == null) return false;
    usize pos = 0;
    Slice tok;
    pos = nextArg(argv, pos, &tok);
    if (tok.len == 0) return false;

    bool haveCmd = false;
    while (true)
    {
        pos = nextArg(argv, pos, &tok);
        if (tok.len == 0) break;
        Flag f = classifyFlag(tok);
        if (f == Flag::Help)
        {
            opts->help = true;
            return true;
        }
        if (f == Flag::Force)
        {
            opts->force = true;
            continue;
        }
        if (f == Flag::DryRun)
        {
            opts->dryRun = true;
            continue;
        }
        if (f == Flag::MapOnly)
        {
            opts->mapOnly = true;
            continue;
        }
        if (f == Flag::Strict)
        {
            opts->strict = true;
            continue;
        }
        if (f == Flag::File)
        {
            Slice val;
            pos = nextArg(argv, pos, &val);
            if (val.len == 0)
            {
                printf("coral: -f needs a file path\n");
                return false;
            }
            opts->buildFile = val;
            continue;
        }
        if (tok.ptr[0] == 45)
        {
            printf("coral: unknown flag: %s\n", sliceCStr(tok));
            return false;
        }
        if (haveCmd)
        {
            printf("coral: unexpected argument: %s\n", sliceCStr(tok));
            return false;
        }
        haveCmd = true;
        if (aEq(tok, "build", 5)) opts->cmd = Command::Build;
        else if (aEq(tok, "map", 3)) opts->cmd = Command::Map;
        else if (aEq(tok, "init", 4)) opts->cmd = Command::Init;
        else if (aEq(tok, "run", 3)) opts->cmd = Command::Run;
        else
        {
            printf("coral: unknown command: %s\n", sliceCStr(tok));
            return false;
        }
    }
    return true;
}

pub i32 main()
{
    Options opts;
    if (!parseArgs(&opts))
    {
        usage();
        return 2;
    }
    if (opts.help)
    {
        usage();
        return 0;
    }
    if (opts.cmd == Command::Map)
    {
        printf("coral: map is not implemented yet\n");
        return 4;
    }
    if (opts.cmd == Command::Init)
    {
        printf("coral: init is not implemented yet\n");
        return 4;
    }
    if (opts.cmd == Command::Run)
    {
        printf("coral: run is not implemented yet\n");
        return 4;
    }

    u8* fileC = sliceCStr(opts.buildFile);
    if (fileC == null) return 1;
    usize len = 0;
    Slice src = readFile(fileC, &len);
    if (src.ptr == null)
    {
        printf("coral: cannot read %s\n", fileC);
        return 1;
    }

    Arena a;
    a.init(4194304);
    Parser p;
    p.init(&a, src);
    Node* root = p.parseFile();
    if (root == null || p.errors > 0)
    {
        printf("coral: parse failed, errors=%d\n", (i32)p.errors);
        return 2;
    }

    Builder b;
    i32 errs = builderRun(root, &a, opts.force, opts.mapOnly, &b);
    if (errs == 0) return 0;
    return 3;
}
