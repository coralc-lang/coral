mod slice = import "slice" { Slice };

enum TokenKind
{
    EOF,
    IDENT,
    STRING,
    NUMBER,
    BOOL,
    LBRACE,
    RBRACE,
    LBRACKET,
    RBRACKET,
    EQUALS,
    SEMI,
    COMMA,
    ERROR
}

struct Token {
    TokenKind kind;
    Slice text;
    u32 line;
    u32 col;
    u64 numValue;
    bool boolValue;
}