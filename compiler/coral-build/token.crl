mod slice = import "../coral-common/token/slice" { Slice };

pub enum TokenKind
{
    EOF,
    IDENT,
    STRING,
    NUMBER,
    BOOL,
    LBRACE,
    RBRACE,
    LBRACKET,
    RBRACKET,
    EQUALS,
    SEMI,
    COMMA,
    ERROR
}

pub struct Token
{
    TokenKind kind;
    Slice text;
    usize line;
    usize col;
    isize numValue;
    bool boolValue;
}