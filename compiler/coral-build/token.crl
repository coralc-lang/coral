mod slice = import "../coral-common/slice" { Slice };

pub enum TokenKind
{
    Eof,
    Ident,
    String,
    Number,
    Bool,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Equals,
    Semi,
    Comma,
    Error
}

pub struct Token
{
    TokenKind kind;
    Slice text;
    usize line;
    usize col;
    i64 numValue;
    bool boolValue;
}
