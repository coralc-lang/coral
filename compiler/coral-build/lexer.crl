mod Arena = import "arena" { Arena };
mod Token = import "token" { Token, TokenKind };
mod Slice = import "../coral-common/slice" { Slice };
// IDENT      = /[A-Za-z_][A-Za-z0-9_-]*/
// STRING     = '"' { [^"\\] | "\\" . } '"'
// NUMBER     = /[0-9]+/
// BOOL       = "true" | "false"     (lexed as identifiers, reclassified)
// comment    = "#" { [^\n] }
//
// Keywords (build, workspace, task, extends, ...) are NOT special-cased by
// the lexer -- they come back as plain IDENT tokens, exactly like the
// EBNF's quoted-terminal convention implies (they match the IDENT pattern).
// The parser is what knows which identifier text means what.
pub struct Lexer
{
    Slice src;
    usize pos;
    usize line;
    usize col;
    bool hadError;

    void init(Slice s)
    {
        self.src.ptr = s.ptr;
        self.src.len = s.len;
        self.pos = 0;
        self.line = 1;
        self.col = 1;
        self.hadError = false;
    }

    u8 peek() const
    {
        if (self.pos >= self.src.len) return 0;
        return self.src.ptr[self.pos];
    }

    static bool isIdentStart(u8 c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'; }
    static bool isIdentCont(u8 c) { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '-'; }
    static bool isDigit(u8 c) { return c >= '0' && c <= '9'; }

    void skipWsAndComments()
    {
        loop {
            u8 c = self.peek();
            if (c == ' ' || c == '\t' || c == '\r' || c == '\n') { self.advance(); continue; }
            if (c == '#') {
                while (self.peek() != 0 && self.peek() != '\n') self.advance();
                continue;
            }
            break;
        }
    }

    u8 advance()
    {
        u8 c = self.src.ptr[self.pos];
        self.pos = self.pos + 1;
        if (c == '\n') { self.line = self.line + 1; self.col = 1; }
        else { self.col = self.col + 1; }
        return c;
    }

    bool isIdentStart(u8 c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'; }
    bool isIdentCont(u8 c) { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '-'; }
    bool isDigit(u8 c) { return c >= '0' && c <= '9'; }
    
    Token Lexer::next()
    {
        self.skipWsAndComments();
        
        Token t = {
            .kind = TokenKind::EOF,
            .text.ptr = null,
            .text.len = 0,
            .line = self.line,
            .col = self.col,
            .numValue = 0,
            .boolValue = false
        };

        if (self.pos >= self.src.len) { t.kind = TokenKind::EOF; return t; }
        u8 c = self.peek();
    
        if (c == '{') { self.advance(); t.kind = TokenKind::LBRACE; return t; }
        if (c == '}') { self.advance(); t.kind = TokenKind::RBRACE; return t; }
        if (c == '[') { self.advance(); t.kind = TokenKind::LBRACKET; return t; }
        if (c == ']') { self.advance(); t.kind = TokenKind::RBRACKET; return t; }
        if (c == '=') { self.advance(); t.kind = TokenKind::EQUALS; return t; }
        if (c == ';') { self.advance(); t.kind = TokenKind::SEMI; return t; }
        if (c == ',') { self.advance(); t.kind = TokenKind::COMMA; return t; }
    
        if (c == '"') {
            self.advance(); // opening quote
            usize start = self.pos;
            usize writePos = start; // trails `pos` only once an escape is seen
    
            loop {
                u8 cc = self.peek();
                if (cc == 0) { self.hadError = true; t.kind = TokenKind::ERROR; return t; }
                if (cc == '"') { self.advance(); break; }
    
                if (cc == '\\') {
                    self.advance(); // the backslash
                    u8 esc = self.peek();
                    if (esc == 0) { self.hadError = true; t.kind = TokenKind::ERROR; return t; }
                    self.advance(); // the escaped character
    
                    u8 decoded;
                    switch (esc) {
                        'n' => { decoded = '\n'; },
                        't' => { decoded = '\t'; },
                        'r' => { decoded = '\r'; },
                        '"' => { decoded = '"';  },
                        '\\' => { decoded = '\\'; },
                        else => { decoded = esc; }
                    }
                    self.src.ptr[writePos] = decoded;
                    writePos = writePos + 1;
                    continue;
                }
    
                // Ordinary character. While writePos == pos (no escape seen
                // yet) this is a self-assignment of one byte -- effectively
                // free, and definitely not a heap allocation.
                self.src.ptr[writePos] = cc;
                writePos = writePos + 1;
                self.advance();
            }
    
            usize outLen = writePos - start;
            t.kind = TokenKind::STRING;
            t.text = Slice::from(self.src + start, outLen);
            return t;
        }
    
        if (isDigit(c)) {
            usize start = self.pos;
            while (isDigit(self.peek())) self.advance();
            usize l = self.pos - start;
            t.kind = TokenKind::NUMBER;
            t.text = Slice::from(self.src + start, l);
            usize v = 0;
            for (usize i = 0; i < l; i = i + 1) v = v * 10 + (self.src.ptr[start + i] - '0');
            t.numValue = v;
            return t;
        }
    
        if (isIdentStart(c)) {
            usize start = self.pos;
            while (isIdentCont(self.peek())) self.advance();
            usize l = self.pos - start;
            Slice txt = Slice::from(self.src + start, l);
            if (txt.eq(Slice{ "true", 4 }))  { t.kind = TokenKind::BOOL; t.boolValue = true;  t.text = txt; return t; }
            if (txt.eq(Slice{ "false", 5 })) { t.kind = TokenKind::BOOL; t.boolValue = false; t.text = txt; return t; }
            t.kind = TokenKind::IDENT;
            t.text = txt;
            return t;
        }
    
        // Unknown character.
        self.advance();
        self.hadError = true;
        t.kind = TokenKind::ERROR;
        t.text = Slice::from(self.src + (self.pos - 1), 1);
        return t;
    }
}