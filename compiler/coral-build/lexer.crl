mod Arena = import "arena" { Arena };
mod Token = import "token" { Token, TokenKind };
mod Slice = import "../coral-common/slice" { Slice };
// IDENT      = /[A-Za-z_][A-Za-z0-9_-]*/
// STRING     = '"' { [^"\\] | "\\" . } '"'
// NUMBER     = /[0-9]+/
// BOOL       = "true" | "false"     (lexed as identifiers, reclassified)
// comment    = "#" { [^\n] }
//
// Keywords (build, workspace, task, extends, ...) are NOT special-cased by
// the lexer -- they come back as plain IDENT tokens, exactly like the
// EBNF's quoted-terminal convention implies (they match the IDENT pattern).
// The parser is what knows which identifier text means what.
pub struct Lexer
{
    const u8* src;
    usize len;
    usize pos;
    usize line;
    usize col;
    Arena* arena;
    bool hadError;

    void init(Slice s, Arena* arena) {
        self.src = s.ptr;
        self.len = s.len;
        self.pos = 0;
        self.line = 1;
        self.col = 1;
        self.arena = arena;
        self.hadError = false;
    }

    u8 peekc()
    {
        if (self.pos >= self.len) return 0;
        return self.src[self.pos];
    }

    void skipWsAndComments()
    {
        loop {
            u8 c = self.peekc();
            if (c == ' ' || c == '\t' || c == '\r' || c == '\n') { self.advc(); continue; }
            if (c == '#') {
                while (self.peekc() != 0 && self.peekc() != '\n') self.advc();
                continue;
            }
            break;
        }
    }

    bool isIdentStart(u8 c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'; }
    bool isIdentCont(u8 c) { return isIdentStart(c) || (c >= '0' && c <= '9') || c == '-'; }
    bool isDigit(u8 c) { return c >= '0' && c <= '9'; }
    
    Token next()
    {
        self.skipWsAndComments();
    
        Token t;
        t.kind = TokenKind::EOF;
        t.text.ptr = 0; t.text.len = 0;
        t.line = self.line; t.col = self.col;
        t.numValue = 0; t.boolValue = false;
    
        if (self.pos >= self.len) { t.kind = EOF; return t; }
        u8 c = self.peekc();
        if (c == '{') { self.advc(); t.kind = TokenKind::LBRACE; return t; }
        if (c == '}') { self.advc(); t.kind = TokenKind::RBRACE; return t; }
        if (c == '[') { self.advc(); t.kind = TokenKind::LBRACKET; return t; }
        if (c == ']') { self.advc(); t.kind = TokenKind::RBRACKET; return t; }
        if (c == '=') { self.advc(); t.kind = TokenKind::EQUALS; return t; }
        if (c == ';') { self.advc(); t.kind = TokenKind::SEMI; return t; }
        if (c == ',') { self.advc(); t.kind = TokenKind::COMMA; return t; }
    
        if (c == '"')
        {
            self.advc(); // consume opening quote
            usize remaining = self.len - self.pos;
            u8* buf = (u8*)Arena::alloc(self.arena, remaining + 1, 1);
            usize outLen = 0;
            loop {
                u8 cc = self.peekc();
                if (cc == 0) { self.hadError = true; t.kind = TokenKind::ERROR; return t; }
                if (cc == '"') { self.advc(); break; }
                if (cc == '\\') {
                    self.advc();
                    u8 esc = self.peekc();
                    if (esc == 0) { self.hadError = true; t.kind = TokenKind::ERROR; return t; }
                    self.advc();
                    switch (esc) {
                        'n' => { buf[outLen] = '\n'; },
                        't' => { buf[outLen] = '\t'; },
                        'r' => { buf[outLen] = '\r'; },
                        '"' => { buf[outLen] = '"'; },
                        '\\' => { buf[outLen] = '\\'; },
                        else => { buf[outLen] = esc; }
                    }
                    outLen = outLen + 1;
                    continue;
                }
                buf[outLen] = cc;
   TokenKind::             outLen = outLen + 1;
                selfadvc();
            }
            buf[outLen] = 0;
            t.kind = TokenKind::STRING;
            t.text = Slice::from(buf, outLen);
            return t;
        }
    
        if (isDigit(c))
        {
            usize start = self.pos;
            while (isDigit(self.peekc())) self.advc();
            usize l = self.pos - start;
            t.kind = TokenKind::NUMBER;
            t.text = Slice::from(self.src + start, l);
            usize v = 0;
            for (usize i = 0; i < l; i = i + 1) v = v * 10 + (self.src[start + i] - '0');
            t.numValue = v;
            return t;
        }
    
        if (isIdentStart(c))
        {
            usize start = self.pos;
            while (isIdentCont(self.peekc())) self.advc();
            usize l = self.pos - start;
            Slice txt = Slice::from(self.src + start, l);
            if (txt.eq("true"))  { t.kind = TokenKind::BOOL; t.boolValue = true;  t.text = txt; return t; }
            if (txt.eq("false")) { t.kind = BOOL; t.boolValue = false; t.text = txt; return t; }
            t.kind = IDENT;
            t.text = txt;
            return t;
        }
    
        // Unknown u8acter.
        self.advc();
        self.hadError = true;
        t.kind = TokenKind::ERROR;
        t.text = Slice::from(self.src + (self.pos - 1), 1);
        return t;
    }
}