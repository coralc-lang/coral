mod Arena = import "arena" { Arena };
mod Tok = import "token" { Token, TokenKind };
mod SliceMod = import "../coral-common/slice" { Slice };

// IDENT   = /[A-Za-z_][A-Za-z0-9_-]*/
// STRING  = '"' { [^"\\] | "\\" . } '"'
// NUMBER  = /[0-9]+/
// BOOL    = "true" | "false"   (lexed as ident, reclassified)
// comment = "#" { [^\n] }
//
// Keywords come back as plain IDENT tokens; the parser decides what
// identifier text means what.

pub bool isIdentStart(u8 c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'; }

pub bool isIdentCont(u8 c)
{
    if (isIdentStart(c)) return true;
    return c >= '0' && c <= '9' || c == '-';
}

pub bool isDigit(u8 c)
{
    return c >= '0' && c <= '9';
}

pub Slice mkSlice(u8* p, usize n)
{
    Slice s;
    s.ptr = p;
    s.len = n;
    return s;
}

pub struct Lexer
{
    Slice src;
    usize pos;
    usize line;
    usize col;
    bool hadError;

    void init(Slice s)
    {
        self = Lexer {
            .src = s,
            .pos = 0,
            .line = 1,
            .col = 1,
            .hadError = false
        };
    }

    u8 peek()
    {
        if (self.pos >= self.src.len) return 0;
        return self.src.ptr[self.pos];
    }

    void skipWsAndComments()
    {
        while (true)
        {
            u8 c = self.peek();
            if (c == ' ' || c == '\t' || c == '\r' || c == '\n')
            {
                self.advance();
                continue;
            }
            if (c == '#')
            {
                while (self.peek() != 0 && self.peek() != '\n') self.advance();
                continue;
            }
            break;
        }
    }

    u8 advance()
    {
        u8 c = self.src.ptr[self.pos];
        self.pos = self.pos + 1;
        if (c == '\n') {
            self.line = self.line + 1;
            self.col = 1;
        }
        else {
            self.col = self.col + 1;
        }
        return c;
    }

    Token next()
    {
        self.skipWsAndComments();

        Token t = Token {
            .kind = TokenKind::Eof,
            .text = mkSlice(null, 0),
            .line = self.line,
            .col = self.col,
            .numValue = 0,
            .boolValue = false,
        };

        if (self.pos >= self.src.len) return t;
        u8 c = self.peek();

        if (c == '{') { self.advance(); t.kind = TokenKind::LBrace; return t; }
        if (c == '}') { self.advance(); t.kind = TokenKind::RBrace; return t; }
        if (c == '[') { self.advance(); t.kind = TokenKind::LBracket; return t; }
        if (c == ']') { self.advance(); t.kind = TokenKind::RBracket; return t; }
        if (c == '=') { self.advance(); t.kind = TokenKind::Equals; return t; }
        if (c == ';') { self.advance(); t.kind = TokenKind::Semi; return t; }
        if (c == ',') { self.advance(); t.kind = TokenKind::Comma; return t; }

        if (c == '"')
        {
            self.advance();
            usize start = self.pos;
            usize writePos = start;
            while (true)
            {
                u8 cc = self.peek();
                if (cc == 0)
                {
                    self.hadError = true;
                    t.kind = TokenKind::Error;
                    return t;
                }
                if (cc == '"')
                {
                    self.advance();
                    break;
                }
                if (cc == '\\')
                {
                    self.advance();
                    u8 esc = self.peek();
                    if (esc == 0)
                    {
                        self.hadError = true;
                        t.kind = TokenKind::Error;
                        return t;
                    }
                    self.advance();
                    u8 decoded;
                    switch (esc)
                    {
                        'n' => { decoded = '\n'; },
                        't' => { decoded = '\t'; },
                        'r' => { decoded = '\r'; },
                        '"' => { decoded = '"'; },
                        '\\' => { decoded = '\\'; },
                        else => { decoded = esc; }
                    }
                    self.src.ptr[writePos] = decoded;
                    writePos = writePos + 1;
                    continue;
                }
                self.src.ptr[writePos] = cc;
                writePos = writePos + 1;
                self.advance();
            }
            t.kind = TokenKind::String;
            t.text = mkSlice(self.src.ptr + start, writePos - start);
            return t;
        }

        if (isDigit(c))
        {
            usize start = self.pos;
            while (isDigit(self.peek())) self.advance();
            usize l = self.pos - start;
            t.kind = TokenKind::Number;
            t.text = mkSlice(self.src.ptr + start, l);
            i64 v = 0;
            usize i = 0;
            while (i < l)
            {
                v = v * 10 + (i64)(self.src.ptr[start + i] - '0');
                i = i + 1;
            }
            t.numValue = v;
            return t;
        }

        if (isIdentStart(c))
        {
            usize start = self.pos;
            while (isIdentCont(self.peek())) self.advance();
            usize l = self.pos - start;
            Slice txt = mkSlice(self.src.ptr + start, l);
            if (txt.eq(mkSlice("true", 4)))
            {
                t.kind = TokenKind::Bool;
                t.boolValue = true;
                t.text = txt;
                return t;
            }
            if (txt.eq(mkSlice("false", 5)))
            {
                t.kind = TokenKind::Bool;
                t.boolValue = false;
                t.text = txt;
                return t;
            }
            t.kind = TokenKind::Ident;
            t.text = txt;
            return t;
        }

        self.advance();
        self.hadError = true;
        t.kind = TokenKind::Error;
        t.text = mkSlice(self.src.ptr + (self.pos - 1), 1);
        return t;
    }
}
