mod arena_mod = import "arena" { Arena };
mod ast_mod = import "ast" { Node, NodeKind, Value, ValueArray, nodeKindName };
mod slice_mod = import "../coral-common/slice" { Slice };

extern("C") i32 printf(u8* fmt, ...);
extern("C") i32 open(u8* path, i32 flags, i32 mode);
extern("C") i32 read(i32 fd, u8* buf, usize len);
extern("C") i32 write(i32 fd, u8* buf, usize len);
extern("C") i32 close(i32 fd);
extern("C") rawptr malloc(usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);
extern("C") void free(rawptr ptr);
extern("C") rawptr memcpy(rawptr dst, rawptr src, usize n);
extern("C") usize strlen(u8* s);
extern("C") i64 syscall(i64 num, ...);

// small helpers

Slice bSlice(u8* p, usize n)
{
    Slice s;
    s.ptr = p;
    s.len = n;
    return s;
}

bool bEq(Slice a, u8* b, usize bl)
{
    if (a.len != bl) return false;
    usize i = 0;
    while (i < bl)
    {
        if (a.ptr[i] != b[i]) return false;
        i = i + 1;
    }
    return true;
}

bool bEndsWith(Slice a, u8* suffix, usize sl)
{
    if (a.len < sl) return false;
    return bEq(bSlice(a.ptr + (a.len - sl), sl), suffix, sl);
}

u8* bCStr(Arena* a, Slice s)
{
    u8* p = (u8*)a.alloc(s.len + 1, 1);
    if (p == null) return null;
    memcpy(p, s.ptr, s.len);
    p[s.len] = 0;
    return p;
}

u8* bConcat3(Arena* a, Slice x, u8* mid, usize midLen, Slice y)
{
    usize total = x.len + midLen + y.len;
    u8* p = (u8*)a.alloc(total + 1, 1);
    if (p == null) return null;
    memcpy(p, x.ptr, x.len);
    memcpy(p + x.len, mid, midLen);
    memcpy(p + x.len + midLen, y.ptr, y.len);
    p[total] = 0;
    return p;
}

usize bJoin(u8* out, usize cap, Slice dir, Slice name)
{
    usize n = 0;
    usize i = 0;
    while (i < dir.len && n + 1 < cap)
    {
        out[n] = dir.ptr[i];
        n = n + 1;
        i = i + 1;
    }
    if (n > 0 && out[n - 1] != '/' && n + 1 < cap)
    {
        out[n] = '/';
        n = n + 1;
    }
    i = 0;
    while (i < name.len && n + 1 < cap)
    {
        out[n] = name.ptr[i];
        n = n + 1;
        i = i + 1;
    }
    out[n] = 0;
    return n;
}

u64 bFnv(u64 h, u8* data, usize len)
{
    usize i = 0;
    while (i < len)
    {
        h = h ^ (u64)data[i];
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

usize bApp(u8* buf, usize cap, usize* len, u8* src, usize n)
{
    usize i = 0;
    while (i < n && *len < cap)
    {
        buf[*len] = src[i];
        *len = *len + 1;
        i = i + 1;
    }
    return *len;
}

bool bFileExists(u8* cpath)
{
    i32 fd = open(cpath, 0, 0);
    if (fd < 0) return false;
    close(fd);
    return true;
}

Slice bReadFile(Arena* a, u8* cpath, usize* outLen)
{
    *outLen = 0;
    i32 fd = open(cpath, 0, 0);
    if (fd < 0) return bSlice(null, 0);
    usize cap = 65536;
    u8* buf = (u8*)malloc(cap);
    if (buf == null)
    {
        close(fd);
        return bSlice(null, 0);
    }
    usize len = 0;
    while (true)
    {
        if (len >= cap)
        {
            u8* fresh = (u8*)realloc(buf, cap * 2);
            if (fresh == null) break;
            buf = fresh;
            cap = cap * 2;
        }
        i32 got = read(fd, buf + len, cap - len);
        if (got <= 0) break;
        len = len + (usize)got;
    }
    close(fd);
    u8* copy = (u8*)a.alloc(len + 1, 1);
    if (copy == null)
    {
        free(buf);
        return bSlice(null, 0);
    }
    memcpy(copy, buf, len);
    copy[len] = 0;
    free(buf);
    *outLen = len;
    return bSlice(copy, len);
}

pub struct DirEnt
{
    u8* name;
    u8 dtype;
}

DirEnt* bListDir(Arena* a, u8* cpath, u32* outLen)
{
    *outLen = 0;
    i32 fd = open(cpath, 0, 0);
    if (fd < 0) return null;
    u8* buf = (u8*)malloc(65536);
    if (buf == null)
    {
        close(fd);
        return null;
    }
    DirEnt* arr = (DirEnt*)a.alloc(64 * sizeof(DirEnt), 8);
    u32 cap = 64;
    if (arr == null)
    {
        free(buf);
        close(fd);
        return 0;
    }
    u32 len = 0;
    while (true)
    {
        i64 n = syscall(217, fd, buf, 65536);
        if (n <= 0) break;
        i64 off = 0;
        while (off < n)
        {
            u16 reclen = (u16)(((u32)buf[off + 16]) | ((u32)buf[off + 17] << 8));
            if (reclen == 0) break;
            u8 dtype = buf[off + 18];
            usize nameLen = 0;
            while (nameLen < 255 && buf[off + 19 + nameLen] != 0) nameLen = nameLen + 1;
            if (len >= cap)
            {
                DirEnt* fresh = (DirEnt*)a.alloc((cap * 2) * sizeof(DirEnt), 8);
                if (fresh == null) break;
                u32 i = 0;
                while (i < len)
                {
                    fresh[i] = arr[i];
                    i = i + 1;
                }
                arr = fresh;
                cap = cap * 2;
            }
            u8* name = (u8*)a.alloc(nameLen + 1, 1);
            memcpy(name, buf + off + 19, nameLen);
            name[nameLen] = 0;
            arr[len].name = name;
            arr[len].dtype = dtype;
            len = len + 1;
            off = off + (i64)reclen;
        }
    }
    free(buf);
    close(fd);
    *out = arr;
    *outLen = len;
    return len;
}

bool bIsSkipped(Slice name, Slice* skips, u32 skipLen)
{
    u32 i = 0;
    while (i < skipLen)
    {
        if (bEq(name, skips[i].ptr, skips[i].len)) return true;
        i = i + 1;
    }
    return false;
}

u32 bCollectCrl(Arena* a, u8* dirC, Slice dirS, Slice* skips, u32 skipLen, Slice* out, u32 cap, u32* outLen)
{
    DirEnt* ents = null;
    u32 n = 0;
    bListDir(a, dirC, &ents, &n);
    u32 i = 0;
    while (i < n)
    {
        Slice nm = bSlice(ents[i].name, strlen(ents[i].name));
        if (!bEq(nm, ".", 1) && !bEq(nm, "..", 2))
        {
            if (ents[i].dtype == 4)
            {
                if (!bIsSkipped(nm, skips, skipLen))
                {
                    u8* subC = (u8*)a.alloc(dirS.len + nm.len + 2, 1);
                    usize subLen = bJoin(subC, dirS.len + nm.len + 2, dirS, nm);
                    bCollectCrl(a, subC, bSlice(subC, subLen), skips, skipLen, out, cap, outLen);
                }
            }
            else if (bEndsWith(nm, ".crl", 4))
            {
                if (*outLen < cap)
                {
                    u8* fullC = (u8*)a.alloc(dirS.len + nm.len + 2, 1);
                    usize fullLen = bJoin(fullC, dirS.len + nm.len + 2, dirS, nm);
                    out[*outLen] = bSlice(fullC, fullLen);
                    *outLen = *outLen + 1;
                }
            }
        }
        i = i + 1;
    }
    return *outLen;
}

void bSortFiles(Slice* files, u32 len)
{
    u32 i = 1;
    while (i < len)
    {
        Slice key = files[i];
        i32 j = (i32)i - 1;
        while (j >= 0)
        {
            bool less = false;
            Slice cur = files[j];
            usize minLen = cur.len;
            if (key.len < minLen) minLen = key.len;
            usize k = 0;
            while (k < minLen)
            {
                if (cur.ptr[k] < key.ptr[k]) { less = true; break; }
                if (cur.ptr[k] > key.ptr[k]) { less = false; break; }
                k = k + 1;
                if (k == minLen && cur.len < key.len) less = true;
            }
            if (!less) break;
            files[j + 1] = files[j];
            j = j - 1;
        }
        files[j + 1] = key;
        i = i + 1;
    }
}

// config extraction

Value* bFindField(Node* n, Slice name)
{
    u32 i = 0;
    while (i < n.fields.len)
    {
        if (bEq(n.fields.data[i].name, name.ptr, name.len)) return n.fields.data + i;
        i = i + 1;
    }
    return null;
}

bool bFieldStr(Node* n, Slice name, Slice* out)
{
    Value* v = bFindField(n, name);
    if (v == null) return false;
    if (v.tag != Value::String) return false;
    *out = v.payload.String.value;
    return true;
}

bool bFieldList(Node* n, Slice name, Arena* a, Slice** out, u32* outLen)
{
    *out = null;
    *outLen = 0;
    Value* v = bFindField(n, name);
    if (v == null) return false;
    if (v.tag != Value::List) return false;
    ValueArray* va = v.payload.List.value;
    if (va == null) return true;
    if (va.len == 0) return true;
    Slice* arr = (Slice*)a.alloc(va.len * sizeof(Slice), 8);
    if (arr == null) return false;
    u32 i = 0;
    while (i < va.len)
    {
        Value item = va.data[i];
        if (item.tag != Value::String) return false;
        arr[i] = item.payload.String.value;
        i = i + 1;
    }
    *out = arr;
    *outLen = va.len;
    return true;
}

pub struct MapEnt
{
    Slice key;   // already NUL-terminated via arena
    Slice path;  // NUL-terminated
}

pub struct AliasEnt
{
    Slice name;
    Slice folder;
}

pub struct ModNode
{
    Slice name;
    u32* deps;
    u32 depsLen;
    u32 depsCap;
    u64 fingerprint;
    bool stale;
}

pub struct Builder
{
    Arena* arena;
    Node* cfg;
    Node* build;
    Slice rootDir;
    Slice entry;
    Slice output;
    Slice mapPath;
    Slice cacheDir;
    Slice* modules;
    u32 modulesLen;
    Slice* skips;
    u32 skipsLen;
    AliasEnt* aliases;
    u32 aliasesLen;
    MapEnt* table;
    u32 tableLen;
    u32 tableCap;
    ModNode* mods;
    u32 topoLen;
    u32* topoOrder;
    u32 errors;
    bool force;
    bool emitMapOnly;
}

void bError(Builder* b, u8* code, u8* msg, u8* k1, u8* v1, u8* k2, u8* v2, u8* hint)
{
    b.errors = b.errors + 1;
    printf("%s  %s\n", code, msg);
    if (k1 != null) printf("  %s:   %s\n", k1, v1);
    if (k2 != null) printf("  %s:   %s\n", k2, v2);
    if (hint != null) printf("  hint:   %s\n", hint);
}

bool bInit(Builder* b, Arena* a, Node* root, bool forceIn, bool emitMapOnlyIn)
{
    b.arena = a;
    b.cfg = root;
    b.build = null;
    b.errors = 0;
    b.force = forceIn;
    b.emitMapOnly = emitMapOnlyIn;
    b.rootDir = bSlice("compiler/", 9); // why is this a hardcoded comiler dir, the compiler used in the docs was an example for tthiis project.
    b.entry = bSlice(null, 0);
    b.output = bSlice(null, 0);
    b.mapPath = bSlice(".coral/modules.map", 18);
    b.cacheDir = bSlice(".coral/cache", 12);
    b.modules = null;
    b.modulesLen = 0;
    b.skips = null;
    b.skipsLen = 0;
    b.aliases = null;
    b.aliasesLen = 0;
    b.table = null;
    b.tableLen = 0;
    b.tableCap = 0;
    b.mods = null;
    b.topoOrder = null;
    b.topoLen = 0;

    u32 i = 0;
    while (i < root.children.len)
    {
        Node* c = root.children.data[i];
        if (c.kind == NodeKind::Build)
        {
            b.build = c;
            break;
        }
        i = i + 1;
    }
    if (b.build == null)
    {
        printf("E1000  no build block found\n");
        b.errors = b.errors + 1;
        return false;
    }

    bFieldStr(b.build, bSlice("root", 4), &b.rootDir);
    bFieldStr(b.build, bSlice("entry", 5), &b.entry);
    bFieldStr(b.build, bSlice("output", 6), &b.output);
    bFieldStr(b.build, bSlice("module_map", 10), &b.mapPath);
    bFieldStr(b.build, bSlice("cache_dir", 9), &b.cacheDir);
    bFieldList(b.build, bSlice("modules", 7), a, &b.modules, &b.modulesLen);
    bFieldList(b.build, bSlice("skip", 4), a, &b.skips, &b.skipsLen);

    if (b.modulesLen == 0)
    {
        printf("E1000  modules = [...] is required in build block\n");
        b.errors = b.errors + 1;
        return false;
    }

    b.mods = (ModNode*)a.alloc(b.modulesLen * sizeof(ModNode), 8);
    if (b.mods == null) return false;
    u32 m = 0;
    while (m < b.modulesLen)
    {
        b.mods[m].name = b.modules[m];
        b.mods[m].deps = null;
        b.mods[m].depsLen = 0;
        b.mods[m].depsCap = 0;
        b.mods[m].fingerprint = 14695981039346656037;
        b.mods[m].stale = true;
        m = m + 1;
    }

    u32 aliasCount = 0;
    i = 0;
    while (i < root.children.len)
    {
        if (root.children.data[i].kind == NodeKind::Alias) aliasCount = aliasCount + 1;
        i = i + 1;
    }
    if (aliasCount > 0)
    {
        b.aliases = (AliasEnt*)a.alloc(aliasCount * sizeof(AliasEnt), 8);
        if (b.aliases == null) return false;
    }
    i = 0;
    while (i < root.children.len)
    {
        Node* c = root.children.data[i];
        if (c.kind == NodeKind::Alias && c.hasLabel && c.hasPayload)
        {
            u8* tgt = c.payload;
            usize tgtLen = c.payload.len;
            u32 s = 0;
            while (s < tgtLen)
            {
                if (tgt[s] == '/')
                {
                    tgtLen = s;
                    break;
                }
                s = s + 1;
            }
            b.aliases[b.aliasesLen].name = c.label;
            b.aliases[b.aliasesLen].folder = bSlice(tgt.ptr, tgtLen);
            b.aliasesLen = b.aliasesLen + 1;
        }
        i = i + 1;
    }
    return b.errors == 0;
}

// resolve alias or raw folder prefix to a module folder
bool bResolvePrefix(Builder* b, Slice prefix, Slice* outFolder)
{
    u32 i = 0;
    while (i < b.aliasesLen)
    {
        if (bEq(b.aliases[i].name, prefix.ptr, prefix.len))
        {
            *outFolder = b.aliases[i].folder;
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while (i < b.modulesLen)
    {
        if (bEq(b.modules[i], prefix.ptr, prefix.len))
        {
            *outFolder = b.modules[i];
            return true;
        }
        i = i + 1;
    }
    return false;
}

i32 bModuleIdx(Builder* b, Slice folder)
{
    u32 i = 0;
    while (i < b.modulesLen)
    {
        if (bEq(b.modules[i], folder.ptr, folder.len)) return (i32)i;
        i = i + 1;
    }
    return -1;
}

