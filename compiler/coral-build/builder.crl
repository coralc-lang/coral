bool bWriteFile(u8* cpath, u8* data, usize len)
{
    i32 fd = open(cpath, 577, 420);
    if (fd < 0) return false;
    i32 w = write(fd, data, len);
    close(fd);
    return w >= 0;
}

bool bWriteMap(Builder* b)
{
    syscall(83, ".coral", 493);

    usize cap = 262144;
    u8* buf = (u8*)malloc(cap);
    if (buf == null) return false;
    usize len = 0;
    u8* header = "# coral modules.map v1 — generated by `coralc build`, do not edit\n";
    bApp(buf, cap, &len, header, strlen(header));

    u32 t = 0;
    while (t < b.tableLen)
    {
        bApp(buf, cap, &len, b.table[t].key.ptr, b.table[t].key.len);
        while (b.table[t].key.len < 24 && len < cap)
        {
            buf[len] = ' ';
            len = len + 1;
        }
        bApp(buf, cap, &len, " →  ", 6);
        bApp(buf, cap, &len, b.table[t].path.ptr, b.table[t].path.len);
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len = len + 1;
        }
        t = t + 1;
    }

    // aliased entries: @alias::name → path
    if (b.aliasesLen > 0)
    {
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len = len + 1;
        }
        u8* ah = "# aliases (from build file)";
        bApp(buf, cap, &len, ah, strlen(ah));
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len = len + 1;
        }

        u32 al = 0;
        while (al < b.aliasesLen)
        {
            u32 tt = 0;
            while (tt < b.tableLen)
            {
                Slice folder = b.aliases[al].folder;
                if (b.table[tt].key.len > folder.len + 2 &&
                    bEq(bSlice(b.table[tt].key.ptr, folder.len), folder.ptr, folder.len) &&
                    b.table[tt].key.ptr[folder.len] == ':' && b.table[tt].key.ptr[folder.len + 1] == ':')
                {
                    if (len + 1 < cap)
                    {
                        buf[len] = '@';
                        len = len + 1;
                    }
                    bApp(buf, cap, &len, b.aliases[al].name.ptr, b.aliases[al].name.len);
                    usize rest = folder.len + 2;
                    bApp(buf, cap, &len, b.table[tt].key.ptr + rest, b.table[tt].key.len - rest);
                    usize kk = b.aliases[al].name.len + (b.table[tt].key.len - rest);
                    while (kk < 24 && len < cap)
                    {
                        buf[len] = ' ';
                        len = len + 1;
                        kk = kk + 1;
                    }
                    bApp(buf, cap, &len, " →  ", 6);
                    bApp(buf, cap, &len, b.table[tt].path.ptr, b.table[tt].path.len);
                    if (len + 1 < cap)
                    {
                        buf[len] = '\n';
                        len = len + 1;
                    }
                }
                tt = tt + 1;
            }
            al = al + 1;
        }
    }

    u8 mapC[4096];
    usize mi = 0;
    while (mi < b.mapPath.len && mi < 4095) { mapC[mi] = b.mapPath.ptr[mi]; mi = mi + 1; }
    mapC[mi] = 0;
    bool ok = bWriteFile(mapC, buf, len);
    if (!ok)
    {
        printf("E1000  cannot write %s\n", mapC);
        b.errors = b.errors + 1;
    }
    free(buf);
    return ok;
}

// scan all .crl files for `import prefix::name` / `import folder {` → edges
bool bScanImports(Builder* b)
{
    u32 m = 0;
    while (m < b.modulesLen)
    {
        Slice dirS = b.rootDir;
        // dir for collect = rootDir + module
        u8 dirBuf[4096];
        usize dl = bJoin(dirBuf, 4096, b.rootDir, b.modules[m]);

        Slice* files = (Slice*)b.arena.alloc(512 * sizeof(Slice), 8);
        if (files == null) return false;
        u32 filesLen = 0;
        bCollectCrl(b.arena, dirBuf, bSlice(dirBuf, dl), b.skips, b.skipsLen, files, 512, &filesLen);
        bSortFiles(files, filesLen);

        u32 f = 0;
        while (f < filesLen)
        {
            usize flen = 0;
            Slice content = bReadFile(b.arena, bCStr(b.arena, files[f]), &flen);
            if (content.ptr != null)
            {
                b.mods[m].fingerprint = bFnv(b.mods[m].fingerprint, files[f].ptr, files[f].len);
                b.mods[m].fingerprint = bFnv(b.mods[m].fingerprint, content.ptr, flen);

                usize i = 0;
                while (i < flen)
                {
                    usize lineStart = i;
                    while (i < flen && content.ptr[i] != '\n') i = i + 1;
                    usize lineEnd = i;
                    if (i < flen) i = i + 1;
                    usize p = lineStart;
                    while (p < lineEnd && (content.ptr[p] == ' ' || content.ptr[p] == '\t')) p = p + 1;
                    if (lineEnd - p >= 7)
                    {
                        bool isImport = true;
                        u8* kw = "import ";
                        u32 k = 0;
                        while (k < 7)
                        {
                            if (content.ptr[p + k] != kw[k]) { isImport = false; break; }
                            k = k + 1;
                        }
                        if (isImport)
                        {
                            usize q = p + 7;
                            usize nameStart = q;
                            while (q < lineEnd && ((content.ptr[q] >= 'A' && content.ptr[q] <= 'Z') || (content.ptr[q] >= 'a' && content.ptr[q] <= 'z') || (content.ptr[q] == '_') || (q > nameStart && content.ptr[q] >= '0' && content.ptr[q] <= '9'))) q = q + 1;
                            Slice prefix = bSlice(content.ptr + nameStart, q - nameStart);
                            if (prefix.len > 0)
                            {
                                Slice folder;
                                if (bResolvePrefix(b, prefix, &folder))
                                {
                                    i32 targetIdx = bModuleIdx(b, folder);
                                    if (targetIdx >= 0 && (u32)targetIdx != m)
                                    {
                                        // self-target export must exist unless surface import
                                        bool okEntry = false;
                                        if (q + 1 < lineEnd && content.ptr[q] == ':' && content.ptr[q + 1] == ':')
                                        {
                                            usize r = q + 2;
                                            usize expStart = r;
                                            while (r < lineEnd && ((content.ptr[r] >= 'A' && content.ptr[r] <= 'Z') || (content.ptr[r] >= 'a' && content.ptr[r] <= 'z') || (content.ptr[r] == '_') || (r > expStart && content.ptr[r] >= '0' && content.ptr[r] <= '9'))) r = r + 1;
                                            Slice exp = bSlice(content.ptr + expStart, r - expStart);
                                            u32 t = 0;
                                            while (t < b.tableLen)
                                            {
                                                if (bEq(b.table[t].key, folder.ptr, folder.len))
                                                {
                                                    if (b.table[t].key.len > folder.len + 2 + exp.len &&
                                                        b.table[t].key.ptr[folder.len] == ':' &&
                                                        b.table[t].key.ptr[folder.len + 1] == ':' &&
                                                        bEq(bSlice(b.table[t].key.ptr + folder.len + 2, exp.len), exp.ptr, exp.len))
                                                    {
                                                        okEntry = true;
                                                        break;
                                                    }
                                                }
                                                t = t + 1;
                                            }
                                            if (!okEntry)
                                            {
                                                u8 fileBuf[4096];
                                                usize fi = 0;
                                                while (fi < files[f].len && fi < 4095) { fileBuf[fi] = files[f].ptr[fi]; fi = fi + 1; }
                                                fileBuf[fi] = 0;
                                                u8 impBuf[512];
                                                usize ii = 0;
                                                while (ii < folder.len && ii < 511) { impBuf[ii] = folder.ptr[ii]; ii = ii + 1; }
                                                impBuf[ii] = ':'; impBuf[ii + 1] = ':'; ii = ii + 2;
                                                usize e = 0;
                                                while (e < exp.len && ii < 511) { impBuf[ii] = exp.ptr[e]; ii = ii + 1; e = e + 1; }
                                                impBuf[ii] = 0;
                                                bError(b, "E1005", "unresolved module import", "file", fileBuf, "import", impBuf,
                                                       "is the module in `modules`?");
                                            }
                                        }
                                        else
                                        {
                                            // surface import: folder must have at least one export OR be in modules
                                            okEntry = bModuleIdx(b, folder) >= 0;
                                        }
                                        if (okEntry || (u32)targetIdx < b.modulesLen)
                                        {
                                            ModNode* node = b.mods + m;
                                            bool dup = false;
                                            u32 d = 0;
                                            while (d < node.depsLen)
                                            {
                                                if (node.deps[d] == (u32)targetIdx) { dup = true; break; }
                                                d = d + 1;
                                            }
                                            if (!dup)
                                            {
                                                if (node.depsLen >= node.depsCap)
                                                {
                                                    u32 newCap = 8;
                                                    if (node.depsCap != 0) newCap = node.depsCap * 2;
                                                    u32* fresh = (u32*)b.arena.alloc(newCap * sizeof(u32), 4);
                                                    if (fresh == null) return false;
                                                    u32 d2 = 0;
                                                    while (d2 < node.depsLen) { fresh[d2] = node.deps[d2]; d2 = d2 + 1; }
                                                    node.deps = fresh;
                                                    node.depsCap = newCap;
                                                }
                                                node.deps[node.depsLen] = (u32)targetIdx;
                                                node.depsLen = node.depsLen + 1;
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    u8 fileBuf[4096];
                                    usize fi = 0;
                                    while (fi < files[f].len && fi < 4095) { fileBuf[fi] = files[f].ptr[fi]; fi = fi + 1; }
                                    fileBuf[fi] = 0;
                                    u8 impBuf[512];
                                    usize ii = 0;
                                    while (ii < prefix.len && ii < 511) { impBuf[ii] = prefix.ptr[ii]; ii = ii + 1; }
                                    impBuf[ii] = 0;
                                    bError(b, "E1005", "unresolved module import", "file", fileBuf, "import", impBuf,
                                           "is coral-common in `modules`?");
                                }
                            }
                        }
                    }
                }
            }
            f = f + 1;
        }
        m = m + 1;
    }
    return true;
}

// DFS topo + cycle detect
bool bDfs(Builder* b, u32 idx, u8* state, u32* stack, u32* stackLen, u32* out, u32* outLen)
{
    state[idx] = 1;
    stack[*stackLen] = idx;
    *stackLen = *stackLen + 1;
    u32 d = 0;
    while (d < b.mods[idx].depsLen)
    {
        u32 dep = b.mods[idx].deps[d];
        if (state[dep] == 1)
        {
            printf("E1006  dependency cycle\n  cycle:  ");
            u32 s = 0;
            while (s < *stackLen)
            {
                usize n = 0;
                while (n < b.mods[stack[s]].name.len) { printf("%c", b.mods[stack[s]].name.ptr[n]); n = n + 1; }
                printf(" -> ");
                s = s + 1;
            }
            usize n = 0;
            while (n < b.mods[dep].name.len) { printf("%c", b.mods[dep].name.ptr[n]); n = n + 1; }
            printf("\n");
            b.errors = b.errors + 1;
            return false;
        }
        if (state[dep] == 0)
        {
            if (!bDfs(b, dep, state, stack, stackLen, out, outLen)) return false;
        }
        d = d + 1;
    }
    *stackLen = *stackLen - 1;
    state[idx] = 2;
    out[*outLen] = idx;
    *outLen = *outLen + 1;
    return true;
}

bool bTopo(Builder* b)
{
    u8* state = (u8*)b.arena.alloc(b.modulesLen, 1);
    u32* stack = (u32*)b.arena.alloc(b.modulesLen * sizeof(u32), 4);
    u32* out = (u32*)b.arena.alloc(b.modulesLen * sizeof(u32), 4);
    if (state == null || stack == null || out == null) return false;
    u32 i = 0;
    while (i < b.modulesLen) { state[i] = 0; i = i + 1; }
    b.topoOrder = out;
    b.topoLen = 0;
    u32 stackLen = 0;
    i = 0;
    while (i < b.modulesLen)
    {
        if (state[i] == 0)
        {
            if (!bDfs(b, i, state, stack, &stackLen, out, &b.topoLen)) return false;
        }
        i = i + 1;
    }
    return true;
}

bool bWriteGraph(Builder* b)
{
    syscall(83, ".coral", 493);
    usize cap = 65536;
    u8* buf = (u8*)malloc(cap);
    if (buf == null) return false;
    usize len = 0;
    u8* start = "digraph coral {\n  rankdir=BT;\n";
    bApp(buf, cap, &len, start, strlen(start));
    u32 m = 0;
    while (m < b.modulesLen)
    {
        u32 d = 0;
        while (d < b.mods[m].depsLen)
        {
            bApp(buf, cap, &len, "  \"", 3);
            bApp(buf, cap, &len, b.mods[m].name.ptr, b.mods[m].name.len);
            bApp(buf, cap, &len, "\" -> \"", 6);
            bApp(buf, cap, &len, b.mods[b.mods[m].deps[d]].name.ptr, b.mods[b.mods[m].deps[d]].name.len);
            bApp(buf, cap, &len, "\";\n", 3);
            d = d + 1;
        }
        m = m + 1;
    }
    bApp(buf, cap, &len, "}\n", 2);
    bool ok = bWriteFile(".coral/graph.dot", buf, len);
    free(buf);
    if (!ok)
    {
        printf("E1000  cannot write .coral/graph.dot\n");
        b.errors = b.errors + 1;
    }
    return ok;
}

bool bWriteFp(Builder* b, u32 modIdx)
{
    syscall(83, ".coral", 493);
    syscall(83, ".coral/cache", 493);
    u8 pathC[512];
    usize n = 0;
    u8* pre = ".coral/cache/";
    while (n < 13) { pathC[n] = pre[n]; n = n + 1; }
    usize i = 0;
    while (i < b.mods[modIdx].name.len && n < 500) { pathC[n] = b.mods[modIdx].name.ptr[i]; n = n + 1; i = i + 1; }
    u8* fp = ".fp";
    pathC[n] = fp[0]; pathC[n + 1] = fp[1]; pathC[n + 2] = fp[2]; pathC[n + 3] = 0;
    u8 hex[17];
    u64 v = b.mods[modIdx].fingerprint;
    u32 s = 0;
    while (s < 16)
    {
        u32 nib = (u32)((v >> ((15 - s) * 4)) & 15);
        if (nib < 10) hex[s] = (u8)(48 + nib);
        else hex[s] = (u8)(87 + nib);
        s = s + 1;
    }
    hex[16] = 0;
    return bWriteFile(pathC, hex, 16);
}

bool bCheckFp(Builder* b, u32 modIdx)
{
    if (b.force) return true;
    u8 pathC[512];
    usize n = 0;
    u8* pre = ".coral/cache/";
    while (n < 13) { pathC[n] = pre[n]; n = n + 1; }
    usize i = 0;
    while (i < b.mods[modIdx].name.len && n < 500) { pathC[n] = b.mods[modIdx].name.ptr[i]; n = n + 1; i = i + 1; }
    u8* fp = ".fp";
    pathC[n] = fp[0]; pathC[n + 1] = fp[1]; pathC[n + 2] = fp[2]; pathC[n + 3] = 0;
    usize len = 0;
    Slice got = bReadFile(b.arena, pathC, &len);
    if (got.ptr == null || len < 16) return true;
    u8 hex[17];
    u64 v = b.mods[modIdx].fingerprint;
    u32 s = 0;
    while (s < 16)
    {
        u32 nib = (u32)((v >> ((15 - s) * 4)) & 15);
        if (nib < 10) hex[s] = (u8)(48 + nib);
        else hex[s] = (u8)(87 + nib);
        s = s + 1;
    }
    u32 c = 0;
    while (c < 16)
    {
        if (got.ptr[c] != hex[c]) return true;
        c = c + 1;
    }
    return false;
}

pub i32 builderRun(Node* cfgRoot, Arena* a, bool forceIn, bool emitMapOnlyIn)
{
    Builder b;
    if (!bInit(&b, a, cfgRoot, forceIn, emitMapOnlyIn)) return b.errors;

    u32 m = 0;
    while (m < b.modulesLen)
    {
        u8 dirBuf[4096];
        usize dl = bJoin(dirBuf, 4096, b.rootDir, b.modules[m]);
        if (!bScanLib(&b, b.modules[m], dirBuf))
        {
            m = m + 1;
            continue;
        }
        m = m + 1;
    }
    if (b.errors > 0) return b.errors;

    if (!bValidateAliases(&b)) return b.errors;
    if (!bWriteMap(&b)) return b.errors;
    if (!bScanImports(&b)) return b.errors;
    if (!bTopo(&b)) return b.errors;
    if (!bWriteGraph(&b)) return b.errors;

    // fingerprint pass: fold dep fps into module fps (reverse topo = deps first)
    u32 i = 0;
    while (i < b.topoLen)
    {
        u32 idx = b.topoOrder[i];
        u32 d = 0;
        while (d < b.mods[idx].depsLen)
        {
            b.mods[idx].fingerprint = bFnv(b.mods[idx].fingerprint, (u8*)&b.mods[b.mods[idx].deps[d]].fingerprint, 8);
            d = d + 1;
        }
        b.mods[idx].stale = bCheckFp(&b, idx);
        i = i + 1;
    }

    printf("modules.map written (%d entries, %d aliases)\n", (i32)b.tableLen, (i32)b.aliasesLen);
    if (!emitMapOnlyIn)
    {
        i = 0;
        while (i < b.topoLen)
        {
            u32 idx = b.topoOrder[i];
            usize n = 0;
            while (n < b.mods[idx].name.len) { printf("%c", b.mods[idx].name.ptr[n]); n = n + 1; }
            if (b.mods[idx].stale) printf("  stale\n");
            else printf("  fresh\n");
            i = i + 1;
        }
    }
    return b.errors;
}
