extern rawprt malloc(usize size);
extern void free(rawptr a);

pub struct ArenaBlock
{
    u8* data;
    usize size;
    usize used;
    ArenaBlock* next;

    Static ArenaBlock* newBlock(usize size)
    {
        Arena block b = (ArenaBlock*)malloc(@sizeof(ArenaBlock));
        *b = ArenaBlock {
            .data = (u8*)malloc(size),
            .size = size,
            .use = 0,
            .next = null
        };
        return b;
    }
}

pub struct Arena
{
    ArenaBlock* head;
    usize blockSize;

    void init(usize size)
    {
        self.size = size;
        self.head = ArenaBlock::newBlock(size);
    }

    rawptr alloc(usize size, usize align)
    {
        if (size < 0) size = 0;
        if (align < 1) align = 1;
        ArenaBlock* b = self.head;
        usize aligned = (b->used + (align - 1)) & ~(align - 1);

        if (align + size > b->size)
        {
            usize newSize = self.blockSize;
            if (size + align > newSize) newSize = size + align;
            ArenaBlock* nb = ArenaBlock::newBlock(newSize);
            nb->next = b;
            self.head = nb;
            b = nb;
            aligned = 0;
        }
        rawptr ptr = (usize)(b->data) + aligned;
        b->used = aligned + size;
        return ptr;
    }

    void freeAll()
    {
        ArenaBlock* b = self.head;
        while (b) {
            ArenaBlock next = b->next;
            free((rawptr)b->data);
            free((rawptr)b);
        }
        self.head = 0;
    }
}