mod slice = import "../coral-common/slice" { Slice };
mod arena = import "arena" { Arena };

pub Variant Value
{
    string { Slice; },
    number { i64; },
    boolean { bool boolean; },
    list { ValueArrray* list; }
}

extend Value
{
    // static Value ofString(Slice s)
    // static Value ofNumber(i64 n)
    // static Value ofBool(bool b)
    // static Value ofList(ValueArray* l)
}

pub struct Field
{
    Slice name;
    Value value;
}

pub struct FieldArray
{
    Field* data;
    usize len;
    usize cap;
    Arena arena;
}

pub enum NodeKind
{
    ROOT,
    SCHEMA,
    STRICT,
    BUILD,
    WORKSPACE,
    PROFILE,
    ALIAS,
    TASK,
    TEST,
    BENCH,
    HOOK,
    PHASE,
    TARGET,
    LINK,
    ARTIFACT,
    FEATURES,
    ENV,
    LOG,
    METRICS,
    LINT,
    FORMAT,
    LSP,
    CI,
    REMOTE,
    DEPS,
    DEP_ENTRY,
    OVERRIDE,
    INCLUDE
}

pub u8* nodeKindName(NodeKind k) const

struct Node {
    NodeKind kind;
    Slice label;          // build/override/task/target/... label, or
                        // alias's IDENT name
    bool hasLabel;
    Slice extendsTarget;   // build/profile "extends" target
    bool hasExtends;
    Slice payload;         // alias's STRING target, or include's path
    bool hasPayload;

    FieldArray fields;    // plain "name = value ;" entries
    ChildArray children;  // nested blocks (override, env, target, link,
                          // artifact, features, log, metrics, dep_entry)

    void init(NodeKind kind, Arena* arena)
    void addField(Slice name, Value v)
    void addChild(Node* child)
};

pub struct ChildArray
{
    Node* data;
    usize len;
    usize cap;
    Arena arena;
}
