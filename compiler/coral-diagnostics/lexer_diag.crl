import "slice" { Slice };

extern("C") i32 printf(u8* fmt, ...);

extern("C") i32 write(i32 fd, void* buf, usize len);

pub struct DiagnosticEngine
{
    usize errors;

    void reportError(self, u8* bufStart,
                     u8* bufEnd,
                     u8* errPtr,
                     u8* message)
    {
        self.errors++;
        u8* lineStart = errPtr;
        
        while (lineStart > bufStart && lineStart[-1] != '\n')
            lineStart--;

        u8* lineEnd = errPtr;
        
        while (lineEnd < bufEnd && lineEnd[0] != '\n' && lineEnd[0] != '\r')
            lineEnd++;

        usize lineNum = 1;
        u8* scan = bufStart;
        
        while (scan < lineStart)
        {
            if (scan[0] == '\n')
                lineNum++; 
            scan++;
        }

        usize colNum = (usize)(errPtr - lineStart) + 1;
        usize lineLen = (usize)(lineEnd - lineStart);
        Slice lineStr = Slice::from(lineStart, lineLen);

        printf("%llu : %llu: error: \n %s\n", lineNum, colNum, message);

        printf("%s\n", lineStr.ptr);
        
        self.printp((i32)colNum, Slice::from((u8*)"\n^", 3));
    }

    void printp(self, i32 padding, Slice s) 
    {
        for (i32 i = 0; i < padding; i++)
        {
            write(1, " ", 1);
        }
        write(1, s.ptr, s.len);
    }
}
