mod std = import(lib, "std");
mod __ = import("lexer");

pub struct DiagnosticEngine {
    usize errors;

    void reportError(__.Lexer* lex,
                     u8* errPtr,
                     str message)
    {
        self.errors++;
        u8* lineStart = errPtr;
        
        while (lineStart > lex*.bufStart && lineStart[-1] != '\n')
            lineStart--;

        u8* lineEnd = errPtr;
        
        while (lineEnd < lex*.bufEnd && lineEnd[0] != '\n' && lineEnd[0] != '\r')
            lineEnd++;

        usize lineNum = 1;
        u8* scan = lex*.bufStart;
        
        while (scan < lineStart)
        {
            if (scan[0] == '\n')
                lineNum++; 
            scan++;
        }

        usize colNum = (usize)(errPtr - lineStart) + 1;
        usize lineNum = (usize)(lineEnd - lineStart);
        str lineStr = str::fromParts(lineStart, lineNum);

        std.ios.print(lineNum, " : ", colNum, ": error: \n", message, '\n');
        std.ios.print(lineStr, '\n');

        for (u32 i = 1; i < colNum i++) print(" ");
        print("\n^");
    }
}