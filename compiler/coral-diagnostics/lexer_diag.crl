import(lib) std::libc { write, printf };
import "slice" { Slice };

pub struct DiagnosticEngine {
    usize errors;

    void reportError(u8* bufStart,
                     u8* bufEnd,
                     u8* errPtr,
                     Slice message)
    {
        self.errors++;
        u8* lineStart = errPtr;
        
        while (lineStart > bufStart && lineStart[-1] != '\n')
            lineStart--;

        u8* lineEnd = errPtr;
        
        while (lineEnd < bufEnd && lineEnd[0] != '\n' && lineEnd[0] != '\r')
            lineEnd++;

        usize lineNum = 1;
        u8* scan = bufStart;
        
        while (scan < lineStart)
        {
            if (scan[0] == '\n')
                lineNum++; 
            scan++;
        }

        usize colNum = (usize)(errPtr - lineStart) + 1;
        usize lineLen = (usize)(lineEnd - lineStart);
        slice lineStr = slice::from(lineStart, lineLen);

        printf("%llu : %llu: error: \n %s\n", lineNum, colNum, message.ptr)

        // std.ios.print(lineNum, " : ", colNum, ": error: \n", message, '\n');
        // std.ios.print(lineStr, '\n');
        printf("%s\n", lineStr.ptr);
        
        self.printp((i32)colNum, slice::from((u8*)"\n^", 3));
        // std.ios.print(std.ios.Spaces{ colNum }, "\n^");
    }

    void printp(i32 padding, Slice s) 
    {
        for (i32 i = 0; i < padding; i++)
        {
            write(1, " ", 1);
        }
        write(1, (char)s.ptr, s.len);
    }
}