/* diagnostics/error_code.crl — unique error numbers
 *
 * Follows Clang's DiagnosticIDs design: each diagnostic has a unique ID.
 * Ranges:
 *   1000-1999  Lexer errors
 *   2000-2999  Parser errors
 *   3000-3999  Semantic errors (name resolution, type checking)
 *   4000-4999  Codegen errors
 *   5000-5999  Driver errors (file I/O, flags)
 */

pub enum ErrorCode
{
    // Lexer errors 1000-1999 
    LexUnknownChar,
    LexUnterminatedString,
    LexUnterminatedChar,
    LexUnterminatedComment,
    LexInvalidEscape,
    LexInvalidNumber,
    LexInvalidChar,

    // Parser errors 2000-2999 
    ParseExpectedToken,
    ParseExpectedExpr,
    ParseExpectedType,
    ParseExpectedDecl,
    ParseExpectedStmt,
    ParseUnexpectedEof,
    ParseInvalidAssignTarget,
    ParseDuplicateModifier,
    ParseMissingSemicolon,
    ParseCondAssign,

    // Semantic errors 3000-3999 
    SemaUndeclaredIdent,
    SemaTypeMismatch,
    SemaArityMismatch,
    SemaDuplicateDecl,
    SemaInvalidCast,
    SemaUnknownMember,
    SemaInternal,

    // Codegen errors 4000-4999 
    CodegenUnsupported,
    CodegenInternal,

    // Driver errors 5000-5999 
    DriverFileNotFound,
    DriverInvalidFlag,
    DriverOutOfMemory
}

/* stable diagnostic codes — call sites report one of these (plus a
 * location and an optional help line); error.crl renders everything.
 *   LEX-XXXX  lexer
 *   PAR-XXXX  parser
 *   TC-XXXX   type check / semantic analysis
 *   CG-XXXX   codegen
 *   DRV-XXXX  driver
 */
u8* codeStr(ErrorCode code)
{
    switch (code)
    {
        ErrorCode::LexUnknownChar => { return "LEX-0001"; },
        ErrorCode::LexUnterminatedString => { return "LEX-0002"; },
        ErrorCode::LexUnterminatedChar => { return "LEX-0003"; },
        ErrorCode::LexUnterminatedComment => { return "LEX-0004"; },
        ErrorCode::LexInvalidEscape => { return "LEX-0005"; },
        ErrorCode::LexInvalidNumber => { return "LEX-0006"; },
        ErrorCode::LexInvalidChar => { return "LEX-0007"; },
        ErrorCode::ParseExpectedToken => { return "PAR-0001"; },
        ErrorCode::ParseExpectedExpr => { return "PAR-0002"; },
        ErrorCode::ParseExpectedType => { return "PAR-0003"; },
        ErrorCode::ParseExpectedDecl => { return "PAR-0004"; },
        ErrorCode::ParseExpectedStmt => { return "PAR-0005"; },
        ErrorCode::ParseUnexpectedEof => { return "PAR-0006"; },
        ErrorCode::ParseInvalidAssignTarget => { return "PAR-0007"; },
        ErrorCode::ParseDuplicateModifier => { return "PAR-0008"; },
        ErrorCode::ParseMissingSemicolon => { return "PAR-0009"; },
        ErrorCode::ParseCondAssign => { return "PAR-0010"; },
        ErrorCode::SemaUndeclaredIdent => { return "TC-0001"; },
        ErrorCode::SemaTypeMismatch => { return "TC-0002"; },
        ErrorCode::SemaArityMismatch => { return "TC-0003"; },
        ErrorCode::SemaDuplicateDecl => { return "TC-0004"; },
        ErrorCode::SemaInvalidCast => { return "TC-0005"; },
        ErrorCode::SemaUnknownMember => { return "TC-0006"; },
        ErrorCode::SemaInternal => { return "TC-0007"; },
        ErrorCode::CodegenUnsupported => { return "CG-0001"; },
        ErrorCode::CodegenInternal => { return "CG-0002"; },
        ErrorCode::DriverFileNotFound => { return "DRV-0001"; },
        ErrorCode::DriverInvalidFlag => { return "DRV-0002"; },
        ErrorCode::DriverOutOfMemory => { return "DRV-0003"; },
        else => { return "COR-0000"; }
    }
}
