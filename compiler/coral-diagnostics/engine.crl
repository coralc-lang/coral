/* diagnostics/engine.crl — multi-span diagnostic engine
 *
 * Diagnostic: code, severity, message, detail, labels, why, fix, learn.
 * Label: span + text + primary/secondary.
 * Renderer: groups by file, gutter, underlines (^ or ──┬──), connectors (╰─).
 */

mod code = import "code" { ErrorCode };
mod msg = import "msg" { Severity };
mod span = import "span" { Span, Label, SourceMap };
mod id = import "../coral-ast/id" { Str };;

extern("C") i32 printf(u8* fmt, ...);
extern("C") i32 write(i32 fd, u8* buf, usize len);

pub struct Diagnostic
{
    u32 code;
    u32 severity;
    u8* message;
    u8* detail;
    Label* labels;
    u32 labelsLen;
    u8* why;
    u8* fix;
    u8* learn;
}

pub struct DiagnosticEngine
{
    usize errors;
    usize warnings;
    usize errorLimit;
    usize lexerErrors;
    usize parserErrors;
    u8* bufStart;
    u8* bufEnd;
    SourceMap* sourceMap;
}

pub extend DiagnosticEngine
{
    void init(u8* bufStart, u8* bufEnd)
    {
        self.errors = 0;
        self.warnings = 0;
        self.errorLimit = 20;
        self.lexerErrors = 0;
        self.parserErrors = 0;
        self.bufStart = bufStart;
        self.bufEnd = bufEnd;
        self.sourceMap = null;
    }

    usize errorCount() { return self.errors; }
    usize warningCount() { return self.warnings; }
    usize lexerErrorCount() { return self.lexerErrors; }
    usize parserErrorCount() { return self.parserErrors; }
    bool hasErrors() { return self.errors > 0; }
    bool tooManyErrors() { return self.errorLimit == 0 || self.errors >= self.errorLimit; }

    void setBuffer(u8* bufStart, u8* bufEnd)
    {
        if (bufStart != null) self.bufStart = bufStart;
        if (bufEnd != null) self.bufEnd = bufEnd;
    }

    void emitErrorAt(ErrorCode code, u8* bufStart, u8* bufEnd, u8* errPtr, u8* msg)
    {
        bool shouldRender = !self.tooManyErrors();
        self.errors = self.errors + 1;
        self.setBuffer(bufStart, bufEnd);
        if (errPtr == null) errPtr = self.bufStart;
        if (shouldRender) self.renderSimple(code, errPtr, msg, "error");
    }

    void emitLexerError(ErrorCode code, u8* bufStart, u8* bufEnd, u8* errPtr, u8* msg)
    {
        bool shouldRender = !self.tooManyErrors();
        self.errors = self.errors + 1;
        self.lexerErrors = self.lexerErrors + 1;
        self.setBuffer(bufStart, bufEnd);
        if (errPtr == null) errPtr = self.bufStart;
        if (shouldRender) self.renderSimple(code, errPtr, msg, "error");
    }

    void emitParserError(ErrorCode code, u8* bufStart, u8* bufEnd, u8* errPtr, u8* msg)
    {
        bool shouldRender = !self.tooManyErrors();
        self.errors = self.errors + 1;
        self.parserErrors = self.parserErrors + 1;
        self.setBuffer(bufStart, bufEnd);
        if (errPtr == null) errPtr = self.bufStart;
        if (shouldRender) self.renderSimple(code, errPtr, msg, "error");
    }

    void reportError(u8* bufStart, u8* bufEnd, u8* errPtr, u8* msg) { self.emitLexerError(ErrorCode::LexInvalidChar, bufStart, bufEnd, errPtr, msg); }
    void emitError(ErrorCode code, u8* errPtr, u8* msg) { self.emitErrorAt(code, self.bufStart, self.bufEnd, errPtr, msg); }

    void emitWarning(ErrorCode code, u8* errPtr, u8* msg)
    {
        self.warnings = self.warnings + 1;
        if (errPtr == null) errPtr = self.bufStart;
        self.renderSimple(code, errPtr, msg, "warning");
    }

    void emitNote(ErrorCode code, u8* errPtr, u8* msg)
    {
        if (errPtr == null) errPtr = self.bufStart;
        self.renderSimple(code, errPtr, msg, "note");
    }

    void emitFatal(ErrorCode code, u8* errPtr, u8* msg)
    {
        self.errors = self.errors + 1;
        if (errPtr == null) errPtr = self.bufStart;
        self.renderSimple(code, errPtr, msg, "fatal error");
    }

    void renderSimple(ErrorCode code, u8* errPtr, u8* msg, u8* level)
    {
        if (self.bufStart == null || self.bufEnd == null)
        {
            u8* safeLevel = level != null ? level : (u8*)"error";
            u8* safeMsg = msg != null ? msg : (u8*)"diagnostic";
            printf("%s: %s\n", safeLevel, safeMsg);
            return;
        }
        if (errPtr == null || errPtr < self.bufStart) errPtr = self.bufStart;
        if (errPtr > self.bufEnd) errPtr = self.bufEnd;

        u8* lineStart = errPtr;
        while (lineStart > self.bufStart)
        {
            u8* prev = lineStart - 1;
            if (prev[0] == '\n') break;
            lineStart = prev;
        }

        u8* lineEnd = errPtr;
        while (lineEnd < self.bufEnd)
        {
            if (lineEnd[0] == '\n') break;
            if (lineEnd[0] == '\r') break;
            lineEnd = lineEnd + 1;
        }

        usize lineNum = 1;
        u8* scan = self.bufStart;
        while (scan < lineStart)
        {
            if (scan[0] == '\n') lineNum = lineNum + 1;
            scan = scan + 1;
        }

        usize colNum = (usize)(errPtr - lineStart) + 1;
        u8* safeLevel = level != null ? level : (u8*)"error";
        u8* safeMsg = msg != null ? msg : (u8*)"diagnostic";

        printf("%llu:%llu: %s: %s\n", lineNum, colNum, safeLevel, safeMsg);

        usize lineLen = (usize)(lineEnd - lineStart);
        write(1, lineStart, lineLen);
        write(1, "\n", 1);

        i32 i = 1;
        while (i < (i32)colNum)
        {
            write(1, " ", 1);
            i = i + 1;
        }
        write(1, "^\n", 2);
    }

    void renderDiagnostic(Diagnostic* diag)
    {
        if (diag == null) return;
        u8* sevStr = "error";
        if (diag.severity == 2) sevStr = "warning";
        if (diag.severity == 1) sevStr = "note";
        if (diag.severity == 4) sevStr = "fatal error";

        printf("%s: %s\n", sevStr, diag.message != null ? diag.message : (u8*)"diagnostic");
        if (diag.detail != null) printf("  %s\n", diag.detail);

        u32 i = 0;
        while (i < diag.labelsLen)
        {
            Label* lbl = diag.labels + i;
            if (lbl != null) self.renderLabel(lbl);
            i = i + 1;
        }

        if (diag.why != null) printf("  why    %s\n", diag.why);
        if (diag.fix != null) printf("  fix    %s\n", diag.fix);
        if (diag.learn != null) printf("  learn  %s\n", diag.learn);
    }

    void renderLabel(Label* lbl)
    {
        if (lbl == null || self.bufStart == null || self.bufEnd == null) return;
        u32 start = lbl.span.start;
        u32 end = lbl.span.end;
        if (start > (usize)(self.bufEnd - self.bufStart)) start = (usize)(self.bufEnd - self.bufStart);
        if (end < start) end = start;
        if (end > (usize)(self.bufEnd - self.bufStart)) end = (usize)(self.bufEnd - self.bufStart);

        u8* errPtr = self.bufStart + start;
        u8* lineStart = errPtr;
        while (lineStart > self.bufStart)
        {
            u8* prev = lineStart - 1;
            if (prev[0] == '\n') break;
            lineStart = prev;
        }

        u8* lineEnd = errPtr;
        while (lineEnd < self.bufEnd)
        {
            if (lineEnd[0] == '\n') break;
            if (lineEnd[0] == '\r') break;
            lineEnd = lineEnd + 1;
        }

        usize lineNum = 1;
        u8* scan = self.bufStart;
        while (scan < lineStart)
        {
            if (scan[0] == '\n') lineNum = lineNum + 1;
            scan = scan + 1;
        }

        usize startCol = (usize)(errPtr - lineStart);
        u32 spanLen = end - start;
        usize lineLen = (usize)(lineEnd - lineStart);
        printf("  %llu | ", lineNum);
        write(1, lineStart, lineLen);
        write(1, "\n", 1);
        printf("       | ");

        usize j = 0;
        while (j < startCol)
        {
            write(1, " ", 1);
            j = j + 1;
        }

        if (spanLen <= 1)
        {
            write(1, "^", 1);
        }
        else
        {
            u32 k = 0;
            u32 mid = spanLen / 2;
            while (k < spanLen)
            {
                if (k == mid) write(1, "+", 1);
                else write(1, "-", 1);
                k = k + 1;
            }
        }
        write(1, "\n", 1);

        printf("       | ");
        j = 0;
        if (spanLen > 1)
        {
            u32 mid2 = spanLen / 2;
            while (j < startCol + mid2)
            {
                write(1, " ", 1);
                j = j + 1;
            }
        }
        else
        {
            while (j < startCol)
            {
                write(1, " ", 1);
                j = j + 1;
            }
        }
        printf("`- %s\n", lbl.text != null ? lbl.text : (u8*)"label");
    }
}
