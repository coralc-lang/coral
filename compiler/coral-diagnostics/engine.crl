/* diagnostics/engine.crl — diagnostic engine
 *
 * Owns the file table (file id -> path + buffer) and the error counters.
 * Every diagnostic funnels through error.crl, which owns the formatting.
 * Call sites report a stable ErrorCode + SourceLoc + message + optional
 * help line; the engine resolves the location against the right file.
 */

mod code = import "code" { ErrorCode, codeStr };
mod error = import "error";
mod id = import "../coral-ast/id" { SourceLoc, locFile, locLine, locCol };

extern("C") i32 printf(u8* fmt, ...);
extern("C") i32 write(i32 fd, u8* buf, usize len);

pub struct DiagnosticEngine
{
    usize errors;
    usize warnings;
    usize errorLimit;
    usize lexerErrors;
    usize parserErrors;
    u8* bufStart;
    u8* bufEnd;
    u8** filePaths;
    usize* filePathLens;
    u8** fileBufs;
    u8** fileBufEnds;
    u32 fileCount;
    u32 fileCap;

    void init(u8* bufStart, u8* bufEnd)
    {
        self = DiagnosticEngine {
            .errors = 0,
            .warnings = 0,
            .errorLimit = 20,
            .lexerErrors = 0,
            .parserErrors = 0,
            .bufStart = bufStart,
            .bufEnd = bufEnd,
            .filePaths = null,
            .filePathLens = null,
            .fileBufs = null,
            .fileBufEnds = null,
            .fileCount = 0,
            .fileCap = 0,
        };
    }

    usize errorCount() { return self.errors; }
    usize warningCount() { return self.warnings; }
    usize lexerErrorCount() { return self.lexerErrors; }
    usize parserErrorCount() { return self.parserErrors; }
    bool hasErrors() { return self.errors > 0; }
    bool tooManyErrors() { return self.errorLimit == 0 || self.errors >= self.errorLimit; }

    /* register a source file; returns its file id */
    u32 addFile(u8* path, usize pathLen, u8* bufStart, u8* bufEnd)
    {
        if (self.fileCount >= self.fileCap)
        {
            u32 newCap = self.fileCap == 0 ? 8 : self.fileCap * 2;
            u8** np = (u8**)malloc((usize)newCap * sizeof(u8*));
            usize* nl = (usize*)malloc((usize)newCap * sizeof(usize));
            u8** nb = (u8**)malloc((usize)newCap * sizeof(u8*));
            u8** ne = (u8**)malloc((usize)newCap * sizeof(u8*));
            if (np == null || nl == null || nb == null || ne == null)
            {
                if (np != null) free((rawptr)np);
                if (nl != null) free((rawptr)nl);
                if (nb != null) free((rawptr)nb);
                if (ne != null) free((rawptr)ne);
                return 0;
            }
            u32 i = 0;
            while (i < self.fileCount)
            {
                np[i] = self.filePaths[i];
                nl[i] = self.filePathLens[i];
                nb[i] = self.fileBufs[i];
                ne[i] = self.fileBufEnds[i];
                i = i + 1;
            }
            if (self.filePaths != null) free((rawptr)self.filePaths);
            if (self.filePathLens != null) free((rawptr)self.filePathLens);
            if (self.fileBufs != null) free((rawptr)self.fileBufs);
            if (self.fileBufEnds != null) free((rawptr)self.fileBufEnds);
            self.filePaths = np;
            self.filePathLens = nl;
            self.fileBufs = nb;
            self.fileBufEnds = ne;
            self.fileCap = newCap;
        }
        u32 id = self.fileCount;
        self.filePaths[id] = path;
        self.filePathLens[id] = pathLen;
        self.fileBufs[id] = bufStart;
        self.fileBufEnds[id] = bufEnd;
        self.fileCount = self.fileCount + 1;
        return id;
    }

    /* resolve a SourceLoc to a pointer into the owning file's buffer */
    u8* locPtr(SourceLoc loc)
    {
        u32 file = locFile(loc);
        u32 line = locLine(loc);
        u32 col = locCol(loc);
        if (file >= self.fileCount) return self.bufStart;
        u8* buf = self.fileBufs[file];
        u8* end = self.fileBufEnds[file];
        if (buf == null) return null;
        if (line == 0) return buf;
        u32 curLine = 1;
        u8* p = buf;
        while (p < end && curLine < line)
        {
            if (p[0] == 10) curLine = curLine + 1;
            p = p + 1;
        }
        if (col == 0) col = 1;
        u32 c = 1;
        while (p < end && c < col && p[0] != 10 && p[0] != 13)
        {
            p = p + 1;
            c = c + 1;
        }
        return p;
    }

    void emitError(ErrorCode code, SourceLoc loc, u8* msg, u8* help)
    {
        self.errors = self.errors + 1;
        if (self.tooManyErrors()) return;
        self.renderAt(code, "error", loc, msg, help);
    }

    void emitWarning(ErrorCode code, SourceLoc loc, u8* msg, u8* help)
    {
        self.warnings = self.warnings + 1;
        if (self.tooManyErrors()) return;
        self.renderAt(code, "warning", loc, msg, help);
    }

    void emitNote(ErrorCode code, SourceLoc loc, u8* msg, u8* help)
    {
        self.renderAt(code, "note", loc, msg, help);
    }

    void emitFatal(ErrorCode code, SourceLoc loc, u8* msg, u8* help)
    {
        self.errors = self.errors + 1;
        self.renderAt(code, "fatal error", loc, msg, help);
    }

    void renderAt(ErrorCode code, u8* level, SourceLoc loc, u8* msg, u8* help)
    {
        u8* ptr = self.locPtr(loc);
        if (ptr == null)
        {
            printf("%s[%s]: %s\n", level, codeStr(code), msg != null ? msg : (u8*)"diagnostic");
            return;
        }
        u32 file = locFile(loc);
        u32 line = locLine(loc);
        u32 col = locCol(loc);
        u8* fileBuf = self.fileBufs[file];
        u8* fileEnd = self.fileBufEnds[file];

        u8* lineStart = ptr;
        while (lineStart > fileBuf)
        {
            u8* prev = lineStart - 1;
            if (prev[0] == '\n') break;
            lineStart = prev;
        }

        u8* lineEnd = ptr;
        while (lineEnd < fileEnd)
        {
            if (lineEnd[0] == '\n') break;
            if (lineEnd[0] == '\r') break;
            lineEnd = lineEnd + 1;
        }

        usize lineLen = (usize)(lineEnd - lineStart);
        error.render(codeStr(code), level, msg,
                     self.filePaths[file], line, col,
                     lineStart, lineLen, help);
    }
}
