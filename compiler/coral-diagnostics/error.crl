/* diagnostics/error.crl — the renderer.
 *
 * Every diagnostic funnels through here. The engine resolves a SourceLoc to
 * (file, line, col, source line) via its file table and passes the pieces in
 * with a stable code string, a level, a message, and an optional help line.
 *
 * Output shape:
 *   error[C0024]: <concise summary>
 *     ┌─► <file>:<line>:<col>
 *     │
 *     │   <lineno> │ <source line>
 *     |                       ▲
 *     │                       ╰─ <help / suggestion>
 */

extern("C") i32 printf(u8* fmt, ...);
extern("C") i32 write(i32 fd, u8* buf, usize len);

pub void render(u8* code, u8* level, u8* msg,
                u8* file, usize line, usize col,
                u8* lineText, usize lineTextLen, u8* help)
{
    if (msg == null) msg = (u8*)"diagnostic";
    if (level == null) level = (u8*)"error";
    if (code == null) code = (u8*)"COR-0000";
    if (file == null) file = (u8*)"unknown";

    printf("%s[%s]: %s\n", level, code, msg);
    printf("  ┌─► %s:%llu:%llu\n", file, (u64)line, (u64)col);
    printf("  │\n");

    /* gutter: line number right-aligned in a 4-wide field, then the source */
    printf("  │ %4llu │ ", (u64)line);
    if (lineText != null && lineTextLen > 0)
        write(1, lineText, lineTextLen);
    write(1, "\n", 1);

    /* caret under the error column — source starts at column 11 */
    printf("  │       ");
    usize j = 1;
    while (j < col)
    {
        write(1, " ", 1);
        j = j + 1;
    }
    printf("▲\n");

    if (help != null)
    {
        printf("  │       ");
        usize k = 1;
        while (k < col)
        {
            write(1, " ", 1);
            k = k + 1;
        }
        printf("╰─ %s\n", help);
    }
}
