mod sl = import("slice");

pub enum TokenKind
{
    Eof,
    //Literals
    Ident,
    Dec,
    Hex,
    Bin,
    Float,
    String,
    Char,
    True,
    Null,
    False,

    //Keywords
    If,            // 2
    
    Use            // 3
    Mod,
    Pub,
    For,
    Asm,
    Var,
    
    Enum,          // 4
    Else,
    Loop,
    Flag,
    Self,
    
    While,         // 5
    Trait,
    Const,
    Defer,
    Break,
    
    Import,        // 6
    Static,
    Struct,
    Extern,
    Switch,
    Return,
    
    Default,      // 7
    Typedef,
    
    Distinct,     // 8
    Continue,
    Comptime,
    Volatile,
    
    // operators
    Plus,          // + // single char operators
    Minus,         // -
    Star,          // *
    Slash,         // /
    Less,          // <
    Greater,       // >
    Neg,            // ~
    Not,            // !
    Colon,         // :
    Semicolon,      // ;
    Comma,          // ,
    Hash,
    Dot,            // .
    Ampersand,      // &
    Caret,          // ^
    Pipe,           // |
    
    Equal,          // = // assign
    
    PlusEqual       // +=  // compound(assigned)
    MinusEqual,     // -=
    StarEqual,      // *=
    SlashEqual,     // /=
    EqualEqual,     // ==
    NotEqual,       // !=
    LessEqual,      // <=
    GreaterEqual,   // >=
    PipeEqual,      // |=
    CaretEquat,     // ^=
    AmpEqual,       // &=
    NegEqual,       // ~=
    
    FatArrow,       // => // compound(other)
    ColonColon,     // ::
    PlusPlus,       // ++
    MinusMinus,     // --
    And,            // &&
    Or,             // ||
    StarDot,        // *.
    Ellipsis,       // ...
    
    // separators
    LParen,         // (
    Rparen,         // )
    LBrace,         // {
    RBrace,         // }
    LBracket,       // [
    RBracket,       // ]

    BuiltinSizeof,
    BuiltinAssert,
    BuiltinAlignof,
    BuiltinTypeof,

    BuiltinIdent,
    At             // @
}

pub struct Token {
    TokenKind kind;
    Slice* data;
    usize line;
    usize col;
}