import "slice" { Slice };

pub enum TokenKind
{
    Eof,
    Ident,
    // literals
    Dec,
    Hex,
    Bin,
    Oct,
    Float,
    String,
    RawString,
    Char,
    True,
    Null,
    False,

    // keywords
    If,            // 2
    As,
    
    Mod,           // 3
    Pub,
    For,
    Asm,
    Var,

    Enum,          // 4
    Else,
    Loop,
    Flag,
    Self,

    While,         // 5
    Trait,
    Const,
    Defer,
    Break,
    Union,

    Import,        // 6
    Static,
    Struct,
    Extern,
    Switch,
    Return,
    Extend,

    Typedef,
    Variant,
    In,

    // builtin types
    Void,
    Bool,
    U8,
    I8,
    U16,
    I16,
    U32,
    I32,
    U64,
    I64,
    U128,
    I128, // these will be hidden behind a flag.
    F32,
    F64,
    Usize,
    Isize,
    Rawptr,
    Str,

    Distinct,     // 8
    Continue,
    Comptime,
    Volatile,

    // operators
    Plus,           // + // single char operators
    Minus,          // -
    Star,           // *
    Slash,          // /
    Percent,        // %
    Less,           // <
    Greater,        // >
    Neg,            // ~
    Not,            // !
    Colon,          // :
    Semicolon,      // ;
    Comma,          // ,
    Hash,           // #
    Dot,            // .
    Ampersand,      // &
    Caret,          // ^
    Pipe,           // |

    Equal,          // = // assign

    PlusEqual       // +=  // compound(assigned)
    MinusEqual,     // -=
    StarEqual,      // *=
    SlashEqual,     // /=
    PercentEqual,   // %=
    EqualEqual,     // ==
    NotEqual,       // !=
    LessEqual,      // <=
    GreaterEqual,   // >=
    PipeEqual,      // |=
    CaretEqual,     // ^=
    AmpEqual,       // &=
    NegEqual,       // ~=
    ShlEqual,       // <<=
    ShrEqual,       // >>=

    FatArrow,       // => // compound(other)
    ColonColon,     // ::
    PlusPlus,       // ++
    MinusMinus,     // --
    And,            // &&
    Or,             // ||
    Shl,            // <<
    Shr,            // >>
    Arrow,          // ->
    StarDot,        // *.
                    // In the new variant of the lauguage,
                    // this will be used to replace -> for
                    // member access via pointer.
    Ellipsis,       // ...

    // separators
    LParen,         // (
    RParen,         // )
    LBrace,         // {
    RBrace,         // }
    LBracket,       // [
    RBracket,       // ]
    AttrOpen,       // [[
    AttrClose,      // ]]

    // builtin identifier
    BuiltinSizeof,
    BuiltinAssert,
    BuiltinAlignof,
    BuiltinTypeof,

    At,             // @
    Question,       // ?
    Unknown         // invalid token (not Eof)
}

pub struct Token
{
    usize col;
    usize line;
    Slice data;
    TokenKind kind;
    IdentifierInfo* info;
}

pub struct IdentifierInfo
{
    u8* name;
    usize nameLen;
    TokenKind kind;
    bool isKeyword;
}