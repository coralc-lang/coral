pub enum TokenKind
{
    Eof,
    Ident,
    // literals
    Dec,
    Hex,
    Bin,
    Oct,
    Float,
    String,
    RawString,
    Char,
    True,
    Null,
    False,

    // keywords
    If,            // 2

    Use            // 3
    Mod,
    Pub,
    For,
    Asm,
    Var,

    Enum,          // 4
    Else,
    Loop,
    Flag,
    Self,

    While,         // 5
    Trait,
    Const,
    Defer,
    Break,
    Union,

    Import,        // 6
    Static,
    Struct,
    Extern,
    Switch,
    Return,
    Extend,

    Default,      // 7
    Typedef,

    // builtin types
    KwVoid,
    KwBool,
    KwChar,
    KwU8, KwU16, KwU32, KwU64, KwU128,
    KwI8, KwI16, KwI32, KwI64, KwI128,
    KwF32, KwF64,
    KwUsize, KwIsize,
    KwRawptr,
    KwStr,

    Distinct,     // 8
    Continue,
    Comptime,
    Volatile,

    // operators
    Plus,           // + // single char operators
    Minus,          // -
    Star,           // *
    Slash,          // /
    Less,           // <
    Greater,        // >
    Neg,            // ~
    Not,            // !
    Colon,          // :
    Semicolon,      // ;
    Comma,          // ,
    Hash,           // #
    Dot,            // .
    Ampersand,      // &
    Caret,          // ^
    Pipe,           // |

    Equal,          // = // assign

    PlusEqual       // +=  // compound(assigned)
    MinusEqual,     // -=
    StarEqual,      // *=
    SlashEqual,     // /=
    EqualEqual,     // ==
    NotEqual,       // !=
    LessEqual,      // <=
    GreaterEqual,   // >=
    PipeEqual,      // |=
    CaretEqual,     // ^=
    AmpEqual,       // &=
    NegEqual,       // ~=

    FatArrow,       // => // compound(other)
    ColonColon,     // ::
    PlusPlus,       // ++
    MinusMinus,     // --
    And,            // &&
    Or,             // ||
    StarDot,        // *. 
                    // In the new variant of the lauguage,
                    // this will be used to replace -> for
                    // member access via pointer.
    Ellipsis,       // ...

    // separators
    LParen,         // (
    Rparen,         // )
    LBrace,         // {
    RBrace,         // }
    LBracket,       // [
    RBracket,       // ]

    // builtin identifier
    BuiltinSizeof,
    BuiltinAssert,
    BuiltinAlignof,
    BuiltinTypeof,
  
    At             // @
}

[[reorder]]
pub struct Token {
    usize col;
    usize line;
    Slice data;
    TokenKind kind;
    IdentifierInfo* info;
}

pub struct IdentifierInfo {
    u8* name;
    usize nameLen;
    TokenKind kind;
    bool isKeyword;
}