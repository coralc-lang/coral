mod T = import("token");

typedef TokenKind = T.TokenKind;

pub struct IdentifierInfo {
    u8* name;
    usize nameLen;
    TokenKind kind;
    bool isKeyword;
}

pub struct IdentEntry {
    IdentifierInfo info;
    bool occupied;
}

pub struct IdentifierTable {
    IdentEntry* entries;
    usize capacity;
    usize count;

    void init(IdentEntry* buf, usize cap)
    {
        self.entries = buf;
        self.capacity = cap;
        self.count = 0;
        for (usize i = 0; i < cap; i++)
            self.entries[i].occupied = false;
    }

    usize hash(u8* name, usize len)
    {
        // FNV-1a
        usize h = 14695981039346656037;
        for (usize i = 0; i < len; i++)
        {
            h ^= (usize)name[i];
            h *= 1099511628211;
        }
        return h;
    }

    IdentifierInfo* get(u8* name, usize len)
    {
        usize idx = self.hash(name, len) & (self.capacity - 1);

        // linear probing: find existing or first empty slot
        for (usize probe = 0; probe < self.capacity; probe++)
        {
            usize pos = (idx + probe) & (self.capacity - 1);
            IdentEntry* e = &self.entries[pos];

            if (!e->occupied)
            {
                // empty slot -- insert new entry
                e->info.name = name;
                e->info.nameLen = len;
                e->info.kind = TokenKind::Ident;
                e->info.isKeyword = false;
                e->occupied = true;
                self.count++;
                return &e->info;
            }

            // check if this entry matches
            if (e->info.nameLen == len)
            {
                bool match = true;
                for (usize i = 0; i < len; i++)
                {
                    if (e->info.name[i] != name[i])
                    {
                        match = false;
                        break;
                    }
                }
                if (match) return &e->info;
            }
        }

        // table full -- return null (should not happen with reasonable capacity)
        return null;
    }

    void addKeyword(u8* name, usize len, TokenKind kind)
    {
        IdentifierInfo* info = self.get(name, len);
        if (info != null)
        {
            info->kind = kind;
            info->isKeyword = true;
        }
    }

    void addKeywords()
    {
        self.addKeyword("if", 2, TokenKind::If);
        self.addKeyword("use", 3, TokenKind::Use);
        self.addKeyword("mod", 3, TokenKind::Mod);
        self.addKeyword("pub", 3, TokenKind::Pub);
        self.addKeyword("for", 3, TokenKind::For);
        self.addKeyword("asm", 3, TokenKind::Asm);
        self.addKeyword("var", 3, TokenKind::Var);
        self.addKeyword("enum", 4, TokenKind::Enum);
        self.addKeyword("else", 4, TokenKind::Else);
        self.addKeyword("loop", 4, TokenKind::Loop);
        self.addKeyword("flag", 4, TokenKind::Flag);
        self.addKeyword("true", 4, TokenKind::True);
        self.addKeyword("null", 4, TokenKind::Null);
        self.addKeyword("self", 4, TokenKind::Self);
        self.addKeyword("while", 5, TokenKind::While);
        self.addKeyword("trait", 5, TokenKind::Trait);
        self.addKeyword("const", 5, TokenKind::Const);
        self.addKeyword("defer", 5, TokenKind::Defer);
        self.addKeyword("break", 5, TokenKind::Break);
        self.addKeyword("union", 5, TokenKind::Union);
        self.addKeyword("import", 6, TokenKind::Import);
        self.addKeyword("static", 6, TokenKind::Static);
        self.addKeyword("struct", 6, TokenKind::Struct);
        self.addKeyword("extern", 6, TokenKind::Extern);
        self.addKeyword("switch", 6, TokenKind::Switch);
        self.addKeyword("return", 6, TokenKind::Return);
        self.addKeyword("default", 7, TokenKind::Default);
        self.addKeyword("typedef", 7, TokenKind::Typedef);
        self.addKeyword("distinct", 8, TokenKind::Distinct);
        self.addKeyword("continue", 8, TokenKind::Continue);
        self.addKeyword("comptime", 8, TokenKind::Comptime);
        self.addKeyword("volatile", 8, TokenKind::Volatile);
        self.addKeyword("false", 5, TokenKind::False);
        // builtin types
        self.addKeyword("void", 4, TokenKind::KwVoid);
        self.addKeyword("bool", 4, TokenKind::KwBool);
        self.addKeyword("char", 4, TokenKind::KwChar);
        self.addKeyword("u8", 2, TokenKind::KwU8);
        self.addKeyword("u16", 3, TokenKind::KwU16);
        self.addKeyword("u32", 3, TokenKind::KwU32);
        self.addKeyword("u64", 3, TokenKind::KwU64);
        self.addKeyword("u128", 4, TokenKind::KwU128);
        self.addKeyword("i8", 2, TokenKind::KwI8);
        self.addKeyword("i16", 3, TokenKind::KwI16);
        self.addKeyword("i32", 3, TokenKind::KwI32);
        self.addKeyword("i64", 3, TokenKind::KwI64);
        self.addKeyword("i128", 4, TokenKind::KwI128);
        self.addKeyword("f16", 3, TokenKind::KwF16);
        self.addKeyword("f32", 3, TokenKind::KwF32);
        self.addKeyword("f64", 3, TokenKind::KwF64);
        self.addKeyword("usize", 5, TokenKind::KwUsize);
        self.addKeyword("isize", 5, TokenKind::KwIsize);
    }
}
