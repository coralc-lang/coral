pub struct Slice {
    u8* ptr;
    usize len;

    Slice from(u8* p, usize len)
    {
        Slice s;
        s.ptr = p;
        s.len = len;
        return s;
    }

    bool eq(Slice b)
    {
        if (self.len != b.len) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != b.ptr[i]) return false; 
        }
        return true;
    }

    bool eqCstr(str cStr)
    {
        if (self.len != cStr.len) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != cStr.ptr[i]) return false; 
        }
        return true;
    }
}