pub struct Slice
{
    u8* ptr;
    usize len;

    Slice from(u8* p, usize len)
    {
        Slice s;
        s.ptr = p;
        s.len = len;
        return s;
    }

    bool eq(Slice b)
    {
        if (self.len != b.len) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != b.ptr[i]) return false; 
        }
        return true;
    }

    bool eqSlice(Slice other)
    {
        if (self.len != other.len) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != other.ptr[i]) return false;
        }
        return true;
    }

    bool eqCstr(u8* cStr, usize cStrLen)
    {
        if (self.len != cStrLen) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != cStr[i]) return false;
        }
        return true;
    }
}