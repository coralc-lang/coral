/* ast/types.crl — type representation for Coral
 *
 * Performance-first design:
 *   - Every node is an index (NodeId), not a pointer
 *   - Strings are interned (Str = ptr + len, equality = ptr compare)
 *   - Generics use parallel arrays (T* + len), not Slice<T>
 *   - After monomorphization, TypeParam variants become Named
 */

import "id" { Str, SourceLoc, NodeId }

pub variant TypeKind
{
    Error,
    Void,
    Bool,
    Char,
    I8,
    U8,
    I16,
    U16,
    I32,
    U32,
    I64,
    U64,
    I128,
    U128,
    F32,
    F64,
    Isize,
    Usize,
    Rawptr,
    Str,
    
    Named {
        Str name,
        NodeId* generic_args,
        u32 generic_args_len,
    },

    Pointer {
        NodeId base,
    },

    Slice {
        NodeId elem,
    },

    Array {
        NodeId elem,
        u32 len,
    },

    FnPtr {
        NodeId ret,
        NodeId* params,
        u32 params_len,
        Str name,
    },

    Tuple {
        NodeId* fields,
        u32 fields_len,
    },

    TypeParam {
        Str name,
        u32 index,
    },
}

pub struct Ty
{
    TypeKind kind,
    SourceLoc loc,
}
