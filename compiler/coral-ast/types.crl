/* ast/types.crl — type representation for Coral */

import "id" { Str, SourceLoc, NodeId }

pub variant TypeKind
{
    Error,
    Void,
    Bool,
    Char,
    I8,
    U8,
    I16,
    U16,
    I32,
    U32,
    I64,
    U64,
    I128,
    U128,
    F32,
    F64,
    Isize,
    Usize,
    Rawptr,
    Str,
    
    Named {
        Str name,
        NodeId* genericArgs,
        u32 genericArgsLen,
    },
    Pointer {
        NodeId base,
    },
    Slice {
        NodeId elem,
    },
    Array {
        NodeId elem,
        u32 len,
    },
    FnPtr {
        NodeId ret,
        NodeId* params,
        u32 paramsLen,
        Str name,
    },

    Tuple {
        NodeId* fields,
        u32 fieldsLen,
    },
    TypeParam {
        Str name,
        u32 index,
    }
}

pub struct Ty
{
    TypeKind kind,
    SourceLoc loc,
}
