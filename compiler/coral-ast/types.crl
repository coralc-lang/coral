/* ast/types.crl — type representation for Coral */

import "id" { Str, SourceLoc, NodeId }

pub variant TypeKind
{
    Error,
    Void,
    Bool,
    Char,
    I8, U8,
    I16, U16,
    I32, U32,
    I64, U64,
    I128, U128,
    F32, F64,
    Isize, Usize,
    Rawptr,
    Str,
    Named {
        Str name,
        NodeId* generic_args,
        u32 generic_args_len,
    },
    Pointer {
        NodeId base,
        bool is_mut,
    },
    Slice {
        NodeId elem,
    },
    Array {
        NodeId elem,
        u32 len,
    },
    FnPtr {
        NodeId* params,
        u32 params_len,
        NodeId ret,
    },
    Tuple {
        NodeId* fields,
        u32 fields_len,
    },
    TypeParam {
        Str name,
        u32 index,
    },
    ComptimeInt {
        i64 value,
    },
    ComptimeFloat {
        f64 value,
    },
}

pub struct Ty
{
    TypeKind kind,
    SourceLoc loc,
}
