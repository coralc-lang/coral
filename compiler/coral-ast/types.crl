/* ast/types.crl — type representation
 *
 * Ty is a u32 index into a global type table.
 * The actual TypeKind data lives in a parallel array.
 * This cuts every Ty from 64 bytes to 4 bytes.
 *
 * TypeKind variants are stored in type arena, not inline in Ty.
 * Only the kind tag + small inline data is stored per variant.
 * Large payloads (Named, FnPtr, Pointer, etc.) store references.
 */

pub typedef Ty = u32;

/* Type kinds — stored in type arena, not inline in Ty */
pub variant TypeKind
{
    Error,
    Void,
    Bool,
    Char,
    I8,
    U8,
    I16,
    U16,
    I32,
    U32,
    I64,
    U64,
    I128,
    U128,
    F32,
    F64,
    Isize,
    Usize,
    Rawptr,
    Str,
    Named {
        Str name;
        Ty* genericArgs;
        u32 genericArgsLen;
    },

    Pointer {
        Ty base;
    },

    Slice {
        Ty base;
    },

    Array {
        Ty base;
        u32 len;
    },

    FnPtr {
        Ty returnType;
        Ty* params;
        u32 paramsLen;
        Str name;
    },

    Tuple {
        Ty* elems;
        u32 elemsLen;
    },

    TypeParam {
        Str name;
        u32 index;
    }
}

pub struct TypeEntry
{
    TypeKind kind;
    SourceLoc loc;
}
