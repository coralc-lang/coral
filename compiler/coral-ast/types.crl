/* ast/types.crl — type representation for Coral
 *
 * Actual Coral type syntax:
 *   Type name              — explicit type
 *   var name = init        — type inference
 *   Type (param) name      — function pointer
 *   struct(T1, T2)         — tuple type
 *   []T                    — slice
 *   [N]T                   — array
 *   T*                     — pointer
 *   ?T                     — optional (Option<T> from stdlib)
 *
 * No: var x: Type, try/catch, &x/&mut x patterns, fn(T)->V syntax
 */

import "id" { Str, SourceLoc, NodeId }

pub variant TypeKind
{
    Error,
    Void,
    Bool,
    Char,
    I8,
    U8,
    I16,
    U16,
    I32,
    U32,
    I64,
    U64,
    I128,
    U128,
    F32,
    F64,
    Isize,
    Usize,
    Rawptr,
    Str,
    
    Named {
        Str name,
        NodeId* genericArgs,
        u32 genericArgsLen,
    },
    
    Pointer {
        NodeId base,
    },
    
    Slice {
        NodeId elem,
    },
    
    Array {
        NodeId elem,
        u32 len,
    },
    
    FnPtr {
        NodeId ret,
        NodeId* params,
        u32 paramsLen,
        Str name,
    },
    
    Tuple {
        NodeId* fields,
        u32 fieldsLen,
    },
    
    TypeParam {
        Str name,
        u32 index,
    },
}

pub struct Ty
{
    TypeKind kind,
    SourceLoc loc,
}
