/* ast/id.crl — string interning and source locations
 *
 * Str is a u32 index into a global string intern table.
 * Equality is O(1) — just compare two u32 values.
 * The actual string data (ptr + len) lives in the intern table.
 *
 * SourceLoc is 32 bits — packed file ID + line + column.
 * Matches Clang's 32-bit SourceLocation design.
 *
 * NodeId is a 32-bit index into the AST node array.
 * index=0 is the sentinel for "absent" — no NodeId* heap allocs.
 */

/* String intern table index. 0 = empty string. */
pub typedef Str = u32;

pub struct SourceLoc
{
    u32 data,
}

pub struct NodeId
{
    u32 index,
}
