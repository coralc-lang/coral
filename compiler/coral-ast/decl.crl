/* ast/decl.crl — declaration nodes
 *
 * Performance-first design:
 *   - All collections are parallel arrays (T* + len), not Slice<T>
 *   - No Option types — use bool flags for optional fields
 *   - No tuple types in generic args
 *   - Function pointers: Type (param_types) name
 *   - Variants: Name { Type field } syntax
 *   - No: var x: Type, try/catch, &mut x, fn(T)->V
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "expr" { Expr }
import "stmt" { Stmt }

pub struct GenericParam
{
    Str name,
    NodeId* bounds,
    u32 bounds_len,
    SourceLoc loc,
}

pub struct TraitBound
{
    Str trait_name,
    SourceLoc loc,
}

pub struct Param
{
    Str name,
    Ty type_node,
    bool is_self,
    bool is_mut_self,
    bool is_const_self,
    SourceLoc loc,
}

pub struct Field
{
    Str name,
    Ty type_node,
    bool is_pub,
    NodeId default_value,
    bool has_default,
    SourceLoc loc,
}

pub struct EnumVariant
{
    Str name,
    NodeId value,
    bool has_value,
    SourceLoc loc,
}

pub struct VariantVariant
{
    Str name,
    NodeId* field_types,
    Str* field_names,
    u32 fields_len,
    SourceLoc loc,
}

pub struct FlagBranch
{
    Str label,
    NodeId* stmts,
    u32 stmts_len,
    SourceLoc loc,
}

/* Import symbol: symbol [as alias] */
pub struct ImportSymbol
{
    Str name,
    Str alias,
    bool has_alias,
}

pub variant DeclKind
{
    Import {
        Str path,
        ImportSymbol* symbols,
        u32 symbols_len,
        bool is_lib,
        Str lib_path,
        bool has_lib_path,
    },
    ModReexport {
        Str alias,
        Str path,
        bool is_lib,
        Str lib_path,
        bool has_lib_path,
    },
    Struct {
        Str name,
        NodeId* generic_params,
        u32 generic_params_len,
        NodeId* fields,
        u32 fields_len,
        bool is_pub,
        NodeId* methods,
        u32 methods_len,
    },
    Enum {
        Str name,
        Ty backing_type,
        bool has_backing,
        NodeId* variants,
        u32 variants_len,
        bool is_pub,
    },
    Variant {
        Str name,
        NodeId* generic_params,
        u32 generic_params_len,
        NodeId* variants,
        u32 variants_len,
        bool is_pub,
        NodeId* methods,
        u32 methods_len,
    },
    Union {
        Str name,
        NodeId* fields,
        u32 fields_len,
        bool is_pub,
        NodeId* methods,
        u32 methods_len,
    },
    Trait {
        Str name,
        NodeId* generic_params,
        u32 generic_params_len,
        NodeId* super_traits,
        u32 super_traits_len,
        NodeId* methods,
        u32 methods_len,
        bool is_pub,
    },
    Extend {
        Ty self_type,
        NodeId* methods,
        u32 methods_len,
    },
    ExtendTrait {
        Ty self_type,
        Str trait_name,
        NodeId* methods,
        u32 methods_len,
    },
    Func {
        Str name,
        NodeId* generic_params,
        u32 generic_params_len,
        NodeId* params,
        u32 params_len,
        Ty return_type,
        NodeId body,
        bool has_body,
        bool is_pub,
        bool is_extern,
        bool is_static,
    },
    Constant {
        Ty type_node,
        Str name,
        NodeId value,
        bool is_pub,
    },
    TypeAlias {
        Str name,
        Ty target,
        bool is_pub,
    },
    Distinct {
        Str name,
        Ty base_type,
        bool is_pub,
    },
    Flag {
        Str flag_name,
        NodeId* branches,
        u32 branches_len,
    },
    Comptime {
        NodeId* decls,
        u32 decls_len,
    },
}

pub struct Decl
{
    DeclKind kind,
    SourceLoc loc,
}

pub struct File
{
    Str path,
    NodeId* decls,
    u32 decls_len,
}
