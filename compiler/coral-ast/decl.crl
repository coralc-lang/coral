/* ast/decl.crl — declaration nodes
 *
 * Coral declaration syntax:
 *   pub fn name<T>(params) { body }
 *   Type name;              — field/param
 *   Type name = init;       — field with default
 *   pub struct Name<T> { fields methods }
 *   pub variant Name<T> { Variants { fields } }
 *   pub enum Name { A, B, C }
 *   pub trait Name { methods }
 *   extend Type { methods }
 *   extend Type : Trait { methods }
 *   distinct Name = Type;
 *   flag(PLATFORM) { label => stmts }  — else is default branch
 *   import "path" { symbols }
 *   import file::module { symbols }
 *   import(lib) package::module { symbols }
 *   pub mod alias = import "path";
 *   pub mod alias = import(lib) package::path;
 *   [[attribute]] — [[packed]], [[noreturn]], [[inline]], etc.
 *   comptime { decls }
 *
 * Function pointers: ReturnType (ParamTypes) name
 *   e.g. rawptr(rawptr, usize) alloc;
 *   e.g. T(T) fn;
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "expr" { Expr }
import "stmt" { Stmt }

pub struct GenericParam
{
    Str name,
    NodeId* bounds,
    u32 boundsLen,
    SourceLoc loc,
}

pub struct TraitBound
{
    Str traitName,
    SourceLoc loc,
}

pub struct Param
{
    Str name,
    Ty typeNode,
    bool isSelf,
    bool isMutSelf,
    bool isConstSelf,
    SourceLoc loc,
}

pub struct Field
{
    Str name,
    Ty typeNode,
    bool isPub,
    NodeId defaultValue,
    bool hasDefault,
    SourceLoc loc,
}

pub struct EnumVariant
{
    Str name,
    NodeId value,
    bool hasValue,
    SourceLoc loc,
}

pub struct VariantVariant
{
    Str name,
    NodeId* fieldTypes,
    Str* fieldNames,
    u32 fieldsLen,
    SourceLoc loc,
}

pub struct FlagBranch
{
    Str label,
    NodeId* stmts,
    u32 stmtsLen,
    SourceLoc loc,
}

pub struct ImportSymbol
{
    Str name,
    Str alias,
    bool hasAlias,
}

pub struct Attribute
{
    Str name,
    SourceLoc loc,
}

pub variant DeclKind
{
    Import {
        Str path,
        ImportSymbol* symbols,
        u32 symbolsLen,
        bool isLib,
        Str libPath,
        bool hasLibPath,
    },

    ModReexport {
        Str alias,
        Str path,
        bool isLib,
        Str libPath,
        bool hasLibPath,
    },

    Struct {
        Str name,
        NodeId* genericParams,
        u32 genericParamsLen,
        NodeId* fields,
        u32 fieldsLen,
        bool isPub,
        NodeId* methods,
        u32 methodsLen,
    },

    Enum {
        Str name,
        Ty backingType,
        bool hasBacking,
        NodeId* variants,
        u32 variantsLen,
        bool isPub,
    },

    Variant {
        Str name,
        NodeId* genericParams,
        u32 genericParamsLen,
        NodeId* variants,
        u32 variantsLen,
        bool isPub,
        NodeId* methods,
        u32 methodsLen,
    },

    Union {
        Str name,
        NodeId* fields,
        u32 fieldsLen,
        bool isPub,
        NodeId* methods,
        u32 methodsLen,
    },

    Trait {
        Str name,
        NodeId* genericParams,
        u32 genericParamsLen,
        NodeId* superTraits,
        u32 superTraitsLen,
        NodeId* methods,
        u32 methodsLen,
        bool isPub,
    },

    Extend {
        Ty selfType,
        NodeId* methods,
        u32 methodsLen,
    },

    ExtendTrait {
        Ty selfType,
        Str traitName,
        NodeId* methods,
        u32 methodsLen,
    },

    Func {
        Str name,
        NodeId* genericParams,
        u32 genericParamsLen,
        NodeId* params,
        u32 paramsLen,
        Ty returnType,
        NodeId body,
        bool hasBody,
        bool isPub,
        bool isExtern,
        bool isStatic,
    },

    Constant {
        Ty typeNode,
        Str name,
        NodeId value,
        bool isPub,
    },

    TypeAlias {
        Str name,
        Ty target,
        bool isPub,
    },

    Distinct {
        Str name,
        Ty baseType,
        bool isPub,
    },

    Flag {
        Str flagName,
        NodeId* branches,
        u32 branchesLen,
    },

    Comptime {
        NodeId* decls,
        u32 declsLen,
    }
}

pub struct Decl
{
    DeclKind kind,
    SourceLoc loc,
    Attribute* attrs,
    u32 attrsLen,
}

pub struct File
{
    Str path,
    NodeId* decls,
    u32 declsLen,
}
