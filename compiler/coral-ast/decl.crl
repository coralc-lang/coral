/* ast/decl.crl — declaration nodes
 * Declarations define new types, functions, modules, etc.
 * This covers the full Coral language surface:
 *   - modules and imports
 *   - structs, enums, variants, unions, traits
 *   - functions with generics
 *   - extend blocks (including trait impls)
 *   - flag/平台条件编译
 *   - comptime declarations
 *   - distinct types
 *   - constants
 *
 * Design: after monomorphization, all generics are resolved.
 * GenericParams are erased; TypeParam variants become Named types.
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty, TypeKind }
import "expr" { Expr }
import "stmt" { Stmt }

// generic parameters 

pub struct GenericParam
{
    Str name,
    Slice<Ty> bounds,
    SourceLoc loc,
}

pub struct GenericArg
{
    Ty type_node,
    SourceLoc loc,
}

// trait bounds 

pub struct TraitBound
{
    Str trait_name,
    Slice<Ty> args,
    SourceLoc loc,
}

// parameter 

pub struct Param
{
    Str name,
    Ty type_node,
    bool is_self,
    bool is_mut_self,
    bool is_const_self,
    SourceLoc loc,
}

// field 
pub struct Field
{
    Str name,
    Ty type_node,
    bool is_pub,
    Option<NodeId> default_value,
    SourceLoc loc,
}

// top-level declarations 
pub variant DeclKind
{
    // import: import "path" { Symbol1, Symbol2 } 
    Import {
        Str path,
        Slice<(Str, Option<Str>)> symbols,
        bool is_lib,
        Option<Str> lib_path,
    },

    // module re-export: pub mod alias = import "path"; 
    ModReexport {
        Str alias,
        Str path,
        bool is_lib,
        Option<Str> lib_path,
    },

    // struct declaration 
    Struct {
        Str name,
        Slice<GenericParam> generic_params,
        Slice<Field> fields,
        bool is_pub,
        Slice<NodeId> methods,
        Slice<NodeId> impls,
    },

    // enum declaration 
    Enum {
        Str name,
        Option<Ty> backing_type,
        Slice<EnumVariant> variants,
        bool is_pub,
    },

    // variant (tagged union) declaration 
    Variant {
        Str name,
        Slice<GenericParam> generic_params,
        Slice<VariantVariant> variants,
        bool is_pub,
        Slice<NodeId> methods,
    },

    // union declaration 
    Union {
        Str name,
        Slice<Field> fields,
        bool is_pub,
        Slice<NodeId> methods,
    },

    // trait declaration 
    Trait {
        Str name,
        Slice<GenericParam> generic_params,
        Slice<TraitBound> super_traits,
        Slice<NodeId> methods,
        bool is_pub,
    },

    // extend block: extend Type { methods } 
    Extend {
        Ty self_type,
        Slice<NodeId> methods,
    },

    // trait implementation: extend Type : TraitName { methods } 
    ExtendTrait {
        Ty self_type,
        Str trait_name,
        Slice<NodeId> methods,
    },

    // function declaration 
    Func {
        Str name,
        Slice<GenericParam> generic_params,
        Slice<Param> params,
        Ty return_type,
        Option<NodeId> body,
        bool is_pub,
        bool is_extern,
        bool is_static,
        bool is_inline,
        bool is_volatile,
        bool is_noinline,
        Slice<TraitBound> bounds,
    },

    // constant: const Type name = value; 
    Constant {
        Ty type_node,
        Str name,
        NodeId value,
        bool is_pub,
    },

    // global mutable: global Type name = value; 
    Global {
        Ty type_node,
        Str name,
        Option<NodeId> value,
        bool is_pub,
    },

    // type alias: type Name = Type; 
    TypeAlias {
        Str name,
        Ty target,
        bool is_pub,
    },

    // distinct type: distinct Name = BaseType; 
    Distinct {
        Str name,
        Ty base_type,
        bool is_pub,
    },

    // flag conditional: flag(PLATFORM) { linux => { ... } } 
    Flag {
        Str flag_name,
        Slice<FlagBranch> branches,
    },

    // comptime block 
    Comptime {
        Slice<NodeId> decls,
    },

    // macro definition (future) 
    Macro {
        Str name,
        Slice<Str> params,
        Slice<NodeId> body,
        bool is_pub,
    },
}

// helper nodes 

pub struct EnumVariant
{
    Str name,
    Option<NodeId> value,
    SourceLoc loc,
}

pub struct VariantVariant
{
    Str name,
    Slice<Field> fields,
    SourceLoc loc,
}

pub struct FlagBranch
{
    Str label,
    Slice<NodeId> stmts,
    SourceLoc loc,
}

pub struct Decl
{
    DeclKind kind,
    SourceLoc loc,
}

// top-level file 

pub struct File
{
    Str path,
    Slice<NodeId> decls,
    SourceLoc loc,
}
