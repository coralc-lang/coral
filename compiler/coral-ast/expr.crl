/* ast/expr.crl — expression nodes
 *
 * Actual Coral expression syntax:
 *   42, 3.14, "hello", 'c', true, false, null
 *   foo, Module::name
 *   foo(args), obj.method(args), Type::method(args)
 *   obj.field, obj*.field, obj[index]
 *   +, -, *, /, %, ==, !=, <, <=, >, >=, &&, ||, &, |, ^, <<, >>
 *   !x, -x, *x, &x (addr-of), cast
 *   a ? b : c
 *   (a, b, c) — tuple literal
 *   Type { field: val } — struct literal
 *   [1, 2, 3] — array literal
 *   @assert, @sizeof, @alignof, @typeof, @offsetof
 *   { stmts; expr } — block expression
 *   a..b, a..=b — range
 *   a! — unwrap
 *   a : Type — type annotation
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }

pub variant ExprKind
{
    IntLit {
        u64 value,
        bool is_negative,
    },

    FloatLit {
        f64 value,
    },

    StringLit {
        Str value,
    },

    CharLit {
        u32 value,
    },

    BoolLit {
        bool value,
    },

    NullLit,
    
    Ident {
        Str name,
    },

    Path {
        NodeId* segments,
        u32 segments_len,
    },

    Call {
        NodeId func,
        NodeId* args,
        u32 args_len,
    },

    MethodCall {
        NodeId receiver,
        Str method,
        NodeId* args,
        u32 args_len,
    },

    Field {
        NodeId obj,
        Str field,
    },

    DerefField {
        NodeId obj,
        Str field,
    },

    StaticCall {
        Str type_name,
        Str method,
        NodeId* args,
        u32 args_len,
    },

    Index {
        NodeId obj,
        NodeId index,
    },

    Not {
        NodeId expr,
    },

    Neg {
        NodeId expr,
    },

    Deref {
        NodeId expr,
    },

    AddrOf {
        NodeId expr,
    },

    Add {
        NodeId left,
        NodeId right,
    },

    Sub {
        NodeId left,
        NodeId right,
    },

    Mul {
        NodeId left,
        NodeId right,
    },

    Div {
        NodeId left,
        NodeId right,
    },

    Mod {
        NodeId left,
        NodeId right,
    },

    Eq {
        NodeId left,
        NodeId right,
    },

    Ne {
        NodeId left,
        NodeId right,
    },

    Lt {
        NodeId left,
        NodeId right,
    },

    Le {
        NodeId left,
        NodeId right,
    },

    Gt {
        NodeId left,
        NodeId right,
    },

    Ge {
        NodeId left,
        NodeId right,
    },

    And {
        NodeId left,
        NodeId right,
    },

    Or {
        NodeId left,
        NodeId right,
    },

    BitAnd {
        NodeId left,
        NodeId right,
    },

    BitOr {
        NodeId left,
        NodeId right,
    },

    BitXor {
        NodeId left,
        NodeId right,
    },

    Shl {
        NodeId left,
        NodeId right,
    },

    Shr {
        NodeId left,
        NodeId right,
    },

    Cast {
        Ty target_type,
        NodeId expr,
    },

    Sizeof {
        Ty target_type,
    },

    Alignof {
        Ty target_type,
    },

    Typeof {
        NodeId expr,
    },

    Ternary {
        NodeId cond,
        NodeId then_expr,
        NodeId else_expr,
    },

    TupleField {
        NodeId obj,
        u32 index,
    },

    StructLiteral {
        Ty type_node,
        NodeId* field_values,
        u32 field_values_len,
    },

    ArrayLiteral {
        NodeId* elems,
        u32 elems_len,
    },

    BuiltinCall {
        Str name,
        NodeId* args,
        u32 args_len,
    },

    BlockExpr {
        NodeId* stmts,
        u32 stmts_len,
        NodeId* result,
        bool has_result,
    },

    Range {
        NodeId start,
        NodeId end,
        bool inclusive,
    },

    Unwrap {
        NodeId expr,
    },

    TypeAnnotation {
        Ty type_node,
        NodeId expr,
    },

    Assign {
        NodeId target,
        NodeId value,
    },

    AssignAdd {
        NodeId target,
        NodeId value,
    },

    AssignSub {
        NodeId target,
        NodeId value,
    },

    AssignMul {
        NodeId target,
        NodeId value,
    },

    AssignDiv {
        NodeId target,
        NodeId value,
    },

    AssignMod {
        NodeId target,
        NodeId value,
    },

    AssignBitAnd {
        NodeId target,
        NodeId value,
    },

    AssignBitOr {
        NodeId target,
        NodeId value,
    },

    AssignBitXor {
        NodeId target,
        NodeId value,
    },

    AssignShl {
        NodeId target,
        NodeId value,
    },

    AssignShr {
        NodeId target,
        NodeId value,
    },
}

pub struct Expr
{
    ExprKind kind,
    SourceLoc loc,
    Ty resolved_type,
}