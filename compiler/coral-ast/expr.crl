/* ast/expr.crl — expression nodes
 *
 * Function pointers: ReturnType (ParamTypes) name
 *   e.g. rawptr(rawptr, usize) alloc;
 *   e.g. void(rawptr, rawptr) free;
 *   e.g. T(T) fn;
 *
 * Builtins use @ prefix:
 *   @assert, @sizeof, @alignof, @typeof, @offsetof
 *
 * Struct literals use dot-prefix field syntax:
 *   Foo { .field = val, .field2 = val2 }
 *
 * Clang-inspired performance principles:
 *   - Flatten variants: split tag + data into parallel arrays
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Move resolvedType to separate array (not inline in Expr)
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "stmt" { SwitchCase }

pub variant ExprKind
{
    IntLit {
        u64 value,
        bool isNegative,
    },

    FloatLit {
        f64 value,
    },

    StringLit {
        Str value,
    },

    CharLit {
        u32 value,
    },

    BoolLit {
        bool value,
    },

    NullLit,
    Ident {
        Str name,
    },

    Path {
        NodeId* segments,
        u32 segmentsLen,
    },

    Call {
        NodeId func,
        NodeId* args,
        u32 argsLen,
    },

    MethodCall {
        NodeId receiver,
        Str method,
        NodeId* args,
        u32 argsLen,
    },

    Field {
        NodeId obj,
        Str field,
    },

    DerefField {
        NodeId obj,
        Str field,
    },

    StaticCall {
        Str typeName,
        Str method,
        NodeId* args,
        u32 argsLen,
    },

    Index {
        NodeId obj,
        NodeId index,
    },

    Not {
        NodeId expr,
    },

    Neg {
        NodeId expr,
    },

    Deref {
        NodeId expr,
    },

    AddrOf {
        NodeId expr,
    },

    Add {
        NodeId left,
        NodeId right,
    },

    Sub {
        NodeId left,
        NodeId right,
    },

    Mul {
        NodeId left,
        NodeId right,
    },

    Div {
        NodeId left,
        NodeId right,
    },

    Mod {
        NodeId left,
        NodeId right,
    },

    Eq {
        NodeId left,
        NodeId right,
    },

    Ne {
        NodeId left,
        NodeId right,
    },

    Lt {
        NodeId left,
        NodeId right,
    },

    Le {
        NodeId left,
        NodeId right,
    },

    Gt {
        NodeId left,
        NodeId right,
    },

    Ge {
        NodeId left,
        NodeId right,
    },

    And {
        NodeId left,
        NodeId right,
    },

    Or {
        NodeId left,
        NodeId right,
    },

    BitAnd {
        NodeId left,
        NodeId right,
    },

    BitOr {
        NodeId left,
        NodeId right,
    },

    BitXor {
        NodeId left,
        NodeId right,
    },

    Shl {
        NodeId left,
        NodeId right,
    },

    Shr {
        NodeId left,
        NodeId right,
    },

    Cast {
        Ty targetType,
        NodeId expr,
    },

    Sizeof {
        Ty targetType,
    },

    Alignof {
        Ty targetType,
    },

    Typeof {
        NodeId expr,
    },

    Ternary {
        NodeId cond,
        NodeId thenExpr,
        NodeId elseExpr,
    },

    TupleField {
        NodeId obj,
        u32 index,
    },

    StructLiteral {
        Ty typeNode,
        Str* fieldNames,
        NodeId* fieldValues,
        u32 fieldValuesLen,
    },

    ArrayLiteral {
        NodeId* elems,
        u32 elemsLen,
    },

    BuiltinCall {
        Str name,
        NodeId* args,
        u32 argsLen,
    },

    BlockExpr {
        NodeId* stmts,
        u32 stmtsLen,
        NodeId* result,
        bool hasResult,
    },

    IfExpr {
        NodeId cond,
        NodeId thenBody,
        NodeId* elseBody,
        bool hasElse,
    },

    SwitchExpr {
        NodeId expr,
        SwitchCase* cases,
        u32 casesLen,
    },

    Assign {
        NodeId target,
        NodeId value,
    },

    AssignAdd {
        NodeId target,
        NodeId value,
    },

    AssignSub {
        NodeId target,
        NodeId value,
    },

    AssignMul {
        NodeId target,
        NodeId value,
    },

    AssignDiv {
        NodeId target,
        NodeId value,
    },

    AssignMod {
        NodeId target,
        NodeId value,
    },

    AssignBitAnd {
        NodeId target,
        NodeId value,
    },

    AssignBitOr {
        NodeId target,
        NodeId value,
    },

    AssignBitXor {
        NodeId target,
        NodeId value,
    },

    AssignShl {
        NodeId target,
        NodeId value,
    },

    AssignShr {
        NodeId target,
        NodeId value,
    }
}

pub struct Expr
{
    ExprKind kind,
    SourceLoc loc,
    Ty resolvedType,
}
