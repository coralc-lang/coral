/* ast/expr.crl — expression nodes */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }

pub variant ExprKind
{
    IntLit {
        u64 value,
        bool is_negative,
    },
    FloatLit {
        f64 value,
    },
    StringLit {
        Str value,
    },
    CharLit {
        u32 value,
    },
    BoolLit {
        bool value,
    },
    NullLit,
    Ident {
        Str name,
    },
    Path {
        NodeId* segments,
        u32 segments_len,
    },
    Call {
        NodeId func,
        NodeId* args,
        u32 args_len,
    },
    MethodCall {
        NodeId receiver,
        Str method,
        NodeId* args,
        u32 args_len,
    },
    Field {
        NodeId obj,
        Str field,
    },
    DerefField {
        NodeId obj,
        Str field,
    },
    StaticCall {
        Str type_name,
        Str method,
        NodeId* args,
        u32 args_len,
    },
    Index {
        NodeId obj,
        NodeId index,
    },
    Not {
        NodeId expr,
    },
    Neg {
        NodeId expr,
    },
    Deref {
        NodeId expr,
    },
    AddrOf {
        NodeId expr,
        bool is_mut,
    },
    Add {
        NodeId left,
        NodeId right,
    },
    Sub {
        NodeId left,
        NodeId right,
    },
    Mul {
        NodeId left,
        NodeId right,
    },
    Div {
        NodeId left,
        NodeId right,
    },
    Mod {
        NodeId left,
        NodeId right,
    },
    Eq {
        NodeId left,
        NodeId right,
    },
    Ne {
        NodeId left,
        NodeId right,
    },
    Lt {
        NodeId left,
        NodeId right,
    },
    Le {
        NodeId left,
        NodeId right,
    },
    Gt {
        NodeId left,
        NodeId right,
    },
    Ge {
        NodeId left,
        NodeId right,
    },
    And {
        NodeId left,
        NodeId right,
    },
    Or {
        NodeId left,
        NodeId right,
    },
    BitAnd {
        NodeId left,
        NodeId right,
    },
    BitOr {
        NodeId left,
        NodeId right,
    },
    BitXor {
        NodeId left,
        NodeId right,
    },
    Shl {
        NodeId left,
        NodeId right,
    },
    Shr {
        NodeId left,
        NodeId right,
    },
    Cast {
        Ty target_type,
        NodeId expr,
    },
    Sizeof {
        Ty target_type,
    },
    Alignof {
        Ty target_type,
    },
    Typeof {
        NodeId expr,
    },
    Ternary {
        NodeId cond,
        NodeId then_expr,
        NodeId else_expr,
    },
    TupleField {
        NodeId obj,
        u32 index,
    },
    StructLiteral {
        Ty type_node,
        NodeId* field_values,
        u32 field_values_len,
    },
    ArrayLiteral {
        NodeId* elems,
        u32 elems_len,
    },
    BuiltinCall {
        Str name,
        NodeId* args,
        u32 args_len,
    },
    BlockExpr {
        NodeId* stmts,
        u32 stmts_len,
        NodeId* result,
    },
    Range {
        NodeId start,
        NodeId end,
        bool inclusive,
    },
    Unwrap {
        NodeId expr,
    },
    Catch {
        NodeId expr,
        Str bind_name,
        NodeId handler,
        bool has_handler,
    },
    TypeAnnotation {
        Ty type_node,
        NodeId expr,
    },
}

pub struct Expr
{
    ExprKind kind,
    SourceLoc loc,
    Ty resolved_type,
}
