/* ast/stmt.crl — statement nodes */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "pat" { Pat }

pub variant StmtKind
{
    ExprStmt {
        NodeId expr,
    },
    VarDecl {
        Str name,
        Ty type_node,
        NodeId* init,
        bool is_mut,
        bool has_type,
        bool has_init,
    },
    Assign {
        NodeId target,
        NodeId value,
    },
    AssignOp {
        Str op,
        NodeId target,
        NodeId value,
    },
    Return {
        NodeId* value,
        bool has_value,
    },
    Break,
    Continue,
    Block {
        NodeId* stmts,
        u32 stmts_len,
    },
    If {
        NodeId cond,
        NodeId then_body,
        NodeId* else_body,
        bool has_else,
    },
    While {
        NodeId cond,
        NodeId body,
    },
    Loop {
        NodeId body,
    },
    For {
        NodeId* init,
        NodeId* cond,
        NodeId* post,
        NodeId body,
        bool has_init,
        bool has_cond,
        bool has_post,
    },
    ForIn {
        Str bind_name,
        Ty bind_type,
        NodeId iter_expr,
        NodeId body,
        bool has_type,
    },
    Switch {
        NodeId expr,
        NodeId* cases,
        u32 cases_len,
    },
    Defer {
        NodeId body,
    },
    Comptime {
        NodeId* stmts,
        u32 stmts_len,
    },
    Asm {
        bool is_volatile,
        NodeId* template,
        u32 template_len,
    },
    Throw {
        NodeId expr,
    },
    Bare {
        NodeId expr,
    },
}

pub struct SwitchCase
{
    NodeId* patterns,
    u32 patterns_len,
    NodeId* guard,
    bool has_guard,
    NodeId body,
    SourceLoc loc,
}

pub struct Stmt
{
    StmtKind kind,
    SourceLoc loc,
}
