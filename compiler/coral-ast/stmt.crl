/* ast/stmt.crl — statement nodes
 *
 * Actual Coral declaration syntax:
 *   Type name;             — explicit type
 *   Type name = init;      — explicit type with init
 *   var name = init;       — type inference
 *   NO var name: Type      — this does NOT exist
 *
 * No try/catch, no &mut, no catch patterns.
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "pat" { Pat }

pub variant StmtKind
{
    ExprStmt {
        NodeId expr,
    },

    VarDecl {
        Str name,
        Ty typeNode,
        NodeId* init,
        bool isConst,
        bool hasInit,
    },

    Assign {
        NodeId target,
        NodeId value,
    },

    AssignOp {
        Str op,
        NodeId target,
        NodeId value,
    },

    Return {
        NodeId* value,
        bool hasValue,
    },

    Break,
    Continue,
    
    Block {
        NodeId* stmts,
        u32 stmtsLen,
    },

    If {
        NodeId cond,
        NodeId thenBody,
        NodeId* elseBody,
        bool hasElse,
    },

    While {
        NodeId cond,
        NodeId body,
    },

    Loop {
        NodeId body,
    },

    For {
        NodeId* init,
        NodeId* cond,
        NodeId* post,
        NodeId body,
        bool hasInit,
        bool hasCond,
        bool hasPost,
    },

    ForIn {
        Str bindName,
        NodeId iterExpr,
        NodeId body,
    },
    
    Switch {
        NodeId expr,
        NodeId* cases,
        u32 casesLen,
    },

    Defer {
        NodeId body,
    },

    Comptime {
        NodeId* stmts,
        u32 stmtsLen,
    },

    Asm {
        bool isVolatile,
        NodeId* template,
        u32 templateLen,
    },

    Bare {
        NodeId expr,
    },
}

pub struct SwitchCase
{
    NodeId* patterns,
    u32 patternsLen,
    NodeId* guard,
    bool hasGuard,
    NodeId body,
    SourceLoc loc,
}

pub struct Stmt
{
    StmtKind kind,
    SourceLoc loc,
}
