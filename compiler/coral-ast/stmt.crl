/* ast/stmt.crl — statement nodes
 *
 * if/else and switch can be BOTH statements and expressions in Coral:
 *   var x = if (cond) { a } else { b };
 *   var x = switch (val) { A => { 1 },
 else => { 0 } };
 *
 * Declaration syntax:
 *   Type name;           — explicit type
 *   Type name = init;    — explicit type with init
 *   var name = init;     — type inference
 *
 * For loop: for (T name : iterable) { body }
 *   T can be var or a type
 *
 * Clang-inspired performance principles:
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Bit-pack booleans: u8 flags instead of scattered bools
 *   - Flatten variants: split tag + data into parallel arrays
 */

import "id" { Str, SourceLoc, NodeId };
import "types" { Ty };
import "pat" { Pat };
import "decl" { Attribute };

pub struct SwitchCase
{
    NodeId* patterns;
    u32 patternsLen;
    NodeId guard;
    NodeId body;
    u8 flags;
    /* flags bits:
     *   bit 0 = hasGuard
     *   bit 1 = isFallthrough ( [[fallthrough]] allows missing else)
     */
}

pub variant StmtKind
{
    ExprStmt { NodeId expr; },

    VarDecl {
        Str name;
        Ty typeNode;
        NodeId init;
        u8 flags;
        /* flags bits:
         *   bit 0 = isConst
         *   bit 1 = hasInit
         */
    },

    Assign {
        NodeId target;
        NodeId value;
        Str op;
    },

    Return { NodeId value; },

    Break,
    Continue,

    Block {
        NodeId* stmts;
        u32 stmtsLen;
    },

    If {
        NodeId cond;
        NodeId thenBody;
        NodeId elseBody;
    },

    While {
        NodeId cond;
        NodeId body;
    },

    Loop { NodeId body; },

    For {
        NodeId init;
        NodeId cond;
        NodeId post;
        NodeId body;
        u8 flags;
        /* flags bits:
         *   bit 0 = hasInit
         *   bit 1 = hasCond
         *   bit 2 = hasPost
         */
    },

    ForIn {
        Str bindName;
        Ty bindType;
        NodeId iterExpr;
        NodeId body;
        u8 flags;
        /* flags bits:
         *   bit 0 = isVar (var instead of explicit type)
         */
    },

    Switch {
        NodeId expr;
        SwitchCase* cases;
        u32 casesLen;
    },

    Defer { NodeId stmt; },

    Comptime {
        NodeId* stmts;
        u32 stmtsLen;
    },

    Asm {
        NodeId* template;
        u32 templateLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isVolatile
         */
    }
}

pub struct Stmt
{
    StmtKind kind;
    SourceLoc loc;
    Attribute* attrs;
    u32 attrsLen;
}
