/* ast/stmt.crl — statement and expression nodes
 *
 * if/else and switch can be BOTH statements and expressions in Coral:
 *   var x = if (cond) { a } else { b };
 *   var x = switch (val) { A => { 1 }, else => { 0 } };
 *
 * Declaration syntax:
 *   Type name;           — explicit type
 *   Type name = init;    — explicit type with init
 *   var name = init;     — type inference
 *
 * For loop: for (T name : iterable) { body }
 *   T can be var or a type
 *
 * Clang-inspired performance principles:
 *   - Flatten variants: split tag + data into parallel arrays
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Bit-pack booleans: u8 flags instead of scattered bools
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "pat" { Pat }

pub struct SwitchCase
{
    NodeId* patterns,
    u32 patternsLen,
    NodeId* guard,
    bool hasGuard,
    NodeId body,
    SourceLoc loc,
}

pub variant StmtKind
{
    ExprStmt {
        NodeId expr,
    },

    VarDecl {
        Str name,
        Ty typeNode,
        NodeId* init,
        bool isConst,
        bool hasInit,
    },

    Assign {
        NodeId target,
        NodeId value,
    },

    AssignOp {
        Str op,
        NodeId target,
        NodeId value,
    },

    Return {
        NodeId* value,
        bool hasValue,
    },

    Break,
    Continue,
    
    Block {
        NodeId* stmts,
        u32 stmtsLen,
    },

    If {
        NodeId cond,
        NodeId thenBody,
        NodeId* elseBody,
        bool hasElse,
    },

    While {
        NodeId cond,
        NodeId body,
    },

    Loop {
        NodeId body,
    },

    For {
        NodeId* init,
        NodeId* cond,
        NodeId* post,
        NodeId body,
        bool hasInit,
        bool hasCond,
        bool hasPost,
    },

    ForIn {
        Str bindName,
        Ty bindType,
        bool isVar,
        NodeId iterExpr,
        NodeId body,
    },

    Switch {
        NodeId expr,
        NodeId* cases,
        u32 casesLen,
    },

    Defer {
        NodeId body,
    },

    Comptime {
        NodeId* stmts,
        u32 stmtsLen,
    },

    Asm {
        bool isVolatile,
        NodeId* template,
        u32 templateLen,
    },

    Bare {
        NodeId expr,
    }
}

pub struct Stmt
{
    StmtKind kind,
    SourceLoc loc,
}
