/* ast/node.crl — top-level AST node */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }
import "expr" { Expr }
import "stmt" { Stmt }
import "decl" { Decl, File }
import "pat" { Pat }

pub variant Node
{
    Expr { Expr value },
    Stmt { Stmt value },
    Decl { Decl value },
    Pat { Pat value },
    Type { Ty value },
}

pub struct Ast
{
    File file,
    Node* nodes,
    u32 nodes_len,
}
