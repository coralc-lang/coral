/* ast/node.crl — universal AST node wrapper
 *
 * Node is a flat wrapper that references other node types by index.
 * The actual data lives in parallel arrays in the Ast struct.
 *
 * Clang-inspired performance principles:
 *   - Flatten variants: NodeKind tag + parallel arrays per kind
 *   - NodeId is u32 index (4 bytes, not 8-byte pointer)
 *   - Ast owns all data — single allocation, no pointer chasing
 *   - Immutable nodes: create once, never modify
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty, TypeEntry }
import "expr" { Expr }
import "stmt" { Stmt }
import "decl" { Decl, File }
import "pat" { Pat }

pub variant NodeKind
{
    Expr { Expr value; },
    Stmt { Stmt value; },
    Decl { Decl value; },
    Pat { Pat value; },
    Type { Ty value; }
}

pub struct Node
{
    NodeKind kind;
    SourceLoc loc;
}

pub struct Ast
{
    File* files;
    u32 filesLen;
    Node* nodes;
    u32 nodesLen;
    TypeEntry* types;
    u32 typesLen;
}
