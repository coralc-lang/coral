/* ast/node.crl — top-level AST node
 * This is the universal container. Every node in the tree is a NodeId
 * that indexes into a flat arena. The arena stores Node values, each of
 * which is one of these variants.
 *
 * This design is borrowed from Rust's ast/mod.rs and Zig's Ast.
 * Benefits:
 *   - Flat storage = cache-friendly traversal
 *   - NodeId = 8 bytes (file + index) — cheap to pass around
 *   - No heap allocation per node
 *   - Easy to serialize/deserialize for incremental compilation
 */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty, TypeKind }
import "expr" { Expr, ExprKind }
import "stmt" { Stmt, StmtKind }
import "decl" { Decl, DeclKind, File }
import "pat" { Pat, PatKind }

pub variant Node
{
    Expr { Expr },
    Stmt { Stmt },
    Decl { Decl } ,
    Pat { Pat },
    Type { Ty ),
}

pub struct Ast
{
    File file,
    Slice<Node> nodes,
}
