/* ast/pat.crl — pattern nodes for switch */

import "id" { Str, SourceLoc, NodeId }

pub variant PatKind
{
    Wildcard,
    Lit {
        NodeId expr,
    },

    Ident {
        Str name,
    },

    Type {
        Str name,
    },

    Variant {
        Str typeName,
        Str variant,
        NodeId* fieldNames,
        u32 fieldNamesLen,
        bool hasType,
    },

    Tuple {
        NodeId* elems,
        u32 elemsLen,
    },

    Struct {
        Str name,
        NodeId* fieldNames,
        u32 fieldNamesLen,
    },

    Or {
        NodeId* alternatives,
        u32 alternativesLen,
    },

    Guard {
        NodeId pattern,
        NodeId cond,
    },

    Range {
        NodeId start,
        NodeId end,
        bool inclusive,
    }
}

pub struct Pat
{
    PatKind kind,
    SourceLoc loc,
}
