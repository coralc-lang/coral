/* ast/pat.crl — pattern nodes
 *
 * Actual Coral pattern syntax in switch:
 *   _                      — wildcard
 *   literal                — int, string, bool, char
 *   name                   — binding
 *   TypeName               — enum variant (unit)
 *   Variant { field: pat } — variant with payload
 *   (pat, pat, ...)        — tuple pattern
 *   Name { field: pat }    — struct pattern
 *   pat | pat | pat        — or-pattern
 *   pat if cond            — guard
 *   start..end             — range
 *   start..=end            — inclusive range
 *
 * No: &x/&mut x patterns, catch patterns
 */

import "id" { Str, SourceLoc, NodeId }

pub variant PatKind
{
    Wildcard,
    Lit {
        NodeId expr,
    },

    Ident {
        Str name,
    },

    Type {
        Str name,
    },

    Variant {
        Str type_name,
        Str variant,
        NodeId* field_names,
        u32 field_names_len,
        bool has_type,
    },

    Tuple {
        NodeId* elems,
        u32 elems_len,
    },

    Struct {
        Str name,
        NodeId* field_names,
        u32 field_names_len,
    },

    Or {
        NodeId* alternatives,
        u32 alternatives_len,
    },

    Guard {
        NodeId pattern,
        NodeId cond,
    },

    Range {
        NodeId start,
        NodeId end,
        bool inclusive,
    },
}

pub struct Pat
{
    PatKind kind,
    SourceLoc loc,
}
