/* ast/pat.crl — pattern nodes */

import "id" { Str, SourceLoc, NodeId }
import "types" { Ty }

pub variant PatKind
{
    Wildcard,
    Lit {
        NodeId expr,
    },
    Ident {
        Str name,
    },
    Type {
        Str name,
    },
    Variant {
        Str type_name,
        Str variant,
        NodeId* fields,
        u32 fields_len,
        bool has_type,
    },
    Tuple {
        NodeId* elems,
        u32 elems_len,
    },
    Struct {
        Str name,
        NodeId* fields,
        u32 fields_len,
    },
    Ref {
        NodeId inner,
        bool is_mut,
    },
    Deref {
        NodeId inner,
    },
    Range {
        NodeId start,
        NodeId end,
        bool inclusive,
    },
    Or {
        NodeId* alternatives,
        u32 alternatives_len,
    },
    Guard {
        NodeId pattern,
        NodeId cond,
    },
    Catch {
        Str bind_name,
    },
}

pub struct BindField
{
    Str name,
    NodeId* pattern,
    bool has_pattern,
}

pub struct Pat
{
    PatKind kind,
    SourceLoc loc,
}
