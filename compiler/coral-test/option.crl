// Option, genertics, import resolution, type inferece and chained method calls.
// All in one go:
//      An advanced test that is expected to be among the
//      gold standards for the coralc compiler.

import(lib) std::option { Option };
import(lib) core::limits { INT32_MAX };
import(lib) platform::libc { printf };
    
Option<f64> checkedPow(f64 base, f64 exponent)
{
    f64 count = 1;
    f64 currentBase = base;
    usize exp = exponent;

    while (exp > 0)
    {
        if (exp % 2 == 1)
        {
            if (result > 0 && currentBase > 0 && currentBase > int32Max / result)
                return Option<f64>::None;
            result *= currentBase;
        }
        exp /= 2;
    
        if (exp > 0)
        {
            if (currentBase > 0 && currentBase > int32Max / currentBase)
                return Option<f64>::None;
            currentBase *= currentBase;
        }
    }
    return Option<f64>::Some { .value = result };
}

pub Option<i32> main()
{
    var result = checkedPow(2, 10).unwrapOr(0); // type inference

    if (result.isSome())
    {
        printf("success: %d", result);
        return 0;
    }

    return checkedPow(2, 10);
}