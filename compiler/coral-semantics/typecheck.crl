    Ty selfNamedType(Str name, NodeId* genericParams, u32 genericParamsLen)
    {
        if (genericParamsLen == 0) return self.namedType(name);
        TypeKind kind;
        Ty* args = null;
        if (genericParamsLen > 0) args = (Ty*)malloc(genericParamsLen * @sizeof(Ty));
        u32 i = 0;
        while (i < genericParamsLen)
        {
            Node* gn = self.ctx.nodes + genericParams[i].index;
            Str pname = 0;
            if (gn->kind.tag == NodeKind::GenericParam) pname = gn->kind.payload.GenericParam.value.name;
            args[i] = self.typeParamType(pname, i);
            i = i + 1;
        }
        kind = TypeKind::Named { .name = name, .genericArgs = args, .genericArgsLen = genericParamsLen };
        return self.allocType(kind);
    }

    Ty namedType(Str name)
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* entry = self.ctx.types + i;
            if (entry->kind.tag == TypeKind::Named && entry->kind.payload.Named.name == name)
                return i;
            i++;
        }
        TypeKind kind = TypeKind::Named { .name = name, .genericArgs = null, .genericArgsLen = 0 };
        return self.allocType(kind);
    }

    Ty typeParamType(Str name, u32 index)
    {
        TypeKind kind = TypeKind::TypeParam { .name = name, .index = index };
        return self.allocType(kind);
    }

    void setExprType(NodeId id, Ty typeNode)
    {
        if (id.index == 0) return;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag == NodeKind::Expr)
            node->kind.payload.Expr.value.resolvedType = typeNode;
    }

    Ty exprType(NodeId id)
    {
        if (id.index == 0) return 0;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Expr) return 0;
        return node->kind.payload.Expr.value.resolvedType;
    }

    bool sameType(Ty left, Ty right)
    {
        if (left == right) return true;
        if (left == 0 || right == 0) return false;
        TypeEntry* a = self.ctx.types + left;
        TypeEntry* b = self.ctx.types + right;
        /* During generic checking a type param may appear on one side and its
         * unparameterised Named placeholder (pre-binding parse form) on the
         * other; they denote the same type when the names match. */
        if (a->kind.tag == TypeKind::TypeParam && b->kind.tag == TypeKind::Named && b->kind.payload.Named.genericArgsLen == 0 &&
            a->kind.payload.TypeParam.name == b->kind.payload.Named.name) return true;
        if (b->kind.tag == TypeKind::TypeParam && a->kind.tag == TypeKind::Named && a->kind.payload.Named.genericArgsLen == 0 &&
            b->kind.payload.TypeParam.name == a->kind.payload.Named.name) return true;
        if (a->kind.tag != b->kind.tag) return false;
        switch (a->kind.tag)
        {
            TypeKind::Named => {
                if (a->kind.payload.Named.name != b->kind.payload.Named.name) return false;
                if (a->kind.payload.Named.genericArgsLen != b->kind.payload.Named.genericArgsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Named.genericArgsLen)
                {
                    if (!self.sameType(a->kind.payload.Named.genericArgs[i], b->kind.payload.Named.genericArgs[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::Pointer => { return self.sameType(a->kind.payload.Pointer.base, b->kind.payload.Pointer.base); },
            TypeKind::Const => { return self.sameType(a->kind.payload.Const.base, b->kind.payload.Const.base); },
            TypeKind::Comptime => { return self.sameType(a->kind.payload.Comptime.base, b->kind.payload.Comptime.base); },
            TypeKind::Slice => { return self.sameType(a->kind.payload.Slice.base, b->kind.payload.Slice.base); },

            TypeKind::Array => {
                if (a->kind.payload.Array.len != b->kind.payload.Array.len) return false;
                return self.sameType(a->kind.payload.Array.base, b->kind.payload.Array.base);
            },
            
            TypeKind::FnPtr => {
                if (a->kind.payload.FnPtr.paramsLen != b->kind.payload.FnPtr.paramsLen) return false;
                if (!self.sameType(a->kind.payload.FnPtr.returnType, b->kind.payload.FnPtr.returnType)) return false;
                u32 i = 0;
                while (i < a->kind.payload.FnPtr.paramsLen) {
                    if (!self.sameType(a->kind.payload.FnPtr.params[i], b->kind.payload.FnPtr.params[i])) return false;
                    i++;
                }
                return true;
            },

            TypeKind::Tuple => {
                if (a->kind.payload.Tuple.elemsLen != b->kind.payload.Tuple.elemsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Tuple.elemsLen) {
                    if (!self.sameType(a->kind.payload.Tuple.elems[i], b->kind.payload.Tuple.elems[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::TypeParam => { return a->kind.payload.TypeParam.name == b->kind.payload.TypeParam.name; },
            else => { return true; }
        }
    }

    u32 intWidth(Ty t)
    {
        if (t == 0) return 0;
        TypeEntry* entry = self.ctx.types + t;
        switch (entry->kind.tag)
        {
            TypeKind::U8, TypeKind::I8 => { return 8; },
            /* char is a UTF-32 codepoint (u32 width), never a byte —
             * bytes are u8/cchar */
            TypeKind::Char => { return 32; },
            TypeKind::U16, TypeKind::I16 => { return 16; },
            TypeKind::U32, TypeKind::I32 => { return 32; },
            TypeKind::U64, TypeKind::I64, TypeKind::Usize, TypeKind::Isize => { return 64; },
            TypeKind::U128, TypeKind::I128 => { return 128; },
            else => { return 0; },
        }
    }

    bool intSigned(Ty t)
    {
        if (t == 0) return false;
        TypeEntry* entry = self.ctx.types + t;
        switch (entry->kind.tag)
        {
            TypeKind::I8, TypeKind::I16, TypeKind::I32, TypeKind::I64, TypeKind::Isize, TypeKind::I128 => { return true; },
            else => { return false; },
        }
    }

    bool integerType(Ty typeNode)
    {
        if (typeNode == 0) return false;
        TypeEntry* entry = self.ctx.types + typeNode;
        return entry->kind.tag == TypeKind::U8 || entry->kind.tag == TypeKind::U16 || entry->kind.tag == TypeKind::U32 || entry->kind.tag == TypeKind::U64 || entry->kind.tag == TypeKind::U128 || entry->kind.tag == TypeKind::I8 || entry->kind.tag == TypeKind::I16 || entry->kind.tag == TypeKind::I32 || entry->kind.tag == TypeKind::I64 || entry->kind.tag == TypeKind::I128 || entry->kind.tag == TypeKind::Usize || entry->kind.tag == TypeKind::Isize || entry->kind.tag == TypeKind::Char;
    }

    bool floatType(Ty typeNode)
    {
        if (typeNode == 0) return false;
        TypeEntry* entry = self.ctx.types + typeNode;
        return entry->kind.tag == TypeKind::F32 || entry->kind.tag == TypeKind::F64;
    }

    u32 genericCount(NodeId id)
    {
        if (id.index == 0) return 0;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Decl) return 0;
        Decl* decl = &node->kind.payload.Decl.value;
        switch (decl->kind.tag)
        {
            DeclKind::Func => { return decl->kind.payload.Func.genericParamsLen; },
            DeclKind::Struct => { return decl->kind.payload.Struct.genericParamsLen; },
            DeclKind::Variant => { return decl->kind.payload.Variant.genericParamsLen; },
            DeclKind::Union => { return decl->kind.payload.Union.genericParamsLen; },
            DeclKind::Trait => { return decl->kind.payload.Trait.genericParamsLen; },
            DeclKind::Extend => { return decl->kind.payload.Extend.genericParamsLen; },
            DeclKind::ExtendTrait => { return decl->kind.payload.ExtendTrait.genericParamsLen; },
            else => { return 0; }
        }
    }

    bool checkType(Ty typeNode)
    {
        if (typeNode == 0) return true;
        TypeEntry* entry = self.ctx.types + typeNode;
        switch (entry->kind.tag)
        {
            TypeKind::Named => {
                Str tn = entry->kind.payload.Named.name;
                Symbol* symbol = self.scopes.lookup(tn);
                if (symbol == null) {
                    self.semaError(ErrorCode::SemaUndeclaredIdent, entry->loc, self.nameMsg((u8*)"unknown type name: ", tn));
                    return false;
                }
                u32 want = entry->kind.payload.Named.genericArgsLen;
                u32 expected = self.genericCount(symbol->declaration);
                if (expected != want)
                {
                    /* merged files may declare the same name (libc's extern
                     * realloc vs mman's realloc<T>) — prefer a decl whose
                     * generic arity matches the explicit arguments */
                    Symbol** cands = (Symbol**)malloc(16 * @sizeof(Symbol*));
                    if (cands != null)
                    {
                        u32 n = self.scopes.lookupAll(tn, cands, 16);
                        u32 a = 0;
                        while (a < n)
                        {
                            if (self.genericCount(cands[a]->declaration) == want)
                            {
                                symbol = cands[a];
                                break;
                            }
                            a = a + 1;
                        }
                        free((rawptr)cands);
                    }
                    expected = self.genericCount(symbol->declaration);
                }
                if (expected != want) {
                    self.semaError(ErrorCode::SemaArityMismatch, entry->loc, "wrong number of generic arguments");
                    return false;
                }
                u32 i = 0;
                while (i < entry->kind.payload.Named.genericArgsLen) {
                    if (!self.checkType(entry->kind.payload.Named.genericArgs[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::Pointer => { return self.checkType(entry->kind.payload.Pointer.base); },
            TypeKind::Const => { return self.checkType(entry->kind.payload.Const.base); },
            TypeKind::Comptime => { return self.checkType(entry->kind.payload.Comptime.base); },
            TypeKind::Slice => { return self.checkType(entry->kind.payload.Slice.base); },
            TypeKind::Array => { return self.checkType(entry->kind.payload.Array.base); },
            
            TypeKind::FnPtr => {
                if (!self.checkType(entry->kind.payload.FnPtr.returnType)) return false;
                u32 i = 0;
                while (i < entry->kind.payload.FnPtr.paramsLen) {
                    if (!self.checkType(entry->kind.payload.FnPtr.params[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::Tuple => {
                u32 i = 0;
                while (i < entry->kind.payload.Tuple.elemsLen) {
                    if (!self.checkType(entry->kind.payload.Tuple.elems[i])) return false;
                    i++;
                }
                return true;
            },
            else => { return true; }
        }
    }

    bool dependentType(Ty typeNode)
    {
        if (typeNode == 0) return false;
        TypeEntry* entry = self.ctx.types + typeNode;
        if (entry->kind.tag == TypeKind::TypeParam) return true;
        if (entry->kind.tag == TypeKind::Named)
        {
            u32 i = 0;
            while (i < entry->kind.payload.Named.genericArgsLen) {
                if (self.dependentType(entry->kind.payload.Named.genericArgs[i])) return true;
                i++;
            }
            Symbol* symbol = self.scopes.lookup(entry->kind.payload.Named.name);
            if (symbol != null && symbol->kind == 4) return true;
            return false;
        }
        if (entry->kind.tag == TypeKind::Pointer) return self.dependentType(entry->kind.payload.Pointer.base);
        if (entry->kind.tag == TypeKind::Const) return self.dependentType(entry->kind.payload.Const.base);
        if (entry->kind.tag == TypeKind::Comptime) return self.dependentType(entry->kind.payload.Comptime.base);
        if (entry->kind.tag == TypeKind::Slice) return self.dependentType(entry->kind.payload.Slice.base);
        if (entry->kind.tag == TypeKind::Array) return self.dependentType(entry->kind.payload.Array.base);
        return false;
    }

    bool genericArgParam(Decl* decl, Param* param)
    {
        if (decl == null || param == null) return false;
        if (decl->kind.tag != DeclKind::Func) return false;
        if (param->typeNode == 0) return false;
        Ty base = param->typeNode;
        TypeEntry* entry = self.ctx.types + base;
        while (entry != null && entry->kind.tag == TypeKind::Const)
        {
            base = entry->kind.payload.Const.base;
            if (base == 0) return false;
            entry = self.ctx.types + base;
        }
        if (entry == null) return false;
        if (entry->kind.tag == TypeKind::TypeParam) return true;
        if (entry->kind.tag != TypeKind::Named) return false;
        if ((param->flags & 8) != 0) return true;
        Str name = entry->kind.payload.Named.name;
        u32 i = 0;
        while (i < decl->kind.payload.Func.genericParamsLen)
        {
            Node* genericNode = self.ctx.nodes + decl->kind.payload.Func.genericParams[i].index;
            if (genericNode->kind.tag == NodeKind::GenericParam)
            {
                GenericParam* generic = &genericNode->kind.payload.GenericParam.value;
                if (generic->name == name) return true;
            }
            i++;
        }
        return false;
    }

    Str structParamName(Ty objectType, u32 index)
    {
        if (objectType == 0) return 0;
        TypeEntry* obj = self.ctx.types + objectType;
        if (obj->kind.tag != TypeKind::Named) return 0;
        Symbol* symbol = self.scopes.lookup(obj->kind.payload.Named.name);
        if (symbol == null) return 0;
        Node* declNode = self.ctx.nodes + symbol->declaration.index;
        if (declNode->kind.tag != NodeKind::Decl) return 0;
        Decl* decl = &declNode->kind.payload.Decl.value;
        NodeId* generics = null;
        u32 count = 0;

        if (decl->kind.tag == DeclKind::Struct) {
            generics = decl->kind.payload.Struct.genericParams;
            count = decl->kind.payload.Struct.genericParamsLen;
        } else if (decl->kind.tag == DeclKind::Variant) {
            generics = decl->kind.payload.Variant.genericParams;
            count = decl->kind.payload.Variant.genericParamsLen;
        } else if (decl->kind.tag == DeclKind::Union) {
            generics = decl->kind.payload.Union.genericParams;
            count = decl->kind.payload.Union.genericParamsLen;
        } else if (decl->kind.tag == DeclKind::Trait) {
            generics = decl->kind.payload.Trait.genericParams;
            count = decl->kind.payload.Trait.genericParamsLen;
        }
        if (generics == null || index >= count) return 0;
        Node* genericNode = self.ctx.nodes + generics[index].index;
        if (genericNode->kind.tag != NodeKind::GenericParam) return 0;
        return genericNode->kind.payload.GenericParam.value.name;
    }

    /* Structural match where TypeParam entries in `pattern` act as wildcards —
     * used to match an extend's self type (`Option<T>`) against a concrete
     * receiver (`Option<f64>`) */
    bool sameTypePattern(Ty pattern, Ty concrete)
    {
        if (pattern == concrete) return true;
        if (pattern == 0 || concrete == 0) return false;
        TypeEntry* a = self.ctx.types + pattern;
        TypeEntry* b = self.ctx.types + concrete;
        if (a->kind.tag == TypeKind::TypeParam) return true;
        if (a->kind.tag != b->kind.tag) return false;
        switch (a->kind.tag)
        {
            TypeKind::Named => {
                if (a->kind.payload.Named.name != b->kind.payload.Named.name) return false;
                if (a->kind.payload.Named.genericArgsLen != b->kind.payload.Named.genericArgsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Named.genericArgsLen)
                {
                    if (!self.sameTypePattern(a->kind.payload.Named.genericArgs[i], b->kind.payload.Named.genericArgs[i])) return false;
                    i++;
                }
                return true;
            },
            TypeKind::Pointer => { return self.sameTypePattern(a->kind.payload.Pointer.base, b->kind.payload.Pointer.base); },
            TypeKind::Const => { return self.sameTypePattern(a->kind.payload.Const.base, b->kind.payload.Const.base); },
            TypeKind::Comptime => { return self.sameTypePattern(a->kind.payload.Comptime.base, b->kind.payload.Comptime.base); },
            TypeKind::Slice => { return self.sameTypePattern(a->kind.payload.Slice.base, b->kind.payload.Slice.base); },
            TypeKind::Array => {
                if (a->kind.payload.Array.len != b->kind.payload.Array.len) return false;
                return self.sameTypePattern(a->kind.payload.Array.base, b->kind.payload.Array.base);
            },
            TypeKind::FnPtr => {
                if (a->kind.payload.FnPtr.paramsLen != b->kind.payload.FnPtr.paramsLen) return false;
                if (!self.sameTypePattern(a->kind.payload.FnPtr.returnType, b->kind.payload.FnPtr.returnType)) return false;
                u32 i = 0;
                while (i < a->kind.payload.FnPtr.paramsLen) {
                    if (!self.sameTypePattern(a->kind.payload.FnPtr.params[i], b->kind.payload.FnPtr.params[i])) return false;
                    i++;
                }
                return true;
            },
            TypeKind::Tuple => {
                if (a->kind.payload.Tuple.elemsLen != b->kind.payload.Tuple.elemsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Tuple.elemsLen) {
                    if (!self.sameTypePattern(a->kind.payload.Tuple.elems[i], b->kind.payload.Tuple.elems[i])) return false;
                    i++;
                }
                return true;
            },
            else => { return true; }
        }
        return true;
    }

    Ty substituteFieldTy(Ty fieldType, Ty objectType)
    {
        if (fieldType == 0 || objectType == 0) return fieldType;
        TypeEntry* obj = self.ctx.types + objectType;
        while (obj != null)
        {
            if (obj->kind.tag == TypeKind::Pointer) objectType = obj->kind.payload.Pointer.base;
            else if (obj->kind.tag == TypeKind::Const) objectType = obj->kind.payload.Const.base;
            else if (obj->kind.tag == TypeKind::Comptime) objectType = obj->kind.payload.Comptime.base;
            else break;
            if (objectType == 0) return fieldType;
            obj = self.ctx.types + objectType;
        }
        if (obj == null || obj->kind.tag != TypeKind::Named) return fieldType;
        u32 objArgsLen = obj->kind.payload.Named.genericArgsLen;
        Ty* objArgs = obj->kind.payload.Named.genericArgs;
        if (objArgsLen == 0) return fieldType;
        TypeEntry* entry = self.ctx.types + fieldType;
        switch (entry->kind.tag)
        {
            TypeKind::TypeParam => {
                u32 i = 0;
                while (i < objArgsLen) {
                    if (self.structParamName(objectType, i) == entry->kind.payload.TypeParam.name) return objArgs[i];
                    i++;
                }
                return fieldType;
            },
            
            TypeKind::Named => {
                if (entry->kind.payload.Named.genericArgsLen == 0) {
                    Str name = entry->kind.payload.Named.name;
                    u32 i = 0;
                    while (i < objArgsLen) {
                        if (self.structParamName(objectType, i) == name) return objArgs[i];
                        i++;
                    }
                    return fieldType;
                }
                u32 len = entry->kind.payload.Named.genericArgsLen;
                Ty* args = (Ty*)malloc((usize)len * @sizeof(Ty));
                if (args == null) return fieldType;
                bool changed = false;
                u32 i = 0;
                while (i < len) {
                    args[i] = self.substituteFieldTy(entry->kind.payload.Named.genericArgs[i], objectType);
                    if (args[i] != entry->kind.payload.Named.genericArgs[i]) changed = true;
                    i++;
                }
                if (!changed) {
                    free((rawptr)args);
                    return fieldType;
                }
                if (!self.ctx.track((rawptr)args)) {
                    free((rawptr)args);
                    return fieldType;
                }
                TypeKind kind = TypeKind::Named{ .name = entry->kind.payload.Named.name, .genericArgs = args, .genericArgsLen = len };
                return self.allocType(kind);
            },
            
            TypeKind::Pointer => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Pointer.base, objectType);
                if (base == entry->kind.payload.Pointer.base) return fieldType;
                TypeKind kind = TypeKind::Pointer{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Const => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Const.base, objectType);
                if (base == entry->kind.payload.Const.base) return fieldType;
                TypeKind kind = TypeKind::Const{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Comptime => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Comptime.base, objectType);
                if (base == entry->kind.payload.Comptime.base) return fieldType;
                TypeKind kind = TypeKind::Comptime{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Slice => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Slice.base, objectType);
                if (base == entry->kind.payload.Slice.base) return fieldType;
                TypeKind kind = TypeKind::Slice{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Array => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Array.base, objectType);
                if (base == entry->kind.payload.Array.base) return fieldType;
                TypeKind kind = TypeKind::Array{ .base = base, .len = entry->kind.payload.Array.len };
                return self.allocType(kind);
            },
            else => { return fieldType; }
        }
    }

    bool compatible(Ty from, Ty to)
    {
        if (from == 0 || to == 0) return true;
        if (self.sameType(from, to)) return true;

        TypeEntry* source = self.ctx.types + from;
        TypeEntry* target = self.ctx.types + to;
        if (source->kind.tag == TypeKind::Const)
            return self.compatible(source->kind.payload.Const.base, to);
        if (source->kind.tag == TypeKind::Comptime)
            return self.compatible(source->kind.payload.Comptime.base, to);
        if (target->kind.tag == TypeKind::Const)
            return self.compatible(from, target->kind.payload.Const.base);
        if (target->kind.tag == TypeKind::Comptime)
            return self.compatible(from, target->kind.payload.Comptime.base);

        /* Pointer structure first: adding qualification to the target is
         * allowed (T* -> const T*), matching element type is required. */
        if (source->kind.tag == TypeKind::Pointer && target->kind.tag == TypeKind::Pointer)
        {
            Ty sb = source->kind.payload.Pointer.base;
            Ty tb = target->kind.payload.Pointer.base;
            while (tb != 0)
            {
                TypeEntry* te = self.ctx.types + tb;
                if (te->kind.tag == TypeKind::Const) tb = te->kind.payload.Const.base;
                else if (te->kind.tag == TypeKind::Comptime) tb = te->kind.payload.Comptime.base;
                else break;
            }
            if (self.sameType(sb, tb)) return true;
        }
        if (source->kind.tag == TypeKind::Pointer && target->kind.tag == TypeKind::Rawptr)
            return true;

        /* array decay: T[] matches T* / rawptr (stack buffers passed to
         * pointer params, `p >= buf` comparisons) */
        if (source->kind.tag == TypeKind::Array && target->kind.tag == TypeKind::Pointer)
        {
            Ty tb2 = target->kind.payload.Pointer.base;
            while (tb2 != 0)
            {
                TypeEntry* te2 = self.ctx.types + tb2;
                if (te2->kind.tag == TypeKind::Const) tb2 = te2->kind.payload.Const.base;
                else if (te2->kind.tag == TypeKind::Comptime) tb2 = te2->kind.payload.Comptime.base;
                else break;
            }
            if (self.sameType(source->kind.payload.Array.base, tb2)) return true;
        }
        if (source->kind.tag == TypeKind::Array && target->kind.tag == TypeKind::Rawptr)
            return true;

        /* Integer conversion only when it cannot narrow (C-style
         * integer promotion): same signedness widening is fine; narrowing
         * or int<->float still requires an explicit cast. Equal-width
         * same-signedness matches; same-width unsigned->signed is NOT a
         * faithful conversion unless the target is strictly wider. */
        if (self.integerType(from) && self.integerType(to))
        {
            u32 fw = self.intWidth(from);
            u32 tw = self.intWidth(to);
            if (tw < fw) return false;
            if (tw == fw && self.intSigned(from) != self.intSigned(to)) return false;
            if (!self.intSigned(from) && self.intSigned(to) && tw <= fw) return false;
            return true;
        }

        /* Dependent/generic flexibility (no bounds yet — mono boundary is
         * the enforcement point): one side dependent fits anything, BUT two
         * distinct dependent types are not interchangeable unless their
         * shapes already matched above. */
        bool fromDep = self.dependentType(from);
        bool toDep = self.dependentType(to);
        if (fromDep && toDep) return false;
        if (fromDep || toDep) return true;
        return false;
    }
}
