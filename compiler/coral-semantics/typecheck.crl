        TypeKind kind;
        kind.tag = TypeKind::Usize;
        return self.allocType(kind);
    }

    /* str.ptr — const u8* (immutable *byte* view into the literal/storage;
     * str is a byte string, `char` is utf32 and never a byte) */
    Ty strPtrType()
    {
        Ty b = self.u8Type();
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* e = self.ctx.types + i;
            if (e->kind.tag == TypeKind::Pointer && e->kind.payload.Pointer.base == b) return i;
            i++;
        }
        TypeKind inner = TypeKind::Const{ .base = b };
        Ty cst = self.allocType(inner);
        TypeKind kind = TypeKind::Pointer{ .base = cst };
        return self.allocType(kind);
    }

    /* C"..." → const cchar* — NUL-terminated C-ABI byte string, matching
     * libc's `const cchar*` params (printf/snprintf/...). Built by name so
     * the literal type-checks against those params without the calling
     * file importing cchar itself; sameType compares Named by name. */
    Ty ccharPtrType()
    {
        Str cn = self.ctx.intern((u8*)"cchar", 5);
        Ty named = 0;
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* e = self.ctx.types + i;
            if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.name == cn &&
                e->kind.payload.Named.genericArgsLen == 0) { named = i; break; }
            i = i + 1;
        }
        if (named == 0) {
            TypeKind nk;
            nk = TypeKind::Named{ .name = cn, .genericArgs = null, .genericArgsLen = 0 };
            named = self.allocType(nk);
        }
        /* Const{Pointer{Named}} — the shape `const cchar*` params parse to
         * (type-position const wraps the whole type) and, via compatible()'s
         * source-const strip, also assignable to statement-const locals
         * (`const cchar* s` = bare Pointer + const flag) */
        TypeKind pk;
        pk = TypeKind::Pointer{ .base = named };
        Ty ptr = self.allocType(pk);
        TypeKind ck;
        ck = TypeKind::Const{ .base = ptr };
        return self.allocType(ck);
    }

    Ty i32Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::I32) return i;
            i++;
