mod id = import "../coral-ast/id";
mod types = import "../coral-ast/types";
mod node = import "../coral-ast/node";
mod decl_ast = import "../coral-ast/decl";
mod context = import "../coral-context/context";
mod scope = import "scope";
mod sema = import "sema";
mod diagnostics = import "../coral-diagnostics/code";

import id { Str, NodeId };
import types { Ty, TypeEntry, TypeKind };
import node { Node, NodeKind };
import decl_ast { File, Decl, DeclKind, ImportSymbol, GenericParam };
import context { InternEntry };
import scope { Symbol, ScopeStack };
import sema { Sema };
import diagnostics { ErrorCode };

pub extend Sema
{
    bool checkDecl(NodeId id, bool bodies)
    {
        if (id.index == 0) return true;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Decl) return true;
        Decl* decl = &node->kind.payload.Decl.value;
        u8 symbolFlags = 0;
        u8 kind = 0;
        Str name = 0;
        Ty typeNode = 0;
        switch (decl->kind.tag)
        {
            DeclKind::Func => {
                kind = 2;
                name = decl->kind.payload.Func.name;
                typeNode = decl->kind.payload.Func.returnType;
            },
            DeclKind::Struct => {
                kind = 3;
                name = decl->kind.payload.Struct.name;
                typeNode = self.namedType(name);
            },
            DeclKind::Variant => {
                kind = 3;
                name = decl->kind.payload.Variant.name;
                typeNode = self.namedType(name);
            },
            DeclKind::Enum => {
                kind = 3;
                name = decl->kind.payload.Enum.name;
                typeNode = self.namedType(name);
            },
            DeclKind::Union => {
                kind = 3;
                name = decl->kind.payload.Union.name;
                typeNode = self.namedType(name);
            },
            DeclKind::Trait => {
                kind = 3;
                name = decl->kind.payload.Trait.name;
                typeNode = self.namedType(name);
            },
            DeclKind::TypeAlias => {
                kind = 3;
                name = decl->kind.payload.TypeAlias.name;
                typeNode = decl->kind.payload.TypeAlias.target;
            },
            DeclKind::Distinct => {
                kind = 3;
                name = decl->kind.payload.Distinct.name;
                typeNode = decl->kind.payload.Distinct.baseType;
            },
            DeclKind::Constant => {
                kind = 1;
                name = decl->kind.payload.Constant.name;
                typeNode = decl->kind.payload.Constant.typeNode;
                /* parser flags bit 16 = `const` — mark the symbol const so
                 * assignments to it are rejected (TC-0008) */
                if ((decl->kind.payload.Constant.flags & 16) != 0) symbolFlags = symbolFlags | 1;
                if (typeNode == 0 && decl->kind.payload.Constant.value.index != 0)
                {
                    if (self.checkExpr(decl->kind.payload.Constant.value))
                    {
                        Ty inferred = self.exprType(decl->kind.payload.Constant.value);
                        if (inferred != 0)
                        {
                            typeNode = inferred;
                            decl->kind.payload.Constant.typeNode = inferred;
                        }
                    }
                }
            },
            DeclKind::ModReexport => {
                kind = 5;
                name = decl->kind.payload.ModReexport.alias;
            },
            DeclKind::Import => {
                if (!bodies && !self.checkImportDecl(id, decl)) return false;
            },
            else => {}
        }
        /* symbols are declared once, on the declareAll pass — checkBodies
         * would only repeat the declaration (and re-count its failure) */
        if (name != 0 && !bodies)
        {
            if (!self.scopes.declare(name, kind, typeNode, id, symbolFlags, self.fileOf(id)) &&
                self.scopes.lastDeclFail == 1)
                self.semaErrorCounted(ErrorCode::SemaDuplicateDecl, id, "duplicate declaration of this name");
        }
        if (!bodies) return true;
        if (decl->kind.tag == DeclKind::Func)
            return self.checkFunction(decl, 0);
        if (decl->kind.tag == DeclKind::Struct)
            return self.checkMethods(decl->kind.payload.Struct.methods, decl->kind.payload.Struct.methodsLen, self.selfNamedType(decl->kind.payload.Struct.name, decl->kind.payload.Struct.genericParams, decl->kind.payload.Struct.genericParamsLen), decl->kind.payload.Struct.genericParams, decl->kind.payload.Struct.genericParamsLen);
        if (decl->kind.tag == DeclKind::Union)
            return self.checkMethods(decl->kind.payload.Union.methods, decl->kind.payload.Union.methodsLen, self.selfNamedType(decl->kind.payload.Union.name, decl->kind.payload.Union.genericParams, decl->kind.payload.Union.genericParamsLen), decl->kind.payload.Union.genericParams, decl->kind.payload.Union.genericParamsLen);
        if (decl->kind.tag == DeclKind::Trait)
            return self.checkMethods(decl->kind.payload.Trait.methods, decl->kind.payload.Trait.methodsLen, self.selfNamedType(decl->kind.payload.Trait.name, decl->kind.payload.Trait.genericParams, decl->kind.payload.Trait.genericParamsLen), decl->kind.payload.Trait.genericParams, decl->kind.payload.Trait.genericParamsLen);
        if (decl->kind.tag == DeclKind::Variant)
            return self.checkMethods(decl->kind.payload.Variant.methods, decl->kind.payload.Variant.methodsLen, self.selfNamedType(decl->kind.payload.Variant.name, decl->kind.payload.Variant.genericParams, decl->kind.payload.Variant.genericParamsLen), decl->kind.payload.Variant.genericParams, decl->kind.payload.Variant.genericParamsLen);
        if (decl->kind.tag == DeclKind::Extend)
        {
            self.addExtend(id);
            return self.checkMethods(decl->kind.payload.Extend.methods, decl->kind.payload.Extend.methodsLen, decl->kind.payload.Extend.selfType, decl->kind.payload.Extend.genericParams, decl->kind.payload.Extend.genericParamsLen);
        }
        if (decl->kind.tag == DeclKind::ExtendTrait)
        {
            self.addExtend(id);
            return self.checkMethods(decl->kind.payload.ExtendTrait.methods, decl->kind.payload.ExtendTrait.methodsLen, decl->kind.payload.ExtendTrait.selfType, decl->kind.payload.ExtendTrait.genericParams, decl->kind.payload.ExtendTrait.genericParamsLen);
        }
        return true;
    }

    bool checkMethods(NodeId* methods, u32 methodsLen, Ty selfType, NodeId* genericParams, u32 genericParamsLen)
    {
        self.scopes.enter();
        bool ok = true;
        u32 genericIndex = 0;
        while (genericIndex < genericParamsLen)
        {
            NodeId genericId = genericParams[genericIndex];
            Node* genericNode = self.ctx.nodes + genericId.index;
            if (genericNode->kind.tag == NodeKind::GenericParam)
            {
                GenericParam* generic = &genericNode->kind.payload.GenericParam.value;
                Ty typeNode = self.typeParamType(generic->name, genericIndex);
                if (!self.scopes.declare(generic->name, 4, typeNode, genericId, 0, 0)) ok = false;
            }
            genericIndex = genericIndex + 1;
        }
        /* legacy `extend Option<T>`: parameter names live in the self
         * type's generic args when no explicit list was given */
        if (genericParamsLen == 0 && selfType != 0)
        {
            TypeEntry* te = self.ctx.types + selfType;
            if (te->kind.tag == TypeKind::Named)
            {
                u32 a = 0;
                while (a < te->kind.payload.Named.genericArgsLen)
                {
                    Ty arg = te->kind.payload.Named.genericArgs[a];
                    TypeEntry* ae = self.ctx.types + arg;
                    if (ae->kind.tag == TypeKind::Named)
                    {
                        Ty typeNode = self.typeParamType(ae->kind.payload.Named.name, a);
                        NodeId nid;
                        nid.index = 0;
                        self.scopes.declare(ae->kind.payload.Named.name, 4, typeNode, nid, 0, 0);
                    }
                    a = a + 1;
                }
            }
        }
        u32 i = 0;
        while (i < methodsLen)
        {
            Node* methodNode = self.ctx.nodes + methods[i].index;
            if (methodNode->kind.tag == NodeKind::Decl)
            {
                Decl* method = &methodNode->kind.payload.Decl.value;
                if (method->kind.tag == DeclKind::Func)
                {
                    if (!self.checkFunction(method, selfType)) ok = false;
                }
            }
            i = i + 1;
        }
        self.scopes.leave();
        return ok;
    }

    bool moduleExportsContain(Decl* modDecl, Str member)
    {
        if (modDecl == null) return true;
        if (modDecl->kind.tag != DeclKind::ModReexport) return true;
        if (modDecl->kind.payload.ModReexport.symbolsLen == 0) return true;
        ImportSymbol* symbols = modDecl->kind.payload.ModReexport.symbols;
        u32 i = 0;
        while (i < modDecl->kind.payload.ModReexport.symbolsLen)
        {
            if ((symbols[i].flags & 2) != 0) return true;
            if (symbols[i].name == member) return true;
            if (symbols[i].alias != 0 && symbols[i].alias == member) return true;
            i = i + 1;
        }
        return false;
    }

    bool isRootSegment(u8* ptr, u32 len)
    {
        if (len == 4 && ptr[0] == 102 && ptr[1] == 105 && ptr[2] == 108 && ptr[3] == 101) return true;
        if (len == 3 && ptr[0] == 108 && ptr[1] == 105 && ptr[2] == 98) return true;
        return false;
    }

    /* Bind every named symbol of an import into THIS file's scope, pointing
     * at the real declaration. Two direct pulls of the same local name in one
     * file conflict — alias one with `as` or use a qualified path; the same
     * name in different files stays legal (mangling keeps them apart). */
    bool bindImportSymbols(NodeId id, Decl* decl, u8* notFoundMsg)
    {
        u32 fileId = self.fileOf(id);
        u32 i = 0;
        while (i < decl->kind.payload.Import.symbolsLen)
        {
            ImportSymbol* symbol = decl->kind.payload.Import.symbols + i;
            if ((symbol->flags & 2) == 0 && symbol->name != 0)
            {
                /* tail segment for nested `mod::{ Sym }` groups */
                Str lookupName = symbol->name;
                InternEntry* se = self.ctx.interns + lookupName;
                u8* sp = se->ptr;
                usize sl = se->len;
                usize lastCol = 0;
                usize q = 0;
                while (q + 1 < sl)
                {
                    if (sp[q] == 58 && sp[q + 1] == 58) lastCol = q;
                    q = q + 1;
                }
                if (lastCol > 0 && lastCol + 2 < sl)
                    lookupName = self.ctx.intern(sp + lastCol + 2, sl - (lastCol + 2));
                Symbol* real = self.scopes.lookup(lookupName);
                if (real == null)
                {
                    self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, notFoundMsg);
                    return false;
                }
                Str local = lookupName;
                if (symbol->alias != 0) local = symbol->alias;
                if (!self.claimDirectImport(fileId, local))
                {
                    self.semaError(ErrorCode::SemaDuplicateDecl, (self.ctx.nodes + id.index)->loc, self.nameMsg((u8*)"conflicting import: already bound in this file — alias it with `as` or use a qualified path: ", local));
                    return false;
                }
                if (!self.scopes.declare(local, real->kind, real->typeNode, real->declaration, 0, fileId))
                {
                    if (self.scopes.lastDeclFail == 1)
                        self.semaErrorCounted(ErrorCode::SemaDuplicateDecl, id, self.nameMsg((u8*)"conflicting import: already bound in this file — alias it with `as` or use a qualified path: ", local));
                    return false;
                }
                /* an `as` rename: the backend mangles refs through the alias
                 * as `path__alias__name` and needs a bridge to the
                 * canonical `path__name` definition */
                if (symbol->alias != 0 && symbol->alias != lookupName)
                    self.addAliasPair(symbol->alias, real->declaration);
            }
            i = i + 1;
        }
        return true;
    }

    bool checkImportDecl(NodeId id, Decl* decl)
    {
        Str path = decl->kind.payload.Import.path;
        if (path == 0)
        {
            self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, "missing import path");
            return false;
        }
        /* path-only import: bind the last path segment as the module name
         * so qualified calls (`libc::printf`) resolve */
        if (decl->kind.payload.Import.symbolsLen == 0)
        {
            Str modName = path;
            InternEntry* pe = self.ctx.interns + path;
            usize lastCol = 0;
            usize q = 0;
            while (q + 1 < pe->len)
            {
                if (pe->ptr[q] == 58 && pe->ptr[q + 1] == 58) lastCol = q;
                q = q + 1;
            }
            if (lastCol > 0 && lastCol + 2 < pe->len)
                modName = self.ctx.intern(pe->ptr + lastCol + 2, pe->len - (lastCol + 2));
            u32 impFileId = self.fileOf(id);
            if (!self.claimDirectImport(impFileId, modName))
            {
                self.semaError(ErrorCode::SemaDuplicateDecl, (self.ctx.nodes + id.index)->loc, self.nameMsg((u8*)"conflicting import: already bound in this file — alias it with `as` or use a qualified path: ", modName));
                return false;
            }
            if (!self.scopes.declare(modName, 5, 0, id, 0, impFileId) && self.scopes.lastDeclFail == 1)
                self.semaErrorCounted(ErrorCode::SemaDuplicateDecl, id, self.nameMsg((u8*)"conflicting import: already bound in this file — alias it with `as` or use a qualified path: ", modName));
        }
        if ((decl->kind.payload.Import.flags & 1) != 0)
        {
            /* import(lib): the loader merges the target's decls flat — bind
             * each named symbol to its real declaration in this file's scope */
            return self.bindImportSymbols(id, decl, (u8*)"symbol not found in imported library");
        }
        Decl* modDecl = null;
        if ((decl->kind.payload.Import.flags & 1) == 0)
        {
            InternEntry* entry = self.ctx.interns + path;
            u32 firstLen = 0;
            while (firstLen < entry->len && entry->ptr[firstLen] != 58) firstLen = firstLen + 1;
            if (firstLen == 0)
            {
                self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, "invalid import path");
                return false;
            }
            if (!self.isRootSegment(entry->ptr, firstLen))
            {
                Str first = self.ctx.intern(entry->ptr, (usize)firstLen);
                Symbol* symbol = self.scopes.lookup(first);
                if (symbol == null)
                {
                    /* sibling file import — the loader merged <first>.crl
                     * flat, so the named symbols are plain declarations in
                     * scope; bind them into this file */
                    return self.bindImportSymbols(id, decl, (u8*)"symbol not found in imported file");
                }
                if (symbol->kind == 5 && symbol->declaration.index != 0)
                {
                    Node* modNode = self.ctx.nodes + symbol->declaration.index;
                    if (modNode->kind.tag == NodeKind::Decl)
                    {
                        Decl* resolved = &modNode->kind.payload.Decl.value;
                        if (firstLen < entry->len)
                        {
                            u32 memberStart = firstLen + 2;
                            u32 memberLen = memberStart;
                            while (memberLen < entry->len && entry->ptr[memberLen] != 58) memberLen = memberLen + 1;
                            if (memberLen <= memberStart)
                            {
                                self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, "invalid module member in import path");
                                return false;
                            }
                            Str member = self.ctx.intern(entry->ptr + memberStart, (usize)(memberLen - memberStart));
                            if (!self.moduleExportsContain(resolved, member))
                            {
                                self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "symbol not exported by module");
                                return false;
                            }
                        }
                        else modDecl = resolved;
                    }
                }
            }
        }
        if (modDecl != null)
        {
            u32 i = 0;
            while (i < decl->kind.payload.Import.symbolsLen)
            {
                ImportSymbol* symbol = decl->kind.payload.Import.symbols + i;
                if ((symbol->flags & 2) == 0 && symbol->name != 0)
                {
                    if (!self.moduleExportsContain(modDecl, symbol->name))
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "symbol not exported by module");
                        return false;
                    }
                }
                i = i + 1;
            }
        }
        return self.bindImportSymbols(id, decl, (u8*)"symbol not found in imported module");
    }

    bool checkFile(File* file)
    {
        if (file == null)
        {
            self.semaErrorNode(ErrorCode::SemaInternal, self.ctx.noneNode(), "checkFile called with null file");
            return false;
        }
        if (!self.scopes.enter())
        {
            self.semaErrorNode(ErrorCode::SemaInternal, self.ctx.noneNode(), "scopes.enter failed");
            return false;
        }
        self.declareAll(file);
        self.checkBodies(file);
        self.errors = self.scopes.errors;
        return self.errors == 0;
    }

    void declareAll(File* file)
    {
        if (file == null) return;
        u32 i = 0;
        while (i < file->declsLen)
        {
            self.checkDecl(file->decls[i], false);
            i = i + 1;
        }
    }

    void checkBodies(File* file)
    {
        if (file == null) return;
        u32 i = 0;
        while (i < file->declsLen)
        {
            self.checkDecl(file->decls[i], true);
            i = i + 1;
        }
    }
}
