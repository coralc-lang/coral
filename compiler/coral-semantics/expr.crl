mod id = import "../coral-ast/id";
mod types = import "../coral-ast/types";
mod node = import "../coral-ast/node";
mod expr = import "../coral-ast/expr";
mod decl_ast = import "../coral-ast/decl";
mod stmt = import "../coral-ast/stmt";
mod scope = import "scope";
mod member = import "member";
mod sema = import "sema";
mod diagnostics = import "../coral-diagnostics/code";

import id { Str, NodeId };
import types { Ty, TypeEntry, TypeKind };
import node { Node, NodeKind };
import expr { Expr, ExprKind };
import decl_ast { Decl, DeclKind, Param, VariantVariant };
import stmt { SwitchCase };
import scope { Symbol };
import member { MemberInfo };
import sema { Sema };
import diagnostics { ErrorCode };

pub extend Sema
{
    bool checkIdent(NodeId id, Str name)
    {
        Symbol* symbol = self.scopes.lookup(name);
        if (symbol == null)
        {
            self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, "undeclared identifier");
            return false;
        }
        return true;
    }

    bool assignExpr(NodeId id)
    {
        if (id.index == 0) return false;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Expr) return false;
        Expr* expr = &node->kind.payload.Expr.value;
        if (expr->kind.tag == ExprKind::Ident)
        {
            Symbol* symbol = self.scopes.lookup(expr->kind.payload.Ident.name);
            if (symbol == null) return false;
            self.setExprType(id, symbol->typeNode);
            return self.scopes.assign(expr->kind.payload.Ident.name, id);
        }
        if (expr->kind.tag == ExprKind::Field)
        {
            if (!self.checkExpr(expr->kind.payload.Field.obj)) return false;
            MemberInfo member = self.findMember(self.exprType(expr->kind.payload.Field.obj), expr->kind.payload.Field.field);
            if (member.typeNode == 0) return false;
            self.setExprType(id, self.substituteFieldTy(member.typeNode, self.exprType(expr->kind.payload.Field.obj)));
            return true;
        }
        if (expr->kind.tag == ExprKind::Index)
        {
            if (!self.checkExpr(expr->kind.payload.Index.obj)) return false;
            Ty objectType = self.exprType(expr->kind.payload.Index.obj);
            if (objectType == 0) return false;
            TypeEntry* objectEntry = self.ctx.types + objectType;
            if (objectEntry->kind.tag == TypeKind::Array) self.setExprType(id, objectEntry->kind.payload.Array.base);
            else if (objectEntry->kind.tag == TypeKind::Slice) self.setExprType(id, objectEntry->kind.payload.Slice.base);
            else if (objectEntry->kind.tag == TypeKind::Pointer) self.setExprType(id, objectEntry->kind.payload.Pointer.base);
            else return false;
            return self.checkExpr(expr->kind.payload.Index.index);
        }
        if (expr->kind.tag == ExprKind::Deref)
        {
            if (!self.checkExpr(expr->kind.payload.Deref.expr)) return false;
            Ty pointerType = self.exprType(expr->kind.payload.Deref.expr);
            if (pointerType == 0) return false;
            TypeEntry* pointerEntry = self.ctx.types + pointerType;
            if (pointerEntry->kind.tag != TypeKind::Pointer) return false;
            self.setExprType(id, pointerEntry->kind.payload.Pointer.base);
            return true;
        }
        return false;
    }

    /* a call through a function-pointer value (parameter, local, field):
     * arity + argument types + result type all come from the FnPtr type */
    bool checkFnPtrCall(NodeId callId, Ty calleeTy, NodeId* args, u32 argsLen)
    {
        if (calleeTy == 0) return true;
        TypeEntry* te = self.ctx.types + calleeTy;
        while (te->kind.tag == TypeKind::Const || te->kind.tag == TypeKind::Comptime)
        {
            if (te->kind.tag == TypeKind::Const) te = self.ctx.types + te->kind.payload.Const.base;
            else te = self.ctx.types + te->kind.payload.Comptime.base;
        }
        if (te->kind.tag != TypeKind::FnPtr) return true;
        if (argsLen != te->kind.payload.FnPtr.paramsLen)
        {
            self.semaErrorNode(ErrorCode::SemaArityMismatch, callId, "wrong number of arguments in call");
            return false;
        }
        u32 i = 0;
        while (i < argsLen)
        {
            if (!self.compatible(self.exprType(args[i]), te->kind.payload.FnPtr.params[i]))
                self.semaErrorNode(ErrorCode::SemaTypeMismatch, callId, "argument type does not match parameter type");
            i = i + 1;
        }
        self.setExprType(callId, te->kind.payload.FnPtr.returnType);
        return true;
    }

    bool checkCall(NodeId callId, Str name, NodeId* args, u32 argsLen, Ty calleeTy)
    {
        Symbol* symbol = self.scopes.lookup(name);
        if (symbol == null)
        {
            self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, callId, "call to undeclared function");
            return false;
        }
        Node* declNode = self.ctx.nodes + symbol->declaration.index;
        if (declNode->kind.tag != NodeKind::Decl) return self.checkFnPtrCall(callId, calleeTy, args, argsLen);
        Decl* decl = &declNode->kind.payload.Decl.value;
        if (decl->kind.tag != DeclKind::Func) return self.checkFnPtrCall(callId, calleeTy, args, argsLen);
        u32 paramsLen = decl->kind.payload.Func.paramsLen;
        bool variadic = false;
        if (paramsLen > 0)
        {
            NodeId lastParamId = decl->kind.payload.Func.params[paramsLen - 1];
            Node* lastParamNode = self.ctx.nodes + lastParamId.index;
            if (lastParamNode->kind.tag == NodeKind::Param)
            {
                Param* lastParam = &lastParamNode->kind.payload.Param.value;
                if ((lastParam->flags & 16) != 0)
                {
                    variadic = true;
                    paramsLen = paramsLen - 1;
                }
            }
        }
        if (argsLen < paramsLen || (!variadic && argsLen != paramsLen))
        {
            self.semaErrorNode(ErrorCode::SemaArityMismatch, callId, "wrong number of arguments in call");
            return false;
        }
        u32 i = 0;
        while (i < argsLen)
        {
            if (i < paramsLen)
            {
                NodeId paramId = decl->kind.payload.Func.params[i];
                Node* paramNode = self.ctx.nodes + paramId.index;
                if (paramNode->kind.tag == NodeKind::Param)
                {
                    Param* param = &paramNode->kind.payload.Param.value;
                    if (!self.genericArgParam(decl, param))
                    {
                        if (!self.compatible(self.exprType(args[i]), param->typeNode)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, callId, "argument type does not match parameter type");
                    }
                }
            }
            i = i + 1;
        }
        self.setExprType(callId, decl->kind.payload.Func.returnType);
        return true;
    }

    bool checkPath(NodeId id)
    {
        if (id.index == 0) return true;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Expr) return true;
        Expr* expr = &node->kind.payload.Expr.value;
        if (expr->kind.tag != ExprKind::Path) return true;
        NodeId* segments = expr->kind.payload.Path.segments;
        u32 segmentsLen = expr->kind.payload.Path.segmentsLen;
        if (segmentsLen < 2) return true;
        Node* leftNode = self.ctx.nodes + segments[0].index;
        if (leftNode->kind.tag != NodeKind::Expr) return true;
        Expr* leftExpr = &leftNode->kind.payload.Expr.value;
        if (leftExpr->kind.tag == ExprKind::Path) return self.checkPath(segments[0]);
        if (leftExpr->kind.tag == ExprKind::TypeRef)
        {
            /* `Option<f64>::None` — type of the path is the head type */
            self.setExprType(id, leftExpr->kind.payload.TypeRef.typeNode);
            return true;
        }
        if (leftExpr->kind.tag != ExprKind::Ident) return true;
        Node* rightNode = self.ctx.nodes + segments[1].index;
        if (rightNode->kind.tag != NodeKind::Expr) return true;
        Expr* rightExpr = &rightNode->kind.payload.Expr.value;
        if (rightExpr->kind.tag != ExprKind::Ident) return true;
        Str root = leftExpr->kind.payload.Ident.name;
        Str member = rightExpr->kind.payload.Ident.name;
        Symbol* symbol = self.scopes.lookup(root);
        if (symbol == null)
        {
            self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, "undeclared module in path");
            return false;
        }
        /* enum value: Color::Red — type is the enum itself */
        if (symbol->declaration.index != 0)
        {
            Node* edeclNode = self.ctx.nodes + symbol->declaration.index;
            if (edeclNode->kind.tag == NodeKind::Decl && edeclNode->kind.payload.Decl.value.kind.tag == DeclKind::Enum)
            {
                Decl* edecl = &edeclNode->kind.payload.Decl.value;
                self.setExprType(id, self.namedType(edecl->kind.payload.Enum.name));
                return true;
            }
            /* bare variant: Option::None — type is the variant decl */
            if (edeclNode->kind.tag == NodeKind::Decl && edeclNode->kind.payload.Decl.value.kind.tag == DeclKind::Variant)
            {
                Decl* edecl = &edeclNode->kind.payload.Decl.value;
                self.setExprType(id, self.namedType(edecl->kind.payload.Variant.name));
                return true;
            }
        }
        if (symbol->kind == 5 && symbol->declaration.index != 0)
        {
            Node* declNode = self.ctx.nodes + symbol->declaration.index;
            if (declNode->kind.tag == NodeKind::Decl)
            {
                Decl* decl = &declNode->kind.payload.Decl.value;
                if (!self.moduleExportsContain(decl, member))
                {
                    self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "symbol not exported by module");
                    return false;
                }
            }
        }
        return true;
    }

    Ty assignTargetType(NodeId target)
    {
        Ty t = self.exprType(target);
        if (t != 0 && target.index != 0)
        {
            Node* n = self.ctx.nodes + target.index;
            TypeEntry* te = self.ctx.types + t;
            if (te->kind.tag == TypeKind::Pointer &&
                n->kind.tag == NodeKind::Expr &&
                n->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&
                n->kind.payload.Expr.value.kind.payload.Ident.name == self.ctx.intern((u8*)"self", 4))
            {
                /* `self = x` writes through the implicit self pointer in the C backend */
                return te->kind.payload.Pointer.base;
            }
        }
        return t;
    }

    bool checkBinary(NodeId id, NodeId left, NodeId right)
    {
        if (!self.checkExpr(left)) return false;
        if (!self.checkExpr(right)) return false;
        Ty leftType = self.exprType(left);
        Ty rightType = self.exprType(right);
        if (leftType == 0) leftType = rightType;
        if (rightType == 0) rightType = leftType;
        if (!self.compatible(leftType, rightType)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "binary operand types do not match");
        self.setExprType(id, leftType);
        return true;
    }

    bool checkBinaryBool(NodeId id, NodeId left, NodeId right)
    {
        if (!self.checkBinary(id, left, right)) return false;
        self.setExprType(id, self.boolType());
        return true;
    }

    bool checkExpr(NodeId id)
    {
        if (id.index == 0) return true;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Expr) return true;
        Expr* expr = &node->kind.payload.Expr.value;
        switch (expr->kind.tag)
        {
            ExprKind::IntLit => {
                u64 v = expr->kind.payload.IntLit.value;
                Ty t;
                if ((expr->kind.payload.IntLit.flags & 1) != 0)
                {
                    /* unsigned suffix: smallest unsigned type that fits */
                    if (v <= 255) t = self.u8Type();
                    else if (v <= 65535) t = self.u16Type();
                    else if (v <= 4294967295) t = self.u32Type();
                    else t = self.u64Type();
                }
                else
                {
                    if (v <= 2147483647) t = self.i32Type();
                    else if (v <= 9223372036854775807) t = self.i64Type();
                    else t = self.u64Type();
                }
                self.setExprType(id, t);
                return true;
            },
            ExprKind::FloatLit => { if ((expr->kind.payload.FloatLit.flags & 2) != 0) self.setExprType(id, self.f32Type()); else self.setExprType(id, self.f64Type()); return true; },
            ExprKind::StringLit => { self.setExprType(id, self.strType()); return true; },
            ExprKind::CharLit => { self.setExprType(id, self.charType()); return true; },
            ExprKind::BoolLit => { self.setExprType(id, self.boolType()); return true; },
            ExprKind::NullLit => { return true; },
            ExprKind::Ident => {
                if (!self.checkIdent(id, expr->kind.payload.Ident.name)) return false;
                Symbol* symbol = self.scopes.lookup(expr->kind.payload.Ident.name);
                if (symbol != null) self.setExprType(id, symbol->typeNode);
                return true;
            },
            ExprKind::TypeRef => {
                if (!self.checkIdent(id, expr->kind.payload.TypeRef.name)) return false;
                if (!self.checkType(expr->kind.payload.TypeRef.typeNode)) return false;
                self.setExprType(id, expr->kind.payload.TypeRef.typeNode);
                return true;
            },
            ExprKind::Path => { return self.checkPath(id); },
            ExprKind::Call => {
                if (!self.checkExpr(expr->kind.payload.Call.callee)) return false;
                u32 i = 0;
                while (i < expr->kind.payload.Call.argsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.Call.args[i])) return false;
                    i = i + 1;
                }
                Node* calleeNode = self.ctx.nodes + expr->kind.payload.Call.callee.index;
                if (calleeNode->kind.tag == NodeKind::Expr)
                {
                    Expr* callee = &calleeNode->kind.payload.Expr.value;
                    if (callee->kind.tag == ExprKind::Ident)
                        return self.checkCall(id, callee->kind.payload.Ident.name, expr->kind.payload.Call.args, expr->kind.payload.Call.argsLen, callee->resolvedType);
                    return self.checkFnPtrCall(id, callee->resolvedType, expr->kind.payload.Call.args, expr->kind.payload.Call.argsLen);
                }
                return true;
            },
            ExprKind::MethodCall => {
                if (!self.checkExpr(expr->kind.payload.MethodCall.receiver)) return false;
                MemberInfo methodInfo = self.findMethod(self.exprType(expr->kind.payload.MethodCall.receiver), expr->kind.payload.MethodCall.method);
                if (methodInfo.declaration.index == 0)
                {
                    self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "method not found on type");
                    return false;
                }
                Node* methodNode = self.ctx.nodes + methodInfo.declaration.index;
                Decl* methodDecl = &methodNode->kind.payload.Decl.value;
                u32 paramsLen = methodDecl->kind.payload.Func.paramsLen;
                u32 selfOffset = 0;
                if (paramsLen > 0)
                {
                    NodeId firstParamId = methodDecl->kind.payload.Func.params[0];
                    Node* firstParamNode = self.ctx.nodes + firstParamId.index;
                    if (firstParamNode->kind.tag == NodeKind::Param)
                    {
                        Param* firstParam = &firstParamNode->kind.payload.Param.value;
                        if ((firstParam->flags & 1) != 0) selfOffset = 1;
                    }
                }
                if (paramsLen - selfOffset != expr->kind.payload.MethodCall.argsLen)
                {
                    self.semaErrorNode(ErrorCode::SemaArityMismatch, id, "wrong number of arguments to method");
                    return false;
                }
                u32 i = 0;
                while (i < expr->kind.payload.MethodCall.argsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.MethodCall.args[i])) return false;
                    NodeId paramId = methodDecl->kind.payload.Func.params[i + selfOffset];
                    Node* paramNode = self.ctx.nodes + paramId.index;
                    if (paramNode->kind.tag == NodeKind::Param)
                    {
                        Param* param = &paramNode->kind.payload.Param.value;
                        if (!self.compatible(self.exprType(expr->kind.payload.MethodCall.args[i]), param->typeNode)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "method argument type does not match parameter type");
                    }
                    i = i + 1;
                }
                self.setExprType(id, self.substituteFieldTy(methodDecl->kind.payload.Func.returnType, self.exprType(expr->kind.payload.MethodCall.receiver)));
                return true;
            },
            ExprKind::Field => {
                if (!self.checkExpr(expr->kind.payload.Field.obj)) return false;
                MemberInfo member = self.findMember(self.exprType(expr->kind.payload.Field.obj), expr->kind.payload.Field.field);
                if (member.typeNode == 0)
                {
                    self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "field not found on type");
                    return false;
                }
                self.setExprType(id, self.substituteFieldTy(member.typeNode, self.exprType(expr->kind.payload.Field.obj)));
                return true;
            },
            ExprKind::DerefField => {
                if (!self.checkExpr(expr->kind.payload.DerefField.obj)) return false;
                MemberInfo member = self.findMember(self.exprType(expr->kind.payload.DerefField.obj), expr->kind.payload.DerefField.field);
                if (member.typeNode == 0)
                {
                    self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "field not found through pointer");
                    return false;
                }
                self.setExprType(id, self.substituteFieldTy(member.typeNode, self.exprType(expr->kind.payload.DerefField.obj)));
                return true;
            },
            ExprKind::Index => {
                if (!self.checkExpr(expr->kind.payload.Index.obj)) return false;
                Ty objectType = self.exprType(expr->kind.payload.Index.obj);
                if (objectType == 0) return false;
                TypeEntry* objectEntry = self.ctx.types + objectType;
                if (objectEntry->kind.tag == TypeKind::Array) self.setExprType(id, objectEntry->kind.payload.Array.base);
                else if (objectEntry->kind.tag == TypeKind::Slice) self.setExprType(id, objectEntry->kind.payload.Slice.base);
                else if (objectEntry->kind.tag == TypeKind::Pointer) self.setExprType(id, objectEntry->kind.payload.Pointer.base);
                else if (objectEntry->kind.tag == TypeKind::Str) self.setExprType(id, self.charType());
                else
                {
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "cannot dereference this type");
                    return false;
                }
                if (!self.checkExpr(expr->kind.payload.Index.index)) return false;
                Ty indexTy = self.exprType(expr->kind.payload.Index.index);
                if (indexTy != 0 && !self.integerType(indexTy))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "array index must be an integer type");
                return true;
            },
            ExprKind::Cast => {
                if (!self.checkExpr(expr->kind.payload.Cast.expr)) return false;
                if (expr->kind.payload.Cast.targetType != 0)
                    self.setExprType(id, expr->kind.payload.Cast.targetType);
                return true;
            },
            ExprKind::Sizeof => { return true; },
            ExprKind::Alignof => { return true; },
            ExprKind::Typeof => { return self.checkExpr(expr->kind.payload.Typeof.expr); },
            ExprKind::AddressOf => {
                if (!self.checkExpr(expr->kind.payload.AddressOf.expr)) return false;
                Ty inner = self.exprType(expr->kind.payload.AddressOf.expr);
                if (inner != 0)
                {
                    TypeKind k = TypeKind::Pointer{ .base = inner };
                    self.setExprType(id, self.allocType(k));
                }
                return true;
            },
            ExprKind::Deref => {
                if (!self.checkExpr(expr->kind.payload.Deref.expr)) return false;
                Ty inner = self.exprType(expr->kind.payload.Deref.expr);
                if (inner != 0)
                {
                    TypeEntry* te = self.ctx.types + inner;
                    if (te->kind.tag == TypeKind::Pointer) self.setExprType(id, te->kind.payload.Pointer.base);
                    else self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "cannot dereference non-pointer type");
                }
                return true;
            },
            ExprKind::Neg => {
                if (!self.checkExpr(expr->kind.payload.Neg.expr)) return false;
                Ty t = self.exprType(expr->kind.payload.Neg.expr);
                /* `-` applied to a bare literal narrows to the smallest
                 * signed type that can hold the negative value
                 * (-2147483648 → i32, -9223372036854775808 → i64) */
                NodeId negInner = expr->kind.payload.Neg.expr;
                if (negInner.index != 0)
                {
                    Node* inner = self.ctx.nodes + negInner.index;
                    if (inner->kind.tag == NodeKind::Expr && inner->kind.payload.Expr.value.kind.tag == ExprKind::IntLit)
                    {
                        u64 v = inner->kind.payload.Expr.value.kind.payload.IntLit.value;
                        if (v <= 2147483648) t = self.i32Type();
                        else if (v <= 9223372036854775808) t = self.i64Type();
                        else
                        {
                            self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "negative literal out of range");
                            t = self.i64Type();
                        }
                    }
                }
                if (t != 0) self.setExprType(id, t);
                return true;
            },
            ExprKind::BitNot => {
                if (!self.checkExpr(expr->kind.payload.BitNot.expr)) return false;
                Ty t = self.exprType(expr->kind.payload.BitNot.expr);
                if (t != 0) self.setExprType(id, t);
                return true;
            },
            ExprKind::Not => {
                if (!self.checkExpr(expr->kind.payload.Not.expr)) return false;
                self.setExprType(id, self.boolType());
                return true;
            },
            ExprKind::Add => { return self.checkBinary(id, expr->kind.payload.Add.left, expr->kind.payload.Add.right); },
            ExprKind::Sub => { return self.checkBinary(id, expr->kind.payload.Sub.left, expr->kind.payload.Sub.right); },
            ExprKind::Mul => { return self.checkBinary(id, expr->kind.payload.Mul.left, expr->kind.payload.Mul.right); },
            ExprKind::Div => { return self.checkBinary(id, expr->kind.payload.Div.left, expr->kind.payload.Div.right); },
            ExprKind::Mod => { return self.checkBinary(id, expr->kind.payload.Mod.left, expr->kind.payload.Mod.right); },
            ExprKind::Eq => { return self.checkBinaryBool(id, expr->kind.payload.Eq.left, expr->kind.payload.Eq.right); },
            ExprKind::Ne => { return self.checkBinaryBool(id, expr->kind.payload.Ne.left, expr->kind.payload.Ne.right); },
            ExprKind::Lt => { return self.checkBinaryBool(id, expr->kind.payload.Lt.left, expr->kind.payload.Lt.right); },
            ExprKind::Le => { return self.checkBinaryBool(id, expr->kind.payload.Le.left, expr->kind.payload.Le.right); },
            ExprKind::Gt => { return self.checkBinaryBool(id, expr->kind.payload.Gt.left, expr->kind.payload.Gt.right); },
            ExprKind::Ge => { return self.checkBinaryBool(id, expr->kind.payload.Ge.left, expr->kind.payload.Ge.right); },
            ExprKind::And => { return self.checkBinaryBool(id, expr->kind.payload.And.left, expr->kind.payload.And.right); },
            ExprKind::Or => { return self.checkBinaryBool(id, expr->kind.payload.Or.left, expr->kind.payload.Or.right); },
            ExprKind::BitAnd => { return self.checkBinary(id, expr->kind.payload.BitAnd.left, expr->kind.payload.BitAnd.right); },
            ExprKind::BitOr => { return self.checkBinary(id, expr->kind.payload.BitOr.left, expr->kind.payload.BitOr.right); },
            ExprKind::BitXor => { return self.checkBinary(id, expr->kind.payload.BitXor.left, expr->kind.payload.BitXor.right); },
            ExprKind::Shl => { return self.checkBinary(id, expr->kind.payload.Shl.left, expr->kind.payload.Shl.right); },
            ExprKind::Shr => { return self.checkBinary(id, expr->kind.payload.Shr.left, expr->kind.payload.Shr.right); },
            ExprKind::Assign => {
                if (!self.assignExpr(expr->kind.payload.Assign.target)) return false;
                if (!self.checkExpr(expr->kind.payload.Assign.value)) return false;
                if (!self.compatible(self.exprType(expr->kind.payload.Assign.value), self.assignTargetType(expr->kind.payload.Assign.target))) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "type mismatch in assignment");
                return true;
            },
            ExprKind::AssignAdd => {
                if (!self.assignExpr(expr->kind.payload.AssignAdd.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignAdd.value)) return false;
                if (!self.compatible(self.exprType(expr->kind.payload.AssignAdd.value), self.assignTargetType(expr->kind.payload.AssignAdd.target))) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "type mismatch in assignment");
                return true;
            },
            ExprKind::AssignSub => {
                if (!self.assignExpr(expr->kind.payload.AssignSub.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignSub.value)) return false;
                if (!self.compatible(self.exprType(expr->kind.payload.AssignSub.value), self.assignTargetType(expr->kind.payload.AssignSub.target))) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "type mismatch in assignment");
                return true;
            },
            ExprKind::AssignMul => {
                if (!self.assignExpr(expr->kind.payload.AssignMul.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignMul.value)) return false;
                return true;
            },
            ExprKind::AssignDiv => {
                if (!self.assignExpr(expr->kind.payload.AssignDiv.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignDiv.value)) return false;
                return true;
            },
            ExprKind::AssignMod => {
                if (!self.assignExpr(expr->kind.payload.AssignMod.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignMod.value)) return false;
                return true;
            },
            ExprKind::AssignBitAnd => {
                if (!self.assignExpr(expr->kind.payload.AssignBitAnd.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignBitAnd.value)) return false;
                return true;
            },
            ExprKind::AssignBitOr => {
                if (!self.assignExpr(expr->kind.payload.AssignBitOr.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignBitOr.value)) return false;
                return true;
            },
            ExprKind::AssignBitXor => {
                if (!self.assignExpr(expr->kind.payload.AssignBitXor.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignBitXor.value)) return false;
                return true;
            },
            ExprKind::AssignShl => {
                if (!self.assignExpr(expr->kind.payload.AssignShl.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignShl.value)) return false;
                return true;
            },
            ExprKind::AssignShr => {
                if (!self.assignExpr(expr->kind.payload.AssignShr.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignShr.value)) return false;
                return true;
            },
            ExprKind::TupleField => { return self.checkExpr(expr->kind.payload.TupleField.obj); },
            ExprKind::StructLiteral => {
                if (!self.checkType(expr->kind.payload.StructLiteral.typeNode)) return false;
                Str variantName = expr->kind.payload.StructLiteral.variantName;
                if (variantName != 0)
                {
                    /* variant construction: fields must belong to the
                     * named variant of the variant decl behind typeNode */
                    Ty base = self.stripType(expr->kind.payload.StructLiteral.typeNode);
                    if (base == 0) return false;
                    TypeEntry* te = self.ctx.types + base;
                    if (te->kind.tag != TypeKind::Named)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "variant construction needs a variant type");
                        return false;
                    }
                    Symbol* symbol = self.scopes.lookup(te->kind.payload.Named.name);
                    if (symbol == null || symbol->declaration.index == 0)
                    {
                        self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, "unknown type name");
                        return false;
                    }
                    Node* dn = self.ctx.nodes + symbol->declaration.index;
                    if (dn->kind.tag != NodeKind::Decl)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "variant construction needs a variant type");
                        return false;
                    }
                    Decl* decl = &dn->kind.payload.Decl.value;
                    if (decl->kind.tag != DeclKind::Variant)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "not a variant type");
                        return false;
                    }
                    VariantVariant* vv = null;
                    u32 v = 0;
                    while (v < decl->kind.payload.Variant.variantsLen)
                    {
                        if (decl->kind.payload.Variant.variants[v].name == variantName)
                        {
                            vv = decl->kind.payload.Variant.variants + v;
                            break;
                        }
                        v = v + 1;
                    }
                    if (vv == null)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "unknown variant");
                        return false;
                    }
                    u32 i = 0;
                    while (i < expr->kind.payload.StructLiteral.fieldValuesLen)
                    {
                        Str fieldName = expr->kind.payload.StructLiteral.fieldNames[i];
                        Ty ft = 0;
                        u32 k = 0;
                        while (k < vv->fieldsLen)
                        {
                            if (vv->fieldNames[k] == fieldName)
                            {
                                ft = vv->fieldTypes[k];
                                break;
                            }
                            k = k + 1;
                        }
                        if (ft == 0)
                        {
                            self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "unknown field in variant construction");
                            return false;
                        }
                        if (!self.checkExpr(expr->kind.payload.StructLiteral.fieldValues[i])) return false;
                        Ty expected = self.substituteFieldTy(ft, expr->kind.payload.StructLiteral.typeNode);
                        if (!self.compatible(self.exprType(expr->kind.payload.StructLiteral.fieldValues[i]), expected)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "variant field type mismatch");
                        i = i + 1;
                    }
                    self.setExprType(id, expr->kind.payload.StructLiteral.typeNode);
                    return true;
                }
                u32 i = 0;
                while (i < expr->kind.payload.StructLiteral.fieldValuesLen)
                {
                    MemberInfo member = self.findMember(expr->kind.payload.StructLiteral.typeNode, expr->kind.payload.StructLiteral.fieldNames[i]);
                    if (member.typeNode == 0)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "unknown field in struct literal");
                        return false;
                    }
                    if (!self.checkExpr(expr->kind.payload.StructLiteral.fieldValues[i])) return false;
                    Ty expected = self.substituteFieldTy(member.typeNode, expr->kind.payload.StructLiteral.typeNode);
                    if (!self.compatible(self.exprType(expr->kind.payload.StructLiteral.fieldValues[i]), expected)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "struct literal field type mismatch");
                    i = i + 1;
                }
                self.setExprType(id, expr->kind.payload.StructLiteral.typeNode);
                return true;
            },
            ExprKind::ArrayLiteral => {
                u32 i = 0;
                while (i < expr->kind.payload.ArrayLiteral.elemsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.ArrayLiteral.elems[i])) return false;
                    i = i + 1;
                }
                return true;
            },
            ExprKind::BuiltinCall => {
                u32 i = 0;
                while (i < expr->kind.payload.BuiltinCall.argsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.BuiltinCall.args[i])) return false;
                    i = i + 1;
                }
                return true;
            },
            ExprKind::TupleExpr => {
                u32 i = 0;
                while (i < expr->kind.payload.TupleExpr.elemsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.TupleExpr.elems[i])) return false;
                    i = i + 1;
                }
                return true;
            },
            ExprKind::BlockExpr => {
                u32 i = 0;
                while (i < expr->kind.payload.BlockExpr.stmtsLen)
                {
                    if (!self.checkStmt(expr->kind.payload.BlockExpr.stmts[i])) return false;
                    i = i + 1;
                }
                return self.checkExpr(expr->kind.payload.BlockExpr.result);
            },
            ExprKind::Ternary => {
                if (!self.checkExpr(expr->kind.payload.Ternary.cond)) return false;
                Ty ternCondTy = self.exprType(expr->kind.payload.Ternary.cond);
                if (ternCondTy != 0 && ternCondTy != self.boolType())
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "ternary condition must be bool");
                if (!self.checkExpr(expr->kind.payload.Ternary.thenExpr)) return false;
                if (!self.checkExpr(expr->kind.payload.Ternary.elseExpr)) return false;
                Ty thenTy = self.exprType(expr->kind.payload.Ternary.thenExpr);
                Ty elseTy = self.exprType(expr->kind.payload.Ternary.elseExpr);
                if (thenTy == 0) thenTy = elseTy;
                if (elseTy == 0) elseTy = thenTy;
                if (!self.compatible(thenTy, elseTy)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "ternary branch types do not match");
                self.setExprType(id, thenTy);
                return true;
            },
            ExprKind::PostInc => { if (!self.assignExpr(expr->kind.payload.PostInc.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PostInc.expr)); return true; },
            ExprKind::PostDec => { if (!self.assignExpr(expr->kind.payload.PostDec.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PostDec.expr)); return true; },
            ExprKind::PreInc => { if (!self.assignExpr(expr->kind.payload.PreInc.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PreInc.expr)); return true; },
            ExprKind::PreDec => { if (!self.assignExpr(expr->kind.payload.PreDec.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PreDec.expr)); return true; },
            ExprKind::IfExpr => {
                if (!self.checkExpr(expr->kind.payload.IfExpr.cond)) return false;
                Ty ifExprCondTy = self.exprType(expr->kind.payload.IfExpr.cond);
                if (ifExprCondTy != 0 && ifExprCondTy != self.boolType())
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "if-expression condition must be bool");
                if (!self.checkExpr(expr->kind.payload.IfExpr.thenBody)) return false;
                if (!self.checkExpr(expr->kind.payload.IfExpr.elseBody)) return false;
                Ty thenTy = self.exprType(expr->kind.payload.IfExpr.thenBody);
                Ty elseTy = self.exprType(expr->kind.payload.IfExpr.elseBody);
                if (thenTy == 0) thenTy = elseTy;
                if (elseTy == 0) elseTy = thenTy;
                if (!self.compatible(thenTy, elseTy)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "if-expression branch types do not match");
                self.setExprType(id, thenTy);
                return true;
            },
            ExprKind::SwitchExpr => {
                if (!self.checkExpr(expr->kind.payload.SwitchExpr.expr)) return false;
                Ty resultTy = 0;
                bool ok = true;
                u32 i = 0;
                while (i < expr->kind.payload.SwitchExpr.casesLen)
                {
                    SwitchCase* switchCase = expr->kind.payload.SwitchExpr.cases + i;
                    u32 p = 0;
                    while (p < switchCase->patternsLen)
                    {
                        if (!self.checkExpr(switchCase->patterns[p])) ok = false;
                        p = p + 1;
                    }
                    if (switchCase->guard.index != 0)
                    {
                        if (!self.checkExpr(switchCase->guard)) ok = false;
                    }
                    if (!self.checkExpr(switchCase->body)) ok = false;
                    Ty bodyTy = self.exprType(switchCase->body);
                    if (bodyTy != 0)
                    {
                        if (resultTy == 0) resultTy = bodyTy;
                        else if (!self.compatible(bodyTy, resultTy)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "switch arm types do not match");
                    }
                    i = i + 1;
                }
                self.setExprType(id, resultTy);
                return ok;
            },
            else => {
                self.addError();
                return false;
            }
        }
    }
}
