mod id = import "../coral-ast/id";
mod types = import "../coral-ast/types";
mod node = import "../coral-ast/node";
mod decl_ast = import "../coral-ast/decl";
mod stmt_ast = import "../coral-ast/stmt";
mod expr_ast = import "../coral-ast/expr";
mod pat = import "../coral-ast/pat";
mod scope = import "scope";
mod sema = import "sema";
mod diagnostics = import "../coral-diagnostics/code";

import id { Str, NodeId };
import types { Ty, TypeEntry, TypeKind };
import node { Node, NodeKind };
import decl_ast { Decl, DeclKind, Param, GenericParam, VariantVariant };
import stmt_ast { Stmt, StmtKind, SwitchCase };
import pat { Pat, PatKind };
import scope { Symbol };
import sema { Sema };
import diagnostics { ErrorCode };

pub extend Sema
{
    bool checkStmt(NodeId id)
    {
        if (id.index == 0) return true;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Stmt) return true;
        Stmt* stmt = &node->kind.payload.Stmt.value;
        switch (stmt->kind.tag)
        {
            StmtKind::VarDecl => {
                if (!self.checkExpr(stmt->kind.payload.VarDecl.init)) return false;
                Ty declaredType = stmt->kind.payload.VarDecl.typeNode;
                if (!self.checkType(declaredType)) return false;
                Ty actualType = self.exprType(stmt->kind.payload.VarDecl.init);
                if (declaredType != 0 && !self.assignCompatible(stmt->kind.payload.VarDecl.init, actualType, declaredType))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "initializer type does not match variable type");
                if (declaredType == 0)
                {
                    /* `var x = expr;` — infer from the initializer */
                    declaredType = actualType;
                    if (declaredType == 0 && stmt->kind.payload.VarDecl.init.index != 0)
                    {
                        /* `var p = null;` — a bare null has no type of its own */
                        Node* inn = self.ctx.nodes + stmt->kind.payload.VarDecl.init.index;
                        if (inn->kind.tag == NodeKind::Expr && inn->kind.payload.Expr.value.kind.tag == ExprKind::NullLit)
                            declaredType = self.rawptrType();
                    }
                    if (declaredType == 0)
                    {
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "cannot infer type: add an explicit type annotation");
                        return false;
                    }
                    stmt->kind.payload.VarDecl.typeNode = declaredType;
                }
                if (stmt->kind.payload.VarDecl.name != 0)
                    self.scopes.declare(stmt->kind.payload.VarDecl.name, 1, declaredType, id, stmt->kind.payload.VarDecl.flags);
                return true;
            },
            
            StmtKind::Block => {
                self.scopes.enter();
                bool ok = true;
                u32 i = 0;
                while (i < stmt->kind.payload.Block.stmtsLen)
                {
                    if (!self.checkStmt(stmt->kind.payload.Block.stmts[i])) ok = false;
                    i = i + 1;
                }
                self.scopes.leave();
                return ok;
            },
            
            StmtKind::Return => {
                if (!self.checkExpr(stmt->kind.payload.Return.value)) return false;
                if (!self.compatible(self.exprType(stmt->kind.payload.Return.value), self.currentReturnType))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "return type does not match function return type");
                return true;
            },
            
            StmtKind::If => {
                if (!self.checkExpr(stmt->kind.payload.If.cond)) return false;
                Ty ifCondTy = self.exprType(stmt->kind.payload.If.cond);
                if (ifCondTy != 0 && ifCondTy != self.boolType())
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "if condition must be bool");
                if (!self.checkStmt(stmt->kind.payload.If.thenBody)) return false;
                return self.checkStmt(stmt->kind.payload.If.elseBody);
            },
            
            StmtKind::While => {
                if (!self.checkExpr(stmt->kind.payload.While.cond)) return false;
                Ty whileCondTy = self.exprType(stmt->kind.payload.While.cond);
                if (whileCondTy != 0 && whileCondTy != self.boolType())
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "while condition must be bool");
                return self.checkStmt(stmt->kind.payload.While.body);
            },
            
            StmtKind::ForIn => {
                if (!self.checkExpr(stmt->kind.payload.ForIn.iterExpr)) return false;
                Ty iterTy = self.exprType(stmt->kind.payload.ForIn.iterExpr);
                if (iterTy != 0)
                {
                    TypeEntry* ie = self.ctx.types + iterTy;
                    if (ie->kind.tag != TypeKind::Slice && ie->kind.tag != TypeKind::Array)
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "for-in iterator must be an array or slice");
                    else
                    {
                        Ty elemTy = ie->kind.tag == TypeKind::Slice ? ie->kind.payload.Slice.base
                                                                     : ie->kind.payload.Array.base;
                        if (stmt->kind.payload.ForIn.bindType != 0)
                        {
                            if (!self.compatible(elemTy, stmt->kind.payload.ForIn.bindType))
                                self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "for-in bind type does not match the iterator's element type");
                        }
                        if (stmt->kind.payload.ForIn.bindType == 0) stmt->kind.payload.ForIn.bindType = elemTy;
                    }
                }
                self.scopes.enter();
                self.scopes.declare(stmt->kind.payload.ForIn.bindName, 1, stmt->kind.payload.ForIn.bindType, id, 2);
                bool ok = self.checkStmt(stmt->kind.payload.ForIn.body);
                self.scopes.leave();
                return ok;
            },
            
            StmtKind::For => {
                if (!self.checkStmt(stmt->kind.payload.For.init)) return false;
                if (!self.checkExpr(stmt->kind.payload.For.cond)) return false;
                Ty forCondTy = self.exprType(stmt->kind.payload.For.cond);
                if (forCondTy != 0 && forCondTy != self.boolType())
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, "for condition must be bool");
                if (!self.checkExpr(stmt->kind.payload.For.post)) return false;
                return self.checkStmt(stmt->kind.payload.For.body);
            },
            
            StmtKind::Comptime => {
                u32 i = 0;
                while (i < stmt->kind.payload.Comptime.stmtsLen)
                {
                    if (!self.checkStmt(stmt->kind.payload.Comptime.stmts[i])) return false;
                    i = i + 1;
                }
                return true;
            },
            
            StmtKind::Asm => {
                u32 i = 0;
                while (i < stmt->kind.payload.Asm.templateLen)
                {
                    if (!self.checkExpr(stmt->kind.payload.Asm.template[i])) return false;
                    i = i + 1;
                }
                return true;
            },
            
            StmtKind::Defer => { return self.checkStmt(stmt->kind.payload.Defer.stmt); },
            StmtKind::Break => { return true; },
            StmtKind::Continue => { return true; },
            StmtKind::Loop => { return self.checkStmt(stmt->kind.payload.Loop.body); },
            StmtKind::ExprStmt => { return self.checkExpr(stmt->kind.payload.ExprStmt.expr); },

    
            StmtKind::Switch => {
                if (!self.checkExpr(stmt->kind.payload.Switch.expr)) return false;
                Ty scrutTy = self.exprType(stmt->kind.payload.Switch.expr);
                bool ok = true;
                u32 i = 0;
                while (i < stmt->kind.payload.Switch.casesLen) {
                    SwitchCase* switchCase = stmt->kind.payload.Switch.cases + i;
                    self.scopes.enter();
                    u32 p = 0;
                    while (p < switchCase->patternsLen) {
                        if (!self.declarePatternBindings(switchCase->patterns[p], scrutTy)) ok = false;
                        p = p + 1;
                    }
                    if (switchCase->guard.index != 0) {
                        if (!self.checkExpr(switchCase->guard)) ok = false;
                    }
                    if (switchCase->body.index != 0) {
                        Node* bodyNode = self.ctx.nodes + switchCase->body.index;
                        if (bodyNode->kind.tag == NodeKind::Expr) {
                            if (!self.checkExpr(switchCase->body)) ok = false;
                        } else {
                            if (!self.checkStmt(switchCase->body)) ok = false;
                        }
                    }
                    self.scopes.leave();
                    i = i + 1;
                }
                return ok;
            },
            else => {
                self.semaErrorNode(ErrorCode::SemaInternal, id, "unhandled statement kind in checkStmt");
                return false;
            }
        }
    }

    /* replace the `self` placeholder with the actual type */
    Ty resolveSelfTy(Ty t, Ty selfType)
    {
        if (t == 0) return 0;
        TypeEntry* e = self.ctx.types + t;
        switch (e->kind.tag)
        {
            TypeKind::Named => {
                if (e->kind.payload.Named.name == self.ctx.intern((u8*)"self", 4)) return selfType;
                return t;
            },
            TypeKind::Pointer => {
                Ty base = self.resolveSelfTy(e->kind.payload.Pointer.base, selfType);
                if (base == e->kind.payload.Pointer.base) return t;
                return self.allocType(TypeKind::Pointer{ .base = base });
            },
            TypeKind::Const => {
                Ty base = self.resolveSelfTy(e->kind.payload.Const.base, selfType);
                if (base == e->kind.payload.Const.base) return t;
                return self.allocType(TypeKind::Const{ .base = base });
            },
            else => { return t; }
        }
    }

    bool checkFunction(Decl* decl, Ty selfType)
    {
        self.scopes.enter();
        bool ok = true;
        u32 genericIndex = 0;
        while (genericIndex < decl->kind.payload.Func.genericParamsLen)
        {
            NodeId genericId = decl->kind.payload.Func.genericParams[genericIndex];
            Node* genericNode = self.ctx.nodes + genericId.index;
            if (genericNode->kind.tag == NodeKind::GenericParam)
            {
                GenericParam* generic = &genericNode->kind.payload.GenericParam.value;
                Ty typeNode = self.typeParamType(generic->name, genericIndex);
                if (!self.scopes.declare(generic->name, 4, typeNode, genericId, 0)) ok = false;
            }
            genericIndex = genericIndex + 1;
        }
        u32 i = 0;
        bool hasSelfParam = false;
        while (i < decl->kind.payload.Func.paramsLen)
        {
            NodeId paramId = decl->kind.payload.Func.params[i];
            Node* paramNode = self.ctx.nodes + paramId.index;
            if (paramNode->kind.tag == NodeKind::Param)
            {
                Param* param = &paramNode->kind.payload.Param.value;
                if ((param->flags & 1) != 0) hasSelfParam = true;
            }
            i = i + 1;
        }
        if (selfType != 0 && !hasSelfParam) {
            Str selfStr = self.ctx.intern("self", 4);
            /* self is a pointer in the C implementation — declare it as one
             * so member access emits `self->field` */
            Ty selfPtr = self.allocType(TypeKind::Pointer{ .base = selfType });
            self.scopes.declare(selfStr, 1, selfPtr, decl->kind.payload.Func.body, 0);
        }
        i = 0;
        while (i < decl->kind.payload.Func.paramsLen)
        {
            NodeId paramId = decl->kind.payload.Func.params[i];
            Node* paramNode = self.ctx.nodes + paramId.index;
            if (paramNode->kind.tag == NodeKind::Param)
            {
                Param* param = &paramNode->kind.payload.Param.value;
                if (param->name != 0) {
                    if ((param->flags & 8) != 0) {
                        Ty typeNode = self.typeParamType(param->name, i);
                        if (!self.scopes.declare(param->name, 4, typeNode, paramId, 0)) ok = false;
                    } else if ((param->flags & 1) != 0) {
                        Ty selfTy = param->typeNode;
                        if (selfTy == 0) selfTy = selfType;
                        else selfTy = self.resolveSelfTy(selfTy, selfType);
                        if (!self.scopes.declare(param->name, 1, selfTy, paramId, 0)) ok = false;
                    } else {
                        if (!self.scopes.declare(param->name, 1, param->typeNode, paramId, 0)) ok = false;
                    }
                }
                if ((param->flags & 1) == 0 && !self.checkType(param->typeNode)) ok = false;
            }
            i = i + 1;
        }
        /* a comptime generic parameter must have a matching comptime
         * block somewhere in this function's body (the compiler is
         * expected to auto-deduce the parameter's value from it) */
        bool needsComptimeBlock = false;
        u32 ci = 0;
        while (ci < decl->kind.payload.Func.genericParamsLen)
        {
            NodeId gId = decl->kind.payload.Func.genericParams[ci];
            Node* gNode = self.ctx.nodes + gId.index;
            if (gNode->kind.tag == NodeKind::GenericParam && (gNode->kind.payload.GenericParam.value.flags & 1) != 0)
                needsComptimeBlock = true;
            ci = ci + 1;
        }
        if (needsComptimeBlock && decl->kind.payload.Func.body.index != 0)
        {
            Node* bNode = self.ctx.nodes + decl->kind.payload.Func.body.index;
            bool found = false;
            if (bNode->kind.tag == NodeKind::Stmt &&
                bNode->kind.payload.Stmt.value.kind.tag == StmtKind::Block)
            {
                Stmt* blk = &bNode->kind.payload.Stmt.value;
                u32 bi = 0;
                while (bi < blk->kind.payload.Block.stmtsLen)
                {
                    Node* inner = self.ctx.nodes + blk->kind.payload.Block.stmts[bi].index;
                    if (inner->kind.tag == NodeKind::Stmt &&
                        inner->kind.payload.Stmt.value.kind.tag == StmtKind::Comptime)
                        found = true;
                    bi = bi + 1;
                }
            }
            else if (bNode->kind.tag == NodeKind::Stmt &&
                     bNode->kind.payload.Stmt.value.kind.tag == StmtKind::Comptime)
                found = true;
            if (!found)
                self.semaErrorNode(ErrorCode::SemaTypeMismatch, decl->kind.payload.Func.body, "function with a comptime generic parameter needs a comptime {} block in its body");
        }
        if (!self.checkType(decl->kind.payload.Func.returnType)) ok = false;
        self.currentReturnType = decl->kind.payload.Func.returnType;
        if (!self.checkStmt(decl->kind.payload.Func.body)) ok = false;
        self.currentReturnType = 0;
        self.scopes.leave();
        return ok;
    }

    /* declares the fields bound by a variant pattern (`Some { value }`)
     * in the case scope, typed against the scrutinee's variant decl */
    bool declarePatternBindings(NodeId patId, Ty scrutTy)
    {
        if (patId.index == 0) return true;
        Node* n = self.ctx.nodes + patId.index;
        if (n.kind.tag != NodeKind::Pat) return true;
        Pat* p = &n.kind.payload.Pat.value;
        if (p->kind.tag != PatKind::Variant) return true;
        Ty base = self.stripType(scrutTy);
        if (base == 0) return true;
        TypeEntry* te = self.ctx.types + base;
        if (te->kind.tag != TypeKind::Named) return true;
        Symbol* symbol = self.scopes.lookup(te->kind.payload.Named.name);
        if (symbol == null || symbol->declaration.index == 0) return true;
        Node* dn = self.ctx.nodes + symbol->declaration.index;
        if (dn->kind.tag != NodeKind::Decl) return true;
        Decl* decl = &dn->kind.payload.Decl.value;
        if (decl->kind.tag != DeclKind::Variant) return true;
        VariantVariant* vv = null;
        u32 v = 0;
        while (v < decl->kind.payload.Variant.variantsLen)
        {
            if (decl->kind.payload.Variant.variants[v].name == p->kind.payload.Variant.variantName)
            {
                vv = decl->kind.payload.Variant.variants + v;
                break;
            }
            v = v + 1;
        }
        if (vv == null)
        {
            self.semaErrorNode(ErrorCode::SemaUnknownMember, patId, "unknown variant in pattern");
            return false;
        }
        bool ok = true;
        u32 f = 0;
        while (f < p->kind.payload.Variant.fieldNamesLen)
        {
            Str fieldName = p->kind.payload.Variant.fieldNames[f];
            Ty ft = 0;
            u32 k = 0;
            while (k < vv->fieldsLen)
            {
                if (vv->fieldNames[k] == fieldName)
                {
                    ft = vv->fieldTypes[k];
                    break;
                }
                k = k + 1;
            }
            if (ft == 0)
            {
                self.semaErrorNode(ErrorCode::SemaUnknownMember, patId, "unknown field in pattern");
                ok = false;
            }
            else
            {
                Ty boundTy = self.substituteFieldTy(ft, scrutTy);
                if (!self.scopes.declare(fieldName, 1, boundTy, patId, 0)) ok = false;
            }
            f = f + 1;
        }
        return ok;
    }
}
