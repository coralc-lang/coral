extern("C") u64 write(i32 fd, u8* buf, u64 n);

extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);
extern("C") rawptr realloc(rawptr ptr, usize size);

pub struct AnalyzeResult
{
    u32 parseErrors;
    u32 semanticErrors;
    u32 monoErrors;
    u32 instances;
    u32 nodes;
}

/* Like analyze(), but keeps the AST alive for a backend: the context is
 * heap-allocated and outlives this call. Free with freeUnit().
 * sema/mono are kept too — the backend reads monomorphisation instances. */
pub struct CompileUnit
{
    AstContext* ctx;
    File* file;
    Sema* sema;
    MonoContext* mono;
    u8** bufs;
    u32 bufsLen;
    DiagnosticEngine* engineObj;
    u32 parseErrors;
    u32 semanticErrors;
    u32 monoErrors;
}

pub void freeUnit(CompileUnit* unit)
{
    if (unit.bufs != null)
    {
        u32 bi = 0;
        while (bi < unit.bufsLen)
        {
            free(unit.bufs[bi]);
            bi = bi + 1;
        }
        free(unit.bufs);
        unit.bufs = null;
    }
    if (unit.engineObj != null) { free(unit.engineObj); unit.engineObj = null; }
    if (unit.mono != null) {
        unit.mono.deinit();
        free(unit.mono);
        unit.mono = null;
    }
    if (unit.sema != null) {
        unit.sema.deinit();
        free(unit.sema);
        unit.sema = null;
    }
    if (unit.ctx != null) {
        unit.ctx.deinit();
        free(unit.ctx);
        unit.ctx = null;
        unit.file = null;
    }
}

/*
 * Resolves `import(lib) a::b::c` against the lib/ roots:
 *   1. <root>/a/b/c.crl            direct module file
 *   2. <root>/a/b/c/lib.crl        directory manifest
 *   3. <root>/a/lib.crl entry `b`  package manifest — entries are
 *      `pub mod name = import <path>;` and their targets resolve
 *      relative to the manifest's directory (nesting recurses).
 * Roots: <dir(input)>/../../lib, then ./lib.  The resolved file is
 * parsed into the shared context and merged flat, dependencies first,
 * ahead of the importing file's own decls. 
 */

struct LibSeg
{
    u8* ptr;
    u32 len;
}

struct LibLoader
{
    AstContext* ctx;
    IdentifierTable* idents;
    DiagnosticEngine* diag;
    u8* inputPath;
    u8** loaded;
    u32 loadedLen;
    u32 loadedCap;
    File** files;
    u32 filesLen;
    u32 filesCap;
    u8** bufs;
    u32 bufsLen;
    u32 bufsCap;
    LibSeg* platformRootSegs;
    u32 platformRootSegsLen;
    u32 errors;
}

usize libLen(u8* s)
{
    usize n = 0;
    if (s == null) return 0;
    while (s[n] != 0) n = n + 1;
    return n;
}

bool libBytesEq(u8* a, usize al, u8* b, usize bl)
{
    if (a == null || b == null) return false;
    if (al != bl) return false;
    usize i = 0;
    while (i < al)
    {
        if (a[i] != b[i]) return false;
        i = i + 1;
    }
    return true;
}

u8* libCandidate(u8* dir, usize dirLen, u8* seg, usize segLen, u8* suffix, usize suffixLen)
{
    u8* p = (u8*)malloc(dirLen + 1 + segLen + suffixLen + 1);
    if (p == null) return null;
    usize k = 0;
    usize i = 0;
    while (i < dirLen) { p[k] = dir[i]; k = k + 1; i = i + 1; }
    p[k] = 47; k = k + 1;
    i = 0;
    while (i < segLen) { p[k] = seg[i]; k = k + 1; i = i + 1; }
    i = 0;
    while (i < suffixLen) { p[k] = suffix[i]; k = k + 1; i = i + 1; }
    p[k] = 0;
    return p;
}

u8* libDir(u8* path)
{
    usize n = libLen(path);
    usize i = n;
    while (i > 0)
    {
        i = i - 1;
        if (path[i] == 47)
        {
            if (i == 0) return null;
            u8* d = (u8*)malloc(i + 1);
            if (d == null) return null;
            usize k = 0;
            while (k < i) { d[k] = path[k]; k = k + 1; }
            d[i] = 0;
            return d;
        }
    }
    return null;
}


u8* libRead(u8* cpath, usize* outLen)
{
    *outLen = 0;
    Slice s = readFile(cpath, outLen);
    if (s.ptr == null || s.len == 0)
    {
        if (s.ptr != null) free(s.ptr);
        return null;
    }
    return (u8*)s.ptr;
}

u32 libSplit(u8* s, usize n, LibSeg* out, u32 max)
{
    u32 count = 0;
    usize start = 0;
    usize i = 0;
    while (i <= n)
    {
        bool atEnd = (i == n);
        bool atSep = false;
        if (!atEnd && (i + 1) < n && s[i] == 58 && s[i + 1] == 58) atSep = true;
        if (atEnd || atSep)
        {
            if (count < max)
            {
                out[count].ptr = s + start;
                out[count].len = (u32)(i - start);
                count = count + 1;
            }
            if (atEnd) break;
            i = i + 2;
            start = i;
            continue;
        }
        i = i + 1;
    }
    return count;
}

File* libParse(LibLoader* L, u8* buf, usize len, u8* cpath, DiagnosticEngine* diag, u32 fileId)
{
    /* report into the caller's engine — it owns the file table entry for
     * `buf` (registered via addFile before this call). A throwaway engine
     * here produced location-less diagnostics: empty file table made
     * renderAt fall back to the bare one-line form. */
    DiagnosticEngine localEngine;
    DiagnosticEngine* eng = diag;
    if (eng == null)
    {
        localEngine.init(buf, buf + len);
        eng = &localEngine;
    }
    Lexer lexer = Lexer {
        .bufStart = buf,
        .cur = buf,
        .bufEnd = buf + len,
        .line = 1,
        .lineStart = buf,
        .diag = eng,
        .idents = L->idents,
        .fileId = fileId,
    };
    
    Parser parser = Parser {
        .lexer = &lexer,
        .ctx = L->ctx,
        .panicMode = 0,
        .pendingGreater = false,
        .current = lexer.nextToken(),
        .fileId = fileId,
    };
    parser.previous = parser.current;
    AstContext* c = L->ctx;
    File* f = parser.parseFile(c.intern(cpath, libLen(cpath)));
    L->errors = L->errors + parser.errorCount();
    return f;
}

u8* libResolveSegs(LibLoader* L, LibSeg* segs, u32 n, u8* dir, usize dirLen, u32 depth)
{
    if (L == null || segs == null || dir == null || n == 0) return null;
    if (depth > 16) return null;

    if (n == 1)
    {
        /* existence probe only — the file is re-read by the loader later,
         * and nothing here interns into this buffer, so it can be freed */
        usize len = 0;
        u8* cand = libCandidate(dir, dirLen, segs[0].ptr, segs[0].len, ".crl", 4);
        if (cand != null)
        {
            u8* buf = libRead(cand, &len);
            if (buf != null)
            {
                free(buf);
                return cand;
            }
            free(cand);
        }
        cand = libCandidate(dir, dirLen, segs[0].ptr, segs[0].len, "/lib.crl", 8);
        if (cand != null)
        {
            u8* buf = libRead(cand, &len);
            if (buf != null)
            {
                free(buf);
                return cand;
            }
            free(cand);
        }
        return null;
    }
    u8* sub = libCandidate(dir, dirLen, segs[0].ptr, segs[0].len, "", 0);
    if (sub == null) return null;
    usize subLen = dirLen + 1 + segs[0].len;
    u8* mpath = libCandidate(dir, dirLen, segs[0].ptr, segs[0].len, "/lib.crl", 8);
    if (mpath != null)
    {
        usize mlen = 0;
        u8* mbuf = libRead(mpath, &mlen);
        if (mbuf != null)
        {
            u32 mfid = 0;
            DiagnosticEngine* dg = L->diag;
            if (dg != null) mfid = dg.addFile(mpath, libLen(mpath), mbuf, mbuf + mlen);
            File* mf = libParse(L, mbuf, mlen, mpath, dg, mfid);
            if (mf != null)
            {
                u32 d = 0;
                while (d < mf->declsLen)
                {
                    Node* dn = L->ctx->nodes + mf->decls[d].index;
                    if (dn->kind.tag == NodeKind::Decl)
                    {
                        Decl* dd = &dn->kind.payload.Decl.value;
                        if (dd->kind.tag == DeclKind::ModReexport && dd->kind.payload.ModReexport.path != 0)
                        {
                            InternEntry* entry = L->ctx->interns + dd->kind.payload.ModReexport.alias;
                            if (libBytesEq(entry->ptr, entry->len, segs[1].ptr, segs[1].len))
                            {
                                InternEntry* target = L->ctx->interns + dd->kind.payload.ModReexport.path;
                                u32 maxT = (u32)(target->len / 2) + 1;
                                LibSeg* next = (LibSeg*)malloc(((usize)maxT + n) * @sizeof(LibSeg));
                                if (next != null)
                                {
                                    u32 got = libSplit(target->ptr, target->len, next, maxT);
                                    u32 j = 2;
                                    while (j < n)
                                    {
                                        next[got] = segs[j];
                                        got = got + 1;
                                        j = j + 1;
                                    }
                                    u8* r = libResolveSegs(L, next, got, sub, subLen, depth + 1);
                                    free(next);
                                    if (r != null)
                                    {
                                        free(mpath);
                                        return r;
                                    }
                                }
                            }
                        }
                    }
                    d = d + 1;
                }
            }
        }
        free(mpath);
    }
    /* no export entry (or its target failed) — descend as a directory */
    return libResolveSegs(L, segs + 1, n - 1, sub, subLen, depth + 1);
}

u8* libResolve(LibLoader* L, u8* nsPtr, usize nsLen)
{
    if (nsPtr == null || nsLen == 0) return null;
    u32 maxSegs = 1;
    usize i = 0;
    while (i + 1 < nsLen)
    {
        if (nsPtr[i] == 58 && nsPtr[i + 1] == 58) maxSegs = maxSegs + 1;
        i = i + 1;
    }
    LibSeg* segs = (LibSeg*)malloc((usize)maxSegs * @sizeof(LibSeg));
    if (segs == null) return null;
    u32 n = libSplit(nsPtr, nsLen, segs, maxSegs);
    u8* result = null;
    u8* base = libDir(L->inputPath);
    if (base != null)
    {
        usize bl = libLen(base);
        u8* up = libCandidate(base, bl, "..", 2, "/..", 3);
        if (up != null)
        {
            u8* root1 = libCandidate(up, libLen(up), "lib", 3, "", 0);
            if (root1 != null)
            {
                result = libResolveSegs(L, segs, n, root1, libLen(root1), 0);
                free(root1);
            }
            free(up);
        }
        free(base);
    }
    if (result == null)
        result = libResolveSegs(L, segs, n, (u8*)"lib", 3, 0);
    if (result == null && L->platformRootSegsLen > 0 && n > 1)
    {
        /* platform-first: <module>/<platform_root>/<rest> — neutral paths
         * resolve under the platform root before the base tree
         * (see coral-docs/builder_incomplete.md) */
        LibSeg* psegs = (LibSeg*)malloc(((usize)1 + L->platformRootSegsLen + (n - 1)) * @sizeof(LibSeg));
        if (psegs != null)
        {
            psegs[0] = segs[0];
            u32 k = 1;
            u32 m = 0;
            while (m < L->platformRootSegsLen)
            {
                psegs[k] = L->platformRootSegs[m];
                k = k + 1;
                m = m + 1;
            }
            m = 1;
            while (m < n)
            {
                psegs[k] = segs[m];
                k = k + 1;
                m = m + 1;
            }
            result = libResolveSegs(L, psegs, k, (u8*)"lib", 3, 0);
            if (result == null && base != null)
                result = libResolveSegs(L, psegs, k, base, libLen(base), 0);
            free(psegs);
        }
    }
    free(segs);
    return result;
}

bool libHas(LibLoader* L, u8* path)
{
    usize plen = libLen(path);
    u32 i = 0;
    while (i < L->loadedLen)
    {
        if (libBytesEq(L->loaded[i], libLen(L->loaded[i]), path, plen)) return true;
        i = i + 1;
    }
    return false;
}

bool libPush(LibLoader* L, u8* path)
{
    if (L->loadedLen >= L->loadedCap)
    {
        u32 newCap = L->loadedCap * 2;
        rawptr raw = realloc((rawptr)L->loaded, (usize)newCap * @sizeof(u8*));
        if (raw == null) return false;
        L->loaded = (u8**)raw;
        L->loadedCap = newCap;
    }
    L->loaded[L->loadedLen] = path;
    L->loadedLen = L->loadedLen + 1;
    return true;
}

bool libPushFile(LibLoader* L, File* f)
{
    if (L->filesLen >= L->filesCap)
    {
        u32 newCap = L->filesCap * 2;
        rawptr raw = realloc((rawptr)L->files, (usize)newCap * @sizeof(File*));
        if (raw == null) return false;
        L->files = (File**)raw;
        L->filesCap = newCap;
    }
    L->files[L->filesLen] = f;
    L->filesLen = L->filesLen + 1;
    return true;
}

 bool libIsRootSeg(u8* p, usize n)
 {
     if (n == 4 && p[0] == 102 && p[1] == 105 && p[2] == 108 && p[3] == 101) return true;
     if (n == 3 && p[0] == 108 && p[1] == 105 && p[2] == 98) return true;
     return false;
 }

 /* non-lib `import a { … }` — load the sibling file <dir-of-f>/a.crl and
  * merge it flat, like import(lib) files. Nested imports recurse;
  * already-loaded paths are skipped (libHas dedupes). A missing file is
  * not an error here — sema then falls back to module-symbol lookup. */
 void libLoadSiblingImports(LibLoader* L, File* f)
 {
     if (f == null || f->path == 0) return;
     InternEntry* pe = L->ctx->interns + f->path;
     u8* dir = libDir(pe->ptr);
     if (dir == null) return;
     usize dirLen = libLen(dir);
     u32 i = 0;
     while (i < f->declsLen)
     {
         Node* dn = L->ctx->nodes + f->decls[i].index;
         if (dn->kind.tag == NodeKind::Decl)
         {
             Decl* dd = &dn->kind.payload.Decl.value;
             if (dd->kind.tag == DeclKind::Import && (dd->kind.payload.Import.flags & 1) == 0 && dd->kind.payload.Import.path != 0)
             {
                 InternEntry* ie = L->ctx->interns + dd->kind.payload.Import.path;
                 bool sibling = ie->len > 0;
                 if (sibling && libIsRootSeg(ie->ptr, ie->len)) sibling = false;
                 usize q = 0;
                 while (sibling && q < ie->len)
                 {
                     if (ie->ptr[q] == 58) sibling = false;
                     q = q + 1;
                 }
                 if (sibling)
                 {
                     u8* cand = libCandidate(dir, dirLen, ie->ptr, ie->len, ".crl", 4);
                     if (cand != null)
                     {
                         if (libHas(L, cand))
                         {
                             free(cand);
                         }
                         else
                         {
                             usize len = 0;
                             u8* buf = libRead(cand, &len);
                             if (buf == null)
                             {
                                 free(cand);
                             }
                             else if (!libPush(L, cand))
                             {
                                 L->errors = L->errors + 1;
                                 free(cand);
                                 free(buf);
                             }
                             else
                             {
                                 u32 fid = 0;
                                 DiagnosticEngine* dg = L->diag;
                                 if (dg != null) fid = dg.addFile(cand, libLen(cand), buf, buf + len);
                                 if (L->bufsLen >= L->bufsCap)
                                 {
                                     u32 newCap = L->bufsCap == 0 ? 8 : L->bufsCap * 2;
                                     rawptr raw = realloc((rawptr)L->bufs, (usize)newCap * @sizeof(u8*));
                                     if (raw != null) { L->bufs = (u8**)raw; L->bufsCap = newCap; }
                                 }
                                 if (L->bufsLen < L->bufsCap) L->bufs[L->bufsLen] = buf;
                                 else free(buf);
                                 L->bufsLen = L->bufsLen + 1;
                                 File* lf = libParse(L, buf, len, cand, dg, fid);
                                 if (lf == null)
                                 {
                                     write(2, "coral: cannot parse sibling import ", 34);
                                     write(2, cand, libLen(cand));
                                     write(2, "\n", 1);
                                     L->errors = L->errors + 1;
                                 }
                                 else
                                 {
                                     libLoadImports(L, lf);
                                     libLoadSiblingImports(L, lf);
                                     if (!libPushFile(L, lf)) L->errors = L->errors + 1;
                                 }
                             }
                         }
                     }
                 }
             }
         }
         i = i + 1;
     }
 }

 void libLoadImports(LibLoader* L, File* f)
 {
     if (f == null) return;
     u32 i = 0;
     while (i < f->declsLen)
     {
         Node* dn = L->ctx->nodes + f->decls[i].index;
         if (dn->kind.tag == NodeKind::Decl)
         {
             Decl* dd = &dn->kind.payload.Decl.value;
             if (dd->kind.tag == DeclKind::Import && (dd->kind.payload.Import.flags & 1) != 0 && dd->kind.payload.Import.path != 0)
             {
                 /* copy out before libResolve — parsing manifests grows the
                  * intern table, invalidating InternEntry pointers */
                 InternEntry* ie = L->ctx->interns + dd->kind.payload.Import.path;
                 u8* nsPtr = ie->ptr;
                 usize nsLen = ie->len;
                 /* targets: the import path itself, plus `path::mod` for
                  * every nested item group `mod::{ … }` — the submodule file
                  * must be merged too, not just the directory manifest */
                 u32 symCount = dd->kind.payload.Import.symbolsLen;
                 usize compsSize = 0;
                 u32 groupCount = 0;
                 u32 si = 0;
                 while (si < symCount)
                 {
                     Str nm = dd->kind.payload.Import.symbols[si].name;
                     if (nm != 0)
                     {
                         InternEntry* se = L->ctx->interns + nm;
                         usize lastCol = 0;
                         usize q = 0;
                         while (q + 1 < se->len)
                         {
                             if (se->ptr[q] == 58 && se->ptr[q + 1] == 58) lastCol = q;
                             q = q + 1;
                         }
                         if (lastCol > 0 && lastCol + 2 < se->len)
                         {
                             groupCount = groupCount + 1;
                             compsSize = compsSize + nsLen + 2 + lastCol;
                         }
                     }
                     si = si + 1;
                 }
                 u8* comps = null;
                 u8** tPtrs = null;
                 usize* tLens = null;
                 u32 targets = 1;
                 if (groupCount > 0)
                 {
                     comps = (u8*)malloc(compsSize);
                     tPtrs = (u8**)malloc(((usize)1 + groupCount) * @sizeof(u8*));
                     tLens = (usize*)malloc(((usize)1 + groupCount) * @sizeof(usize));
                     if (comps == null || tPtrs == null || tLens == null)
                     {
                         if (comps != null) free(comps);
                         if (tPtrs != null) free(tPtrs);
                         if (tLens != null) free(tLens);
                         comps = null;
                         tPtrs = null;
                         tLens = null;
                         L->errors = L->errors + 1;
                     }
                     else
                     {
                         usize off = 0;
                         si = 0;
                         while (si < symCount)
                         {
                             Str nm = dd->kind.payload.Import.symbols[si].name;
                             if (nm != 0)
                             {
                                 InternEntry* se = L->ctx->interns + nm;
                                 usize lastCol = 0;
                                 usize q = 0;
                                 while (q + 1 < se->len)
                                 {
                                     if (se->ptr[q] == 58 && se->ptr[q + 1] == 58) lastCol = q;
                                     q = q + 1;
                                 }
                                 if (lastCol > 0 && lastCol + 2 < se->len)
                                 {
                                     u8* dst = comps + off;
                                     usize d = 0;
                                     while (d < nsLen) { dst[d] = nsPtr[d]; d = d + 1; }
                                     dst[nsLen] = 58;
                                     dst[nsLen + 1] = 58;
                                     d = 0;
                                     while (d < lastCol) { dst[nsLen + 2 + d] = se->ptr[d]; d = d + 1; }
                                     tPtrs[targets] = dst;
                                     tLens[targets] = nsLen + 2 + lastCol;
                                     targets = targets + 1;
                                     off = off + nsLen + 2 + lastCol;
                                 }
                             }
                             si = si + 1;
                         }
                     }
                 }
                  u32 tCap = targets;
                  u8* tHard = null;
                  u8** tOwned = null;
                  if (tPtrs == null)
                  {
                      tPtrs = (u8**)malloc(@sizeof(u8*));
                      tLens = (usize*)malloc(@sizeof(usize));
                      tHard = (u8*)malloc(1);
                      tOwned = (u8**)malloc(@sizeof(u8*));
                      if (tPtrs == null || tLens == null || tHard == null || tOwned == null)
                      {
                          if (tPtrs != null) free(tPtrs);
                          if (tLens != null) free(tLens);
                          if (tHard != null) free(tHard);
                          if (tOwned != null) free(tOwned);
                          tPtrs = null;
                          tLens = null;
                          tHard = null;
                          tOwned = null;
                          L->errors = L->errors + 1;
                      }
                      else tCap = 1;
                  }
                  if (tPtrs == null)
                  {
                      if (comps != null) free(comps);
                      continue;
                  }
                  /* hard = missing file is an error; chased re-export
                   * targets are soft (a dead re-export may not exist here) */
                  if (tHard == null || tOwned == null)
                  {
                      u8* nh = (u8*)malloc(tCap);
                      u8** no = (u8**)malloc(((usize)tCap) * @sizeof(u8*));
                      if (nh != null && no != null)
                      {
                          tHard = nh;
                          tOwned = no;
                      }
                      else
                      {
                          if (nh != null) free(nh);
                          if (no != null) free(no);
                          free(tPtrs);
                          free(tLens);
                          if (comps != null) free(comps);
                          tPtrs = null;
                          continue;
                      }
                  }
                  u32 zi = 0;
                  while (zi < tCap)
                  {
                      tHard[zi] = 1;
                      tOwned[zi] = null;
                      zi = zi + 1;
                  }
                  tPtrs[0] = nsPtr;
                  tLens[0] = nsLen;
                  u32 k = 0;
                  while (k < targets && tPtrs != null)
                  {
                      u8* target = tPtrs[k];
                      usize targetLen = tLens[k];
                      u8* resolved = libResolve(L, target, targetLen);
                      if (resolved == null)
                      {
                          if (tHard[k] != 0)
                          {
                              write(2, "coral: cannot resolve import(lib) ", 34);
                              write(2, target, targetLen);
                              write(2, "\n", 1);
                              L->errors = L->errors + 1;
                          }
                      }
                      else
                      {
                          if (getenv((u8*)"CORAL_TRACE_LOAD") != null)
                          {
                              write(2, "coral: load ", 12);
                              write(2, resolved, libLen(resolved));
                              write(2, "\n", 1);
                          }
                          if (libHas(L, resolved))
                          {
                              free(resolved);
                          }
                          else if (!libPush(L, resolved))
                          {
                              L->errors = L->errors + 1;
                          }
                          else
                          {
                              usize len = 0;
                              u8* buf = libRead(resolved, &len);
                              File* lf = null;
                              if (buf != null)
                              {
                                  u32 fid = 0;
                                  DiagnosticEngine* dg = L->diag;
                                  if (dg != null) fid = dg.addFile(resolved, libLen(resolved), buf, buf + len);
                                  if (L->bufsLen >= L->bufsCap)
                                  {
                                      u32 newCap = L->bufsCap == 0 ? 8 : L->bufsCap * 2;
                                      rawptr raw = realloc((rawptr)L->bufs, (usize)newCap * @sizeof(u8*));
                                      if (raw != null) { L->bufs = (u8**)raw; L->bufsCap = newCap; }
                                  }
                                  if (L->bufsLen < L->bufsCap) L->bufs[L->bufsLen] = buf;
                                  else free(buf);
                                  L->bufsLen = L->bufsLen + 1;
                                  lf = libParse(L, buf, len, resolved, dg, fid);
                              }
                              if (lf == null)
                              {
                                  write(2, "coral: cannot read import(lib) file ", 36);
                                  write(2, resolved, libLen(resolved));
                                  write(2, "\n", 1);
                                  L->errors = L->errors + 1;
                              }
                              else
                              {
                                  libLoadImports(L, lf);   /* dependencies first */
                                  libLoadSiblingImports(L, lf);
                                  if (!libPushFile(L, lf)) L->errors = L->errors + 1;

                                  /* directory-manifest re-exports: a path that
                                   * lands on <dir>/lib.crl must chase its
                                   * `pub mod X = import …` targets so members
                                   * resolve (std::math → math/lib.crl →
                                   * math/math.crl). Chased only for symbols
                                   * this import asked for when any alias
                                   * matches, else all aliases (the path names
                                   * the directory itself). Targets are soft. */
                                  Str* rxAliases = (Str*)malloc(((usize)lf->declsLen + 1) * @sizeof(Str));
                                  u8* rxWant = null;
                                  u32 rxCount = 0;
                                  if (rxAliases != null)
                                  {
                                      u32 rx = 0;
                                      while (rx < lf->declsLen)
                                      {
                                          Node* rn = L->ctx->nodes + lf->decls[rx].index;
                                          if (rn->kind.tag == NodeKind::Decl)
                                          {
                                              Decl* rd = &rn->kind.payload.Decl.value;
                                              if (rd->kind.tag == DeclKind::ModReexport)
                                              {
                                                  rxAliases[rxCount] = rd->kind.payload.ModReexport.alias;
                                                  rxCount = rxCount + 1;
                                              }
                                          }
                                          rx = rx + 1;
                                      }
                                  }
                                  if (rxAliases != null && rxCount > 0)
                                  {
                                      rxWant = (u8*)malloc(rxCount);
                                      if (rxWant != null)
                                      {
                                          u32 a = 0;
                                          u32 any = 0;
                                          while (a < rxCount)
                                          {
                                              rxWant[a] = 0;
                                              if (symCount > 0)
                                              {
                                                  u32 s2 = 0;
                                                  while (s2 < symCount)
                                                  {
                                                      Str nm = dd->kind.payload.Import.symbols[s2].name;
                                                      if (nm != 0)
                                                      {
                                                          if (nm == rxAliases[a]) rxWant[a] = 1;
                                                          else
                                                          {
                                                              InternEntry* se2 = L->ctx->interns + nm;
                                                              u8* np2 = se2->ptr;
                                                              usize nl2 = se2->len;
                                                              usize lc = 0;
                                                              usize q2 = 0;
                                                              while (q2 + 1 < nl2)
                                                              {
                                                                  if (np2[q2] == 58 && np2[q2 + 1] == 58) lc = q2;
                                                                  q2 = q2 + 1;
                                                              }
                                                              if (lc > 0 && lc + 2 < nl2)
                                                              {
                                                                  AstContext* ac = L->ctx;
                                                                  Str pref = ac.intern(np2, lc);
                                                                  Str tail = ac.intern(np2 + lc + 2, nl2 - (lc + 2));
                                                                  if (pref == rxAliases[a] || tail == rxAliases[a]) rxWant[a] = 1;
                                                              }
                                                          }
                                                      }
                                                      s2 = s2 + 1;
                                                  }
                                              }
                                              if (rxWant[a] != 0) any = 1;
                                              a = a + 1;
                                          }
                                          a = 0;
                                          while (a < rxCount)
                                          {
                                              if (symCount == 0 || any == 0 || rxWant[a] != 0)
                                              {
                                                  if (targets >= tCap)
                                                  {
                                                      u32 nc = 16;
                                                      if (tCap != 0) nc = tCap * 2;
                                                      u8** np = (u8**)realloc((rawptr)tPtrs, (usize)nc * @sizeof(u8*));
                                                      if (np != null) tPtrs = np;
                                                      usize* nl = (usize*)realloc((rawptr)tLens, (usize)nc * @sizeof(usize));
                                                      if (nl != null) tLens = nl;
                                                      u8* nhh = (u8*)realloc((rawptr)tHard, (usize)nc);
                                                      if (nhh != null) tHard = nhh;
                                                      u8** noo = (u8**)realloc((rawptr)tOwned, (usize)nc * @sizeof(u8*));
                                                      if (noo != null) tOwned = noo;
                                                      if (targets < nc) tCap = nc;
                                                  }
                                                  if (targets < tCap)
                                                  {
                                                      InternEntry* ae = L->ctx->interns + rxAliases[a];
                                                      u8* nt = (u8*)malloc(targetLen + 2 + ae->len);
                                                      if (nt != null)
                                                      {
                                                          usize w = 0;
                                                          while (w < targetLen) { nt[w] = target[w]; w = w + 1; }
                                                          nt[targetLen] = 58;
                                                          nt[targetLen + 1] = 58;
                                                          w = 0;
                                                          while (w < ae->len) { nt[targetLen + 2 + w] = ae->ptr[w]; w = w + 1; }
                                                          tPtrs[targets] = nt;
                                                          tLens[targets] = targetLen + 2 + ae->len;
                                                          tHard[targets] = 0;
                                                          tOwned[targets] = nt;
                                                          targets = targets + 1;
                                                      }
                                                  }
                                              }
                                              a = a + 1;
                                          }
                                      }
                                  }
                                  if (rxAliases != null) free(rxAliases);
                                  if (rxWant != null) free(rxWant);
                              }
                          }
                      }
                      k = k + 1;
                  }
                  if (comps != null) free(comps);
                  if (tPtrs != null) free(tPtrs);
                  if (tLens != null) free(tLens);
                  if (tHard != null) free(tHard);
                  if (tOwned != null)
                  {
                      u32 fi = 0;
                      while (fi < targets)
                      {
                          if (tOwned[fi] != null) free(tOwned[fi]);
                          fi = fi + 1;
                      }
                      free(tOwned);
                  }
             }
         }
         i = i + 1;
     }
 }

bool libMerge(LibLoader* L, File* file)
{
    if (L->filesLen == 0) return true;
    u32 total = file->declsLen;
    u32 i = 0;
    while (i < L->filesLen)
    {
        total = total + L->files[i]->declsLen;
        i = i + 1;
    }
    NodeId* merged = (NodeId*)malloc((usize)total * @sizeof(NodeId));
    if (merged == null) return false;
    u32 k = 0;
    i = 0;
    while (i < L->filesLen)
    {
        u32 j = 0;
        while (j < L->files[i]->declsLen)
        {
            merged[k] = L->files[i]->decls[j];
            k = k + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < file->declsLen)
    {
        merged[k] = file->decls[i];
        k = k + 1;
        i = i + 1;
    }
    AstContext* c = L->ctx;
    if (!c.track((rawptr)merged))
    {
        free((rawptr)merged);
        return false;
    }
    file->decls = merged;
    file->declsLen = total;
    return true;
}

CompileUnit analyzeForCompile(u8* src, usize len, u8* path, Slice* flagsN, Slice* flagsV, u32 nFlags, usize errorLimit)
{
    CompileUnit unit = CompileUnit {
        .ctx = null,
        .file = null,
        .sema = null,
        .mono = null,
        .bufs = null,
        .bufsLen = 0,
        .parseErrors = 0,
        .semanticErrors = 0,
        .monoErrors = 0,
    };

    AstContext* ctx = (AstContext*)malloc(@sizeof(AstContext));
    if (ctx == null) {
        unit.parseErrors = 1;
        return unit;
    }
    ctx.init(4096, 4096, 4096);

    /* seed flag table from the CLI so `flag (NAME) {...}` evaluates
     * against build-time flags (see compile.crl / Options) */
    if (flagsN != null && nFlags > 0)
    {
        Str* fns = (Str*)malloc(nFlags * @sizeof(Str));
        Str* fvs = (Str*)malloc(nFlags * @sizeof(Str));
        u32 fi = 0;
        while (fi < nFlags)
        {
            fns[fi] = ctx.intern(flagsN[fi].ptr, flagsN[fi].len);
            fvs[fi] = ctx.intern(flagsV[fi].ptr, flagsV[fi].len);
            fi = fi + 1;
        }
        ctx->flagNames = fns;
        ctx->flagValues = fvs;
        ctx->flagsLen = nFlags;
    }

    IdentEntry* entries = (IdentEntry*)malloc(256 * @sizeof(IdentEntry));
    if (entries == null) {
        unit.parseErrors = 1;
        ctx.deinit();
        free(ctx);
        return unit;
    }

    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();

    DiagnosticEngine* engine = (DiagnosticEngine*)malloc(@sizeof(DiagnosticEngine));
    unit.engineObj = engine;
    DiagnosticEngine __tmpEngine;
    __tmpEngine.init(src, src + len);
    __tmpEngine.errorLimit = errorLimit;

    u8* mainPath = (u8*)"main";
    usize mainPathLen = 4;
    if (path != null)
    {
        usize plen = 0;
        while (path[plen] != 0) plen = plen + 1;
        if (plen > 0) { mainPath = path; mainPathLen = plen; }
    }
    __tmpEngine.addFile(mainPath, mainPathLen, src, src + len);
    *engine = __tmpEngine;

    Lexer lexer = Lexer {
        .bufStart = src,
        .cur = src,
        .bufEnd = src + len,
        .line = 1,
        .lineStart = src,
        .diag = engine,
        .idents = &idents,
        .fileId = 0,
    };

    Parser parser = Parser {
        .lexer = &lexer,
        .ctx = ctx,
        .panicMode = 0,
        .pendingGreater = false,
        .current = lexer.nextToken(),
        .fileId = 0,
    };
    parser.previous = parser.current;

    /* real file path so the backend can mangle module paths from it */
    Str pathStr = ctx.intern((u8*)"main", 4);
    if (path != null) {
        usize plen = 0;
        while (path[plen] != 0) plen = plen + 1;
        if (plen > 0) pathStr = ctx.intern(path, plen);
    }
    File* file = parser.parseFile(pathStr);
    unit.parseErrors = parser.errorCount();
    if (file == null && unit.parseErrors == 0) unit.parseErrors = 1;

    /* import(lib): resolve + parse + merge library decls, deps first */
    bool loadOk = true;
    LibLoader loader = LibLoader {
        .ctx = null,
        .idents = null,
        .diag = null,
        .inputPath = null,
        .loaded = null,
        .loadedLen = 0,
        .loadedCap = 0,
        .files = null,
        .filesLen = 0,
        .filesCap = 0,
        .bufs = null,
        .bufsLen = 0,
        .bufsCap = 0,
        .platformRootSegs = null,
        .platformRootSegsLen = 0,
        .errors = 0
    };
    
    if (file != null)
    {
        loader.ctx = ctx;
        loader.idents = &idents;
        loader.inputPath = path;
        loader.diag = engine;
        /* default host platform — neutral lib paths resolve under
         * <platform_root>/ first, then the base tree (see
         * coral-docs/builder_incomplete.md). target flags from the build
         * manifest override this once manifest selection lands. */
        LibSeg* prSegs = (LibSeg*)malloc(2 * @sizeof(LibSeg));
        if (prSegs != null)
        {
            prSegs[0].ptr = (u8*)"x86_64";
            prSegs[0].len = 6;
            prSegs[1].ptr = (u8*)"linux";
            prSegs[1].len = 5;
            loader.platformRootSegs = prSegs; // seems kinda hardcoded. there will be more 
            loader.platformRootSegsLen = 2;   // host platforms and more target archs
        }
        loader.loaded = (u8**)malloc(8 * @sizeof(u8*));
        loader.loadedLen = 0;
        loader.loadedCap = 8;
        loader.files = (File**)malloc(8 * @sizeof(File*));
        loader.filesLen = 0;
        loader.filesCap = 8;
        loader.errors = 0;
        if (loader.loaded == null || loader.files == null)
        {
            loader.errors = loader.errors + 1;
        }
        else
        {
            libLoadImports(&loader, file);
            libLoadSiblingImports(&loader, file);
            if (loader.errors == 0 && !libMerge(&loader, file))
            {
                write(2, "coral: failed to merge import(lib) decls\n", 41);
                loader.errors = loader.errors + 1;
            }
        }
        if (loader.loaded != null) free(loader.loaded);
        if (loader.files != null) free(loader.files);
        if (loader.errors > 0)
        {
            unit.parseErrors = unit.parseErrors + loader.errors;
            loadOk = false;
        }
    }

    if (file != null && loadOk) {
        Sema* sema = (Sema*)malloc(@sizeof(Sema));
        MonoContext* mono = (MonoContext*)malloc(@sizeof(MonoContext));
        if (sema == null || mono == null) {
            unit.parseErrors = unit.parseErrors + 1;
            if (sema != null) free(sema);
            if (mono != null) free(mono);
        } else {
            sema.init(ctx, engine);
            sema.scopes.enter();
            sema.declareAll(file);
            sema.checkBodies(file);
            sema.errors = sema.scopes.errors;

            mono.init(ctx, sema);
            mono.collectFile(file);
            mono.run();

            unit.semanticErrors = sema.errors;
            unit.monoErrors = mono.errors;
            unit.sema = sema;
            unit.mono = mono;
        }
    }

    /* lib file buffers must stay alive until codegen finishes — interned
     * strings point into them (see freeUnit) */
    unit.bufs = loader.bufs;
    unit.bufsLen = loader.bufsLen;
    if (loader.platformRootSegs != null) free(loader.platformRootSegs);

    free(entries);

    if (unit.parseErrors > 0 || unit.semanticErrors > 0 || unit.monoErrors > 0) {
        freeUnit(&unit);            /* sema + mono (unit.ctx not set yet) */
        ctx.deinit();
        free(ctx);
        return unit;
    }

    unit.ctx = ctx;
    unit.file = file;
    return unit;
}

AnalyzeResult analyze(u8* src, usize len)
{
    AnalyzeResult result = AnalyzeResult{
        .parseErrors = 0,
        .semanticErrors = 0,
        .monoErrors = 0,
        .instances = 0,
        .nodes = 0,
    };
    
    AstContext ctx;
    ctx.init(4096, 4096, 4096);
    
    IdentEntry* entries = (IdentEntry*)malloc(256 * @sizeof(IdentEntry));
    if (entries == null) {
        result.parseErrors = 1;
        ctx.deinit();
        return result;
    }
    
    IdentifierTable idents;
    idents.init(entries, 256);
    idents.addKeywords();

    CompileUnit unit;
    unit.engineObj = null;
    DiagnosticEngine engine;
    engine.init(src, src + len);

    Lexer lexer = Lexer {
        .bufStart = src,
        .cur = src,
        .bufEnd = src + len,
        .line = 1,
        .lineStart = src,
        .diag = &engine,
        .idents = &idents,
        .fileId = 0,
    };
    
    Parser parser = Parser {
        .lexer = &lexer,
        .ctx = &ctx,
        .panicMode = 0,
        .pendingGreater = false,
        .current = lexer.nextToken(),
        .fileId = 0,
    };
    parser.previous = parser.current;
    
    File* file = parser.parseFile(ctx.intern("frontend", 8));
    Sema sema;
    sema.init(&ctx, &engine);
    sema.scopes.enter();
    sema.declareAll(file);
    sema.checkBodies(file);
    sema.errors = sema.scopes.errors;
    
    MonoContext mono;
    mono.init(&ctx, &sema);
    mono.collectFile(file);
    mono.run();

    result = AnalyzeResult {
        .parseErrors = parser.errorCount(),
        .semanticErrors = sema.errors,
        .monoErrors = mono.errors,
        .instances = mono.instancesLen,
        .nodes = ctx.nodeCount(),
    };

    mono.deinit();
    sema.deinit();
    ctx.deinit();
    free(entries);
    return result;
}
