mod id = import "../coral-ast/id";
mod types = import "../coral-ast/types";
mod node_ast = import "../coral-ast/node";
mod context = import "../coral-context/context";
mod scope = import "scope";
mod diag_engine = import "../coral-diagnostics/engine";
mod diag_code = import "../coral-diagnostics/code";

import id { Str, NodeId, SourceLoc, locFile };
import types { Ty };
import node_ast { Node, NodeKind };
import context { AstContext, InternEntry };
import scope { ScopeStack, Symbol };
import diag_engine { DiagnosticEngine };
import diag_code { ErrorCode };

extern("C") rawptr calloc(usize count, usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);
extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

pub struct Sema
{
    AstContext* ctx;
    ScopeStack* scopes;
    Ty currentReturnType;
    u32 errors;
    NodeId* extends;
    u32 extendsLen;
    u32 extendsCap;
    DiagnosticEngine* diag;
    /* --allow-int-ptr: int→pointer assignments are reported (TC-0009)
     * but non-fatal; without it they fail the build */
    bool allowIntPtr;
    /* direct (unqualified) import bindings by (file, local name) — a
     * second direct pull of the same name in one file conflicts */
    Str* directNames;
    u32* directFiles;
    u32 directLen;
    u32 directCap;
    /* import `as` renames: local alias → the aliased declaration, so the
     * backend can bridge `path__alias__name` refs to `path__name` */
    Str* aliasNames;
    NodeId* aliasDecls;
    u32 aliasLen;
    u32 aliasCap;
}

pub extend Sema
{
    /* diagnostic file id of the node's source file — 0 for absent ids */
    u32 fileOf(NodeId id)
    {
        if (id.index == 0) return 0;
        Node* n = self.ctx.nodes + id.index;
        return locFile(n->loc);
    }

    /* name lookup that prefers the symbol declared in the use-site's own
     * file (same-name symbols from other merged files mangle apart) */
    Symbol* lookupAt(Str name, NodeId id)
    {
        return self.scopes.lookupFrom(name, self.fileOf(id));
    }

    /* like lookupAt for a type reference: Named types carry the site they
     * were spelled at (TypeEntry.loc), so a same-named type declared in
     * another merged file resolves to its own decl. Entries without a
     * recorded site (sema-created) keep the plain scope behaviour. */
    Symbol* lookupType(Str name, SourceLoc loc)
    {
        if (loc.data == 0) return self.scopes.lookup(name);
        return self.scopes.lookupFrom(name, locFile(loc));
    }

    void init(AstContext* ctx, DiagnosticEngine* diag)
    {
        self.ctx = ctx;
        self.scopes = (ScopeStack*)calloc(1, @sizeof(ScopeStack));
        if (self.scopes != null) self.scopes.init(64);
        self.currentReturnType = 0;
        self.errors = 0;
        self.extends = null;
        self.allowIntPtr = false;
        self.extendsLen = 0;
        self.extendsCap = 0;
        self.diag = diag;
        self.directNames = null;
        self.directFiles = null;
        self.directLen = 0;
        self.directCap = 0;
        self.aliasNames = null;
        self.aliasDecls = null;
        self.aliasLen = 0;
        self.aliasCap = 0;
    }

    void deinit()
    {
        if (self.scopes != null)
        {
            self.scopes.deinit();
            free((rawptr)self.scopes);
        }
        if (self.extends != null) free((rawptr)self.extends);
        if (self.directNames != null) free((rawptr)self.directNames);
        if (self.directFiles != null) free((rawptr)self.directFiles);
        if (self.aliasNames != null) free((rawptr)self.aliasNames);
        if (self.aliasDecls != null) free((rawptr)self.aliasDecls);
        self.scopes = null;
        self.ctx = null;
        self.currentReturnType = 0;
        self.errors = 0;
        self.extends = null;
        self.diag = null;
        self.directNames = null;
        self.directFiles = null;
        self.directLen = 0;
        self.directCap = 0;
        self.aliasNames = null;
        self.aliasDecls = null;
        self.aliasLen = 0;
        self.aliasCap = 0;
    }

    /* record a direct (unqualified) import binding — false if this file
     * already pulled the same local name (conflict; alias with `as`) */
    bool claimDirectImport(u32 fileId, Str name)
    {
        u32 i = 0;
        while (i < self.directLen)
        {
            if (self.directFiles[i] == fileId && self.directNames[i] == name) return false;
            i = i + 1;
        }
        if (self.directLen >= self.directCap)
        {
            u32 newCap = 16;
            if (self.directCap != 0) newCap = self.directCap * 2;
            Str* n1 = (Str*)realloc((rawptr)self.directNames, (usize)newCap * 4);
            if (n1 == null) return true;
            self.directNames = n1;
            u32* n2 = (u32*)realloc((rawptr)self.directFiles, (usize)newCap * 4);
            if (n2 == null) return true;
            self.directFiles = n2;
            self.directCap = newCap;
        }
        self.directNames[self.directLen] = name;
        self.directFiles[self.directLen] = fileId;
        self.directLen = self.directLen + 1;
        return true;
    }

    /* record an import `as` rename — dedup by (alias, decl) */
    void addAliasPair(Str alias, NodeId declId)
    {
        if (alias == 0 || declId.index == 0) return;
        u32 i = 0;
        while (i < self.aliasLen)
        {
            if (self.aliasNames[i] == alias && self.aliasDecls[i].index == declId.index) return;
            i = i + 1;
        }
        if (self.aliasLen >= self.aliasCap)
        {
            u32 newCap = 16;
            if (self.aliasCap != 0) newCap = self.aliasCap * 2;
            Str* n1 = (Str*)realloc((rawptr)self.aliasNames, (usize)newCap * 4);
            if (n1 == null) return;
            self.aliasNames = n1;
            NodeId* n2 = (NodeId*)realloc((rawptr)self.aliasDecls, (usize)newCap * 4);
            if (n2 == null) return;
            self.aliasDecls = n2;
            self.aliasCap = newCap;
        }
        self.aliasNames[self.aliasLen] = alias;
        self.aliasDecls[self.aliasLen] = declId;
        self.aliasLen = self.aliasLen + 1;
    }

    void addExtend(NodeId id)
    {
        if (self.extendsLen >= self.extendsCap)
        {
            u32 newCap = 8;
            if (self.extendsCap != 0) newCap = self.extendsCap * 2;
            NodeId* fresh = (NodeId*)realloc((rawptr)self.extends, (usize)newCap * 4);
            if (fresh == null) return;
            self.extends = fresh;
            self.extendsCap = newCap;
        }
        self.extends[self.extendsLen] = id;
        self.extendsLen = self.extendsLen + 1;
    }

    void addError()
    {
        if (self.scopes != null) self.scopes.errors = self.scopes.errors + 1;
        self.errors = self.errors + 1;
    }

    void semaError(ErrorCode code, SourceLoc loc, u8* msg)
    {
        self.addError();
        if (self.diag == null) return;
        self.diag.emitError(code, loc, msg, null);
    }

    /* emit a diagnostic without counting again — used when the failing
     * operation (e.g. scopes.declare) already incremented the counter */
    void semaErrorCounted(ErrorCode code, NodeId id, u8* msg)
    {
        if (self.diag == null) return;
        SourceLoc loc;
        loc.data = 0;
        if (id.index != 0)
        {
            Node* node = self.ctx.nodes + id.index;
            loc = node->loc;
        }
        self.diag.emitError(code, loc, msg, null);
    }

    void semaErrorNode(ErrorCode code, NodeId id, u8* msg)
    {
        SourceLoc loc;
        loc.data = 0;
        if (id.index != 0)
        {
            Node* node = self.ctx.nodes + id.index;
            loc = node->loc;
        }
        self.semaError(code, loc, msg);
    }

    /* "<prefix><interned name>" as a fresh cstr — diagnostics name the
     * offending identifier instead of a bare generic message */
    u8* nameMsg(u8* prefix, Str name)
    {
        usize pl = 0;
        while (prefix[pl] != 0) pl = pl + 1;
        InternEntry* ie = self.ctx.interns + name;
        u8* m = (u8*)malloc(pl + ie->len + 1);
        if (m == null) return prefix;
        usize i = 0;
        while (i < pl) { m[i] = prefix[i]; i = i + 1; }
        i = 0;
        while (i < ie->len) { m[pl + i] = ie->ptr[i]; i = i + 1; }
        m[pl + ie->len] = 0;
        return m;
    }

    /* "<prefix><interned name><suffix>" as a fresh cstr */
    u8* nameMsgS(u8* prefix, Str name, u8* suffix)
    {
        usize pl = 0;
        while (prefix[pl] != 0) pl = pl + 1;
        usize sl = 0;
        while (suffix[sl] != 0) sl = sl + 1;
        InternEntry* ie = self.ctx.interns + name;
        u8* m = (u8*)malloc(pl + ie->len + sl + 1);
        if (m == null) return prefix;
        usize i = 0;
        while (i < pl) { m[i] = prefix[i]; i = i + 1; }
        i = 0;
        while (i < ie->len) { m[pl + i] = ie->ptr[i]; i = i + 1; }
        i = 0;
        while (i < sl) { m[pl + ie->len + i] = suffix[i]; i = i + 1; }
        m[pl + ie->len + sl] = 0;
        return m;
    }

    /* append to a fixed diagnostic buffer (truncates, never overflows) */
    void tyAppend(u8* buf, usize cap, usize* len, u8* s)
    {
        usize i = 0;
        while (s[i] != 0 && *len + 1 < cap) { buf[*len] = s[i]; *len = *len + 1; i = i + 1; }
        buf[*len] = 0;
    }

    void tyAppendCh(u8* buf, usize cap, usize* len, u8 c)
    {
        if (*len + 1 < cap) { buf[*len] = c; *len = *len + 1; buf[*len] = 0; }
    }

    void tyAppendName(u8* buf, usize cap, usize* len, Str name)
    {
        if (name == 0 || name >= self.ctx.internsLen) return;
        InternEntry* ie = self.ctx.interns + name;
        usize i = 0;
        while (i < ie->len && *len + 1 < cap) { buf[*len] = ie->ptr[i]; *len = *len + 1; i = i + 1; }
        buf[*len] = 0;
    }

    /* render a Ty the way the user spelled it — i32, u8*, const cchar*,
     * str, Vec<i32>, T — into buf; returns buf. used by mismatch diags. */
    u8* tySpelling(Ty t, u8* buf, usize cap)
    {
        usize len = 0;
        u8* sub = (u8*)malloc(128);
        u8* digits = (u8*)malloc(12);
        buf[0] = 0;
        if (sub == null || digits == null) { buf[0] = 63; buf[1] = 0; return buf; }
        sub[0] = 0;
        if (t == 0) { self.tyAppend(buf, cap, &len, (u8*)"void"); free(sub); free(digits); return buf; }
        TypeEntry* e = self.ctx.types + t;
        TypeKind k = e.kind;
        switch (k.tag)
        {
            TypeKind::Void => { self.tyAppend(buf, cap, &len, (u8*)"void"); },
            TypeKind::Bool => { self.tyAppend(buf, cap, &len, (u8*)"bool"); },
            TypeKind::Char => { self.tyAppend(buf, cap, &len, (u8*)"char"); },
            TypeKind::I8 => { self.tyAppend(buf, cap, &len, (u8*)"i8"); },
            TypeKind::U8 => { self.tyAppend(buf, cap, &len, (u8*)"u8"); },
            TypeKind::I16 => { self.tyAppend(buf, cap, &len, (u8*)"i16"); },
            TypeKind::U16 => { self.tyAppend(buf, cap, &len, (u8*)"u16"); },
            TypeKind::I32 => { self.tyAppend(buf, cap, &len, (u8*)"i32"); },
            TypeKind::U32 => { self.tyAppend(buf, cap, &len, (u8*)"u32"); },
            TypeKind::I64 => { self.tyAppend(buf, cap, &len, (u8*)"i64"); },
            TypeKind::U64 => { self.tyAppend(buf, cap, &len, (u8*)"u64"); },
            TypeKind::I128 => { self.tyAppend(buf, cap, &len, (u8*)"i128"); },
            TypeKind::U128 => { self.tyAppend(buf, cap, &len, (u8*)"u128"); },
            TypeKind::F32 => { self.tyAppend(buf, cap, &len, (u8*)"f32"); },
            TypeKind::F64 => { self.tyAppend(buf, cap, &len, (u8*)"f64"); },
            TypeKind::Isize => { self.tyAppend(buf, cap, &len, (u8*)"isize"); },
            TypeKind::Usize => { self.tyAppend(buf, cap, &len, (u8*)"usize"); },
            TypeKind::Rawptr => { self.tyAppend(buf, cap, &len, (u8*)"rawptr"); },
            TypeKind::Str => { self.tyAppend(buf, cap, &len, (u8*)"str"); },
            TypeKind::Error => { self.tyAppend(buf, cap, &len, (u8*)"error"); },
            TypeKind::Named => {
                self.tyAppendName(buf, cap, &len, k.payload.Named.name);
                if (k.payload.Named.genericArgsLen > 0)
                {
                    self.tyAppendCh(buf, cap, &len, 60);
                    u32 g = 0;
                    while (g < k.payload.Named.genericArgsLen)
                    {
                        if (g > 0) self.tyAppend(buf, cap, &len, (u8*)", ");
                        self.tySpelling(k.payload.Named.genericArgs[g], sub, 128);
                        self.tyAppend(buf, cap, &len, sub);
                        g = g + 1;
                    }
                    self.tyAppendCh(buf, cap, &len, 62);
                }
            },
            TypeKind::Pointer => {
                self.tySpelling(k.payload.Pointer.base, sub, 128);
                self.tyAppend(buf, cap, &len, sub);
                self.tyAppendCh(buf, cap, &len, 42);
            },
            TypeKind::Const => {
                self.tyAppend(buf, cap, &len, (u8*)"const ");
                self.tySpelling(k.payload.Const.base, sub, 128);
                self.tyAppend(buf, cap, &len, sub);
            },
            TypeKind::Comptime => {
                self.tyAppend(buf, cap, &len, (u8*)"comptime ");
                self.tySpelling(k.payload.Comptime.base, sub, 128);
                self.tyAppend(buf, cap, &len, sub);
            },
            TypeKind::Slice => {
                self.tySpelling(k.payload.Slice.base, sub, 128);
                self.tyAppend(buf, cap, &len, sub);
                self.tyAppend(buf, cap, &len, (u8*)"[]");
            },
            TypeKind::Array => {
                self.tySpelling(k.payload.Array.base, sub, 128);
                self.tyAppend(buf, cap, &len, sub);
                self.tyAppendCh(buf, cap, &len, 91);
                u32 n = k.payload.Array.len;
                u32 di = 0;
                if (n == 0) { digits[0] = 48; di = 1; }
                while (n > 0 && di < 11) { digits[di] = (u8)(48 + (n % 10)); n = n / 10; di = di + 1; }
                while (di > 0) { di = di - 1; self.tyAppendCh(buf, cap, &len, digits[di]); }
                self.tyAppendCh(buf, cap, &len, 93);
            },
            TypeKind::FnPtr => {
                self.tySpelling(k.payload.FnPtr.returnType, sub, 128);
                self.tyAppend(buf, cap, &len, sub);
                self.tyAppend(buf, cap, &len, (u8*)"(");
                u32 p = 0;
                while (p < k.payload.FnPtr.paramsLen)
                {
                    if (p > 0) self.tyAppend(buf, cap, &len, (u8*)", ");
                    self.tySpelling(k.payload.FnPtr.params[p], sub, 128);
                    self.tyAppend(buf, cap, &len, sub);
                    p = p + 1;
                }
                self.tyAppendCh(buf, cap, &len, 41);
            },
            TypeKind::Tuple => {
                self.tyAppendCh(buf, cap, &len, 40);
                u32 p = 0;
                while (p < k.payload.Tuple.elemsLen)
                {
                    if (p > 0) self.tyAppend(buf, cap, &len, (u8*)", ");
                    self.tySpelling(k.payload.Tuple.elems[p], sub, 128);
                    self.tyAppend(buf, cap, &len, sub);
                    p = p + 1;
                }
                self.tyAppendCh(buf, cap, &len, 41);
            },
            TypeKind::TypeParam => { self.tyAppendName(buf, cap, &len, k.payload.TypeParam.name); },
            else => { self.tyAppend(buf, cap, &len, (u8*)"?"); }
        }
        free(sub);
        free(digits);
        return buf;
    }

    /* "argument `name`: got `<from>`, expected `<to>`" */
    u8* paramMismatchMsg(Str paramName, Ty fromTy, Ty toTy)
    {
        u8* fb = (u8*)malloc(128);
        u8* tb = (u8*)malloc(128);
        if (fb == null || tb == null) return (u8*)"argument type mismatch";
        self.tySpelling(fromTy, fb, 128);
        self.tySpelling(toTy, tb, 128);
        InternEntry* pe = self.ctx.interns + paramName;
        usize fl = 0;
        while (fb[fl] != 0) fl = fl + 1;
        usize tl = 0;
        while (tb[tl] != 0) tl = tl + 1;
        u8* m = (u8*)malloc(pe->len + fl + tl + 40);
        if (m == null) { free(fb); free(tb); return (u8*)"argument type mismatch"; }
        usize n = 0;
        usize i = 0;
        u8* p1 = (u8*)"argument `";
        i = 0;
        while (p1[i] != 0) { m[n] = p1[i]; n = n + 1; i = i + 1; }
        i = 0;
        while (i < pe->len) { m[n] = pe->ptr[i]; n = n + 1; i = i + 1; }
        u8* p2 = (u8*)"`: got `";
        i = 0;
        while (p2[i] != 0) { m[n] = p2[i]; n = n + 1; i = i + 1; }
        i = 0;
        while (i < fl) { m[n] = fb[i]; n = n + 1; i = i + 1; }
        u8* p3 = (u8*)"`, expected `";
        i = 0;
        while (p3[i] != 0) { m[n] = p3[i]; n = n + 1; i = i + 1; }
        i = 0;
        while (i < tl) { m[n] = tb[i]; n = n + 1; i = i + 1; }
        m[n] = 96; n = n + 1;
        m[n] = 0;
        free(fb);
        free(tb);
        return m;
    }

    /* "<what>: got `<from>`, expected `<to>`" — frees nothing; caller
     * passes the result straight to semaErrorNode (engine copies it) */
    u8* typeMismatchMsg(u8* what, Ty fromTy, Ty toTy)
    {
        u8* fb = (u8*)malloc(128);
        u8* tb = (u8*)malloc(128);
        if (fb == null || tb == null) return what;
        self.tySpelling(fromTy, fb, 128);
        self.tySpelling(toTy, tb, 128);
        usize wl = 0;
        while (what[wl] != 0) wl = wl + 1;
        usize fl = 0;
        while (fb[fl] != 0) fl = fl + 1;
        usize tl = 0;
        while (tb[tl] != 0) tl = tl + 1;
        u8* m = (u8*)malloc(wl + fl + tl + 40);
        if (m == null) { free(fb); free(tb); return what; }
        usize n = 0;
        usize i = 0;
        while (i < wl) { m[n] = what[i]; n = n + 1; i = i + 1; }
        u8* mid = (u8*)": got `";
        i = 0;
        while (mid[i] != 0) { m[n] = mid[i]; n = n + 1; i = i + 1; }
        i = 0;
        while (i < fl) { m[n] = fb[i]; n = n + 1; i = i + 1; }
        u8* mid2 = (u8*)"`, expected `";
        i = 0;
        while (mid2[i] != 0) { m[n] = mid2[i]; n = n + 1; i = i + 1; }
        i = 0;
        while (i < tl) { m[n] = tb[i]; n = n + 1; i = i + 1; }
        m[n] = 96; n = n + 1;
        m[n] = 0;
        free(fb);
        free(tb);
        return m;
    }

    /* duplicate declaration: name it and note where the first one is */
    void dupDeclDiag(Str name, NodeId id)
    {
        self.semaErrorCounted(ErrorCode::SemaDuplicateDecl, id,
            self.nameMsgS((u8*)"duplicate declaration of `", name, (u8*)"`"));
        if (self.scopes.dupSymbol != null && self.scopes.dupSymbol->declaration.index != 0 && self.diag != null)
        {
            Node* prev = self.ctx.nodes + self.scopes.dupSymbol->declaration.index;
            self.diag.emitNote(ErrorCode::SemaDuplicateDecl, prev->loc,
                self.nameMsgS((u8*)"previous declaration of `", name, (u8*)"` is here"), null);
        }
    }
}
