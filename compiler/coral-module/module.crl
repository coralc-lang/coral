/* module/module.crl — module resolution for 3 import forms
 *
 * Per reason.crl spec:
 *   A. Local path:  import "src/math/core.crl" { square };
 *   B. Root import: import file::math::core { square };
 *   C. Global lib:  import(lib) std::math { pow };
 *
 * Re-exports:
 *   mod m = import "path";
 *   pub mod m = import(lib) manifest::path;
 */

mod id = import "../coral-ast/id";
import id { Str };

extern("C") rawptr calloc(usize count, usize size);
extern("C") void free(rawptr ptr);

pub struct ModuleId { u32 index; }

pub struct ModuleEntry
{
    Str path;
    Str manifest;
    u8 kind;
}

pub struct ModuleMap
{
    ModuleEntry* entries;
    u32 entriesLen;
    u32 entriesCap;
}

extend ModuleMap
{
    void init(u32 cap)
    {
        self.entries = null;
        self.entriesLen = 0;
        self.entriesCap = 0;
        if (cap == 0) return;
        self.entries = calloc((usize)cap, 32);
        if (self.entries != null)
        {
            self.entriesCap = cap;
            self.entriesLen = 1;
        }
    }

    void deinit()
    {
        if (self.entries != null) free(self.entries);
        self.entries = null;
        self.entriesLen = 0;
        self.entriesCap = 0;
    }

    ModuleId add(Str path, Str manifest, u8 kind)
    {
        ModuleId none;
        none.index = 0;
        if (self.entries == null || self.entriesLen == 0 || self.entriesLen >= self.entriesCap)
            return none;
        ModuleEntry* entry = self.entries + self.entriesLen;
        entry*.path = path;
        entry*.manifest = manifest;
        entry*.kind = kind;
        ModuleId id;
        id.index = self.entriesLen;
        self.entriesLen = self.entriesLen + 1;
        return id;
    }

    ModuleId resolvePath(Str path)
    {
        u32 i = 1;
        while (i < self.entriesLen)
        {
            ModuleEntry* e = self.entries + i;
            if (e*.path == path)
            {
                ModuleId m;
                m.index = i;
                return m;
            }
            i = i + 1;
        }
        ModuleId none;
        none.index = 0;
        return none;
    }

    ModuleId resolveLib(Str manifest)
    {
        u32 i = 1;
        while (i < self.entriesLen)
        {
            ModuleEntry* e = self.entries + i;
            if (e*.manifest == manifest)
            {
                ModuleId m;
                m.index = i;
                return m;
            }
            i = i + 1;
        }
        ModuleId none;
        none.index = 0;
        return none;
    }

    bool isResolved(ModuleId m) { return m.index != 0; }
}
