pub struct EscapeResult {
    u8 character;
    usize bytesConsumed;
    bool isValid;

    void decodeEscapeSequence(u8* ptr, u8* end)
    {
        self.isValid = true;
        self.bytesConsumed = 2;

        if (ptr >= end || ptr[0] != '\\')
            self.isValid = false;

        u8 next = ptr[1];
        switch (next)
        {
            case 'n': self.character = '\n'; break;
            case 'r': self.character = '\r'; break;
            case 't': self.character = '\t'; break;
            case '\\': self.character = '\\'; break;
            case '\'': self.character = '\''; break;
            case '\"': self.character = '\"'; break;
            case '0': self.character = '\0'; break;
            case 'x': 
            {
                if (ptr + 3 >= end)
                {
                    self.isValid = false;
                    break;
                }
                u8 h1 = ptr[2];
                u8 h2 = ptr[3];

                self.bytesConsumed = 4;
                break;
            }
            default:
            {
                self.isValid = false;
                self.character = next;
            }
        }
    }
}