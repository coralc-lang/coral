/* parser/decl.crl — declaration parsing */

import "parser" { Parser }
import "../coral-common/token" { TokenKind }
import "../coral-ast/id" { NodeId }

extend Parser
{
    NodeId parseDecl()
    {
        while (self.match(TokenKind::AttrOpen))
        {
            self.expect(TokenKind::Ident);
            while (self.match(TokenKind::Comma))
            {
                self.expect(TokenKind::Ident);
            }
            self.expect(TokenKind::AttrClose);
        }
        self.match(TokenKind::Pub);

        if (self.check(TokenKind::Fn) || self.check(TokenKind::Extern) ||
            self.check(TokenKind::Static))
        {
            return self.parseFuncDecl();
        }
        if (self.check(TokenKind::Struct))
        {
            return self.parseStructDecl();
        }
        if (self.check(TokenKind::Enum))
        {
            return self.parseEnumDecl();
        }
        if (self.check(TokenKind::Variant))
        {
            return self.parseVariantDecl();
        }
        if (self.check(TokenKind::Union))
        {
            return self.parseUnionDecl();
        }
        if (self.check(TokenKind::Trait))
        {
            return self.parseTraitDecl();
        }
        if (self.check(TokenKind::Extend))
        {
            return self.parseExtendDecl();
        }
        if (self.check(TokenKind::Typedef))
        {
            return self.parseTypedefDecl();
        }
        if (self.check(TokenKind::Distinct))
        {
            return self.parseDistinctDecl();
        }
        if (self.check(TokenKind::Flag))
        {
            return self.parseFlagDecl();
        }
        if (self.check(TokenKind::Import))
        {
            return self.parseImportDecl();
        }
        if (self.check(TokenKind::Mod))
        {
            return self.parseModReexport();
        }
        if (self.check(TokenKind::Comptime))
        {
            return self.parseComptimeDecl();
        }
        self.parseType();
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::Equal);
        self.parseExpr();
        self.expect(TokenKind::Semicolon);
        return self.allocNode();
    }

    NodeId parseGenericParams()
    {
        self.expect(TokenKind::Less);
        self.expect(TokenKind::Ident);
        if (self.match(TokenKind::Colon))
        {
            self.expect(TokenKind::Ident);
            while (self.match(TokenKind::Comma))
            {
                self.expect(TokenKind::Ident);
            }
        }
        while (self.match(TokenKind::Comma))
        {
            self.expect(TokenKind::Ident);
            if (self.match(TokenKind::Colon))
            {
                self.expect(TokenKind::Ident);
            }
        }
        if (self.check(TokenKind::Shr))
        {
            self.advance();
            return self.allocNode();
        }
        self.expect(TokenKind::Greater);
        return self.allocNode();
    }

    NodeId parseFuncDecl()
    {
        self.match(TokenKind::Extern);
        if (self.check(TokenKind::LParen))
        {
            self.advance();
            self.expect(TokenKind::String);
            self.expect(TokenKind::RParen);
        }
        self.match(TokenKind::Static);
        self.expect(TokenKind::Fn);
        self.expect(TokenKind::Ident);
        if (self.check(TokenKind::Less))
        {
            self.parseGenericParams();
        }
        self.expect(TokenKind::LParen);
        if (!self.check(TokenKind::RParen))
        {
            self.parseParam();
            while (self.match(TokenKind::Comma))
            {
                self.parseParam();
            }
        }
        self.expect(TokenKind::RParen);
        if (self.match(TokenKind::FatArrow))
        {
            self.parseType();
        }
        if (self.match(TokenKind::Semicolon))
        {
            return self.allocNode();
        }
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            self.parseStmt();
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseParam()
    {
        if (self.check(TokenKind::Self))
        {
            self.advance();
            return self.allocNode();
        }
        self.parseType();
        self.expect(TokenKind::Ident);
        return self.allocNode();
    }

    NodeId parseStructDecl()
    {
        self.expect(TokenKind::Struct);
        self.expect(TokenKind::Ident);
        if (self.check(TokenKind::Less))
        {
            self.parseGenericParams();
        }
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            if (self.check(TokenKind::Fn) || self.check(TokenKind::Extern) ||
                self.check(TokenKind::Static) || self.check(TokenKind::Pub))
            {
                self.match(TokenKind::Pub);
                self.parseFuncDecl();
                continue;
            }
            self.match(TokenKind::Pub);
            self.parseType();
            self.expect(TokenKind::Ident);
            if (self.match(TokenKind::Equal))
            {
                self.parseExpr();
            }
            self.match(TokenKind::Comma);
            self.match(TokenKind::Semicolon);
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseEnumDecl()
    {
        self.expect(TokenKind::Enum);
        self.expect(TokenKind::Ident);
        if (self.match(TokenKind::Colon))
        {
            self.parseType();
        }
        self.expect(TokenKind::LBrace);
        if (!self.check(TokenKind::RBrace))
        {
            self.expect(TokenKind::Ident);
            if (self.match(TokenKind::Equal))
            {
                self.parseExpr();
            }
            while (self.match(TokenKind::Comma))
            {
                if (self.check(TokenKind::RBrace)) break;
                self.expect(TokenKind::Ident);
                if (self.match(TokenKind::Equal))
                {
                    self.parseExpr();
                }
            }
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseVariantDecl()
    {
        self.expect(TokenKind::Variant);
        self.expect(TokenKind::Ident);
        if (self.check(TokenKind::Less))
        {
            self.parseGenericParams();
        }
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            if (self.check(TokenKind::Fn) || self.check(TokenKind::Pub))
            {
                self.match(TokenKind::Pub);
                self.parseFuncDecl();
                continue;
            }
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::LBrace);
            while (!self.check(TokenKind::RBrace) && !self.atEnd())
            {
                self.parseType();
                self.expect(TokenKind::Ident);
                if (!self.match(TokenKind::Comma)) break;
            }
            self.expect(TokenKind::RBrace);
            self.match(TokenKind::Comma);
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseUnionDecl()
    {
        self.expect(TokenKind::Union);
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            if (self.check(TokenKind::Fn) || self.check(TokenKind::Pub))
            {
                self.match(TokenKind::Pub);
                self.parseFuncDecl();
                continue;
            }
            self.match(TokenKind::Pub);
            self.parseType();
            self.expect(TokenKind::Ident);
            self.match(TokenKind::Comma);
            self.match(TokenKind::Semicolon);
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseTraitDecl()
    {
        self.expect(TokenKind::Trait);
        self.expect(TokenKind::Ident);
        if (self.check(TokenKind::Less))
        {
            self.parseGenericParams();
        }
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            self.parseFuncDecl();
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseExtendDecl()
    {
        self.expect(TokenKind::Extend);
        self.parseType();
        if (self.match(TokenKind::Colon))
        {
            self.expect(TokenKind::Ident);
        }
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            self.parseFuncDecl();
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseTypedefDecl()
    {
        self.expect(TokenKind::Typedef);
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::Equal);
        self.parseType();
        self.expect(TokenKind::Semicolon);
        return self.allocNode();
    }

    NodeId parseDistinctDecl()
    {
        self.expect(TokenKind::Distinct);
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::Equal);
        self.parseType();
        self.expect(TokenKind::Semicolon);
        return self.allocNode();
    }

    NodeId parseFlagDecl()
    {
        self.expect(TokenKind::Flag);
        self.expect(TokenKind::LParen);
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::RParen);
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::FatArrow);
            self.expect(TokenKind::LBrace);
            while (!self.check(TokenKind::RBrace) && !self.atEnd())
            {
                self.parseStmt();
            }
            self.expect(TokenKind::RBrace);
            self.match(TokenKind::Comma);
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    NodeId parseImportDecl()
    {
        self.expect(TokenKind::Import);
        if (self.match(TokenKind::LParen))
        {
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::RParen);
        }
        if (self.check(TokenKind::String))
        {
            self.advance();
        }
        else
        {
            self.expect(TokenKind::Ident);
            while (self.match(TokenKind::ColonColon))
            {
                self.expect(TokenKind::Ident);
            }
        }
        if (self.match(TokenKind::LBrace))
        {
            if (!self.check(TokenKind::RBrace))
            {
                self.expect(TokenKind::Ident);
                if (self.match(TokenKind::As))
                {
                    self.expect(TokenKind::Ident);
                }
                while (self.match(TokenKind::Comma))
                {
                    if (self.check(TokenKind::RBrace)) break;
                    if (self.match(TokenKind::Star))
                    {
                        break;
                    }
                    self.expect(TokenKind::Ident);
                    if (self.match(TokenKind::As))
                    {
                        self.expect(TokenKind::Ident);
                    }
                }
            }
            self.expect(TokenKind::RBrace);
        }
        self.match(TokenKind::Semicolon);
        return self.allocNode();
    }

    NodeId parseModReexport()
    {
        self.expect(TokenKind::Mod);
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::Equal);
        self.expect(TokenKind::Import);
        if (self.match(TokenKind::LParen))
        {
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::RParen);
        }
        if (self.check(TokenKind::String))
        {
            self.advance();
        }
        else
        {
            self.expect(TokenKind::Ident);
            while (self.match(TokenKind::ColonColon))
            {
                self.expect(TokenKind::Ident);
            }
        }
        self.match(TokenKind::Semicolon);
        return self.allocNode();
    }

    NodeId parseComptimeDecl()
    {
        self.expect(TokenKind::Comptime);
        self.expect(TokenKind::LBrace);
        while (!self.check(TokenKind::RBrace) && !self.atEnd())
        {
            self.parseDecl();
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }
}
