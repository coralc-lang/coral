/* parser/decl.crl — declaration parsing */
mod diagnostics = import "../coral-diagnostics/code";

mod base = import "base";
mod node_ast = import "../coral-ast/node";
mod decl_ast = import "../coral-ast/decl";
mod types_ast = import "../coral-ast/types";
mod parser = import "parser";
mod context = import "../coral-context/context";
mod token = import "../coral-common/token";
mod id = import "../coral-ast/id";

import diagnostics { ErrorCode };
import base { Parser, ParserMark };
import parser { Parser };
import context { AstContext, InternEntry, NodeListBuilder, StrListBuilder, TyListBuilder, VariantListBuilder };
import token { Token, TokenKind };
import id { NodeId, Str };
import decl_ast { Decl, DeclKind, Param, Field, GenericParam, EnumVariant, VariantVariant, ImportSymbol };
import node_ast { Node, NodeKind };
import types_ast { Ty, TypeEntry, TypeKind };

extern("C") rawptr malloc(usize size);
extern("C") rawptr realloc(rawptr ptr, usize size);

struct ImportSymList
{
    ImportSymbol* items;
    u32 len;
    u32 cap;
}

pub extend Parser
{
    NodeId storeDecl(DeclKind kind)
    {
        Decl d;
        d.kind = kind;
        d.loc = self.tokenLoc(self.previous);
        d.attrs = null;
        d.attrsLen = 0;
        return self.storeNode(NodeKind::Decl{ .value = d });
    }

    NodeId storeParam(Param value)
    {
        value.loc = self.tokenLoc(self.previous);
        return self.storeNode(NodeKind::Param{ .value = value });
    }

    NodeId storeField(Field value)
    {
        value.loc = self.tokenLoc(self.previous);
        return self.storeNode(NodeKind::Field{ .value = value });
    }

    /* `#[[name(args), …]]*` — one or more attribute lists.
     * Returns flags: bit0 = carries `const`. Shared by decl, method and
     * struct/union member parsing so every position accepts attributes. */
    u8 parseAttrList()
    {
        u8 flags = 0;
        while (self.match(TokenKind::Hash))
        {
            self.expect(TokenKind::LBracket);
            self.expect(TokenKind::LBracket);
            if (!self.atEnd() && self.current.kind != TokenKind::RBracket)
            {
                if (self.current.kind == TokenKind::Const) flags = flags | 1;
                self.advance();
            }
            if (self.current.kind == TokenKind::LParen)
            {
                self.advance();
                while (self.current.kind != TokenKind::RParen && !self.atEnd())
                    self.advance();
                self.expect(TokenKind::RParen);
            }
            while (self.match(TokenKind::Comma))
            {
                if (!self.atEnd() && self.current.kind != TokenKind::RBracket)
                {
                    if (self.current.kind == TokenKind::Const) flags = flags | 1;
                    self.advance();
                }
                if (self.current.kind == TokenKind::LParen)
                {
                    self.advance();
                    while (self.current.kind != TokenKind::RParen && !self.atEnd())
                        self.advance();
                    self.expect(TokenKind::RParen);
                }
            }
            self.expect(TokenKind::RBracket);
            self.expect(TokenKind::RBracket);
        }
        return flags;
    }

    NodeId parseDecl()
    {
        u8 attrFlags = self.parseAttrList();
        bool isConst = (attrFlags & 1) != 0;
        bool isPub = self.match(TokenKind::Pub);
        bool isExtern = self.match(TokenKind::Extern);
        if (isExtern && self.current.kind == TokenKind::LParen)
        {
            self.advance();
            self.expect(TokenKind::String);
            self.expect(TokenKind::RParen);
        }
        bool isStatic = self.match(TokenKind::Static);

        switch (self.current.kind)
        {
            /* `struct(...) fn name(...)` is a function returning a tuple —
             * only a bare `struct` starts a struct declaration */
            TokenKind::Struct => {
                ParserMark m = self.save();
                self.advance();
                bool tupleRet = self.current.kind == TokenKind::LParen;
                self.restore(m);
                if (!tupleRet) return self.parseStructDecl(isPub);
            },
            TokenKind::Enum => { return self.parseEnumDecl(isPub); },
            TokenKind::Variant => { return self.parseVariantDecl(isPub); },
            TokenKind::Union => { return self.parseUnionDecl(isPub); },
            TokenKind::Trait => { return self.parseTraitDecl(isPub); },
            TokenKind::Extend => { return self.parseExtendDecl(isPub); },
            TokenKind::Const => { return self.parseConstDecl(isPub); },
            TokenKind::Var => { return self.parseVarDecl(isPub); },
            TokenKind::Typedef => { return self.parseTypedefDecl(); },
            TokenKind::Distinct => { return self.parseDistinctDecl(); },
            TokenKind::Flag => { return self.parseFlagDecl(); },
            TokenKind::Import => { return self.parseImportDecl(); },
            TokenKind::Mod => { return self.parseModReexport(isPub); },
            TokenKind::Comptime => { return self.parseComptimeDecl(); },
            else => {}
        }

        if (isExtern || isStatic || self.isTypeStart())
            return self.parseFuncOrVarDecl(isPub, isExtern, isStatic, isConst);

        self.reportCurrentError(ErrorCode::ParseExpectedDecl, "expected a declaration: a function, var, const, struct or a type");
        if (!self.atEnd()) self.advance();
        return self.noneNode();
    }

    bool isTypeStart()
    {
        TokenKind k = self.current.kind;
        switch (k)
        {
            TokenKind::Void => { return true; },
            TokenKind::Bool => { return true; },
            TokenKind::Char => { return true; },
            TokenKind::U8 => { return true; },
            TokenKind::I8 => { return true; },
            TokenKind::U16 => { return true; },
            TokenKind::I16 => { return true; },
            TokenKind::U32 => { return true; },
            TokenKind::I32 => { return true; },
            TokenKind::U64 => { return true; },
            TokenKind::I64 => { return true; },
            TokenKind::U128 => { return true; },
            TokenKind::I128 => { return true; },
            TokenKind::F32 => { return true; },
            TokenKind::F64 => { return true; },
            TokenKind::Usize => { return true; },
            TokenKind::Isize => { return true; },
            TokenKind::Rawptr => { return true; },
            TokenKind::Str => { return true; },
            TokenKind::Ident => { return true; },
            TokenKind::Const => { return true; },
            TokenKind::Comptime => { return true; },
            TokenKind::Flag => { return true; },
            TokenKind::LParen => { return true; },
            TokenKind::Struct => { return true; },
            else => { return false; }
        }
    }

    void rebindTypeParams(Ty ty, NodeId* genericValues, u32 genericCount)
    {
        if (ty == 0 || genericCount == 0) return;
        TypeEntry* entry = self.ctx.types + ty;
        if (entry->kind.tag == TypeKind::Named)
        {
            Str nm = entry->kind.payload.Named.name;
            u32 g = 0;
            while (g < genericCount)
            {
                Node* gn = self.ctx.nodes + genericValues[g].index;
                if (gn->kind.tag == NodeKind::GenericParam)
                {
                    if (gn->kind.payload.GenericParam.value.name == nm)
                    {
                        entry->kind = TypeKind::TypeParam { .name = nm, .index = g };
                        return;
                    }
                }
                g = g + 1;
            }
            u32 i = 0;
            while (i < entry->kind.payload.Named.genericArgsLen)
            {
                self.rebindTypeParams(entry->kind.payload.Named.genericArgs[i], genericValues, genericCount);
                i = i + 1;
            }
            return;
        }
        if (entry->kind.tag == TypeKind::Pointer) {
            self.rebindTypeParams(entry->kind.payload.Pointer.base, genericValues, genericCount);
            return;
        }
        if (entry->kind.tag == TypeKind::Const) {
            self.rebindTypeParams(entry->kind.payload.Const.base, genericValues, genericCount);
            return;
        }
        if (entry->kind.tag == TypeKind::Comptime) {
            self.rebindTypeParams(entry->kind.payload.Comptime.base, genericValues, genericCount);
            return;
        }
        if (entry->kind.tag == TypeKind::Slice) {
            self.rebindTypeParams(entry->kind.payload.Slice.base, genericValues, genericCount);
            return;
        }
        if (entry->kind.tag == TypeKind::Array) {
            self.rebindTypeParams(entry->kind.payload.Array.base, genericValues, genericCount);
            return;
        }
        if (entry->kind.tag == TypeKind::FnPtr) {
            self.rebindTypeParams(entry->kind.payload.FnPtr.returnType, genericValues, genericCount);
            u32 p = 0;
            while (p < entry->kind.payload.FnPtr.paramsLen)
            {
                self.rebindTypeParams(entry->kind.payload.FnPtr.params[p], genericValues, genericCount);
                p = p + 1;
            }
            return;
        }
        if (entry->kind.tag == TypeKind::Tuple) {
            u32 e = 0;
            while (e < entry->kind.payload.Tuple.elemsLen)
            {
                self.rebindTypeParams(entry->kind.payload.Tuple.elems[e], genericValues, genericCount);
                e = e + 1;
            }
            return;
        }
    }

    NodeId parseFuncOrVarDecl(bool isPub, bool isExtern, bool isStatic, bool isConst)
    {
        Ty retType = self.parseType();
        /* `u8 const NAME = …` — type-first constant; `const u8 NAME` is
         * routed to parseConstDecl before we ever get here */
        if (self.match(TokenKind::Const)) isConst = true;
        Token nameTok = self.expectName();
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        NodeListBuilder genericParams;
        self.ctx.nodeListInit(&genericParams);
        
        if (self.current.kind == TokenKind::Less)
            self.parseGenericParams(&genericParams);
        u32 genericCount = genericParams.len;
        NodeId* genericValues = self.ctx.nodeListFinish(&genericParams);
        self.rebindTypeParams(retType, genericValues, genericCount);
        self.rebindTypeParams(retType, self.outerGenerics, self.outerGenericsLen);
        u8 flags = 0;
        
        if (isPub) flags = flags | 1;
        if (isExtern) flags = flags | 2;
        if (isStatic) flags = flags | 4;
        if (isConst) flags = flags | 16;
        if (self.current.kind == TokenKind::LParen) {
            self.advance();
            NodeListBuilder params;
            self.ctx.nodeListInit(&params);
            if (self.current.kind != TokenKind::RParen)
            {
                NodeId param = self.parseParam();
                if (!self.ctx.nodeListAppend(&params, param)) self.reportAllocFailed();
                while (self.match(TokenKind::Comma))
                {
                    param = self.parseParam();
                    if (!self.ctx.nodeListAppend(&params, param)) self.reportAllocFailed();
                }
            }
            self.expect(TokenKind::RParen);
            /* `const` qualifier after the parameter list — const method */
            if (self.match(TokenKind::Const)) flags = flags | 16;
            u32 paramCount = params.len;
            NodeId* paramValues = self.ctx.nodeListFinish(&params);
            u32 pi = 0;
            while (pi < paramCount)
            {
                Node* pn = self.ctx.nodes + paramValues[pi].index;
                if (pn->kind.tag == NodeKind::Param)
                {
                    self.rebindTypeParams(pn->kind.payload.Param.value.typeNode, genericValues, genericCount);
                    self.rebindTypeParams(pn->kind.payload.Param.value.typeNode, self.outerGenerics, self.outerGenericsLen);
                }
                pi = pi + 1;
            }
            NodeId body = self.noneNode();
            if (!self.match(TokenKind::Semicolon)) {
                body = self.parseBlock();
                flags = flags | 8;
            }
            return self.storeDecl(DeclKind::Func{ .name = name, .genericParams = genericValues, .genericParamsLen = genericCount, .params = paramValues, .paramsLen = paramCount, .returnType = retType, .body = body, .flags = flags });
        }
        NodeId value = self.noneNode();
        Ty varType = self.parseDeclaratorArray(retType);
        if (self.match(TokenKind::Equal)) {
            value = self.parseExpr();
            self.expect(TokenKind::Semicolon);
        } else {
            self.expect(TokenKind::Semicolon);
        }
        return self.storeDecl(DeclKind::Constant{ .name = name, .typeNode = varType, .value = value, .flags = flags });
    }

    NodeId parseGenericParam()
    {
        GenericParam param;
        param.bounds = null;
        param.boundsLen = 0;
        param.flags = 0;
        if (self.match(TokenKind::Comptime)) param.flags = param.flags | 1;
        Token nameTok = self.expectName();
        param.name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        return self.storeNode(NodeKind::GenericParam{ .value = param });
    }

    void parseGenericParams(NodeListBuilder* params)
    {
        self.expect(TokenKind::Less);
        if (self.consumeGreater()) return;
        while (true)
        {
            NodeId param = self.parseGenericParam();
            if (!self.ctx.nodeListAppend(params, param)) self.reportAllocFailed();
            if (!self.match(TokenKind::Comma)) break;
        }
        if (!self.consumeGreater()) self.reportCurrentError(ErrorCode::ParseExpectedToken, "expected '>' to close generic parameters");
    }

    NodeId parseFuncDecl()
    {
        return self.parseFuncDeclFlags(0);
    }

    /* attrs already consumed by a member loop get folded in here */
    NodeId parseFuncDeclFlags(u8 attrFlags)
    {
        attrFlags = attrFlags | self.parseAttrList();
        bool isConst = (attrFlags & 1) != 0;
        return self.parseFuncOrVarDecl(false, false, false, isConst);
    }

    NodeId parseParam()
    {
        Param param;
        param.loc.data = 0;
        param.flags = 0;
        if (self.current.kind == TokenKind::Self)
        {
            self.advance();
            param.name = self.ctx.intern("self", 4);
            param.typeNode = 0;
            param.flags = 1;
            return self.storeParam(param);
        }
        if (self.current.kind == TokenKind::Ellipsis)
        {
            self.advance();
            param.name = 0;
            param.typeNode = 0;
            param.flags = 16;
            /* `... args` — named variadic package */
            if (self.current.kind == TokenKind::Ident)
            {
                Token varTok = self.advance();
                param.name = self.ctx.intern(varTok.data.ptr, varTok.data.len);
            }
            return self.storeParam(param);
        }
        param.typeNode = self.parseType();
        /* `self`, `self*`, `const self*` — explicit self parameter (the
         * receiver is a pointer in the C implementation) */
        {
            Ty resolved = param.typeNode;
            TypeEntry* typeEntry = (resolved != 0) ? self.ctx.types + resolved : null;
            while (typeEntry != null && (typeEntry->kind.tag == TypeKind::Const || typeEntry->kind.tag == TypeKind::Pointer))
            {
                if (typeEntry->kind.tag == TypeKind::Const) resolved = typeEntry->kind.payload.Const.base;
                else resolved = typeEntry->kind.payload.Pointer.base;
                if (resolved == 0) break;
                typeEntry = self.ctx.types + resolved;
            }
            if (typeEntry != null && typeEntry->kind.tag == TypeKind::Named &&
                typeEntry->kind.payload.Named.name == self.ctx.intern((u8*)"self", 4))
            {
                param.name = self.ctx.intern((u8*)"self", 4);
                param.flags = 1;
                return self.storeParam(param);
            }
        }
        if (self.current.kind == TokenKind::Comma || self.current.kind == TokenKind::RParen)
        {
            param.name = 0;
            param.flags = 8;
            if (param.typeNode != 0)
            {
                Ty resolved = param.typeNode;
                TypeEntry* typeEntry = self.ctx.types + resolved;
                while (typeEntry != null && typeEntry->kind.tag == TypeKind::Const)
                {
                    resolved = typeEntry->kind.payload.Const.base;
                    if (resolved == 0) break;
                    typeEntry = self.ctx.types + resolved;
                }
                if (typeEntry != null && typeEntry->kind.tag == TypeKind::Comptime)
                {
                    Ty base = typeEntry->kind.payload.Comptime.base;
                    typeEntry = base != 0 ? self.ctx.types + base : null;
                }
                if (typeEntry != null && typeEntry->kind.tag == TypeKind::Named)
                    param.name = typeEntry->kind.payload.Named.name;
            }
            return self.storeParam(param);
        }
        Token name = self.expectName();
        param.name = self.ctx.intern(name.data.ptr, name.data.len);
        return self.storeParam(param);
    }

    NodeId parseStructDecl(bool isPub)
    {
        self.expect(TokenKind::Struct);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        NodeListBuilder genericParams;
        self.ctx.nodeListInit(&genericParams);
        if (self.current.kind == TokenKind::Less)
            self.parseGenericParams(&genericParams);
        u32 genericCount = genericParams.len;
        NodeId* genericValues = self.ctx.nodeListFinish(&genericParams);
        self.outerGenerics = genericValues;
        self.outerGenericsLen = genericCount;
        NodeListBuilder fields;
        NodeListBuilder methods;
        self.ctx.nodeListInit(&fields);
        self.ctx.nodeListInit(&methods);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            u8 memberAttrs = self.parseAttrList();
            u8 fieldFlags = 0;
            if (self.match(TokenKind::Pub)) fieldFlags = 1;
            if (self.current.kind == TokenKind::Extern || self.current.kind == TokenKind::Static)
            {
                bool mIsExtern = self.match(TokenKind::Extern);
                if (mIsExtern && self.current.kind == TokenKind::LParen)
                {
                    self.advance();
                    self.expect(TokenKind::String);
                    self.expect(TokenKind::RParen);
                }
                bool mIsStatic = self.match(TokenKind::Static);
                NodeId method = self.parseFuncOrVarDecl(fieldFlags == 1, mIsExtern, mIsStatic, (memberAttrs & 1) != 0);
                if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
                continue;
            }

            ParserMark mark = self.save();
            self.parseType();
            self.expect(TokenKind::Ident);
            bool isMethod = self.current.kind == TokenKind::LParen ||
                            self.current.kind == TokenKind::Less;
            self.restore(mark);

            if (isMethod)
            {
                NodeId method = self.parseFuncDeclFlags(memberAttrs);
                if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
                continue;
            }

            Ty fieldType = self.parseType();
            Token fieldNameTok = self.expect(TokenKind::Ident);
            fieldType = self.parseDeclaratorArray(fieldType);
            Field field;
            field.name = self.ctx.intern(fieldNameTok.data.ptr, fieldNameTok.data.len);
            field.typeNode = fieldType;
            field.defaultValue = self.noneNode();
            field.loc.data = 0;
            field.flags = fieldFlags;
            if (self.match(TokenKind::Equal))
            {
                field.defaultValue = self.parseExpr();
                field.flags = field.flags | 2;
            }
            NodeId fieldNode = self.storeField(field);
            if (!self.ctx.nodeListAppend(&fields, fieldNode)) self.reportAllocFailed();
            self.match(TokenKind::Comma);
            self.match(TokenKind::Semicolon);
        }
        self.expect(TokenKind::RBrace);
        self.outerGenerics = null;
        self.outerGenericsLen = 0;
        u32 fieldCount = fields.len;
        NodeId* fieldValues = self.ctx.nodeListFinish(&fields);
        u32 methodCount = methods.len;
        NodeId* methodValues = self.ctx.nodeListFinish(&methods);
        u8 flags = 0;
        if (isPub) flags = 1;
        return self.storeDecl(DeclKind::Struct{ .name = name, .genericParams = genericValues, .genericParamsLen = genericCount, .fields = fieldValues, .fieldsLen = fieldCount, .methods = methodValues, .methodsLen = methodCount, .flags = flags });
    }

    NodeId parseEnumDecl(bool isPub)
    {
        self.expect(TokenKind::Enum);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        Ty backingType = 0;
        u8 flags = 0;
        if (self.match(TokenKind::Colon))
        {
            backingType = self.parseType();
            flags = 1;
        }
        if (isPub) flags = flags | 2;
        NodeListBuilder variants;
        self.ctx.nodeListInit(&variants);
        self.expect(TokenKind::LBrace);
        if (self.current.kind != TokenKind::RBrace)
        {
            while (true)
            {
                EnumVariant enumValue;
                Token variantTok = self.expect(TokenKind::Ident);
                enumValue.name = self.ctx.intern(variantTok.data.ptr, variantTok.data.len);
                enumValue.value = self.noneNode();
                enumValue.loc.data = 0;
                enumValue.flags = 0;
                if (self.match(TokenKind::Equal))
                {
                    enumValue.value = self.parseExpr();
                    enumValue.flags = 1;
                }
                NodeId variantNode = self.storeNode(NodeKind::EnumVariant{ .value = enumValue });
                if (!self.ctx.nodeListAppend(&variants, variantNode)) self.reportAllocFailed();
                if (!self.match(TokenKind::Comma)) break;
                if (self.current.kind == TokenKind::RBrace) break;
            }
        }
        self.expect(TokenKind::RBrace);
        u32 variantCount = variants.len;
        NodeId* variantValues = self.ctx.nodeListFinish(&variants);
        return self.storeDecl(DeclKind::Enum{ .name = name, .backingType = backingType, .variants = variantValues, .variantsLen = variantCount, .flags = flags });
    }

    NodeId parseVariantDecl(bool isPub)
    {
        self.expect(TokenKind::Variant);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        NodeListBuilder genericParams;
        self.ctx.nodeListInit(&genericParams);
        if (self.current.kind == TokenKind::Less)
            self.parseGenericParams(&genericParams);
        u32 genericCount = genericParams.len;
        NodeId* genericValues = self.ctx.nodeListFinish(&genericParams);
        self.outerGenerics = genericValues;
        self.outerGenericsLen = genericCount;
        VariantListBuilder variants;
        NodeListBuilder methods;
        self.ctx.variantListInit(&variants);
        self.ctx.nodeListInit(&methods);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            if (self.current.kind == TokenKind::Pub)
            {
                self.advance();
                NodeId method = self.parseFuncDecl();
                if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
                continue;
            }
            Token variantTok = self.expect(TokenKind::Ident);
            VariantVariant variantValue;
            variantValue.name = self.ctx.intern(variantTok.data.ptr, variantTok.data.len);
            variantValue.fieldNames = null;
            variantValue.fieldTypes = null;
            variantValue.fieldsLen = 0;
            variantValue.loc.data = 0;
            if (self.current.kind == TokenKind::LBrace)
            {
                self.advance();
                StrListBuilder fieldNames;
                TyListBuilder fieldTypes;
                self.ctx.strListInit(&fieldNames);
                self.ctx.tyListInit(&fieldTypes);
                while (self.current.kind != TokenKind::RBrace && !self.atEnd())
                {
                    Ty fieldType = self.parseType();
                    Token fieldTok = self.expect(TokenKind::Ident);
                    Str fieldName = self.ctx.intern(fieldTok.data.ptr, fieldTok.data.len);
                    if (!self.ctx.tyListAppend(&fieldTypes, fieldType)) self.reportAllocFailed();
                    if (!self.ctx.strListAppend(&fieldNames, fieldName)) self.reportAllocFailed();
                    if (!self.match(TokenKind::Comma) && !self.match(TokenKind::Semicolon)) break;
                }
                self.expect(TokenKind::RBrace);
                variantValue.fieldsLen = fieldNames.len;
                variantValue.fieldNames = self.ctx.strListFinish(&fieldNames);
                variantValue.fieldTypes = self.ctx.tyListFinish(&fieldTypes);
            }
            if (!self.ctx.variantListAppend(&variants, variantValue)) self.reportAllocFailed();
            self.match(TokenKind::Comma);
        }
        self.expect(TokenKind::RBrace);
        self.outerGenerics = null;
        self.outerGenericsLen = 0;
        u32 variantCount = variants.len;
        VariantVariant* variantValues = self.ctx.variantListFinish(&variants);
        u32 methodCount = methods.len;
        NodeId* methodValues = self.ctx.nodeListFinish(&methods);
        u8 flags = 0;
        if (isPub) flags = 1;
        return self.storeDecl(DeclKind::Variant{ .name = name, .genericParams = genericValues, .genericParamsLen = genericCount, .variants = variantValues, .variantsLen = variantCount, .methods = methodValues, .methodsLen = methodCount, .flags = flags });
    }

    NodeId parseUnionDecl(bool isPub)
    {
        self.expect(TokenKind::Union);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        NodeListBuilder genericParams;
        self.ctx.nodeListInit(&genericParams);
        if (self.current.kind == TokenKind::Less)
            self.parseGenericParams(&genericParams);
        u32 genericCount = genericParams.len;
        NodeId* genericValues = self.ctx.nodeListFinish(&genericParams);
        self.outerGenerics = genericValues;
        self.outerGenericsLen = genericCount;
        NodeListBuilder fields;
        NodeListBuilder methods;
        self.ctx.nodeListInit(&fields);
        self.ctx.nodeListInit(&methods);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            u8 memberAttrs = self.parseAttrList();
            u8 fieldFlags = 0;
            if (self.match(TokenKind::Pub)) fieldFlags = 1;
            if (self.current.kind == TokenKind::Extern || self.current.kind == TokenKind::Static)
            {
                bool mIsExtern = self.match(TokenKind::Extern);
                if (mIsExtern && self.current.kind == TokenKind::LParen)
                {
                    self.advance();
                    self.expect(TokenKind::String);
                    self.expect(TokenKind::RParen);
                }
                bool mIsStatic = self.match(TokenKind::Static);
                NodeId method = self.parseFuncOrVarDecl(fieldFlags == 1, mIsExtern, mIsStatic, (memberAttrs & 1) != 0);
                if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
                continue;
            }
            ParserMark mark = self.save();
            self.parseType();
            self.expect(TokenKind::Ident);
            bool isMethod = self.current.kind == TokenKind::LParen ||
                            self.current.kind == TokenKind::Less;
            self.restore(mark);
            if (isMethod)
            {
                NodeId method = self.parseFuncDeclFlags(memberAttrs);
                if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
                continue;
            }
            Ty fieldType = self.parseType();
            Token fieldTok = self.expect(TokenKind::Ident);
            Field field;
            field.name = self.ctx.intern(fieldTok.data.ptr, fieldTok.data.len);
            field.typeNode = fieldType;
            field.defaultValue = self.noneNode();
            field.loc.data = 0;
            field.flags = fieldFlags;
            NodeId fieldNode = self.storeField(field);
            if (!self.ctx.nodeListAppend(&fields, fieldNode)) self.reportAllocFailed();
            self.match(TokenKind::Comma);
            self.match(TokenKind::Semicolon);
        }
        self.expect(TokenKind::RBrace);
        self.outerGenerics = null;
        self.outerGenericsLen = 0;
        u32 fieldCount = fields.len;
        NodeId* fieldValues = self.ctx.nodeListFinish(&fields);
        u32 methodCount = methods.len;
        NodeId* methodValues = self.ctx.nodeListFinish(&methods);
        u8 flags = 0;
        if (isPub) flags = 1;
        return self.storeDecl(DeclKind::Union{ .name = name, .genericParams = genericValues, .genericParamsLen = genericCount, .fields = fieldValues, .fieldsLen = fieldCount, .methods = methodValues, .methodsLen = methodCount, .flags = flags });
    }

    NodeId parseTraitDecl(bool isPub)
    {
        self.expect(TokenKind::Trait);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        NodeListBuilder genericParams;
        self.ctx.nodeListInit(&genericParams);
        if (self.current.kind == TokenKind::Less)
            self.parseGenericParams(&genericParams);
        u32 genericCount = genericParams.len;
        NodeId* genericValues = self.ctx.nodeListFinish(&genericParams);
        self.outerGenerics = genericValues;
        self.outerGenericsLen = genericCount;
        NodeListBuilder methods;
        self.ctx.nodeListInit(&methods);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            NodeId method;
            if (self.current.kind == TokenKind::Extern || self.current.kind == TokenKind::Static)
            {
                bool mIsExtern = self.match(TokenKind::Extern);
                if (mIsExtern && self.current.kind == TokenKind::LParen)
                {
                    self.advance();
                    self.expect(TokenKind::String);
                    self.expect(TokenKind::RParen);
                }
                bool mIsStatic = self.match(TokenKind::Static);
                method = self.parseFuncOrVarDecl(false, mIsExtern, mIsStatic, false);
            }
            else
            {
                method = self.parseFuncDecl();
            }
            if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
        }
        self.expect(TokenKind::RBrace);
        self.outerGenerics = null;
        self.outerGenericsLen = 0;
        u32 methodCount = methods.len;
        NodeId* methodValues = self.ctx.nodeListFinish(&methods);
        u8 flags = 0;
        if (isPub) flags = 1;
        return self.storeDecl(DeclKind::Trait{ .name = name, .genericParams = genericValues, .genericParamsLen = genericCount, .methods = methodValues, .methodsLen = methodCount, .flags = flags });
    }

    NodeId parseExtendDecl(bool isPub)
    {
        self.expect(TokenKind::Extend);
        NodeListBuilder genParams;
        self.ctx.nodeListInit(&genParams);
        if (self.current.kind == TokenKind::Less)
            self.parseGenericParams(&genParams);
        u32 genericCount = genParams.len;
        NodeId* genericValues = self.ctx.nodeListFinish(&genParams);
        self.outerGenerics = genericValues;
        self.outerGenericsLen = genericCount;
        Ty selfType = self.parseType();
        self.rebindTypeParams(selfType, genericValues, genericCount);
        Str traitName = 0;
        if (self.match(TokenKind::Colon))
        {
            /* builtin traits are spelled `@name` (`@drop`, `@toStr`, …);
             * keep the `@` so they stay distinct from user traits */
            bool atMark = self.match(TokenKind::At);
            Token traitTok = self.expect(TokenKind::Ident);
            if (atMark)
            {
                u8* buf = (u8*)malloc(traitTok.data.len + 1);
                if (buf != null)
                {
                    buf[0] = '@';
                    u32 i = 0;
                    while (i < traitTok.data.len) { buf[i + 1] = traitTok.data.ptr[i]; i = i + 1; }
                    /* intern keeps the pointer — the buffer lives as long as the context */
                    if (!self.ctx.track((rawptr)buf)) self.reportAllocFailed();
                    traitName = self.ctx.intern(buf, traitTok.data.len + 1);
                }
            }
            else {
                traitName = self.ctx.intern(traitTok.data.ptr, traitTok.data.len);
            }
        }
        NodeListBuilder methods;
        self.ctx.nodeListInit(&methods);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            NodeId method;
            if (self.current.kind == TokenKind::Extern || self.current.kind == TokenKind::Static)
            {
                bool mIsExtern = self.match(TokenKind::Extern);
                if (mIsExtern && self.current.kind == TokenKind::LParen)
                {
                    self.advance();
                    self.expect(TokenKind::String);
                    self.expect(TokenKind::RParen);
                }
                bool mIsStatic = self.match(TokenKind::Static);
                method = self.parseFuncOrVarDecl(false, mIsExtern, mIsStatic, false);
            }
            else
            {
                method = self.parseFuncDecl();
            }
            if (!self.ctx.nodeListAppend(&methods, method)) self.reportAllocFailed();
        }
        self.expect(TokenKind::RBrace);
        self.outerGenerics = null;
        self.outerGenericsLen = 0;
        u32 methodCount = methods.len;
        NodeId* methodValues = self.ctx.nodeListFinish(&methods);
        if (traitName != 0)
            return self.storeDecl(DeclKind::ExtendTrait{ .selfType = selfType, .traitName = traitName, .genericParams = genericValues, .genericParamsLen = genericCount, .methods = methodValues, .methodsLen = methodCount });
        return self.storeDecl(DeclKind::Extend{ .selfType = selfType, .genericParams = genericValues, .genericParamsLen = genericCount, .methods = methodValues, .methodsLen = methodCount });
    }

    NodeId parseConstDecl(bool isPub)
    {
        self.expect(TokenKind::Const);
        Ty typeNode = self.parseType();
        Str nameId = 0;
        if (self.current.kind == TokenKind::Equal)
        {
            /* untyped constant: `const NAME = value;` — what parseType
             * consumed was actually the constant's name */
            if (typeNode != 0)
            {
                TypeEntry* te = self.ctx.types + typeNode;
                if (te->kind.tag == TypeKind::Named && te->kind.payload.Named.genericArgsLen == 0)
                    nameId = te->kind.payload.Named.name;
            }
            typeNode = 0;
        }
        else
        {
            Token name = self.expectName();
            if (typeNode != 0) typeNode = self.parseDeclaratorArray(typeNode);
            nameId = self.ctx.intern(name.data.ptr, name.data.len);
        }
        if (nameId == 0) self.reportCurrentError(ErrorCode::ParseExpectedToken, "expected a constant name");
        self.expect(TokenKind::Equal);
        NodeId value = self.parseInitExpr();
        self.expect(TokenKind::Semicolon);
        /* flags: 1 = pub, 16 = const (see parseFuncOrVarDecl) */
        u8 cflags = 16;
        if (isPub) cflags = cflags | 1;
        return self.storeDecl(DeclKind::Constant{ .name = nameId, .typeNode = typeNode, .value = value, .flags = cflags });
    }

    /* `var NAME = expr;` (inferred storage) and `var T NAME [N] [= expr];`
     * (typed storage) at file scope. */
    NodeId parseVarDecl(bool isPub)
    {
        self.expect(TokenKind::Var);
        Ty ty = 0;
        bool typed = false;
        if (self.isTypeStart())
        {
            ParserMark m = self.save();
            Ty parsed = self.parseType();
            if (self.current.kind == TokenKind::Ident)
            {
                /* a name follows the type: `var i32 x = …` */
                typed = true;
                ty = parsed;
                self.endSpeculation();
            }
            else self.restore(m);
        }
        Token nameTok = self.expectName();
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        if (typed) ty = self.parseDeclaratorArray(ty);
        NodeId value = self.noneNode();
        if (self.match(TokenKind::Equal)) value = self.parseExpr();
        self.expect(TokenKind::Semicolon);
        u8 flags = isPub ? 1 : 0;
        return self.storeDecl(DeclKind::Constant{ .name = name, .typeNode = ty, .value = value, .flags = flags });
    }

    NodeId parseTypedefDecl()
    {
        self.expect(TokenKind::Typedef);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        self.expect(TokenKind::Equal);
        Ty target = self.parseType();
        self.expect(TokenKind::Semicolon);
        return self.storeDecl(DeclKind::TypeAlias{ .name = name, .target = target, .flags = 0 });
    }

    NodeId parseDistinctDecl()
    {
        self.expect(TokenKind::Distinct);
        Token nameTok = self.expect(TokenKind::Ident);
        Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
        self.expect(TokenKind::Equal);
        Ty base = 0;
        if (self.current.kind == TokenKind::Flag) base = self.parseFlagType();
        else base = self.parseType();
        self.expect(TokenKind::Semicolon);
        return self.storeDecl(DeclKind::Distinct{ .name = name, .baseType = base, .flags = 0 });
    }

    /* `flag (NAME) { <key> => { T }, ..., else => { T } }` — a type that
     * is selected by matching NAME's value against the host. Picked branch
     * is the distinct alias' base type. For tidiness we use the compiler's
     * ARM key lookup compares against `ctx->targetArch` (driver-configured; currently defaults to "x86_64"; later it comes from the build manifest's `platform_root`). The `else` arm is the fallback. */
    Ty parseFlagType()
    {
        self.advance(); /* flag */
        self.expect(TokenKind::LParen);
        Token nameTokStmt = self.expect(TokenKind::Ident);
        Str nameStrFor = self.ctx.intern(nameTokStmt.data.ptr, nameTokStmt.data.len);
        self.expect(TokenKind::RParen);
        self.expect(TokenKind::LBrace);

        Ty selected = 0;
        Ty selectedArmElse = 0;
        while (!self.atEnd() && self.current.kind != TokenKind::RBrace)
        {
            bool isElse = false;
            bool isHost = false;
            if (self.match(TokenKind::Else))
            {
                isElse = true;
            }
            else
            {
                Token keyTok = self.expect(TokenKind::Ident);
                /* arm selected when the build-time flag (flag name is
                 * the param of `flag (NAME)`)'s value equals this key; the
                 * 'else' arm is the fallback when no match is found. */
                bool isMatch = false;
                if (self.ctx != null)
                {
                    Str keyStr = self.ctx.intern(keyTok.data.ptr, keyTok.data.len);
                    Str anm = nameStrFor; /* filled in at top of parseFlagType */
                    u32 f1 = 0;
                    while (f1 < self.ctx->flagsLen)
                    {
                        if (self.ctx->flagNames[f1] == anm &&
                            self.ctx->flagValues[f1] == keyStr) isMatch = true;
                        f1 = f1 + 1;
                    }
                }
                if (isMatch) isHost = true;
            }
            self.expect(TokenKind::FatArrow);
            Ty armTy = 0;
            if (self.match(TokenKind::LBrace))
            {
                armTy = self.parseType();
                self.expect(TokenKind::RBrace);
            }
            else armTy = self.parseType();
            if (isHost) selected = armTy;
            else if (isElse) selectedArmElse = armTy;
            if (!self.match(TokenKind::Comma)) break;
        }
        self.expect(TokenKind::RBrace);
        Ty r = selected != 0 ? selected : selectedArmElse;
        return r;
    }

    NodeId parseFlagDecl()
    {
        self.expect(TokenKind::Flag);
        self.expect(TokenKind::LParen);
        self.expect(TokenKind::Ident);
        self.expect(TokenKind::RParen);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            if (!self.match(TokenKind::Else))
                self.expect(TokenKind::Ident);
            self.expect(TokenKind::FatArrow);
            self.expect(TokenKind::LBrace);
            while (self.current.kind != TokenKind::RBrace && !self.atEnd())
                self.parseStmt();
            self.expect(TokenKind::RBrace);
            self.match(TokenKind::Comma);
        }
        self.expect(TokenKind::RBrace);
        return self.allocNode();
    }

    Str strListJoin(StrListBuilder* parts)
    {
        u32 count = parts->len;
        Str* values = self.ctx.strListFinish(parts);
        if (count == 0 || values == null) return 0;
        if (count == 1) return values[0];
        usize total = 0;
        u32 i = 0;
        while (i < count)
        {
            InternEntry* entry = self.ctx.interns + values[i];
            total = total + entry->len;
            if (i + 1 < count) total = total + 2;
            i = i + 1;
        }
        u8* text = (u8*)malloc(total);
        if (text == null)
        {
            self.reportAllocFailed();
            return 0;
        }
        usize offset = 0;
        i = 0;
        while (i < count)
        {
            InternEntry* entry = self.ctx.interns + values[i];
            usize len = entry->len;
            u8* source = entry->ptr;
            usize j = 0;
            while (j < len)
            {
                text[offset + j] = source[j];
                j = j + 1;
            }
            offset = offset + len;
            if (i + 1 < count)
            {
                text[offset] = ':';
                text[offset + 1] = ':';
                offset = offset + 2;
            }
            i = i + 1;
        }
        Str result = self.ctx.intern(text, total);
        if (!self.ctx.track((rawptr)text)) self.reportAllocFailed();
        return result;
    }

    Str parseNamespacePath()
    {
        StrListBuilder parts;
        self.ctx.strListInit(&parts);
        while (true)
        {
            Token tok = self.expectName();
            Str part = self.ctx.intern(tok.data.ptr, tok.data.len);
            if (!self.ctx.strListAppend(&parts, part))
            {
                self.reportAllocFailed();
                break;
            }
            if (self.current.kind != TokenKind::ColonColon) break;
            ParserMark m = self.save();
            self.advance();
            if (self.current.kind == TokenKind::LBrace)
            {
                self.restore(m);
                break;
            }
            self.endSpeculation();
        }
        return self.strListJoin(&parts);
    }

    bool parseSymbolList(Str prefix, ImportSymList* list)
    {
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
        {
            ImportSymbol value;
            value.name = 0;
            value.alias = 0;
            value.flags = 0;
            if (self.match(TokenKind::Star))
            {
                value.flags = 2;
                if (list->len >= list->cap)
                {
                    u32 newCap = list->cap * 2;
                    if (newCap == 0) newCap = 4;
                    rawptr raw = realloc((rawptr)list->items, (usize)newCap * sizeof(ImportSymbol));
                    if (raw == null)
                    {
                        self.reportAllocFailed();
                        return false;
                    }
                    list->items = (ImportSymbol*)raw;
                    list->cap = newCap;
                }
                list->items[list->len] = value;
                list->len = list->len + 1;
            }
            else
            {
                Token nameTok = self.expectName();
                Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
                if (prefix != 0)
                {
                    StrListBuilder parts;
                    self.ctx.strListInit(&parts);
                    self.ctx.strListAppend(&parts, prefix);
                    self.ctx.strListAppend(&parts, name);
                    name = self.strListJoin(&parts);
                }
                if (self.current.kind == TokenKind::ColonColon)
                {
                    ParserMark m = self.save();
                    self.advance();
                    if (self.current.kind == TokenKind::LBrace)
                    {
                        self.advance();
                        if (!self.parseSymbolList(name, list)) return false;
                        self.expect(TokenKind::RBrace);
                        self.endSpeculation();
                        if (!self.match(TokenKind::Comma)) break;
                        continue;
                    }
                    self.restore(m);
                }
                if (self.current.kind == TokenKind::LBrace)
                {
                    self.advance();
                    if (!self.parseSymbolList(name, list)) return false;
                    self.expect(TokenKind::RBrace);
                }
                else
                {
                    value.name = name;
                    if (self.match(TokenKind::As))
                    {
                        Token aliasTok = self.expectName();
                        value.alias = self.ctx.intern(aliasTok.data.ptr, aliasTok.data.len);
                        value.flags = value.flags | 1;
                    }
                    if (list->len >= list->cap)
                    {
                        u32 newCap = list->cap * 2;
                        if (newCap == 0) newCap = 4;
                        rawptr raw = realloc((rawptr)list->items, (usize)newCap * sizeof(ImportSymbol));
                        if (raw == null)
                        {
                            self.reportAllocFailed();
                            return false;
                        }
                        list->items = (ImportSymbol*)raw;
                        list->cap = newCap;
                    }
                    list->items[list->len] = value;
                    list->len = list->len + 1;
                }
            }
            if (!self.match(TokenKind::Comma)) break;
        }
        return true;
    }

    void parseImportSymbols(rawptr* outSymbols, u32* outLen, Str path)
    {
        *outSymbols = null;
        *outLen = 0;
        Str prefix = 0;
        if (self.current.kind == TokenKind::ColonColon)
        {
            self.advance();
            prefix = path;
            self.expect(TokenKind::LBrace);
        }
        else if (!self.match(TokenKind::LBrace)) return;
        ImportSymList list;
        list.items = null;
        list.len = 0;
        list.cap = 0;
        self.parseSymbolList(prefix, &list);
        self.expect(TokenKind::RBrace);
        if (list.items != null && !self.ctx.track((rawptr)list.items)) self.reportAllocFailed();
        *outSymbols = (rawptr)list.items;
        *outLen = list.len;
    }

    NodeId parseImportDecl()
    {
        self.expect(TokenKind::Import);
        u8 flags = 0;
        if (self.match(TokenKind::LParen))
        {
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::RParen);
            flags = flags | 1;
        }
        Str path = 0;
        if (self.current.kind == TokenKind::String)
        {
            /* `import "std";` — quoted path (token text keeps the quotes) */
            Token ptok = self.advance();
            if (ptok.data.len >= 2)
                path = self.ctx.intern(ptok.data.ptr + 1, ptok.data.len - 2);
            else
                self.reportCurrentError(ErrorCode::ParseExpectedToken, "expected a non-empty import path");
        }
        else path = self.parseNamespacePath();
        ImportSymbol* symbols = null;
        u32 symbolsLen = 0;
        self.parseImportSymbols((rawptr*)&symbols, &symbolsLen, path);
        self.expect(TokenKind::Semicolon);
        return self.storeDecl(DeclKind::Import{ .path = path, .symbols = symbols, .symbolsLen = symbolsLen, .flags = flags });
    }

    NodeId parseModReexport(bool isPub)
    {
        self.expect(TokenKind::Mod);
        Token aliasToken = self.expectName();
        Str alias = self.ctx.intern(aliasToken.data.ptr, aliasToken.data.len);
        self.expect(TokenKind::Equal);
        self.expect(TokenKind::Import);
        u8 flags = 0;
        if (self.match(TokenKind::LParen))
        {
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::RParen);
            flags = flags | 1;
        }
        Str path = 0;
        if (self.current.kind == TokenKind::String)
        {
            /* `import "std";` — quoted path (token text keeps the quotes) */
            Token ptok = self.advance();
            if (ptok.data.len >= 2)
                path = self.ctx.intern(ptok.data.ptr + 1, ptok.data.len - 2);
            else
                self.reportCurrentError(ErrorCode::ParseExpectedToken, "expected a non-empty import path");
        }
        else path = self.parseNamespacePath();
        ImportSymbol* symbols = null;
        u32 symbolsLen = 0;
        self.parseImportSymbols((rawptr*)&symbols, &symbolsLen, path);
        self.expect(TokenKind::Semicolon);
        if (isPub) flags = flags | 2;
        return self.storeDecl(DeclKind::ModReexport{ .alias = alias, .path = path, .symbols = symbols, .symbolsLen = symbolsLen, .flags = flags });
    }

    NodeId parseComptimeDecl()
    {
        self.expect(TokenKind::Comptime);
        self.expect(TokenKind::LBrace);
        while (self.current.kind != TokenKind::RBrace && !self.atEnd())
            self.parseDecl();
            self.expect(TokenKind::RBrace);
        return self.allocNode();
    }
}
