mod token = import "../coral-common/token";
mod diagnostics = import "../coral-diagnostics/code";
mod diagnostic_engine = import "../coral-diagnostics/engine";
mod base = import "base";

import token { Token, TokenKind };
import diagnostics { ErrorCode };
import diagnostic_engine { DiagnosticEngine };
import base { Parser };

extern("C") rawptr malloc(usize size);
extern("C") void free(rawptr ptr);

pub extend Parser
{
    u32 errorCount() { return self.panicMode & 0x3fffffff; }
    bool hasParseErrors() { return self.errorCount() != 0; }
    bool isRecovering() { return (self.panicMode & 0x40000000) != 0; }
    bool isSpeculating() { return self.specDepth != 0; }
    void beginSpeculation() { self.specDepth = self.specDepth + 1; }
    void endSpeculation() { if (self.specDepth != 0) self.specDepth = self.specDepth - 1; }
    void beginRecovery() { self.panicMode = self.panicMode | 0x40000000; }
    void endRecovery() { self.panicMode = self.panicMode & 0xbfffffff; }
    void reportCurrentError(ErrorCode code, u8* msg) { self.reportError(code, self.current, msg); }
    void reportAllocFailed() { self.reportError(ErrorCode::DriverOutOfMemory, self.current, "out of memory while parsing"); }

    void addError()
    {
        u32 count = self.errorCount();
        if (count < 0x3fffffff)
            self.panicMode = (self.panicMode & 0xc0000000) | (count + 1);
    }

    void reportError(ErrorCode code, Token token, u8* msg)
    {
        if (self.isSpeculating()) return;
        self.addError();
        if (self.lexer == null) return;
        DiagnosticEngine* diag = self.lexer.diag;
        if (diag == null) return;
        diag.emitError(code, self.tokenLoc(token), msg, null);
    }

    u8* expectedTokenText(TokenKind kind)
    {
        switch (kind)
        {
            TokenKind::LParen => { return "expected '('"; },
            TokenKind::RParen => { return "expected ')'"; },
            TokenKind::LBrace => { return "expected '{'"; },
            TokenKind::RBrace => { return "expected '}'"; },
            TokenKind::LBracket => { return "expected '['"; },
            TokenKind::RBracket => { return "expected ']'"; },
            TokenKind::Ident => { return "expected identifier"; },
            TokenKind::Equal => { return "expected '='"; },
            TokenKind::Semicolon => { return "expected ';'"; },
            TokenKind::Comma => { return "expected ','"; },
            TokenKind::Colon => { return "expected ':'"; },
            TokenKind::FatArrow => { return "expected '=>'"; },
            TokenKind::Less => { return "expected '<'"; },
            TokenKind::Greater => { return "expected '>'"; },
            else => { return "expected token"; },
        }
    }

    void reportExpected(TokenKind kind)
    {
        if (self.current.kind == TokenKind::Eof)
        {
            self.reportError(ErrorCode::ParseUnexpectedEof, self.current, "unexpected end of file");
            return;
        }
        /* "expected ';', found 'x'" — built on the heap, freed after the
         * diagnostic has been rendered (reportError uses it synchronously) */
        u8* base = self.expectedTokenText(kind);
        usize bl = 0;
        while (base[bl] != 0) bl = bl + 1;
        Token t = self.current;
        usize tl = t.data.len;
        if (tl > 64) tl = 64;
        u8* buf = (u8*)malloc(bl + tl + 24);
        if (buf == null)
        {
            self.reportError(ErrorCode::ParseExpectedToken, t, base);
            return;
        }
        usize n = 0;
        usize i = 0;
        while (i < bl) { buf[n] = base[i]; n = n + 1; i = i + 1; }
        buf[n] = 44; n = n + 1;              /* , */
        buf[n] = 32; n = n + 1;              /* space */
        buf[n] = 102; n = n + 1;             /* f */
        buf[n] = 111; n = n + 1;             /* o */
        buf[n] = 117; n = n + 1;             /* u */
        buf[n] = 110; n = n + 1;             /* n */
        buf[n] = 100; n = n + 1;             /* d */
        buf[n] = 32; n = n + 1;              /* space */
        buf[n] = 39; n = n + 1;              /* \' */
        i = 0;
        while (i < tl) { buf[n] = t.data.ptr[i]; n = n + 1; i = i + 1; }
        buf[n] = 39; n = n + 1;              /* \' */
        buf[n] = 0;
        self.reportError(ErrorCode::ParseExpectedToken, t, buf);
        free(buf);
    }

    bool isRecoveryBoundary(TokenKind kind)
    {
        return kind == TokenKind::Eof || kind == TokenKind::Semicolon ||
               kind == TokenKind::RBrace || kind == TokenKind::RParen ||
               kind == TokenKind::RBracket || kind == TokenKind::LBrace;
    }

    void synchronize()
    {
        self.beginRecovery();
        u32 braceDepth = 0;
        u32 parenDepth = 0;
        u32 bracketDepth = 0;
        u32 startLine = self.current.line;
        while (!self.atEnd())
        {
            TokenKind kind = self.current.kind;
            if (braceDepth == 0 && parenDepth == 0 && bracketDepth == 0)
            {
                if (kind == TokenKind::Semicolon)
                {
                    self.advance();
                    break;
                }
                if (kind == TokenKind::RBrace || kind == TokenKind::RParen ||
                    kind == TokenKind::RBracket)
                    break;
                if (self.current.line > startLine && self.isDeclarationStart()) break;
            }
            if (kind == TokenKind::LBrace) braceDepth = braceDepth + 1;
            else if (kind == TokenKind::RBrace)
            {
                if (braceDepth > 0) braceDepth = braceDepth - 1;
            }
            else if (kind == TokenKind::LParen) parenDepth = parenDepth + 1;
            else if (kind == TokenKind::RParen)
            {
                if (parenDepth > 0) parenDepth = parenDepth - 1;
            }
            else if (kind == TokenKind::LBracket) bracketDepth = bracketDepth + 1;
            else if (kind == TokenKind::RBracket)
            {
                if (bracketDepth > 0) bracketDepth = bracketDepth - 1;
            }
            self.advance();
        }
        self.endRecovery();
    }

    void synchronizeStatement()
    {
        self.beginRecovery();
        while (!self.atEnd())
        {
            TokenKind kind = self.current.kind;
            if (kind == TokenKind::RBrace || kind == TokenKind::RParen ||
                kind == TokenKind::RBracket)
                break;
            if (kind == TokenKind::Semicolon)
            {
                self.advance();
                break;
            }
            self.advance();
        }
        self.endRecovery();
    }

    void synchronizeExpression()
    {
        self.beginRecovery();
        while (!self.atEnd())
        {
            TokenKind kind = self.current.kind;
            if (kind == TokenKind::Comma || kind == TokenKind::Semicolon ||
                kind == TokenKind::RParen || kind == TokenKind::RBrace ||
                kind == TokenKind::RBracket)
                break;
            self.advance();
        }
        self.endRecovery();
    }

    void synchronizeCase()
    {
        self.beginRecovery();
        while (!self.atEnd())
        {
            TokenKind kind = self.current.kind;
            if (kind == TokenKind::Comma || kind == TokenKind::FatArrow ||
                kind == TokenKind::RBrace)
                break;
            self.advance();
        }
        self.endRecovery();
    }
}
