/* parser/parse_stmt.crl — statement parsing */

import "parser" { Parser }
import "../coral-common/token" { TokenKind }
import "../coral-ast/stmt" { Stmt, StmtKind }
import "../coral-ast/id" { NodeId }

extend Parser
{
    NodeId parseStmt()
    {
        if (self.check(TokenKind::Return))
        {
            return self.parseReturnStmt();
        }
        if (self.check(TokenKind::If))
        {
            return self.parseIfStmt();
        }
        if (self.check(TokenKind::While))
        {
            return self.parseWhileStmt();
        }
        if (self.check(TokenKind::For))
        {
            return self.parseForStmt();
        }
        if (self.check(TokenKind::Loop))
        {
            return self.parseLoopStmt();
        }
        if (self.check(TokenKind::Switch))
        {
            return self.parseSwitchStmt();
        }
        if (self.check(TokenKind::Defer))
        {
            return self.parseDeferStmt();
        }
        if (self.check(TokenKind::Break))
        {
            self.advance();
            self.expect(TokenKind::Semicolon);
            /* TODO: create Break node */
            return self.noneNode();
        }
        if (self.check(TokenKind::Continue))
        {
            self.advance();
            self.expect(TokenKind::Semicolon);
            /* TODO: create Continue node */
            return self.noneNode();
        }
        if (self.check(TokenKind::LBrace))
        {
            return self.parseBlock();
        }
        if (self.check(TokenKind::Comptime))
        {
            return self.parseComptimeStmt();
        }
        if (self.check(TokenKind::Asm))
        {
            return self.parseAsmStmt();
        }
        /* expression statement or variable declaration */
        return self.parseExprOrDecl();
    }

    NodeId parseReturnStmt()
    {
        self.advance();
        if (!self.check(TokenKind::Semicolon))
        {
            NodeId val = self.parseExpr();
            /* TODO: create Return node with value */
        }
        self.expect(TokenKind::Semicolon);
        /* TODO: create Return node */
        return self.noneNode();
    }

    NodeId parseIfStmt()
    {
        self.advance();
        self.expect(TokenKind::LParen);
        NodeId cond = self.parseExpr();
        self.expect(TokenKind::RParen);
        NodeId thenBody = self.parseStmt();
        NodeId elseBody = self.noneNode();
        if (self.match(TokenKind::Else))
        {
            elseBody = self.parseStmt();
        }
        /* TODO: create If node */
        return self.noneNode();
    }

    NodeId parseWhileStmt()
    {
        self.advance();
        self.expect(TokenKind::LParen);
        NodeId cond = self.parseExpr();
        self.expect(TokenKind::RParen);
        NodeId body = self.parseStmt();
        /* TODO: create While node */
        return self.noneNode();
    }

    NodeId parseForStmt()
    {
        self.advance();
        self.expect(TokenKind::LParen);

        /* for (T name : iter) — for-in loop */
        /* for (init; cond; post) — c-style for */
        /* TODO: distinguish between for-in and c-style */

        self.expect(TokenKind::RParen);
        NodeId body = self.parseStmt();
        /* TODO: create For/ForIn node */
        return self.noneNode();
    }

    NodeId parseLoopStmt()
    {
        self.advance();
        NodeId body = self.parseStmt();
        /* TODO: create Loop node */
        return self.noneNode();
    }

    NodeId parseSwitchStmt()
    {
        self.advance();
        self.expect(TokenKind::LParen);
        NodeId expr = self.parseExpr();
        self.expect(TokenKind::RParen);
        self.expect(TokenKind::LBrace);
        /* TODO: parse cases */
        self.expect(TokenKind::RBrace);
        /* TODO: create Switch node */
        return self.noneNode();
    }

    NodeId parseDeferStmt()
    {
        self.advance();
        NodeId stmt = self.parseStmt();
        /* TODO: create Defer node */
        return self.noneNode();
    }

    NodeId parseBlock()
    {
        self.expect(TokenKind::LBrace);
        /* TODO: parse statements until RBrace */
        self.expect(TokenKind::RBrace);
        /* TODO: create Block node */
        return self.noneNode();
    }

    NodeId parseComptimeStmt()
    {
        self.advance();
        self.expect(TokenKind::LBrace);
        /* TODO: parse declarations */
        self.expect(TokenKind::RBrace);
        /* TODO: create Comptime node */
        return self.noneNode();
    }

    NodeId parseAsmStmt()
    {
        self.advance();
        self.expect(TokenKind::LBrace);
        /* TODO: parse asm template */
        self.expect(TokenKind::RBrace);
        /* TODO: create Asm node */
        return self.noneNode();
    }

    NodeId parseExprOrDecl()
    {
        /* could be:
         *   Type name;          — field declaration
         *   Type name = init;   — variable declaration
         *   var name = init;    — variable declaration
         *   const name = init;  — constant declaration
         *   expr;               — expression statement
         *   expr = expr;        — assignment
         *   expr op= expr;      — compound assignment
         */
        /* TODO: disambiguate declaration vs expression */
        NodeId expr = self.parseExpr();
        self.expect(TokenKind::Semicolon);
        return expr;
    }
}
