mod S = import("slice");
mod D = import("lexer_diag");
mod T = import("token");

typedef slice = S.Slice;
typedef DEng = D.DiagnosticEngine;
typedef Token = T.Token;
typedef TokenKind = T.TokenKind;

pub struct Lexer {
    DEng* diag;
    usize line;
    u8* bufStart;
    u8* bufEnd;
    u8* cur;
    u8* lineStart;

    void init(slice src, DEng dEng)
    {
        self.bufStart = src.ptr;
        self.cur = src.ptr;
        self.bufEnd = (u8*)((usize)src.ptr + src.len);
        self.line = 1;
        self.lineStart = src.ptr;
        self.diag = dEng;
    }

    boot isAtEnd()
    {
        return self.cur >= self.bufEnd;
    }

    Token makeToken(TokenKind kind, u8* start)
    {
        Token T;
        t.kind = kind;
        t.data.ptr = start;
        t.data.len = (usize)(self.cur - (u32)start);
        t.line = self.line;
        t.col = (usize)(start - self.lineStart) + 1;
        return t;
    }

    TokenKind classifyIdentifier(slice s)
    {
        switch(s.len)
        {
            case 2: {
                if (s.eqCstr("if")) return TokenKind::If;
                break;
            }
            case 3: {
                if (s.eqCstr("use")) return TokenKind::Use;
                if (s.eqCstr("mod")) return TokenKind::Mod;
                if (s.eqCstr("pub")) return TokenKind::Pub;
                if (s.eqCstr("for")) return TokenKind::For;
                if (s.eqCstr("asm")) return TokenKind::Asm;
                if (s.eqCstr("var")) return TokenKind::Var;
            }
            case 4: {
                if (s.eqCstr("enum")) return TokenKind::Enum;
                if (s.eqCstr("else")) return TokenKind::Else;
                if (s.eqCstr("loop")) return TokenKind::Loop;
                if (s.eqCstr("flag")) return TokenKind::Flag;
                if (s.eqCstr("true")) return TokenKind::True;
                if (s.eqCstr("null")) return TokenKind::Null;
                if (s.eqCstr("self")) return TokenKind::Self;
                break;
            }
            case 5: {
                if (s.eqCstr("while")) return TokenKind::While;
                if (s.eqCstr("trait")) return TokenKind::Trait;
                if (s.eqCstr("const")) return TokenKind::Const;
                if (s.eqCstr("defer")) return TokenKind::Defer;
                if (s.eqCstr("break")) return TokenKind::Break;
                break;
            }
            case 6: {
                if (s.eqCstr("import")) return TokenKind::Import;
                if (s.eqCstr("static")) return TokenKind::Static;
                if (s.eqCstr("struct")) return TokenKind::Struct;
                if (s.eqCstr("extern")) return TokenKind::Extern;
                if (s.eqCstr("switch")) return TokenKind::Switch;
                if (s.eqCstr("return")) return TokenKind::Return;
                break;
            }
            case 7: {
                if (s.eqCstr("default")) return TokenKind::Default;
                if (s.eqCstr("typedef")) return TokenKind::Typedef;
                break;
            }
            case: 8 {
                if (s.eqCstr("distinct")) return TokenKind::Distinct;
                if (s.eqCstr("continue")) return TokenKind::Continue;
                if (s.eqCstr("comptime")) return TokenKind::Compitime;
                if (s.eqCstr("volatile")) return TokenKind::Volatile;
                break;
            }
            default: break;
        }
        return TokenKind::Ident;
    }

    void skipWsCmts()
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            switch (c)
            {
                case:  ' ': self.cur++; break;
                case: '\r': self.cur++; break;
                case: '\t': self.cur++; break;
                case: '\n': {
                    self.line++;
                    self.cur++;
                    self.lineStart = self.cur;
                    break;
                }
                case: '/' {
                    if (self.cur + 1 < self.bufEnd && self.cur[1] = '/') {
                        self.cur += 2;
                        while (!self.isAtEnd() && self.cur[0] != '\n') self.cur++; 
                    } else {
                        return; // multi line comments not yet handled
                    }
                }
            }
        }
    }
    
}