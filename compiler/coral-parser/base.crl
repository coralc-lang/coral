/* parser/parser.crl — parser state and token stream */

import "../coral-common/token" { Token, TokenKind }
import "../coral-lexer/lexer" { Lexer }
import "../coral-context/context" { AstContext }
import "../coral-ast/id" { NodeId }

pub struct ParserMark
{
    u8* cur;
    u8* lineStart;
    u32 line;
    Token current;
    Token previous;
    u32 panicMode;
    bool pendingGreater;
}

pub struct Parser
{
    Lexer* lexer;
    AstContext* ctx;
    Token current;
    Token previous;
    u32 panicMode;
    bool pendingGreater;
}