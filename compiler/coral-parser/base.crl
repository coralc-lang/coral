/* parser/parser.crl — parser state and token stream */

mod token = import "../coral-common/token";
mod lexer = import "../coral-lexer/lexer";
mod context = import "../coral-context/context";
mod id = import "../coral-ast/id";

import token { Token, TokenKind };
import lexer { Lexer };
import context { AstContext };
import id { NodeId, Str };

pub struct ParserMark
{
    u8* cur;
    u8* lineStart;
    u32 line;
    Token current;
    Token previous;
    u32 panicMode;
    u32 specDepth;
    bool pendingGreater;
    /* type-table length at save(): restore() rewinds it so a speculative
     * parseType() does not leave orphaned entries behind — orphan Bool/Int
     * entries before the real ones broke index equality with the sema
     * type helpers (boolType() returns the FIRST Bool entry). */
    u32 typesLen;
}

pub struct Parser
{
    Lexer* lexer;
    AstContext* ctx;
    Token current;
    Token previous;
    u32 panicMode;
    /* nested-speculation depth: save() pushes, restore()/endSpeculation()
     * pop. A single flag cannot survive an inner save()/endSpeculation()
     * pair inside an outer speculative parse (e.g. generic-arg parsing
     * inside a declaration lookahead), which let diagnostics from a
     * discarded parse escape. */
    u32 specDepth;
    bool pendingGreater;
    /* #[[condassign]] allows `=` at the top level of the next
     * if/while/for/switch condition */
    bool condAssignAttr;
    /* token text of the most recent assignment operator, for
     * ParseCondAssign diagnostics */
    u8* lastAssignPtr;
    /* generic params of the innermost enclosing container
     * (struct/union/trait/variant/extend) — method signatures parsed
     * inside it rebind their type parameters against these in addition
     * to their own <...> */
    NodeId* outerGenerics;
    u32 outerGenericsLen;
    /* source file this parser is lexing — packed into every SourceLoc */
    u32 fileId;
    /* same-file `const T NAME = <int literal>` table recorded while
     * parsing — declarator array sizes (`u8 buf[N]`) resolve N through
     * it. Per-parser (per-file) so equal names in other files do not
     * collide; entries must be declared before use. Freed in parseFile. */
    Str* constNames;
    u64* constValues;
    u32 constLen;
    u32 constCap;
}