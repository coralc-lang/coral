/* parser/type.crl — type parsing */

import "parser" { Parser }
import "../coral-common/token" { TokenKind }
import "../coral-ast/types" { Ty }

extend Parser
{
    Ty parseType()
    {
        Ty base = self.parseBaseType();
        while (self.match(TokenKind::Star))
        {
            base = self.allocType();
        }
        if (self.check(TokenKind::LBracket))
        {
            self.advance();
            if (self.match(TokenKind::RBracket))
            {
                base = self.allocType();
            }
            else
            {
                self.parseExpr();
                self.expect(TokenKind::RBracket);
                base = self.allocType();
            }
        }
        return base;
    }

    Ty parseBaseType()
    {
        if (self.match(TokenKind::Void)) return self.allocType();
        if (self.match(TokenKind::Bool)) return self.allocType();
        if (self.match(TokenKind::Char)) return self.allocType();
        if (self.match(TokenKind::U8)) return self.allocType();
        if (self.match(TokenKind::I8)) return self.allocType();
        if (self.match(TokenKind::U16)) return self.allocType();
        if (self.match(TokenKind::I16)) return self.allocType();
        if (self.match(TokenKind::U32)) return self.allocType();
        if (self.match(TokenKind::I32)) return self.allocType();
        if (self.match(TokenKind::U64)) return self.allocType();
        if (self.match(TokenKind::I64)) return self.allocType();
        if (self.match(TokenKind::U128)) return self.allocType();
        if (self.match(TokenKind::I128)) return self.allocType();
        if (self.match(TokenKind::F32)) return self.allocType();
        if (self.match(TokenKind::F64)) return self.allocType();
        if (self.match(TokenKind::Usize)) return self.allocType();
        if (self.match(TokenKind::Isize)) return self.allocType();
        if (self.match(TokenKind::Rawptr)) return self.allocType();
        if (self.match(TokenKind::Str)) return self.allocType();

        if (self.check(TokenKind::Ident))
        {
            self.advance();
            while (self.match(TokenKind::ColonColon))
            {
                self.expect(TokenKind::Ident);
            }
            if (self.check(TokenKind::Less))
            {
                self.advance();
                if (self.check(TokenKind::Shr))
                {
                    self.advance();
                }
                else
                {
                    self.parseType();
                    while (self.match(TokenKind::Comma))
                    {
                        self.parseType();
                    }
                    if (self.check(TokenKind::Shr))
                    {
                        self.advance();
                    }
                    else
                    {
                        self.expect(TokenKind::Greater);
                    }
                }
            }
            if (self.check(TokenKind::LParen))
            {
                self.advance();
                if (!self.check(TokenKind::RParen))
                {
                    self.parseType();
                    while (self.match(TokenKind::Comma))
                    {
                        self.parseType();
                    }
                }
                self.expect(TokenKind::RParen);
            }
            return self.allocType();
        }

        if (self.check(TokenKind::LParen))
        {
            self.advance();
            self.parseType();
            while (self.match(TokenKind::Comma))
            {
                self.parseType();
            }
            self.expect(TokenKind::RParen);
            return self.allocType();
        }

        if (self.check(TokenKind::Struct))
        {
            self.advance();
            self.expect(TokenKind::LParen);
            self.parseType();
            while (self.match(TokenKind::Comma))
            {
                self.parseType();
            }
            self.expect(TokenKind::RParen);
            return self.allocType();
        }

        self.panicMode = 1;
        return 0;
    }

    Ty allocType()
    {
        return self.ctx.allocTypeSlot();
    }
}
