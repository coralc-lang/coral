/* parser/type.crl — type parsing */

mod base = import "base";
mod parser = import "parser";
mod token = import "../coral-common/token";
mod types = import "../coral-ast/types";
mod id = import "../coral-ast/id";
mod context = import "../coral-context/context";
mod node = import "../coral-ast/node";
mod expr_ast = import "../coral-ast/expr";

import base { Parser, ParserMark };
import parser { Parser };
import token { Token, TokenKind };
import types { Ty, TypeKind, TypeEntry };
import id { Str, NodeId };
import context { AstContext, TyListBuilder };
import node { Node, NodeKind };
import expr_ast { ExprKind };

extern("C") void free(rawptr ptr);

pub extend Parser
{
    /* suffixes on a base type: fn-pointer, pointer, slice, array */
    Ty parseTypeSuffix(Ty base)
    {
        if (self.current.kind == TokenKind::LParen && base != 0)
        {
            /* fn-pointer type over a keyword base: `void(i32)`,
             * `rawptr(rawptr)`, `u32(rawptr)` — RET(params) */
            self.advance();
            TyListBuilder fpParams;
            self.ctx.tyListInit(&fpParams);
            if (self.current.kind != TokenKind::RParen)
            {
                Ty fpParam = self.parseType();
                if (!self.ctx.tyListAppend(&fpParams, fpParam)) self.addError();
                while (self.match(TokenKind::Comma))
                {
                    fpParam = self.parseType();
                    if (!self.ctx.tyListAppend(&fpParams, fpParam)) self.addError();
                }
            }
            self.expect(TokenKind::RParen);
            u32 fpCount = fpParams.len;
            Ty* fpValues = self.ctx.tyListFinish(&fpParams);
            base = self.makeFunctionPointer(0, base, fpValues, fpCount);
        }
        while (self.match(TokenKind::Star)) {
             base = self.makePointer(base); }

        while (self.current.kind == TokenKind::LBracket)
        {
            self.advance();
            if (self.match(TokenKind::RBracket)) {
                base = self.makeSlice(base);
            } else {
                self.parseExpr();
                self.expect(TokenKind::RBracket);
                base = self.makeArray(base, 0);
            }
        }
        return base;
    }

    Ty parseType()
    {
        if (self.current.kind == TokenKind::Flag) return self.parseFlagType();
        if (self.match(TokenKind::Const))
        {
            Ty inner = self.parseType();
            return self.makeConst(inner);
        }
        if (self.match(TokenKind::Comptime))
        {
            Ty inner = self.parseType();
            return self.makeComptime(inner);
        }
        return self.parseTypeSuffix(self.parseBaseType());
    }

    /* `name[N]` / `name[]` Array suffix attached to a declarator.
     * N must be an integer literal for now. */
    Ty parseDeclaratorArray(Ty base)
    {
        if (self.current.kind != TokenKind::LBracket) return base;
        self.advance();
        if (self.match(TokenKind::RBracket)) return self.makeSlice(base);
        NodeId sizeExpr = self.parseExpr();
        self.expect(TokenKind::RBracket);
        Node* sn = self.ctx.nodes + sizeExpr.index;
        if (sn.kind.tag == NodeKind::Expr &&
            sn.kind.payload.Expr.value.kind.tag == ExprKind::IntLit)
        {
            u64 v = sn.kind.payload.Expr.value.kind.payload.IntLit.value;
            return self.makeArray(base, (u32)v);
        }
        self.addError();
        return base;
    }

    Ty makeVoid()
    {
        TypeKind k;
        k.tag = TypeKind::Void;
        return self.allocTypeKind(k);
    }
    
    Ty makeNamed(Str name) { return self.makeNamedArgs(name, null, 0); }

    Ty makeNamedArgs(Str name, Ty* args, u32 argsLen)
    {
        TypeKind k;
        k = TypeKind::Named{ .name = name, .genericArgs = args, .genericArgsLen = argsLen };
        return self.allocTypeKind(k);
    }

    bool parseGenericArguments(rawptr* outArgs, u32* outLen)
    {
        *outArgs = null;
        *outLen = 0;
        if (self.current.kind != TokenKind::Less) return false;
        ParserMark mark = self.save();
        self.advance();
        TyListBuilder args;
        self.ctx.tyListInit(&args);
        bool ok = true;
        if (self.current.kind == TokenKind::Greater || self.current.kind == TokenKind::Shr) {
            ok = self.consumeGreater();
        }
        else
        {
            u32 errorsBefore = self.errorCount();
            while (true)
            {
                Ty arg = self.parseType();
                if (self.errorCount() > errorsBefore || !self.ctx.tyListAppend(&args, arg))
                {
                    ok = false;
                    break;
                }
                if (!self.match(TokenKind::Comma)) break;
            }
            if (ok) ok = self.consumeGreater();
        }
        if (!ok)
        {
            if (args.data != null) free((rawptr)args.data);
            self.restore(mark);
            return false;
        }
        *outLen = args.len;
        *outArgs = (rawptr)self.ctx.tyListFinish(&args);
        self.endSpeculation();
        return true;
    }
    
    Ty makePointer(Ty base)
    {
        TypeKind k;
        k = TypeKind::Pointer{ .base = base };
        return self.allocTypeKind(k);
    }

    Ty makeConst(Ty base)
    {
        TypeKind k;
        k = TypeKind::Const{ .base = base };
        return self.allocTypeKind(k);
    }
    
    Ty makeComptime(Ty base)
    {
        TypeKind k;
        k = TypeKind::Comptime{ .base = base };
        return self.allocTypeKind(k);
    }

    Ty makeSlice(Ty base)
    {
        TypeKind k;
        k = TypeKind::Slice{ .base = base };
        return self.allocTypeKind(k);
    }

    Ty makeArray(Ty base, u32 len)
    {
        TypeKind k;
        k = TypeKind::Array{ .base = base, .len = len };
        return self.allocTypeKind(k);
    }

    Ty makeTuple(Ty* elems, u32 len)
    {
        TypeKind k;
        k = TypeKind::Tuple{ .elems = elems, .elemsLen = len };
        return self.allocTypeKind(k);
    }

    Ty makeFunctionPointer(Str name, Ty returnType, Ty* params, u32 paramsLen)
    {
        TypeKind k;
        k = TypeKind::FnPtr{ .returnType = returnType, .params = params, .paramsLen = paramsLen, .name = name };
        return self.allocTypeKind(k);
    }

    Ty allocTypeKind(TypeKind kind)
    {
        Ty id = self.ctx.allocTypeSlot();
        if (id == 0 || self.ctx.types == null) {
            self.addError();
            return 0;
        }
        TypeEntry* e = self.ctx.types + id;
        e.kind = kind;
        return id;
    }

    Ty parseBaseType()
    {
        if (self.match(TokenKind::Self)) return self.makeNamed(self.ctx.intern((u8*)"self", 4));
        if (self.match(TokenKind::Void)) return self.makeVoid();
        if (self.match(TokenKind::Bool)) { TypeKind k; k.tag = TypeKind::Bool; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Char)) { TypeKind k; k.tag = TypeKind::Char; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U8)) { TypeKind k; k.tag = TypeKind::U8; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I8)) { TypeKind k; k.tag = TypeKind::I8; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U16)) { TypeKind k; k.tag = TypeKind::U16; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I16)) { TypeKind k; k.tag = TypeKind::I16; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U32)) { TypeKind k; k.tag = TypeKind::U32; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I32)) { TypeKind k; k.tag = TypeKind::I32; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U64)) { TypeKind k; k.tag = TypeKind::U64; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I64)) { TypeKind k; k.tag = TypeKind::I64; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U128)) { TypeKind k; k.tag = TypeKind::U128; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I128)) { TypeKind k; k.tag = TypeKind::I128; return self.allocTypeKind(k); }
        if (self.match(TokenKind::F32)) { TypeKind k; k.tag = TypeKind::F32; return self.allocTypeKind(k); }
        if (self.match(TokenKind::F64)) { TypeKind k; k.tag = TypeKind::F64; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Usize)) { TypeKind k; k.tag = TypeKind::Usize; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Isize)) { TypeKind k; k.tag = TypeKind::Isize; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Rawptr)) { TypeKind k; k.tag = TypeKind::Rawptr; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Str)) { TypeKind k; k.tag = TypeKind::Str; return self.allocTypeKind(k); }

        if (self.current.kind == TokenKind::Ident)
        {
            Token nameTok = self.advance();
            Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
            while (self.match(TokenKind::ColonColon)) {
                self.expectName(); }
    
            Ty* genericArgs = null;
            u32 genericArgsLen = 0;
            self.parseGenericArguments((rawptr*)&genericArgs, &genericArgsLen);
            if (self.current.kind == TokenKind::LParen)
            {
                self.advance();
                TyListBuilder params;
                self.ctx.tyListInit(&params);
                if (self.current.kind != TokenKind::RParen)
                {
                    Ty param = self.parseType();
                    if (!self.ctx.tyListAppend(&params, param)) self.addError();
                    while (self.match(TokenKind::Comma))
                    {
                        param = self.parseType();
                        if (!self.ctx.tyListAppend(&params, param)) self.addError();
                    }
                }
                self.expect(TokenKind::RParen);
                u32 count = params.len;
                Ty* values = self.ctx.tyListFinish(&params);
                /* `T(params)` — a function type returning T taking params */
                Ty ret = self.makeNamedArgs(name, genericArgs, genericArgsLen);
                return self.makeFunctionPointer(name, ret, values, count);
            }
             return self.makeNamedArgs(name, genericArgs, genericArgsLen);
        }

        if (self.current.kind == TokenKind::LParen)
        {
            self.advance();
            TyListBuilder elems;
            self.ctx.tyListInit(&elems);
            if (self.current.kind != TokenKind::RParen)
            {
                Ty elem = self.parseType();
                if (!self.ctx.tyListAppend(&elems, elem)) self.addError();
                while (self.match(TokenKind::Comma))
                {
                    elem = self.parseType();
                    if (!self.ctx.tyListAppend(&elems, elem)) self.addError();
                }
            }
            self.expect(TokenKind::RParen);
            u32 count = elems.len;
            Ty* values = self.ctx.tyListFinish(&elems);
            return self.makeTuple(values, count);
        }

        if (self.current.kind == TokenKind::Struct)
        {
            self.advance();
            self.expect(TokenKind::LParen);
            TyListBuilder elems;
            self.ctx.tyListInit(&elems);
            if (self.current.kind != TokenKind::RParen)
            {
                Ty elem = self.parseType();
                if (!self.ctx.tyListAppend(&elems, elem)) self.addError();
                while (self.match(TokenKind::Comma))
                {
                    elem = self.parseType();
                    if (!self.ctx.tyListAppend(&elems, elem)) self.addError();
                }
            }
            self.expect(TokenKind::RParen);
            u32 count = elems.len;
            Ty* values = self.ctx.tyListFinish(&elems);
            return self.makeTuple(values, count);
        }

        self.addError();
        if (!self.atEnd()) self.advance();
        return 0;
    }

    Ty allocType()
    {
        self.addError();
        return 0;
    }
}
