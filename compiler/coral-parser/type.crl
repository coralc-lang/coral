/* parser/type.crl — type parsing */
mod diagnostics = import "../coral-diagnostics/code";
mod diagnostic_engine = import "../coral-diagnostics/engine";

mod base = import "base";
mod parser = import "parser";
mod token = import "../coral-common/token";
mod types = import "../coral-ast/types";
mod id = import "../coral-ast/id";
mod context = import "../coral-context/context";
mod node = import "../coral-ast/node";
mod expr_ast = import "../coral-ast/expr";

import diagnostics { ErrorCode };
import diagnostic_engine { DiagnosticEngine };
import base { Parser, ParserMark };
import parser { Parser };
import token { Token, TokenKind };
import types { Ty, TypeKind, TypeEntry };
import id { Str, NodeId };
import context { AstContext, TyListBuilder };
import node { Node, NodeKind };
import expr_ast { Expr, ExprKind };

extern("C") void free(rawptr ptr);
extern("C") rawptr realloc(rawptr ptr, usize size);

pub extend Parser
{
    /* `T(params)` is a fn-pointer type only when what follows `(` can be a
     * parameter type (or the list is empty). Without this a statement like
     * `take(&a[1]);` speculatively reads `take(` as a function type,
     * error recovery lands on `[`, and the decl-vs-expr guess commits a
     * bogus declaration full of PAR errors. */
    bool fnTypeAhead()
    {
        if (self.current.kind != TokenKind::LParen) return false;
        ParserMark m = self.save();
        self.advance();
        bool ok = self.current.kind == TokenKind::RParen || self.isTypeStart();
        self.restore(m);
        return ok;
    }

    /* suffixes on a base type: fn-pointer, pointer, slice, array */
    Ty parseTypeSuffix(Ty base)
    {
        if (base != 0 && self.fnTypeAhead())
        {
            /* fn-pointer type over a keyword base: `void(i32)`,
             * `rawptr(rawptr)`, `u32(rawptr)` — RET(params) */
            self.advance();
            TyListBuilder fpParams;
            self.ctx.tyListInit(&fpParams);
            if (self.current.kind != TokenKind::RParen)
            {
                Ty fpParam = self.parseType();
                if (!self.ctx.tyListAppend(&fpParams, fpParam)) self.reportAllocFailed();
                while (self.match(TokenKind::Comma))
                {
                    fpParam = self.parseType();
                    if (!self.ctx.tyListAppend(&fpParams, fpParam)) self.reportAllocFailed();
                }
            }
            self.expect(TokenKind::RParen);
            u32 fpCount = fpParams.len;
            Ty* fpValues = self.ctx.tyListFinish(&fpParams);
            base = self.makeFunctionPointer(0, base, fpValues, fpCount);
        }
        while (self.match(TokenKind::Star)) {
             base = self.makePointer(base); }

        while (self.current.kind == TokenKind::LBracket)
        {
            self.advance();
            if (self.match(TokenKind::RBracket)) {
                base = self.makeSlice(base);
            } else {
                self.parseExpr();
                self.expect(TokenKind::RBracket);
                base = self.makeArray(base, 0);
            }
        }
        return base;
    }

    Ty parseType()
    {
        if (self.current.kind == TokenKind::Flag) return self.parseFlagType();
        if (self.match(TokenKind::Const))
        {
            Ty inner = self.parseType();
            return self.makeConst(inner);
        }
        if (self.match(TokenKind::Comptime))
        {
            Ty inner = self.parseType();
            return self.makeComptime(inner);
        }
        return self.parseTypeSuffix(self.parseBaseType());
    }

    /* `name[N]` / `name[]` Array suffix attached to a declarator.
     * N is an integer literal, or a same-file `const T N = <int literal>` —
     * resolved through the prescanConstInts table, so declaration order
     * within the file does not matter (cross-file consts need sema's
     * declare-all pass from text.txt and are not supported yet). */
    Ty parseDeclaratorArray(Ty base)
    {
        if (self.current.kind != TokenKind::LBracket) return base;
        self.advance();
        if (self.match(TokenKind::RBracket)) return self.makeSlice(base);
        NodeId sizeExpr = self.parseExpr();
        self.expect(TokenKind::RBracket);
        u32 v = 0;
        bool ok = false;
        {
            Node* sn = self.ctx.nodes + sizeExpr.index;
            if (sn.kind.tag == NodeKind::Expr)
            {
                Expr se = sn.kind.payload.Expr.value;
                if (se.kind.tag == ExprKind::IntLit)
                {
                    v = (u32)se.kind.payload.IntLit.value;
                    ok = true;
                }
                else if (se.kind.tag == ExprKind::Ident)
                {
                    u64 cv = 0;
                    if (self.lookupConstInt(se.kind.payload.Ident.name, &cv)) { v = (u32)cv; ok = true; }
                }
            }
        }
        if (!ok)
        {
            self.reportCurrentError(ErrorCode::ParseExpectedExpr, "array size must be an integer literal or a const int declared in this file");
            return base;
        }
        /* rightmost suffix is the innermost dimension:
         * `T x[A][B]` → Array(Array(T, B), A) so the outer dim is A */
        Ty inner = self.parseDeclaratorArray(base);
        return self.makeArray(inner, v);
    }

    /* same-file const-int table lookup (see Parser.constNames) */
    bool lookupConstInt(Str name, u64* out)
    {
        u32 i = 0;
        while (i < self.constLen)
        {
            if (self.constNames[i] == name)
            {
                *out = self.constValues[i];
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /* grow-and-append for the const-int prescan table */
    void addConstInt(Str name, u64 value)
    {
        if (name == 0) return;
        if (self.constLen >= self.constCap)
        {
            u32 newCap = 8;
            if (self.constCap > 0) newCap = self.constCap * 2;
            rawptr names = realloc((rawptr)self.constNames, (usize)newCap * sizeof(Str));
            if (names == null) { self.reportAllocFailed(); return; }
            self.constNames = (Str*)names;
            rawptr values = realloc((rawptr)self.constValues, (usize)newCap * sizeof(u64));
            if (values == null) { self.reportAllocFailed(); return; }
            self.constValues = (u64*)values;
            self.constCap = newCap;
        }
        self.constNames[self.constLen] = name;
        self.constValues[self.constLen] = value;
        self.constLen = self.constLen + 1;
    }

    /* tokens allowed between `const` and `=` in the prescan head:
     * identifiers, `::`, and the builtin type keywords (usize/u32/...
     * lex as their own TokenKinds, not Ident) */
    bool isConstHeadToken(TokenKind k)
    {
        if (k == TokenKind::Ident || k == TokenKind::ColonColon) return true;
        if (k == TokenKind::Void || k == TokenKind::Bool || k == TokenKind::Char) return true;
        if (k == TokenKind::U8 || k == TokenKind::I8 || k == TokenKind::U16 || k == TokenKind::I16) return true;
        if (k == TokenKind::U32 || k == TokenKind::I32 || k == TokenKind::U64 || k == TokenKind::I64) return true;
        if (k == TokenKind::U128 || k == TokenKind::I128 || k == TokenKind::F32 || k == TokenKind::F64) return true;
        if (k == TokenKind::Usize || k == TokenKind::Isize || k == TokenKind::Rawptr || k == TokenKind::Str) return true;
        return false;
    }

    /* text.txt pass 1 in miniature (fast variant): re-lex the whole file
     * once before parsing and record every `const T NAME = <int literal>`
     * into the table, so declarator array sizes (`u8 buf[N]`) resolve no
     * matter where the const is declared — coral needs no forward
     * declarations. Pattern: const, then head tokens (idents/`::`/type
     * keywords), then `=`, one int literal, `;` — anything else (fns,
     * pointer consts, `#[[const]]`, non-literal values) resets the scan.
     * Lexer diagnostics are muted for this dry run — the real parse
     * reports them once. */
    void prescanConstInts()
    {
        DiagnosticEngine* savedDiag = self.lexer.diag;
        self.lexer.diag = null;
        ParserMark m = self.save();
        u32 state = 0;   /* 0 hunt, 1 head, 2 value, 3 expect ';' */
        u32 headCount = 0;
        u64 value = 0;
        Str name = 0;
        while (!self.atEnd())
        {
            TokenKind k = self.current.kind;
            if (state == 0)
            {
                if (k == TokenKind::Const)
                {
                    state = 1;
                    headCount = 0;
                    name = 0;
                }
                self.advance();
                continue;
            }
            if (state == 1)
            {
                if (self.isConstHeadToken(k))
                {
                    if (k == TokenKind::Ident)
                        name = self.ctx.intern(self.current.data.ptr, self.current.data.len);
                    headCount = headCount + 1;
                    self.advance();
                    continue;
                }
                if (k == TokenKind::Equal && headCount > 0) { state = 2; self.advance(); continue; }
                state = 0;
                continue;
            }
            if (state == 2)
            {
                if (k == TokenKind::Dec || k == TokenKind::Hex ||
                    k == TokenKind::Bin || k == TokenKind::Oct)
                {
                    value = self.current.number;
                    state = 3;
                    self.advance();
                    continue;
                }
                state = 0;
                continue;
            }
            if (k == TokenKind::Semicolon)
            {
                self.addConstInt(name, value);
                state = 0;
                self.advance();
                continue;
            }
            state = 0;
        }
        self.restore(m);
        self.lexer.diag = savedDiag;
    }

    /* called at the end of parseFile — the table is per-parser */
    void freeConstTable()
    {
        if (self.constNames != null)
        {
            free((rawptr)self.constNames);
            self.constNames = null;
        }
        if (self.constValues != null)
        {
            free((rawptr)self.constValues);
            self.constValues = null;
        }
        self.constLen = 0;
        self.constCap = 0;
    }

    Ty makeVoid()
    {
        TypeKind k;
        k.tag = TypeKind::Void;
        return self.internKind(k);
    }
    
    Ty makeNamed(Str name) { return self.makeNamedArgs(name, null, 0); }

    Ty makeNamedArgs(Str name, Ty* args, u32 argsLen)
    {
        TypeKind k;
        k = TypeKind::Named{ .name = name, .genericArgs = args, .genericArgsLen = argsLen };
        return self.allocTypeKind(k);
    }

    bool parseGenericArguments(rawptr* outArgs, u32* outLen)
    {
        *outArgs = null;
        *outLen = 0;
        if (self.current.kind != TokenKind::Less) return false;
        ParserMark mark = self.save();
        self.advance();
        TyListBuilder args;
        self.ctx.tyListInit(&args);
        bool ok = true;
        if (self.current.kind == TokenKind::Greater || self.current.kind == TokenKind::Shr) {
            ok = self.consumeGreater();
        }
        else
        {
            u32 errorsBefore = self.errorCount();
            while (true)
            {
                Ty arg = self.parseType();
                if (self.errorCount() > errorsBefore || !self.ctx.tyListAppend(&args, arg))
                {
                    ok = false;
                    break;
                }
                if (!self.match(TokenKind::Comma)) break;
            }
            if (ok) ok = self.consumeGreater();
        }
        if (!ok)
        {
            if (args.data != null) free((rawptr)args.data);
            self.restore(mark);
            return false;
        }
        *outLen = args.len;
        *outArgs = (rawptr)self.ctx.tyListFinish(&args);
        self.endSpeculation();
        return true;
    }
    
    Ty makePointer(Ty base)
    {
        TypeKind k;
        k = TypeKind::Pointer{ .base = base };
        return self.allocTypeKind(k);
    }

    Ty makeConst(Ty base)
    {
        TypeKind k;
        k = TypeKind::Const{ .base = base };
        return self.allocTypeKind(k);
    }
    
    Ty makeComptime(Ty base)
    {
        TypeKind k;
        k = TypeKind::Comptime{ .base = base };
        return self.allocTypeKind(k);
    }

    Ty makeSlice(Ty base)
    {
        TypeKind k;
        k = TypeKind::Slice{ .base = base };
        return self.allocTypeKind(k);
    }

    Ty makeArray(Ty base, u32 len)
    {
        TypeKind k;
        k = TypeKind::Array{ .base = base, .len = len };
        return self.allocTypeKind(k);
    }

    Ty makeTuple(Ty* elems, u32 len)
    {
        TypeKind k;
        k = TypeKind::Tuple{ .elems = elems, .elemsLen = len };
        return self.allocTypeKind(k);
    }

    Ty makeFunctionPointer(Str name, Ty returnType, Ty* params, u32 paramsLen)
    {
        TypeKind k;
        k = TypeKind::FnPtr{ .returnType = returnType, .params = params, .paramsLen = paramsLen, .name = name };
        return self.allocTypeKind(k);
    }

    Ty allocTypeKind(TypeKind kind)
    {
        Ty id = self.ctx.allocTypeSlot();
        if (id == 0 || self.ctx.types == null) {
            self.reportAllocFailed();
            return 0;
        }
        TypeEntry* e = self.ctx.types + id;
        e.kind = kind;
        return id;
    }

    /* payload-less primitive kinds (Bool, Char, integers, floats, Void,
     * Usize, Isize, Rawptr, Str, ...) are identified by tag alone: reuse
     * the existing entry instead of allocating a duplicate, so every
     * `bool` in every file shares one index — the sema helpers
     * (boolType(), i32Type(), ...) return the FIRST entry with that tag
     * and index equality must hold against them. Kinds with payloads
     * (Named, Pointer, Array, ...) go through allocTypeKind. */
    Ty internKind(TypeKind kind)
    {
        u32 i = 1;
        while (i < self.ctx.typesLen)
        {
            if (self.ctx.types[i].kind.tag == kind.tag) return i;
            i = i + 1;
        }
        return self.allocTypeKind(kind);
    }

    Ty parseBaseType()
    {
        if (self.match(TokenKind::Any))
        {
            Token tTok = self.expect(TokenKind::Ident);
            Str tn = self.ctx.intern(tTok.data.ptr, tTok.data.len);
            Ty recv = self.makeNamedArgs(tn, null, 0);
            return self.makeNamedArgs(self.ctx.intern((u8*)"any", 3), &recv, 1);
        }
        if (self.match(TokenKind::Self)) return self.makeNamed(self.ctx.intern((u8*)"self", 4));
        if (self.match(TokenKind::Void)) return self.makeVoid();
        if (self.match(TokenKind::Bool)) { TypeKind k; k.tag = TypeKind::Bool; return self.internKind(k); }
        if (self.match(TokenKind::Char)) { TypeKind k; k.tag = TypeKind::Char; return self.internKind(k); }
        if (self.match(TokenKind::U8)) { TypeKind k; k.tag = TypeKind::U8; return self.internKind(k); }
        if (self.match(TokenKind::I8)) { TypeKind k; k.tag = TypeKind::I8; return self.internKind(k); }
        if (self.match(TokenKind::U16)) { TypeKind k; k.tag = TypeKind::U16; return self.internKind(k); }
        if (self.match(TokenKind::I16)) { TypeKind k; k.tag = TypeKind::I16; return self.internKind(k); }
        if (self.match(TokenKind::U32)) { TypeKind k; k.tag = TypeKind::U32; return self.internKind(k); }
        if (self.match(TokenKind::I32)) { TypeKind k; k.tag = TypeKind::I32; return self.internKind(k); }
        if (self.match(TokenKind::U64)) { TypeKind k; k.tag = TypeKind::U64; return self.internKind(k); }
        if (self.match(TokenKind::I64)) { TypeKind k; k.tag = TypeKind::I64; return self.internKind(k); }
        if (self.match(TokenKind::U128)) { TypeKind k; k.tag = TypeKind::U128; return self.internKind(k); }
        if (self.match(TokenKind::I128)) { TypeKind k; k.tag = TypeKind::I128; return self.internKind(k); }
        if (self.match(TokenKind::F32)) { TypeKind k; k.tag = TypeKind::F32; return self.internKind(k); }
        if (self.match(TokenKind::F64)) { TypeKind k; k.tag = TypeKind::F64; return self.internKind(k); }
        if (self.match(TokenKind::Usize)) { TypeKind k; k.tag = TypeKind::Usize; return self.internKind(k); }
        if (self.match(TokenKind::Isize)) { TypeKind k; k.tag = TypeKind::Isize; return self.internKind(k); }
        if (self.match(TokenKind::Rawptr)) { TypeKind k; k.tag = TypeKind::Rawptr; return self.internKind(k); }
        if (self.match(TokenKind::Str)) { TypeKind k; k.tag = TypeKind::Str; return self.internKind(k); }

        if (self.current.kind == TokenKind::Ident)
        {
            Token nameTok = self.advance();
            Str name = self.ctx.intern(nameTok.data.ptr, nameTok.data.len);
            while (self.match(TokenKind::ColonColon)) {
                self.expectName(); }
    
            Ty* genericArgs = null;
            u32 genericArgsLen = 0;
            self.parseGenericArguments((rawptr*)&genericArgs, &genericArgsLen);
            if (self.fnTypeAhead())
            {
                self.advance();
                TyListBuilder params;
                self.ctx.tyListInit(&params);
                if (self.current.kind != TokenKind::RParen)
                {
                    Ty param = self.parseType();
                    if (!self.ctx.tyListAppend(&params, param)) self.reportAllocFailed();
                    while (self.match(TokenKind::Comma))
                    {
                        param = self.parseType();
                        if (!self.ctx.tyListAppend(&params, param)) self.reportAllocFailed();
                    }
                }
                self.expect(TokenKind::RParen);
                u32 count = params.len;
                Ty* values = self.ctx.tyListFinish(&params);
                /* `T(params)` — a function type returning T taking params */
                Ty ret = self.makeNamedArgs(name, genericArgs, genericArgsLen);
                return self.makeFunctionPointer(name, ret, values, count);
            }
             return self.makeNamedArgs(name, genericArgs, genericArgsLen);
        }

        if (self.current.kind == TokenKind::LParen)
        {
            self.advance();
            TyListBuilder elems;
            self.ctx.tyListInit(&elems);
            if (self.current.kind != TokenKind::RParen)
            {
                Ty elem = self.parseType();
                if (!self.ctx.tyListAppend(&elems, elem)) self.reportAllocFailed();
                while (self.match(TokenKind::Comma))
                {
                    elem = self.parseType();
                    if (!self.ctx.tyListAppend(&elems, elem)) self.reportAllocFailed();
                }
            }
            self.expect(TokenKind::RParen);
            u32 count = elems.len;
            Ty* values = self.ctx.tyListFinish(&elems);
            return self.makeTuple(values, count);
        }

        if (self.current.kind == TokenKind::Struct)
        {
            self.advance();
            self.expect(TokenKind::LParen);
            TyListBuilder elems;
            self.ctx.tyListInit(&elems);
            if (self.current.kind != TokenKind::RParen)
            {
                Ty elem = self.parseType();
                if (!self.ctx.tyListAppend(&elems, elem)) self.reportAllocFailed();
                while (self.match(TokenKind::Comma))
                {
                    elem = self.parseType();
                    if (!self.ctx.tyListAppend(&elems, elem)) self.reportAllocFailed();
                }
            }
            self.expect(TokenKind::RParen);
            u32 count = elems.len;
            Ty* values = self.ctx.tyListFinish(&elems);
            return self.makeTuple(values, count);
        }

        self.reportCurrentError(ErrorCode::ParseExpectedType, "expected a type");
        if (!self.atEnd()) self.advance();
        return 0;
    }

    Ty allocType()
    {
        self.reportAllocFailed();
        return 0;
    }
}
