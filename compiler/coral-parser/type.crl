/* parser/parse_type.crl — type parsing */

import "parser" { Parser }
import "../coral-common/token" { TokenKind }
import "../coral-ast/types" { Ty, TypeKind }
import "../coral-ast/id" { NodeId }

extend Parser
{
    Ty parseType()
    {
        Ty base = self.parseBaseType();

        /* pointer * */
        while (self.match(TokenKind::Star))
        {
            /* TODO: wrap base in Pointer type */
        }

        /* slice [] */
        if (self.check(TokenKind::LBracket) && self.checkNext(TokenKind::RBracket))
        {
            self.advance();
            self.advance();
            /* TODO: wrap base in Slice type */
        }

        /* array [N] */
        if (self.check(TokenKind::LBracket))
        {
            self.advance();
            /* TODO: parse array size */
            self.expect(TokenKind::RBracket);
            /* TODO: wrap base in Array type */
        }

        return base;
    }

    Ty parseBaseType()
    {
        /* builtin types */
        if (self.match(TokenKind::Void)) return 0;
        if (self.match(TokenKind::Bool)) return 0;
        if (self.match(TokenKind::Char)) return 0;
        if (self.match(TokenKind::U8)) return 0;
        if (self.match(TokenKind::I8)) return 0;
        if (self.match(TokenKind::U16)) return 0;
        if (self.match(TokenKind::I16)) return 0;
        if (self.match(TokenKind::U32)) return 0;
        if (self.match(TokenKind::I32)) return 0;
        if (self.match(TokenKind::U64)) return 0;
        if (self.match(TokenKind::I64)) return 0;
        if (self.match(TokenKind::F32)) return 0;
        if (self.match(TokenKind::F64)) return 0;
        if (self.match(TokenKind::Usize)) return 0;
        if (self.match(TokenKind::Isize)) return 0;
        if (self.match(TokenKind::Rawptr)) return 0;
        if (self.match(TokenKind::Str)) return 0;

        /* named type: Ident or Ident<Args> */
        if (self.check(TokenKind::Ident))
        {
            Token name = self.advance();
            /* TODO: create Named type */

            /* optional generic args <Type, Type> */
            if (self.match(TokenKind::Less))
            {
                /* TODO: parse type arguments */
                while (!self.check(TokenKind::Greater) && !self.atEnd())
                {
                    self.advance();
                }
                self.expect(TokenKind::Greater);
            }

            return 0;
        }

        /* tuple type: (Type, Type, ...) */
        if (self.check(TokenKind::LParen))
        {
            self.advance();
            /* TODO: parse tuple element types */
            self.expect(TokenKind::RParen);
            return 0;
        }

        /* fn pointer type: RetType(ParamTypes) */
        /* handled at declaration level, not here */

        /* error */
        self.panicMode = 1;
        return 0;
    }

    bool checkNext( TokenKind kind)
    {
        /* peek one token ahead without consuming */
        /* TODO: implement proper lookahead */
        return false;
    }
}
