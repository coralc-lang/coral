/* parser/type.crl — type parsing */

import "base" { Parser, ParserMark };
import "../coral-common/token" { Token, TokenKind };
import "../coral-ast/types" { Ty, TypeKind, TypeEntry };
import "../coral-ast/id" { Str };

extend Parser
{
    Ty parseType()
    {
        if (self.match(TokenKind::Const))
        {
            Ty inner = self.parseType();
            return self.makeConst(inner);
        }
        Ty base = self.parseBaseType();
        while (self.match(TokenKind::Star))
        {
            base = self.makePointer(base);
        }
        while (self.check(TokenKind::LBracket))
        {
            self.advance();
            if (self.match(TokenKind::RBracket))
            {
                base = self.makeSlice(base);
            }
            else
            {
                self.parseExpr();
                self.expect(TokenKind::RBracket);
                base = self.makeArray(base, 0);
            }
        }
        return base;
    }

    Ty makeVoid()
    {
        TypeKind k;
        k.tag = TypeKind_Void;
        return self.allocTypeKind(k);
    }
    
    Ty makeNamed(Str name)
    {
        TypeKind k;
        k = TypeKind::Named { .name = name, .genericArgs = null, .genericArgsLen = 0 };
        return self.allocTypeKind(k);
    }
    Ty makePointer(Ty base)
    {
        TypeKind k;
        k = TypeKind::Pointer { .base = base };
        return self.allocTypeKind(k);
    }
    Ty makeConst(Ty base)
    {
        TypeKind k;
        k = TypeKind::Const { .base = base };
        return self.allocTypeKind(k);
    }
    Ty makeSlice(Ty base)
    {
        TypeKind k;
        k = TypeKind::Slice { .base = base };
        return self.allocTypeKind(k);
    }
    Ty makeArray(Ty base, u32 len)
    {
        TypeKind k;
        k = TypeKind::Array { .base = base, .len = len };
        return self.allocTypeKind(k);
    }
    Ty allocTypeKind(TypeKind kind)
    {
        Ty id = self.ctx.allocTypeSlot();
        TypeEntry* e = self.ctx.types + id;
        e.kind = kind;
        return id;
    }

    Ty parseBaseType()
    {
        if (self.match(TokenKind::Void)) return self.makeVoid();
        if (self.match(TokenKind::Bool)) { TypeKind k; k.tag = TypeKind_Bool; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Char)) { TypeKind k; k.tag = TypeKind_Char; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U8)) { TypeKind k; k.tag = TypeKind_U8; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I8)) { TypeKind k; k.tag = TypeKind_I8; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U16)) { TypeKind k; k.tag = TypeKind_U16; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I16)) { TypeKind k; k.tag = TypeKind_I16; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U32)) { TypeKind k; k.tag = TypeKind_U32; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I32)) { TypeKind k; k.tag = TypeKind_I32; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U64)) { TypeKind k; k.tag = TypeKind_U64; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I64)) { TypeKind k; k.tag = TypeKind_I64; return self.allocTypeKind(k); }
        if (self.match(TokenKind::U128)) { TypeKind k; k.tag = TypeKind_U128; return self.allocTypeKind(k); }
        if (self.match(TokenKind::I128)) { TypeKind k; k.tag = TypeKind_I128; return self.allocTypeKind(k); }
        if (self.match(TokenKind::F32)) { TypeKind k; k.tag = TypeKind_F32; return self.allocTypeKind(k); }
        if (self.match(TokenKind::F64)) { TypeKind k; k.tag = TypeKind_F64; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Usize)) { TypeKind k; k.tag = TypeKind_Usize; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Isize)) { TypeKind k; k.tag = TypeKind_Isize; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Rawptr)) { TypeKind k; k.tag = TypeKind_Rawptr; return self.allocTypeKind(k); }
        if (self.match(TokenKind::Str)) { TypeKind k; k.tag = TypeKind_Str; return self.allocTypeKind(k); }

        if (self.check(TokenKind::Ident))
        {
            self.advance();
            while (self.match(TokenKind::ColonColon))
            {
                self.expect(TokenKind::Ident);
            }
            if (self.check(TokenKind::Less))
            {
                ParserMark m = self.save();
                self.advance();
                bool ok = true;
                if (self.check(TokenKind::Greater) || self.check(TokenKind::Shr))
                {
                    ok = self.consumeGreater();
                }
                else
                {
                    self.parseType();
                    if (self.panicMode) ok = false;
                    else
                    {
                        while (self.match(TokenKind::Comma))
                        {
                            self.parseType();
                            if (self.panicMode) { ok = false; break; }
                        }
                        if (ok) ok = self.consumeGreater();
                    }
                }
                if (!ok)
                {
                    self.restore(m);
                }
            }
            if (self.check(TokenKind::LParen))
            {
                self.advance();
                if (!self.check(TokenKind::RParen))
                {
                    self.parseType();
                    while (self.match(TokenKind::Comma))
                    {
                        self.parseType();
                    }
                }
                self.expect(TokenKind::RParen);
            }
            return self.allocType();
        }

        if (self.check(TokenKind::LParen))
        {
            self.advance();
            self.parseType();
            while (self.match(TokenKind::Comma))
            {
                self.parseType();
            }
            self.expect(TokenKind::RParen);
            return self.allocType();
        }

        if (self.check(TokenKind::Struct))
        {
            self.advance();
            self.expect(TokenKind::LParen);
            self.parseType();
            while (self.match(TokenKind::Comma))
            {
                self.parseType();
            }
            self.expect(TokenKind::RParen);
            return self.allocType();
        }

        self.panicMode = 1;
        return 0;
    }

    Ty allocType()
    {
        return self.ctx.allocTypeSlot();
    }
}
