/* parser/parser.crl — parser state and token stream */

import "../coral-common/token" { Token, TokenKind }
import "../coral-lexer/lexer" { Lexer }
import "../coral-context/context" { AstContext }
import "../coral-ast/id" { NodeId }

pub struct ParserMark
{
    u8* cur;
    u8* lineStart;
    u32 line;
    Token current;
    Token previous;
    u32 panicMode;
}

pub struct Parser
{
    Lexer* lexer;
    AstContext* ctx;
    Token current;
    Token previous;
    u32 panicMode;
}

extend Parser
{
    Parser init(Lexer* lexer, AstContext* ctx)
    {
        Parser p;
        p.lexer = lexer;
        p.ctx = ctx;
        p.panicMode = 0;
        Lexer_nextToken(lexer);
        p.current = lexer.token;
        p.previous = lexer.token;
        return p;
    }

    Token advance()
    {
        self.previous = self.current;
        Lexer_nextToken(self.lexer);
        self.current = self.lexer.token;
        return self.previous;
    }

    bool check(TokenKind kind) { return self.current.kind == kind; }

    bool match(TokenKind kind)
    {
        if (self.current.kind == kind)
        {
            self.advance();
            return true;
        }
        return false;
    }

    Token expect(TokenKind kind)
    {
        if (self.current.kind == kind)
        {
            return self.advance();
        }
        self.panicMode = 1;
        return self.current;
    }

    bool atEnd() { return self.current.kind == TokenKind::Eof; }
    NodeId noneNode() { return self.ctx.noneNode(); }
    NodeId allocNode() { return self.ctx.allocNodeSlot(); }

    ParserMark save()
    {
        ParserMark m;
        m.cur = self.lexer.cur;
        m.lineStart = self.lexer.lineStart;
        m.line = self.lexer.line;
        m.current = self.current;
        m.previous = self.previous;
        m.panicMode = self.panicMode;
        return m;
    }

    void restore(ParserMark m)
    {
        self.lexer.cur = m.cur;
        self.lexer.lineStart = m.lineStart;
        self.lexer.line = m.line;
        self.current = m.current;
        self.previous = m.previous;
        self.panicMode = m.panicMode;
        self.lexer.token = m.current;
    }

    bool consumeGreater()
    {
        if (self.check(TokenKind::Greater)) { self.advance(); return true; }
        if (self.check(TokenKind::Shr))
        {
            Token t = self.current;
            u8* curBefore = self.lexer.cur;
            self.advance();
            Token gt;
            gt.kind = TokenKind::Greater;
            gt.data.ptr = t.data.ptr + 1;
            gt.data.len = 1;
            gt.line = t.line;
            gt.col = t.col + 1;
            gt.info = null;
            self.lexer.cur = self.lexer.cur - 1;
            self.current = gt;
            self.lexer.token = gt;
            return true;
        }
        return false;
    }
}
