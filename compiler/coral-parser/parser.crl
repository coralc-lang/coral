/* parser/parser.crl — parser state and token stream */

import "../coral-common/token" { Token, TokenKind }
import "../coral-lexer/lexer" { Lexer }

pub struct Parser
{
    Lexer* lexer;
    Token current;
    Token previous;
    u32 panicMode;
    u32 nodeCount;
}

extend Parser
{
    Parser init(Lexer* lexer)
    {
        Parser p;
        p.lexer = lexer;
        p.panicMode = 0;
        p.nodeCount = 0;
        Lexer_nextToken(lexer);
        p.current = lexer.token;
        p.previous = lexer.token;
        return p;
    }

    Token advance()
    {
        self.previous = self.current;
        Lexer_nextToken(self.lexer);
        self.current = self.lexer.token;
        return self.previous;
    }

    bool check(TokenKind kind)
    {
        return self.current.kind == kind;
    }

    bool match(TokenKind kind)
    {
        if (self.current.kind == kind)
        {
            self.advance();
            return true;
        }
        return false;
    }

    Token expect(TokenKind kind)
    {
        if (self.current.kind == kind)
        {
            return self.advance();
        }
        self.panicMode = 1;
        return self.current;
    }

    bool atEnd()
    {
        return self.current.kind == TokenKind::Eof;
    }

    NodeId noneNode()
    {
        NodeId n;
        n.index = 0;
        return n;
    }

    NodeId allocNode()
    {
        self.nodeCount = self.nodeCount + 1;
        NodeId n;
        n.index = self.nodeCount;
        return n;
    }
}
