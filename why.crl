// coralc Lexer Audit Report
// CRITICAL — Correctness Bugs
// C1. No f/F suffix for float literals
// File: compiler/coral-lexer/number.crl:172-210
// lexDecimal never checks for a trailing f/F suffix. Input 3.14f lexes as two tokens: Float("3.14") + Ident("f"). The parser then sees a float followed by an identifier, which is a parse error or silent misinterpretation.
// // number.crl:200-209 — no f/F check anywhere
// Token token;
// if (isFloat) token = self.makeToken(TokenKind::Float, start);
// else token = self.makeToken(TokenKind::Dec, start);
// if (!isFloat && !self.isAtEnd() && (self.cur[0] == 'u' || self.cur[0] == 'U') && ...)
// Proper approach: Clang's NumericLiteralParser consumes f/F/l/L suffixes and sets a isFloat flag on the resulting APFloat. The suffix should be part of the token, not a separate identifier.
// C2. Identifier table is fixed at 256 entries and never resizes
// File: compiler/coral-lexer/table.crl:44-76, compiler/coral-frontend/analyze.crl:536
// // analyze.crl:536
// IdentEntry* entries = (IdentEntry*)malloc(256 * sizeof(IdentEntry));
// idents.init(entries, 256);
// The table is allocated with 256 slots and never resized. When full, get() returns null for every new identifier. Since get() also inserts on lookup (see D4), the table fills with user identifiers after 256 unique ones. Any identifier beyond that silently fails to resolve — keywords still work (inserted first), but user identifiers beyond the 256th are treated as unknown.
// Proper approach: Clang's IdentifierTable uses a resizable hash table (typically starting at 1024+ and doubling). The table should grow when load factor exceeds ~0.7.
// C3. decodeUtf8 accepts invalid UTF-8 (overlong encodings, surrogates)
// File: compiler/coral-lexer/ident.crl:9-42
// // ident.crl:15-21 — no check for overlong 2-byte (0xC0-0xC1) or surrogates
// if (b0 < 0xE0) {
//     if (buf + 1 >= bufEnd) { outLen[0] = 0; return 0; }
//     u8 b1 = buf[1];
//     if ((b1 & 0xC0) != 0x80) { outLen[0] = 0; return 0; }
//     outLen[0] = 2;
//     return ((u32)(b0 & 0x1F) << 6) | ((u32)(b1 & 0x3F));
// }
// - 0xC0 0x80 (overlong NUL) is accepted as valid 2-byte UTF-8.
// - 0xED 0xA0 0x80 (UTF-16 surrogate U+D800 encoded in UTF-8) is accepted.
// - 0xF5-0xF7 (beyond U+10FFFF) fall through to the b0 < 0xF8 branch and are accepted.
// Proper approach: Clang's ConvertUTF8toUTF32 rejects overlong encodings (b0 < 0xC2 for 2-byte), surrogates (b0 == 0xED && b1 >= 0xA0), and codepoints > 0x10FFFF.
// C4. \u and \U escapes accept invalid codepoints
// File: compiler/coral-lexer/escape.crl:56-104
// // escape.crl:63-71 — no validation of resulting codepoint
// for (usize i = 0; i < 4; i++) {
//     u8 h = ptr[2 + i];
//     u8 val;
//     if (h >= '0' && h <= '9') val = h - '0';
//     else if ((h | 0x20) >= 'a' && (h | 0x20) <= 'f') val = (h | 0x20) - 'a' + 10;
//     else { valid = false; break; }
//     cp = (cp << 4) | val;
// }
// \uD800 (surrogate) and \U00110000 (> U+10FFFF) are accepted without error. Clang validates the resulting codepoint against the Unicode range and rejects surrogates.
// C5. No l/L suffix support for integers
// File: compiler/coral-lexer/number.crl:90-94, 203-207
// Only u/U is checked. 123l or 123L lexes as Dec("123") + Ident("l"). There is no way to represent a long suffix.
// // number.crl:90 — only u/U
// if (!self.isAtEnd() && (self.cur[0] == 'u' || self.cur[0] == 'U') && self.numSuffixBoundary(self.cur + 1))
// C6. numFlags is a single bit — cannot represent suffix combinations
// File: compiler/coral-common/token.crl:160
// u8 numFlags;    // bit0: unsigned suffix (255u)
// Only one bit for "unsigned". Cannot represent l, ul, ll, ull, etc. Clang uses a proper Suffix enum with flags for Unsigned, Long, LongLong, Float, Float128, etc.
// HIGH — Design Naivety
// D1. Hardcoded Unicode ranges for XID_Start / XID_Continue
// File: compiler/coral-lexer/ident.crl:44-86
// // ident.crl:47-71 — 25+ hardcoded ranges, incomplete and unmaintainable
// if (cp >= 0x00C0 && cp <= 0x06FF) return true;
// if (cp >= 0x0700 && cp <= 0x07BF) return true;
// // ... 23 more ranges ...
// This is a massive hack. Unicode XID_Start/XID_Continue are defined by property tables in DerivedCoreProperties.txt, with thousands of codepoints. The hardcoded ranges:
// - Accept many non-XID codepoints (e.g., 0x00D7 multiplication sign is in range 0x00C0-0x06FF but is NOT XID_Start).
// - Reject many valid XID codepoints that fall in gaps between the hardcoded ranges.
// - Will break with every new Unicode version.
// Proper approach: Generate tables from Unicode data files at build time (like Clang's UnicodeData tables), or use a binary-search over a sorted codepoint array.
// D2. get() inserts on lookup — conflates lookup with interning
// File: compiler/coral-lexer/table.crl:38-76
// IdentifierInfo* get(u8* name, usize len)
// {
//     // ...
//     if (!e->occupied)
//     {
//         e->info.name = name;   // <-- inserts on lookup!
//         e->info.nameLen = len;
//         // ...
//         return &e->info;
//     }
// }
// Every call to get() mutates the table. This means:
// - The table fills with every identifier ever seen (not just keywords).
// - Combined with C2 (fixed 256 entries), the table is exhausted by user code.
// - There is no separation between "lookup" and "insert".
// Proper approach: Clang separates IdentifierInfo::get() (lookup or insert) from IdentifierTable::get() (pure lookup). The interner is a separate concern.
// D3. Float literals never parsed to double
// File: compiler/coral-parser/expr.crl:315
// TokenKind::Float => {
//     Token tok = self.advance();
//     return self.storeExpr(ExprKind::FloatLit{ .value = self.ctx.intern(tok.data.ptr, tok.data.len) });
// },
// The float value is interned as a raw string slice. No strtod is ever called. This means:
// - No validation of float syntax at lex time.
// - No conversion to double — the string is passed through to codegen.
// - 1e999 (overflow to infinity) is not detected.
// Proper approach: Clang's NumericLiteralParser calls APFloat::convertFromString and checks for overflow/invalid.
// D4. parseInteger breaks on overflow, returning partial value
// File: compiler/coral-lexer/number.crl:36-45
// u64 prod = value * (u64)base;
// if (value != 0 && prod / (u64)base != value) {
//     self.reportError(..., "integer literal out of range");
//     break;  // <-- returns partial value
// }
// On overflow, the function returns the partially-parsed value (digits up to the overflow point). The parser then uses this truncated value silently. Clang computes the full value (with wrapping) and emits a warning — the token is still valid.
// D5. No hex float literals (0x1.8p1)
// File: compiler/coral-lexer/number.crl:62-83
// lexNumber dispatches to lexHex for 0x prefix, but lexHex only accepts hex digits and _. A . or p in a hex float causes the token to end early, and the .8p1 is lexed as separate tokens.
// D6. lexDecimal exponent allows _ separators
// File: compiler/coral-lexer/number.crl:190
// while (digits < self.bufEnd && ((digits[0] >= '0' && digits[0] <= '9') || digits[0] == '_')) digits++;
// 1e1_0 is accepted as 1e10. Digit separators in exponents are non-standard and inconsistent with typical C behavior.
// D7. lexString silently allows multi-line strings
// File: compiler/coral-lexer/string.crl:32-35
// if (c =='\n') {
//     self.line++;
//     self.lineStart = self.cur + 1;
// }
// self.cur++;  // <-- continues past newline without error
// A string literal spanning multiple lines is accepted without any diagnostic. Clang rejects this with "missing terminating " character".
// D8. No nested block comments
// File: compiler/coral-lexer/skip_ws.crl:29-55
// else if (self.cur[0] == '*' && self.cur + 1 < self.bufEnd && self.cur[1] == '/')
// {
//     self.cur += 2;
//     closed = true;
//     break;  // <-- first */ closes, no nesting
// }
// C does not nest block comments, so this is technically C-compatible. But it's worth noting as a design limitation — Clang supports nested block comments in C++ mode as an extension.
// MEDIUM — Code Quality / Maintainability
// M1. isXidStart ASCII check uses (cp | 0x20) trick
// File: compiler/coral-lexer/ident.crl:46
// if (cp < 128) return (cp | 0x20) >= 'a' && (cp | 0x20) <= 'z' || cp == '_';
// This is a hack that works for ASCII but is unclear. cp >= 'A' && cp <= 'Z' || cp >= 'a' && cp <= 'z' || cp == '_' is clearer and compiles to the same thing.
// M2. lexRawString bounds checking is convoluted
// File: compiler/coral-lexer/string.crl:72-84
// usize idx = (usize)(self.cur + 1 + i - self.bufStart);
// if (idx >= (usize)(self.bufEnd - self.bufStart)) { ... }
// The arithmetic self.cur + 1 + i - self.bufStart is correct but hard to read. A local remaining = self.bufEnd - self.cur would be clearer and less error-prone.
// M3. lexNumber checks start[0] == '0' three times redundantly
// File: compiler/coral-lexer/number.crl:64-81
// if (!self.isAtEnd() && self.cur[0] == 'x' && (usize)(self.cur - start) == 1 && start[0] == '0')
// if (!self.isAtEnd() && self.cur[0] == 'b' && (usize)(self.cur - start) == 1 && start[0] == '0')
// if (!self.isAtEnd() && self.cur[0] == 'o' && (usize)(self.cur - start) == 1 && start[0] == '0')
// The start[0] == '0' check is repeated three times. A single bool startsWithZero = (start[0] == '0') would be cleaner.
// M4. No error recovery mechanism
// File: compiler/coral-lexer/lexer.crl:93-94
// self.reportErrorCode(ErrorCode::LexUnknownChar, ...);
// return self.makeToken(TokenKind::Unknown, start);
// After an unknown character, the lexer advances by one byte and continues. There is no synchronization strategy (e.g., skip to next whitespace/newline). This can cascade errors.
// M5. c prefix inconsistency
// File: compiler/coral-lexer/lexer.crl:36
// if ((c == 'u' || c == 'U' || c == 'c') && !self.isAtEnd() && self.cur[0] == '"')
// c"..." is treated as a string literal, but c'...' is not handled — c followed by ' lexes as identifier c + char literal. This is inconsistent.
// Summary Table
// #	Severity
// C1	Critical
// C2	Critical
// C3	Critical
// C4	Critical
// C5	Critical
// C6	Critical
