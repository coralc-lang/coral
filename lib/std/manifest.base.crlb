# std base manifest — platform manifests extend this file.
# Import paths inside std sources are platform-neutral
# (`memory::mman`, `collections::vec`, ...). The extending manifest
# sets `platform_root`; the builder resolves a neutral path by searching
# `<platform_root>/` first, then the base tree — so a platform may
# override any portable file.
#
# See coral-docs/builder_incomplete.md — include/extends/platform_root
# resolution is not implemented in the builder yet.

schema = 1;
strict = true;

build "std" {
    root          = "lib/std/";
    modules       = ["std"];
    platform_root = "";
}
