@[[no_warn_unsafe]]

mod std = import(lib, "std");
mod core = import(lib, "core");

void _writeStr(i32 fd, str s)
{
    if (s.len > 0) std::libc::write(fd, s.ptr, s.len);
}

i32 _fprintI8(i32 fd, i8 v)
{
    std::string::String s = std::fmt::formatInt((i64)v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintI16(i32 fd, i16 v)
{
    std::string::String s = std::fmt::formatInt((i64)v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintI32(i32 fd, i32 v)
{
    std::string::String s = std::fmt::formatInt((i64)v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintI64(i32 fd, i64 v)
{
    std::string::String s = std::fmt::formatInt(v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintU8(i32 fd, u8 v)
{
    std::string::String s = std::fmt::formatUint((u64)v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintU16(i32 fd, u16 v)
{
    std::string::String s = std::fmt::formatUint((u64)v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintU32(i32 fd, u32 v)
{
    std::string::String s = std::fmt::formatUint((u64)v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintU64(i32 fd, u64 v)
{
    std::string::String s = std::fmt::formatUint(v, 10u, false);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintF32(i32 fd, f32 v)
{
    u8 buf[64];
    i32 len = std::libc::snprintf(buf, 64u, "%.6g", v);
    if (len > 0) std::libc::write(fd, buf, (usize)len);
    return len;
}

i32 _fprintF64(i32 fd, f64 v)
{
    u8 buf[64];
    i32 len = std::libc::snprintf(buf, 64u, "%.15g", v);
    if (len > 0) std::libc::write(fd, buf, (usize)len);
    return len;
}

i32 _fprintBool(i32 fd, bool v)
{
    if (v) { std::libc::write(fd, "true", 4u); return 4; }
    else { std::libc::write(fd, "false", 5u); return 5; }
}

i32 _fprintChar(i32 fd, u8 v)
{
    std::libc::write(fd, &v, 1u);
    return 1;
}

i32 _fprintPtr(i32 fd, const rawptr v)
{
    std::string::String s = std::fmt::formatHex((u64)v, true);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintCstr(i32 fd, const std.cchar* s)
{
    usize len = std::libc::strlen(s);
    if (len > 0) std::libc::write(fd, s, len);
    return (i32)len;
}

i32 _fprintBytes(i32 fd, const std.cchar* ptr, usize len)
{
    if (ptr && len > 0) std::libc::write(fd, ptr, len);
    return (i32)len;
}

inline void _fprintNewline(i32 fd)
{
    std::libc::write(fd, "\n", 1u);
}

inline void _fprintFlush(i32 fd)
{
    (void)fd;
}

i32 _fprintHex(i32 fd, u64 v)
{
    std::string::String s = std::fmt::formatHex(v, true);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

i32 _fprintBin(i32 fd, u64 v)
{
    std::string::String s = std::fmt::formatBin(v, true);
    _writeStr(fd, s.asView());
    i32 len = (i32)s.len;
    s.free();
    return len;
}

// womdering if i should inline this funtions.
// cuz calling a funtion to call another funtion
// taking the same args still requires stack setup
// in the surrent ir. maybe ill add an optimization for it

i32 _sysReadByte()
{
    return std::libc::getchar();
}

usize _sysReadLine(u8* buf, usize maxBytes)
{
    if (maxBytes == 0u) return 0;
    usize i = 0;
    while (i < maxBytes - 1u)
    {
        i32 c = std::libc::getchar();
        if (c < 0 || c == '\n') break;
        if (c != '\r')
        {
            buf[i] = (u8)c;
            ++i;
        }
    }
    buf[i] = 0;
    return i;
}

void _fprintOne<T>(i32 fd, T val)
{
    comptime
    {
        if (T == i8) { _fprintI8(fd, (i8)val); return; }
        if (T == i16) { _fprintI16(fd, (i16)val); return; }
        if (T == i32) { _fprintI32(fd, (i32)val); return; }
        if (T == i64) { _fprintI64(fd, (i64)val); return; }
        if (T == u8) { _fprintU8(fd, (u8)val); return; }
        if (T == u16) { _fprintU16(fd, (u16)val); return; }
        if (T == u32) { _fprintU32(fd, (u32)val); return; }
        if (T == u64) { _fprintU64(fd, (u64)val); return; }
        if (T == f32) { _fprintF32(fd, (f32)val); return; }
        if (T == f64) { _fprintF64(fd, (f64)val); return; }
        if (T == bool) { _fprintBool(fd, (bool)val); return; }
        if (T == std.cchar) { _fprintChar(fd, (std.cchar)val); return; }
        if (T == (const std.cchar*) || T == (std.cchar*))
        {
            _fprintBytes(fd, (const std.cchar*)val, std::libc::strlen((const std.cchar*)val));
            return;
        }
        if (T == str) { _fprintBytes(fd, val.ptr, val.len); return; }
        if (T == std::string::String) { _fprintBytes(fd, val.ptr, val.len); return; }
        if (T == (rawptr)) { _fprintPtr(fd, (const rawptr)val); return; }
        if (T == Spaces)
        {
            Spaces v = val;
            for (usize i = 0u; i < v.count; ++i) _fprintChar(fd, ' ');
            return;
        }
        if (T == Repeat)
        {
            Repeat v = val;
            for (usize i = 0u; i < v.count; ++i) _fprintChar(fd, v.ch);
            return;
        }
        if (T == Hex)
        {
            Hex v = val;
            _fprintHex(fd, v.value);
            return;
        }
        if (T == Bin)
        {
            Bin v = val;
            _fprintBin(fd, v.value);
            return;
        }
        if (T == Fixed)
        {
            Fixed v = val;
            std::string::String s = std::fmt::formatFloat(v.value, v.precision);
            _writeStr(fd, s.asView());
            s.free();
            return;
        }
    }
}

void _printOne<T>(T val) { _fprintOne(1, val); }
void _eprintOne<T>(T val) { _fprintOne(2, val); }

// Variadic, no runtime loop
// i was thinking of adding a '!'. then, in compile time
// variadics, it'll be differentiated from libc runtime
// variadics, say, print<T!::fmt::.args>(T!::fmt::. args); ion know
// if there is a need. you nigga tell me
// and then like zig, amybe a comptime T, telling the compiler
// the type will be evaluated at compile tim,
// rather thatn filling manually
// you the reader, whatchu think?
pub void print!<T...>(T... args)
{
    comptime {
        for (var arg : args) _fprintOne(1, arg);
    }
}

pub void nprint!<T...>(T... args)
{
    comptime {
        for (var arg : args) _fprintOne(1, arg);
    }
    _fprintNewline(1);
}

pub void eprint!<T...>(T::fmt::. args)
{
    for (var arg : args) _fprintOne(2, arg);
}

pub void neprint!<T...>(T::fmt::. args)
{
    for (var arg : args) _fprintOne(2, arg);
    _fprintNewline(2);
}

// Print manipulator types
pub struct Spaces { u64 count; }
pub struct Repeat { u8 ch; u64 count; }
pub struct Hex { u64 value; }
pub struct Bin { u64 value; }
pub struct Fixed { f64 value; u64 precision; }

pub Spaces spaces(u64 count)
{
    Spaces s;
    s.count = count;
    return s;
}

pub Repeat repeat(u8 ch, u64 count)
{
    Repeat r;
    r.ch = ch;
    r.count = count;
    return r;
}

pub Hex hex(u64 value)
{
    Hex h;
    h.value = value;
    return h;
}

pub Bin bin(u64 value)
{
    Bin b;
    b.value = value;
    return b;
}

pub Fixed fixed(f64 value, u64 precision)
{
    Fixed f;
    f.value = value;
    f.precision = precision;
    return f;
}

pub void flush()
{
    _fprintFlush(1);
}

i64 _readI64()
{
    std::string::String s = std::string::String::new();
    readLine(&s);
    bool ok;
    i64 v = s.asView().parseI64(&ok);
    s.free();
    return v;
}

u64 _readU64()
{
    std::string::String s = std::string::String::new();
    readLine(&s);
    bool ok;
    u64 v = s.asView().parseU64(&ok);
    s.free();
    return v;
}

f64 _readF64()
{
    std::string::String s = std::string::String::new();
    readLine(&s);
    bool ok;
    f64 v = parseF64(s.asView(), &ok);
    s.free();
    return v;
}

bool _readBool()
{
    std::string::String s = std::string::String::new();
    readLine(&s);
    str sv = s.asView();
    sv = sv.trim();
    bool result = sv.equals(str::fromCstr("true")) ||
                            sv.equals(str::fromCstr("1")) || 
                            v.equals(str::fromCstr("yes"));
    s.free();
    return result;
}

pub i64 parseI64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    bool neg = false;

    if (sv.ptr[0] == '-')
    {
        neg = true;
        ++i;
    } else if (sv.ptr[0] == '+')
    {
        ++i;
    }
    if (i == sv.len) return 0;

    u64 result = 0;
    u64 limit = neg ? 9223372036854775808u : (u64)core::limits::INT64_MAX;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (limit - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    if (neg)
    {
        if (result == 9223372036854775808u) return core::limits::INT64_MIN;
        return -(i64)result;
    }
    return (i64)result;
}

pub u64 parseU64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    if (sv.ptr[0] == '+') ++i;
    if (i == sv.len) return 0;
    u64 result = 0;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (0xFFFFFFFFFFFFFFFFu - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    return result;
}

pub f64 parseF64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0.0;

    u8 buf[256];
    usize len = sv.len < 255u ? sv.len : 255u;
    std::mman::copy<u8>(buf, (const u8*)sv.ptr, len);
    buf[len] = 0;

    std.cchar* endptr;
    f64 result = std::libc::strtod(buf, &endptr);
    if (endptr == buf) return 0.0;
    while (*endptr == ' ' || *endptr == '\t' || *endptr == '\n' || *endptr == '\r') endptr++;
    if (*endptr != 0) return 0.0;
    *ok = true;
    return result;
}

pub u8 readChar()
{
    i32 b = std::libc::getchar();
    return (u8)(b < 0 ? 0 : b);
}

pub bool readLine(std::string::String* out)
{
    out*.clear();
    for (;;)
    {
        i32 b = std::libc::getchar();
        if (b < 0) return !out*.isEmpty();
        if (b == '\n') return true;
        if (b != '\r') out*.pushChar((u8)b);
    }
}

pub void read<T>(T* out)
{
    comptime
    {
        if (T == i8) { *out = (i8)_readI64(); return; }
        if (T == i16) { *out = (i16)_readI64(); return; }
        if (T == i32) { *out = (i32)_readI64(); return; }
        if (T == i64) { *out = _readI64(); return; }
        if (T == u8) { *out = (u8)_readU64(); return; }
        if (T == u16) { *out = (u16)_readU64(); return; }
        if (T == u32) { *out = (u32)_readU64(); return; }
        if (T == u64) { *out = _readU64(); return; }
        if (T == f32) { *out = (f32)_readF64(); return; }
        if (T == f64) { *out = _readF64(); return; }
        if (T == bool) { *out = _readBool(); return; }
        if (T == std.cchar) { *out = readChar(); return; }
        if (T == std::string::String) { readLine(out); return; }
    }
}

pub T readVal<T>()
{
    T result;
    read(&result);
    return result;
}