mod std = import(lib, "std");

pub struct TempFile
{
    i32 fd;
    std::string::String path;
    bool autoDelete;

    static TempFile create(str prefix, str suffix)
    {
        std::string::String tmpl = std::string::String::new();
        tmpl.appendView(str::fromCstr("/tmp/"));
        tmpl.appendView(prefix);
        tmpl.appendView(suffix);
        tmpl.appendView(str::fromCstr("XXXXXX"));

        u8* buf = std::mman::alloc<u8>(tmpl.len + 1);
        if (buf == null) { tmpl.free(); TempFile f; f.fd = -1; f.path = std::string::String::new(); f.autoDelete = false; return f; }
        std::mman::copy<u8>(buf, (const u8*)tmpl.asView().ptr, tmpl.len);
        buf[tmpl.len] = 0;

        i32 fd = std::libc::mkstemp(buf);
        std::string::String actualPath;
        if (fd >= 0)
            actualPath = std::string::String::fromView(str::fromParts(buf, tmpl.len));
        else
            actualPath = std::string::String::new();
        std::mman::dealloc<u8>(buf);
        tmpl.free();

        TempFile f;
        f.fd = fd;
        f.path = actualPath;
        f.autoDelete = true;
        return f;
    }

    void dispose()
    {
        if (self.fd >= 0) std::libc::close(self.fd);
        if (self.autoDelete && !self.path.isEmpty())
            std::libc::unlink((const u8*)self.path.asView().ptr);
        self.path.free();
        self.fd = -1;
    }

    i32 fd() { return self.fd; }
    str pathStr() { return self.path.asView(); }

    void setAutoDelete(bool ad) { self.autoDelete = ad; }
}

pub struct TempDir
{
    std::string::String path;
    bool autoDelete;

    static TempDir create(str prefix)
    {
        std::string::String tmpl = std::string::String::new();
        tmpl.appendView(str::fromCstr("/tmp/"));
        tmpl.appendView(prefix);
        tmpl.appendView(str::fromCstr("XXXXXX"));

        u8* buf = std::mman::alloc<u8>(tmpl.len + 1);
        if (buf == null) { tmpl.free(); TempDir d; d.path = std::string::String::new(); d.autoDelete = false; return d; }
        std::mman::copy<u8>(buf, (const u8*)tmpl.asView().ptr, tmpl.len);
        buf[tmpl.len] = 0;

        u8* result = std::libc::mkdtemp(buf);
        std::string::String actualPath;
        if (result != null)
            actualPath = std::string::String::fromView(str::fromParts(buf, tmpl.len));
        else
            actualPath = std::string::String::new();
        std::mman::dealloc<u8>(buf);
        tmpl.free();

        TempDir d;
        d.path = actualPath;
        d.autoDelete = true;
        return d;
    }

    void dispose()
    {
        if (self.autoDelete && !self.path.isEmpty())
            std::libc::rmdir((const u8*)self.path.asView().ptr);
        self.path.free();
    }

    str pathStr() { return self.path.asView(); }
    void setAutoDelete(bool ad) { self.autoDelete = ad; }
    bool isValid() { return !self.path.isEmpty(); }
}

trait drop
{
    void drop();
}

TempFile::drop
{
    void drop()
    {
        self.dispose();
    }
}

TempDir::drop
{
    void drop()
    {
        self.dispose();
    }
}