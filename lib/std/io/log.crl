mod std = import(lib, "std");

pub enum LogLevel
{
    Debug,
    Info,
    Warn,
    Error,
    Fatal
}

pub struct Logger
{
    LogLevel minLevel;
    std::string::String name;

    Logger new(str name, LogLevel minLevel)
    {
        Logger l;
        l.name = std::string::std::string::fromView(name);
        l.minLevel = minLevel;
        return l;
    }

    void dispose()
    {
        self.name.free();
    }

    void setLevel(LogLevel level) { self.minLevel = level; }

    bool enabled(LogLevel level) { return level >= self.minLevel; }

    void _log(LogLevel level, str msg)
    {
        if (level < self.minLevel) return;
        str label;
        if (level == LogLevel::Debug) label = "DEBUG";
        else if (level == LogLevel::Info) label = "INFO";
        else if (level == LogLevel::Warn) label = "WARN";
        else if (level == LogLevel::Error) label = "ERROR";
        else label = "FATAL";
        if (level == LogLevel::Error || level == LogLevel::Fatal)
            ios.neprint("[", label, "][", self.name.asView(), "] ", msg);
        else
            ios.nprint("[", label, "][", self.name.asView(), "] ", msg);
    }

    void debug(str msg) { self._log(LogLevel::Debug, msg); }
    void info(str msg) { self._log(LogLevel::Info, msg); }
    void warn(str msg) { self._log(LogLevel::Warn, msg); }
    void error(str msg) { self._log(LogLevel::Error, msg); }
    void fatal(str msg) { self._log(LogLevel::Fatal, msg); }
}