// memmove, memcpy, memcmp, mmep, memset... provided here

import(lib) platform::win32 { VirtualAlloc, VirtualFree };

// Win32 memory constants (porting guide §9 — defined locally, not in
// the win32 surface).
const u32 MEM_COMMIT = 0x1000;
const u32 MEM_RESERVE = 0x2000;
const u32 MEM_RELEASE = 0x8000;
const u32 PAGE_READWRITE = 4;

pub void memmove(rawptr dst, const rawptr src, usize n)
{
    if (n == 0) return;
    u8* d = (u8*)dst;
    const u8* s = (const u8*)src;
    if (d == s) return;
    if (d < s)
    {
        memcpy(dst, src, n);
        return;
    }
    usize i = n;
    while (i > 0)
    {
        i--;
        d[i] = s[i];
    }
}

pub void memcpy(rawptr dst, const rawptr src, usize n)
{
    if (n == 0) return;
    u8* d = (u8*)dst;
    const u8* s = (const u8*)src;
    usize i = 0;
    while (i + 8 <= n)
    {
        *(usize*)(d + i) = *(const usize*)(s + i);
        i += 8;
    }
    while (i < n)
    {
        d[i] = s[i];
        i++;
    }
}

// mmap: Win32 equivalent is VirtualAlloc — reserve and commit RW pages.
// The 6-arg POSIX signature is kept exactly so every call site (mman,
// mimalloc) stays untouched: prot/flags/fd/offset are ignored, addr is
// a placement hint (all call sites pass null). Returns null on failure.
pub rawptr mmap(rawptr addr, usize length,
                i32 prot, i32 flags,
                i32 fd, i64 offset)
{
    (void)prot;
    (void)flags;
    (void)fd;
    (void)offset;
    return VirtualAlloc(addr, (u64)length, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
}


// munmap: release the whole region back to the OS. The length argument
// is ignored — VirtualFree(MEM_RELEASE) requires a zero size and the
// base address returned by VirtualAlloc.
pub void munmap(rawptr addr, usize length)
{
    (void)length;
    VirtualFree(addr, 0, MEM_RELEASE);
}


pub void memset(rawptr dst, u8 val, usize n)
{
    u8* d = (u8*)dst;
    for (usize i = 0; i < n; i++)
        d[i] = val;
}

pub i32 memcmp(const rawptr a, const rawptr b, usize n)
{
    const u8* pa = (const u8*)a;
    const u8* pb = (const u8*)b;
    for (usize i = 0; i < n; i++)
    {
        if (pa[i] < pb[i]) return -1;
        if (pa[i] > pb[i]) return 1;
    }
    return 0;
}