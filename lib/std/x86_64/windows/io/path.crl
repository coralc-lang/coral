import(lib) std::text::string { String };
import(lib) std::option { Option };

const u8 SEP = '/';
const u8 ALT_SEP = '\\';
str CUR_DIR = ".";
str PARENT_DIR = "..";
str SEP_STR = "/";

// None when the path has no separator — absence, not an error
pub Option<usize> findLastSep(str p)
{
    for (usize i = p.len; i > 0; i--)
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) return Option<usize>::Some { .value = i - 1 };
    return Option<usize>::None;
}

pub bool isAbsolute(str p)
{
    return p.len > 0 && p.ptr[0] == SEP;
}

pub bool hasExtension(str p)
{
    usize lastDot = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    if (lastDot >= p.len) return false;
    Option<usize> lastSep = findLastSep(p);
    return lastSep.isNone() || lastDot > lastSep.unwrap();
}

// None when there is no extension — absence, not an error
pub Option<str> extension(str p)
{
    usize lastDot = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    if (lastDot >= p.len) return Option<str>::None;
    Option<usize> lastSep = findLastSep(p);
    if (lastSep.isSome() && lastDot <= lastSep.unwrap()) return Option<str>::None;
    return Option<str>::Some { .value = str::fromParts(p.ptr + lastDot, p.len - lastDot) };
}

pub str stem(str p)
{
    usize lastDot = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    usize lastSep = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    usize start = lastSep < p.len ? lastSep + 1 : 0;
    usize end = lastDot < p.len ? lastDot : p.len;
    if (end <= start) return p.len > 0 ? str::fromParts(p.ptr + start, p.len - start) : "";
    return str::fromParts(p.ptr + start, end - start);
}

// None when the path has no parent (no separator) — absence, not an error
pub Option<str> parent(str p)
{
    usize lastSep = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    if (lastSep > p.len) return Option<str>::None;
    if (lastSep == 0) return Option<str>::Some { .value = "/" };
    return Option<str>::Some { .value = str::fromParts(p.ptr, lastSep) };
}

pub str filename(str p)
{
    usize lastSep = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    if (lastSep > p.len) return p;
    return str::fromParts(p.ptr + lastSep + 1, p.len - lastSep - 1);
}

pub String join(str a, str b)
{
    String out = String::new();
    out.appendView(a);
    if (a.len > 0 && a.ptr[a.len - 1] != SEP && a.ptr[a.len - 1] != ALT_SEP)
        out.pushChar(SEP);
    out.appendView(b);
    return out;
}

pub String normalize(str p)
{
    String out = String::new();
    usize i = 0;
    bool needSep = false;
    if (isAbsolute(p)) { out.pushChar(SEP); i++; }
    while (i < p.len)
    {
        if (p.ptr[i] == SEP || p.ptr[i] == ALT_SEP) { i++; continue; }
        usize segStart = i;
        while (i < p.len && p.ptr[i] != SEP && p.ptr[i] != ALT_SEP) i++;
        str seg = str::fromParts(p.ptr + segStart, i - segStart);
        if (seg.len == 0) {}
        else if (seg.len == 1 && seg.ptr[0] == '.') {}
        else
        {
            if (needSep) out.pushChar(SEP);
            out.appendView(seg);
            needSep = true;
        }
    }
    if (out.isEmpty()) out.appendView(CUR_DIR);
    return out;
}

pub String absolute(str base, str rel)
{
    if (isAbsolute(rel)) return normalize(rel);
    String joined = join(base, rel);
    String norm = normalize(joined.asView());
    joined.free();
    return norm;
}

pub String changeExtension(str p, str newExt)
{
    Option<str> ext = extension(p);
    String out = String::new();
    if (ext.isSome())
        out.appendView(str::fromParts(p.ptr, p.len - ext.unwrap().len));
    else
        out.appendView(p);
    if (newExt.len > 0)
    {
        if (newExt.ptr[0] != '.') out.pushChar('.');
        out.appendView(newExt);
    }
    return out;
}
