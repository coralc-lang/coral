// Win32 port: sem_* -> kernel32 semaphore HANDLE
// (CreateSemaphoreA / WaitForSingleObject / ReleaseSemaphore).
// All externs below come from lib/platform/win32.crl — no local externs.
import(lib) platform::win32 { CreateSemaphoreA, ReleaseSemaphore, WaitForSingleObject, CloseHandle };

const u32 INFINITE = 0xFFFFFFFF;
// FLAG: POSIX sem_init has no upper bound beyond SEM_VALUE_MAX (2^31-1 on
// Linux); Win32 CreateSemaphoreA requires an explicit maximum count, so we
// pass SEM_VALUE_MAX, the closest match.
const i32 SEM_MAX = 0x7FFFFFFF;

pub struct Semaphore
{
    // FLAG (size changed): the old rawptr impl[8] sem_t buffer becomes a
    // Win32 HANDLE — a pointer-sized value (8 bytes on x64), not a buffer,
    // so it is stored by value and passed by value to the APIs.
    rawptr impl;

    bool init(u32 value)
    {
        self.impl = CreateSemaphoreA(null, (i32)value, SEM_MAX, null);
        return self.impl != null;
    }

    void destroy()
    {
        if (self.impl != null)
        {
            CloseHandle(self.impl);
            self.impl = null;
        }
    }

    void wait()
    {
        WaitForSingleObject(self.impl, INFINITE);
    }

    bool tryWait()
    {
        // WAIT_OBJECT_0 = 0 (signalled), WAIT_TIMEOUT = 0x102.
        return WaitForSingleObject(self.impl, 0) == 0;
    }

    void post()
    {
        ReleaseSemaphore(self.impl, 1, null);
    }

    i32 value()
    {
        // FLAG: sem_getvalue has NO Win32 equivalent — there is no way to
        // query a semaphore's count. This returns 0 as a placeholder
        // approximation; callers must not rely on it (always-succeed or
        // fabricated counts would be wrong).
        return 0;
    }
}
