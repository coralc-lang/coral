// Win32 port: pthread_mutex_* -> CRITICAL_SECTION.
import(lib) platform::win32 { InitCriticalSection, DeleteCriticalSection, EnterCriticalSection, LeaveCriticalSection, TryEnterCriticalSection };

pub struct Mutex
{
    // CRITICAL_SECTION is 40 bytes on x64 — FLAGGED size assumption
    // (RTL_CRITICAL_SECTION: ptr 8 + LONG 4 + LONG 4 + HANDLE 8 +
    //  HANDLE 8 + ULONG_PTR 8 = 40). The array form keeps `self._cs`
    //  passing the ADDRESS of the section to the externs, matching how
    //  the old code passed its rawptr impl[6] buffer to pthread.
    u8 _cs[40];

    void init() {
        InitCriticalSection(self._cs);
    }

    void initRecursive()
    {
        // FLAG: Win32 CRITICAL_SECTION is always recursive (owned per
        // thread with a recursion count), so PTHREAD_MUTEX_RECURSIVE
        // (type 1) needs no equivalent — plain init is the same thing.
        InitCriticalSection(self._cs);
    }

    void destroy() { DeleteCriticalSection(self._cs); }
    void lock() { EnterCriticalSection(self._cs); }
    void unlock() { LeaveCriticalSection(self._cs); }
    bool tryLock() { return TryEnterCriticalSection(self._cs); }
}
