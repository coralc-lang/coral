// FLAG: signal and raise stay on the CRT (msvcrt) per §9 — the libc
// surface provides them and msvcrt exports POSIX-like signal/raise, so
// this file keeps its platform::libc import for that subset only.
import(lib) platform::libc { signal, raise };
import(lib) platform::win32 { CloseHandle };

// kill has no Win32 equivalent — local externs (not in win32.crl).
pub extern rawptr OpenProcess(u32 dwDesiredAccess, bool bInheritHandle, u32 dwProcessId);
pub extern bool TerminateProcess(rawptr hProcess, u32 uExitCode);

const u32 PROCESS_TERMINATE = 1;

pub const i32 SIGABRT = 6;
pub const i32 SIGALRM = 14;
pub const i32 SIGBUS = 7;
pub const i32 SIGCHLD = 17;
pub const i32 SIGCONT = 18;
pub const i32 SIGFPE = 8;
pub const i32 SIGHUP = 1;
pub const i32 SIGILL = 4;
pub const i32 SIGINT = 2;
pub const i32 SIGKILL = 9;
pub const i32 SIGPIPE = 13;
pub const i32 SIGQUIT = 3;
pub const i32 SIGSEGV = 11;
pub const i32 SIGSTOP = 19;
pub const i32 SIGTERM = 15;
pub const i32 SIGTSTP = 20;
pub const i32 SIGTTIN = 21;
pub const i32 SIGTTOU = 22;
pub const i32 SIGUSR1 = 10;
pub const i32 SIGUSR2 = 12;
pub const i32 SIGSYS = 31;
pub const i32 SIGTRAP = 5;
pub const i32 SIGURG = 23;
pub const i32 SIGXCPU = 24;
pub const i32 SIGXFSZ = 25;

// SIG_DFL/SIG_IGN are special pointer values, not integers.
// msvcrt uses the same values as POSIX: SIG_DFL = (void (*)(int))0,
// SIG_IGN = (void (*)(int))1. These are passed as raw usize and cast to
// function pointer.

pub const u8 SIG_DFL = 0;
pub const usize SIG_IGN = 1;

pub typedef SigHandler = void(i32);

pub void(i32) handle(i32 sig, SigHandler* handler)
{
    return signal(sig, handler);
}

pub void ignore(i32 sig)
{
    signal(sig, (SigHandler*)(usize)SIG_IGN);
}

pub void defaultHandler(i32 sig)
{
    signal(sig, (SigHandler*)(usize)SIG_DFL);
}

// FLAG: no POSIX kill() on Win32 — best-effort strategy chosen:
// OpenProcess(PROCESS_TERMINATE) + TerminateProcess + CloseHandle.
// Differences from POSIX kill: no signal delivery (the target's handlers
// never run, this is a hard termination), sig is used only as the exit
// code (sig == 0, the POSIX existence probe, would terminate!), and
// termination is asynchronous. Returns 0 on success, -1 on failure.
pub i32 send(i32 pid, i32 sig)
{
    rawptr h = OpenProcess(PROCESS_TERMINATE, false, (u32)pid);
    if (h == null) return -1;
    bool ok = TerminateProcess(h, (u32)sig);
    CloseHandle(h);
    return ok ? 0 : -1;
}

pub i32 raiseSig(i32 sig)
{
    return raise(sig);
}
