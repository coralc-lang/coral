import(lib) platform::libc { open, close, read, write, lseek, access, stat, mkdir, rmdir, unlink, rename, opendir, readdir, closedir, __errno_location };
import(lib) std::mman { copy };
import(lib) std::text::string { String };
import(lib) std::result { Result };

// glibc keeps errno in thread-local storage, reached through this accessor;
// the failing libc call sets it just before we read it in IoError::os.


// Shared error type for the whole io subsystem (fs is the lowest module
// everything else can import without a cycle).
pub variant IoError
{
    // errno (linux) / GetLastError (windows) from the failing call
    Os { i32 code; str op; },
    // stream ended before the requested bytes
    Eof { str op; },
    // caller-side problem, no syscall was made (bad mode, bad ip, ...)
    BadUsage { str msg; }
}

pub extend IoError
{
    // errno of the calling thread, captured right after a failed libc call
    static IoError os(str op)
    {
        return IoError::Os { .code = *__errno_location(), .op = op };
    }
}

pub const i32 O_RDONLY = 0;
pub const i32 O_WRONLY = 1;
pub const i32 O_RDWR = 2;
pub const i32 O_CREAT = 64;
pub const i32 O_TRUNC = 512;
pub const i32 O_APPEND = 1024;
pub const i32 S_IRWXU = 448;
pub const i32 S_IRUSR = 256;
pub const i32 S_IWUSR = 128;
pub const i32 S_IXUSR = 64;
pub const i32 SEEK_SET = 0;
pub const i32 SEEK_CUR = 1;
pub const i32 SEEK_END = 2;
pub const i32 F_OK = 0;
pub const i32 R_OK = 4;
pub const i32 W_OK = 2;
pub const i32 X_OK = 1;

pub distinct File = i32;
pub distinct Dir = rawptr;

// had to check to make sure the layout matches glibc x86-64 struct stat and the BSDs' old stat
pub struct Stat
{
    u64 st_dev;
    u64 st_ino;
    u64 st_nlink;
    u32 st_mode;
    u32 st_uid;
    u32 st_gid;
    u32 pad0;
    u64 st_rdev;
    i64 st_size;
    i64 st_blksize;
    i64 st_blocks;
    i64 st_atime;
    i64 st_atimeNsec;
    i64 st_mtime;
    i64 st_mtimeNsec;
    i64 st_ctime;
    i64 st_ctimeNsec;
    i64 reserved[3];
}

pub enum FileType
{
    Unknown,
    Regular,
    Directory,
    CharDevice,
    BlockDevice,
    Fifo,
    Symlink,
    Socket
}

pub Result<File, IoError> fileOpen(str path, str mode)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;

    i32 flags = -1;
    bool create = false;
    if (mode.len >= 1)
    {
        if (mode.ptr[0] == 'r') flags = O_RDONLY;
        else if (mode.ptr[0] == 'w') { flags = O_WRONLY | O_CREAT | O_TRUNC; create = true; }
        else if (mode.ptr[0] == 'a') { flags = O_WRONLY | O_CREAT | O_APPEND; create = true; }
    }
    if (flags < 0) return Result<File, IoError>::Err { .error = IoError::BadUsage { .msg = "invalid open mode" } };
    for (usize i = 1; i < mode.len; i++)
    {
        if (mode.ptr[i] == '+') { flags = (flags & ~(O_RDONLY | O_WRONLY)) | O_RDWR; }
    }
    i32 fd = open(pbuf, flags, create ? 420 : 0);
    if (fd < 0) return Result<File, IoError>::Err { .error = IoError::os("open") };
    return Result<File, IoError>::Ok { .value = (File)fd };
}

pub void fileClose(File f)
{
    close((i32)f);
}

pub Result<isize, IoError> fileRead(File f, u8* buf, usize count)
{
    isize n = read((i32)f, buf, count);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("read") };
    return Result<isize, IoError>::Ok { .value = n };
}

pub Result<isize, IoError> fileWrite(File f, const u8* buf, usize count)
{
    isize n = write((i32)f, buf, count);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("write") };
    return Result<isize, IoError>::Ok { .value = n };
}

pub Result<isize, IoError> fileSeek(File f, isize offset, i32 whence)
{
    isize n = lseek((i32)f, offset, whence);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("lseek") };
    return Result<isize, IoError>::Ok { .value = n };
}

// existence probe: false means "does not exist", the normal answer to
// the question — no errno worth propagating.
pub bool fileExists(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return access(pbuf, F_OK) == 0;
}

pub Result<bool, IoError> statPath(str path, Stat* out)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    if (stat(pbuf, (rawptr)out) != 0) return Result<bool, IoError>::Err { .error = IoError::os("stat") };
    return Result<bool, IoError>::Ok { .value = true };
}

pub FileType getFileType(const Stat* s)
{
    u32 mode = s->st_mode;
    if ((mode & 0xF000) == 0x8000) return FileType::Regular;
    if ((mode & 0xF000) == 0x4000) return FileType::Directory;
    if ((mode & 0xF000) == 0x2000) return FileType::CharDevice;
    if ((mode & 0xF000) == 0x6000) return FileType::BlockDevice;
    if ((mode & 0xF000) == 0x1000) return FileType::Fifo;
    if ((mode & 0xF000) == 0xA000) return FileType::Symlink;
    if ((mode & 0xF000) == 0xC000) return FileType::Socket;
    return FileType::Unknown;
}

pub Result<bool, IoError> createDir(str path, i32 mode)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    if (mkdir(pbuf, mode) != 0) return Result<bool, IoError>::Err { .error = IoError::os("mkdir") };
    return Result<bool, IoError>::Ok { .value = true };
}

pub Result<bool, IoError> removeDir(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    if (rmdir(pbuf) != 0) return Result<bool, IoError>::Err { .error = IoError::os("rmdir") };
    return Result<bool, IoError>::Ok { .value = true };
}

pub Result<bool, IoError> deleteFile(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    if (unlink(pbuf) != 0) return Result<bool, IoError>::Err { .error = IoError::os("unlink") };
    return Result<bool, IoError>::Ok { .value = true };
}

pub Result<bool, IoError> renameFile(str oldPath, str newPath)
{
    u8 oldBuf[4096];
    u8 newBuf[4096];
    usize olen = oldPath.len < 4095 ? oldPath.len : 4095;
    usize nlen = newPath.len < 4095 ? newPath.len : 4095;
    copy<u8>(oldBuf, (u8*)oldPath.ptr, olen);
    copy<u8>(newBuf, (u8*)newPath.ptr, nlen);
    oldBuf[olen] = 0; newBuf[nlen] = 0;
    if (rename(oldBuf, newBuf) != 0) return Result<bool, IoError>::Err { .error = IoError::os("rename") };
    return Result<bool, IoError>::Ok { .value = true };
}

// permission probe: false means "cannot access", the normal answer —
// no error info beyond that worth propagating.
pub bool canAccess(str path, i32 mode)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    return access(pbuf, mode) == 0;
}

pub Result<Dir, IoError> openDir(str path)
{
    u8 pbuf[4096];
    usize plen = path.len < 4095 ? path.len : 4095;
    copy<u8>(pbuf, (u8*)path.ptr, plen);
    pbuf[plen] = 0;
    rawptr d = opendir(pbuf);
    if (d == null) return Result<Dir, IoError>::Err { .error = IoError::os("opendir") };
    return Result<Dir, IoError>::Ok { .value = (Dir)d };
}

pub rawptr readDir(Dir dir)
{
    return readdir((rawptr)dir);
}

pub void closeDir(Dir dir)
{
    closedir((rawptr)dir);
}

pub Result<String, IoError> readFileToString(str path)
{
    Result<File, IoError> fo = fileOpen(path, "r");
    if (fo.isErr()) return Result<String, IoError>::Err { .error = fo.unwrapErr() };
    File f = fo.unwrap();
    String out = String::new();
    u8 chunk[4096];
    while (true)
    {
        Result<isize, IoError> rr = fileRead(f, (u8*)chunk, 4096);
        if (rr.isErr())
        {
            fileClose(f);
            out.free();
            return Result<String, IoError>::Err { .error = rr.unwrapErr() };
        }
        isize n = rr.unwrap();
        if (n <= 0) break;
        out.appendView(str::fromParts(chunk, (usize)n));
    }
    fileClose(f);
    return Result<String, IoError>::Ok { .value = out };
}

// glibc x86-64 struct dirent (fields we need; reclen-padded tail omitted).
// Layout verified against bits/dirent.h, d_ino u64, d_off i64, d_reclen u16,
// d_type u8, d_name cchar[256].
pub struct Dirent
{
    u64 d_ino;
    i64 d_off;
    u16 d_reclen;
    u8 d_type;
    u8 d_name[256];
}

// Read the next directory entry; false at end of stream.
pub bool readDirEntry(Dir dir, Dirent* out)
{
    rawptr raw = readDir(dir);
    if (raw == null) return false;
    copy<u8>((u8*)out, (u8*)raw, (usize)@sizeof(Dirent));
    return true;
}

// mkdir -p behavior, create every missing component of `path`.
// mode 0755 by convention here (pass 493u).
pub Result<bool, IoError> createDirRecursive(str path, i32 mode)
{
    if (path.len == 0) return Result<bool, IoError>::Err { .error = IoError::BadUsage { .msg = "empty path" } };
    Stat st;
    if (statPath(path, &st).isOk()) return Result<bool, IoError>::Ok { .value = true }; // already exists
    // find parent and recurse first
    u32 lastSlash = 0;
    bool hasSlash = false;
    for (usize i = 0; i < path.len; i++)
        if (path.ptr[i] == '/') { lastSlash = (u32)i; hasSlash = true; }
    if (hasSlash && lastSlash > 0)
    {
        Result<bool, IoError> parent = createDirRecursive(str::fromParts(path.ptr, (usize)lastSlash), mode);
        if (parent.isErr()) return parent;
    }
    return createDir(path, mode);
}

// Write an entire String to `path` (truncates).
pub Result<bool, IoError> writeFileFromString(str path, const String* data)
{
    Result<File, IoError> fo = fileOpen(path, "w");
    if (fo.isErr()) return Result<bool, IoError>::Err { .error = fo.unwrapErr() };
    File f = fo.unwrap();
    usize off = 0;
    while (off < data->len)
    {
        Result<isize, IoError> wr = fileWrite(f, data->ptr + off, data->len - off);
        if (wr.isErr())
        {
            fileClose(f);
            return Result<bool, IoError>::Err { .error = wr.unwrapErr() };
        }
        isize put = wr.unwrap();
        if (put <= 0)
        {
            fileClose(f);
            return Result<bool, IoError>::Err { .error = IoError::Os { .code = 0, .op = "write" } };
        }
        off += (usize)put;
    }
    fileClose(f);
    return Result<bool, IoError>::Ok { .value = true };
}
