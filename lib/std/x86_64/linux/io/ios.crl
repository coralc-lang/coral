// Print manipulator types
pub struct Spaces { u64 count; }
pub struct Repeat { u8 ch; u64 count; }
pub struct Hex { u64 value; }
pub struct Bin { u64 value; }
pub struct Fixed { f64 value; u64 precision; }

pub Spaces spaces(u64 count) { return Spaces { .count = count }; }
pub Repeat repeat(u8 ch, u64 count) { return Repeat { .ch = ch, .count = count }; }
pub Hex hex(u64 value) { return Hex { .value = value }; }
pub Bin bin(u64 value) { return Bin { .value = value }; }
pub Fixed fixed(f64 value, u64 precision) { return Fixed { .value = value, .precision = precision }; }
pub void flush() { _fprintFlush(1); }

static i64 _readI64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    i64 v = parseI64(s.asView(), &ok);
    s.free();
    return v;
}

static u64 _readU64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    u64 v = parseU64(s.asView(), &ok);
    s.free();
    return v;
}

static f64 _readF64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    f64 v = parseF64(s.asView(), &ok);
    s.free();
    return v;
}

static bool _readBool()
{
    String s = String::new();
    readLine(&s);
    str sv = s.asView();
    sv = sv.trim();
    bool result = sv.equals(str::fromCstr("true")) ||
                            sv.equals(str::fromCstr("1")) ||
                            sv.equals(str::fromCstr("yes"));
    s.free();
    return result;
}

pub i64 parseI64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    bool neg = false;

    if (sv.ptr[0] == '-') {
        neg = true;
        ++i;
    } else if (sv.ptr[0] == '+') {
        ++i;
    }
    if (i == sv.len) return 0;

    u64 result = 0;
    u64 limit = neg ? 9223372036854775808u : (u64)INT64_MAX;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (limit - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    if (neg) {
        if (result == 9223372036854775808u) return INT64_MIN;
        return -(i64)result;
    }
    return (i64)result;
}

pub u64 parseU64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    if (sv.ptr[0] == '+') ++i;
    if (i == sv.len) return 0;
    u64 result = 0;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (0xFFFFFFFFFFFFFFFFu - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    return result;
}

pub f64 parseF64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0.0;

    u8 buf[256];
    usize len = sv.len < 255u ? sv.len : 255u;
    copy<u8>(buf, (u8*)sv.ptr, len);
    buf[len] = 0;

    cchar* endptr;
    f64 result = strtod(buf, &endptr);
    if (endptr == buf) return 0.0;
    while (*endptr == ' ' || *endptr == '\t' || *endptr == '\n' || *endptr == '\r') endptr++;
    if (*endptr != 0) return 0.0;
    *ok = true;
    return result;
}

pub u8 readChar()
{
    i32 b = getchar();
    return (u8)(b < 0 ? 0 : b);
}

pub bool readLine(String* out)
{
    out->clear();
    loop {
        i32 b = getchar();
        if (b < 0) return !out->isEmpty();
        if (b == '\n') return true;
        if (b != '\r') out->pushChar((u8)b);
    }
}

pub void read<T>(T* out)
{
    comptime
    {
        switch (T) {
            i8 => { *out = (i8)_readI64(); return; },
            i16 => { *out = (i16)_readI64(); return; },
            i32 => { *out = (i32)_readI64(); return; },
            i64 => { *out = _readI64(); return; },
            u8 => { *out = (u8)_readU64(); return; },
            u16 => { *out = (u16)_readU64(); return; },
            u32 => { *out = (u32)_readU64(); return; },
            u64 => { *out = _readU64(); return; },
            f32 => { *out = (f32)_readF64(); return; },
            f64 => { *out = _readF64(); return; },
            bool => { *out = _readBool(); return; },
            cchar => { *out = readChar(); return; },
            String => { readLine(out); return; }
        }
    }
}

pub T readVal<T>()
{
    T result;
    read(&result);
    return result;
}
