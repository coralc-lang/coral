import(lib) platform::libc { write, strlen, snprintf, strtod, getchar };
import(lib) std::mman { copy };
import(lib) std::text::string { String };
import(lib) core::limits { INT64_MAX, INT64_MIN };

// One stack-buffered output context per print call: every helper appends
// here and the call issues a single write(2) when it flushes.
struct _Buf
{
    i32 fd;
    u8* data;
    usize len;
}

#[[inline]]
static void _writeStr(i32 fd, str s) { if (s.len > 0) write(fd, s.ptr, s.len); }

#[[inline]]
static void _pflush(_Buf* out)
{
    if (out->len > 0)
    {
        write(out->fd, out->data, out->len);
        out->len = 0;
    }
}

#[[inline]]
static void _pbyte(_Buf* out, u8 c)
{
    if (out->len >= 1024u) _pflush(out);
    out->data[out->len] = c;
    out->len++;
}

#[[inline]]
static void _pbytes(_Buf* out, const cchar* s, usize n)
{
    if (n == 0) return;
    if (n >= 1024u)
    {
        // Longer than a whole buffer: flush, then write the run directly.
        _pflush(out);
        _writeStr(out->fd, str::fromParts((u8*)s, n));
        return;
    }
    if (out->len + n > 1024u) _pflush(out);
    for (usize i = 0; i < n; i++) out->data[out->len + i] = s[i];
    out->len += n;
}

// Hand-rolled itoa — replaces fmt::formatInt/formatUint so the print path
// has no std::fmt dependency and no String alloc/free per number.
// Digits are produced back-to-front into tmp, then copied forward.
// tmp holds 72 bytes: 64 binary digits + sign (+ prefix lives outside).
#[[inline]]
static usize _itoa(u8* dst, u64 val, u32 base, bool neg)
{
    u8 tmp[72];
    usize n = 0;
    if (val == 0) {
        tmp[0] = '0';
        n = 1;
    } else {
        while (val != 0)
        {
            u64 digit = val % (u64)base;
            val /= (u64)base;
            tmp[n] = digit < 10u ? (u8)('0' + digit) : (u8)('a' + digit - 10u);
            n++;
        }
        if (neg) { tmp[n] = '-'; n++; }
    }
    for (usize i = 0; i < n; i++) dst[i] = tmp[n - 1 - i];
    return n;
}

// Signed integer into the buffer (decimal by default; base comes from
// {:d}/{:x}/{:b}). 72 bytes covers i64's 21 decimal / 65 binary digits.
#[[inline]]
static i32 _fprintSigned(_Buf* out, i64 v, u32 base)
{
    u8 numBuf[72];
    bool neg = v < 0;
    u64 mag = neg ? (u64)(-(v + 1)) + 1u : (u64)v;
    usize n = _itoa(numBuf, mag, base, neg);
    _pbytes(out, numBuf, n);
    return (i32)n;
}

// Unsigned integer into the buffer; `prefix` adds the 0x/0b the old
// formatHex/formatBin produced for the hex/bin manipulators and {:p}.
#[[inline]]
static i32 _fprintUnsigned(_Buf* out, u64 v, u32 base, bool prefix)
{
    u8 numBuf[72];
    usize n = 0;
    if (prefix)
    {
        if (base == 16u) { numBuf[0] = '0'; numBuf[1] = 'x'; n = 2; }
        else if (base == 2u) { numBuf[0] = '0'; numBuf[1] = 'b'; n = 2; }
    }
    n += _itoa(numBuf + n, v, base, false);
    _pbytes(out, numBuf, n);
    return (i32)n;
}

#[[inline]] static i32 _fprintI8(_Buf* out, i8 v) { return _fprintSigned(out, (i64)v, 10); }
#[[inline]] static i32 _fprintI16(_Buf* out, i16 v) { return _fprintSigned(out, (i64)v, 10); }
#[[inline]] static i32 _fprintI32(_Buf* out, i32 v) { return _fprintSigned(out, (i64)v, 10); }
#[[inline]] static i32 _fprintI64(_Buf* out, i64 v) { return _fprintSigned(out, v, 10); }
#[[inline]] static i32 _fprintU8(_Buf* out, u8 v) { return _fprintUnsigned(out, (u64)v, 10, false); }
#[[inline]] static i32 _fprintU16(_Buf* out, u16 v) { return _fprintUnsigned(out, (u64)v, 10, false); }
#[[inline]] static i32 _fprintU32(_Buf* out, u32 v) { return _fprintUnsigned(out, (u64)v, 10, false); }
#[[inline]] static i32 _fprintU64(_Buf* out, u64 v) { return _fprintUnsigned(out, v, 10, false); }

static i32 _fprintF32(_Buf* out, f32 v)
{
    u8 buf[64];
    i32 len = snprintf(buf, 64u, "%.6g", v);
    if (len > 0)
    {
        if (len > 63) len = 63;
        _pbytes(out, buf, (usize)len);
    }
    return len;
}

static i32 _fprintF64(_Buf* out, f64 v)
{
    u8 buf[64];
    i32 len = snprintf(buf, 64u, "%.15g", v);
    if (len > 0)
    {
        if (len > 63) len = 63;
        _pbytes(out, buf, (usize)len);
    }
    return len;
}

#[[inline]] static i32 _fprintBool(_Buf* out, bool v)
{
    if (v) { _pbytes(out, "true", 4u); return 4; }
    else { _pbytes(out, "false", 5u); return 5; }
}

#[[inline]] static i32 _fprintChar(_Buf* out, u8 v)
{
    _pbyte(out, v);
    return 1;
}

#[[inline]]
static i32 _fprintPtr(_Buf* out, const rawptr v)
{
    return _fprintUnsigned(out, (u64)v, 16, true);
}

#[[inline]]
static i32 _fprintCstr(_Buf* out, const cchar* s)
{
    usize len = strlen(s);
    if (len > 0) _pbytes(out, s, len);
    return (i32)len;
}

#[[inline]]
static i32 _fprintBytes(_Buf* out, const cchar* ptr, usize len) {
    if (ptr && len > 0) _pbytes(out, ptr, len);
    return (i32)len;
}

#[[inline]] static void _fprintNewline(_Buf* out) { _pbyte(out, '\n'); }

// Nothing is retained between calls — each print call flushes its own
// stack buffer — so flush is a no-op, as it was in the old file.
#[[inline]] static void _fprintFlush(i32 fd) { (void)fd; }

#[[inline]] static i32 _fprintHex(_Buf* out, u64 v) { return _fprintUnsigned(out, v, 16, true); }

#[[inline]] static i32 _fprintBin(_Buf* out, u64 v)
{
    return _fprintUnsigned(out, v, 2, true);
}

// The Fixed manipulator: %.*f with the same precision clamp the old
// fmt::formatFloat applied. The stack buffer covers ±1.8e308 (309 digits)
// + '.' + 1000 decimals + sign + NUL.
static i32 _fprintFixed(_Buf* out, f64 value, u64 precision)
{
    if (precision > 1000u) precision = 1000u;
    u8 buf[1344];
    i32 len = snprintf(buf, 1344u, "%.*f", (i32)precision, value);
    if (len > 0)
    {
        if (len > 1343) len = 1343;
        _pbytes(out, buf, (usize)len);
    }
    return len;
}

// womdering if i should inline this funtions.
// cuz calling a funtion to call another funtion
// taking the same args still requires stack setup
// in the surrent ir. maybe ill add an optimization for it

#[[inline]] static i32 _sysReadByte() { return getchar(); }

static usize _sysReadLine(u8* buf, usize maxBytes)
{
    if (maxBytes == 0u) return 0;
    usize i = 0;
    while (i < maxBytes - 1u)
    {
        i32 c = getchar();
        if (c < 0 || c == '\n') break;
        if (c != '\r')
        {
            buf[i] = (u8)c;
            ++i;
        }
    }
    buf[i] = 0;
    return i;
}

// The built-in comptime switch — zero runtime type dispatch. These types
// count as covered by the type-not-specified rule; every other type is
// matched by the `any toStr` prong (the inbuilt toStr trait) and the
// compiler resolves and inserts that call itself — no dispatch code is
// written here.
static void _fprintOne<T>(_Buf* out, T val)
{
    comptime {
        switch (T) {
            i8 => { _fprintI8(out, (i8)val); return; },
            i16 => { _fprintI16(out, (i16)val); return; },
            i32 => { _fprintI32(out, (i32)val); return; },
            i64 => { _fprintI64(out, (i64)val); return; },
            u8 => { _fprintU8(out, (u8)val); return; },
            u16 => { _fprintU16(out, (u16)val); return; },
            u32 => { _fprintU32(out, (u32)val); return; },
            u64 => { _fprintU64(out, (u64)val); return; },
            f32 => { _fprintF32(out, (f32)val); return; },
            f64 => { _fprintF64(out, (f64)val); return; },
            bool => { _fprintBool(out, (bool)val); return; },
            cchar => { _fprintChar(out, (cchar)val); return; },
            
            const cchar* => {
                _fprintCstr(out, (const cchar*)val);
                return;
            },
            
            cchar* => {
                _fprintCstr(out, (const cchar*)val);
                return;
            },
            
            str => { _fprintBytes(out, val.ptr, val.len); return; },
            String => { _fprintBytes(out, val.ptr, val.len); return; },
            rawptr => { _fprintPtr(out, (const rawptr)val); return; },
            
            Spaces => {
                Spaces v = val;
                for (usize i = 0u; i < v.count; ++i) _pbyte(out, ' ');
                return;
            },
            
            Repeat => {
                Repeat v = val;
                for (usize i = 0u; i < v.count; ++i) _pbyte(out, v.ch);
                return;
            },
            
            Hex => {
                Hex v = val;
                _fprintHex(out, v.value);
                return;
            },
            
            Bin => {
                Bin v = val;
                _fprintBin(out, v.value);
                return;
            },
            
            Fixed => {
                Fixed v = val;
                _fprintFixed(out, v.value, v.precision);
                return;
            },

            // Any type implementing the inbuilt toStr trait (same class
            // as @drop): the compiler resolves the toStr call itself —
            // no dispatch code here. A type matching no prong above and
            // no `any toStr` falls through to the error below.
            any toStr => {
                str s = val.toStr();
                _fprintBytes(out, s.ptr, s.len);
                return;
            }
        }

        @compileError("print: type implements neither a builtin printer nor toStr");
    }
}

static void _printOne<T>(T val)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    _fprintOne(&out, val);
    _pflush(&out);
}

static void _eprintOne<T>(T val)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 2, .data = outBuf, .len = 0 };
    _fprintOne(&out, val);
    _pflush(&out);
}

// Renders one {} placeholder: spec 0 is the default dispatch (so the
// manipulators work as {} arguments); {:d} {:x} {:b} re-render an integer
// in that base; {:p} prints a pointer; {..} spreads an iterable
// collection. Anything else is a compile error.
static void _fprintSpec<T>(_Buf* out, T val, u8 spec)
{
    comptime
    {
        switch (spec)
        {
            0 => { _fprintOne(out, val); },
            'd' => { _fprintInt(out, val, 10); },
            'x' => { _fprintInt(out, val, 16); },
            'b' => { _fprintInt(out, val, 2); },
            'p' => { _fprintPtrVal(out, val); },
            '.' => { _fprintIter(out, val); },
            else => { @compileError("print: unknown format specifier"); }
        }
    }
}

// {..}: an iterable collection, every element through the default {}
// dispatch, elements separated by ", ". Relies on range-for over the
// collection (old `iterable` trait class) — a non-iterable argument is
// a compile error.
static void _fprintIter<T>(_Buf* out, T val)
{
    comptime
    {
        bool first = true;
        for (var elem : val)
        {
            if (!first) { _pbyte(out, ','); _pbyte(out, ' '); }
            first = false;
            _fprintOne(out, elem);
        }
    }
}

// {:d}/{:x}/{:b} are integer-only — a non-integer argument is a compile error.
static i32 _fprintInt<T>(_Buf* out, T val, u32 base)
{
    comptime
    {
        switch (T)
        {
            i8 => { return _fprintSigned(out, (i64)val, base); },
            i16 => { return _fprintSigned(out, (i64)val, base); },
            i32 => { return _fprintSigned(out, (i64)val, base); },
            i64 => { return _fprintSigned(out, (i64)val, base); },
            u8 => { return _fprintUnsigned(out, (u64)val, base, false); },
            u16 => { return _fprintUnsigned(out, (u64)val, base, false); },
            u32 => { return _fprintUnsigned(out, (u64)val, base, false); },
            u64 => { return _fprintUnsigned(out, (u64)val, base, false); },
            else => { @compileError("print: integer specifier requires an integer argument"); }
        }
    }
}

// {:p} is pointer-only — a non-pointer argument is a compile error.
static i32 _fprintPtrVal<T>(_Buf* out, T val)
{
    comptime
    {
        switch (T)
        {
            rawptr => { return _fprintPtr(out, (const rawptr)val); },
            const cchar* => { return _fprintPtr(out, (const rawptr)val); },
            cchar* => { return _fprintPtr(out, (const rawptr)val); },
            else => { @compileError("print: {:p} requires a pointer argument"); }
        }
    }
}

// Emits one print call. When the first argument is a comptime string
// literal it is the format string: literal chunks (and the {{ }} escapes)
// are written directly — no runtime scanning of {} — and each
// placeholder consumes the next argument. Otherwise this is the
// type-not-specified path: fmt is just the first value and every
// argument renders through the comptime switch above or its own toStr.
static void _printEmit<T>(_Buf* out, T fmt, ... args)
{
    comptime
    {
        if (@isFormatLiteral(fmt))
        {
            str f;
            switch (T)
            {
                str => { f = fmt; },
                const cchar* => { f = str::fromCstr(fmt); },
                cchar* => { f = str::fromCstr((const cchar*)fmt); },
                else => { @compileError("print: format string must be a comptime literal"); }
            }

            usize i = 0;
            for (var arg : args)
            {
                // Literal run up to the next placeholder.
                while (i < f.len)
                {
                    u8 c = f.ptr[i];
                    if (c == '{')
                    {
                        if (i + 1 < f.len && f.ptr[i + 1] == '{') { _pbyte(out, '{'); i += 2; continue; }
                        break;
                    }
                    if (c == '}' && i + 1 < f.len && f.ptr[i + 1] == '}')
                    {
                        _pbyte(out, '}');
                        i += 2;
                        continue;
                    }
                    _pbyte(out, c);
                    i++;
                }
                if (i >= f.len || f.ptr[i] != '{')
                {
                    @compileError("print: placeholder/argument count mismatch (more arguments than placeholders)");
                }

                i++; // consume the opening brace of the placeholder
                u8 spec = 0;
                if (i + 2 < f.len && f.ptr[i] == '.' && f.ptr[i + 1] == '.' && f.ptr[i + 2] == '}')
                {
                    // {..} — iterable spread
                    spec = '.';
                    i += 2; // the closing '}' is consumed by the check below
                }
                else if (i < f.len && f.ptr[i] == ':')
                {
                    i++;
                    if (i >= f.len) { @compileError("print: malformed placeholder"); }
                    spec = f.ptr[i];
                    i++;
                }
                if (i >= f.len || f.ptr[i] != '}')
                {
                    @compileError("print: malformed placeholder");
                }
                i++;
                _fprintSpec(out, arg, spec);
            }

            // Remainder: an unclosed placeholder left here means too few
            // arguments (this also covers "{}" passed with no arguments at all).
            while (i < f.len)
            {
                u8 c = f.ptr[i];
                if (c == '{')
                {
                    if (i + 1 < f.len && f.ptr[i + 1] == '{') { _pbyte(out, '{'); i += 2; continue; }
                    @compileError("print: placeholder/argument count mismatch (more placeholders than arguments)");
                }
                if (c == '}' && i + 1 < f.len && f.ptr[i + 1] == '}')
                {
                    _pbyte(out, '}');
                    i += 2;
                    continue;
                }
                _pbyte(out, c);
                i++;
            }
        }
        else
        {
            // No comptime format literal: values only. A runtime str here
            // is a value, not a format — it prints via toStr.
            _fprintOne(out, fmt);
            for (var arg : args) _fprintOne(out, arg);
        }
    }
}

// toStr is an INBUILT trait (same class as @drop) — nothing is declared
// here. User types provide impls (extend ... : @toStr, spelling FLAGGED)
// and the `any toStr` prong above is where the compiler auto-wires the
// call. A type matching no prong (no builtin, no toStr) is a compile
// error. Built-in comptime-switch types don't need an impl.

// Final rules: print/println/eprint/eprintln take the format string FIRST
// as `comptime T` — the compiler parses the literal ({} one placeholder
// per following argument, {{ }} escapes, {:d} {:x} {:b} {:p} specifiers,
// {..} spreads an iterable collection with ", " separators);
// placeholder/argument mismatch, an unknown specifier, or {} with no
// argument is a compile error. Without a comptime format literal
// (print(x), print(a, b)) every argument must render through the built-in
// comptime switch or its `any toStr` case. One 1024-byte stack buffer per
// call: a single write(2) per call, hand-rolled itoa for integers,
// snprintf for floats.
pub void print<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _pflush(&out);
}

pub void println<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _fprintNewline(&out);
    _pflush(&out);
}

pub void eprint<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 2, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _pflush(&out);
}

pub void eprintln<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 2, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _fprintNewline(&out);
    _pflush(&out);
}

// vaprint — lib_old print!'s equivalent: a compile-time variadic of
// VALUES. No format string first — the first argument is never treated
// as text — and no format specifiers at all: there is no order to
// encode, so arguments print in sequence, each inferred through the
// built-in comptime switch or the `any toStr` case. Unbounded argument
// count and output length (the 1024-byte stack buffer flushes per full
// buffer). No trailing newline (see println).
pub void vaprint(... args)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    comptime { for (var arg : args) _fprintOne(&out, arg); }
    _pflush(&out);
}

// Rebuilds fmt[ds..de) into dst (NUL-terminated): '%' + flags/width/
// precision with the length modifiers dropped, "ll" forced when forceLL,
// then the conversion char. Returns 0 when it does not fit dst[64].
static usize _vaprintRebuild(u8* dst, const cchar* fmt, usize ds, usize de, bool forceLL)
{
    usize n = 0;
    dst[n] = '%'; n++;
    for (usize i = ds + 1; i + 1 < de; i++) // everything before the conversion char
    {
        u8 c = (u8)fmt[i];
        if (c == 'h' || c == 'l' || c == 'z' || c == 'j' || c == 't') continue;
        if (n >= 58u) return 0;
        dst[n] = c; n++;
    }
    if (forceLL)
    {
        if (n + 2u >= 60u) return 0;
        dst[n] = 'l'; dst[n + 1] = 'l'; n += 2u;
    }
    if (n + 2u >= 62u) return 0;
    dst[n] = (u8)fmt[de - 1]; n++;
    dst[n] = 0; n++;
    return n;
}

static void _vaprintI64(_Buf* out, const cchar* fmt, usize ds, usize de, i64 v)
{
    u8 dfmt[64];
    if (_vaprintRebuild(dfmt, fmt, ds, de, true) == 0) { _pbytes(out, fmt + ds, de - ds); return; }
    u8 tmp[256];
    i32 w = snprintf(tmp, 256u, dfmt, v);
    if (w > 0) _pbytes(out, tmp, (usize)w < 256u ? (usize)w : 255u);
}

static void _vaprintU64(_Buf* out, const cchar* fmt, usize ds, usize de, u64 v)
{
    u8 dfmt[64];
    if (_vaprintRebuild(dfmt, fmt, ds, de, true) == 0) { _pbytes(out, fmt + ds, de - ds); return; }
    u8 tmp[256];
    i32 w = snprintf(tmp, 256u, dfmt, v);
    if (w > 0) _pbytes(out, tmp, (usize)w < 256u ? (usize)w : 255u);
}

static void _vaprintF64(_Buf* out, const cchar* fmt, usize ds, usize de, f64 v)
{
    u8 dfmt[64];
    if (_vaprintRebuild(dfmt, fmt, ds, de, false) == 0) { _pbytes(out, fmt + ds, de - ds); return; }
    u8 tmp[256];
    i32 w = snprintf(tmp, 256u, dfmt, v);
    if (w > 0) _pbytes(out, tmp, (usize)w < 256u ? (usize)w : 255u);
}

// %d/%i with integer arguments (u64 reinterprets bit-for-bit — same
// leniency C shows); anything else falls back to default rendering.
static void _vaprintSigned<T>(_Buf* out, const cchar* fmt, usize ds, usize de, T val)
{
    comptime
    {
        switch (T)
        {
            i8 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            i16 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            i32 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            i64 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            u8 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            u16 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            u32 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            u64 => { _vaprintI64(out, fmt, ds, de, (i64)val); },
            else => { _fprintOne(out, val); }
        }
    }
}

// %u/%x/%X/%o with integer arguments (negatives print as their two's
// complement, as C does); anything else falls back to default rendering.
static void _vaprintUnsigned<T>(_Buf* out, const cchar* fmt, usize ds, usize de, T val)
{
    comptime
    {
        switch (T)
        {
            i8 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            i16 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            i32 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            i64 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            u8 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            u16 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            u32 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            u64 => { _vaprintU64(out, fmt, ds, de, (u64)val); },
            else => { _fprintOne(out, val); }
        }
    }
}

// Float conversions with floats (integers promote, as in C); anything
// else falls back to default rendering.
static void _vaprintFloat<T>(_Buf* out, const cchar* fmt, usize ds, usize de, T val)
{
    comptime
    {
        switch (T)
        {
            f32 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            f64 => { _vaprintF64(out, fmt, ds, de, val); },
            i8 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            i16 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            i32 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            i64 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            u8 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            u16 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            u32 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            u64 => { _vaprintF64(out, fmt, ds, de, (f64)val); },
            else => { _fprintOne(out, val); }
        }
    }
}

// Parses [-][flags][width][.precision] out of the directive.
static void _vaprintParts(const cchar* fmt, usize ds, usize de, bool* left, i64* width, i64* prec)
{
    *left = false;
    *width = -1;
    *prec = -1;
    usize i = ds + 1;
    if (i + 1 < de && fmt[i] == '-') { *left = true; i++; }
    while (i + 1 < de && (fmt[i] == '0' || fmt[i] == '+' || fmt[i] == ' ' || fmt[i] == '#')) i++;
    i64 w = 0;
    bool saw = false;
    while (i + 1 < de && fmt[i] >= '0' && fmt[i] <= '9') { w = w * 10 + (fmt[i] - '0'); i++; saw = true; }
    if (saw) *width = w;
    if (i + 1 < de && fmt[i] == '.')
    {
        i++;
        i64 p = 0;
        bool sawp = false;
        while (i + 1 < de && fmt[i] >= '0' && fmt[i] <= '9') { p = p * 10 + (fmt[i] - '0'); i++; sawp = true; }
        *prec = sawp ? p : 0;
    }
}

// %s: str/String/cstr printed directly (str need not be NUL-terminated),
// honoring precision (truncation), width and '-'. Other arguments fall
// back to default rendering.
static void _vaprintStr<T>(_Buf* out, const cchar* fmt, usize ds, usize de, T val)
{
    comptime
    {
        switch (T)
        {
            str => { _vaprintStrBytes(out, fmt, ds, de, (const u8*)val.ptr, val.len); },
            String => { _vaprintStrBytes(out, fmt, ds, de, (const u8*)val.ptr, val.len); },
            const cchar* => { _vaprintStrBytes(out, fmt, ds, de, (const u8*)val, strlen(val)); },
            cchar* => { _vaprintStrBytes(out, fmt, ds, de, (const u8*)val, strlen(val)); },
            else => { _fprintOne(out, val); }
        }
    }
}

static void _vaprintStrBytes(_Buf* out, const cchar* fmt, usize ds, usize de, const u8* p, usize n)
{
    bool left;
    i64 width;
    i64 prec;
    _vaprintParts(fmt, ds, de, &left, &width, &prec);
    if (prec >= 0 && (i64)n > prec) n = (usize)prec;
    i64 pad = 0;
    if (width > 0 && (i64)n < width) pad = width - (i64)n;
    if (!left) { for (i64 k = 0; k < pad; k++) _pbyte(out, ' '); }
    _pbytes(out, (const cchar*)p, n);
    if (left) { for (i64 k = 0; k < pad; k++) _pbyte(out, ' '); }
}

// %c: one byte, width honored (spaces, '-' left-align). Non-character
// arguments fall back to default rendering.
static void _vaprintChar<T>(_Buf* out, const cchar* fmt, usize ds, usize de, T val)
{
    comptime
    {
        u8 ch = 0;
        bool isCh = false;
        switch (T)
        {
            u8 => { ch = val; isCh = true; },
            i8 => { ch = (u8)val; isCh = true; },
            cchar => { ch = (u8)val; isCh = true; },
            u16 => { ch = (u8)val; isCh = true; },
            i16 => { ch = (u8)val; isCh = true; },
            u32 => { ch = (u8)val; isCh = true; },
            i32 => { ch = (u8)val; isCh = true; },
            u64 => { ch = (u8)val; isCh = true; },
            i64 => { ch = (u8)val; isCh = true; },
            else => { }
        }
        if (!isCh) { _fprintOne(out, val); return; }

        bool left;
        i64 width;
        i64 prec;
        _vaprintParts(fmt, ds, de, &left, &width, &prec);
        i64 pad = 0;
        if (width > 0 && width > 1) pad = width - 1;
        if (!left) { for (i64 k = 0; k < pad; k++) _pbyte(out, ' '); }
        _pbyte(out, ch);
        if (left) { for (i64 k = 0; k < pad; k++) _pbyte(out, ' '); }
    }
}

// %p: pointer types only (add prongs for further pointer types as they
// show up); other arguments fall back to default rendering.
static void _vaprintPtr<T>(_Buf* out, T val)
{
    comptime
    {
        switch (T)
        {
            rawptr => { _fprintPtr(out, (const rawptr)val); },
            const cchar* => { _fprintPtr(out, (const rawptr)val); },
            cchar* => { _fprintPtr(out, (const rawptr)val); },
            else => { _fprintOne(out, val); }
        }
    }
}

// Print manipulator types
pub struct Spaces { u64 count; }
pub struct Repeat { u8 ch; u64 count; }
pub struct Hex { u64 value; }
pub struct Bin { u64 value; }
pub struct Fixed { f64 value; u64 precision; }

pub Spaces spaces(u64 count) { return Spaces { .count = count }; }
pub Repeat repeat(u8 ch, u64 count) { return Repeat { .ch = ch, .count = count }; }
pub Hex hex(u64 value) { return Hex { .value = value }; }
pub Bin bin(u64 value) { return Bin { .value = value }; }
pub Fixed fixed(f64 value, u64 precision) { return Fixed { .value = value, .precision = precision }; }
pub void flush() { _fprintFlush(1); }

static i64 _readI64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    i64 v = parseI64(s.asView(), &ok);
    s.free();
    return v;
}

static u64 _readU64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    u64 v = parseU64(s.asView(), &ok);
    s.free();
    return v;
}

static f64 _readF64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    f64 v = parseF64(s.asView(), &ok);
    s.free();
    return v;
}

static bool _readBool()
{
    String s = String::new();
    readLine(&s);
    str sv = s.asView();
    sv = sv.trim();
    bool result = sv.equals(str::fromCstr("true")) ||
                            sv.equals(str::fromCstr("1")) ||
                            sv.equals(str::fromCstr("yes"));
    s.free();
    return result;
}

pub i64 parseI64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    bool neg = false;

    if (sv.ptr[0] == '-') {
        neg = true;
        ++i;
    } else if (sv.ptr[0] == '+') {
        ++i;
    }
    if (i == sv.len) return 0;

    u64 result = 0;
    u64 limit = neg ? 9223372036854775808u : (u64)INT64_MAX;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (limit - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    if (neg) {
        if (result == 9223372036854775808u) return INT64_MIN;
        return -(i64)result;
    }
    return (i64)result;
}

pub u64 parseU64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    if (sv.ptr[0] == '+') ++i;
    if (i == sv.len) return 0;
    u64 result = 0;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (0xFFFFFFFFFFFFFFFFu - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    return result;
}

pub f64 parseF64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0.0;

    u8 buf[256];
    usize len = sv.len < 255u ? sv.len : 255u;
    copy<u8>(buf, (u8*)sv.ptr, len);
    buf[len] = 0;

    cchar* endptr;
    f64 result = strtod(buf, &endptr);
    if (endptr == buf) return 0.0;
    while (*endptr == ' ' || *endptr == '\t' || *endptr == '\n' || *endptr == '\r') endptr++;
    if (*endptr != 0) return 0.0;
    *ok = true;
    return result;
}

pub u8 readChar()
{
    i32 b = getchar();
    return (u8)(b < 0 ? 0 : b);
}

pub bool readLine(String* out)
{
    out->clear();
    loop {
        i32 b = getchar();
        if (b < 0) return !out->isEmpty();
        if (b == '\n') return true;
        if (b != '\r') out->pushChar((u8)b);
    }
}

pub void read<T>(T* out)
{
    comptime
    {
        switch (T) {
            i8 => { *out = (i8)_readI64(); return; },
            i16 => { *out = (i16)_readI64(); return; },
            i32 => { *out = (i32)_readI64(); return; },
            i64 => { *out = _readI64(); return; },
            u8 => { *out = (u8)_readU64(); return; },
            u16 => { *out = (u16)_readU64(); return; },
            u32 => { *out = (u32)_readU64(); return; },
            u64 => { *out = _readU64(); return; },
            f32 => { *out = (f32)_readF64(); return; },
            f64 => { *out = _readF64(); return; },
            bool => { *out = _readBool(); return; },
            cchar => { *out = readChar(); return; },
            String => { readLine(out); return; }
        }
    }
}

pub T readVal<T>()
{
    T result;
    read(&result);
    return result;
}
