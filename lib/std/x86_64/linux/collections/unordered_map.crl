import(lib) std::option { Option };
import hashmap { HashMap };
import vec { Vec };

pub struct UnorderedMap<K, V>
{
    HashMap<K, V> inner;

    static UnorderedMap<K, V> new(usize(K) hf, bool(K, K) ef)
    {
        return UnorderedMap<K, V> { .inner = HashMap<K, V>::new(hf, ef) };
    }

    void dispose() { self.inner.dispose(); }
    usize count() { return self.inner.count(); }
    bool isEmpty() { return self.inner.count() == 0; }

    void insert(K key, V value)
    {
        self.inner.insert(key, value);
    }

    Option<V> get(K key)
    {
        return self.inner.get(key);
    }

    V* getPtr(K key)
    {
        return self.inner.getPtr(key);
    }

    bool contains(K key)
    {
        return self.inner.contains(key);
    }

    void remove(K key)
    {
        self.inner.remove(key);
    }

    void clear()
    {
        self.inner.clear();
    }

    Vec<K> keys()
    {
        return self.inner.keys();
    }

    Vec<V> values()
    {
        return self.inner.values();
    }

    void each(void(K, V) fn)
    {
        self.inner.each(fn);
    }
}

