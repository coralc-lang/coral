import mman { alloc, dealloc, AllocError };
import(lib) std::result { Result };

struct RefCount
{
    usize count;
}

pub struct SharedPtr<T>
{
    T* ptr;
    RefCount* rc;

    // Err(AllocFailed) — the pointee or the refcount block could not be
    // allocated; the SharedPtr is left empty (isValid() false, dispose() a
    // no-op) and nothing is dereferenced.
    Result<bool, AllocError> init(T value)
    {
        self.ptr = alloc<T>(1);
        self.rc = alloc<RefCount>(1);
        if (self.ptr == null || self.rc == null)
        {
            if (self.ptr != null) { dealloc<T>(self.ptr); }
            if (self.rc != null) { dealloc<RefCount>(self.rc); }
            self.ptr = null;
            self.rc = null;
            return Result<bool, AllocError>::Err {
                .error = AllocError::AllocFailed { .msg = "SharedPtr pointee or refcount allocation failed" }
            };
        }
        *self.ptr = value;
        self.rc.count = 1;
        return Result<bool, AllocError>::Ok { .value = true };
    }

    void dispose()
    {
        if (self.rc == null) return;
        self.rc.count--;
        if (self.rc.count == 0)
        {
            dealloc<T>(self.ptr);
            dealloc<RefCount>(self.rc);
        }
        self.ptr = null;
        self.rc = null;
    }

    T get(const self*)
    {
        @assert(self.ptr != null);
        return *self.ptr;
    }

    T* data()
    {
        return self.ptr;
    }

    const T* constData(const self*)
    {
        return self.ptr;
    }

    usize refCount(const self*)
    {
        if (self.rc == null) return 0;
        return self.rc.count;
    }

    bool isValid(const self*)
    {
        return self.ptr != null;
    }
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
pub extend<T> SharedPtr<T> : @drop
{
    void drop()
    {
        self.dispose();
    }
}
