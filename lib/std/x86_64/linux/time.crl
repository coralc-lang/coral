#[[no_drop_all]]
// std::time -- wall-clock and monotonic time.
//
// Ported from the old std/core/time module. The Linux port talks to the
// kernel directly: every clock or sleep call below is a raw x86_64
// syscall, so there is no libc between you and the clock. The public
// surface matches std::time on Windows exactly, call for call.

const i32 CLOCK_REALTIME = 0;
const i32 CLOCK_MONOTONIC = 1;

// x86_64 syscall numbers we need.
const u32 SYS_gettimeofday = 96;
const u32 SYS_nanosleep = 35;
const u32 SYS_time = 201;
const u32 SYS_clock_gettime = 228;

pub struct Timespec
{
    i64 sec;
    i64 nsec;
}

pub struct Timeval
{
    i64 sec;
    i64 usec;
}

// clock_gettime(2), timespec written straight into rsi.
pub Timespec nowMonotonic()
{
    Timespec ts;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_clock_gettime), "D"((usize)CLOCK_MONOTONIC), "S"((usize)&ts)
        : "rcx", "r11", "memory"
    }
    return ts;
}

pub Timespec nowRealtime()
{
    Timespec ts;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_clock_gettime), "D"((usize)CLOCK_REALTIME), "S"((usize)&ts)
        : "rcx", "r11", "memory"
    }
    return ts;
}

// gettimeofday(2); the timezone argument stays null.
pub Timeval nowTimeval()
{
    Timeval tv;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_gettimeofday), "D"((usize)&tv), "S"(0u)
        : "rcx", "r11", "memory"
    }
    return tv;
}

pub u64 unixSeconds()
{
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_time), "D"(0u)
        : "rcx", "r11", "memory"
    }
    return (u64)ret;
}

pub Timespec addTimespec(Timespec a, Timespec b)
{
    Timespec r;
    r.sec = a.sec + b.sec;
    r.nsec = a.nsec + b.nsec;
    if (r.nsec >= 1000000000)
    {
        r.nsec -= 1000000000;
        r.sec += 1;
    }
    return r;
}

pub Timespec subTimespec(Timespec a, Timespec b)
{
    Timespec r;
    r.sec = a.sec - b.sec;
    r.nsec = a.nsec - b.nsec;
    if (r.nsec < 0)
    {
        r.nsec += 1000000000;
        r.sec -= 1;
    }
    return r;
}

pub f64 timespecToF64(Timespec ts)
{
    return (f64)ts.sec + (f64)ts.nsec * 1e-9;
}

pub f64 timevalToF64(Timeval tv)
{
    return (f64)tv.sec + (f64)tv.usec * 1e-6;
}

// nanosleep(2), no remainder retry -- a signal shortens the sleep.
pub void sleepTimespec(Timespec ts)
{
    Timespec req;
    req.sec = ts.sec;
    req.nsec = ts.nsec;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_nanosleep), "D"((usize)&req), "S"(0u)
        : "rcx", "r11", "memory"
    }
}

pub void sleepMs(u64 ms)
{
    Timespec ts;
    ts.sec = (i64)(ms / 1000u);
    ts.nsec = (i64)((ms % 1000u) * 1000000u);
    sleepTimespec(ts);
}
