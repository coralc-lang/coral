
// erased — poor-man's type erasure: a raw pointer wrapper with typed access.

pub struct Erased
{
    rawptr p;

    rawptr ptr()
    {
        return self.p;
    }

    bool isNull()
    {
        return self.p == null;
    }

    T* asPtr<T>()
    {
        return (T*)self.p;
    }
}

pub Erased wrap(rawptr value)
{
    return Erased { .p = value };
}
