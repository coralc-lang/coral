// erased — poor-man's type erasure: a raw pointer wrapper with typed access.
// NOTE: overlaps with the language's dyn-trait form (`any TraitName`); the
// name is Erased because `any` is a keyword (porting rule 1 — port the
// whole file, flag the overlap rather than drop it).
pub struct Erased
{
    rawptr p;

    rawptr ptr()
    {
        return self.p;
    }

    bool isNull()
    {
        return self.p == null;
    }

    T* asPtr<T>()
    {
        return (T*)self.p;
    }
}

pub Erased wrap(rawptr value)
{
    return Erased { .p = value };
}
