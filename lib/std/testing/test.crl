mod std = import(lib, "std");

usize _testsRun = 0;
usize _testsPassed = 0;
usize _testsFailed = 0;
bool _currentTestFailed = false;
str _currentTestName = "";

pub struct TestResult
{
    str name;
    bool passed;
    str message;
}

pub void _testBegin(str name)
{
    _currentTestName = name;
    _currentTestFailed = false;
    _testsRun++;
}

pub void _testEnd()
{
    if (_currentTestFailed)
    {
        _testsFailed++;
        std::ios::neprint("  FAIL: ", _currentTestName);
    }
    else
    {
        _testsPassed++;
    }
}

pub void _testFail(str msg)
{
    _currentTestFailed = true;
    std::ios::neprint("    ", msg);
}

pub void assertEq(usize expected, usize actual, str msg)
{
    if (expected != actual)
    {
        _currentTestFailed = true;
        std::ios::nprint("    expected ", expected, " got ", actual, " - ", msg);
    }
}

pub void assertEqStr(str expected, str actual, str msg)
{
    if (!expected.equals(actual))
    {
        _currentTestFailed = true;
        std::ios::nprint("    expected '", expected, "' got '", actual, "' - ", msg);
    }
}

pub void assertTrue(bool cond, str msg)
{
    if (!cond)
    {
        _currentTestFailed = true;
        std::ios::neprint("    ", msg);
    }
}

pub void assertFalse(bool cond, str msg)
{
    if (cond)
    {
        _currentTestFailed = true;
        std::ios::neprint("    ", msg);
    }
}

pub void assertNull(rawptr ptr, str msg)
{
    if (ptr != null)
    {
        _currentTestFailed = true;
        std::ios::neprint("    expected null - ", msg);
    }
}

pub void assertNotNull(rawptr ptr, str msg)
{
    if (ptr == null)
    {
        _currentTestFailed = true;
        std::ios::neprint("    expected non-null - ", msg);
    }
}

pub void testSummary()
{
    std::ios::nprint("");
    std::ios::nprint("Test Summary");
    std::ios::nprint("  run:    ", _testsRun);
    std::ios::nprint("  passed: ", _testsPassed);
    std::ios::nprint("  failed: ", _testsFailed);
    if (_testsFailed == 0)
        std::ios::nprint("  ALL TESTS PASSED");
    else
        std::ios::nprint("  SOME TESTS FAILED");
}

pub bool testAllPassed()
{
    return _testsFailed == 0;
}
