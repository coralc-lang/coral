pub struct arr<T, N>
{
    T data[N];

    T* ptr()
    {
        return self.data;
    }

    const T* constPtr()
    {
        return (const T*)self.data;
    }

    usize count()
    {
        return N;
    }

    bool isEmpty()
    {
        return N == 0;
    }

    T at(usize i)
    {
        assert(i < N);
        return self.data[i];
    }

    void set(usize i, T val)
    {
        assert(i < N);
        self.data[i] = val;
    }

    T* atPtr(usize i)
    {
        assert(i < N);
        return &self.data[i];
    }

    T front()
    {
        assert(N > 0);
        return self.data[0];
    }

    T back()
    {
        assert(N > 0);
        return self.data[N - 1];
    }

    void fill(T val)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = val;
    }

    void copyTo(T* dst)
    {
        for (usize i = 0; i < N; i++)
            dst[i] = self.data[i];
    }

    void copyFrom(const T* src)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = src[i];
    }
}