mod std = import(lib, "std");

u64 _clampRadix(u64 radix)
{
    if (radix < 2u) return 10u;
    if (radix > 36u) return 36u;
    return radix;
}

pub std::string::String format(str f, ...)
{
    std::string::String out = std::string::String::new();
    usize i = 0;
    while (i < f.len)
    {
        if (f.ptr[i] == '{' && i + 1 < f.len && f.ptr[i + 1] == '}')
        {
            i += 2;
            continue;
        }
        out.pushChar(f.ptr[i]);
        i++;
    }
    return out;
}

pub std::string::String formatInt(i64 val, u64 radix, bool upper)
{
    radix = _clampRadix(radix);
    if (val == 0) return std::string::String::fromView(str::fromCstr("0"));
    bool neg = val < 0;
    u64 mag = neg ? (u64)(-(val + 1)) + 1u : (u64)val;
    u8 buf[65];
    u64 pos = 64;
    buf[pos] = 0;
    while (mag != 0)
    {
        u64 digit = mag % radix;
        mag /= radix;
        pos--;
        if (digit < 10u) buf[pos] = (u8)('0' + digit);
        else buf[pos] = upper ? (u8)('A' + digit - 10u) : (u8)('a' + digit - 10u);
    }
    if (neg) { pos--; buf[pos] = '-'; }
    return std::string::String::fromView(str::fromParts(buf + pos, 64 - pos));
}

pub std::string::String formatUint(u64 val, u64 radix, bool upper)
{
    radix = _clampRadix(radix);
    if (val == 0) return std::string::String::fromView(str::fromCstr("0"));
    u8 buf[65];
    u64 pos = 64;
    buf[pos] = 0;
    while (val != 0)
    {
        u64 digit = val % radix;
        val /= radix;
        pos--;
        if (digit < 10) buf[pos] = (u8)('0' + digit);
        else buf[pos] = upper ? (u8)('A' + digit - 10) : (u8)('a' + digit - 10);
    }
    return std::string::String::fromView(str::fromParts(buf + pos, 64 - pos));
}

pub std::string::String formatFloat(f64 val, u64 precision)
{
    if (precision > 1000u) precision = 1000u;
    i32 n = std::libc::snprintf(null, 0u, "%.*f", (i32)precision, val);
    if (n < 0) return std::string::String::new();
    u64 size = (u64)n;
    u8* buf = std::mman::alloc<u8>(size + 1u);
    if (buf == null) return std::string::String::new();
    i32 m = std::libc::snprintf(buf, size + 1u, "%.*f", (i32)precision, val);
    std::string::String out;
    if (m < 0 || (u64)m > size) out = std::string::String::new();
    else out = std::string::String::fromView(str::fromParts((const u8*)buf, (u64)m));
    std::mman::dealloc<u8>(buf);
    return out;
}

pub std::string::String formatHex(u64 val, bool prefix)
{
    std::string::String s = formatUint(val, 16, false);
    if (prefix) {
        std::string::String p = std::string::String::fromView(str::fromCstr("0x"));
        p.appendView(s.asView()); s.free(); return p; }
    return s;
}

pub std::string::String formatHexUpper(u64 val, bool prefix)
{
    std::string::String s = formatUint(val, 16, true);
    if (prefix) {
        std::string::String p = std::string::String::fromView(str::fromCstr("0x"));
        p.appendView(s.asView()); s.free(); return p; }
    return s;
}

pub std::string::String formatBin(u64 val, bool prefix)
{
    std::string::String s = formatUint(val, 2, false);
    if (prefix) {
        std::string::String p = std::string::String::fromView(str::fromCstr("0b"));
        p.appendView(s.asView()); s.free(); return p; }
    return s;
}

pub std::string::String padLeft(str sv, usize width, u8 pad)
{
    if (sv.len >= width) return std::string::String::fromView(sv);
    std::string::String out = std::string::String::new();
    usize n = width - sv.len;
    for (usize i = 0; i < n; i++) out.pushChar(pad);
    out.appendView(sv);
    return out;
}

pub std::string::String padRight(str sv, usize width, u8 pad)
{
    if (sv.len >= width) return std::string::String::fromView(sv);
    std::string::String out = std::string::String::fromView(sv);
    usize n = width - sv.len;
    for (usize i = 0; i < n; i++) out.pushChar(pad);
    return out;
}

pub std::string::String repeat(str sv, usize count)
{
    std::string::String out = std::string::String::new();
    for (usize i = 0; i < count; i++) out.appendView(sv);
    return out;
}

pub std::string::String join(const str* parts, usize count, str sep)
{
    std::string::String out = std::string::String::new();
    for (usize i = 0; i < count; i++)
    {
        if (i > 0) out.appendView(sep);
        out.appendView(parts[i]);
    }
    return out;
}

pub std::string::String joinVec(const std::vec::vec<std::string::String>* parts, str sep)
{
    std::string::String out = std::string::String::new();
    for (usize i = 0; i < parts*.count(parts); i++)
    {
        if (i > 0) out.appendView(sep);
        out.appendView(parts*.at(parts, i).asView());
    }
    return out;
}