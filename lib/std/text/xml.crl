mod std = import(lib, "std");

pub struct XmlAttribute
{
    std::string::String name;
    std::string::String value;

    void dispose()
    {
        self.name.free();
        self.value.free();
    }
}

pub enum XmlNodeType
{
    Element,
    Text,
    Comment,
    CData,
}

pub struct XmlNode
{
    XmlNodeType type;
    std::string::String tag;
    std::string::String text;
    std::vec::vec<XmlAttribute> attrs;
    std::vec::vec<XmlNode> children;

    static XmlNode element(str tag)
    {
        XmlNode n;
        n.type = XmlNodeType::Element;
        n.tag = std::string::String::fromView(tag);
        n.text = std::string::String::new();
        n.attrs = std::vec::vec<XmlAttribute>::new();
        n.children = std::vec::vec<XmlNode>::new();
        return n;
    }

    static XmlNode text(str content)
    {
        XmlNode n;
        n.type = XmlNodeType::Text;
        n.tag = std::string::String::new();
        n.text = std::string::String::fromView(content);
        n.attrs = std::vec::vec<XmlAttribute>::new();
        n.children = std::vec::vec<XmlNode>::new();
        return n;
    }

    void dispose()
    {
        self.tag.free();
        self.text.free();
        for (usize i = 0; i < self.attrs.count(); i++)
            self.attrs.atPtr(i)*.dispose();
        for (usize i = 0; i < self.children.count(); i++)
            self.children.atPtr(i)*.dispose();
        self.attrs.dispose();
        self.children.dispose();
    }

    bool hasAttr(str name)
    {
        for (usize i = 0; i < self.attrs.count(); i++)
        {
            if (self.attrs.at(i).name.asView().equals(name)) return true;
        }
        return false;
    }

    str getAttr(str name)
    {
        for (usize i = 0; i < self.attrs.count(); i++)
        {
            if (self.attrs.at(i).name.asView().equals(name))
                return self.attrs.at(i).value.asView();
        }
        return "";
    }

    XmlNode* firstChild(str tagName)
    {
        for (usize i = 0; i < self.children.count(); i++)
        {
            if (self.children.at(i).tag.asView().equals(tagName))
                return self.children.atPtr(i);
        }
        return null;
    }
}

struct _XmlParser
{
    const u8* data;
    usize len;
    usize pos;
    bool error;

    void skipSpace()
    {
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
            self.pos++;
        }
    }

    u8 peek()
    {
        self.skipSpace();
        if (self.pos >= self.len) return 0;
        return self.data[self.pos];
    }

    u8 next()
    {
        self.skipSpace();
        if (self.pos >= self.len) return 0;
        return self.data[self.pos++];
    }

    bool expect(u8 ch)
    {
        if (self.next() != ch) { self.error = true; return false; }
        return true;
    }

    std::string::String parseName()
    {
        usize start = self.pos;
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == ':')
                self.pos++;
            else break;
        }
        if (self.pos == start) { self.error = true; return std::string::String::new(); }
        return std::string::String::fromView(string.str::fromParts(self.data + start, self.pos - start));
    }

    std::string::String parseQuotedString()
    {
        std::string::String s = std::string::String::new();
        u8 quote = self.next();
        if (quote != '"' && quote != '\'') { self.error = true; return s; }
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos++];
            if (c == quote) return s;
            if (c == '&')
            {
                usize ampPos = self.pos - 1;
                usize entStart = self.pos;
                while (self.pos < self.len && self.data[self.pos] != ';') self.pos++;
                if (self.pos >= self.len) { self.error = true; return s; }
                self.pos++;
                str ent = str::fromParts((const u8*)(self.data + entStart), self.pos - entStart - 1);
                if (ent.equals(str::fromCstr("lt"))) s.pushChar('<');
                else if (ent.equals(str::fromCstr("gt"))) s.pushChar('>');
                else if (ent.equals(str::fromCstr("amp"))) s.pushChar('&');
                else if (ent.equals(str::fromCstr("quot"))) s.pushChar('"');
                else if (ent.equals(str::fromCstr("apos"))) s.pushChar('\'');
                else
                {
                    for (usize i = ampPos; i < self.pos; i++)
                        s.pushChar((u8)self.data[i]);
                }
            }
            else s.pushChar((u8)c);
        }
        self.error = true;
        return s;
    }

    XmlNode parseElement()
    {
        XmlNode node = XmlNode::element("");
        if (!self.expect('<')) { node.dispose(); return XmlNode::element(""); }

        if (self.peek() == '?')
        {
            self.pos++;
            while (self.pos + 2 < self.len)
            {
                if (self.data[self.pos] == '?' && self.data[self.pos + 1] == '>')
                {
                    self.pos += 2;
                    return node;
                }
                self.pos++;
            }
            self.error = true;
            return node;
        }

        if (self.peek() == '!')
        {
            self.pos++;
            if (self.pos + 2 < self.len && self.data[self.pos] == '-' && self.data[self.pos + 1] == '-')
            {
                self.pos += 2;
                while (self.pos + 2 < self.len)
                {
                    if (self.data[self.pos] == '-' && self.data[self.pos + 1] == '-' && self.data[self.pos + 2] == '>')
                    {
                        self.pos += 3;
                        return node;
                    }
                    self.pos++;
                }
                self.error = true;
                return node;
            }
            self.error = true;
            return node;
        }

        std::string::String tagName = self.parseName();
        if (self.error) { tagName.free(); node.dispose(); return XmlNode::element(""); }
        node.tag.free();
        node.tag = tagName;

        while (self.pos < self.len)
        {
            self.skipSpace();
            u8 c = self.peek();
            if (c == '/' || c == '>') break;
            XmlAttribute attr;
            attr.name = self.parseName();
            if (self.error) { node.dispose(); attr.name.free(); return XmlNode::element(""); }
            if (self.next() != '=') { self.error = true; node.dispose(); attr.name.free(); return XmlNode::element(""); }
            attr.value = self.parseQuotedString();
            if (self.error) { node.dispose(); attr.name.free(); attr.value.free(); return XmlNode::element(""); }
            node.attrs.push(attr);
        }

        if (self.peek() == '/')
        {
            self.pos++;
            if (!self.expect('>')) { node.dispose(); return XmlNode::element(""); }
            return node;
        }

        if (!self.expect('>')) { node.dispose(); return XmlNode::element(""); }

        while (self.pos < self.len)
        {
            self.skipSpace();
            if (self.pos >= self.len) break;
            if (self.data[self.pos] == '<' && self.pos + 1 < self.len && self.data[self.pos + 1] == '/')
            {
                self.pos += 2;
                std::string::String endTag = self.parseName();
                if (self.error) { endTag.free(); node.dispose(); return XmlNode::element(""); }
                bool match = endTag.equals(node.tag.asView());
                endTag.free();
                if (!match) { self.error = true; node.dispose(); return XmlNode::element(""); }
                self.skipSpace();
                if (!self.expect('>')) { node.dispose(); return XmlNode::element(""); }
                return node;
            }
            if (self.data[self.pos] == '<')
            {
                XmlNode child = self.parseElement();
                if (self.error) { node.dispose(); child.dispose(); return XmlNode::element(""); }
                node.children.push(child);
            }
            else
            {
                std::string::String text = std::string::String::new();
                while (self.pos < self.len && self.data[self.pos] != '<')
                {
                    u8 c = self.data[self.pos++];
                    if (c == '&')
                    {
                        usize ampPos = self.pos - 1;
                        usize entStart = self.pos;
                        while (self.pos < self.len && self.data[self.pos] != ';') self.pos++;
                        if (self.pos >= self.len)
                        {
                            text.free();
                            self.error = true;
                            node.dispose();
                            return XmlNode::element("");
                        }
                        self.pos++;
                        str ent = str::fromParts(self.data + entStart, self.pos - entStart - 1);
                        if (ent.equals(str::fromCstr("lt"))) text.pushChar('<');
                        else if (ent.equals(str::fromCstr("gt"))) text.pushChar('>');
                        else if (ent.equals(str::fromCstr("amp"))) text.pushChar('&');
                        else
                        {
                            for (usize i = ampPos; i < self.pos; i++)
                                text.pushChar((u8)self.data[i]);
                        }
                    }
                    else text.pushChar((u8)c);
                }
                if (!text.isEmpty())
                    node.children.push(XmlNode::text(text.asView()));
                text.free();
            }
        }
        self.error = true;
        node.dispose();
        return XmlNode::element("");
    }
}

pub bool parseXml(str input, XmlNode* out)
{
    _XmlParser p;
    p.data = (const u8*)input.ptr;
    p.len = input.len;
    p.pos = 0;
    p.error = false;
    *out = p.parseElement();
    return !p.error;
}

pub std::string::String serializeXml(XmlNode* node)
{
    std::string::String out = std::string::String::new();
    _serialize(node, &out);
    return out;
}

void _serialize(XmlNode* node, std::string::String* out)
{
    if (node*.type == XmlNodeType::Text)
    {
        std::string::String escaped = _escapeXml(node*.text.asView());
        out*.appendView(escaped.asView());
        escaped.free();
        return;
    }
    out*.pushChar('<');
    out*.appendView(node*.tag.asView());
    for (usize i = 0; i < node*.attrs.count(); i++)
    {
        out*.pushChar(' ');
        out*.appendView(node*.attrs.at(i).name.asView());
        out*.pushView("=\"");
        std::string::String escaped = _escapeXml(node*.attrs.at(i).value.asView());
        out*.appendView(escaped.asView());
        escaped.free();
        out*.pushChar('"');
    }
    if (node*.children.count() == 0 && node*.text.isEmpty())
    {
        out*.pushView(str::fromCstr("/>"));
        return;
    }
    out*.pushChar('>');
    if (!node*.text.isEmpty())
    {
        std::string::String escaped = _escapeXml(node*.text.asView());
        out*.appendView(escaped.asView());
        escaped.free();
    }
    for (usize i = 0; i < node*.children.count(); i++)
        _serialize(node*.children.atPtr(i), out);
    out*.pushView(str::fromCstr("</"));
    out*.appendView(node*.tag.asView());
    out*.pushChar('>');
}

std::string::String _escapeXml(str s)
{
    std::string::String out = std::string::String::new();
    for (usize i = 0; i < s.len; i++)
    {
        u8 c = s.ptr[i];
        if (c == '<') out.appendView(str::fromCstr("&lt;"));
        else if (c == '>') out.appendView(str::fromCstr("&gt;"));
        else if (c == '&') out.appendView(str::fromCstr("&amp;"));
        else if (c == '"') out.appendView(str::fromCstr("&quot;"));
        else out.pushChar((u8)c);
    }
    return out;
}

trait drop
{
    void drop();
}

XmlNode::drop
{
    void drop()
    {
        self.dispose();
    }
}