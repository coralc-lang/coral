mod std = import(lib, "std");

pub struct iniSection
{
    std::hashmap::hashmap<std::string::String, std::string::String> entries;

    iniSection new()
    {
        iniSection s;
        s.entries = std::hashmap::hashmap<std::string::String, std::string::String>::new(hashString, eq);
        return s;
    }

    void dispose()
    {
        self.entries.eachEntry(freeEntry);
        self.entries.dispose();
    }

    std::string::String get(str key)
    {
        std::string::String sk = std::string::String::fromView(key);
        option.option<std::string::String> v = self.entries.get(sk);
        sk.free();
        if (v.isNone()) return std::string::String::new();
        std::string::String stored = v.unwrap();
        return std::string::String::fromView(stored.asView());
    }

    void set(str key, str value)
    {
        std::string::String sk = std::string::String::fromView(key);
        option.option<std::hashmap::HashMapEntry<std::string::String, std::string::String>> old = self.entries.removeEntry(sk);
        if (old.isSome())
        {
            std::hashmap::HashMapEntry<std::string::String, std::string::String> e = old.unwrap();
            e.key.free();
            e.value.free();
        }
        std::string::String sv = std::string::String::fromView(value);
        self.entries.insert(sk, sv);
    }
}

pub struct iniFile
{
    std::vec::vec<iniSection> sections;
    std::vec::vec<std::string::String> names;

    iniFile new()
    {
        iniFile f;
        f.sections = std::vec::vec<iniSection>::new();
        f.names = std::vec::vec<std::string::String>::new();
        iniSection global = iniSection::new();
        f.sections.push(global);
        f.names.push(std::string::String::new());
        return f;
    }

    void dispose()
    {
        for (usize i = 0; i < self.sections.count(); i++)
            self.sections.atPtr(i)*.dispose();
        for (usize i = 0; i < self.names.count(); i++)
            self.names.atPtr(i)*.free();
        self.sections.dispose();
        self.names.dispose();
    }

    bool parse(str input)
    {
        std::vec::vec<str> lines = std::string::strutilsplitVec(input, '\n');
        usize curSection = 0;
        for (usize i = 0; i < lines.count(); i++)
        {
            str line = std::string::strutiltrim(lines.at(i));
            if (line.len == 0 || line.ptr[0] == ';' || line.ptr[0] == '#') continue;
            if (line.ptr[0] == '[')
            {
                isize closeIdx = std::string::strutilindexOfChar(line, ']');
                if (closeIdx < 0) continue;
                str name = std::string::strutiltrim(str::fromParts(line.ptr + 1, (usize)closeIdx - 1));
                iniSection sec = iniSection::new();
                self.sections.push(sec);
                self.names.push(std::string::String::fromView(name));
                curSection = self.sections.count() - 1;
                continue;
            }
            isize eq = std::string::strutilindexOfChar(line, '=');
            if (eq < 0) continue;
            str key = std::string::strutiltrim(str::fromParts(line.ptr, (usize)eq));
            str value = std::string::strutiltrim(str::fromParts(line.ptr + (usize)eq + 1, line.len - (usize)eq - 1));
            isize semi = std::string::strutilindexOfChar(value, ';');
            if (semi >= 0)
                value = std::string::strutiltrim(str::fromParts(value.ptr, (usize)semi));
            self.sections.atPtr(curSection)*.set(key, value);
        }
        lines.dispose();
        return true;
    }

    iniSection* section(str name)
    {
        for (usize i = 0; i < self.names.count(); i++)
        {
            str n = self.names.at(i).asView();
            if (n.len == name.len)
            {
                bool match = true;
                for (usize j = 0; j < n.len; j++)
                    if (n.ptr[j] != name.ptr[j]) { match = false; break; }
                if (match) return self.sections.atPtr(i);
            }
        }
        return null;
    }

    std::string::String get(str section, str key)
    {
        for (usize i = 0; i < self.names.count(); i++)
        {
            str n = self.names.at(i).asView();
            if (n.len == section.len)
            {
                bool match = true;
                for (usize j = 0; j < n.len; j++)
                    if (n.ptr[j] != section.ptr[j]) { match = false; break; }
                if (match)
                    return self.sections.at(i).get(key);
            }
        }
        return std::string::String::new();
    }
}

u64 hashString(std::string::String s)
{
    str v = s.asView();
    u64 hash = 14695981039346656037u;
    for (usize i = 0; i < v.len; i++)
    {
        hash ^= (u64)(u8)v.ptr[i];
        hash *= 1099511628211u;
    }
    return hash;
}

bool eq(std::string::String a, std::string::String b)
{
    return a.asView().equalsView(b.asView());
}

void freeEntry(std::hashmap::HashMapEntry<std::string::String, std::string::String>* e)
{
    e*.key.free();
    e*.value.free();
}

trait drop
{
    void drop();
}

iniSection::drop
{
    void drop()
    {
        self.dispose();
    }
}

iniFile::drop
{
    void drop()
    {
        self.dispose();
    }
}
