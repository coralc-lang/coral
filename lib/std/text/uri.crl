mod std = import(lib, "std");

pub struct uri
{
    std::string::String scheme;
    std::string::String userInfo;
    std::string::String host;
    u16 port;
    std::string::String path;
    std::string::String query;
    std::string::String fragment;
    bool hasPort;

    uri new()
    {
        uri u;
        u.scheme = std::string::String::new();
        u.userInfo = std::string::String::new();
        u.host = std::string::String::new();
        u.port = 0;
        u.hasPort = false;
        u.path = std::string::String::new();
        u.query = std::string::String::new();
        u.fragment = std::string::String::new();
        return u;
    }

    void dispose()
    {
        self.scheme.free();
        self.userInfo.free();
        self.host.free();
        self.path.free();
        self.query.free();
        self.fragment.free();
    }

    bool parse(str input)
    {
        usize i = 0;

        usize schemeEnd = i;
        while (schemeEnd < input.len && input.ptr[schemeEnd] != ':' && input.ptr[schemeEnd] != '/' && input.ptr[schemeEnd] != '?' && input.ptr[schemeEnd] != '#')
            schemeEnd++;
        if (schemeEnd < input.len && input.ptr[schemeEnd] == ':')
        {
            self.scheme.free();
            self.scheme = std::string::String.fromView(str::fromParts(input.ptr, schemeEnd));
            i = schemeEnd + 1;
        }

        if (i + 1 < input.len && input.ptr[i] == '/' && input.ptr[i + 1] == '/')
        {
            i += 2;
            usize authEnd = i;
            while (authEnd < input.len && input.ptr[authEnd] != '/' && input.ptr[authEnd] != '?' && input.ptr[authEnd] != '#')
                authEnd++;

            str authority = str::fromParts(input.ptr + i, authEnd - i);
            i = authEnd;

            isize at = -1;
            for (usize j = 0; j < authority.len; j++)
                if (authority.ptr[j] == '@') { at = (i64)j; break; }

            if (at >= 0)
            {
                self.userInfo.free();
                self.userInfo = std::string::String.fromView(str::fromParts(authority.ptr, (usize)at));
                authority = str::fromParts(authority.ptr + (usize)at + 1, authority.len - (usize)at - 1);
            }

            isize colon = -1;
            for (usize j = 0; j < authority.len; j++)
                if (authority.ptr[j] == ':') { colon = (i64)j; break; }

            if (colon >= 0)
            {
                self.host.free();
                self.host = std::string::String.fromView(str::fromParts(authority.ptr, (usize)colon));
                str portStr = str::fromParts(authority.ptr + (usize)colon + 1, authority.len - (usize)colon - 1);
                if (portStr.len == 0) return false;
                usize portVal = 0;
                for (usize j = 0; j < portStr.len; j++)
                {
                    if (portStr.ptr[j] < '0' || portStr.ptr[j] > '9') return false;
                    portVal = portVal * 10 + (usize)(portStr.ptr[j] - '0');
                    if (portVal > 65535u) return false;
                }
                self.port = (u16)portVal;
                self.hasPort = true;
            }
            else
            {
                self.host.free();
                self.host = std::string::String.fromView(authority);
            }
        }

        usize pathEnd = i;
        while (pathEnd < input.len && input.ptr[pathEnd] != '?' && input.ptr[pathEnd] != '#')
            pathEnd++;
        if (pathEnd > i)
        {
            self.path.free();
            self.path = std::string::String.fromView(str::fromParts(input.ptr + i, pathEnd - i));
        }
        else if (self.host.len > 0)
        {
            self.path.free();
            self.path = std::string::String.fromView(str::fromCstr("/"));
        }
        i = pathEnd;

        if (i < input.len && input.ptr[i] == '?')
        {
            i++;
            usize qEnd = i;
            while (qEnd < input.len && input.ptr[qEnd] != '#') qEnd++;
            self.query.free();
            self.query = std::string::String.fromView(str::fromParts(input.ptr + i, qEnd - i));
            i = qEnd;
        }
        else if (self.query.len > 0)
        {
            self.query.free();
            self.query = std::string::String::new();
        }

        if (i < input.len && input.ptr[i] == '#')
        {
            i++;
            self.fragment.free();
            self.fragment = std::string::String.fromView(str::fromParts(input.ptr + i, input.len - i));
        }
        else if (self.fragment.len > 0)
        {
            self.fragment.free();
            self.fragment = std::string::String::new();
        }

        return true;
    }
}

trait drop
{
    void drop();
}

uri::drop
{
    void drop()
    {
        self.dispose();
    }
}