mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// IR text printer: dumps IR module to text format
// Format:
//   ; comments
//   @globalName = global i64 42
//   @strConst = "hello world"
//   fn funcName(i64, ptr) i64
//   @entry:
//     %0 = add i64 %arg0, 1
//     store i64 %0, %ptr
//     %1 = load i64, %ptr
//     ret i64 %1

pub struct IrPrinter
{
    char* output;
    u32 len;
    u32 cap;

    IrPrinter new()
    {
        IrPrinter p;
        p.output = null;
        p.len = 0;
        p.cap = 0;
        return p;
    }

    void destroy()
    {
        if (self.output) std::mman::dealloc<char>(self.output);
    }

    void emitCstr(const std::cchar* cstr)
    {
        u32 slen = 0;
        while (cstr[slen]) slen++;
        if (self.len + slen + 1 > self.cap)
        {
            u32 newCap = self.cap ? self.cap * 2 : 4096;
            char* buf = std::mman::alloc<char>(newCap);
            if (self.output)
            {
                for (u32 i = 0; i < self.len; i++)
                    buf[i] = self.output[i];
                std::mman::dealloc<char>(self.output);
            }
            self.output = buf;
            self.cap = newCap;
        }
        for (u32 i = 0; i < slen; i++)
            self.output[self.len + i] = (char)cstr[i];
        self.len += slen;
        self.output[self.len] = 0;
    }

    void emit(str s)
    {
        if (self.len + s.len + 1 > self.cap)
        {
            u32 newCap = self.cap ? self.cap * 2 : 4096;
            char* buf = std::mman::alloc<char>(newCap);
            if (self.output)
            {
                for (u32 i = 0; i < self.len; i++)
                    buf[i] = self.output[i];
                std::mman::dealloc<char>(self.output);
            }
            self.output = buf;
            self.cap = newCap;
        }
        for (u32 i = 0; i < s.len; i++)
            self.output[self.len + i] = (char)s.ptr[i];
        self.len += s.len;
        self.output[self.len] = 0;
    }

    void emitLine(str s)
    {
        self.emit(s);
        self.emit("\n");
    }

    void emitChar(std::cchar c)
    {
        char buf[2] = { (char)c, 0 };
        self.emit(str::fromParts((const std::cchar*)buf, 1));
    }

    void emitU32(u32 val)
    {
        if (val == 0) { self.emit("0"); return; }
        char buf[16];
        u32 i = 0;
        u32 v = val;
        while (v > 0) { buf[i++] = '0' + (v % 10); v /= 10; }
        for (u32 j = 0; j < i; j++)
            self.emitChar((std::cchar)buf[i - 1 - j]);
    }

    void emitI64(i64 val)
    {
        if (val < 0) { self.emit("-"); val = -val; }
        if (val == 0) { self.emit("0"); return; }
        char buf[32];
        u32 i = 0;
        i64 v = val;
        while (v > 0) { buf[i++] = '0' + (v % 10); v /= 10; }
        for (u32 j = 0; j < i; j++)
            self.emitChar((std::cchar)buf[i - 1 - j]);
    }

    void emitType(wallvm::ir_types::IrType* ty)
    {
        if (!ty) { self.emit("void"); return; }
        switch (ty.kind)
        {
        case wallvm::ir_types::IrTypeKind::Void:
            self.emit("void");
            break;
        case wallvm::ir_types::IrTypeKind::Int:
            self.emit("i");
            self.emitU32(ty.width);
            break;
        case wallvm::ir_types::IrTypeKind::Float:
            self.emit("f");
            self.emitU32(ty.width);
            break;
        case wallvm::ir_types::IrTypeKind::Ptr:
            self.emit("ptr");
            break;
        case wallvm::ir_types::IrTypeKind::Vector:
            self.emit("<");
            self.emitU32(ty.count);
            self.emit(" x ");
            self.emitType(ty.elem);
            self.emit(">");
            break;
        case wallvm::ir_types::IrTypeKind::Array:
            self.emit("[");
            self.emitU32(ty.count);
            self.emit(" x ");
            self.emitType(ty.elem);
            self.emit("]");
            break;
        case wallvm::ir_types::IrTypeKind::Func:
            self.emit("func");
            break;
        case wallvm::ir_types::IrTypeKind::Struct:
            self.emit("struct{");
            self.emitU32(ty.width);
            self.emit("}");
            break;
        default:
            self.emit("?");
            break;
        }
    }

    void emitValueRef(wallvm::ir_types::IrValue* val)
    {
        if (!val) { self.emit("null"); return; }
        if (val.kind == wallvm::ir_types::IrValueKind::ConstInt)
        {
            self.emitI64((i64)val.valData);
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::ConstFloat)
        {
            self.emit("fp?");
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::Global)
        {
            wallvm::ir_types::IrGlobal* g = (wallvm::ir_types::IrGlobal*)val;
            self.emit("@");
            self.emitCstr((const std::cchar*)g.name);
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::Func)
        {
            wallvm::ir_types::IrFunc* f = (wallvm::ir_types::IrFunc*)val;
            self.emit("@");
            self.emitCstr((const std::cchar*)f.name);
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::Block)
        {
            wallvm::ir_types::IrBlock* bb = (wallvm::ir_types::IrBlock*)val;
            self.emit("@");
            self.emitCstr((const std::cchar*)bb.name);
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::Inst)
        {
            wallvm::ir_types::IrInst* inst = (wallvm::ir_types::IrInst*)val;
            self.emit("%");
            self.emitU32(inst.base.id);
            return;
        }
        if (val.kind == wallvm::ir_types::IrValueKind::Arg)
        {
            self.emit("%arg");
            self.emitU32(val.id);
            return;
        }
        self.emit("%?");
    }

    void emitStringConst(wallvm::ir_types::IrStringConst* sc)
    {
        self.emit("@str");
        self.emitU32(sc.base.id);
        self.emit(" = \"");
        for (u32 i = 0; i < sc.length; i++)
        {
            std::cchar c = sc.str[i];
            if (c == '\\') self.emit("\\\\");
            else if (c == '"') self.emit("\\\"");
            else if (c == '\n') self.emit("\\n");
            else if (c == '\t') self.emit("\\t");
            else self.emitChar(c);
        }
        self.emitLine("\"");
    }

    void emitInst(wallvm::ir_types::IrInst* inst)
    {
        self.emit("    ");

        // Emit debug location as comment
        if (inst.debugLoc.file)
        {
            self.emit("; ");
            self.emitCstr((const std::cchar*)inst.debugLoc.file);
            self.emit(":");
            self.emitU32(inst.debugLoc.line);
            self.emit("\n    ");
        }

        bool hasResult = inst.opcode != wallvm::irOps::IrOpcode::Br &&
            inst.opcode != wallvm::irOps::IrOpcode::CondBr &&
            inst.opcode != wallvm::irOps::IrOpcode::Ret &&
            inst.opcode != wallvm::irOps::IrOpcode::Store &&
            inst.opcode != wallvm::irOps::IrOpcode::Unreachable &&
            inst.opcode != wallvm::irOps::IrOpcode::Noret &&
            inst.opcode != wallvm::irOps::IrOpcode::Fence &&
            inst.opcode != wallvm::irOps::IrOpcode::AtomicStore &&
            inst.opcode != wallvm::irOps::IrOpcode::GcWriteBarrier &&
            inst.opcode != wallvm::irOps::IrOpcode::GcSafepoint;

        if (hasResult)
        {
            self.emit("%");
            self.emitU32(inst.base.id);
            self.emit(" = ");
        }

        switch (inst.opcode)
        {
        case wallvm::irOps::IrOpcode::Add:
        case wallvm::irOps::IrOpcode::Sub:
        case wallvm::irOps::IrOpcode::Mul:
        case wallvm::irOps::IrOpcode::SDiv:
        case wallvm::irOps::IrOpcode::UDiv:
        case wallvm::irOps::IrOpcode::SRem:
        case wallvm::irOps::IrOpcode::URem:
        case wallvm::irOps::IrOpcode::And:
        case wallvm::irOps::IrOpcode::Or:
        case wallvm::irOps::IrOpcode::Xor:
        case wallvm::irOps::IrOpcode::Shl:
        case wallvm::irOps::IrOpcode::Ashr:
        case wallvm::irOps::IrOpcode::Lshr:
        case wallvm::irOps::IrOpcode::Rotl:
        case wallvm::irOps::IrOpcode::Rotr:
        case wallvm::irOps::IrOpcode::SMin:
        case wallvm::irOps::IrOpcode::SMax:
        case wallvm::irOps::IrOpcode::UMin:
        case wallvm::irOps::IrOpcode::UMax:
            self.emit(wallvm::irOps::irOpcodeStr(inst.opcode));
            self.emit(" ");
            self.emitType(inst.base.type);
            if (inst.nops > 0) { self.emit(" "); self.emitValueRef(inst.ops[0]); }
            if (inst.nops > 1) { self.emit(", "); self.emitValueRef(inst.ops[1]); }
            break;

        case wallvm::irOps::IrOpcode::Neg:
        case wallvm::irOps::IrOpcode::Not:
        case wallvm::irOps::IrOpcode::Abs:
        case wallvm::irOps::IrOpcode::CtPop:
        case wallvm::irOps::IrOpcode::CtLz:
        case wallvm::irOps::IrOpcode::CtTz:
        case wallvm::irOps::IrOpcode::Bswap:
        case wallvm::irOps::IrOpcode::FAbs:
        case wallvm::irOps::IrOpcode::FSqrt:
            self.emit(wallvm::irOps::irOpcodeStr(inst.opcode));
            self.emit(" ");
            self.emitType(inst.base.type);
            if (inst.nops > 0) { self.emit(" "); self.emitValueRef(inst.ops[0]); }
            break;

        case wallvm::irOps::IrOpcode::FAdd:
        case wallvm::irOps::IrOpcode::FSub:
        case wallvm::irOps::IrOpcode::FMul:
        case wallvm::irOps::IrOpcode::FDiv:
        case wallvm::irOps::IrOpcode::Fma:
            self.emit(wallvm::irOps::irOpcodeStr(inst.opcode));
            self.emit(" ");
            self.emitType(inst.base.type);
            if (inst.nops > 0) { self.emit(" "); self.emitValueRef(inst.ops[0]); }
            if (inst.nops > 1) { self.emit(", "); self.emitValueRef(inst.ops[1]); }
            if (inst.nops > 2) { self.emit(", "); self.emitValueRef(inst.ops[2]); }
            break;

        case wallvm::irOps::IrOpcode::Trunc:
        case wallvm::irOps::IrOpcode::Zext:
        case wallvm::irOps::IrOpcode::Sext:
        case wallvm::irOps::IrOpcode::FpTrunc:
        case wallvm::irOps::IrOpcode::FpExt:
        case wallvm::irOps::IrOpcode::FpToSi:
        case wallvm::irOps::IrOpcode::SiToFp:
        case wallvm::irOps::IrOpcode::FpToUi:
        case wallvm::irOps::IrOpcode::UiToFp:
        case wallvm::irOps::IrOpcode::Bitcast:
            self.emit(wallvm::irOps::irOpcodeStr(inst.opcode));
            self.emit(" ");
            self.emitType(inst.base.type);
            if (inst.nops > 0) { self.emit(" "); self.emitValueRef(inst.ops[0]); }
            break;

        case wallvm::irOps::IrOpcode::Load:
            self.emit("load ");
            self.emitType(inst.base.type);
            self.emit(", ");
            if (inst.nops > 0) self.emitValueRef(inst.ops[0]);
            break;

        case wallvm::irOps::IrOpcode::Store:
            self.emit("store ");
            self.emitType(inst.ops[0] ? inst.ops[0].type : null);
            self.emit(" ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            break;

        case wallvm::irOps::IrOpcode::Alloca:
            self.emit("alloca ");
            self.emitType(inst.base.type);
            break;

        case wallvm::irOps::IrOpcode::Gep:
            self.emit("gep ");
            self.emitType(inst.base.type);
            self.emit(" ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            break;

        case wallvm::irOps::IrOpcode::ICmp:
            self.emit("icmp ");
            self.emit(wallvm::irOps::irICmpStr(inst.icmpPred));
            self.emit(" ");
            self.emitType(inst.base.type);
            self.emit(" ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            break;

        case wallvm::irOps::IrOpcode::FCmp:
            self.emit("fcmp ");
            self.emit(wallvm::irOps::irFCmpStr(inst.fcmpPred));
            self.emit(" ");
            self.emitType(inst.base.type);
            self.emit(" ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            break;

        case wallvm::irOps::IrOpcode::Br:
            self.emit("br ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            break;

        case wallvm::irOps::IrOpcode::CondBr:
            self.emit("condbr ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 2 ? inst.ops[2] : null);
            break;

        case wallvm::irOps::IrOpcode::Ret:
            self.emit("ret");
            if (inst.nops > 0 && inst.ops[0])
            {
                self.emit(" ");
                self.emitType(inst.base.type);
                self.emit(" ");
                self.emitValueRef(inst.ops[0]);
            }
            break;

        case wallvm::irOps::IrOpcode::Call:
            self.emit("call ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            for (u32 i = 1; i < inst.nops; i++)
            {
                self.emit(", ");
                self.emitValueRef(inst.ops[i]);
            }
            break;

        case wallvm::irOps::IrOpcode::Select:
            self.emit("select ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 2 ? inst.ops[2] : null);
            break;

        case wallvm::irOps::IrOpcode::InlineAsm:
            self.emit("inlineasm \"");
            if (inst.asmString) self.emitCstr((const std::cchar*)inst.asmString);
            self.emit("\" \"");
            if (inst.asmConstraints) self.emitCstr((const std::cchar*)inst.asmConstraints);
            self.emit("\" \"");
            if (inst.asmClobbers) self.emitCstr((const std::cchar*)inst.asmClobbers);
            self.emit("\"");
            for (u32 i = 0; i < inst.nops; i++)
            {
                self.emit(", ");
                self.emitValueRef(inst.ops[i]);
            }
            break;

        case wallvm::irOps::IrOpcode::Phi:
            self.emit("phi ");
            self.emitType(inst.base.type);
            for (u32 i = 0; i < inst.nops; i += 2)
            {
                self.emit(" [");
                self.emitValueRef(inst.ops[i]);
                self.emit(", ");
                self.emitValueRef(inst.ops[i + 1]);
                self.emit("]");
            }
            break;

        case wallvm::irOps::IrOpcode::VecAdd:
        case wallvm::irOps::IrOpcode::VecSub:
        case wallvm::irOps::IrOpcode::VecMul:
        case wallvm::irOps::IrOpcode::VecDiv:
        case wallvm::irOps::IrOpcode::VecFAdd:
        case wallvm::irOps::IrOpcode::VecFSub:
        case wallvm::irOps::IrOpcode::VecFMul:
        case wallvm::irOps::IrOpcode::VecFDiv:
        case wallvm::irOps::IrOpcode::VecMin:
        case wallvm::irOps::IrOpcode::VecMax:
            self.emit(wallvm::irOps::irOpcodeStr(inst.opcode));
            self.emit(" ");
            self.emitType(inst.base.type);
            if (inst.nops > 0) { self.emit(" "); self.emitValueRef(inst.ops[0]); }
            if (inst.nops > 1) { self.emit(", "); self.emitValueRef(inst.ops[1]); }
            break;

        case wallvm::irOps::IrOpcode::VecBroadcast:
            self.emit("vec_broadcast ");
            self.emitType(inst.base.type);
            if (inst.nops > 0) { self.emit(" "); self.emitValueRef(inst.ops[0]); }
            break;

        case wallvm::irOps::IrOpcode::AtomicLoad:
            self.emit("atomic_load ");
            self.emitType(inst.base.type);
            self.emit(", ");
            if (inst.nops > 0) self.emitValueRef(inst.ops[0]);
            break;

        case wallvm::irOps::IrOpcode::AtomicStore:
            self.emit("atomic_store ");
            self.emitType(inst.ops[0] ? inst.ops[0].type : null);
            self.emit(" ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            break;

        case wallvm::irOps::IrOpcode::AtomicCmpXchg:
            self.emit("atomic_cmpxchg ");
            self.emitType(inst.base.type);
            self.emit(" ");
            self.emitValueRef(inst.nops > 0 ? inst.ops[0] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 1 ? inst.ops[1] : null);
            self.emit(", ");
            self.emitValueRef(inst.nops > 2 ? inst.ops[2] : null);
            break;

        case wallvm::irOps::IrOpcode::Unreachable:
            self.emit("unreachable");
            break;

        case wallvm::irOps::IrOpcode::GcRoot:
            self.emit("gc_root ");
            if (inst.nops > 0) self.emitValueRef(inst.ops[0]);
            break;

        case wallvm::irOps::IrOpcode::GcWriteBarrier:
            self.emit("gc_write_barrier ");
            if (inst.nops > 0) self.emitValueRef(inst.ops[0]);
            break;

        case wallvm::irOps::IrOpcode::GcSafepoint:
            self.emit("gc_safepoint");
            break;

        default:
            self.emit(wallvm::irOps::irOpcodeStr(inst.opcode));
            for (u32 i = 0; i < inst.nops; i++)
            {
                self.emit(" ");
                self.emitValueRef(inst.ops[i]);
            }
            break;
        }

        self.emit("\n");
    }

    void emitBlock(wallvm::ir_types::IrBlock* bb)
    {
        self.emit("@");
        self.emitCstr((const std::cchar*)bb.name);
        self.emitLine(":");
        for (u32 i = 0; i < bb.ninsts; i++)
            self.emitInst(bb.insts[i]);
    }

    void emitFunc(wallvm::ir_types::IrFunc* func)
    {
        if (func.isExtern)
        {
            self.emit("extern ");
            self.emitCstr((const std::cchar*)func.name);
            self.emit("\n");
            return;
        }
        self.emit("fn ");
        self.emitCstr((const std::cchar*)func.name);
        self.emit("(");
        for (u32 i = 0; i < func.nparams; i++)
        {
            if (i > 0) self.emit(", ");
            self.emitType(func.paramTypes[i]);
        }
        self.emit(") ");
        self.emitType(func.retType);
        self.emit("\n");
        for (u32 i = 0; i < func.nblocks; i++)
            self.emitBlock(func.blocks[i]);
    }

    void emitModule(wallvm::ir_types::IrModule* modd)
    {
        self.emit("; Module: ");
        self.emitLine(modd.name ? str::fromParts((const std::cchar*)modd.name, std::libc::strlen(modd.name)) : "unnamed");

        for (u32 i = 0; i < modd.nglobals; i++)
        {
            wallvm::ir_types::IrGlobal* g = modd.globals[i];
            self.emit("@");
            self.emitCstr((const std::cchar*)g.name);
            self.emit(" = ");
            self.emit(g.isConst ? "constant " : "global ");
            self.emitType(g.base.type);
            self.emit(" ");
            self.emitValueRef(g.initVal);
            self.emit("\n");
        }

        for (u32 i = 0; i < modd.nconstStrings; i++)
            self.emitStringConst(modd.constStrings[i]);

        self.emit("\n");

        for (u32 i = 0; i < modd.nfuncs; i++)
        {
            self.emitFunc(modd.funcs[i]);
            self.emit("\n");
        }
    }

    str getOutput() { return str::fromParts((const std::cchar*)self.output, self.len); }
}
