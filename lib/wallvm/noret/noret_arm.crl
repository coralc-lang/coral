mod std = import(lib) std;

pub struct NoretArm
{
    u64 exitCode;
    char* out;
    u32 outLen;
    u32 outCap;

    NoretArm new(u64 exitCode)
    {
        NoretArm n;
        n.exitCode = exitCode;
        n.out = null;
        n.outLen = 0;
        n.outCap = 0;
        return n;
    }

    void ensureCap(u32 needed)
    {
        if (self.outLen + needed <= self.outCap) return;
        u32 newCap = self.outCap ? self.outCap * 2 : 64;
        while (self.outLen + needed > newCap) newCap *= 2;
        char* newOut = std::mman::alloc<char>(newCap);
        if (self.out)
        {
            std::mman::copy<char>(newOut, self.out, self.outLen);
            std::mman::dealloc<char>(self.out);
        }
        self.out = newOut;
        self.outCap = newCap;
    }

    void c(char ch)
    {
        self.ensureCap(1);
        self.out[self.outLen++] = ch;
    }

    void s(str s) // on sum '.s()' shit
    {
        self.ensureCap(s.len);
        for (u32 i = 0; i < s.len; i++)
            self.out[self.outLen++] = (char)s.ptr[i];
    }

    str getString()
    {
        self.ensureCap(1);
        self.out[self.outLen] = 0;
        return str::fromParts((const u8*)self.out, self.outLen);
    }

    void clear()
    {
        self.outLen = 0;
    }

    void destroy()
    {
        if (self.out) std::mman::dealloc<char>(self.out);
    }

    void emitLinuxSyscall()
    {
        self.emitMovImm(str::fromCstr((const u8*)"r0"), self.exitCode);
        self.c('\n');
        self.emitMovImm(str::fromCstr((const u8*)"r7"), 1);
        self.c('\n');
        self.s("\tsvc #0");
        self.c('\n');
    }

    void emitWindowsTerminate()
    {
        self.emitMovImm(str::fromCstr((const u8*)"r0"), self.exitCode);
        self.c('\n');
        self.s("\tbl ExitProcess");
        self.c('\n');
    }

    void emitBareMetalHalt()
    {
        self.s(".halt:");
        self.c('\n');
        self.s("\twfi");
        self.c('\n');
        self.s("\tb .halt");
        self.c('\n');
    }

    void emitNoretPlatform(str platform)
    {
        if (platformMatch(platform, str::fromCstr((const u8*)"LINUX")))
            self.emitLinuxSyscall();
        else if (platformMatch(platform, str::fromCstr((const u8*)"WINDOWS")))
            self.emitWindowsTerminate();
        else
            self.emitBareMetalHalt();
    }

    void emitMovImm(str reg, u64 imm)
    {
        self.s("\tmov ");
        self.s(reg);
        self.s(", #");
        u64 val = imm;
        char buf[24];
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val) { buf[n++] = (char)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }
}

static bool platformMatch(str platform, str known)
{
    if (platform.isEmpty() || known.isEmpty()) return false;
    if (platform.len != known.len) return false;
    for (u32 i = 0; i < platform.len; i++)
    {
        char a = (char)platform.ptr[i];
        char k = (char)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
