import(lib) std::mman { alloc, dealloc, copy };
import(lib) core::cchar { cchar };

pub struct NoretX86_64
{
    u64 exitCode;
    char* out;
    u32 outLen;
    u32 outCap;

    NoretX86_64 new(u64 exitCode)
    {
        return NoretX86_64 {
            .exitCode = exitCode,
            .out = null,
            .outLen = 0,
            .outCap = 0
        };
    }

    void ensureCap(u32 needed)
    {
        if (self.outLen + needed <= self.outCap) return;
        u32 newCap = self.outCap ? self.outCap * 2 : 64;
        while (self.outLen + needed > newCap) newCap *= 2;
        char* newOut = alloc<char>(newCap);
        if (self.out != null)
        {
            copy<char>(newOut, self.out, self.outLen);
            dealloc<char>(self.out);
        }
        self.out = newOut;
        self.outCap = newCap;
    }

    void c(char ch)
    {
        self.ensureCap(1);
        self.out[self.outLen++] = ch;
    }

    void s(str s)
    {
        self.ensureCap(s.len);
        for (u32 i = 0; i < s.len; i++)
            self.out[self.outLen++] = (char)s.ptr[i];
    }

    str getString()
    {
        self.ensureCap(1);
        self.out[self.outLen] = 0;
        return str::fromParts((const u8*)self.out, self.outLen);
    }

    void clear()
    {
        self.outLen = 0;
    }

    void destroy()
    {
        if (self.out != null) dealloc<char>(self.out);
    }

    void emitLinuxSyscall()
    {
        self.emitMovRegImm64(str::fromCstr((const cchar*)"rax"), 60);
        self.c('\n');
        self.emitMovRegImm64(str::fromCstr((const cchar*)"rdi"), self.exitCode);
        self.c('\n');
        self.emitSyscall();
        self.c('\n');
    }

    void emitWindowsTerminate()
    {
        self.emitMovRegImm32(str::fromCstr((const cchar*)"ecx"), (u32)self.exitCode);
        self.c('\n');
        self.emitCall(str::fromCstr((const cchar*)"ExitProcess"));
        self.c('\n');
    }

    void emitMacOSExit()
    {
        self.s("mov $0x2000001, %rax");
        self.c('\n');
        self.emitMovRegImm64(str::fromCstr((const cchar*)"rdi"), self.exitCode);
        self.c('\n');
        self.emitSyscall();
        self.c('\n');
    }

    void emitBareMetalHalt()
    {
        self.emitCli();
        self.c('\n');
        self.emitLabel(str::fromCstr((const cchar*)".halt"));
        self.c('\n');
        self.emitHlt();
        self.c('\n');
        self.emitJmp(str::fromCstr((const cchar*)".halt"));
        self.c('\n');
    }

    void emitNoretPlatform(str platform)
    {
        if (platformMatch(platform, str::fromCstr((const cchar*)"LINUX")))
            self.emitLinuxSyscall();
        else if (platformMatch(platform, str::fromCstr((const cchar*)"WINDOWS")))
            self.emitWindowsTerminate();
        else if (platformMatch(platform, str::fromCstr((const cchar*)"MACOS")))
            self.emitMacOSExit();
        else
            self.emitBareMetalHalt();
    }

    void emitMovRegImm64(str reg, u64 imm)
    {
        self.s("mov ");
        self.s("$");
        u64 val = imm;
        char buf[24];
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (char)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
        self.s(", %");
        self.s(reg);
    }

    void emitMovRegImm32(str reg, u32 imm)
    {
        self.s("mov $");
        u32 val = imm;
        char buf[16];
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (char)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
        self.s(", %");
        self.s(reg);
    }

    void emitSyscall()
    {
        self.s("\tsyscall");
    }

    void emitCall(str target)
    {
        self.s("\tcall ");
        self.s(target);
    }

    void emitCli()
    {
        self.s("\tcli");
    }

    void emitHlt()
    {
        self.s("\thlt");
    }

    void emitLabel(str label)
    {
        self.s(label);
        self.c(':');
    }

    void emitJmp(str target)
    {
        self.s("\tjmp ");
        self.s(target);
    }
}

static bool platformMatch(str platform, str known)
{
    if (platform.isEmpty() || known.isEmpty()) return false;
    if (platform.len != known.len) return false;
    for (u32 i = 0; i < platform.len; i++)
    {
        char a = (char)platform.ptr[i];
        char k = (char)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
