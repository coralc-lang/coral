mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

pub const u32 WALLVM_VERSION_MAJOR = 0;
pub const u32 WALLVM_VERSION_MINOR = 1;
pub const u32 WALLVM_VERSION_PATCH = 0;

// Loop unrolling is opt-in: --funroll.
pub bool gUnrollEnabled = false;

pub bool(wallvm::ir_types::IrFunc*, rawptr) PassFn;

pub struct PassPipeline
{
    PassFn** passes;
    str* names;
    u32 count;
    u32 capacity;

    PassPipeline new()
    {
        PassPipeline p;
        p.passes = null;
        p.names = null;
        p.count = 0;
        p.capacity = 0;
        return p;
    }

    void add(PassFn* fn, str name)
    {
        if (self.count >= self.capacity)
        {
            u32 nc = self.capacity ? self.capacity * 2 : 8;
            PassFn** np = std::mman::alloc<PassFn*>(nc);
            str* nn = std::mman::alloc<str>(nc);
            for (u32 i = 0; i < self.count; i++)
            {
                np[i] = self.passes[i];
                nn[i] = self.names[i];
            }
            if (self.passes) std::mman::dealloc<PassFn*>(self.passes);
            if (self.names) std::mman::dealloc<str>(self.names);
            self.passes = np;
            self.names = nn;
            self.capacity = nc;
        }
        self.passes[self.count] = fn;
        self.names[self.count] = name;
        self.count++;
    }

    void clear()
    {
        if (self.passes) std::mman::dealloc<PassFn*>(self.passes);
        if (self.names) std::mman::dealloc<str>(self.names);
        self.passes = null;
        self.names = null;
        self.count = 0;
        self.capacity = 0;
    }

    bool runOnFunc(wallvm::ir_types::IrFunc* func, rawptr ctx)
    {
        bool changed = false;
        for (u32 i = 0; i < self.count; i++)
        {
            if (self.passes[i](func, ctx))
                changed = true;
        }
        return changed;
    }

    // Run the pipeline repeatedly until no pass makes changes.
    // This allows passes that expose new opportunities for each other
    // to converge (e.g., constfold exposes algebraic, which exposes
    // constfold again, etc.)
    bool runOnFuncIterate(wallvm::ir_types::IrFunc* func, rawptr ctx, u32 maxIters)
    {
        bool anyChanged = false;
        for (u32 iter = 0; iter < maxIters; iter++)
        {
            bool changed = false;
            for (u32 i = 0; i < self.count; i++)
            {
                if (self.passes[i](func, ctx))
                    changed = true;
            }
            if (!changed) break;
            anyChanged = true;
        }
        return anyChanged;
    }
}

pub PassPipeline pipelineLevel0()
{
    PassPipeline p = PassPipeline::new();
    p.add(wallvm::passes::validate.irPassValidate, "validate");
    p.add(wallvm::passes::algebraic.irPassSimplify, "simplify");
    p.add(wallvm::passes::constfold.irPassConstfold, "constfold");
    p.add(wallvm::passes::sccp.irPassSccp, "sccp");
    p.add(wallvm::passes::dce.irPassDce, "dce");
    p.add(wallvm::passes::validate.irPassValidate, "validate");
    return p;
}

pub PassPipeline pipelineLevel1()
{
    PassPipeline p = PassPipeline::new();
    p.add(wallvm::passes::validate.irPassValidate, "validate");
    p.add(wallvm::passes::abi_lower.irABILower, "abi_lower");
    p.add(wallvm::passes::comm_canon.irPassCommCanonicalize, "comm_canon");
    p.add(wallvm::passes::algebraic.irPassSimplify, "simplify");
    p.add(wallvm::passes::constfold.irPassConstfold, "constfold");
    p.add(wallvm::passes::involution.irPassInvolution, "involution");
    p.add(wallvm::passes::sccp.irPassSccp, "sccp");
    p.add(wallvm::passes::range.irPassRange, "range");
    p.add(wallvm::passes::range.irPassRangeBranchElim, "range_br_elim");
    p.add(wallvm::passes::branchprop.irPassBranchProp, "branchprop");
    p.add(wallvm::passes::branch_inversion.irPassBranchInversionFlat, "branch_inv_flat");
    p.add(wallvm::passes::cse.irPassCse, "cse");
    p.add(wallvm::passes::cast_elim.irPassCastElimination, "cast_elim");
    p.add(wallvm::passes::dse.irPassDse, "dse");
    p.add(wallvm::passes::jump_thread.irPassJumpThread, "jump_thread");
    p.add(wallvm::passes::idiom.irPassIdiom, "idiom");
    p.add(wallvm::passes::peephole.irPassPeephole, "peephole");
    p.add(wallvm::passes::dce.irPassDce, "dce");
    p.add(wallvm::passes::validate.irPassValidate, "validate");
    return p;
}

