mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Idempotent Op Removal / Redundant Write Suppression:
// Detects consecutive identical store operations to the same memory location
// with no intervening read or side effect, and strips the redundant write.
// Also handles: redundant loads (load from same address when value hasn't changed),
// redundant GEP chains, redundant bitcasts.
pub struct IdempotentPass
{
    wallvm::ir_types::IrContext* ctx;
    u64 removals;

    IdempotentPass new(wallvm::ir_types::IrContext* ctx)
    {
        IdempotentPass p;
        p.ctx = ctx;
        p.removals = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.removals = 0;
        bool anyChanged = false;
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                if (self.processInst(bb, ii))
                {
                    anyChanged = true;
                    // Instruction removed or rewritten; restart this block from 0
                    // (indices shifted) but don't restart from block 0
                    ii = 0;
                }
                else
                {
                    ii++;
                }
            }
        }
        return anyChanged;
    }

    bool processInst(wallvm::ir_types::IrBlock* bb, u32 idx)
    {
        wallvm::ir_types::IrInst* inst = bb.insts[idx];

        // Pattern 1: Consecutive identical stores to same address
        // store [addr], val1; ... store [addr], val2  where val1 == val2
        if (inst.opcode == wallvm::irOps::IrOpcode::Store && inst.nops >= 2)
        {
            wallvm::ir_types::IrValue* addr = inst.ops[1];
            wallvm::ir_types::IrValue* val = inst.ops[0];

            // Look backwards for an earlier store to the same address
            for (u32 pi = idx; pi > 0; pi--)
            {
                wallvm::ir_types::IrInst* prev = bb.insts[pi - 1];
                if (prev == inst) continue;

                // Stop at side effects
                if (prev.opcode == wallvm::irOps::IrOpcode::Call ||
                    prev.opcode == wallvm::irOps::IrOpcode::Store ||
                    prev.opcode == wallvm::irOps::IrOpcode::AtomicStore ||
                    prev.opcode == wallvm::irOps::IrOpcode::AtomicLoad ||
                    prev.opcode == wallvm::irOps::IrOpcode::AtomicRmw ||
                    prev.opcode == wallvm::irOps::IrOpcode::Fence ||
                    prev.opcode == wallvm::irOps::IrOpcode::InlineAsm)
                    break;

                if (prev.opcode == wallvm::irOps::IrOpcode::Load && prev.nops >= 1)
                {
                    // If the load reads from the same address as our store,
                    // the store is the last write and a previous store is redundant
                    if (prev.ops[0] == addr)
                        break; // intervening load reads from same addr - keep store
                }

                if (prev.opcode == wallvm::irOps::IrOpcode::Store && prev.nops >= 2)
                {
                    if (prev.ops[1] == addr && prev.ops[0] == val)
                    {
                        // Same address, same value, no side effects between - remove earlier store
                        // Actually remove the EARLIER (redundant) store
                        for (u32 ri = 0; ri < prev.nops; ri++)
                            if (prev.ops[ri]) prev.ops[ri].removeUser(prev);
                        for (u32 ri = pi - 1; ri + 1 < bb.ninsts; ri++)
                            bb.insts[ri] = bb.insts[ri + 1];
                        bb.ninsts--;
                        self.removals++;
                        return true;
                    }
                }
            }
        }

        // Pattern 2: Redundant load - load from address that was just stored to
        // store [addr], val; load [addr] -> val (bypass the load)
        if (inst.opcode == wallvm::irOps::IrOpcode::Load && inst.nops >= 1)
        {
            wallvm::ir_types::IrValue* addr = inst.ops[0];

            for (u32 pi = idx; pi > 0; pi--)
            {
                wallvm::ir_types::IrInst* prev = bb.insts[pi - 1];
                if (prev == inst) continue;

                // Stop at side effects that might modify memory
                if (prev.opcode == wallvm::irOps::IrOpcode::Call ||
                    prev.opcode == wallvm::irOps::IrOpcode::Store ||
                    prev.opcode == wallvm::irOps::IrOpcode::AtomicStore ||
                    prev.opcode == wallvm::irOps::IrOpcode::AtomicLoad ||
                    prev.opcode == wallvm::irOps::IrOpcode::AtomicRmw ||
                    prev.opcode == wallvm::irOps::IrOpcode::Fence ||
                    prev.opcode == wallvm::irOps::IrOpcode::InlineAsm)
                    break;

                if (prev.opcode == wallvm::irOps::IrOpcode::Store && prev.nops >= 2)
                {
                    if (prev.ops[1] == addr)
                    {
                        // Load from address that was just stored to
                        // Replace load uses with the stored value
                        inst.base.replaceAllUses(prev.ops[0]);
                        inst.erase();
                        self.removals++;
                        return true;
                    }
                }
            }
        }

        // Pattern 3: Redundant bitcast of bitcast
        if (inst.opcode == wallvm::irOps::IrOpcode::Bitcast && inst.nops == 1 &&
            inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
        {
            wallvm::ir_types::IrInst* inner = (wallvm::ir_types::IrInst*)inst.ops[0];
            if (inner.opcode == wallvm::irOps::IrOpcode::Bitcast && inner.nops == 1)
            {
                // Same type bitcast chain is identity
                inst.base.replaceAllUses(inner.ops[0]);
                inst.erase();
                self.removals++;
                return true;
            }
        }

        // Pattern 4: Redundant GEP with zero index
        // gep base, 0 -> base
        if (inst.opcode == wallvm::irOps::IrOpcode::Gep && inst.nops >= 2)
        {
            bool allZero = true;
            for (u32 oi = 1; oi < inst.nops; oi++)
            {
                if (!inst.ops[oi] || inst.ops[oi].kind != wallvm::ir_types::IrValueKind::ConstInt ||
                    inst.ops[oi].valData != 0)
                {
                    allZero = false;
                    break;
                }
            }
            if (allZero)
            {
                inst.base.replaceAllUses(inst.ops[0]);
                inst.erase();
                self.removals++;
                return true;
            }
        }

        // Pattern 5: Redundant alloca that is never used (dead alloca)
        if (inst.opcode == wallvm::irOps::IrOpcode::Alloca && inst.base.nusers == 0)
        {
            inst.erase();
            self.removals++;
            return true;
        }

        return false;
    }
}

pub bool irPassIdempotent(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;
    IdempotentPass pass = IdempotentPass::new(ctx);
    return pass.run(func);
}