mod wallvm = import(lib) wallvm;
mod std = import(lib) std;
mod alias = import file::alias_analysis;

// MemorySSA: A memory dependency web built on top of alias analysis.
//
// MemorySSA assigns a "memory version" to each instruction that reads or
// writes memory. This allows efficient querying of:
// - What is the last store that may have affected this load?
// - Does a store kill a prior load?
// - Is a load redundant after a prior store?
//
// Structure:
// - MemoryDef: An instruction that writes memory (store, call, fence, etc.)
//   Each MemoryDef gets a unique ID and tracks which objects it may modify.
// - MemoryUse: An instruction that reads memory (load, call)
//   Each MemoryUse points to the most recent MemoryDef it may read past.
// - MemoryPhi: At control flow joins, merges MemoryDefs from predecessors.
//
// This enables GVN, DSE, and vectorizer to make correct aliasing decisions.
// Without MemorySSA, these passes must conservatively assume all memory
// operations alias each other.

pub struct MemorySSA
{
    alias.AliasAnalysis* aliasAnalysis;

    // Per-instruction memory version numbers
    // memVer[instruction_id] = memory version at this point
    u32* memVer;
    u32 memVerCap;

    // Memory version -> definition info
    // For versions that are MemoryDefs, store the instruction that defines them
    wallvm::ir_types::IrInst** memDefInst;
    u32* memDefBlock;
    u32* memDefObjCount;
    u32** memDefObjects;
    u32 numMemVersions;
    u32 memDefCap;

    // Current memory version per block (at block exit)
    u32* blockExitMemVer;
    u32 numBlocks;

    // Current live memory version during scan
    u32 currentMemVer;

    MemorySSA new(alias.AliasAnalysis* aa)
    {
        MemorySSA m;
        m.aliasAnalysis = aa;
        m.memVer = null;
        m.memVerCap = 0;
        m.memDefInst = null;
        m.memDefBlock = null;
        m.memDefObjCount = null;
        m.memDefObjects = null;
        m.numMemVersions = 0;
        m.memDefCap = 0;
        m.blockExitMemVer = null;
        m.numBlocks = 0;
        m.currentMemVer = 0;
        return m;
    }

    void deinit()
    {
        if (self.memVer) std::mman::dealloc(self.memVer);
        if (self.memDefInst) std::mman::dealloc(self.memDefInst);
        if (self.memDefBlock) std::mman::dealloc(self.memDefBlock);
        if (self.memDefObjCount) std::mman::dealloc(self.memDefObjCount);
        if (self.memDefObjects)
        {
            for (u32 i = 0; i < self.numMemVersions; i++)
            {
                if (self.memDefObjects[i])
                    std::mman::dealloc(self.memDefObjects[i]);
            }
            std::mman::dealloc(self.memDefObjects);
        }
        if (self.blockExitMemVer) std::mman::dealloc(self.blockExitMemVer);
    }

    void ensureMemVer(u32 id)
    {
        if (id < self.memVerCap) return;
        u32 newCap = self.memVerCap ? self.memVerCap * 2 : 256;
        while (newCap <= id) newCap *= 2;
        u32* newArr = std::mman::alloc<u32>(newCap);
        for (u32 i = 0; i < self.memVerCap; i++)
            newArr[i] = self.memVer[i];
        for (u32 i = self.memVerCap; i < newCap; i++)
            newArr[i] = 0;
        if (self.memVer) std::mman::dealloc(self.memVer);
        self.memVer = newArr;
        self.memVerCap = newCap;
    }

    void ensureMemDef(u32 needed)
    {
        if (needed <= self.memDefCap) return;
        u32 newCap = self.memDefCap ? self.memDefCap * 2 : 64;
        while (newCap < needed) newCap *= 2;
        wallvm::ir_types::IrInst** newInst = std::mman::alloc<wallvm::ir_types::IrInst*>(newCap);
        u32* newBlock = std::mman::alloc<u32>(newCap);
        u32* newObjCount = std::mman::alloc<u32>(newCap);
        u32** newObjects = std::mman::alloc<u32*>(newCap);
        for (u32 i = 0; i < self.memDefCap; i++)
        {
            newInst[i] = self.memDefInst[i];
            newBlock[i] = self.memDefBlock[i];
            newObjCount[i] = self.memDefObjCount[i];
            newObjects[i] = self.memDefObjects[i];
        }
        for (u32 i = self.memDefCap; i < newCap; i++)
        {
            newInst[i] = null;
            newBlock[i] = 0;
            newObjCount[i] = 0;
            newObjects[i] = null;
        }
        if (self.memDefInst) std::mman::dealloc(self.memDefInst);
        if (self.memDefBlock) std::mman::dealloc(self.memDefBlock);
        if (self.memDefObjCount) std::mman::dealloc(self.memDefObjCount);
        if (self.memDefObjects) std::mman::dealloc(self.memDefObjects);
        self.memDefInst = newInst;
        self.memDefBlock = newBlock;
        self.memDefObjCount = newObjCount;
        self.memDefObjects = newObjects;
        self.memDefCap = newCap;
    }

    // Create a new MemoryDef for a memory-writing instruction.
    // Returns the new memory version number.
    u32 createMemoryDef(wallvm::ir_types::IrInst* inst, u32 blockIndex, u32 parentVersion)
    {
        u32 newVer = self.numMemVersions;
        self.ensureMemDef(newVer + 1);
        self.numMemVersions = newVer + 1;

        self.memDefInst[newVer] = inst;
        self.memDefBlock[newVer] = blockIndex;
        self.memDefObjCount[newVer] = 0;
        self.memDefObjects[newVer] = null;

        // Determine which objects this def modifies
        if (inst && self.aliasAnalysis)
        {
            if (inst.opcode == wallvm::irOps::IrOpcode::Store && inst.nops >= 2)
            {
                u32 objId = self.aliasAnalysis.walkAddr(inst.ops[1]);
                if (objId != alias.OBJECT_UNKNOWN)
                {
                    self.memDefObjects[newVer] = std::mman::alloc<u32>(1);
                    self.memDefObjects[newVer][0] = objId;
                    self.memDefObjCount[newVer] = 1;
                }
            }
            else if (inst.opcode == wallvm::irOps::IrOpcode::AtomicStore && inst.nops >= 2)
            {
                u32 objId = self.aliasAnalysis.walkAddr(inst.ops[1]);
                if (objId != alias.OBJECT_UNKNOWN)
                {
                    self.memDefObjects[newVer] = std::mman::alloc<u32>(1);
                    self.memDefObjects[newVer][0] = objId;
                    self.memDefObjCount[newVer] = 1;
                }
            }
            else
            {
                // Call, fence, asm: may modify anything
                self.memDefObjCount[newVer] = 0;
                self.memDefObjects[newVer] = null;
            }
        }

        return newVer;
    }

    // Check if a MemoryDef at version 'defVer' may alias a load from address 'loadAddr'.
    bool defMayAliasLoad(u32 defVer, wallvm::ir_types::IrValue* loadAddr)
    {
        if (defVer == 0) return false;
        if (defVer >= self.numMemVersions) return true;

        wallvm::ir_types::IrInst* defInst = self.memDefInst[defVer];
        if (!defInst) return true;

        // Call, fence, asm may modify anything
        if (defInst.opcode == wallvm::irOps::IrOpcode::Call
            || defInst.opcode == wallvm::irOps::IrOpcode::Fence
            || defInst.opcode == wallvm::irOps::IrOpcode::InlineAsm)
            return true;

        // Store: check if it may alias the load address
        if (defInst.opcode == wallvm::irOps::IrOpcode::Store && defInst.nops >= 2)
        {
            if (self.aliasAnalysis)
                return self.aliasAnalysis.mayClobber(loadAddr, defInst.ops[1]);
            return true;
        }

        if (defInst.opcode == wallvm::irOps::IrOpcode::AtomicStore && defInst.nops >= 2)
        {
            if (self.aliasAnalysis)
                return self.aliasAnalysis.mayClobber(loadAddr, defInst.ops[1]);
            return true;
        }

        return true;
    }

    // Find the nearest dominating MemoryDef that may alias with a load at the given address.
    // Returns the memory version of that def, or 0 if no aliasing def found.
    u32 findNearestDefForLoad(wallvm::ir_types::IrValue* loadAddr, u32 startingMemVer)
    {
        u32 ver = startingMemVer;
        u32 visited = 0;
        while (ver > 0 && visited < 256)
        {
            visited++;
            if (self.defMayAliasLoad(ver, loadAddr))
                return ver;
            ver--;
        }
        return 0;
    }

    // Check if a store at version 'storeVer' kills a load at version 'loadVer'.
    // (i.e., the store definitely overwrites the same memory the load reads)
    bool doesStoreKillLoad(u32 storeVer, wallvm::ir_types::IrValue* loadAddr)
    {
        if (storeVer == 0 || storeVer >= self.numMemVersions) return false;
        wallvm::ir_types::IrInst* storeInst = self.memDefInst[storeVer];
        if (!storeInst) return false;

        if (storeInst.opcode == wallvm::irOps::IrOpcode::Store && storeInst.nops >= 2)
        {
            if (self.aliasAnalysis)
                return self.aliasAnalysis.isMustAlias(loadAddr, storeInst.ops[1]);
        }
        return false;
    }

    // Build MemorySSA for a function.
    void build(wallvm::ir_types::IrFunc* func)
    {
        self.numMemVersions = 1; // Version 0 is the entry "live on entry"
        self.currentMemVer = 0;
        self.numBlocks = func.nblocks;
        self.blockExitMemVer = std::mman::alloc<u32>(func.nblocks);
        for (u32 i = 0; i < func.nblocks; i++)
            self.blockExitMemVer[i] = 0;

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func.blocks[bi];

            // At block entry, if multiple predecessors, create a phi-like merge
            if (bi > 0)
            {
                u32 predCount = 0;
                for (u32 pi = 0; pi < func.nblocks; pi++)
                {
                    if (pi == bi) continue;
                    wallvm::ir_types::IrBlock* pred = func.blocks[pi];
                    for (u32 si = 0; si < pred.ninsts; si++)
                    {
                        wallvm::ir_types::IrInst* term = pred.insts[si];
                        if (term.opcode == wallvm::irOps::IrOpcode::Br && term.nops >= 1 && term.ops[0].id == bb.base.id)
                            predCount++;
                        if (term.opcode == wallvm::irOps::IrOpcode::CondBr && term.nops >= 3)
                        {
                            if (term.ops[1].id == bb.base.id) predCount++;
                            if (term.ops[2].id == bb.base.id) predCount++;
                        }
                    }
                }
                if (predCount >= 2)
                {
                    // Create a phi memory version
                    self.currentMemVer = self.numMemVersions;
                    self.ensureMemDef(self.numMemVersions + 1);
                    self.memDefInst[self.numMemVersions] = null;
                    self.memDefBlock[self.numMemVersions] = bi;
                    self.memDefObjCount[self.numMemVersions] = 0;
                    self.memDefObjects[self.numMemVersions] = null;
                    self.numMemVersions++;
                }
            }

            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];

                // Assign memory version to this instruction
                self.ensureMemVer(inst.base.id + 1);
                self.memVer[inst.base.id] = self.currentMemVer;

                // Memory-writing instructions create a new version
                if (inst.opcode == wallvm::irOps::IrOpcode::Store
                    || inst.opcode == wallvm::irOps::IrOpcode::AtomicStore
                    || inst.opcode == wallvm::irOps::IrOpcode::AtomicRmw
                    || inst.opcode == wallvm::irOps::IrOpcode::Fence
                    || inst.opcode == wallvm::irOps::IrOpcode::InlineAsm
                    || inst.opcode == wallvm::irOps::IrOpcode::Call)
                {
                    u32 newVer = self.createMemoryDef(inst, bi, self.currentMemVer);
                    self.currentMemVer = newVer;
                    self.ensureMemVer(inst.base.id + 1);
                    self.memVer[inst.base.id] = self.currentMemVer;
                }
            }

            self.blockExitMemVer[bi] = self.currentMemVer;
        }
    }

    // Get the memory version at a given instruction.
    u32 getVersionAtInst(wallvm::ir_types::IrInst* inst)
    {
        if (!inst) return 0;
        self.ensureMemVer(inst.base.id + 1);
        return self.memVer[inst.base.id];
    }

    // Get the memory version at block exit.
    u32 getVersionAtBlockExit(u32 blockIndex)
    {
        if (blockIndex >= self.numBlocks) return 0;
        return self.blockExitMemVer[blockIndex];
    }

    // Check if a load at the given instruction is redundant after a prior store.
    // Returns true if the load is guaranteed to return the value from the most
    // recent store to the same address.
    bool isLoadRedundant(wallvm::ir_types::IrInst* loadInst, wallvm::ir_types::IrInst* priorStore)
    {
        if (!loadInst || !priorStore) return false;
        if (loadInst.opcode != wallvm::irOps::IrOpcode::Load) return false;
        if (priorStore.opcode != wallvm::irOps::IrOpcode::Store) return false;
        if (loadInst.nops < 1 || priorStore.nops < 2) return false;

        return self.aliasAnalysis.isMustAlias(loadInst.ops[0], priorStore.ops[1]);
    }

    // Get the MemoryDef info for a given memory version.
    // Returns null if the version is 0 (entry) or a phi.
    wallvm::ir_types::IrInst* getDefInstForVersion(u32 memVersion)
    {
        if (memVersion == 0 || memVersion >= self.numMemVersions) return null;
        return self.memDefInst[memVersion];
    }
}

pub bool irMemorySSA(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;

    wallvm::ir_types::FunctionAnalysisCache* cache = ctx.getOrCreateAnalysisCache(func);
    if (cache.memorySSA) return false;

    // Use cached AA if available, otherwise create new
    alias::alias::alias::alias::alias::AliasAnalysis* aaPtr = (alias::alias::alias::alias::alias::AliasAnalysis*)cache.aliasAnalysis;
    alias::alias::alias::alias::alias::AliasAnalysis aa;
    bool ownAA = false;
    if (aaPtr)
    {
        aa = *aaPtr;
    }
    else
    {
        aa = alias::alias::alias::alias::alias::AliasAnalysis::new(ctx);
        aa.analyze(func);
        ownAA = true;
    }

    MemorySSA mssa = MemorySSA::new(&aa);
    mssa.build(func);

    // Store in cache (heap-allocated copy)
    MemorySSA* cached = std::mman::alloc<MemorySSA>(1);
    *cached = mssa;
    cache.memorySSA = cached;

    // We don't own the local mssa anymore (it was moved to cache)
    // Don't deinit it. If we created AA, don't deinit it either since cache holds pointer.
    return false;
}
