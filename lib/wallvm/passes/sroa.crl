import(lib) wallvm::irtypes { IrFunc, IrBlock, IrInst, IrValue };
import(lib) wallvm::irOps { IrOpcode };

// Return Value Optimization (RVO)
// Replaces alloca→store→load patterns with direct value forwarding.

pub bool irPassSROA(IrFunc* func, rawptr userdata)
{
    if (func == null || func->isExtern) return false;
    if (func->nblocks == 0) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            if (inst->opcode != IrOpcode::Alloca) continue;

            IrInst* storeInst = null;
            IrInst* loadInsts[16];
            u32 nLoads = 0;
            u32 storeCount = 0;
            bool safe = true;

            for (u32 bj = 0; bj < func->nblocks; bj++)
            {
                IrBlock* b = func->blocks[bj];
                for (u32 ij = 0; ij < b->ninsts; ij++)
                {
                    IrInst* use = b->insts[ij];
                    if (use->opcode == IrOpcode::Store && use->nops >= 2)
                    {
                        if (use->ops[1] == &inst->base)
                        {
                            storeInst = use;
                            storeCount++;
                        }
                    }
                    else if (use->opcode == IrOpcode::Load && use->nops >= 1)
                    {
                        if (use->ops[0] == &inst->base)
                        {
                            if (nLoads < 16)
                                loadInsts[nLoads] = use;
                            nLoads++;
                        }
                    }
                    else if (use->opcode == IrOpcode::Gep ||
                             use->opcode == IrOpcode::AtomicLoad ||
                             use->opcode == IrOpcode::AtomicStore)
                    {
                        if (use->nops > 0 && use->ops[0] == &inst->base)
                            safe = false;
                    }
                }
            }

            if (!safe || storeCount != 1 || nLoads == 0 || storeInst == null)
                continue;

            IrValue* storedVal = storeInst->ops[0];

            for (u32 li = 0; li < nLoads; li++)
            {
                IrInst* loadInst = loadInsts[li];
                for (u32 bj = 0; bj < func->nblocks; bj++)
                {
                    IrBlock* b = func->blocks[bj];
                    for (u32 ij = 0; ij < b->ninsts; ij++)
                    {
                        IrInst* use = b->insts[ij];
                        for (u32 oi = 0; oi < use->nops; oi++)
                        {
                            if (use->ops[oi] == &loadInst->base)
                                use->ops[oi] = storedVal;
                        }
                    }
                }
                loadInst->opcode = IrOpcode::Noret;
                loadInst->nops = 0;
            }

            inst->opcode = IrOpcode::Noret;
            inst->nops = 0;
            storeInst->opcode = IrOpcode::Noret;
            storeInst->nops = 0;
            changed = true;
        }
    }

    // Compact blocks, remove Noret (dead) instructions
    if (changed)
    {
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 writeIdx = 0;
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                if (bb->insts[ii]->opcode != IrOpcode::Noret)
                    bb->insts[writeIdx++] = bb->insts[ii];
            }
            bb->ninsts = writeIdx;
        }
    }

    return changed;
}
