mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Return Value Optimization (RVO)
// Replaces alloca→store→load patterns with direct value forwarding.

pub bool irPassSROA(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    if (!func || func*.isExtern) return false;
    if (func*.nblocks == 0) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func*.nblocks; bi++)
    {
        wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            if (inst.opcode != wallvm::irOps::IrOpcode::Alloca) continue;

            wallvm::ir_types::IrInst* storeInst = null;
            wallvm::ir_types::IrInst* loadInsts[16];
            u32 nLoads = 0;
            u32 storeCount = 0;
            bool safe = true;

            for (u32 bj = 0; bj < func*.nblocks; bj++)
            {
                wallvm::ir_types::IrBlock* b = func*.blocks[bj];
                for (u32 ij = 0; ij < b.ninsts; ij++)
                {
                    wallvm::ir_types::IrInst* use = b.insts[ij];
                    if (use.opcode == wallvm::irOps::IrOpcode::Store && use.nops >= 2)
                    {
                        if (use.ops[1] == &inst.base)
                        {
                            storeInst = use;
                            storeCount++;
                        }
                    }
                    else if (use.opcode == wallvm::irOps::IrOpcode::Load && use.nops >= 1)
                    {
                        if (use.ops[0] == &inst.base)
                        {
                            if (nLoads < 16)
                                loadInsts[nLoads] = use;
                            nLoads++;
                        }
                    }
                    else if (use.opcode == wallvm::irOps::IrOpcode::Gep ||
                             use.opcode == wallvm::irOps::IrOpcode::AtomicLoad ||
                             use.opcode == wallvm::irOps::IrOpcode::AtomicStore)
                    {
                        if (use.nops > 0 && use.ops[0] == &inst.base)
                            safe = false;
                    }
                }
            }

            if (!safe || storeCount != 1 || nLoads == 0 || !storeInst)
                continue;

            wallvm::ir_types::IrValue* storedVal = storeInst.ops[0];

            for (u32 li = 0; li < nLoads; li++)
            {
                wallvm::ir_types::IrInst* loadInst = loadInsts[li];
                for (u32 bj = 0; bj < func*.nblocks; bj++)
                {
                    wallvm::ir_types::IrBlock* b = func*.blocks[bj];
                    for (u32 ij = 0; ij < b.ninsts; ij++)
                    {
                        wallvm::ir_types::IrInst* use = b.insts[ij];
                        for (u32 oi = 0; oi < use.nops; oi++)
                        {
                            if (use.ops[oi] == &loadInst.base)
                                use.ops[oi] = storedVal;
                        }
                    }
                }
                loadInst.opcode = wallvm::irOps::IrOpcode::Noret;
                loadInst.nops = 0;
            }

            inst.opcode = wallvm::irOps::IrOpcode::Noret;
            inst.nops = 0;
            storeInst.opcode = wallvm::irOps::IrOpcode::Noret;
            storeInst.nops = 0;
            changed = true;
        }
    }

    // Compact blocks: remove Noret (dead) instructions
    if (changed)
    {
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            u32 writeIdx = 0;
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                if (bb.insts[ii].opcode != wallvm::irOps::IrOpcode::Noret)
                    bb.insts[writeIdx++] = bb.insts[ii];
            }
            bb.ninsts = writeIdx;
        }
    }

    return changed;
}
