mod wallvm = import(lib) wallvm;

pub struct AlgebraicSimplifyPass
{
    wallvm::ir_types::IrContext* ctx;
    u64 simplifications;

    AlgebraicSimplifyPass new(wallvm::ir_types::IrContext* ctx)
    {
        AlgebraicSimplifyPass p;
        p.ctx = ctx;
        p.simplifications = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.simplifications = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];
                if (self.simplify(inst))
                {
                    self.simplifications++;
                    changed = true;
                }
                else
                {
                    ii++;
                }
            }
        }
        return changed;
    }

    bool simplify(wallvm::ir_types::IrInst* inst)
    {
        // extension elimination collapse chains of sext/zext/trunc
        // Replacement results always keep the outer instruction result
        // width, so value semantics are preserved on every target
        if (inst.opcode == wallvm::irOps::IrOpcode::Sext ||
            inst.opcode == wallvm::irOps::IrOpcode::Zext ||
            inst.opcode == wallvm::irOps::IrOpcode::Trunc)
        {
            if (inst.nops != 1) return false;
            wallvm::ir_types::IrValue* s = inst.ops[0];
            if (!s || s.kind != wallvm::ir_types::IrValueKind::Inst) return false;
            wallvm::ir_types::IrInst* src = (wallvm::ir_types::IrInst*)s;
            if (src*.nops != 1) return false;
            u32 outW = inst.base.type ? inst.base.type.width : 64;

            // zext(zext(x)) *. zext(x, outW), same for sext and trunc
            if (src*.opcode == inst.opcode)
            {
                wallvm::ir_types::IrValue* ops[1] = { src*.ops[0] };
                wallvm::ir_types::IrInst* ni = self.ctx.createInst(inst.opcode, inst.base.type, ops, 1, 0, 0);
                ops[0].addUser(ni);
                inst.parent.insertBefore(ni, inst);
                inst.base.replaceAllUses(&ni.base);
                inst.erase();
                return true;
            }

            // sext(zext(x)) *. zext(x, outW); the sign bit is zero, so
            // sign extension never changes the valu
            if (inst.opcode == wallvm::irOps::IrOpcode::Sext &&
                src*.opcode == wallvm::irOps::IrOpcode::Zext)
            {
                wallvm::ir_types::IrValue* ops[1] = { src*.ops[0] };
                wallvm::ir_types::IrInst* ni = self.ctx.createInst(wallvm::irOps::IrOpcode::Zext, inst.base.type, ops, 1, 0, 0);
                ops[0].addUser(ni);
                inst.parent.insertBefore(ni, inst);
                inst.base.replaceAllUses(&ni.base);
                inst.erase();
                return true;
            }

            // trunc(zext/sext(y)) if the truncation stays within y's width
            // the extension is irrelevant; otherwise re-extend y directly
            if (inst.opcode == wallvm::irOps::IrOpcode::Trunc &&
                (src*.opcode == wallvm::irOps::IrOpcode::Zext || src*.opcode == wallvm::irOps::IrOpcode::Sext))
            {
                u32 innerW = src*.ops[0].type ? src*.ops[0].type.width : 64;
                if (outW == innerW)
                {
                    inst.base.replaceAllUses(src*.ops[0]);
                    inst.erase();
                    return true;
                }
                wallvm::irOps::IrOpcode op = (outW < innerW) ? wallvm::irOps::IrOpcode::Trunc : src*.opcode;
                wallvm::ir_types::IrValue* ops[1] = { src*.ops[0] };
                wallvm::ir_types::IrInst* ni = self.ctx.createInst(op, inst.base.type, ops, 1, 0, 0);
                ops[0].addUser(ni);
                inst.parent.insertBefore(ni, inst);
                inst.base.replaceAllUses(&ni.base);
                inst.erase();
                return true;
            }
            return false;
        }

        if (inst.nops != 2) return false;

        wallvm::ir_types::IrValue* a = inst.ops[0];
        wallvm::ir_types::IrValue* b = inst.ops[1];
        if (!a || !b) return false;

        bool aConst = a.kind == wallvm::ir_types::IrValueKind::ConstInt;
        bool bConst = b.kind == wallvm::ir_types::IrValueKind::ConstInt;

        // x * 0 = 0
        if (inst.opcode == wallvm::irOps::IrOpcode::Mul && bConst && b.valData == 0)
        {
            wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
            inst.base.replaceAllUses(zero);
            inst.erase();
            return true;
        }

        // x & 0 = 0
        if (inst.opcode == wallvm::irOps::IrOpcode::And && bConst && b.valData == 0)
        {
            wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
            inst.base.replaceAllUses(zero);
            inst.erase();
            return true;
        }

        // x | -1 = -1
        if (inst.opcode == wallvm::irOps::IrOpcode::Or && bConst)
        {
            u32 bits = inst.base.type ? inst.base.type.width : 64;
            u64 allOnes = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);
            if (b.valData == allOnes)
            {
                wallvm::ir_types::IrValue* ones = self.ctx.constInt(inst.base.type, allOnes);
                inst.base.replaceAllUses(ones);
                inst.erase();
                return true;
            }
        }

        // x ^ 0 = x
        if (inst.opcode == wallvm::irOps::IrOpcode::Xor && bConst && b.valData == 0)
        {
            inst.base.replaceAllUses(a);
            inst.erase();
            return true;
        }

        // lshr(shl(x, n), n) -> zext(x) when output width > input width
        if (inst.opcode == wallvm::irOps::IrOpcode::Lshr && bConst &&
            a.kind == wallvm::ir_types::IrValueKind::Inst)
        {
            wallvm::ir_types::IrInst* aInst = (wallvm::ir_types::IrInst*)a;
            if (aInst.opcode == wallvm::irOps::IrOpcode::Shl && aInst.nops == 2 &&
                aInst.ops[1].kind == wallvm::ir_types::IrValueKind::ConstInt &&
                aInst.ops[1].valData == b.valData)
            {
                u32 outW = inst.base.type ? inst.base.type.width : 64;
                u32 inW = aInst.ops[0].type ? aInst.ops[0].type.width : 64;
                if (outW > inW)
                {
                    wallvm::ir_types::IrValue* ops[1] = { aInst.ops[0] };
                    wallvm::ir_types::IrInst* ni = self.ctx.createInst(wallvm::irOps::IrOpcode::Zext, inst.base.type, ops, 1, 0, 0);
                    ops[0].addUser(ni);
                    inst.parent.insertBefore(ni, inst);
                    inst.base.replaceAllUses(&ni.base);
                    inst.erase();
                    return true;
                }
            }
        }

        // ashr(shl(x, n), n) -> sext(x) when output width > input width
        if (inst.opcode == wallvm::irOps::IrOpcode::Ashr && bConst &&
            a.kind == wallvm::ir_types::IrValueKind::Inst)
        {
            wallvm::ir_types::IrInst* aInst = (wallvm::ir_types::IrInst*)a;
            if (aInst.opcode == wallvm::irOps::IrOpcode::Shl && aInst.nops == 2 &&
                aInst.ops[1].kind == wallvm::ir_types::IrValueKind::ConstInt &&
                aInst.ops[1].valData == b.valData)
            {
                u32 outW = inst.base.type ? inst.base.type.width : 64;
                u32 inW = aInst.ops[0].type ? aInst.ops[0].type.width : 64;
                if (outW > inW)
                {
                    wallvm::ir_types::IrValue* ops[1] = { aInst.ops[0] };
                    wallvm::ir_types::IrInst* ni = self.ctx.createInst(wallvm::irOps::IrOpcode::Sext, inst.base.type, ops, 1, 0, 0);
                    ops[0].addUser(ni);
                    inst.parent.insertBefore(ni, inst);
                    inst.base.replaceAllUses(&ni.base);
                    inst.erase();
                    return true;
                }
            }
        }

        // x * 0 = 0 (also commutative 0 * x = 0)
        if (inst.opcode == wallvm::irOps::IrOpcode::Mul && aConst && a.valData == 0)
        {
            wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
            inst.base.replaceAllUses(zero);
            inst.erase();
            return true;
        }

        // x & x = x
        if (inst.opcode == wallvm::irOps::IrOpcode::And && a == b)
        {
            inst.base.replaceAllUses(a);
            inst.erase();
            return true;
        }

        // x | x = x
        if (inst.opcode == wallvm::irOps::IrOpcode::Or && a == b)
        {
            inst.base.replaceAllUses(a);
            inst.erase();
            return true;
        }

        // smin(x, x) = x, smax(x, x) = x, umin(x, x) = x, umax(x, x) = x
        if ((inst.opcode == wallvm::irOps::IrOpcode::SMin ||
             inst.opcode == wallvm::irOps::IrOpcode::SMax ||
             inst.opcode == wallvm::irOps::IrOpcode::UMin ||
             inst.opcode == wallvm::irOps::IrOpcode::UMax) && a == b)
        {
            inst.base.replaceAllUses(a);
            inst.erase();
            return true;
        }

        // x * 2 = x << 1 (strength reduction)
        if (inst.opcode == wallvm::irOps::IrOpcode::Mul && bConst && b.valData == 2)
        {
            wallvm::ir_types::IrValue* shiftVal = self.ctx.constInt(b.type, 1);
            wallvm::ir_types::IrValue* shiftOps[2] = { a, shiftVal };
            wallvm::ir_types::IrInst* shl = self.ctx.createInst(wallvm::irOps::IrOpcode::Shl, inst.base.type, shiftOps, 2, 0, 0);
            shiftOps[0].addUser(shl);
            shiftOps[1].addUser(shl);
            inst.parent.insertBefore(shl, inst);
            inst.base.replaceAllUses(&shl.base);
            inst.erase();
            return true;
        }

        // x * 2^n = x << n (strength reduction)
        if (inst.opcode == wallvm::irOps::IrOpcode::Mul && bConst && b.valData > 0 && b.valData < 64)
        {
            // Check if b is a power of 2
            if ((b.valData & (b.valData - 1)) == 0)
            {
                u32 shiftAmt = 0;
                u64 v = b.valData;
                while (v > 1) { v >>= 1; shiftAmt++; }
                wallvm::ir_types::IrValue* shiftVal = self.ctx.constInt(b.type, shiftAmt);
                wallvm::ir_types::IrValue* shiftOps[2] = { a, shiftVal };
                wallvm::ir_types::IrInst* shl = self.ctx.createInst(wallvm::irOps::IrOpcode::Shl, inst.base.type, shiftOps, 2, 0, 0);
                shiftOps[0].addUser(shl);
                shiftOps[1].addUser(shl);
                inst.parent.insertBefore(shl, inst);
                inst.base.replaceAllUses(&shl.base);
                inst.erase();
                return true;
            }
        }

        // x / 1 = x
        if ((inst.opcode == wallvm::irOps::IrOpcode::SDiv || inst.opcode == wallvm::irOps::IrOpcode::UDiv)
            && bConst && b.valData == 1)
        {
            inst.base.replaceAllUses(a);
            inst.erase();
            return true;
        }

        // x / 2 = x >> 1 (unsigned, strength reduction)
        if (inst.opcode == wallvm::irOps::IrOpcode::UDiv && bConst && b.valData == 2)
        {
            wallvm::ir_types::IrValue* shiftVal = self.ctx.constInt(b.type, 1);
            wallvm::ir_types::IrValue* shiftOps[2] = { a, shiftVal };
            wallvm::ir_types::IrInst* lshr = self.ctx.createInst(wallvm::irOps::IrOpcode::Lshr, inst.base.type, shiftOps, 2, 0, 0);
            shiftOps[0].addUser(lshr);
            shiftOps[1].addUser(lshr);
            inst.parent.insertBefore(lshr, inst);
            inst.base.replaceAllUses(&lshr.base);
            inst.erase();
            return true;
        }

        // x % 1 = 0
        if ((inst.opcode == wallvm::irOps::IrOpcode::SRem || inst.opcode == wallvm::irOps::IrOpcode::URem)
            && bConst && b.valData == 1)
        {
            wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
            inst.base.replaceAllUses(zero);
            inst.erase();
            return true;
        }

        return false;
    }
}

pub bool irPassSimplify(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;
    AlgebraicSimplifyPass pass = AlgebraicSimplifyPass::new(ctx);
    return pass.run(func);
}