mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Macro-Fusion Prep pass: rearranges compare/test instructions to be directly
// adjacent to their dependent conditional branches, enabling hardware macro-fusion
// on x86 (cmp+jcc) and ARM (cbz/cbnz) decoders.

struct MacroFusionPass
{
    wallvm::ir_types::IrContext* ctx;
    u64 fusions;

    MacroFusionPass new(wallvm::ir_types::IrContext* ctx)
    {
        MacroFusionPass p;
        p.ctx = ctx;
        p.fusions = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.fusions = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            if (bb.ninsts < 2) continue;

            // Find ICmp/FCmp not at the end of the block
            // Find CondBr that uses it
            // Move the compare immediately before the branch
            for (u32 ii = 0; ii + 1 < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* cmp = bb.insts[ii];
                if (cmp.opcode != wallvm::irOps::IrOpcode::ICmp &&
                    cmp.opcode != wallvm::irOps::IrOpcode::FCmp)
                    continue;

                // Check if any later instruction in this block uses the compare result
                for (u32 jj = ii + 1; jj < bb.ninsts; jj++)
                {
                    wallvm::ir_types::IrInst* later = bb.insts[jj];

                    // If we hit a terminator before finding a use, stop
                    if (wallvm::irOps::irOpcodeIsTerminator(later.opcode))
                    {
                        // Check if this terminator uses the compare
                        bool usesCmp = false;
                        for (u32 oi = 0; oi < later.nops; oi++)
                        {
                            if (later.ops[oi] == &cmp.base)
                            {
                                usesCmp = true;
                                break;
                            }
                        }

                        if (usesCmp && jj != ii + 1)
                        {
                            // Move cmp from position ii to position jj-1
                            // Remove cmp from ii, insert before jj
                            self.moveInstBefore(bb, ii, jj - 1);
                            self.fusions++;
                            changed = true;
                        }
                        break;
                    }

                    // If the later instruction defines a value the compare uses,
                    // or is itself a compare, stop to avoid breaking dependencies
                    if (later.opcode == wallvm::irOps::IrOpcode::ICmp ||
                        later.opcode == wallvm::irOps::IrOpcode::FCmp)
                        break;

                    // Check if later instruction writes to an operand of cmp
                    bool writesToCmpOperand = false;
                    for (u32 oi = 0; oi < cmp.nops; oi++)
                    {
                        for (u32 di = 0; di < later.nops; di++)
                        {
                            if (cmp.ops[oi] == &later.base)
                            {
                                writesToCmpOperand = true;
                                break;
                            }
                        }
                        if (writesToCmpOperand) break;
                    }
                    if (writesToCmpOperand) break;

                    // Check if later instruction writes to the same dest as cmp
                    if (later.base.id == cmp.base.id) break;

                    // Check if later instruction uses a value defined by cmp
                    bool laterUsesCmp = false;
                    for (u32 oi = 0; oi < later.nops; oi++)
                    {
                        if (later.ops[oi] == &cmp.base)
                        {
                            laterUsesCmp = true;
                            break;
                        }
                    }
                    if (laterUsesCmp) break;
                }
            }
        }

        return changed;
    }

    void moveInstBefore(wallvm::ir_types::IrBlock* bb, u32 fromIdx, u32 toIdx)
    {
        if (fromIdx >= bb.ninsts || toIdx >= bb.ninsts) return;
        if (fromIdx == toIdx) return;
        if (fromIdx > toIdx)
        {
            // Move forward: remove at fromIdx, insert at toIdx
            wallvm::ir_types::IrInst* inst = bb.insts[fromIdx];
            // Shift elements from toIdx..fromIdx-1 up by one
            for (u32 i = fromIdx; i > toIdx; i--)
                bb.insts[i] = bb.insts[i - 1];
            bb.insts[toIdx] = inst;
        }
        else
        {
            // Move backward: remove at fromIdx, insert at toIdx
            wallvm::ir_types::IrInst* inst = bb.insts[fromIdx];
            for (u32 i = fromIdx; i < toIdx; i++)
                bb.insts[i] = bb.insts[i + 1];
            bb.insts[toIdx] = inst;
        }
    }
}

pub bool irPassMacroFusion(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!func || !ctx) return false;

    MacroFusionPass pass = MacroFusionPass.new(ctx);
    return pass.run(func);
}
