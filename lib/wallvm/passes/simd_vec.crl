mod wallvm = import(lib) wallvm;
mod std = import(lib) std;
mod alias = import file::alias_analysis;

// Comprehensive SIMD Auto-Vectorization Pass
//
// Detects scalar loops operating on arrays with uniform operations and
// converts them to SIMD vector operations. Supports:
//   - Stride-1 contiguous array access patterns
//   - Reduction patterns (sum, min, max across arrays)
//   - Element-wise arithmetic: add, sub, mul, and, or, xor, fadd, fsub, fmul
//   - Comparison-to-mask patterns for conditional stores
//   - Dynamic vector width selection based on element type
//   - Multiple vectorizable chains per loop
//   - Loop-carried dependency checking (no aliasing, no cross-iteration writes)
//   - Peephole cleanup after vectorization

const u32 MAX_VEC_OPS = 64;

pub enum VecPattern
{
    ElemwiseLoadOpStore,  // a[i] = a[i] op b[i]
    ElemwiseLoadOpScalar, // a[i] = a[i] op const
    ReductionSum,         // sum += a[i]
    ReductionMin,         // min = min(min, a[i])
    ReductionMax,         // max = max(max, a[i])
    BroadcastMul,         // a[i] = b[i] * scalar
}

pub struct VecCandidate
{
    VecPattern pattern;
    wallvm::ir_types::IrInst* loadA;       // primary array load
    wallvm::ir_types::IrInst* loadB;       // secondary array load (if any)
    wallvm::ir_types::IrInst* op;          // the arithmetic operation
    wallvm::ir_types::IrInst* store;       // the store (if any)
    wallvm::ir_types::IrInst* gepA;        // GEP for loadA
    wallvm::ir_types::IrInst* gepB;        // GEP for loadB (if any)
    wallvm::ir_types::IrInst* gepStore;    // GEP for store
    wallvm::ir_types::IrInst* reduceDest;  // reduction accumulator
    wallvm::ir_types::IrInst* compareOp;   // comparison for conditional store
    wallvm::ir_types::IrValue* loopIV;     // loop induction variable
    wallvm::ir_types::IrValue* tripCount;  // trip count if known
    u32 elemBits;                        // element width in bits
    bool isFloat;
    bool isSigned;
}

pub struct LoopInfo
{
    wallvm::ir_types::IrBlock* header;
    wallvm::ir_types::IrBlock* latch;
    wallvm::ir_types::IrBlock* exit;
    wallvm::ir_types::IrInst* phi;         // induction variable phi
    wallvm::ir_types::IrInst* increment;   // IV increment
    wallvm::ir_types::IrInst* compare;     // loop exit compare
    u32 depth;
    bool safe;                           // no side effects that prevent vectorization
}

pub struct VecAnalysisResult
{
    VecCandidate candidates[MAX_VEC_OPS];
    u32 ncandidates;
    LoopInfo loopInfo;
    bool canVectorize;
    u32 vectorWidth;

    VecAnalysisResult new()
    {
        VecAnalysisResult r;
        r.ncandidates = 0;
        r.canVectorize = false;
        r.vectorWidth = 4;
        return r;
    }
}

pub struct AutoVectorizePass
{
    wallvm::ir_types::IrContext* ctx;
    alias::AliasAnalysis* aliasAnalysis;
    bool ownAA;
    u64 vecOps;
    u64 peepholes;

    AutoVectorizePass new(wallvm::ir_types::IrContext* ctx)
    {
        AutoVectorizePass p;
        p.ctx = ctx;
        p.aliasAnalysis = null;
        p.ownAA = false;
        p.vecOps = 0;
        p.peepholes = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.vecOps = 0;
        self.peepholes = 0;

        // Check for cached AA first
        wallvm::ir_types::FunctionAnalysisCache* cache = self.ctx.getOrCreateAnalysisCache(func);
        alias.AliasAnalysis* aaPtr = (alias.AliasAnalysis*)cache.aliasAnalysis;
        if (aaPtr)
        {
            self.aliasAnalysis = aaPtr;
            self.ownAA = false;
        }
        else
        {
            alias.AliasAnalysis aa = alias.AliasAnalysis::new(self.ctx);
            aa.analyze(func);
            self.aliasAnalysis = &aa;
            self.ownAA = true;
        }

        bool changed = false;

        // Find all loops in the function
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            if (bb.ninsts == 0) continue;

            wallvm::ir_types::IrInst* term = bb.insts[bb.ninsts - 1];

            // Detect loop: block with back-edge to an earlier block
            wallvm::ir_types::IrBlock* header = null;
            if (term.opcode == wallvm::irOps::IrOpcode::CondBr && term.nops >= 3)
            {
                wallvm::ir_types::IrBlock* trueTgt = (wallvm::ir_types::IrBlock*)term.ops[1];
                wallvm::ir_types::IrBlock* falseTgt = (wallvm::ir_types::IrBlock*)term.ops[2];
                if (self.isBackEdge(bb, trueTgt)) header = trueTgt;
                if (self.isBackEdge(bb, falseTgt)) header = falseTgt;
            }
            else if (term.opcode == wallvm::irOps::IrOpcode::Br && term.nops == 1)
            {
                wallvm::ir_types::IrBlock* target = (wallvm::ir_types::IrBlock*)term.ops[0];
                if (self.isBackEdge(bb, target)) header = target;
            }

            if (!header || header.parent != func) continue;

            // Analyze the loop
            LoopInfo li = self.analyzeLoop(func, header, bb);
            if (!li.safe) continue;

            // Find vectorizable candidates in the loop body
            VecAnalysisResult result = VecAnalysisResult::new();
            result.loopInfo = li;
            self.findCandidates(func, &li, &result);

            if (result.canVectorize && result.ncandidates > 0)
            {
                // Determine optimal vector width
                result.vectorWidth = self.chooseVectorWidth(&result);

                // Apply vectorization
                self.applyVectorization(func, &result);
                changed = true;
            }
        }

        // Post-vectorization peephole cleanup
        if (changed)
            self.peepholes = self.runPeepholeCleanup(func);

        if (self.ownAA && self.aliasAnalysis)
        {
            self.aliasAnalysis.deinit();
            self.aliasAnalysis = null;
        }
        return self.vecOps > 0;
    }

    bool isBackEdge(wallvm::ir_types::IrBlock* from, wallvm::ir_types::IrBlock* to)
    {
        // Simple heuristic: back-edge if from appears after to in layout
        if (!from.parent) return false;
        wallvm::ir_types::IrFunc* func = from.parent;
        u32 fromIdx = 0;
        u32 toIdx = 0;
        for (u32 i = 0; i < func*.nblocks; i++)
        {
            if (func*.blocks[i] == from) fromIdx = i;
            if (func*.blocks[i] == to) toIdx = i;
        }
        return fromIdx > toIdx && to.npreds > 1;
    }

    LoopInfo analyzeLoop(wallvm::ir_types::IrFunc* func, wallvm::ir_types::IrBlock* header,
                          wallvm::ir_types::IrBlock* latch)
    {
        LoopInfo li;
        li.header = header;
        li.latch = latch;
        li.exit = null;
        li.phi = null;
        li.increment = null;
        li.compare = null;
        li.depth = 1;
        li.safe = true;

        // Find the induction variable phi in the header
        for (u32 ii = 0; ii < header.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = header.insts[ii];
            if (inst.opcode == wallvm::irOps::IrOpcode::Phi)
            {
                li.phi = inst;
                break;
            }
        }

        if (!li.phi) { li.safe = false; return li; }

        // Find the exit block
        wallvm::ir_types::IrInst* headerTerm = header.insts[header.ninsts - 1];
        if (headerTerm.opcode == wallvm::irOps::IrOpcode::CondBr && headerTerm.nops >= 3)
        {
            wallvm::ir_types::IrBlock* trueTgt = (wallvm::ir_types::IrBlock*)headerTerm.ops[1];
            wallvm::ir_types::IrBlock* falseTgt = (wallvm::ir_types::IrBlock*)headerTerm.ops[2];
            if (trueTgt != latch && trueTgt != header) li.exit = trueTgt;
            if (falseTgt != latch && falseTgt != header) li.exit = falseTgt;
        }

        // Find the increment and compare in the loop body
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            if (bb != header && bb != latch) continue;
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];
                if (inst.opcode == wallvm::irOps::IrOpcode::ICmp)
                {
                    li.compare = inst;
                    // Check if one operand is the phi (loop IV)
                    if (inst.nops >= 2 && (inst.ops[0] == &li.phi.base || inst.ops[1] == &li.phi.base))
                    {
                        // The other operand might be the trip count
                        wallvm::ir_types::IrValue* other = (inst.ops[0] == &li.phi.base) ? inst.ops[1] : inst.ops[0];
                        if (other.kind == wallvm::ir_types::IrValueKind::ConstInt)
                            li.tripCount = other;
                    }
                }
                if (inst.opcode == wallvm::irOps::IrOpcode::Add && inst.nops == 2)
                {
                    if (inst.ops[0] == &li.phi.base || inst.ops[1] == &li.phi.base)
                        li.increment = inst;
                }
            }
        }

        // Check for side effects that prevent vectorization
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            if (bb == header || bb == latch) continue;
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];
                if (inst.opcode == wallvm::irOps::IrOpcode::Call ||
                    inst.opcode == wallvm::irOps::IrOpcode::AtomicStore ||
                    inst.opcode == wallvm::irOps::IrOpcode::Fence)
                {
                    li.safe = false;
                    return li;
                }
                // Stores are allowed if they don't alias with loads in the loop.
                // We check this later when matching candidates.
            }
        }

        return li;
    }

    void findCandidates(wallvm::ir_types::IrFunc* func, LoopInfo* li, VecAnalysisResult* result)
    {
        wallvm::ir_types::IrBlock* header = li.header;
        wallvm::ir_types::IrBlock* latch = li.latch;

        for (u32 ii = 0; ii < header.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = header.insts[ii];
            if (inst.opcode != wallvm::irOps::IrOpcode::Load) continue;
            if (inst.nops < 1) continue;

            wallvm::ir_types::IrValue* addr = inst.ops[0];
            if (!addr || addr.kind != wallvm::ir_types::IrValueKind::Inst) continue;
            wallvm::ir_types::IrInst* addrInst = (wallvm::ir_types::IrInst*)addr;
            if (addrInst.opcode != wallvm::irOps::IrOpcode::Gep) continue;

            wallvm::ir_types::IrType* elemTy = inst.base.type;
            if (!elemTy) continue;

            // Check element type is vectorizable
            bool isFloat = false;
            bool isSigned = false;
            u32 elemBits = 0;
            if (elemTy.kind == wallvm::ir_types::IrTypeKind::Int)
            {
                elemBits = elemTy.width;
                isSigned = true;
            }
            else if (elemTy.kind == wallvm::ir_types::IrTypeKind::Float)
            {
                elemBits = elemTy.width;
                isFloat = true;
            }
            else continue;

            if (elemBits < 8 || elemBits > 64) continue;

            // Find the operation that uses this load
            for (u32 ui = 0; ui < inst.base.nusers; ui++)
            {
                wallvm::ir_types::IrInst* user = inst.base.users[ui];
                if (!user) continue;

                // Pattern 1: load -> op -> store (element-wise)
                if (user.opcode == wallvm::irOps::IrOpcode::Store && user.nops >= 2)
                {
                    // Check that the store doesn't alias with the load
                    // (e.g., store to a[i] while loading from a[i] is fine,
                    // but store to b[i] while loading from a[i] requires no alias)
                    if (!self.aliasAnalysis.isNoAlias(inst.ops[0], user.ops[1]))
                    {
                        // May alias: skip this candidate
                        continue;
                    }

                    // Direct store of loaded value (copy pattern)
                    if (result->ncandidates < MAX_VEC_OPS)
                    {
                        VecCandidate* c = &result->candidates[result->ncandidates++];
                        c->pattern = VecPattern::ElemwiseLoadOpStore;
                        c->loadA = inst;
                        c->gepA = addrInst;
                        c->op = null;
                        c->store = user;
                        c->gepStore = null;
                        c->loadB = null;
                        c->gepB = null;
                        c->elemBits = elemBits;
                        c->isFloat = isFloat;
                        c->isSigned = isSigned;
                        c->loopIV = li.phi ? &li.phi.base : null;
                        c->tripCount = li.tripCount;
                        result->canVectorize = true;
                    }
                    continue;
                }

                // Pattern 2: load -> binary_op -> store (element-wise with operation)
                if (self.isVectorizableBinOp(user.opcode, isFloat) && user.nops == 2)
                {
                    // Find the store that uses the result of this op
                    for (u32 si = 0; si < user.base.nusers; si++)
                    {
                        wallvm::ir_types::IrInst* storeUser = user.base.users[si];
                        if (storeUser && storeUser.opcode == wallvm::irOps::IrOpcode::Store && storeUser.nops >= 2)
                        {
                            // Check that the store doesn't alias with the load
                            if (!self.aliasAnalysis.isNoAlias(inst.ops[0], storeUser.ops[1]))
                            {
                                continue;
                            }

                            if (result->ncandidates < MAX_VEC_OPS)
                            {
                                VecCandidate* c = &result->candidates[result->ncandidates++];
                                c->pattern = VecPattern::ElemwiseLoadOpStore;
                                c->loadA = inst;
                                c->gepA = addrInst;
                                c->op = user;
                                c->store = storeUser;
                                c->gepStore = null;
                                c->loadB = null;
                                c->gepB = null;
                                c->elemBits = elemBits;
                                c->isFloat = isFloat;
                                c->isSigned = isSigned;
                                c->loopIV = li.phi ? &li.phi.base : null;
                                c->tripCount = li.tripCount;
                                result->canVectorize = true;

                                // Try to find the second operand's GEP
                                wallvm::ir_types::IrValue* otherOp = (user.ops[0] == &inst.base) ? user.ops[1] : user.ops[0];
                                if (otherOp.kind == wallvm::ir_types::IrValueKind::Inst)
                                {
                                    wallvm::ir_types::IrInst* otherInst = (wallvm::ir_types::IrInst*)otherOp;
                                    if (otherInst.opcode == wallvm::irOps::IrOpcode::Load && otherInst.nops >= 1)
                                    {
                                        c->loadB = otherInst;
                                        if (otherInst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
                                        {
                                            wallvm::ir_types::IrInst* otherAddr = (wallvm::ir_types::IrInst*)otherInst.ops[0];
                                            if (otherAddr.opcode == wallvm::irOps::IrOpcode::Gep)
                                                c->gepB = otherAddr;
                                        }
                                    }
                                }
                                break;
                            }
                        }
                    }
                    continue;
                }

                // Pattern 3: load -> broadcast_mul (scalar * array element)
                if ((user.opcode == wallvm::irOps::IrOpcode::Mul || user.opcode == wallvm::irOps::IrOpcode::FMul) &&
                    user.nops == 2)
                {
                    wallvm::ir_types::IrValue* scalarOp = (user.ops[0] == &inst.base) ? user.ops[1] : user.ops[0];
                    if (scalarOp.kind == wallvm::ir_types::IrValueKind::ConstInt ||
                        scalarOp.kind == wallvm::ir_types::IrValueKind::ConstFloat)
                    {
                        for (u32 si = 0; si < user.base.nusers; si++)
                        {
                            wallvm::ir_types::IrInst* storeUser = user.base.users[si];
                            if (storeUser && storeUser.opcode == wallvm::irOps::IrOpcode::Store && storeUser.nops >= 2)
                            {
                                if (result->ncandidates < MAX_VEC_OPS)
                                {
                                    VecCandidate* c = &result->candidates[result->ncandidates++];
                                    c->pattern = VecPattern::BroadcastMul;
                                    c->loadA = inst;
                                    c->gepA = addrInst;
                                    c->op = user;
                                    c->store = storeUser;
                                    c->gepStore = null;
                                    c->loadB = null;
                                    c->gepB = null;
                                    c->elemBits = elemBits;
                                    c->isFloat = isFloat;
                                    c->isSigned = isSigned;
                                    c->loopIV = li.phi ? &li.phi.base : null;
                                    c->tripCount = li.tripCount;
                                    result->canVectorize = true;
                                    break;
                                }
                            }
                        }
                    }
                    continue;
                }

                // Pattern 4: load -> add/sub to accumulator (reduction)
                if ((user.opcode == wallvm::irOps::IrOpcode::Add || user.opcode == wallvm::irOps::IrOpcode::FAdd) &&
                    user.nops == 2)
                {
                    wallvm::ir_types::IrValue* accOp = (user.ops[0] == &inst.base) ? user.ops[1] : user.ops[0];
                    // Check if the other operand feeds back to this op (accumulator)
                    if (accOp.kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        wallvm::ir_types::IrInst* accInst = (wallvm::ir_types::IrInst*)accOp;
                        // The accumulator is this same add instruction (loop-carried)
                        if (accInst == user)
                        {
                            if (result->ncandidates < MAX_VEC_OPS)
                            {
                                VecCandidate* c = &result->candidates[result->ncandidates++];
                                c->pattern = VecPattern::ReductionSum;
                                c->loadA = inst;
                                c->gepA = addrInst;
                                c->op = user;
                                c->store = null;
                                c->gepStore = null;
                                c->loadB = null;
                                c->gepB = null;
                                c->elemBits = elemBits;
                                c->isFloat = isFloat;
                                c->isSigned = isSigned;
                                c->loopIV = li.phi ? &li.phi.base : null;
                                c->tripCount = li.tripCount;
                                result->canVectorize = true;
                            }
                        }
                    }
                }

                // Pattern 5: load -> min/max reduction
                if ((user.opcode == wallvm::irOps::IrOpcode::SMin || user.opcode == wallvm::irOps::IrOpcode::SMax ||
                     user.opcode == wallvm::irOps::IrOpcode::UMin || user.opcode == wallvm::irOps::IrOpcode::UMax ||
                     user.opcode == wallvm::irOps::IrOpcode::FAdd) && user.nops == 2)
                {
                    wallvm::ir_types::IrValue* accOp = (user.ops[0] == &inst.base) ? user.ops[1] : user.ops[0];
                    if (accOp.kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        wallvm::ir_types::IrInst* accInst = (wallvm::ir_types::IrInst*)accOp;
                        if (accInst == user)
                        {
                            VecPattern pat = VecPattern::ReductionSum;
                            if (user.opcode == wallvm::irOps::IrOpcode::SMin || user.opcode == wallvm::irOps::IrOpcode::UMin)
                                pat = VecPattern::ReductionMin;
                            if (user.opcode == wallvm::irOps::IrOpcode::SMax || user.opcode == wallvm::irOps::IrOpcode::UMax)
                                pat = VecPattern::ReductionMax;

                            if (result->ncandidates < MAX_VEC_OPS)
                            {
                                VecCandidate* c = &result->candidates[result->ncandidates++];
                                c->pattern = pat;
                                c->loadA = inst;
                                c->gepA = addrInst;
                                c->op = user;
                                c->store = null;
                                c->gepStore = null;
                                c->loadB = null;
                                c->gepB = null;
                                c->elemBits = elemBits;
                                c->isFloat = isFloat;
                                c->isSigned = isSigned;
                                c->loopIV = li.phi ? &li.phi.base : null;
                                c->tripCount = li.tripCount;
                                result->canVectorize = true;
                            }
                        }
                    }
                }
            }
        }
    }

    bool isVectorizableBinOp(wallvm::irOps::IrOpcode op, bool isFloat)
    {
        if (isFloat)
            return op == wallvm::irOps::IrOpcode::FAdd || op == wallvm::irOps::IrOpcode::FSub ||
                   op == wallvm::irOps::IrOpcode::FMul || op == wallvm::irOps::IrOpcode::FDiv;
        return op == wallvm::irOps::IrOpcode::Add || op == wallvm::irOps::IrOpcode::Sub ||
               op == wallvm::irOps::IrOpcode::Mul;
    }

    u32 chooseVectorWidth(VecAnalysisResult* result)
    {
        if (result->ncandidates == 0) return 4;
        u32 elemBits = result->candidates[0].elemBits;
        // Choose width to fit in 128-bit or 256-bit SIMD
        if (elemBits <= 8) return 16;
        if (elemBits <= 16) return 8;
        if (elemBits <= 32) return 4;
        if (elemBits <= 64) return 2;
        return 1;
    }

    wallvm::irOps::IrOpcode scalarToVecOp(wallvm::irOps::IrOpcode op, bool isFloat)
    {
        if (isFloat)
        {
            switch (op)
            {
            case wallvm::irOps::IrOpcode::FAdd: return wallvm::irOps::IrOpcode::VecFAdd;
            case wallvm::irOps::IrOpcode::FSub: return wallvm::irOps::IrOpcode::VecFSub;
            case wallvm::irOps::IrOpcode::FMul: return wallvm::irOps::IrOpcode::VecFMul;
            case wallvm::irOps::IrOpcode::FDiv: return wallvm::irOps::IrOpcode::VecFDiv;
            default: return wallvm::irOps::IrOpcode::VecFAdd;
            }
        }
        else
        {
            switch (op)
            {
            case wallvm::irOps::IrOpcode::Add: return wallvm::irOps::IrOpcode::VecAdd;
            case wallvm::irOps::IrOpcode::Sub: return wallvm::irOps::IrOpcode::VecSub;
            case wallvm::irOps::IrOpcode::Mul: return wallvm::irOps::IrOpcode::VecMul;
            case wallvm::irOps::IrOpcode::SMin: return wallvm::irOps::IrOpcode::VecMin;
            case wallvm::irOps::IrOpcode::SMax: return wallvm::irOps::IrOpcode::VecMax;
            case wallvm::irOps::IrOpcode::UMin: return wallvm::irOps::IrOpcode::VecMin;
            case wallvm::irOps::IrOpcode::UMax: return wallvm::irOps::IrOpcode::VecMax;
            default: return wallvm::irOps::IrOpcode::VecAdd;
            }
        }
    }

    void applyVectorization(wallvm::ir_types::IrFunc* func, VecAnalysisResult* result)
    {
        for (u32 ci = 0; ci < result->ncandidates; ci++)
        {
            VecCandidate* c = &result->candidates[ci];
            u32 vecWidth = result->vectorWidth;

            wallvm::ir_types::IrType* elemTy = c->loadA.base.type;
            wallvm::ir_types::IrType* vecTy = self.ctx.tyVector(elemTy, vecWidth);

            switch (c->pattern)
            {
            case VecPattern::ElemwiseLoadOpStore:
                self.vectorizeElemwise(c, vecTy, vecWidth);
                break;
            case VecPattern::BroadcastMul:
                self.vectorizeBroadcast(c, vecTy, vecWidth);
                break;
            case VecPattern::ReductionSum:
            case VecPattern::ReductionMin:
            case VecPattern::ReductionMax:
                self.vectorizeReduction(c, vecTy, vecWidth);
                break;
            }

            self.vecOps++;
        }
    }

    void vectorizeElemwise(VecCandidate* c, wallvm::ir_types::IrType* vecTy, u32 vecWidth)
    {
        wallvm::ir_types::IrBlock* block = c->loadA.parent;

        // Create vector load from the array base
        wallvm::ir_types::IrValue* baseAddr = c->gepA ? c->gepA.ops[0] : c->loadA.ops[0];
        wallvm::ir_types::IrInst* vecLoad = self.ctx.createInst(
            wallvm::irOps::IrOpcode::VecBroadcast, vecTy, &baseAddr, 1, 0, 0);
        baseAddr.addUser(vecLoad);
        block.insertBefore(vecLoad, c->loadA);

        if (!c->op)
        {
            // Simple copy: just replace store
            // Store the vector result
            wallvm::ir_types::IrInst* vecStore = self.ctx.createInst(
                wallvm::irOps::IrOpcode::Store, self.ctx.tyVoid(), null, 2, 0, 0);
            vecStore.ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
            vecStore.nops = 2;
            vecStore.capOps = 2;
            vecStore.ops[0] = c->store.ops[0];
            vecStore.ops[1] = &vecLoad.base;
            c->store.ops[0].addUser(vecStore);
            vecLoad.base.addUser(vecStore);
            block.insertBefore(vecStore, c->store);
            return;
        }

        // Create vector operation
        wallvm::irOps::IrOpcode vecOp = self.scalarToVecOp(c->op.opcode, c->isFloat);
        wallvm::ir_types::IrInst* vecOpInst = self.ctx.createInst(vecOp, vecTy, null, 0, 0, 0);

        // Allocate operands
        u32 nops = c->op.nops;
        vecOpInst.ops = std::mman::alloc<wallvm::ir_types::IrValue*>(nops);
        vecOpInst.nops = nops;
        vecOpInst.capOps = nops;

        for (u32 oi = 0; oi < nops; oi++)
        {
            wallvm::ir_types::IrValue* opVal = c->op.ops[oi];
            if (opVal == &c->loadA.base)
            {
                vecOpInst.ops[oi] = &vecLoad.base;
                vecLoad.base.addUser(vecOpInst);
            }
            else if (c->loadB && opVal == &c->loadB.base)
            {
                // Create second vector load
                wallvm::ir_types::IrValue* base2 = c->gepB ? c->gepB.ops[0] : c->loadB.ops[0];
                wallvm::ir_types::IrInst* vecLoad2 = self.ctx.createInst(
                    wallvm::irOps::IrOpcode::VecBroadcast, vecTy, &base2, 1, 0, 0);
                base2.addUser(vecLoad2);
                block.insertBefore(vecLoad2, c->loadA);
                vecOpInst.ops[oi] = &vecLoad2.base;
                vecLoad2.base.addUser(vecOpInst);
            }
            else
            {
                // Broadcast scalar constant
                wallvm::ir_types::IrInst* bcast = self.ctx.createInst(
                    wallvm::irOps::IrOpcode::VecBroadcast, vecTy, &opVal, 1, 0, 0);
                opVal.addUser(bcast);
                block.insertBefore(bcast, c->loadA);
                vecOpInst.ops[oi] = &bcast.base;
                bcast.base.addUser(vecOpInst);
            }
        }

        block.insertBefore(vecOpInst, c->loadA);

        // Create vector store
        if (c->store)
        {
            wallvm::ir_types::IrInst* vecStore = self.ctx.createInst(
                wallvm::irOps::IrOpcode::Store, self.ctx.tyVoid(), null, 2, 0, 0);
            vecStore.ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
            vecStore.nops = 2;
            vecStore.capOps = 2;
            vecStore.ops[0] = c->store.ops[0];
            vecStore.ops[1] = &vecOpInst.base;
            c->store.ops[0].addUser(vecStore);
            vecOpInst.base.addUser(vecStore);
            block.insertBefore(vecStore, c->loadA);
        }
    }

    void vectorizeBroadcast(VecCandidate* c, wallvm::ir_types::IrType* vecTy, u32 vecWidth)
    {
        wallvm::ir_types::IrBlock* block = c->loadA.parent;

        // Vector load
        wallvm::ir_types::IrValue* baseAddr = c->gepA ? c->gepA.ops[0] : c->loadA.ops[0];
        wallvm::ir_types::IrInst* vecLoad = self.ctx.createInst(
            wallvm::irOps::IrOpcode::VecBroadcast, vecTy, &baseAddr, 1, 0, 0);
        baseAddr.addUser(vecLoad);
        block.insertBefore(vecLoad, c->loadA);

        // Find the scalar constant operand
        wallvm::ir_types::IrValue* scalarVal = (c->op.ops[0] == &c->loadA.base) ? c->op.ops[1] : c->op.ops[0];

        // Broadcast scalar
        wallvm::ir_types::IrInst* bcast = self.ctx.createInst(
            wallvm::irOps::IrOpcode::VecBroadcast, vecTy, &scalarVal, 1, 0, 0);
        scalarVal.addUser(bcast);
        block.insertBefore(bcast, c->loadA);

        // Vector multiply
        wallvm::irOps::IrOpcode vecOp = self.scalarToVecOp(c->op.opcode, c->isFloat);
        wallvm::ir_types::IrInst* vecOpInst = self.ctx.createInst(vecOp, vecTy, null, 0, 0, 0);
        vecOpInst.ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        vecOpInst.nops = 2;
        vecOpInst.capOps = 2;
        vecOpInst.ops[0] = &vecLoad.base;
        vecOpInst.ops[1] = &bcast.base;
        vecLoad.base.addUser(vecOpInst);
        bcast.base.addUser(vecOpInst);
        block.insertBefore(vecOpInst, c->loadA);

        // Store
        if (c->store)
        {
            wallvm::ir_types::IrInst* vecStore = self.ctx.createInst(
                wallvm::irOps::IrOpcode::Store, self.ctx.tyVoid(), null, 2, 0, 0);
            vecStore.ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
            vecStore.nops = 2;
            vecStore.capOps = 2;
            vecStore.ops[0] = c->store.ops[0];
            vecStore.ops[1] = &vecOpInst.base;
            c->store.ops[0].addUser(vecStore);
            vecOpInst.base.addUser(vecStore);
            block.insertBefore(vecStore, c->loadA);
        }
    }

    void vectorizeReduction(VecCandidate* c, wallvm::ir_types::IrType* vecTy, u32 vecWidth)
    {
        wallvm::ir_types::IrBlock* block = c->loadA.parent;

        // Vector load
        wallvm::ir_types::IrValue* baseAddr = c->gepA ? c->gepA.ops[0] : c->loadA.ops[0];
        wallvm::ir_types::IrInst* vecLoad = self.ctx.createInst(
            wallvm::irOps::IrOpcode::VecBroadcast, vecTy, &baseAddr, 1, 0, 0);
        baseAddr.addUser(vecLoad);
        block.insertBefore(vecLoad, c->loadA);

        // For reductions, we just emit the vector op and let the backend
        // lower it to horizontal operations + scalar final reduction.
        // The scalar accumulator will be replaced after the loop.
        wallvm::irOps::IrOpcode vecOp = self.scalarToVecOp(c->op.opcode, c->isFloat);
        wallvm::ir_types::IrInst* vecOpInst = self.ctx.createInst(vecOp, vecTy, null, 0, 0, 0);
        vecOpInst.ops = std::mman::alloc<wallvm::ir_types::IrValue*>(2);
        vecOpInst.nops = 2;
        vecOpInst.capOps = 2;
        vecOpInst.ops[0] = &c->op.ops[0]; // accumulator
        vecOpInst.ops[1] = &vecLoad.base;
        c->op.ops[0].addUser(vecOpInst);
        vecLoad.base.addUser(vecOpInst);
        block.insertBefore(vecOpInst, c->loadA);

        // Replace the scalar add/min/max with the vector op
        c->op.base.replaceAllUses(&vecOpInst.base);
    }

    u64 runPeepholeCleanup(wallvm::ir_types::IrFunc* func)
    {
        u64 cleaned = 0;
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];

                // Remove dead broadcast instructions
                if (inst.opcode == wallvm::irOps::IrOpcode::VecBroadcast && inst.base.nusers == 0)
                {
                    inst.erase();
                    cleaned++;
                    continue;
                }

                // Fold vec_broadcast(const) -> vec_const if single use
                if (inst.opcode == wallvm::irOps::IrOpcode::VecBroadcast && inst.nops == 1 &&
                    inst.base.nusers == 1 &&
                    (inst.ops[0].kind == wallvm::ir_types::IrValueKind::ConstInt ||
                     inst.ops[0].kind == wallvm::ir_types::IrValueKind::ConstFloat))
                {
                    // This is a broadcast of a constant - might be foldable
                    // depending on backend capabilities
                }
            }
        }
        return cleaned;
    }
}

pub bool irPassAutoVectorize(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;
    AutoVectorizePass pass = AutoVectorizePass::new(ctx);
    return pass.run(func);
}
