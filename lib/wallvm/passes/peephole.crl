mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// Peephole optimizer: local pattern-matching rewrites on adjacent instructions.
// Runs after the main optimization pipeline and before register allocation to
// catch patterns exposed by earlier passes.
pub struct PeepholePass
{
    wallvm::ir_types::IrContext* ctx;
    u64 rewrites;

    PeepholePass new(wallvm::ir_types::IrContext* ctx)
    {
        PeepholePass p;
        p.ctx = ctx;
        p.rewrites = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.rewrites = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            bool blockChanged = true;
            while (blockChanged)
            {
                blockChanged = false;
                u32 ii = 0;
                while (ii < bb.ninsts)
                {
                    wallvm::ir_types::IrInst* inst = bb.insts[ii];

                    // Pattern: add x, 0 -> x  (catches post-constfold residual)
                    if (inst.opcode == wallvm::irOps::IrOpcode::Add && inst.nops == 2)
                    {
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 0)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        if (inst.ops[0].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[0].valData == 0)
                        {
                            inst.base.replaceAllUses(inst.ops[1]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: x + x -> x << 1 (strength reduction)
                    if (inst.opcode == wallvm::irOps::IrOpcode::Add && inst.nops == 2 &&
                        inst.ops[0] == inst.ops[1])
                    {
                        wallvm::ir_types::IrValue* shiftVal = self.ctx.constInt(inst.base.type, 1);
                        wallvm::ir_types::IrValue* shiftOps[2] = { inst.ops[0], shiftVal };
                        wallvm::ir_types::IrInst* shl =
                            self.ctx.createInst(wallvm::irOps::IrOpcode::Shl, inst.base.type, shiftOps, 2, 0, 0);
                        shiftOps[0].addUser(shl);
                        shiftOps[1].addUser(shl);
                        inst.parent.insertBefore(shl, inst);
                        inst.base.replaceAllUses(&shl.base);
                        inst.erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern: sub x, 0 -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::Sub && inst.nops == 2)
                    {
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 0)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: mul x, 1 -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::Mul && inst.nops == 2)
                    {
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 1)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        if (inst.ops[0].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[0].valData == 1)
                        {
                            inst.base.replaceAllUses(inst.ops[1]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: x * -1 -> neg(x) (strength reduction)
                    if (inst.opcode == wallvm::irOps::IrOpcode::Mul && inst.nops == 2)
                    {
                        u32 bits = inst.base.type ? inst.base.type.width : 64;
                        u64 allOnes = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == allOnes)
                        {
                            wallvm::ir_types::IrValue* ops[1] = { inst.ops[0] };
                            wallvm::ir_types::IrInst* neg =
                                self.ctx.createInst(wallvm::irOps::IrOpcode::Neg, inst.base.type, ops, 1, 0, 0);
                            ops[0].addUser(neg);
                            inst.parent.insertBefore(neg, inst);
                            inst.base.replaceAllUses(&neg.base);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        if (inst.ops[0].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[0].valData == allOnes)
                        {
                            wallvm::ir_types::IrValue* ops[1] = { inst.ops[1] };
                            wallvm::ir_types::IrInst* neg =
                                self.ctx.createInst(wallvm::irOps::IrOpcode::Neg, inst.base.type, ops, 1, 0, 0);
                            ops[0].addUser(neg);
                            inst.parent.insertBefore(neg, inst);
                            inst.base.replaceAllUses(&neg.base);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: and x, -1 -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::And && inst.nops == 2)
                    {
                        u32 bits = inst.base.type ? inst.base.type.width : 64;
                        u64 allOnes = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == allOnes)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        // Pattern: and x, 0 -> 0
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 0)
                        {
                            wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
                            inst.base.replaceAllUses(zero);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: or x, 0 -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::Or && inst.nops == 2)
                    {
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 0)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        // Pattern: or x, -1 -> -1
                        u32 bits = inst.base.type ? inst.base.type.width : 64;
                        u64 allOnes = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);
                        if (inst.ops[1].kind ==
                            wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == allOnes)
                        {
                            wallvm::ir_types::IrValue* ones = self.ctx.constInt(inst.base.type, allOnes);
                            inst.base.replaceAllUses(ones);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: shl x, 0 -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::Shl && inst.nops == 2)
                    {
                        if (inst.ops[1].kind
                            == wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 0)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: lshr x, 0 -> x, ashr x, 0 -> x
                    if ((inst.opcode ==
                        wallvm::irOps::IrOpcode::Lshr || inst.opcode ==
                        wallvm::irOps::IrOpcode::Ashr) && inst.nops == 2)
                    {
                        if (inst.ops[1].kind == wallvm::ir_types::IrValueKind::ConstInt && inst.ops[1].valData == 0)
                        {
                            inst.base.replaceAllUses(inst.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: icmp eq x, x -> true (1), icmp ne x, x -> false (0)
                    if (inst.opcode == wallvm::irOps::IrOpcode::ICmp && inst.nops == 2)
                    {
                        if (inst.ops[0] == inst.ops[1])
                        {
                            u64 result = (inst.icmpPred == wallvm::irOps::IrICmpPred::Eq ||
                                          inst.icmpPred == wallvm::irOps::IrICmpPred::Sle ||
                                          inst.icmpPred == wallvm::irOps::IrICmpPred::Ule ||
                                          inst.icmpPred == wallvm::irOps::IrICmpPred::Sge ||
                                          inst.icmpPred == wallvm::irOps::IrICmpPred::Uge) ? 1 : 0;
                            wallvm::ir_types::IrValue* cval = self.ctx.constInt(inst.base.type, result);
                            inst.base.replaceAllUses(cval);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: select(true, x, y) -> x, select(false, x, y) -> y
                    if (inst.opcode == wallvm::irOps::IrOpcode::Select && inst.nops >= 3)
                    {
                        if (inst.ops[0].kind == wallvm::ir_types::IrValueKind::ConstInt)
                        {
                            wallvm::ir_types::IrValue* result = (inst.ops[0].valData != 0) ? inst.ops[1] : inst.ops[2];
                            inst.base.replaceAllUses(result);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        // select(cond, x, x) -> x
                        if (inst.ops[1] == inst.ops[2])
                        {
                            inst.base.replaceAllUses(inst.ops[1]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: neg(neg(x)) -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::Neg && inst.nops == 1 &&
                        inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        wallvm::ir_types::IrInst* inner = (wallvm::ir_types::IrInst*)inst.ops[0];
                        if (inner.opcode == wallvm::irOps::IrOpcode::Neg && inner.nops == 1)
                        {
                            inst.base.replaceAllUses(inner.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: not(not(x)) -> x
                    if (inst.opcode == wallvm::irOps::IrOpcode::Not && inst.nops == 1 &&
                        inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        wallvm::ir_types::IrInst* inner = (wallvm::ir_types::IrInst*)inst.ops[0];
                        if (inner.opcode == wallvm::irOps::IrOpcode::Not && inner.nops == 1)
                        {
                            inst.base.replaceAllUses(inner.ops[0]);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: x ^ x -> 0
                    if (inst.opcode == wallvm::irOps::IrOpcode::Xor && inst.nops == 2 && inst.ops[0] == inst.ops[1])
                    {
                        wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
                        inst.base.replaceAllUses(zero);
                        inst.erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern: x - x -> 0
                    if (inst.opcode == wallvm::irOps::IrOpcode::Sub && inst.nops == 2 && inst.ops[0] == inst.ops[1])
                    {
                        wallvm::ir_types::IrValue* zero = self.ctx.constInt(inst.base.type, 0);
                        inst.base.replaceAllUses(zero);
                        inst.erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern: smin(x, x) -> x, smax(x, x) -> x, umin(x, x) -> x, umax(x, x) -> x
                    if ((inst.opcode == wallvm::irOps::IrOpcode::SMin ||
                         inst.opcode == wallvm::irOps::IrOpcode::SMax ||
                         inst.opcode == wallvm::irOps::IrOpcode::UMin ||
                         inst.opcode == wallvm::irOps::IrOpcode::UMax) &&
                        inst.nops == 2 && inst.ops[0] == inst.ops[1])
                    {
                        inst.base.replaceAllUses(inst.ops[0]);
                        inst.erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern: sext(zext(x)) -> zext(x) if sext width matches
                    if (inst.opcode == wallvm::irOps::IrOpcode::Sext && inst.nops == 1 &&
                        inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        wallvm::ir_types::IrInst* inner = (wallvm::ir_types::IrInst*)inst.ops[0];
                        if (inner.opcode == wallvm::irOps::IrOpcode::Zext && inner.nops == 1)
                        {
                            // The sign bit is 0 from zext, so sext is same as zext
                            wallvm::ir_types::IrValue* ops[1] = { inner.ops[0] };
                            wallvm::ir_types::IrInst* ni =
                                self.ctx.createInst(wallvm::irOps::IrOpcode::Zext, inst.base.type, ops, 1, 0, 0);
                            ops[0].addUser(ni);
                            inst.parent.insertBefore(ni, inst);
                            inst.base.replaceAllUses(&ni.base);
                            inst.erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern: trunc(zext(x)) -> x if widths match
                    if (inst.opcode == wallvm::irOps::IrOpcode::Trunc && inst.nops == 1 &&
                        inst.ops[0].kind == wallvm::ir_types::IrValueKind::Inst)
                    {
                        wallvm::ir_types::IrInst* inner = (wallvm::ir_types::IrInst*)inst.ops[0];
                        if (inner.opcode == wallvm::irOps::IrOpcode::Zext && inner.nops == 1)
                        {
                            u32 outW = inst.base.type ? inst.base.type.width : 64;
                            u32 innerW = inner.ops[0].type ? inner.ops[0].type.width : 64;
                            if (outW == innerW)
                            {
                                inst.base.replaceAllUses(inner.ops[0]);
                                inst.erase();
                                self.rewrites++;
                                blockChanged = true;
                                continue;
                            }
                        }
                    }

                    // Pattern: br to block that only contains br -> redirect
                    if (inst.opcode == wallvm::irOps::IrOpcode::Br && inst.nops == 1 &&
                        inst.ops[0].kind == wallvm::ir_types::IrValueKind::Block)
                    {
                        wallvm::ir_types::IrBlock* target = (wallvm::ir_types::IrBlock*)inst.ops[0];
                        if (target.ninsts == 1)
                        {
                            wallvm::ir_types::IrInst* targetTerm = target.insts[0];
                            if (targetTerm.opcode == wallvm::irOps::IrOpcode::Br && targetTerm.nops == 1)
                            {
                                wallvm::ir_types::IrBlock* finalTarget = (wallvm::ir_types::IrBlock*)targetTerm.ops[0];
                                if (finalTarget != target)
                                {
                                    // Dominance check: skip if target is a PHI predecessor
                                    bool isPhiPred = false;
                                    for (u32 pi = 0; pi < func*.nblocks && !isPhiPred; pi++)
                                    {
                                        wallvm::ir_types::IrBlock* pb = func*.blocks[pi];
                                        for (u32 pj = 0; pj < pb.ninsts && !isPhiPred; pj++)
                                        {
                                            wallvm::ir_types::IrInst* phi = pb.insts[pj];
                                            if (phi.opcode == wallvm::irOps::IrOpcode::Phi)
                                            {
                                                for (u32 pk = 1; pk < phi.nops; pk += 2)
                                                {
                                                    if (phi.ops[pk] == &target.base)
                                                    {
                                                        isPhiPred = true;
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if (!isPhiPred)
                                    {
                                        inst.ops[0].removeUser(inst);
                                        target.removePred(bb);
                                        targetTerm.ops[0].addUser(inst);
                                        inst.ops[0] = &finalTarget.base;
                                        finalTarget.addPred(bb);

                                        // Update PHI nodes in finalTarget to include the new predecessor
                                        for (u32 pi = 0; pi < finalTarget.ninsts; pi++)
                                        {
                                            wallvm::ir_types::IrInst* phi = finalTarget.insts[pi];
                                            if (phi.opcode != wallvm::irOps::IrOpcode::Phi) break;

                                            // Add a default incoming value for the new predecessor
                                            u32 newOpsCount = phi.nops + 2;
                                            wallvm::ir_types::IrValue** newOps = std::mman::alloc<wallvm::ir_types::IrValue*>(newOpsCount);
                                            for (u32 oi = 0; oi < phi.nops; oi++)
                                                newOps[oi] = phi.ops[oi];
                                            newOps[phi.nops] = phi.base.type ? ctx.constInt(phi.base.type, 0) : null;
                                            newOps[phi.nops + 1] = &bb.base;
                                            if (newOps[phi.nops]) newOps[phi.nops].addUser(phi);
                                            bb.base.addUser(phi);
                                            phi.ops = newOps;
                                            phi.nops = newOpsCount;
                                        }

                                        bb.succs[0] = finalTarget;
                                        self.rewrites++;
                                        blockChanged = true;
                                        continue;
                                    }
                                }
                            }
                        }
                    }

                    ii++;
                }
            }
        }

        return self.rewrites > 0;
    }
}

pub bool irPassPeephole(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;
    PeepholePass pass = PeepholePass::new(ctx);
    return pass.run(func);
}
