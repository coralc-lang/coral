mod wallvm = import(lib) wallvm;
mod std = import(lib) std;
mod alias = import file::alias_analysis;

// Dead store elimination enhanced with alias analysis.
//
// Within a single basic block, a store to an address that is overwritten by a
// later store to a must-aliasing address — before any load, call, fence or
// atomic touches it — never contributes to the program state and is removed.
//
// Uses AliasAnalysis to determine when two store addresses definitely alias
// (must-alias), enabling DSE across GEP offsets and bitcasts that the
// original pointer-equality check missed.
//
// Conservative by design: any instruction that can read or write memory
// (call, atomic, fence, inline asm, landing pad) flushes the tracked stores.
pub struct DsePass
{
    wallvm::ir_types::IrContext* ctx;
    alias::AliasAnalysis* aliasAnalysis;
    u64 removed;

    DsePass new(wallvm::ir_types::IrContext* ctx)
    {
        DsePass p;
        p.ctx = ctx;
        p.aliasAnalysis = null;
        p.removed = 0;
        return p;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        self.removed = 0;
        bool changed = false;

        // Check for cached AA first
        wallvm::ir_types::FunctionAnalysisCache* cache = self.ctx.getOrCreateAnalysisCache(func);
        alias::AliasAnalysis* aaPtr = (alias::AliasAnalysis*)cache.aliasAnalysis;
        bool ownAA = false;
        if (aaPtr)
        {
            self.aliasAnalysis = aaPtr;
        }
        else
        {
            alias::AliasAnalysis aa = alias::AliasAnalysis::new(self.ctx);
            aa.analyze(func);
            self.aliasAnalysis = &aa;
            ownAA = true;
        }

        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func.blocks[bi];
            if (self.sweepBlock(bb)) changed = true;
        }

        if (ownAA)
        {
            self.ctx.getOrCreateAnalysisCache(func).aliasAnalysis = self.aliasAnalysis;
        }
        self.aliasAnalysis = null;
        return changed;
    }

    bool isBarrier(wallvm::irOps::IrOpcode op)
    {
        switch (op)
        {
        case wallvm::irOps::IrOpcode::Load:
        case wallvm::irOps::IrOpcode::AtomicLoad:
        case wallvm::irOps::IrOpcode::AtomicStore:
        case wallvm::irOps::IrOpcode::AtomicRmw:
        case wallvm::irOps::IrOpcode::AtomicCmpXchg:
        case wallvm::irOps::IrOpcode::Fence:
        case wallvm::irOps::IrOpcode::Call:
        case wallvm::irOps::IrOpcode::InlineAsm:
        case wallvm::irOps::IrOpcode::GcRoot:
        case wallvm::irOps::IrOpcode::GcWriteBarrier:
        case wallvm::irOps::IrOpcode::GcSafepoint:
        case wallvm::irOps::IrOpcode::LandingPad:
            return true;
        default:
            return false;
        }
    }

    bool sweepBlock(wallvm::ir_types::IrBlock* bb)
    {
        const u32 MAX_TRACKED = 128;
        wallvm::ir_types::IrValue** addrs = std::mman::alloc<wallvm::ir_types::IrValue*>(MAX_TRACKED);
        wallvm::ir_types::IrInst** stores = std::mman::alloc<wallvm::ir_types::IrInst*>(MAX_TRACKED);
        u32 tracked = 0;
        bool changed = false;

        u32 ii = 0;
        while (ii < bb.ninsts)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];

            if (inst.opcode == wallvm::irOps::IrOpcode::Store && inst.nops >= 2)
            {
                wallvm::ir_types::IrValue* addr = inst.ops[1];
                // Use alias analysis to find a pending store that must-aliases
                // this one. Must-alias means the addresses are guaranteed to
                // refer to the same memory location.
                i32 hit = -1;
                for (u32 k = 0; k < tracked; k++)
                {
                    if (self.aliasAnalysis && self.aliasAnalysis.isMustAlias(addr, addrs[k]))
                    {
                        hit = (i32)k;
                        break;
                    }
                    if (addrs[k] == addr)
                    {
                        hit = (i32)k;
                        break;
                    }
                }

                if (hit >= 0)
                {
                    stores[hit].erase();
                    stores[hit] = inst;
                    self.removed++;
                    changed = true;
                    continue;
                }

                if (tracked < MAX_TRACKED)
                {
                    addrs[tracked] = addr;
                    stores[tracked] = inst;
                    tracked++;
                }
            }
            else if (self.isBarrier(inst.opcode))
            {
                tracked = 0;
            }

            ii++;
        }

        std::mman::dealloc<wallvm::ir_types::IrValue*>(addrs);
        std::mman::dealloc<wallvm::ir_types::IrInst*>(stores);
        return changed;
    }

    u64 removedCount()
    {
        return self.removed;
    }
}

pub bool irPassDse(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    if (!ctx || !func) return false;
    DsePass pass = DsePass::new(ctx);
    return pass.run(func);
}
