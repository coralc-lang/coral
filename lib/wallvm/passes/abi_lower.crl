mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// ABI Lowering Pass
// Handles struct arguments and return values according to SystemV AMD64 ABI.
//
// Struct classification rules:
// 1. Each field is classified independently
// 2. INTEGER class: integers, pointers (8 bytes each)
// 3. SSE class: floats (8 bytes each)
// 4. MEMORY class: anything >16 bytes total, or mixed INTEGER+SSE fields
// 5. Packed structs: no alignment padding, fields packed tightly
// 6. Compound structs: nested structs flattened recursively
//
// For MEMORY class structs, they stay in memory via pointer indirection.

pub struct ABILowering
{
    wallvm::ir_types::IrContext* ctx;

    void init(wallvm::ir_types::IrContext* ctx)
    {
        self.ctx = ctx;
    }

    // Classify a single field type
    // Returns: 0 = MEMORY, 1 = INTEGER, 2 = SSE
    u32 classifyField(wallvm::ir_types::IrType* ty)
    {
        if (!ty) return 0;
        switch (ty.kind)
        {
        case wallvm::irTypes::IrTypeKind::Int:
            return 1;  // INTEGER
        case wallvm::irTypes::IrTypeKind::Ptr:
            return 1;  // INTEGER (pointer)
        case wallvm::irTypes::IrTypeKind::Float:
            if (ty.width == 32 || ty.width == 64)
                return 2;  // SSE
            return 0;  // MEMORY for long double etc.
        case wallvm::irTypes::IrTypeKind::Array:
        {
            if (!ty.elem) return 0;
            u32 elemClass = classifyField(ty.elem);
            if (elemClass == 0) return 0;
            u32 totalSize = ty.count * (ty.elem.width / 8);
            if (totalSize > 8) return 0;
            return elemClass;
        }
        case wallvm::irTypes::IrTypeKind::Struct:
            return classifyStructType(ty);
        default:
            return 0;
        }
    }

    // Classify a struct type for ABI purposes
    // Returns: 0 = MEMORY, 1 = INTEGER, 2 = SSE, 3 = MIXED
    u32 classifyStructType(wallvm::ir_types::IrType* ty)
    {
        if (!ty || ty.kind != wallvm::irTypes::IrTypeKind::Struct) return 0;

        u32 sz = ty.width;
        if (sz == 0) return 0;
        if (sz > 16) return 0;  // MEMORY for >16 bytes

        u32 class1 = 0;
        u32 class2 = 0;

        if (sz <= 8)
        {
            class1 = classifyField(ty);
        }
        else
        {
            class1 = classifyField(ty);
            if (class1 == 0) return 0;
            class2 = classifyField(ty);
        }

        if (class1 == 0 || class2 == 0) return 0;
        if (class1 == 3 || class2 == 3) return 0;

        if (class1 != class2) return 3;  // MIXED
        return class1;
    }

    // Count register fields for a struct
    u32 structRegCount(wallvm::ir_types::IrType* ty)
    {
        if (!ty || ty.kind != wallvm::irTypes::IrTypeKind::Struct) return 0;
        u32 sz = ty.width;
        u32 regs = (sz + 7) / 8;
        if (regs > 2) regs = 2;
        return regs;
    }

    // Check if struct fits in integer registers
    bool isIntegerStruct(wallvm::ir_types::IrType* ty)
    {
        u32 cls = classifyStructType(ty);
        return cls == 1;
    }

    // Check if struct fits in SSE registers
    bool isSSEStruct(wallvm::ir_types::IrType* ty)
    {
        u32 cls = classifyStructType(ty);
        return cls == 2;
    }

    // Check if struct must go in memory
    bool isMemoryStruct(wallvm::ir_types::IrType* ty)
    {
        u32 cls = classifyStructType(ty);
        return cls == 0;
    }

    // Check if struct has mixed integer/SSE fields (per-eightbyte classification)
    bool isMixedStruct(wallvm::ir_types::IrType* ty)
    {
        u32 cls = classifyStructType(ty);
        return cls == 3;
    }

    // Get field byte offsets for a struct
    // For packed structs, no alignment padding
    // For normal structs, fields are aligned to their natural alignment
    u32 getFieldOffset(wallvm::ir_types::IrType* ty, u32 fieldIdx, bool isPacked)
    {
        if (!ty) return 0;

        if (ty.kind == wallvm::irTypes::IrTypeKind::Struct)
        {
            u32 off = 0;
            for (u32 i = 0; i < fieldIdx; i++)
            {
                u32 fieldSize = ty.width;  // Simplified
                if (!isPacked)
                {
                    u32 align = 8;
                    off = (off + align - 1) / align * align;
                }
                off += fieldSize;
            }
            return off;
        }

        if (ty.kind == wallvm::irTypes::IrTypeKind::Array && ty.elem)
        {
            u32 elemSize = ty.elem.width / 8;
            if (!isPacked)
            {
                u32 align = elemSize;
                return fieldIdx * ((elemSize + align - 1) / align * align);
            }
            return fieldIdx * elemSize;
        }

        return 0;
    }

    // Flatten compound structs (recursive)
    // Returns the total number of leaf fields
    u32 flattenStruct(wallvm::ir_types::IrType* ty, wallvm::ir_types::IrType** outFields, u32 maxFields)
    {
        if (!ty || maxFields == 0) return 0;

        if (ty.kind == wallvm::irTypes::IrTypeKind::Struct)
        {
            u32 count = 0;
            if (ty.elem && count < maxFields)
            {
                count += flattenStruct(ty.elem, outFields + count, maxFields - count);
            }
            return count;
        }

        if (ty.kind == wallvm::irTypes::IrTypeKind::Array && ty.elem)
        {
            u32 count = 0;
            for (u32 i = 0; i < ty.count && count < maxFields; i++)
            {
                if (ty.elem.kind == wallvm::irTypes::IrTypeKind::Struct)
                    count += flattenStruct(ty.elem, outFields + count, maxFields - count);
                else if (count < maxFields)
                {
                    outFields[count] = ty.elem;
                    count++;
                }
            }
            return count;
        }

        if (outFields)
            outFields[0] = ty;
        return 1;
    }

    bool run(wallvm::ir_types::IrFunc* func)
    {
        if (!func || func*.isExtern) return false;

        bool changed = false;

        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = &bb.insts[ii];

                if (inst.opcode == wallvm::irOps::IrOpcode::Store && inst.nops >= 2)
                {
                    wallvm::ir_types::IrValue* val = inst.ops[0];
                    if (val && val.type && val.type.kind == wallvm::irTypes::IrTypeKind::Struct)
                    {
                        u32 cls = classifyStructType(val.type);
                        if (cls == 1 || cls == 2)
                        {
                            changed = true;
                        }
                    }
                }

                if (inst.opcode == wallvm::irOps::IrOpcode::Load && inst.nops >= 1)
                {
                    if (inst.base.type && inst.base.type.kind == wallvm::irTypes::IrTypeKind::Struct)
                    {
                        u32 cls = classifyStructType(inst.base.type);
                        if (cls == 1 || cls == 2)
                        {
                            changed = true;
                        }
                    }
                }
            }
        }

        return changed;
    }
}

pub bool irABILower(wallvm::ir_types::IrFunc* func, rawptr userdata)
{
    if (!func) return false;
    wallvm::ir_types::IrContext* ctx = (wallvm::ir_types::IrContext*)userdata;
    ABILowering lower = ABILowering::new(ctx);
    return lower.run(func);
}
