// x86_64 encoder: AT&T line → machine bytes. Same shape as every
// assembler's back half — NASM find_match over insns.dat, LLVM's TableGen
// matcher + MCCodeEmitter: a form table keyed by (base mnemonic, size,
// operand signature), a matcher that picks the row, and an emitter that
// writes prefixes/REX/opcode/ModRM/SIB/imm for that row. Vector mnemonics
// go to the AVX table first (full-name match, no suffix splitting), then
// the legacy table. Entry points: encodeLine (one line, no object) and
// assembleText (whole unit into an AsmObject with symbols + relocs).
import(lib) wallvm::asm::common { AsmLine, AsmOperand, AsmOpKind, AsmParseError, AsmLexer, parseAttLine };
import(lib) wallvm::asm::x86::common { X86Reg, X86RegClass, lookupReg, isVectorReg, AsmBytes, X86Rex, encodeMem, encodeRegReg };
import(lib) wallvm::asm::x86::obj { AsmObject, AsmSymbol, AsmRelocKind, asmAddReloc, asmFindOrAddSym, asmFindSym };
import(lib) wallvm::asm::x86::x86_avx { EncodeCtx, ctxNew, tryVecTable };
import(lib) core::char_util { isAlpha, isDigit, isSpace };
import(lib) core::cchar { cchar };

// operand-size suffixes
static u8 sizeOfSuffix(str s)
{
    if (s.len != 1) return 0;
    switch (s.ptr[0])
    {
        98 => { return 1; },   // b
        119 => { return 2; },  // w
        108 => { return 4; },  // l
        113 => { return 8; },  // q
        else => { return 0; },
    }
}

// condition-code numbers, the 0-15 shared by jcc/setcc/cmovcc. Table
// over the alias soup (b/c/nae are the same code) rather than a long
// if-else chain.
struct CcEntry { str name; i32 code; }

static CcEntry _ccTab[] = {
    { "o", 0 }, { "no", 1 },
    { "b", 2 }, { "c", 2 }, { "nae", 2 },
    { "ae", 3 }, { "nb", 3 }, { "nc", 3 },
    { "e", 4 }, { "z", 4 },
    { "ne", 5 }, { "nz", 5 },
    { "be", 6 }, { "na", 6 },
    { "a", 7 }, { "nbe", 7 },
    { "s", 8 }, { "ns", 9 },
    { "p", 10 }, { "pe", 10 },
    { "np", 11 }, { "po", 11 },
    { "l", 12 }, { "nge", 12 },
    { "ge", 13 }, { "nl", 13 },
    { "le", 14 }, { "ng", 14 },
    { "g", 15 }, { "nle", 15 }
};

static i32 ccOfName(str s)
{
    u32 n = sizeof(_ccTab) / sizeof(_ccTab[0]);
    for (u32 i = 0; i < n; i++)
    {
        if (_ccTab[i].name.equals(s)) return _ccTab[i].code;
    }
    return -1;
}

// shift mnemonic → /digit in the C0/D0/D3 groups
struct ShiftEntry { str name; u8 ext; }

static ShiftEntry _shiftTab[] = {
    { "rol", 4 }, { "sal", 4 }, { "shl", 4 },
    { "ror", 5 }, { "shr", 5 },
    { "rcl", 2 }, { "rcr", 3 }, { "sar", 7 }
};

static u8 shiftExtOf(str base)
{
    u32 n = sizeof(_shiftTab) / sizeof(_shiftTab[0]);
    for (u32 i = 0; i < n; i++)
    {
        if (_shiftTab[i].name.equals(base)) return _shiftTab[i].ext;
    }
    return 0xFF;
}

static bool isShiftMnem(str base)
{
    return shiftExtOf(base) != 0xFF;
}

// form signatures, AT&T operand order (src, dst)
enum FormSig
{
    FS_NONE,   // no operands
    FS_RM_R,   // reg, rm      → mr encoding (89, 01, ...)
    FS_R_RM,   // rm, reg      → rm encoding (8B, 03, ...)
    FS_RM_I,   // imm, rm      → mi (83/81, C7)
    FS_R_I,    // imm, reg     → B8+r
    FS_AI,     // imm, al/ax/eax/rax only (A8/A9, 04/05...)
    FS_RM,     // rm alone     → m (FF /0, F7 /4, ...)
    FS_R,      // reg alone    → B8+r/50+r (push/movabs/bswap)
    FS_I,      // imm alone    (push $imm)
    FS_REL,    // relative branch
    FS_IMR     // imm, reg, rm — shld/shrd imm form
}

// immediate width codes in a row
// 0 none, 1 ib, 2 iw, 4 id, 8 iq, 9 auto (follows operand size, capped 4)
// with signExtIb: prefer the sign-extended ib encoding when imm fits i8
struct FormRow
{
    str base;       // mnemonic without suffix
    u8 sizeMask;    // bit0..3 = sizes 1,2,4,8
    u8 sig;
    u8 op;
    u8 op2;         // 0F second byte, or 0
    u8 ext;         // /digit, 0xFF = reg field from the reg operand
    u8 immW;        // immediate width code
    bool signExtIb; // 83-style: use op+1 with sign-extended imm8
    bool forceW;    // REX.W always
    bool noW;       // never REX.W (byte ops, push/pop)
    u8 pfx;         // mandatory prefix byte 0/0x66/0xF2/0xF3
}

const u8 SZ1 = 1, SZ2 = 2, SZ4 = 4, SZ8 = 8;
const u8 SZ124 = 7, SZ1248 = 15, SZ248 = 14, SZ48 = 12, SZ24 = 6;
const u8 NOREG = 0xFF;

// The form table. Row order matters: the matcher takes the first hit, so
// narrower/special rows (sign-extended imm8, imm-to-al) sit above their
// general siblings — the same ordering NASM's insns.dat relies on.
static FormRow _forms[] = {
    // mov
    { "mov", SZ1248, FS_RM_R, 0x88, 0, NOREG, 0, false, false, false, 0 },
    { "mov", SZ1248, FS_R_RM, 0x8A, 0, NOREG, 0, false, false, false, 0 },
    { "mov", SZ1248, FS_R_I,  0xB8, 0, NOREG, 9, false, false, false, 0 },
    { "mov", SZ124,  FS_RM_I, 0xC6, 0, 0,    9, false, false, false, 0 },
    { "mov", SZ8,    FS_RM_I, 0xC7, 0, 0,    4, false, false, false, 0 },
    { "movabs", SZ8, FS_R_I,  0xB8, 0, NOREG, 8, false, false, false, 0 },
    { "lea", SZ248,  FS_R_RM, 0x8D, 0, NOREG, 0, false, false, false, 0 },

    // ALU: add or adc sbb and sub xor cmp — opcode base 0x00 + 8*idx,
    // imm forms 83 /idx ib (sign-ext) above 81 /idx iz
    { "add", SZ1248, FS_RM_R, 0x00, 0, NOREG, 0, false, false, false, 0 },
    { "add", SZ1248, FS_R_RM, 0x02, 0, NOREG, 0, false, false, false, 0 },
    { "add", SZ124,  FS_AI,   0x04, 0, NOREG, 1, false, false, false, 0 },
    { "add", SZ248,  FS_AI,   0x05, 0, NOREG, 9, false, false, false, 0 },
    { "add", SZ1248, FS_RM_I, 0x80, 0, 0,    1, false, false, false, 0 },
    { "add", SZ248,  FS_RM_I, 0x83, 0, 0,    1, true,  false, false, 0 },
    { "add", SZ248,  FS_RM_I, 0x81, 0, 0,    9, false, false, false, 0 },
    { "or",  SZ1248, FS_RM_R, 0x08, 0, NOREG, 0, false, false, false, 0 },
