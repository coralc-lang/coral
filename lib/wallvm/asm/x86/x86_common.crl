// x86 register table and the byte-level encoding substrate every x86
// assembler carries: REX, ModRM, SIB, displacement. Shared by the 64- and
// 32-bit encoders. Follows the same split as LLVM's X86BaseInfo / NASM's
// reg-class tables: registers are (class, size, number), memory operands
// lower to ModRM+SIB+disp with the four classic special cases (rsp/r12
// force SIB, rbp/r13 force disp, rip-relative is mod=00 rm=101).
import(lib) core::char_util { isDigit, isAlpha, isHexDigit, digitValue };
import(lib) core::cchar { cchar };
import(lib) platform::libc { malloc, free, memcmp };
import(lib) std::mman { copy };

pub enum X86RegClass
{
    RcNone,
    RcGpr,    // rax..r15 family, size decides width
    RcXmm,
    RcSeg
}

pub struct X86Reg
{
    str name;
    u8 num;       // 0-15 encoding number
    u8 cls;       // X86RegClass
    u8 size;      // 1, 2, 4, 8 in bytes; xmm = 16
    bool needsRex; // sil/dil/bpl/spl force a REX prefix in byte form
}

// Register table, x86_64. Byte registers that live in the r8-r15 space
// (r8b-r15b) share numbers with the 64-bit regs; ah/ch/dh/bh are the
// high-byte registers (num 4-7, no REX allowed — we reject them under
// REX rather than silently mis-encode).
static X86Reg _regTable[] = { 
    { "rax", 0, 1, 8, false }, { "rcx", 1, 1, 8, false },
    { "rdx", 2, 1, 8, false }, { "rbx", 3, 1, 8, false },
    { "rsp", 4, 1, 8, false }, { "rbp", 5, 1, 8, false },
    { "rsi", 6, 1, 8, false }, { "rdi", 7, 1, 8, false },
    { "r8",  8, 1, 8, false }, { "r9",  9, 1, 8, false },
    { "r10",10, 1, 8, false }, { "r11",11, 1, 8, false },
    { "r12",12, 1, 8, false }, { "r13",13, 1, 8, false },
    { "r14",14, 1, 8, false }, { "r15",15, 1, 8, false },

    { "eax", 0, 1, 4, false }, { "ecx", 1, 1, 4, false },
    { "edx", 2, 1, 4, false }, { "ebx", 3, 1, 4, false },
    { "esp", 4, 1, 4, false }, { "ebp", 5, 1, 4, false },
    { "esi", 6, 1, 4, false }, { "edi", 7, 1, 4, false },
    { "r8d", 8, 1, 4, false }, { "r9d", 9, 1, 4, false },
    { "r10d",10, 1, 4, false }, { "r11d", 11, 1, 4, false },
    { "r12d",12, 1, 4, false }, { "r13d", 13, 1, 4, false },
    { "r14d",14, 1, 4, false }, { "r15d", 15, 1, 4, false },

    { "ax",  0, 1, 2, false }, { "cx", 1, 1, 2, false },
    { "dx",  2, 1, 2, false }, { "bx", 3, 1, 2, false },
    { "sp",  4, 1, 2, false }, { "bp", 5, 1, 2, false },
    { "si",  6, 1, 2, false }, { "di", 7, 1, 2, false },
    { "r8w", 8, 1, 2, false }, { "r9w", 9, 1, 2, false },
    { "r10w",10, 1, 2, false }, { "r11w", 11, 1, 2, false },
    { "r12w",12, 1, 2, false }, { "r13w", 13, 1, 2, false },
    { "r14w",14, 1, 2, false }, { "r15w", 15, 1, 2, false },

    { "al",  0, 1, 1, false }, { "cl", 1, 1, 1, false },
    { "dl",  2, 1, 1, false }, { "bl", 3, 1, 1, false },
    { "spl", 4, 1, 1, true  }, { "bpl", 5, 1, 1, true  },
    { "sil", 6, 1, 1, true  }, { "dil", 7, 1, 1, true  },
    { "r8b", 8, 1, 1, false }, { "r9b", 9, 1, 1, false },
    { "r10b",10, 1, 1, false }, { "r11b", 11, 1, 1, false },
    { "r12b",12, 1, 1, false }, { "r13b", 13, 1, 1, false },
    { "r14b",14, 1, 1, false }, { "r15b", 15, 1, 1, false },
    { "ah", 4, 1, 1, false }, { "ch", 1, 1, 1, false },
    { "dh", 2, 1, 1, false }, { "bh", 3, 1, 1, false },

    { "xmm0", 0, 2, 16, false }, { "xmm1", 1, 2, 16, false },
    { "xmm2", 2, 2, 16, false }, { "xmm3", 3, 2, 16, false },
    { "xmm4", 4, 2, 16, false }, { "xmm5", 5, 2, 16, false },
    { "xmm6", 6, 2, 16, false }, { "xmm7", 7, 2, 16, false },
    { "xmm8", 8, 2, 16, false }, { "xmm9", 9, 2, 16, false },
    { "xmm10",10, 2, 16, false }, { "xmm11",11, 2, 16, false },
    { "xmm12",12, 2, 16, false }, { "xmm13",13, 2, 16, false },
    { "xmm14",14, 2, 16, false }, { "xmm15",15, 2, 16, false },

    { "es", 0, 3, 2, false }, { "cs", 1, 3, 2, false },
    { "ss", 2, 3, 2, false }, { "ds", 3, 3, 2, false },
    { "fs", 4, 3, 2, false }, { "gs", 5, 3, 2, false }
};

pub X86Reg* lookupReg(str name)
{
    u32 n = sizeof(_regTable) / sizeof(_regTable[0]);
    for (u32 i = 0; i < n; i++)
    {
        if (_regTable[i].name.equals(name)) return &_regTable[i];
    }
    return null;
}

// Growable byte sink every encoder writes into.
pub struct AsmBytes
{
    u8* data;
    u32 len;
    u32 cap;

    AsmBytes new()
    {
        return AsmBytes { .data = null, .len = 0, .cap = 0 };
    }

    bool reserve(u32 extra)
    {
        if (self.len + extra <= self.cap) return true;
        u32 ncap = self.cap == 0 ? 32 : self.cap * 2;
        while (ncap < self.len + extra) ncap = ncap * 2;
        u8* nd = (u8*)malloc(ncap);
        if (nd == null) return false;
        for (u32 i = 0; i < self.len; i++) nd[i] = self.data[i];
        if (self.data != null) free(self.data);
        self.data = nd;
        self.cap = ncap;
        return true;
    }

    bool u8b(u8 v)
    {
        if (!self.reserve(1)) return false;
        self.data[self.len] = v;
        self.len++;
        return true;
    }

    bool u16b(u16 v)
    {
        return self.u8b((u8)(v & 0xFF)) && self.u8b((u8)((v >> 8) & 0xFF));
    }

    bool u32b(u32 v)
    {
        return self.u8b((u8)(v & 0xFF)) && self.u8b((u8)((v >> 8) & 0xFF)) &&
               self.u8b((u8)((v >> 16) & 0xFF)) && self.u8b((u8)((v >> 24) & 0xFF));
    }

    bool u64b(u64 v)
    {
        return self.u32b((u32)(v & 0xFFFFFFFF)) && self.u32b((u32)((v >> 32) & 0xFFFFFFFF));
    }

    // little-endian immediate of `bytes` width
    bool immv(i64 v, u32 bytes)
    {
        u64 u = (u64)v;
        for (u32 i = 0; i < bytes; i++)
        {
            if (!self.u8b((u8)((u >> (8 * i)) & 0xFF))) return false;
        }
        return true;
    }

    void reset() { self.len = 0; }

    void deinit()
    {
        if (self.data != null) free(self.data);
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }
}

// REX prefix composition. rex.w from operand size, rex.r/x/b from the
// register-number high bits. A byte register needing REX (spl etc.)
// forces a bare 0x40.
pub struct X86Rex
{
    bool w, r, x, b, force;

    X86Rex new()
    {
        return X86Rex { .w = false, .r = false, .x = false, .b = false, .force = false };
    }

    bool any() { return self.w || self.r || self.x || self.b || self.force; }

    u8 byte()
    {
        u8 v = 0x40;
        if (self.w) v = v | 0x08;
        if (self.r) v = v | 0x04;
        if (self.x) v = v | 0x02;
        if (self.b) v = v | 0x01;
        return v;
    }
}

// ModRM+SIB+displacement for one memory operand plus a reg field.
// base/index are X86Reg* (index may be null); rip bypasses the reg fields.
// This is the part every x86 encoder gets subtly wrong once — the cases
// are: rsp/r12 as base need SIB (rm=100), rbp/r13 as base need a disp
// even when zero (mod=01, disp8=0), rip-relative is mod=00 rm=101 with
// disp32.
bool encodeMem(AsmBytes* out, X86Reg* base, X86Reg* index, u32 scale,
               bool hasDisp, i64 disp, bool rip, u8 regField, u8* rexB, u8* rexX)
{
    u8 reg = (u8)((regField & 7) << 3);

    if (rip)
    {
        // mod=00, rm=101, disp32
        if (!out.u8b(reg | 0x05)) return false;
        if (!out.u32b((u32)(i32)disp)) return false;
        return true;
    }

    if (base == null && index == null)
    {
        // absolute: mod=00 rm=100, SIB with no base/index (base=101,
        // mod=00), disp32
        if (!out.u8b(reg | 0x04)) return false;
        if (!out.u8b(0x25)) return false;
        if (!out.u32b((u32)(i32)disp)) return false;
        return true;
    }

    u8 baseNum = 0;
    bool baseHigh = false;
    if (base != null)
    {
        baseNum = base->num & 7;
        baseHigh = (base->num & 8) != 0;
        if (baseHigh && rexB != null) *rexB = 1;
    }

    u8 indexNum = 0;
    bool indexHigh = false;
    bool hasIndex = index != null;
    if (hasIndex)
    {
        indexNum = index->num & 7;
        indexHigh = (index->num & 8) != 0;
        if (indexHigh && rexX != null) *rexX = 1;
    }

    // scale encoding for SIB: 1→0, 2→1, 4→2, 8→3
    u8 sc = 0;
    if (scale == 2) sc = 1;
    else if (scale == 4) sc = 2;
    else if (scale == 8) sc = 3;

    // rsp as base (rm=100) always needs the SIB byte; r12 shares the low
    // 3 bits (100) so it too must go through SIB
    bool needSib = hasIndex || baseNum == 4;
    // rbp/r13 (low 3 bits 101) with mod=00 means rip/abs, so a zero
    // displacement still needs mod=01
    bool forceDisp8 = base != null && baseNum == 5;

    u8 mod;
    bool disp8 = false;
    bool disp32 = false;
    if (!hasDisp)
    {
        if (forceDisp8) { mod = 0x01; disp8 = true; }
        else { mod = 0x00; }
    }
    else
    {
        if (disp == 0 && !forceDisp8) { mod = 0x00; }
        else if (disp >= -128 && disp <= 127) { mod = 0x01; disp8 = true; }
        else { mod = 0x02; disp32 = true; }
    }

    if (!needSib)
    {
        if (!out.u8b((u8)(mod << 6 | reg | baseNum))) return false;
    }
    else
    {
        if (!out.u8b((u8)(mod << 6 | reg | 0x04))) return false;
        u8 sibBase = hasIndex || base != null ? baseNum : 0x05;
        u8 sibIndex = hasIndex ? indexNum : 0x04; // 100 = none
        if (!out.u8b((u8)(sc << 6 | sibIndex << 3 | sibBase))) return false;
        if (base == null && hasIndex)
        {
            // index-only needs disp32 after the SIB (mod=00 base=101)
            if (!out.u32b((u32)(i32)disp)) return false;
            return true;
        }
        if (base != null && baseNum == 5 && !hasDisp && mod == 0x00)
        {
            // unreachable — forceDisp8 covers rbp/r13 — kept for clarity
        }
    }

    if (disp8)
    {
        if (!out.u8b((u8)(i8)disp)) return false;
    }
    else if (disp32)
    {
        if (!out.u32b((u32)(i32)disp)) return false;
    }
    return true;
}

// ModRM byte for reg/reg forms: mod=11.
u8 encodeRegReg(u8 regField, u8 rmReg)
{
    return (u8)(0xC0 | ((regField & 7) << 3) | (rmReg & 7));
}
