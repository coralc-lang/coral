// Shared assembler front end: AT&T text lexer/parser to a target-neutral
// operand model, plus the inline-asm constraint parser. One line in, one
// AsmLine out; per-target encoders consume AsmLine. Structure follows the
// standard scanner/parser split every assembler uses (NASM stdscan+
// parse_line, LLVM lexer+AsmParser): this file knows AT&T syntax tokens
// and operand shapes, nothing about opcodes.
import(lib) core::char_util { isDigit, isAlpha, isAlnum, isSpace, isHexDigit, digitValue, toLower };
import(lib) core::cchar { cchar };
import(lib) platform::libc { malloc, free };

pub enum AsmOpKind
{
    Reg,      // %rax — name holds "rax"
    Imm,      // $5, $0x10 — imm holds the value
    Mem,      // disp(%base,%index,scale), rip-relative, bare (,%rax,4)
    Rel       // branch displacement: .+N / .-N / absolute number
}

pub struct AsmOperand
{
    AsmOpKind kind;
    str text;      // register name without %, or label for future use
    i64 imm;       // immediate or relative displacement value
    str base;      // mem: base register without %
    str index;     // mem: index register without %
    u32 scale;     // mem: 1, 2, 4, 8
    i64 disp;      // mem: displacement
    bool hasDisp;
    bool rip;      // mem: rip-relative
}

pub struct AsmLine
{
    str mnem;            // full mnemonic text, suffix included ("movl")
    AsmOperand ops[3];
    u32 nops;
    u32 lineNo;
    bool isDirective;    // .globl and friends, no encoding work
    bool isEmpty;
}

pub struct AsmParseError
{
    str msg;
    u32 lineNo;
}

// Cursor over one source line. AT&T: %reg, $imm, disp(base,index,scale),
// comments run from # or // to end of line, labels end with ':'.
pub struct AsmLexer
{
    str src;
    usize pos;
    u32 lineNo;

    AsmLexer new(str src, u32 lineNo)
    {
        return AsmLexer { .src = src, .pos = 0, .lineNo = lineNo };
    }

    bool done() { return self.pos >= self.src.len; }

    u8 peek()
    {
        if (self.pos >= self.src.len) return 0;
        return self.src.ptr[self.pos];
    }

    u8 peekAt(usize off)
    {
        if (self.pos + off >= self.src.len) return 0;
        return self.src.ptr[self.pos + off];
    }

    void skipSpace()
    {
        while (self.pos < self.src.len && isSpace(self.src.ptr[self.pos])) self.pos++;
        // comment to end of line
        if (self.pos < self.src.len && self.src.ptr[self.pos] == (u8)'#') self.pos = self.src.len;
        else if (self.pos + 1 < self.src.len && self.src.ptr[self.pos] == (u8)'/' &&
                 self.src.ptr[self.pos + 1] == (u8)'/') self.pos = self.src.len;
    }

    bool eat(u8 c)
    {
        self.skipSpace();
        if (self.pos < self.src.len && self.src.ptr[self.pos] == c) { self.pos++; return true; }
        return false;
    }

    // identifier-like run: letters, digits, _, ., $ (for @PLT-style tails
    // we stop at @ separately). Used for mnemonics, registers, labels.
    str lexIdent()
    {
        self.skipSpace();
        usize start = self.pos;
        while (self.pos < self.src.len)
        {
            u8 c = self.src.ptr[self.pos];
            if (isAlnum(c) || c == (u8)'_' || c == (u8)'.' || c == (u8)'$') self.pos++;
            else break;
        }
        if (start == self.pos) return str::empty();
        return str::fromParts(self.src.ptr + start, self.pos - start);
    }

    // signed integer: dec, 0x hex, or 0 octal-ish (we take 0x/dec only)
    bool lexNumber(i64* out)
    {
        self.skipSpace();
        bool neg = false;
        if (self.pos < self.src.len && (self.src.ptr[self.pos] == (u8)'-' || self.src.ptr[self.pos] == (u8)'+'))
        {
            neg = self.src.ptr[self.pos] == (u8)'-';
            self.pos++;
        }
        if (self.pos >= self.src.len || !isDigit(self.src.ptr[self.pos])) return false;
        u64 v = 0;
        if (self.src.ptr[self.pos] == (u8)'0' && self.pos + 1 < self.src.len &&
            (self.src.ptr[self.pos + 1] == (u8)'x' || self.src.ptr[self.pos + 1] == (u8)'X'))
        {
            self.pos += 2;
            while (self.pos < self.src.len && isHexDigit(self.src.ptr[self.pos]))
            {
                v = v * 16 + (u64)digitValue(self.src.ptr[self.pos]);
                self.pos++;
            }
        }
        else
        {
            while (self.pos < self.src.len && isDigit(self.src.ptr[self.pos]))
            {
                v = v * 10 + (u64)digitValue(self.src.ptr[self.pos]);
                self.pos++;
            }
        }
        *out = neg ? -(i64)v : (i64)v;
        return true;
    }
}

// Parse one AT&T operand at the cursor. Memory: disp?( base? , index? , scale )?
// with rip spelled (%rip). Registers keep the name without the %.
bool parseAttOperand(AsmLexer* lx, AsmOperand* out, AsmParseError* err)
{
    lx.skipSpace();
    if (lx.done()) { err.msg = str::fromCstr("missing operand"); err.lineNo = lx.lineNo; return false; }

    u8 c = lx.peek();

    // register
    if (c == (u8)'%')
    {
        lx.pos++;
        str name = lx.lexIdent();
        if (name.isEmpty()) { err.msg = str::fromCstr("empty register name"); err.lineNo = lx.lineNo; return false; }
        out.kind = AsmOpKind::Reg;
        out.text = name;
        return true;
    }

    // immediate
    if (c == (u8)'$')
    {
        lx.pos++;
        // allow a bare identifier as an address immediate (symbol ref)
        lx.skipSpace();
        if (!lx.done() && (isAlpha(lx.peek()) || lx.peek() == (u8)'_'))
        {
            str name = lx.lexIdent();
            out.kind = AsmOpKind::Imm;
            out.text = name;
            out.imm = 0;
            return true;
        }
        i64 v = 0;
        if (!lx.lexNumber(&v)) { err.msg = str::fromCstr("bad immediate"); err.lineNo = lx.lineNo; return false; }
        out.kind = AsmOpKind::Imm;
        out.imm = v;
        return true;
    }

    // memory or relative branch: starts with disp, (, or .
    // relative: .+N / .-N — a dot followed by sign
    if (c == (u8)'.' && (lx.peekAt(1) == (u8)'+' || lx.peekAt(1) == (u8)'-'))
    {
        lx.pos++;
        i64 v = 0;
        if (!lx.lexNumber(&v)) { err.msg = str::fromCstr("bad relative displacement"); err.lineNo = lx.lineNo; return false; }
        out.kind = AsmOpKind::Rel;
        out.imm = v;
        return true;
    }

    // memory operand: optional displacement, then '(' ...
    bool sawDisp = false;
    i64 disp = 0;
    if (c == (u8)'(' || isDigit(c) || c == (u8)'-' || c == (u8)'+')
    {
        if (c != (u8)'(')
        {
            if (!lx.lexNumber(&disp)) { err.msg = str::fromCstr("bad displacement"); err.lineNo = lx.lineNo; return false; }
            sawDisp = true;
        }
        lx.skipSpace();
        if (lx.done() || lx.peek() != (u8)'(')
        {
            // bare number without parens is a relative branch target
            out.kind = AsmOpKind::Rel;
            out.imm = disp;
            return true;
        }
    }

    if (lx.peek() != (u8)'(')
    {
        // plain identifier: label reference
        str name = lx.lexIdent();
        if (name.isEmpty()) { err.msg = str::fromCstr("bad operand"); err.lineNo = lx.lineNo; return false; }
        // @PLT tail is part of the name for encoders that care
        if (lx.peek() == (u8)'@')
        {
            lx.pos++;
            str tail = lx.lexIdent();
            usize nlen = name.len + 1 + tail.len;
            u8* buf = (u8*)malloc(nlen);
            for (usize i = 0; i < name.len; i++) buf[i] = name.ptr[i];
            buf[name.len] = (u8)'@';
            for (usize i = 0; i < tail.len; i++) buf[name.len + 1 + i] = tail.ptr[i];
            name = str::fromParts(buf, nlen);
        }
        out.kind = AsmOpKind::Rel;
        out.text = name;
        out.imm = 0;
        return true;
    }

    // inside parens: base, index, scale
    lx.pos++; // consume '('
    out.kind = AsmOpKind::Mem;
    out.hasDisp = sawDisp;
    out.disp = disp;
    out.scale = 1;

    lx.skipSpace();
    if (!lx.done() && lx.peek() == (u8)'%')
    {
        lx.pos++;
        str name = lx.lexIdent();
        if (name.isEmpty()) { err.msg = str::fromCstr("empty register in mem operand"); err.lineNo = lx.lineNo; return false; }
        if (name.equals(str::fromCstr("rip"))) out.rip = true;
        else out.base = name;
    }

    if (lx.eat((u8)','))
    {
        lx.skipSpace();
        if (!lx.done() && lx.peek() == (u8)'%')
        {
            lx.pos++;
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = str::fromCstr("empty index register"); err.lineNo = lx.lineNo; return false; }
            out.index = name;
            if (lx.eat((u8)','))
            {
                i64 sc = 1;
                if (!lx.lexNumber(&sc) || (sc != 1 && sc != 2 && sc != 4 && sc != 8))
                {
                    err.msg = str::fromCstr("bad scale, want 1/2/4/8"); err.lineNo = lx.lineNo; return false;
                }
                out.scale = (u32)sc;
            }
        }
    }

    if (!lx.eat((u8)')'))
    {
        err.msg = str::fromCstr("missing ')' in memory operand"); err.lineNo = lx.lineNo; return false;
    }
    return true;
}

// One AT&T source line → AsmLine. Blank lines, comments, and directives
// come back flagged; everything else must be mnemonic + <=3 operands.
bool parseAttLine(str src, u32 lineNo, AsmLine* out, AsmParseError* err)
{
    out.mnem = str::empty();
    out.nops = 0;
    out.lineNo = lineNo;
    out.isDirective = false;
    out.isEmpty = true;

    AsmLexer lx = AsmLexer::new(src, lineNo);
    lx.skipSpace();
    if (lx.done()) return true;

    // label definition: ident ':' — P1 skips it (no label table yet)
    usize save = lx.pos;
    str maybeLabel = lx.lexIdent();
    lx.skipSpace();
    if (!maybeLabel.isEmpty() && !lx.done() && lx.peek() == (u8)':')
    {
        lx.pos++;
        lx.skipSpace();
        if (lx.done()) return true;
    }
    else
    {
        lx.pos = save;
    }

    // directives start with '.'
    if (lx.peek() == (u8)'.')
    {
        out.isDirective = true;
        out.isEmpty = false;
        return true;
    }

    // prefix words (lock, rep, repz, repnz, data16, data32, addr32) are
    // skipped for P1; encoders that need them come with the atomics table
    while (!lx.done())
    {
        usize before = lx.pos;
        str w = lx.lexIdent();
        if (w.equals(str::fromCstr("lock")) || w.equals(str::fromCstr("rep")) ||
            w.equals(str::fromCstr("repz")) || w.equals(str::fromCstr("repnz")) ||
            w.equals(str::fromCstr("repne")) || w.equals(str::fromCstr("data16")) ||
            w.equals(str::fromCstr("data32")) || w.equals(str::fromCstr("addr32")))
        {
            continue;
        }
        lx.pos = before;
        break;
    }

    str mnem = lx.lexIdent();
    if (mnem.isEmpty()) { err.msg = str::fromCstr("expected mnemonic"); err.lineNo = lineNo; return false; }
    out.mnem = mnem;
    out.isEmpty = false;

    // strip a @suffix from the mnemonic (call foo@PLT keeps @PLT on the
    // operand; the mnemonic itself never carries one)
    while (true)
    {
        lx.skipSpace();
        if (lx.done() || lx.peek() != (u8)',') break;
        if (out.nops >= 3) { err.msg = str::fromCstr("too many operands"); err.lineNo = lineNo; return false; }
        lx.pos++;
        AsmOperand op = AsmOperand {
            .kind = AsmOpKind::Imm,
            .text = str::empty(),
            .imm = 0,
            .base = str::empty(),
            .index = str::empty(),
            .scale = 1,
            .disp = 0,
            .hasDisp = false,
            .rip = false
        };
        if (!parseAttOperand(&lx, &op, err)) return false;
        out.ops[out.nops] = op;
        out.nops++;
    }

    lx.skipSpace();
    if (!lx.done())
    {
        err.msg = str::fromCstr("trailing text after operands");
        err.lineNo = lineNo;
        return false;
    }
    return true;
}

// Inline-asm constraint strings: comma-separated entries, each an optional
// direction marker (=, +, &) then the class letter. Only what the IR path
// needs to validate operands; encoding stays the encoder's job.
pub enum AsmConClass
{
    ConGeneral,   // r
    ConImm,       // i
    ConMem,       // m
    ConFloat,     // f
    ConRegName,   // a c d b S D ... — specific register, reg holds it
    ConUnknown
}

pub struct AsmConstraint
{
    str text;        // the raw entry, kept for diagnostics
    bool isOut;      // '='
    bool isInOut;    // '+'
    bool earlyClobber; // '&'
    AsmConClass cls;
    str regName;     // single-letter class as a name, e.g. "a" for =a
}

// Parse a constraint list into out, returns the count. Returns 0xFFFF on
// a malformed entry (err gets the reason).
pub u32 parseConstraints(str text, AsmConstraint* out, u32 max, AsmParseError* err)
{
    u32 n = 0;
    usize i = 0;
    while (i <= text.len)
    {
        usize start = i;
        while (i < text.len && text.ptr[i] != (u8)',') i++;
        // slice [start, i)
        usize a = start;
        usize b = i;
        while (a < b && isSpace(text.ptr[a])) a++;
        while (b > a && isSpace(text.ptr[b - 1])) b--;
        if (a < b)
        {
            if (n >= max) { err.msg = str::fromCstr("too many constraints"); return 0xFFFF; }
            AsmConstraint c = AsmConstraint {
                .text = str::fromParts(text.ptr + a, b - a),
                .isOut = false,
                .isInOut = false,
                .earlyClobber = false,
                .cls = AsmConClass::ConUnknown,
                .regName = str::empty()
            };
            usize p = a;
            while (p < b)
            {
                u8 ch = text.ptr[p];
                if (ch == (u8)'=') c.isOut = true;
                else if (ch == (u8)'+') c.isInOut = true;
                else if (ch == (u8)'&') c.earlyClobber = true;
                else break;
                p++;
            }
            if (p >= b) { err.msg = str::fromCstr("constraint missing class letter"); err.lineNo = 0; return 0xFFFF; }
            u8 letter = text.ptr[p];
            if (letter == (u8)'r') c.cls = AsmConClass::ConGeneral;
            else if (letter == (u8)'i') c.cls = AsmConClass::ConImm;
            else if (letter == (u8)'m') c.cls = AsmConClass::ConMem;
            else if (letter == (u8)'f') c.cls = AsmConClass::ConFloat;
            else if (isAlpha(letter))
            {
                c.cls = AsmConClass::ConRegName;
                c.regName = str::fromParts(text.ptr + p, 1);
            }
            else { err.msg = str::fromCstr("unknown constraint class"); return 0xFFFF; }
            out[n] = c;
            n++;
        }
        if (i >= text.len) break;
        i++; // skip the comma
    }
    return n;
}
