mod wallvm = import(lib) wallvm;
mod std = import(lib) std;

// x86 (32-bit/i386) base code generator

pub const char** X86_RESERVED_INT = {
    "esp", "ebp"
};

pub const char** X86_RESERVED_FLOAT = {
    "xmm0", "xmm1"
};

pub const char** X86_FLOAT_REGS = {
    "st0", "st1"
};

pub const char** X86_INT_REGS = {
    "eax", "ecx", "edx", "ebx", "esi", "edi"
};

pub const char** X86_INT_CALLEE_SAVE = {
    "ebx", "esi", "edi", "ebp"
};

pub const char** X86_INT_CALLER_SAVE = {
    "eax", "ecx", "edx"
};

pub struct X86Emitter
{
    wallvm::ir_types::IrContext* ctx;
    wallvm::ir_types::IrModule* modd;
    bool useAtt;
    std::cchar* output;
    u32 outputLen;
    u32 outputCap;
    u32 labelCounter;

    void init(wallvm::ir_types::IrContext* ctx, wallvm::ir_types::IrModule* modd, bool useAtt)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.useAtt = useAtt;
        self.output = null;
        self.outputLen = 0;
        self.outputCap = 0;
        self.labelCounter = 0;
    }

    u32 nextLabel()
    {
        return self.labelCounter++;
    }

    void emit(const char* str)
    {
        u32 len = 0;
        while (str[len]) len++;
        if (self.outputLen + len + 1 > self.outputCap)
        {
            u32 newCap = self.outputCap ? self.outputCap * 2 : 8192;
            std::cchar* buf = std::mman::alloc<std::cchar>(newCap);
            if (self.output)
            {
                for (u32 i = 0; i < self.outputLen; i++)
                    buf[i] = self.output[i];
                std::mman::dealloc<std::cchar>(self.output);
            }
            self.output = buf;
            self.outputCap = newCap;
        }
        for (u32 i = 0; i < len; i++)
            self.output[self.outputLen + i] = str[i];
        self.outputLen += len;
        self.output[self.outputLen] = 0;
    }

    void emitLine(const char* str)
    {
        self.emit(str);
        self.emit("\n");
    }

    void emitTab(const char* instr)
    {
        self.emit("\t");
        self.emitLine(instr);
    }

    const char* getOutput() { return self.output; }
}

pub struct X86CodeGen
{
    wallvm::ir_types::IrContext* ctx;
    wallvm::ir_types::IrModule* modd;
    X86Emitter emitter;
    bool isWindows;
    bool currentFuncHasFrame;
    bool useRedZone;
    bool savedCalleeSaves[4];
    u32 numCalleeSaves;
    str lastCallTarget;
    wallvm::ir_types::IrValue* lastCallResult;
    bool omitFramePointer;
    bool calleeSavesPushed;

    void init(wallvm::ir_types::IrContext* ctx, wallvm::ir_types::IrModule* modd, bool isWindows, bool useAtt)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.isWindows = isWindows;
        self.omitFramePointer = true;
        self.emitter.init(ctx, modd, useAtt);
    }

    static bool isCalleeSaved(str reg)
    {
        if (strEq(reg, "ebx")) return true;
        if (strEq(reg, "esi")) return true;
        if (strEq(reg, "edi")) return true;
        if (strEq(reg, "ebp")) return true;
        return false;
    }

    bool funcUsesReg(wallvm::ir_types::IrFunc* func, str reg)
    {
        for (u32 bi = 0; bi < func*.nblocks; bi++)
        {
            wallvm::ir_types::IrBlock* bb = func*.blocks[bi];
            for (u32 ii = 0; ii < bb.ninsts; ii++)
            {
                wallvm::ir_types::IrInst* inst = bb.insts[ii];
                str dst = getRegName(&inst.base);
                if (strEq(dst, reg)) return true;
                for (u32 oi = 0; oi < inst.nops; oi++)
                {
                    str op = getRegName(inst.ops[oi]);
                    if (strEq(op, reg)) return true;
                }
            }
        }
        return false;
    }

    bool blockUsesReg(wallvm::ir_types::IrBlock* bb, str reg)
    {
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            wallvm::ir_types::IrInst* inst = bb.insts[ii];
            str dst = getRegName(&inst.base);
            if (strEq(dst, reg)) return true;
            for (u32 oi = 0; oi < inst.nops; oi++)
            {
                str op = getRegName(inst.ops[oi]);
                if (strEq(op, reg)) return true;
            }
        }
        return false;
    }

    void emitPushCalleeSave(str reg)
    {
        if (self.emitter.useAtt)
        {
            self.emitter.emit("\tpushl %");
            self.emitter.emit(reg);
            self.emitter.emit("\n");
        }
        else
        {
            self.emitter.emit("\tpush ");
            self.emitter.emit(reg);
            self.emitter.emit("\n");
        }
    }

    void emitDeferredCalleeSaves(wallvm::ir_types::IrBlock* bb)
    {
        if (self.calleeSavesPushed) return;

        str calleeSaveRegs[4] = {"ebx", "esi", "edi", "ebp"};
        bool needed = false;
        for (u32 i = 0; i < 4; i++)
        {
            if (self.savedCalleeSaves[i])
            {
                if (self.blockUsesReg(bb, calleeSaveRegs[i]))
                {
                    needed = true;
                    break;
                }
            }
        }

        if (!needed) return;

        self.calleeSavesPushed = true;
        for (u32 i = 0; i < 4; i++)
        {
            if (self.savedCalleeSaves[i])
                self.emitPushCalleeSave(calleeSaveRegs[i]);
        }
    }

    void emitPrologue(wallvm::ir_types::IrFunc* func)
    {
        if (self.isWindows)
        {
            self.emitter.emit("public _");
            self.emitter.emitLine(func*.name);
            self.emitter.emit("_");
        }
        else
        {
            self.emitter.emit(".globl ");
            self.emitter.emitLine(func*.name);
        }
        self.emitter.emit(".type ");
        self.emitter.emit(func*.name);
        self.emitter.emitLine(", @function");

        self.emitter.emit(func*.name);
        self.emitter.emitLine(":");

        self.useRedZone = false;
        self.numCalleeSaves = 0;
        self.lastCallTarget = "";
        self.lastCallResult = null;

        bool isLeaf = func*.isLeaf();

        if (isLeaf && !self.isWindows)
        {
            self.currentFuncHasFrame = false;
            return;
        }

        bool hasFrame = !isLeaf && !self.omitFramePointer;
        bool usesAnyCalleeSave = false;
        str calleeSaveRegs[4] = {"ebx", "esi", "edi", "ebp"};
        for (u32 i = 0; i < 4; i++)
        {
            str reg = calleeSaveRegs[i];
            if (hasFrame && strEq(reg, "ebp"))
                continue;
            if (self.funcUsesReg(func, reg))
            {
                self.savedCalleeSaves[i] = true;
                self.numCalleeSaves++;
                usesAnyCalleeSave = true;
            }
            else
            {
                self.savedCalleeSaves[i] = false;
            }
        }

        self.calleeSavesPushed = false;
        bool canShrinkWrap = usesAnyCalleeSave && !hasFrame;

        if (!canShrinkWrap && !isLeaf)
        {
            self.calleeSavesPushed = true;
            for (u32 i = 0; i < 4; i++)
            {
                if (self.savedCalleeSaves[i])
                    self.emitPushCalleeSave(calleeSaveRegs[i]);
            }
        }

        if (!isLeaf && self.omitFramePointer)
        {
            self.currentFuncHasFrame = false;
        }
        else if (!isLeaf)
        {
            if (self.emitter.useAtt)
            {
                self.emitter.emitTab("pushl %ebp");
                self.emitter.emitTab("movl %esp, %ebp");
            }
            else
            {
                self.emitter.emitTab("push ebp");
                self.emitter.emitTab("mov ebp, esp");
            }
            self.currentFuncHasFrame = true;
        }
        else
        {
            self.currentFuncHasFrame = false;
        }
    }

    void emitEpilogue()
    {
        if (this.currentFuncHasFrame)
            this.emitter.emitTab("leave");

        if (this.calleeSavesPushed)
        {
            str calleeSaveRegs[4] = {"ebx", "esi", "edi", "ebp"};
            for (u32 i = 4; i > 0; i--)
            {
                u32 idx = i - 1;
                if (this.savedCalleeSaves[idx])
                {
                    str reg = calleeSaveRegs[idx];
                    if (this.emitter.useAtt)
                    {
                        this.emitter.emit("\tpopl %");
                        this.emitter.emit(reg);
                        this.emitter.emit("\n");
                    }
                    else
                    {
                        this.emitter.emit("\tpop ");
                        this.emitter.emit(reg);
                        this.emitter.emit("\n");
                    }
                }
            }
        }

        this.emitter.emitTab("ret");
    }

    bool isTailCall(wallvm::ir_types::IrInst* retInst)
    {
        if (!self.lastCallTarget || self.lastCallTarget.len == 0) return false;
        if (!retInst.nops || !retInst.ops[0]) return false;
        if (self.lastCallResult != retInst.ops[0]) return false;
        if (self.currentFuncHasFrame) return false;
        if (self.numCalleeSaves > 0) return false;
        if (self.isWindows) return false;
        return true;
    }

    void emitRet(wallvm::ir_types::IrInst* inst)
    {
        bool isTail = isTailCall(inst);

        if (inst.nops > 0 && inst.ops[0])
        {
            const char* src = getRegForValue(inst.ops[0]);
            if (!strEq(src, "eax"))
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(src);
                self.emitter.emitLine(", %eax");
            }
        }
        if (isTail)
        {
            self.emitter.emit("\tjmp ");
            self.emitter.emitLine(self.lastCallTarget);
        }
        else
        {
            emitEpilogue();
        }
    }

    static void u32ToStr(u32 val, std::cchar* out)
    {
        if (val == 0) { out[0] = '0'; out[1] = 0; return; }
        std::cchar tmp[10];
        u32 i = 0;
        while (val > 0) { tmp[i++] = '0' + (val % 10); val /= 10; }
        for (u32 j = 0; j < i; j++) out[j] = tmp[i - 1 - j];
        out[i] = 0;
    }

    str getRegName(wallvm::ir_types::IrValue* val)
    {
        if (!val) return "eax";
        u64 vd = val.valData;
        if (vd & 0x80000000UL)
            return "eax";
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 2) return X86_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        if (reg < 6) return X86_INT_REGS[reg];
        return "eax";
    }

    str getRegForValue(wallvm::ir_types::IrValue* val)
    {
        if (!val) return "eax";
        u64 vd = val.valData;
        if (vd & 0x80000000UL)
        {
            u32 spillIdx = (u32)(vd & 0x7FFFFFFF);
            u32 offset = spillIdx * 4;
            std::cchar offsetBuf[16];
            u32ToStr(offset, offsetBuf);
            if (vd & 0x40000000UL)
            {
                self.emitter.emit("\tflds -");
                self.emitter.emit(offsetBuf);
                self.emitter.emitLine("(%ebp)");
                return "st0";
            }
            else
            {
                self.emitter.emit("\tmovl -");
                self.emitter.emit(offsetBuf);
                self.emitter.emitLine("(%ebp), %eax");
                return "eax";
            }
        }
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 2) return X86_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        if (reg < 6) return X86_INT_REGS[reg];
        self.emitter.emit("; ERROR: out-of-range register index ");
        std::cchar idxBuf[16];
        u32ToStr(reg, idxBuf);
        self.emitter.emitLine(idxBuf);
        return "eax";
    }

    void emitInst(wallvm::ir_types::IrInst* inst)
    {
        switch (inst.opcode)
        {
        case wallvm::irOps::IrOpcode::Add:
            emitBinOp(inst, "addl");
            break;
        case wallvm::irOps::IrOpcode::Sub:
            emitBinOp(inst, "subl");
            break;
        case wallvm::irOps::IrOpcode::Mul:
            emitBinOp(inst, "imull");
            break;
        case wallvm::irOps::IrOpcode::SDiv:
            emitDiv(inst, true);
            break;
        case wallvm::irOps::IrOpcode::UDiv:
            emitDiv(inst, false);
            break;
        case wallvm::irOps::IrOpcode::SRem:
            emitRem(inst, true);
            break;
        case wallvm::irOps::IrOpcode::URem:
            emitRem(inst, false);
            break;
        case wallvm::irOps::IrOpcode::And:
            emitBinOp(inst, "andl");
            break;
        case wallvm::irOps::IrOpcode::Or:
            emitBinOp(inst, "orl");
            break;
        case wallvm::irOps::IrOpcode::Xor:
            emitBinOp(inst, "xorl");
            break;
        case wallvm::irOps::IrOpcode::Shl:
            emitShift(inst, "shll");
            break;
        case wallvm::irOps::IrOpcode::Ashr:
            emitShift(inst, "sarl");
            break;
        case wallvm::irOps::IrOpcode::Lshr:
            emitShift(inst, "shrl");
            break;
        case wallvm::irOps::IrOpcode::Load:
            emitLoad(inst);
            break;
        case wallvm::irOps::IrOpcode::Store:
            emitStore(inst);
            break;
        case wallvm::irOps::IrOpcode::ICmp:
            emitICmp(inst);
            break;
        case wallvm::irOps::IrOpcode::Br:
            emitBr(inst);
            break;
        case wallvm::irOps::IrOpcode::CondBr:
            emitCondBr(inst);
            break;
        case wallvm::irOps::IrOpcode::Ret:
            emitRet(inst);
            break;
        case wallvm::irOps::IrOpcode::Call:
            emitCall(inst);
            break;
        case wallvm::irOps::IrOpcode::SiToFp:
        {
            const char* src = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
            // Push integer onto CPU stack, load as FPU, clean up
            self.emitter.emit("\tpushl ");
            self.emitter.emitLine(src);
            self.emitter.emitTab("fildl (%esp)");
            self.emitter.emitTab("addl $4, %esp");
            break;
        }
        case wallvm::irOps::IrOpcode::FpToSi:
        {
            const char* dst = getRegForValue(&inst.base);
            // Float value is in ST(0), convert to integer and store to dest
            self.emitter.emitTab("subl $4, %esp");
            self.emitter.emitTab("fistpl (%esp)");
            self.emitter.emit("\tpopl ");
            self.emitter.emitLine(dst);
            break;
        }
        default:
            self.emitter.emit("; unhandled");
            break;
        }
    }

    void emitBinOp(wallvm::ir_types::IrInst* inst, const char* op)
    {
        const char* dst = getRegForValue(&inst.base);
        const char* src1 = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
        const char* src2 = (inst.nops > 1) ? getRegForValue(inst.ops[1]) : "ecx";
        if (!strEq(src1, dst))
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        self.emitter.emit("\t");
        self.emitter.emit(op);
        self.emitter.emit(" ");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
    }

    void emitDiv(wallvm::ir_types::IrInst* inst, bool isSigned)
    {
        const char* src1 = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
        const char* src2 = (inst.nops > 1) ? getRegForValue(inst.ops[1]) : "ecx";
        const char* dst = getRegForValue(&inst.base);
        // If divisor is in eax, save it to ecx first before loading dividend
        if (strEq(src2, "eax"))
        {
            self.emitter.emit("\tmovl %eax, %ecx");
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
        }
        else
        {
            // Load dividend into eax
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
            // Move divisor to ecx if not already there
            if (!strEq(src2, "ecx"))
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %ecx");
            }
        }
        // Sign-extend or zero-extend edx:eax
        if (isSigned)
            self.emitter.emitTab("cltd");
        else
            self.emitter.emitTab("xorl %edx, %edx");
        self.emitter.emit("\t");
        self.emitter.emitLine(isSigned ? "idivl %ecx" : "divl %ecx");
        if (!strEq(dst, "eax"))
        {
            self.emitter.emit("\tmovl %eax, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitRem(wallvm::ir_types::IrInst* inst, bool isSigned)
    {
        const char* src1 = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
        const char* src2 = (inst.nops > 1) ? getRegForValue(inst.ops[1]) : "ecx";
        const char* dst = getRegForValue(&inst.base);
        // If divisor is in eax, save it to ecx first before loading dividend
        if (strEq(src2, "eax"))
        {
            self.emitter.emit("\tmovl %eax, %ecx");
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
        }
        else
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
            if (!strEq(src2, "ecx"))
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %ecx");
            }
        }
        if (isSigned)
            self.emitter.emitTab("cltd");
        else
            self.emitter.emitTab("xorl %edx, %edx");
        self.emitter.emit("\t");
        self.emitter.emitLine(isSigned ? "idivl %ecx" : "divl %ecx");
        if (!strEq(dst, "edx"))
        {
            self.emitter.emit("\tmovl %edx, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitShift(wallvm::ir_types::IrInst* inst, const char* op)
    {
        const char* dst = getRegForValue(&inst.base);
        const char* src1 = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
        const char* amt = (inst.nops > 1) ? getRegForValue(inst.ops[1]) : "ecx";
        self.emitter.emit("\tmovl ");
        self.emitter.emit(src1);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        // Shift count must be in %cl
        if (!strEq(amt, "ecx"))
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(amt);
            self.emitter.emitLine(", %ecx");
        }
        self.emitter.emit("\t");
        self.emitter.emit(op);
        self.emitter.emit(" %cl, ");
        self.emitter.emitLine(dst);
    }

    void emitLoad(wallvm::ir_types::IrInst* inst)
    {
        const char* dst = getRegForValue(&inst.base);
        const char* src = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
        self.emitter.emit("\tmovl (");
        self.emitter.emit(src);
        self.emitter.emit("), ");
        self.emitter.emitLine(dst);
    }

    void emitStore(wallvm::ir_types::IrInst* inst)
    {
        const char* src = (inst.nops > 1) ? getRegForValue(inst.ops[1]) : "eax";
        const char* dst = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "ebx";
        self.emitter.emit("\tmovl ");
        self.emitter.emit(src);
        self.emitter.emit(", (");
        self.emitter.emit(dst);
        self.emitter.emitLine(")");
    }

    void emitICmp(wallvm::ir_types::IrInst* inst)
    {
        const char* dst = getRegForValue(&inst.base);
        const char* src1 = (inst.nops > 0) ? getRegForValue(inst.ops[0]) : "eax";
        const char* src2 = (inst.nops > 1) ? getRegForValue(inst.ops[1]) : "ecx";
        self.emitter.emit("\tcmpl ");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(src1);
        const char* setOp;
        switch (inst.icmpPred)
        {
        case wallvm::irOps::IrICmpPred::Eq: setOp = "sete"; break;
        case wallvm::irOps::IrICmpPred::Ne: setOp = "setne"; break;
        case wallvm::irOps::IrICmpPred::Slt: setOp = "setl"; break;
        case wallvm::irOps::IrICmpPred::Sle: setOp = "setle"; break;
        case wallvm::irOps::IrICmpPred::Sgt: setOp = "setg"; break;
        case wallvm::irOps::IrICmpPred::Sge: setOp = "setge"; break;
        case wallvm::irOps::IrICmpPred::Ult: setOp = "setb"; break;
        case wallvm::irOps::IrICmpPred::Ule: setOp = "setbe"; break;
        case wallvm::irOps::IrICmpPred::Ugt: setOp = "seta"; break;
        case wallvm::irOps::IrICmpPred::Uge: setOp = "setae"; break;
        default: setOp = "sete"; break;
        }
        self.emitter.emit("\t");
        self.emitter.emit(setOp);
        self.emitter.emitLine(" %al");
        self.emitter.emit("\tmovzbl %al, ");
        self.emitter.emitLine(dst);
    }

    void emitBr(wallvm::ir_types::IrInst* inst)
    {
        self.lastCallTarget = "";
        self.lastCallResult = null;
        if (inst.nops > 0 && inst.ops[0])
        {
            self.emitter.emit("\tjmp ");
            self.emitter.emitLine(inst.ops[0].name);
        }
    }

    void emitCondBr(wallvm::ir_types::IrInst* inst)
    {
        self.lastCallTarget = "";
        self.lastCallResult = null;
        if (inst.nops >= 3)
        {
            const char* cond = getRegForValue(inst.ops[0]);
            self.emitter.emit("\ttestl ");
            self.emitter.emit(cond);
            self.emitter.emit(", ");
            self.emitter.emitLine(cond);
            self.emitter.emit("\tjne ");
            self.emitter.emitLine(inst.ops[1].name);
            self.emitter.emit("\tjmp ");
            self.emitter.emitLine(inst.ops[2].name);
        }
    }

    void emitCall(wallvm::ir_types::IrInst* inst)
    {
        if (inst.nops > 0 && inst.ops[0])
        {
            wallvm::ir_types::IrValue* callee = inst.ops[0];
            u32 nargs = inst.nops - 1;

            self.lastCallTarget = callee.name;
            self.lastCallResult = &inst.base;

            for (u32 i = 0; i < nargs; i++)
            {
                const char* src = getRegForValue(inst.ops[1 + i]);
                self.emitter.emit("\tpushl ");
                self.emitter.emitLine(src);
            }
            self.emitter.emit("\tcall ");
            self.emitter.emitLine(callee.name);
            if (nargs > 0)
            {
                std::cchar stackBuf[16];
                u32ToStr(nargs * 4, stackBuf);
                self.emitter.emit("\taddl $");
                self.emitter.emitLine(stackBuf);
            }
        }
    }
}
