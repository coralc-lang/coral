pub void emitAvxVecBroadcast256(X86_64Emitter* emitter, const cchar* dst, const cchar* src)
{
    emitter->it("\tvbroadcastss ");
    emitter->it(src);
    emitter->it(", ");
    emitter->itLine(dst);
}

pub void emitAvxVecGather256(X86_64Emitter* emitter,
                             const cchar* dst, const cchar* base,
                             const cchar* indices, u32 scale)
{
    emitter->it("\tvpgatherdd ");
    emitter->it(indices);
    emitter->it(", (");
    emitter->it(base);
    emitter->it("), ");
    emitter->it(dst);
    emitter->it(", $");
    cchar buf[16];
    u32ToStr(scale, buf);
    emitter->itLine(buf);
}

pub void emitAvx512VecAdd512(X86_64Emitter* emitter,
                             const cchar* dst, const cchar* src1,
                             const cchar* src2)
{
    if (emitter->features != null && emitter->features->avx512f)
    {
        emitter->it("\tvpaddd ");
        emitter->it(src2);
        emitter->it(", ");
        emitter->it(src1);
        emitter->it(", ");
        emitter->itLine(dst);
    }
}

