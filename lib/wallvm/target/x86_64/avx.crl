pub void emitAvx512VecAdd512Masked(X86_64Emitter* emitter,
                                   const cchar* dst, const cchar* src1,
                                   const cchar* src2, const cchar* mask)
{
    if (emitter->features != null && emitter->features->avx512f)
    {
        emitter->it("\tvpaddd ");
        emitter->it(src2);
        emitter->it(", ");
        emitter->it(src1);
        emitter->it(dst);
        emitter->it(" {");
        emitter->it(mask);
        emitter->itLine("}");
    }
}

pub void emitFma(X86_64Emitter* emitter,
                 const cchar* dst, const cchar* src1,
                 const cchar* src2, const cchar* src3)
{
    if (emitter->features != null && emitter->features->fma)
    {
        emitter->it("\tvfmadd231ss ");
        emitter->it(src2);
        emitter->it(", ");
        emitter->it(src1);
        emitter->it(", ");
        emitter->itLine(dst);
    }
}

