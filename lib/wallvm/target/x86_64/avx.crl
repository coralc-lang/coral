import(lib) wallvm::target::x86_64_base { X86_64Emitter };
import(lib) core::cchar { cchar };

static void u32ToStr(u32 val, cchar* out)
{
    if (val == 0) { out[0] = '0'; out[1] = 0; return; }
    cchar buf[16];
    u32 i = 0;
    while (val > 0) { buf[i++] = '0' + (val % 10); val /= 10; }
    for (u32 j = 0; j < i; j++) out[j] = buf[i - 1 - j];
    out[i] = 0;
}

pub void emitAvxVecAdd256(X86_64Emitter* emitter,
                          const cchar* dst, const cchar* src1,
                          const cchar* src2)
{
    emitter->it("\tvpaddd ");
    emitter->it(src2);
    emitter->it(", ");
    emitter->it(src1);
    emitter->it(", ");
    emitter->itLine(dst);
}

pub void emitAvxVecSub256(X86_64Emitter* emitter,
                          const cchar* dst, const cchar* src1,
                          const cchar* src2)
{
    emitter->it("\tvpsubd ");
    emitter->it(src2);
    emitter->it(", ");
    emitter->it(src1);
    emitter->it(", ");
    emitter->itLine(dst);
}

pub void emitAvxVecMul256(X86_64Emitter* emitter,
                          const cchar* dst, const cchar* src1,
                          const cchar* src2)
{
    emitter->it("\tvpmulld ");
    emitter->it(src2);
    emitter->it(", ");
    emitter->it(src1);
    emitter->it(", ");
    emitter->itLine(dst);
}

