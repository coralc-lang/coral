mod irTypes = import "irtypes";
mod irOps = import "irOps";
import(lib) std;

pub struct IrBuilder
{
    ir_types::IrContext* ctx;
    ir_types::IrBlock* block;
    ir_types::IrInst* insertBefore;

    IrBuilder new(ir_types::IrContext* ctx)
    {
        IrBuilder b;
        b.ctx = ctx;
        b.block = null;
        b.insertBefore = null;
        return b;
    }

    / Set insertion position
    void pos(ir_types::IrBlock* block, ir_types::IrInst* before)
    {
        self.block = block;
        self.insertBefore = before;
    }

    ir_types::IrInst* retVoid()
    {
        return self.createInst(irOps::IrOpcode::Ret, self.ctx.tyVoid(), null, 0, 0, 0);
    }

    ir_types::IrInst* ret(ir_types::IrValue* val)
    {
        ir_types::IrValue** ops = self.allocOps(1);
        ops[0] = val;
        return self.createInst(irOps::IrOpcode::Ret, val.type, ops, 1, 0, 0);
    }

    ir_types::IrInst* br(ir_types::IrBlock* dest)
    {
        ir_types::IrValue** ops = self.allocOps(1);
        ops[0] = &dest.base;
        ir_types::IrInst* inst = self.createInst(irOps::IrOpcode::Br, self.ctx.tyVoid(), ops, 1, 0, 0);
        // sdd successor edge
        if (self.block) self.block.addSucc(dest);
        return inst;
    }

    ir_types::IrInst* condBr(ir_types::IrValue* cond, ir_types::IrBlock* thenBb, ir_types::IrBlock* elseBb)
    {
        ir_types::IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = &thenBb.base;
        ops[2] = &elseBb.base;
        ir_types::IrInst* inst = self.createInst(irOps::IrOpcode::CondBr, self.ctx.tyVoid(), ops, 3, 0, 0);
        if (self.block)
        {
            self.block.addSucc(thenBb);
            self.block.addSucc(elseBb);
        }
        return inst;
    }

    ir_types::IrInst* unreachable() { return self.createInst(irOps::IrOpcode::Unreachable, self.ctx.tyVoid(), null, 0, 0, 0); }
    ir_types::IrInst* noret() { return self.createInst(irOps::IrOpcode::Noret, self.ctx.tyVoid(), null, 0, 0, 0); }
    ir_types::IrInst* add(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::Add, l, r); }
    ir_types::IrInst* sub(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::Sub, l, r); }
    ir_types::IrInst* mul(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::Mul, l, r); }
    ir_types::IrInst* sdiv(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::SDiv, l, r); }
    ir_types::IrInst* udiv(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::UDiv, l, r); }
    ir_types::IrInst* srem(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::SRem, l, r); }
    ir_types::IrInst* fadd(ir_types::IrValue* l, ir_types::IrValue* r) { return self.createBinary(irOps::IrOpcode::FAdd, l, r); }
    ir_types::IrInst* fsub(ir_types::IrValue* l, ir_types::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FSub, l, r);
    }

    ir_types::IrInst* fmul(ir_types::IrValue* l, ir_types::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FMul, l, r);
    }

    ir_types::IrInst* fdiv(ir_types::IrValue* l, ir_types::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FDiv, l, r);
    }

    ir_types::IrInst* urem(ir_types::IrValue* l, ir_types::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::URem, l, r);
    }

    ir_types::IrInst* andOp(ir_types::IrValue* l, ir_types::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::And, l, r);
    }
}