/* result.crl for std
 * coral has no inbuilt error handling.
 * I will not add try-catch shit either;
 */

pub variant Result<T, E> // pub enum Result<T, E> : tagged {}
{
    Ok { T value },
    Err { E error }
}

extend Result<T, E>
{
    bool isOk()
    {
        switch (self)
        {
            Ok { value } => { return true; },
            else => {return false; }
        }
    }

    bool isErr() { return !isOk(); }

    T unwrap()
    {
        switch (self)
        {
            Ok { value } => { return value; },
            else => { @assert(false); }
        }
    }

    T unwrapOr(T defaultVal)
    {
        switch (self)
        {
            Ok { value } => { return value; },
            else => { return defaultVal; }
        }
    }

    E unwrapErr()
    {
        switch (self)
        {
            Err { error } => { return error; },
            else => { @assert(false); }
        }
    }

    T* okPtr(self)
    {
        switch (self)
        {
            Ok { value } => { return &value; },
            else => { return null; }
        }
    }

    E* errPtr(self)
    {
        switch (self)
        {
            Err { error } => { return &error; },
            else => { return null; }
        }
    }

    void mapOk(T(T) fn)
    {
        switch (self)
        {
            Ok { value } => { self = Result<T, E>::Ok { fn(value) }; },
            else => {}
        }
    }

    void mapErr(E(E) fn)
    {
        switch (self)
        {
            Err { error } => { self = Result<T, E>::Err { fn(error) }; },
            else => {}
        }
    }

    void andThen(Result<T, E>(T) fn)
    {
        switch (self)
        {
            Ok { error } => { self = fn(error); },
            else => {}
        }
    }

    void orElse(Result<T, E>(E) fn)
    {
        switch (self)
        {
            Err { error } => { self = fn(error); },
            else => {}
        }
    }
}