// HANDOFF example: member of a struct from a function returning its type,
// plus chained method calls.
struct this
{
    i32 goo, moo;

    this new(i32 a, i32 b) { return this { .goo = a, .moo = b }; }
    i32 add() { return self.goo + self.moo; }
    i32 sub() { return self.goo - self.moo };
}

pub i32 main()
{
    // c is an i32 here from type inference
    var c = this::new(2, 3).goo;
    if (c != 5) return 1;
    var d = this::new(c, 3).add();
    if (d != 8) return 2;
    return 0;
}
