import(lib) std::io::ios { println, eprintln, hex, spaces, flush, parseI64 };
import(lib) std::text::string { String };
import(lib) std::vec { Vec };
import(lib) std::io::fs { File, fileOpen, fileClose, fileWrite, fileRead };

pub i32 main()
{
    println("ints: {} {} {}", 1, -2, 3000000000);
    println("str: {}", "hello");
    println("hex: {}", hex(255));
    println("spaces:[{}{}]", spaces(3), "x");

    String s = String::fromView("abc");
    s.appendView("def");
    println("string: {}", s.asView());
    if (s.len != 6) return 1;

    Vec<i32> v = Vec<i32>::new();
    v.push(10);
    v.push(20);
    v.push(30);
    if (v.count() != 3) return 2;
    if (v.at(1) != 20) return 3;
    println("vec: {} {} {}", v.at(0), v.at(1), v.at(2));

    bool ok = false;
    i64 n = parseI64("123", &ok);
    if (ok == false) return 4;
    if (n != 123) return 5;
    println("parse: {}", n);

    File f = fileOpen("/tmp/opencode/tt/probe_io.txt", "w");
    if ((i32)f < 0) return 6;
    str payload = "line1\nline2\n";
    fileWrite(f, (const u8*)payload.ptr, payload.len);
    fileClose(f);

    File g = fileOpen("/tmp/opencode/tt/probe_io.txt", "r");
    if ((i32)g < 0) return 7;
    u8 buf[64];
    isize got = fileRead(g, buf, 64);
    fileClose(g);
    if (got != 12) return 8;
    println("file bytes: {}", got);

    s.free();
    flush();
    eprintln("stderr ok");
    return 0;
}
