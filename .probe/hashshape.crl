import(lib) std::mman { zero, alloc };

struct E<K, V>
{
    K key;
    V val;
    bool occupied;
}

struct Box<K, V>
{
    E<K, V>* entries;
    usize cap;
    usize len;
    usize(K) hashFn;
    bool(K, K) eqFn;

    static Box<K, V> new(usize(K) hf, bool(K, K) ef)
    {
        Box<K, V> m = Box<K, V> {
            .entries = alloc<E<K, V>>(16),
            .cap = 16,
            .len = 0,
            .hashFn = hf,
            .eqFn = ef
        };
        zero<E<K, V>>(m.entries, 16);
        return m;
    }
}

pub i32 main()
{
    return 0;
}
