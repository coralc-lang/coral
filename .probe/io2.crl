import(lib) platform::libc { write };
import(lib) std::text::string { String };
import(lib) std::vec { Vec };
import(lib) std::io::fs { File, fileOpen, fileClose, fileWrite, fileRead };
import(lib) std::io::fios { FileHandle, fileOpen as fOpen, fileClose as fClose, fileWrite as fWrite, fileReadAll };
import(lib) std::mman { alloc, dealloc };
import(lib) std::math { pow, sqrt };
import(lib) std::collections::hashmap { HashMap };

usize hashStr(str k)
{
    usize h = 5381;
    for (usize i = 0; i < k.len; i++) h = h * 33 + (usize)k.ptr[i];
    return h;
}

bool eqStr(str a, str b) { return a.equals(b); }

pub i32 main()
{
    // raw stdout via libc write
    str hello = "io probe\n";
    write(1, hello.ptr, hello.len);

    // String
    String s = String::fromView("  hello world  ");
    String t = String::fromView("  hello world  ");
    if (s.len != 15) return 1;
    if (s.equals(&t) == false) return 2;
    String trimmed = s.trim();
    if (trimmed.len != 11) return 3;
    trimmed.free();
    String word = String::fromView("abc");
    word.appendView("def");
    if (word.len != 6) return 4;
    String expect = String::fromView("abcdef");
    if (word.equals(&expect) == false) return 5;
    if (s.equals(&t) == false) return 51;
    word.free();
    expect.free();
    s.free();
    t.free();

    // Vec
    Vec<i32> v = Vec<i32>::new();
    v.push(10);
    v.push(20);
    v.push(30);
    if (v.count() != 3) return 6;
    if (v.at(1) != 20) return 7;
    v.set(0, 11);
    if (v.at(0) != 11) return 8;
    i32 popped = v.pop();
    if (popped != 30) return 9;
    if (v.count() != 2) return 10;
    v.drop();

    // fs (syscall io)
    File f = fileOpen("/tmp/opencode/tt/probe_fs.txt", "w");
    if ((i32)f < 0) return 11;
    fileWrite(f, (const u8*)hello.ptr, hello.len);
    fileClose(f);
    File g = fileOpen("/tmp/opencode/tt/probe_fs.txt", "r");
    if ((i32)g < 0) return 12;
    u8 buf[64];
    isize got = fileRead(g, buf, 64);
    fileClose(g);
    if (got != (isize)hello.len) return 13;
    if (buf[0] != 'i') return 14;

    // fios (stdio io) + String
    FileHandle fh = fOpen("/tmp/opencode/tt/probe_fios.txt", "w");
    if (fh == 0) return 15;
    fWrite(fh, "line1\nline2\n");
    fClose(fh);
    String contents = String::new();
    bool rok = fileReadAll("/tmp/opencode/tt/probe_fios.txt", &contents);
    if (rok == false) return 16;
    if (contents.len != 12) return 17;
    contents.free();

    // alloc
    i32* nums = alloc<i32>(8);
    if (nums == 0) return 18;
    nums[0] = 42;
    if (nums[0] != 42) return 19;
    dealloc<i32>(nums);

    // math
    f64 p = pow(2.0, 10.0);
    f64 sq = sqrt(16.0);
    if (p < 1023.9) return 20;
    if (sq < 3.9) return 21;

    // hashmap
    HashMap<str, i32> m = HashMap<str, i32>::new(hashStr, eqStr);
    m.insert("one", 1);
    m.insert("two", 2);
    if (m.contains("one") == false) return 22;
    if (m.contains("three") == true) return 23;
    m.dispose();

    write(1, "io probe ok\n", 12);
    return 0;
}
